module sfu

intent "selective forwarding unit for chat calls: peers subscribe to (room, track); a published frame is forwarded, unreliable and latest-wins, to every other subscriber of that track; the SFU folds only (track, seq, digest) metadata, never frame bytes, and payloads are end-to-end ciphertext it cannot read"
    example Setup(me: "s"), ChanRecvDone(req: 1, status: "delivered", data: some(["a\t1\tsub\u{1f}r\u{1f}v"]), err: "") -> subs.len() == 1
    example Setup(me: "s"), ChanRecvDone(req: 1, status: "delivered", data: some(["a\t1\tsub\u{1f}r\u{1f}v"]), err: ""), ChanRecvDone(req: 1, status: "delivered", data: some(["a\t1\tunsub\u{1f}r\u{1f}v"]), err: "") -> subs.len() == 0
    example Setup(me: "s"), ChanRecvDone(req: 1, status: "delivered", data: some(["a\t1\tsub\u{1f}r\u{1f}v"]), err: ""), ChanRecvDone(req: 1, status: "delivered", data: some(["b\t1\tframe\u{1f}r\u{1f}v\u{1f}1\u{1f}d1\u{1f}x"]), err: "") -> forwarded == 1
    example Setup(me: "s"), ChanRecvDone(req: 1, status: "delivered", data: some(["a\t1\tsub\u{1f}r\u{1f}v"]), err: ""), ChanRecvDone(req: 1, status: "delivered", data: some(["a\t1\tframe\u{1f}r\u{1f}v\u{1f}1\u{1f}d1\u{1f}x"]), err: "") -> forwarded == 0
    example Setup(me: "s"), ChanRecvDone(req: 1, status: "delivered", data: some(["a\t1\tsub\u{1f}r\u{1f}v"]), err: ""), ChanRecvDone(req: 1, status: "delivered", data: some(["b\t1\tframe\u{1f}r\u{1f}v\u{1f}2\u{1f}d2\u{1f}x"]), err: ""), ChanRecvDone(req: 1, status: "delivered", data: some(["b\t1\tframe\u{1f}r\u{1f}v\u{1f}1\u{1f}d1\u{1f}x"]), err: "") -> stale == 1

# Wire bodies (fields split by U+001F):
#   sub ROOM TRACK            subscribe the sender to a track
#   unsub ROOM TRACK          drop that subscription
#   frame ROOM TRACK SEQ DIGEST PAYLOAD
#                             a media frame from its publisher: SEQ orders
#                             it, DIGEST names the frame blob, PAYLOAD is
#                             opaque (end-to-end ciphertext or empty when the
#                             bytes travel as a blob by DIGEST)
# A forwarded frame names its publisher:
#   frame ROOM TRACK PUBLISHER SEQ DIGEST PAYLOAD
# A SEQ that is not 1 to 18 ASCII digits, or a body of another shape, is
# counted as malformed; no input from a peer makes a step of the SFU keep
# the state.
# Frames are forwarded with reliable: false (never retried, HC-3 lossy) and
# a frame whose SEQ is not newer than the last one forwarded on that
# (room, track, publisher) is dropped as stale (latest wins).

struct ChanSend
    req: u64
    peer: text
    id: u64
    body: text
    reliable: bool

struct ChanRecv
    req: u64
    max: u64

event Setup(me: text)
event Poll
event ChanSendDone(req: u64, status: text, data: u64?, err: text)
event ChanRecvDone(req: u64, status: text, data: List[text]?, err: text)

# a frame number: 1 to 18 ASCII digits (anything else is malformed, never a trap)
fn seq_of(t: text) -> u64
    let cs = t.chars()
    if cs.len() == 0 or cs.len() > 18
        return 0
    var ok = true
    for c in cs
        if not "0123456789".contains(copy(c))
            ok = false
    if not ok
        return 0
    return copy(t).toint() as u64

state Sfu
    me: text = ""
    next: u64 = 0
    subs: Map[text, u64] = {}
    last: Map[text, u64] = {}
    digests: Map[text, text] = {}
    forwarded: u64 = 0
    stale: u64 = 0
    dropped: u64 = 0
    malformed: u64 = 0

step Sfu on Setup(me: m)
    me = m

step Sfu on Poll
    next += 1
    emit ChanRecv(req: next, max: 256)

step Sfu on ChanRecvDone(req: _r, status: _s, data: d, err: _e)
    for m in d.or([])
        let mf = m.split("\t")
        var w = ""
        var b = ""
        if mf.len() >= 3
            w = copy(mf[0])
            b = copy(mf[2])
        let f = copy(b).split("\u{1f}")
        let op = if f.len() == 3 or f.len() == 6 then copy(f[0]) else ""
        if op == "sub" and f.len() == 3
            subs[copy(f[1]) + "\u{1f}" + copy(f[2]) + "\u{1f}" + copy(w)] = 1
        if op == "unsub" and f.len() == 3
            let k = copy(f[1]) + "\u{1f}" + copy(f[2]) + "\u{1f}" + copy(w)
            if subs.contains(copy(k))
                let _ = subs.remove(k)
        if op == "frame" and f.len() == 6
            let tk = copy(f[1]) + "\u{1f}" + copy(f[2])
            let pk = copy(tk) + "\u{1f}" + copy(w)
            let seq = seq_of(copy(f[3]))
            if seq == 0
                malformed += 1
            else
                if seq <= (last.get(copy(pk)) catch 0)
                    stale += 1
                else
                    last[copy(pk)] = seq
                    digests[copy(pk)] = copy(f[4])
                    for k in subs.keys()
                        let g = copy(k).split("\u{1f}")
                        if copy(g[0]) + "\u{1f}" + copy(g[1]) == tk and g[2] != w
                            next += 1
                            forwarded += 1
                            emit ChanSend(req: next, peer: copy(g[2]), id: next, body: "frame\u{1f}" + copy(tk) + "\u{1f}" + copy(w) + "\u{1f}" + copy(f[3]) + "\u{1f}" + copy(f[4]) + "\u{1f}" + copy(f[5]), reliable: false)
        if not ((op == "sub" or op == "unsub") and f.len() == 3) and not (op == "frame" and f.len() == 6)
            malformed += 1

step Sfu on ChanSendDone(req: _r, status: s, data: _d, err: _e)
    if s != "delivered"
        dropped += 1
