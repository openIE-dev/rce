module pty_http

intent "a shell beside the HTTP host: whatever the sandbox lets the host open, and nothing more, the shell can open"
    example Input(data: "true\n"), PtyOpenDone(req: 1, status: "delivered", data: some(5), err: "") -> pty == 5
    example HttpRequest(id: 7, method: "GET", target: "/", names: ["Host"], values: ["x"], body: []) -> answered == 1

struct HttpRespond
    req: u64
    status: u64
    names: List[text]
    values: List[text]
    body: text

struct PtyOpen
    req: u64
    argv: List[text]
    rows: u64
    cols: u64

struct PtyRead
    req: u64
    id: u64
    max: u64

struct Display
    data: text

event HttpRequest(id: u64, method: text, target: text, names: List[text], values: List[text], body: List[i64])
event HttpMalformed(id: u64, status: u64, why: text)
event HttpRespondDone(req: u64, status: text, data: u64?, err: text)
event PtyOpenDone(req: u64, status: text, data: u64?, err: text)
event PtyReadDone(req: u64, status: text, data: text?, err: text)
event Input(data: text)
event Tick

state S
    req: u64 = 0
    pty: u64 = 0
    answered: u64 = 0

step S on Input(data: d)
    req += 1
    emit PtyOpen(req: req, argv: ["sh", "-c", copy(d)], rows: 24, cols: 80)

step S on PtyOpenDone(req: _r, status: s, data: d, err: _e)
    if s == "delivered"
        pty = d.or(0)

step S on Tick
    if pty != 0
        req += 1
        emit PtyRead(req: req, id: pty, max: 4096)

step S on PtyReadDone(req: _r, status: s, data: d, err: _e)
    if s == "delivered"
        emit Display(data: d.or(""))
    else
        pty = 0

step S on HttpRequest(id: id, method: _m, target: _t, names: _n, values: _v, body: _b)
    answered += 1
    emit HttpRespond(req: id, status: 200, names: [], values: [], body: "ok")

step S on HttpMalformed(id: id, status: st, why: _w)
    emit HttpRespond(req: id, status: st, names: [], values: [], body: "")

step S on HttpRespondDone(_, _, _, _)
    pass
