module refloop

intent "a Refused step that retries an effect whose result step is refused, which must not loop through Refused; and an effect chain that never ends, which a stop must still end"
    example Refused(seq: 1, cause: "trap") -> refusals == 1 and req == 1
    example Go -> refused: trap("division by zero")
    example Endless -> endless and req == 1
    example Endless, RandomDone(req: 1, status: "failed", data: none, err: "no adapter") -> req == 2

struct Random
    req: u64
    n: u64

event Go
event Endless
event RandomDone(req: u64, status: text, data: text?, err: text)
event Refused(seq: u64, cause: text)

state S
    zero: u64 = 0
    refusals: u64 = 0
    req: u64 = 0
    endless: bool = false

step S on Go
    refusals = refusals / zero

step S on Endless
    endless = true
    req += 1
    emit Random(req: req, n: 1)

step S on Refused(seq: _q, cause: _c)
    refusals += 1
    req += 1
    emit Random(req: req, n: 1)

step S on RandomDone(_, _, _, _)
    if endless
        req += 1
        emit Random(req: req, n: 1)
    else
        refusals = refusals / zero
