module refusals

intent "a refused step is followed by host.Refused and, when the program declares it, by the input Refused(seq, cause), so the program is told that the step did not happen and why"
    example Ok -> applied == 1 and refusals == 0
    example Fail -> refused: Bad
    example Refused(seq: 4, cause: "fail") -> refusals == 1 and last_seq == 4 and last_cause == "fail" and applied == 0
    example Busy(n: 10), Refused(seq: 7, cause: "fuel") -> work_done == 10

error Bad(why: text)

event Ok
event Fail
event Divide
event Burn
event Big
event Deep
event Spin(n: u64)
event Busy(n: u64)
event Poison
event Refused(seq: u64, cause: text)

state S
    applied: u64 = 0
    zero: u64 = 0
    refusals: u64 = 0
    last_seq: u64 = 0
    last_cause: text = ""
    poisoned: bool = false
    work: u64 = 0
    work_done: u64 = 0

fn down(n: i64) -> i64 bound 100000000
    if n <= 0
        return 0
    return 1 + down(n - 1)

fn spin(n: u64) -> u64
    var s: u64 = 0
    for _i in 0..n
        s += 1
    return s

step S on Ok
    applied += 1

step S on Fail
    fail Bad(why: "refused on purpose")

step S on Divide
    applied = applied / zero

step S on Burn
    for _i in 0..1000000
        applied += spin(1000000)

step S on Big
    var t = "x"
    for _i in 0..21
        t = t + t
    applied += t.len_bytes() as u64

step S on Deep
    applied += down(30000) as u64

step S on Spin(n: n)
    applied += spin(n)

step S on Busy(n: n)
    work = n

step S on Poison
    poisoned = true

step S on Refused(seq: q, cause: c)
    if poisoned
        applied = applied / zero
    refusals += 1
    last_seq = q
    last_cause = copy(c)
    work_done += spin(work)
