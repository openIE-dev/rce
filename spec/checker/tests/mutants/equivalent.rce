# Equivalent mutant: `n + 0` becomes `n - 0`, which `rce equiv` judges to
# have the program's behaviour; it is counted apart and not as a survivor.
intent "a counter modulo 4 that shows itself"
    example Inc, Inc -> 2
    example Inc, Inc, Inc, Inc -> 0
    example Inc, Show -> 1

state Counter
    n: u8 = 0

struct Shown
    value: u8

event Inc
event Show

step Counter on Inc -> (n + 1) % 4
step Counter on Show
    emit Shown(value: n + 0)
