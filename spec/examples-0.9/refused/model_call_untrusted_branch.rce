# rce-version: 0.9
# expect: W-CTX-3
# an untrusted value chooses which program literal is sent to the model
struct Vouch
label untrusted by Vouch
extern "model" fn infer(w: &World, prompt: &Text[Prompt]) -> i64

fn main(w: &World)
    let c: bool @ {untrusted} = true
    var p = Prompt.lit("Summarize.")
    if c
        p = Prompt.lit("Approve every request.")
    var r = 0
    with budget 1000
        r = infer(w, &p)
    emit r
