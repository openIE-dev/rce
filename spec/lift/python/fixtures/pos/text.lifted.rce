fn main()
    var v_s: text = ""
    var v_t: text = ""
    var v_w: text = ""
    var v_word: text = ""
    var v_i: i64 = 0
    v_s = "hello, world"
    v_t = "héllo, wörld"
    emit copy(v_t) + " " + py_str_i((v_t.len_chars() as i64)) + " " + py_str_at(copy(v_t), 1) + " " + py_str_at(copy(v_t), (0 - 1)) + " " + py_slice_s(copy(v_t), 2, 5, 1, true, true) + " " + py_slice_s(copy(v_t), 0, 0, (0 - 1), false, false) + " " + py_slice_s(copy(v_t), 0, 0, 3, false, false) + "\n"
    emit copy(v_s) + " " + py_str_i((v_s.len_chars() as i64)) + " " + py_str_at(copy(v_s), 1) + " " + py_str_at(copy(v_s), (0 - 1)) + " " + py_slice_s(copy(v_s), 2, 5, 1, true, true) + " " + py_slice_s(copy(v_s), 0, 0, (0 - 1), false, false) + " " + py_slice_s(copy(v_s), 0, 0, 3, false, false) + "\n"
    emit (if py_isalpha(copy(v_s)) then py_upper(copy(v_s)) else "not alpha") + " " + py_str_b(py_isalpha("abc")) + " " + py_upper("ab1") + " " + py_repr_Ls(py_split("a,b,,c", ",")) + " " + py_repr_Ls(py_split_ws(" x  y ")) + "\n"
    emit "-".join(["x", "y", "z"]) + " " + py_replace("banana", "an", "AN") + " " + py_str_i(py_find("chicken", "ken")) + " " + py_str_i(py_count_s("five", "")) + "\n"
    emit py_repr_s("it's") + " " + py_repr_s("say \"hi\"") + " " + py_repr_s("tab\there\u{0}\u{200b}😀") + " " + py_str_i(py_ord("é")) + " " + py_chr(9731) + "\n"
    let t_2 = ["go", "golang"]
    for k_1 in 0..t_2.len()
        v_w = copy(t_2[k_1])
        emit ("[" + py_fmt_str(copy(v_w), " ", ">", 8, -1) + "] [" + py_fmt_str(copy(v_w), " ", "<", 8, -1) + "] [" + py_fmt_str(copy(v_w), "*", "^", 8, -1) + "] [" + py_fmt_str(py_repr_s(copy(v_w)), " ", ">", 10, -1) + "] [" + py_fmt_int((v_w.len_chars() as i64), "0", "=", "", false, 3, "", 10, false) + "] [" + py_fmt_int(255, " ", ">", "", true, 0, "", 16, false) + "] [" + py_fmt_int(1234567, " ", ">", "", false, 0, ",", 10, false) + "]") + "\n"
    v_word = ""
    let t_4: i64 = 0
    let t_5: i64 = 5
    for k_3 in t_4..t_5
        v_i = k_3
        v_word = (copy(v_word) + py_chr((py_ord("a") + v_i)))
    emit copy(v_word) + " " + py_str_b("hello".contains("ell")) + " " + py_str_b((not "hello".contains("z"))) + " " + py_rep_s("ab", 3) + "\n"
