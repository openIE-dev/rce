fn f_push_squares(v_xs: &mut List[i64], v_n: i64)
    var v_i: i64 = 0
    let t_2: i64 = 0
    let t_3: i64 = v_n
    for k_1 in t_2..t_3
        v_i = k_1
        v_xs.push((v_i * v_i))

fn f_swap(v_a: &mut List[i64], v_i: i64, v_j: i64)
    let t_4 = (v_a[py_ix(v_j, v_a.len())], v_a[py_ix(v_i, v_a.len())])
    v_a[py_ix(v_i, v_a.len())] = t_4.0
    v_a[py_ix(v_j, v_a.len())] = t_4.1

fn main()
    var v_xs: List[i64] = []
    var v_counts: (List[text], List[i64]) = ([], [])
    var v_ch: text = ""
    var v_grid: List[List[i64]] = []
    var v_r: i64 = 0
    var v_row: List[i64] = []
    var v_n: i64 = 0
    var v_d: i64 = 0
    var v_k: i64 = 0
    v_xs = []
    f_push_squares(&mut v_xs, 6)
    f_swap(&mut v_xs, 0, 5)
    emit py_repr_Li(copy(v_xs)) + " " + py_repr_Li(py_slice(&v_xs, 1, 3, 1, true, true)) + " " + py_repr_Li(py_sorted(copy(v_xs))) + " " + py_repr_Li(py_sorted_rev(copy(v_xs))) + " " + py_str_i(py_index(&v_xs, 9)) + " " + py_str_i(py_count(&v_xs, 4)) + "\n"
    py_insert(&mut v_xs, 1, 99)
    let _ = py_pop_last(&mut v_xs)
    emit py_repr_Li(copy(v_xs)) + " " + py_repr_Li([c_5 for c_5 in copy(v_xs) if (py_mod(c_5, 2) == 0)]) + " " + py_repr_Li(py_range(10, 0, (0 - 3))) + "\n"
    v_counts = ([], [])
    let t_7 = "mississippi".chars()
    for k_6 in 0..t_7.len()
        v_ch = copy(t_7[k_6])
        py_dset(&mut v_counts, copy(v_ch), (py_dget_or(&v_counts, copy(v_ch), 0) + 1))
    emit py_repr_Dsi(copy(v_counts)) + " " + py_str_i((v_counts.0.len() as i64)) + " " + py_str_b((py_dfind(&v_counts, "s") >= 0)) + " " + py_repr_LT2si(py_ditems(&v_counts)) + "\n"
    v_grid = [py_rep_l([0], 3) for _c_8 in py_range(0, 3, 1)]
    v_grid[py_ix(1, v_grid.len())][py_ix(2, v_grid[py_ix(1, v_grid.len())].len())] = 5
    let t_10 = py_enumerate(copy(v_grid), 0)
    for k_9 in 0..t_10.len()
        let t_11 = copy(t_10[k_9])
        v_r = t_11.0
        v_row = copy(t_11.1)
        emit py_str_i(v_r) + " " + py_repr_Li(copy(v_row)) + "\n"
    let t_13: i64 = 2
    let t_14: i64 = 12
    for k_12 in t_13..t_14
        v_n = k_12
        var brk_15 = false
        let t_17: i64 = 2
        let t_18: i64 = v_n
        for k_16 in t_17..t_18
            v_d = k_16
            if (py_mod(v_n, v_d) == 0)
                brk_15 = true
                break
        if not brk_15
            emit py_str_i(v_n) + " "
    emit "\n"
    v_k = 0
    let b_19: i64 = py_max2((10 - v_k), 0) + 1
    while (v_k < 10) bound b_19 as u64
        v_k = (v_k + 3)
    emit py_str_i(v_k) + "-" + "-".join([py_str_i(x) for x in [1, 2, 3]]) + "\n"
