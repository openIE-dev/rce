# Lifted from lists.py by spec/lift/python/lift_py.py; do not edit.

fn py_ix(i: i64, n: usize) -> usize
    let m = n as i64
    let j = if i < 0 then i + m else i
    check j >= 0 and j < m
    return j as usize

fn py_mod(a: i64, b: i64) -> i64
    let r = a % b
    if r != 0 and ((r < 0) != (b < 0))
        return r + b
    return r

fn py_str_b(b: bool) -> text = if b then "True" else "False"

fn py_rlen(a: i64, b: i64, s: i64) -> i64
    check s != 0
    if s > 0
        return if b > a then (b - a + s - 1) / s else 0
    return if a > b then (a - b - s - 1) / (0 - s) else 0

fn py_range(a: i64, b: i64, s: i64) -> List[i64]
    var o: List[i64] = []
    for k in 0..py_rlen(a, b, s)
        o.push(a + k * s)
    return o

fn py_ord(c: text) -> i64
    check c.len_chars() == 1
    let b0 = c[0] as i64
    if b0 < 128
        return b0
    if b0 < 224
        return (b0 - 192) * 64 + (c[1] as i64 - 128)
    if b0 < 240
        return (b0 - 224) * 4096 + (c[1] as i64 - 128) * 64 + (c[2] as i64 - 128)
    return (b0 - 240) * 262144 + (c[1] as i64 - 128) * 4096 + (c[2] as i64 - 128) * 64 + (c[3] as i64 - 128)

fn py_slice_ix(n: i64, lo: i64, hi: i64, st: i64, has_lo: bool, has_hi: bool) -> List[i64]
    check st != 0
    var o: List[i64] = []
    if st > 0
        var a = if has_lo then lo else 0
        var b = if has_hi then hi else n
        if a < 0
            a = a + n
        if a < 0
            a = 0
        if a > n
            a = n
        if b < 0
            b = b + n
        if b < 0
            b = 0
        if b > n
            b = n
        for k in 0..py_rlen(a, b, st)
            o.push(a + k * st)
        return o
    var a = if has_lo then lo else n - 1
    var b = if has_hi then hi else -1
    if has_lo and a < 0
        a = a + n
    if a < -1
        a = -1
    if a > n - 1
        a = n - 1
    if has_hi and b < 0
        b = b + n
    if b < -1
        b = -1
    if b > n - 1
        b = n - 1
    for k in 0..py_rlen(a, b, st)
        o.push(a + k * st)
    return o

fn py_slice[T](xs: &List[T], lo: i64, hi: i64, st: i64, has_lo: bool, has_hi: bool) -> List[T]
    var o: List[T] = []
    for i in py_slice_ix(xs.len() as i64, lo, hi, st, has_lo, has_hi)
        o.push(copy(xs[i as usize]))
    return o

fn py_rep_l[T](a: List[T], n: i64) -> List[T]
    var o: List[T] = []
    for _k in 0..n
        for x in a
            o.push(copy(x))
    return o

fn py_pop_last[T](xs: &mut List[T]) -> T
    check xs.len() > 0
    let r = copy(xs[xs.len() - 1])
    let _ = xs.pop()
    return r

fn py_insert[T](xs: &mut List[T], i: i64, x: T)
    let n = xs.len() as i64
    var j = if i < 0 then i + n else i
    if j < 0
        j = 0
    if j > n
        j = n
    var o: List[T] = []
    for k in 0..n
        if k == j
            o.push(copy(x))
        o.push(copy(xs[k as usize]))
    if j == n
        o.push(copy(x))
    xs = o

fn py_index[T: Eq](xs: &List[T], x: T) -> i64
    for k in 0..xs.len()
        if xs[k] == x
            return k as i64
    check false
    return -1

fn py_count[T: Eq](xs: &List[T], x: T) -> i64
    var n: i64 = 0
    for y in xs
        if y == x
            n += 1
    return n

fn py_sorted[T: Ord](xs: List[T]) -> List[T]
    var o = xs
    o.sort()
    return o

fn py_sorted_rev[T: Ord](xs: List[T]) -> List[T]
    var o = xs
    o.sort()
    return o.reverse()

fn py_max2[T: Ord](a: T, b: T) -> T = if b > a then b else a

fn py_enumerate[T](xs: List[T], start: i64) -> List[(i64, T)]
    var o: List[(i64, T)] = []
    var i = start
    for x in xs
        o.push((i, copy(x)))
        i += 1
    return o

fn py_dfind[K: Eq, V](d: &(List[K], List[V]), k: K) -> i64
    for i in 0..d.0.len()
        if d.0[i] == k
            return i as i64
    return -1

fn py_dset[K: Eq, V](d: &mut (List[K], List[V]), k: K, v: V)
    let i = py_dfind(d, copy(k))
    if i >= 0
        d.1[i as usize] = v
        return
    d.0.push(k)
    d.1.push(v)

fn py_dget_or[K: Eq, V](d: &(List[K], List[V]), k: K, dflt: V) -> V
    let i = py_dfind(d, k)
    if i < 0
        return dflt
    return copy(d.1[i as usize])

fn py_ditems[K, V](d: &(List[K], List[V])) -> List[(K, V)]
    var o: List[(K, V)] = []
    for i in 0..d.0.len()
        o.push((copy(d.0[i]), copy(d.1[i])))
    return o

fn py_digits(n: i64, base: i64, upper: bool) -> text
    let ds = if upper then "0123456789ABCDEF".chars() else "0123456789abcdef".chars()
    if n == 0
        return "0"
    var o = ""
    var m = n
    while m != 0 bound 64
        let d = m % base
        let e = if d < 0 then 0 - d else d
        o = copy(ds[e as usize]) + o
        m = m / base
    return o

fn py_hex2(n: i64, w: i64) -> text
    var d = py_digits(n, 16, false)
    while d.len_chars() < w as usize bound 8
        d = "0" + d
    return d

fn py_repr_s(s: text) -> text
    let has_sq = s.contains("'")
    let has_dq = s.contains("\"")
    let q = if has_sq and not has_dq then "\"" else "'"
    var o = copy(q)
    for c in s.chars()
        let cp = py_ord(copy(c))
        if c == q or c == "\\"
            o = o + "\\" + c
        elif cp == 9
            o = o + "\\t"
        elif cp == 10
            o = o + "\\n"
        elif cp == 13
            o = o + "\\r"
        elif cp < 32 or cp == 127
            o = o + "\\x" + py_hex2(cp, 2)
        elif cp < 127
            o = o + c
        elif py_nonprintable(cp)
            if cp <= 255
                o = o + "\\x" + py_hex2(cp, 2)
            elif cp <= 65535
                o = o + "\\u" + py_hex2(cp, 4)
            else
                o = o + "\\U" + py_hex2(cp, 8)
        else
            o = o + c
    return o + q

fn py_nonprintable(cp: i64) -> bool
    var lo: usize = 0
    var hi: usize = PY_NP_LO.len()
    while lo < hi bound 64
        let mid = (lo + hi) / 2
        if PY_NP_HI[mid] < cp
            lo = mid + 1
        else
            hi = mid
    return lo < PY_NP_LO.len() and PY_NP_LO[lo] <= cp

fn py_repr_Li(xs: List[i64]) -> text
    var o = "["
    var first = true
    for x in xs
        if not first
            o = o + ", "
        o = o + py_str_i(copy(x))
        first = false
    return o + "]"

fn py_str_i(x: i64) -> text = x.tostr()

fn py_repr_Dsi(d: (List[text], List[i64])) -> text
    var o = "{"
    for i in 0..d.0.len()
        if i > 0
            o = o + ", "
        o = o + py_repr_s(copy(d.0[i])) + ": " + py_str_i(copy(d.1[i]))
    return o + "}"

fn py_repr_LT2si(xs: List[(text, i64)]) -> text
    var o = "["
    var first = true
    for x in xs
        if not first
            o = o + ", "
        o = o + py_repr_T2si(copy(x))
        first = false
    return o + "]"

fn py_repr_T2si(x: (text, i64)) -> text = "(" + py_repr_s(copy(x.0)) + ", " + py_str_i(copy(x.1)) + ")"

