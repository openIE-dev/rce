/-! T24 for the tick rules themselves. A run is a sequence of events in
    tick order; event `i` is on process `proc i` and, if it is a receive,
    names its matching send `src i` (an earlier event). The runtime's clock
    rule: an event takes its process's previous clock, joins (pointwise max)
    the clock of the matching send, and increments its own component.
    `V` below computes exactly that, step by step over the run (`hist`).
    Happens-before `HB` is generated by immediate program order and message
    edges, reflexively and transitively. Proved: the clock counts (`count`:
    `k < V i q` iff the `k`-th event of `q` happens before or equals `i`),
    so `HB j i ↔ V j ≤ V i` and strictly `HB j i ∧ j ≠ i ↔ V j < V i`, both
    directions. With `count` the tick-rule clock is a `VClock.Clock`-style
    counting clock, which `VClock` assumed. -/
namespace RCE.TickClock

structure Trace where
  proc : Nat → Nat
  src : Nat → Option Nat
  src_lt : ∀ i j, src i = some j → j < i

variable (t : Trace)

/-- events on `q` among the first `n` -/
def cnt (q : Nat) : Nat → Nat
  | 0 => 0
  | n + 1 => cnt q n + if t.proc n = q then 1 else 0

/-- index of event `i` on its process -/
def pos (i : Nat) : Nat := cnt t (t.proc i) i

/-- the latest event on `p` before `i` -/
def lastBefore (p : Nat) : Nat → Option Nat
  | 0 => none
  | i + 1 => if t.proc i = p then some i else lastBefore p i

def ov (h : Nat → Nat → Nat) (q : Nat) : Option Nat → Nat
  | some l => h l q
  | none => 0

/-- the tick rule for event `i`, given the clocks `h` of earlier events -/
def step (h : Nat → Nat → Nat) (i q : Nat) : Nat :=
  (if q = t.proc i then 1 else 0) +
    max (ov h q (lastBefore t (t.proc i) i)) (ov h q (t.src i))

/-- the clocks of the first `n` events, computed in tick order -/
def hist : Nat → Nat → Nat → Nat
  | 0 => fun _ _ => 0
  | n + 1 => fun j => if j = n then step t (hist n) n else hist n j

def V (i : Nat) : Nat → Nat := hist t (i + 1) i

inductive HB : Nat → Nat → Prop
  | refl (i) : HB i i
  | prev {j i l} : lastBefore t (t.proc i) i = some l → HB j l → HB j i
  | msg {j i s} : t.src i = some s → HB j s → HB j i

variable {t}

theorem lastBefore_lt {p i l : Nat} (h : lastBefore t p i = some l) : l < i ∧ t.proc l = p := by
  induction i with
  | zero => simp [lastBefore] at h
  | succ n ih =>
    simp only [lastBefore] at h
    split at h
    · cases h; exact ⟨Nat.lt_succ_self _, by assumption⟩
    · have := ih h; exact ⟨Nat.lt_succ_of_lt this.1, this.2⟩

theorem lastBefore_max {p i l : Nat} (h : lastBefore t p i = some l) :
    ∀ j, j < i → t.proc j = p → j ≤ l := by
  induction i with
  | zero => simp [lastBefore] at h
  | succ n ih =>
    intro j hj hp
    simp only [lastBefore] at h
    split at h
    · cases h; omega
    · rcases Nat.lt_succ_iff_lt_or_eq.1 hj with hj | hj
      · exact ih h j hj hp
      · subst hj; contradiction

theorem lastBefore_none {p i : Nat} (h : lastBefore t p i = none) :
    ∀ j, j < i → t.proc j ≠ p := by
  induction i with
  | zero => intro j hj; omega
  | succ n ih =>
    intro j hj hp
    simp only [lastBefore] at h
    split at h
    · contradiction
    · rcases Nat.lt_succ_iff_lt_or_eq.1 hj with hj | hj
      · exact ih h j hj hp
      · subst hj; contradiction

theorem cnt_succ (q n : Nat) :
    cnt t q (n + 1) = cnt t q n + if t.proc n = q then 1 else 0 := rfl

theorem cnt_mono (q : Nat) {m n : Nat} (h : m ≤ n) : cnt t q m ≤ cnt t q n := by
  induction h with
  | refl => exact Nat.le_refl _
  | step _ ih => rw [cnt_succ]; omega

theorem cnt_lt {q j n : Nat} (hj : j < n) (hp : t.proc j = q) : cnt t q j < cnt t q n := by
  have : cnt t q (j + 1) = cnt t q j + 1 := by rw [cnt_succ, if_pos hp]
  have := cnt_mono (t := t) q (show j + 1 ≤ n by omega)
  omega

/-- no event on `p` strictly between `l` and `i` -/
theorem cnt_gap {p i l : Nat} (h : lastBefore t p i = some l) :
    cnt t p i = cnt t p (l + 1) := by
  have ⟨hl, _⟩ := lastBefore_lt h
  have hm := lastBefore_max h
  suffices ∀ d, l + 1 + d ≤ i → cnt t p (l + 1 + d) = cnt t p (l + 1) by
    have := this (i - (l + 1)) (by omega)
    rwa [show l + 1 + (i - (l + 1)) = i by omega] at this
  intro d
  induction d with
  | zero => intro; rfl
  | succ d ih =>
    intro hd
    rw [show l + 1 + (d + 1) = (l + 1 + d) + 1 by omega, cnt_succ]
    split
    · have := hm (l + 1 + d) (by omega) (by assumption); omega
    · rw [ih (by omega)]; rfl

theorem cnt_zero {p i : Nat} (h : lastBefore t p i = none) : cnt t p i = 0 := by
  have hn := lastBefore_none h
  induction i with
  | zero => rfl
  | succ n ih =>
    have h' : lastBefore t p n = none := by
      simp only [lastBefore] at h; split at h
      · contradiction
      · exact h
    rw [cnt_succ, ih h' (fun j hj => hn j (by omega)), if_neg (hn n (by omega))]

theorem pos_inj {j j' : Nat} (hp : t.proc j = t.proc j') (h : pos t j = pos t j') : j = j' := by
  unfold pos at h; rw [hp] at h
  rcases Nat.lt_trichotomy j j' with hl | he | hl
  · have := cnt_lt (t := t) hl hp; omega
  · exact he
  · have := cnt_lt (t := t) hl rfl; omega

theorem hist_stable : ∀ {n m j : Nat}, j < n → n ≤ m → hist t m j = hist t n j := by
  intro n m j hj hm
  induction hm with
  | refl => rfl
  | @step m hle ih =>
    have : n ≤ m := hle
    show (if j = m then step t (hist t m) m else hist t m j) = _
    rw [if_neg (by omega)]; exact ih

theorem hist_self (i : Nat) : hist t (i + 1) i = step t (hist t i) i := by
  show (if i = i then step t (hist t i) i else hist t i i) = _
  exact if_pos rfl

theorem hist_V {i l : Nat} (h : l < i) : hist t i l = V t l := by
  unfold V; exact hist_stable (Nat.lt_succ_self l) h

theorem ov_congr {i q : Nat} : ∀ {o : Option Nat}, (∀ l, o = some l → l < i) →
    ov (hist t i) q o = ov (V t) q o
  | none, _ => rfl
  | some l, h => by simp only [ov]; rw [hist_V (h l rfl)]

theorem V_eq (i q : Nat) :
    V t i q = (if q = t.proc i then 1 else 0) +
      max (ov (V t) q (lastBefore t (t.proc i) i)) (ov (V t) q (t.src i)) := by
  show hist t (i + 1) i q = _
  rw [hist_self, step, ov_congr (fun l h => (lastBefore_lt h).1),
    ov_congr (fun l h => t.src_lt i l h)]

theorem HB_le {j i : Nat} (h : HB t j i) : j ≤ i := by
  induction h with
  | refl => exact Nat.le_refl _
  | prev hl _ ih => have := (lastBefore_lt hl).1; omega
  | msg hs _ ih => have := t.src_lt _ _ hs; omega

theorem HB_trans {a b c : Nat} (h1 : HB t a b) (h2 : HB t b c) : HB t a c := by
  induction h2 with
  | refl => exact h1
  | prev hl _ ih => exact .prev hl ih
  | msg hs _ ih => exact .msg hs ih

/-- HB contains program order -/
theorem HB_po : ∀ (i j : Nat), j ≤ i → t.proc j = t.proc i → HB t j i := by
  intro i
  induction i using Nat.strongRecOn with
  | ind i ih =>
    intro j hj hp
    rcases Nat.lt_or_eq_of_le hj with hj | hj
    · cases h : lastBefore t (t.proc i) i with
      | none => exact absurd hp (lastBefore_none h j hj)
      | some l =>
        have ⟨hl, hpl⟩ := lastBefore_lt h
        exact .prev h (ih l hl j (lastBefore_max h j hj hp) (by rw [hp, hpl]))
    · subst hj; exact .refl _

/-- the tick-rule clock counts: `k < V i q` iff the event of `q` at index
    `k` happens before or equals `i` -/
theorem count : ∀ i q k, k < V t i q ↔ ∃ j, t.proc j = q ∧ pos t j = k ∧ HB t j i := by
  intro i
  induction i using Nat.strongRecOn with
  | ind i ih =>
    -- the own component is pos i + 1
    have bound : ∀ s, s < i → V t s (t.proc i) ≤ pos t i := by
      intro s hs
      apply Nat.le_of_not_lt; intro hlt
      obtain ⟨j, hpj, hk, hj⟩ := (ih s hs _ (pos t i)).1 hlt
      have := cnt_lt (t := t) (Nat.lt_of_le_of_lt (HB_le hj) hs) hpj
      unfold pos at hk; rw [hpj] at hk; omega
    have own : max (ov (V t) (t.proc i) (lastBefore t (t.proc i) i))
        (ov (V t) (t.proc i) (t.src i)) = pos t i := by
      have hL : ov (V t) (t.proc i) (lastBefore t (t.proc i) i) = pos t i := by
        cases h : lastBefore t (t.proc i) i with
        | none => simp only [ov, pos]; rw [cnt_zero h]
        | some l =>
          have ⟨hl, hpl⟩ := lastBefore_lt h
          simp only [ov]
          apply Nat.le_antisymm (bound l hl)
          unfold pos; rw [cnt_gap h]
          apply Nat.le_of_not_lt; intro hlt
          -- the events of proc i up to l are all below V l
          have hown : pos t l < V t l (t.proc l) :=
            (ih l hl _ _).2 ⟨l, rfl, rfl, .refl _⟩
          have : cnt t (t.proc i) (l + 1) = pos t l + 1 := by
            rw [cnt_succ, if_pos hpl, pos, hpl]
          rw [hpl] at hown; omega
      have hM : ov (V t) (t.proc i) (t.src i) ≤ pos t i := by
        cases h : t.src i with
        | none => simp [ov]
        | some s => exact bound s (t.src_lt i s h)
      omega
    intro q k
    rw [V_eq]
    constructor
    · intro hk
      by_cases hlt : k < max (ov (V t) q (lastBefore t (t.proc i) i)) (ov (V t) q (t.src i))
      · rcases (show k < ov (V t) q (lastBefore t (t.proc i) i) ∨ k < ov (V t) q (t.src i) by omega) with h | h
        · cases hl : lastBefore t (t.proc i) i with
          | none => simp [hl, ov] at h
          | some l =>
            rw [hl] at h
            obtain ⟨j, a, b, c⟩ := (ih l (lastBefore_lt hl).1 q k).1 h
            exact ⟨j, a, b, .prev hl c⟩
        · cases hs : t.src i with
          | none => simp [hs, ov] at h
          | some s =>
            rw [hs] at h
            obtain ⟨j, a, b, c⟩ := (ih s (t.src_lt i s hs) q k).1 h
            exact ⟨j, a, b, .msg hs c⟩
      · split at hk
        · rename_i hq; subst hq
          exact ⟨i, rfl, by omega, .refl _⟩
        · omega
    · rintro ⟨j, hpj, hk, hj⟩
      cases hj with
      | refl => subst hpj; rw [if_pos rfl, own]; omega
      | prev hl hj' =>
        have := (ih _ (lastBefore_lt hl).1 q k).2 ⟨j, hpj, hk, hj'⟩
        have : k < ov (V t) q (lastBefore t (t.proc i) i) := by rw [hl]; exact this
        omega
      | msg hs hj' =>
        have := (ih _ (t.src_lt _ _ hs) q k).2 ⟨j, hpj, hk, hj'⟩
        have : k < ov (V t) q (t.src i) := by rw [hs]; exact this
        omega

theorem own (i : Nat) : pos t i < V t i (t.proc i) :=
  (count i _ _).2 ⟨i, rfl, rfl, .refl _⟩

def vle (u v : Nat → Nat) : Prop := ∀ q, u q ≤ v q
def vlt (u v : Nat → Nat) : Prop := vle u v ∧ ∃ q, u q < v q

/-- T24, non-strict, both directions, for the tick-rule clock -/
theorem hb_iff (j i : Nat) : HB t j i ↔ vle (V t j) (V t i) := by
  constructor
  · intro h q
    apply Nat.le_of_not_lt; intro hlt
    obtain ⟨j', a, b, c⟩ := (count j q (V t i q)).1 hlt
    have := (count i q (V t i q)).2 ⟨j', a, b, HB_trans c h⟩
    omega
  · intro h
    obtain ⟨j', a, b, c⟩ := (count i (t.proc j) (pos t j)).1
      (Nat.lt_of_lt_of_le (own j) (h _))
    rwa [← pos_inj a b]

/-- T24, strict, both directions -/
theorem hb_lt_iff (j i : Nat) : (HB t j i ∧ j ≠ i) ↔ vlt (V t j) (V t i) := by
  constructor
  · rintro ⟨h, hne⟩
    refine ⟨(hb_iff j i).1 h, t.proc i, ?_⟩
    have hji : j < i := Nat.lt_of_le_of_ne (HB_le h) hne
    apply Nat.lt_of_not_le; intro hle
    obtain ⟨j', a, b, c⟩ := (count j (t.proc i) (pos t i)).1
      (Nat.lt_of_lt_of_le (own i) hle)
    have := pos_inj a b
    subst this
    have := HB_le c; omega
  · rintro ⟨h, q, hq⟩
    refine ⟨(hb_iff j i).2 h, ?_⟩
    rintro rfl; omega

end RCE.TickClock
