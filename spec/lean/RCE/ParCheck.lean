import RCE.ParSem
/-! Checked correspondence between the small-step semantics of `ParSem` and
    the reference evaluator (`interp`, Rust). `WFb` decides W-PAR-1 on the
    core; `vector_sound` turns a computed big-step value into a statement
    about every complete small-step interleaving (via `par_det`). The file
    `ParVectors.lean` is generated by the checker test
    `tests/lean_vectors.rs`: random well-formed core programs with `par`
    are run by the Rust evaluator, and each recorded final value becomes a
    theorem here, checked by the Lean kernel. This is a correspondence on
    test vectors, not a refinement proof of the Rust evaluator. -/
namespace RCE.ParSem

def disjb (l m : List Nat) : Bool := l.all (fun x => !(m.contains x))

theorem disjb_sound {l m : List Nat} (h : disjb l m = true) : Disj l m := by
  intro x hx hm
  unfold disjb at h
  rw [List.all_eq_true] at h
  have := h x hx
  simp [List.contains, List.elem_iff] at this
  exact this hm

def WFb : St → Bool
  | .skip | .assign _ _ => true
  | .seq a b | .ite _ a b => WFb a && WFb b
  | .par a b => WFb a && WFb b && disjb (W a) (FV b) && disjb (W b) (FV a)

theorem WFb_sound : ∀ s, WFb s = true → WF s
  | .skip, _ => trivial
  | .assign _ _, _ => trivial
  | .seq a b, h => by
    simp [WFb] at h
    exact ⟨WFb_sound a h.1, WFb_sound b h.2⟩
  | .ite _ a b, h => by
    simp [WFb] at h
    exact ⟨WFb_sound a h.1, WFb_sound b h.2⟩
  | .par a b, h => by
    simp only [WFb, Bool.and_eq_true] at h
    exact ⟨WFb_sound a h.1.1.1, WFb_sound b h.1.1.2, disjb_sound h.1.2, disjb_sound h.2⟩

/-- a store given by a list of initial values (0 beyond it) -/
def st0 (vs : List Int) : Store := fun x => vs.getD x 0

/-- every complete interleaving of a W-PAR-1 program ends with the
    big-step value at `x` -/
theorem vector_sound (s : St) (σ : Store) (x : Nat) (v : Int)
    (hw : WFb s = true) (he : exec s σ x = v) :
    ∀ n σ', Steps n s σ .skip σ' → σ' x = v := by
  intro n σ' h
  rw [par_det h (WFb_sound s hw)]
  exact he

end RCE.ParSem
