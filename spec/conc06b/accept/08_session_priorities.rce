# rce-version: 0.6
# Session graph with a cycle, accepted by priorities (W-SES-5, T28p): one
# spawn takes the ends of two channels, so the tree rule reports it, but
# `pair` and `main` both use c1 before c2, so the order on exchanges is
# acyclic and the program cannot deadlock. W-SES-5_spawn_two_endpoints
# uses them in opposite orders and is reported.
protocol Ask
    send i64
    recv i64

protocol Answer
    recv i64
    send i64

fn pair(a: session Answer, b: session Answer)
    let x = <- a
    let y = <- b
    a <- x
    b <- y

fn main()
    let (c1, s1) = chan[session Ask](1)
    let (c2, s2) = chan[session Ask](1)
    spawn pair(s1, s2)
    c1 <- 2
    c2 <- 1
    let r1 = <- c1
    let r2 = <- c2
    emit r1 + r2
