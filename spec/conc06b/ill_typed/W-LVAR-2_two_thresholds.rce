# rce-version: 0.6
# expect: W-LVAR-2
# Two thresholds of an lvar of integers under max are
# compatible (max(3, 5) = 5), so wait([5, 3]) would return 3 or 5
# depending on whether the put of 5 happened before the wait looked.
fn main()
    let x = lvar_new(0)
    var r: i64 = 0
    par
        branch a
            x.put(3)
        branch b
            x.put(5)
        branch c
            r = x.wait([5, 3])
    emit r
