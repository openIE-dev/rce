# rce-version: 0.6
# expect: W-SES-5
# one spawn takes two endpoints: two channels join the same two
# processes, a loop in the session graph that can deadlock
protocol Ask
    send i64
    recv i64

protocol Answer
    recv i64
    send i64

fn server(s: session Answer)
    let x = <- s
    s <- x * 2

fn pair(a: session Answer, b: session Answer)
    let x = <- a
    let y = <- b
    a <- x
    b <- y

fn main()
    let (c1, s1) = chan[session Ask](1)
    let (c2, s2) = chan[session Ask](1)
    spawn pair(s1, s2)
    c2 <- 1
    c1 <- 2
    let r1 = <- c1
    let r2 = <- c2
    emit r1 + r2
