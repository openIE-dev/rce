# An arena with a fixed capacity, and explicit wrapping arithmetic for hashing.
fn fnv1a(s: &text) -> u32
    var h: u32 = 2166136261
    with arena scratch bound 4096
        let cs: List[text] @scratch = s.chars()
        for c in cs
            h = (h ^ (c.len_bytes() as u32)).wrapping_mul(16777619)
    return h

check (250 as u8).wrapping_add(10) == 4
check (250 as u8).saturating_add(10) == 255
