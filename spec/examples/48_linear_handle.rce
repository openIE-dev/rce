# A linear handle must be consumed exactly once on every path.
linear struct File
    fd: i32

extern "C" fn c_open(w: &World, name: &text) -> File
extern "C" fn c_close(w: &World, f: File) -> i32
extern "C" fn c_write(w: &World, f: File, n: u32) -> File

fn main(w: &World)
    let p = "log.txt"
    let f = c_open(w, &p)
    let g = c_write(w, f, 3)
    if g.fd < 0
        let _ = c_close(w, g)
    else
        let r = c_close(w, g)
        emit r
