# rce-version: 0.6
fn main()
    let xs: List[f64] = [0.1, 0.2, 0.3, 1e16, -1e16, 0.4, 0.5, 0.6]
    var s: f64 = 0.0
    var t: f64 = 0.0
    par
        branch left
            for x in xs
                s += x
        branch right
            for x in xs
                t += x * 2.0
    emit s
    emit t
