fn feed(c: chan i64, base: i64)
    for i in 0..4
        c <- base + i
fn main()
    let a = chan[i64](1)
    let b = chan[i64](1)
    spawn feed(a, 10)
    spawn feed(b, 20)
    loop bound 20
        select
            recv v from a -> emit v
            recv w from b -> emit w
            after 2 -> break
