# Checks for effect. The context table is the one of RCE spec 5.2 (also
# checked against the reference checker by tests/effect/effect_probes.py);
# canonical JSON and oracle keys are confirmed against rce src/canon.rs
# (scripts/ref/canon); the rest is derived (scripts/gen/effect_gen.py).

fn ok2(f: fn(&text, &text) -> bool, a: text, b: text) -> bool = f(&a, &b)
fn cj(j: enc.Json) -> text = canon(&j)
fn hj(j: enc.Json) -> text = vhash(&j)
fn bc(a: text, b: text) -> i64 = byte_cmp(&a, &b)
fn dl(b: Backoff, n: u64) -> u64 = delay(&b, n)

struct OrOut
    got: List[enc.Json]
    hits: u64
    misses: u64
    last: text

fn oracle_run(ins: List[enc.Json], outs: List[enc.Json], asks: List[enc.Json]) -> OrOut
    var o = oracle_new()
    for i in 0..ins.len()
        oracle_record(&mut o, &ins[i], &outs[i])
    var got: List[enc.Json] = []
    for a in asks
        let r = oracle_ask(&mut o, &a)
        got.push(r.or(enc.JStr(t: "<miss>")))
    return OrOut(got: got, hits: o.hits, misses: o.misses, last: copy(o.last_miss))

fn retry_run(b: Backoff, sts: List[text], nows: List[u64]) -> text
    var r = retry_new()
    var log: List[text] = []
    for i in 0..sts.len()
        on_outcome(&mut r, &b, &sts[i], nows[i])
        if due(&r, r.wait_until) != (r.verdict == "retry")
            return "due wrong"
        if r.verdict == "retry" and r.wait_until > nows[i] and due(&r, nows[i])
            return "due early"
        log.push(r.verdict + "@" + r.wait_until.tostr())
    return " ".join(log)

struct Cmd
    dest: text
    n: i64

fn plans_ok() -> bool
    var p: Plan[Cmd] = plan_new()
    plan_add(&mut p, Cmd(dest: "a", n: 1))
    plan_add(&mut p, Cmd(dest: "b", n: 2))
    var q: Plan[Cmd] = plan_new()
    plan_add(&mut q, Cmd(dest: "c", n: 3))
    plan_then(&mut p, &q)
    let e: Plan[Cmd] = plan_new()
    plan_then(&mut q, &e)
    return plan_len(&p) == 3 and plan_cmds(&p) == [Cmd(dest: "a", n: 1), Cmd(dest: "b", n: 2), Cmd(dest: "c", n: 3)] and plan_len(&q) == 1 and plan_len(&e) == 0

check plans_ok()
check bc("a", "b") < 0
check bc("b", "a") > 0
check bc("a", "a") == 0
check bc("a", "aa") < 0
check bc("\u{e000}", "😀") < 0

