# expect: run
# events: Comment(body: "<script>x</script>")
# outcome: done
# outputs:
#   - 0 (initial) Page { html = "<p></p>", query = "", link = "/" }
#   - 1 Comment(body: "<script>x</script>") Page { html = "<p>&lt;script&gt;x&lt;/script&gt;</p>", query = "SELECT id FROM users WHERE name = '<script>x</script>'", link = "/search?q=%3Cscript%3Ex%3C%2Fscript%3E" }
#   - "  emit \"<p>&lt;script&gt;x&lt;/script&gt;</p>\""
