# rce-version: 0.8
module login

intent "secrets are opaque (5.16): no literal can make one, no output can carry one, equality is the one release"
    example Enroll(pw: "s3cret"), Login(pw: "s3cret") -> ok == 1
    example Enroll(pw: "s3cret"), Login(pw: "guess") -> failed == 1

state Vault
    stored: Secret[text]? = none
    ok: u32 = 0
    failed: u32 = 0

event Enroll(pw: Secret[text])
event Login(pw: Secret[text])

step Vault on Enroll(pw: p)
    stored = some(p)
step Vault on Login(pw: p)
    if stored == some(p)
        ok += 1
    else
        failed += 1
#--- rce-test
# id: forms-log/harvested/54-secret-ex6
# area: forms-log
# clauses: [CH00-M-61b6ac06, CH07-M-0a0bd71f, N10, N8, T1, T4, T5, T9]
# expect: run
# events: Enroll(pw: "s3cret"), Login(pw: "guess")
# outcome: done
# outputs:
#   - 0 (initial) Vault { stored = none, ok = 0, failed = 0 }
#   - 1 Enroll(pw: "s3cret") Vault { stored = some("s3cret"), ok = 0, failed = 0 }
#   - 2 Login(pw: "guess") Vault { stored = some("s3cret"), ok = 0, failed = 1 }
