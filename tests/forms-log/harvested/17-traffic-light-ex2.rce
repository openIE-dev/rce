intent "a traffic light that cycles on each tick"
    example Tick, Tick -> light == Yellow

kind Light
    Red
    Green
    Yellow

state Signal
    light: Light = Red

event Tick

step Signal on Tick
    match light
        Red -> light = Green
        Green -> light = Yellow
        Yellow -> light = Red
