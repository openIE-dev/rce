module files

intent "file effects: each request gets one logged result; a path outside the granted root fails"
    example Save(path: "a.txt", body: "x"), FileWriteDone(req: 1, status: "delivered", data: none, err: "") -> written == 1

struct FileWrite
    req: u64
    path: text
    data: text

struct FileRead
    req: u64
    path: text

struct FileList
    req: u64
    path: text

event Save(path: text, body: text)
event Load(path: text)
event Ls(path: text)
event FileWriteDone(req: u64, status: text, data: u64?, err: text)
event FileReadDone(req: u64, status: text, data: text?, err: text)
event FileListDone(req: u64, status: text, data: List[text]?, err: text)

state Fs
    next: u64 = 0
    written: u64 = 0
    content: text = ""
    names: List[text] = []
    errors: u64 = 0
    last_err: text = ""

step Fs on Save(path: p, body: b)
    next += 1
    emit FileWrite(req: next, path: p, data: b)

step Fs on Load(path: p)
    next += 1
    emit FileRead(req: next, path: p)

step Fs on Ls(path: p)
    next += 1
    emit FileList(req: next, path: p)

step Fs on FileWriteDone(req: _r, status: s, data: _d, err: e)
    if s == "delivered"
        written += 1
    else
        errors += 1
        last_err = e

step Fs on FileReadDone(req: _r, status: s, data: d, err: e)
    if s == "delivered"
        content = d.or("")
    else
        errors += 1
        last_err = e

step Fs on FileListDone(req: _r, status: s, data: d, err: _e)
    if s == "delivered"
        names = d.or([])
    else
        errors += 1
