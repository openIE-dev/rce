# events: Call(code: "m", func: "f", args: [1]), WasmCallDone(req: 1, status: "failed", data: none, err: "trap")
# outcome: done
# outputs:
#   - 0 (initial) F { next = 0, results = [], traps = 0 }
#   - 1 Call(code: "m", func: "f", args: [1]) F { next = 1, results = [], traps = 0 }
#   - "  emit WasmCall(req: 1, code: \"m\", func: \"f\", args: [1])"
#   - 2 WasmCallDone(req: 1, status: "failed", data: none, err: "trap") F { next = 1, results = [], traps = 1 }
