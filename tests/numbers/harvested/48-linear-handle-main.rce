# A linear handle must be consumed exactly once on every path.
linear struct File
    fd: i32

extern "C" fn c_open(path: &text) -> File
extern "C" fn c_close(f: File) -> i32
extern "C" fn c_write(f: File, n: u32) -> File

fn main()
    let p = "log.txt"
    let f = c_open(&p)
    let g = c_write(f, 3)
    if g.fd < 0
        let _ = c_close(g)
    else
        let r = c_close(g)
        emit r
