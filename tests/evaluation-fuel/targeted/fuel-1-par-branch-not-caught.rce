# rce-version: 0.6
fn spin(n: i64) -> i64
    var s = 0
    for i in 0..n
        s += i
    return s
fn main()
    var a = 0
    var b = 0
    with budget 1000000000
        par
            branch x
                a = spin(100000)
            branch y
                b = 1
    else
        a = -1
    emit a
    emit b
