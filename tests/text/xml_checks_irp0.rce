# generated by scripts/gen/xml_gen.py; do not edit
# canonical dump: "<{ns}local a=[v]...>" children "</>", attributes as
# written minus namespace declarations, comments dropped (as lxml's tree)
fn xc(x: &Xml, n: i64) -> text bound 256
    if x.nk[n as usize] == TEXT
        return copy(x.txt[n as usize])
    var o = "<{" + x.ns[n as usize] + "}" + x.name[n as usize]
    for k in 0..x.an[n as usize].len()
        let a = copy(x.an[n as usize][k])
        if a != "xmlns" and not a.startswith("xmlns:")
            o = o + " " + a + "=[" + x.av[n as usize][k] + "]"
    o = o + ">"
    for k in x.kids[n as usize]
        o = o + xc(x, k)
    return o + "</>"
fn xcanon(s: text) -> text
    let x = parse(&s)
    if not x.ok
        return "err " + x.why
    return xc(&x, root(&x))
# 144/test144.scxml
check xcanon("<!-- test that events are inserted into the queue in the order in which they are raised.  If\nfoo occurs before bar, success, otherwise failure --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n  <onentry>\n    <raise event=\"foo\"/>\n    <raise event=\"bar\"/>\n    </onentry>\n  <transition event=\"foo\" target=\"s1\"/>\n  <transition event=\"*\" target=\"fail\"/>\n   \n </state>\n\n<state id=\"s1\">\n  <transition event=\"bar\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/> \n  </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[s1]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   \n </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n  </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 148/test148.scxml
check xcanon("<!-- test that the else clause executes if <if> and <elseif> evaluate to false.\nBaz should be the only event generated by the <if>.  bat is raised to catch the case where the <else> clause\nfails and baz is not generated, i.e. it makes sure that the test doesn't hang.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n  <if cond=\"false\">\n    <raise event=\"foo\"/>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n  <elseif cond=\"false\"/>\n    <raise event=\"bar\"/>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n  <else/>\n    <raise event=\"baz\"/>\n   <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </if>\n   <raise event=\"bat\"/>\n    </onentry>\n  <transition event=\"baz\" cond=\"\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n   \n </state>\n\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  <{http://www.w3.org/2005/07/scxml}if cond=[false]>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n  <{http://www.w3.org/2005/07/scxml}elseif cond=[false]></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n  <{http://www.w3.org/2005/07/scxml}else></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[baz]></>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}raise event=[bat]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[baz] cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   \n </>\n\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 150/test150.scxml
check xcanon("<!-- test that foreach causes a new variable to be declared if 'item' doesn't already exist.  Also\ntest that it will use an existing var if it does exist. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\"/>\n  <data id=\"Var2\"/>\n  <data id=\"Var3\">\n    [1,2,3]\n    </data>\n  </datamodel>\n  \n   <state id=\"s0\">\n      <onentry>\n<!-- first use declared variables -->\n        <foreach item=\"Var1\" index=\"Var2\" array=\"Var3\"/>\n        <raise event=\"foo\"/>\n        </onentry>\n   <transition event=\"error\" target=\"fail\"/>\n   <transition event=\"*\" target=\"s1\"/> \n   </state>\n   \n<state id=\"s1\">\n     <onentry>\n<!-- now use undeclared variables -->\n        <foreach item=\"Var4\" index=\"Var5\" array=\"Var3\"/>\n        <raise event=\"bar\"/>\n        </onentry>\n   <transition event=\"error\" target=\"fail\"/>\n   <transition event=\"*\" target=\"s2\"/> \n   </state>\n\n<state id=\"s2\">\n  <!-- check that var4 is bound -->\n  <transition cond=\"Var4\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var3]>\n    [1,2,3]\n    </>\n  </>\n  \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n\n        <{http://www.w3.org/2005/07/scxml}foreach item=[Var1] index=[Var2] array=[Var3]></>\n        <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n        </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[fail]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[s1]></> \n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n     <{http://www.w3.org/2005/07/scxml}onentry>\n\n        <{http://www.w3.org/2005/07/scxml}foreach item=[Var4] index=[Var5] array=[Var3]></>\n        <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n        </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[fail]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[s2]></> \n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n  \n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var4] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n\n\n</>"
# 152/test152.scxml
check xcanon("<!-- test that an illegal array or item value causes error.execution and results in executable content\nnot being executed. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  <data id=\"Var2\"/>\n  <data id=\"Var3\"/>\n  <data id=\"Var4\" expr=\"7\"/>\n  <data id=\"Var5\">\n    [1,2,3]\n    </data>\n  </datamodel>\n  \n   <state id=\"s0\">\n      <onentry>\n<!-- invalid array, legal item -->\n        <foreach item=\"Var2\" index=\"Var3\" array=\"Var4\">\n          <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n          </foreach>\n        <raise event=\"foo\"/>\n        </onentry>\n   <transition event=\"error.execution\" target=\"s1\"/>\n   <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n   <state id=\"s1\">\n      <onentry>\n<!-- illegal item, legal array -->\n        <foreach item=\"'continue'\" index=\"Var3\" array=\"Var5\">\n          <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n          </foreach>\n        <raise event=\"bar\"/>\n        </onentry>\n   <transition event=\"error.execution\" target=\"s2\"/>\n   <transition event=\"bar\" target=\"fail\"/> \n   </state>\n\n<state id=\"s2\">\n  <!-- check that var1 has its original value (so executable content never got executed -->\n  <transition cond=\"\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state> \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var3]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var4] expr=[7]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var5]>\n    [1,2,3]\n    </>\n  </>\n  \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n\n        <{http://www.w3.org/2005/07/scxml}foreach item=[Var2] index=[Var3] array=[Var4]>\n          <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n          </>\n        <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n        </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n\n        <{http://www.w3.org/2005/07/scxml}foreach item=['continue'] index=[Var3] array=[Var5]>\n          <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n          </>\n        <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n        </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s2]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[bar] target=[fail]></> \n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n  \n  <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </> \n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n\n\n</>"
# 155/test155.scxml
check xcanon("<!-- test that foreach executes the executable content once for each item in the list '(1,2,3)'. The executable\ncontent sums the items into var1 so it should be 6 at the end --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  <data id=\"Var2\"/>\n  <data id=\"Var3\">\n    [1,2,3]\n    </data>\n  </datamodel>\n  \n   <state id=\"s0\">\n      <onentry>\n        <foreach item=\"Var2\" array=\"Var3\">\n          <assign location=\"Var1\" expr=\"Var1 + Var2\"/>\n          </foreach>\n        </onentry>\n\n  <transition cond=\"\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state> \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var3]>\n    [1,2,3]\n    </>\n  </>\n  \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n        <{http://www.w3.org/2005/07/scxml}foreach item=[Var2] array=[Var3]>\n          <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + Var2]></>\n          </>\n        </>\n\n  <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </> \n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n</>"
# 158/test158.scxml
check xcanon("<!-- test that executable content executes in document order.  if event1 occurs then event2, succeed, otherwise fail --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <raise event=\"event1\"/>\n   <raise event=\"event2\"/>\n    </onentry>\n  <transition event=\"event1\" target=\"s1\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n<state id=\"s1\">\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n   <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s1]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 172/test172.scxml
check xcanon("<!-- we test that eventexpr uses the current value of var1, not its initial value  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"'event1'\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"'event2'\"/>\n   <send eventexpr=\"Var1\"/>\n    </onentry>\n    \n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=['event1']></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=['event2']></>\n   <{http://www.w3.org/2005/07/scxml}send eventexpr=[Var1]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 174/test174.scxml
check xcanon("<!-- we test that typeexpr uses the current value of var1, not its initial value\n(If it uses the initial value, it will generate an error.  If it uses the current value, event1 will be raised  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"27\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"'http://www.w3.org/TR/scxml/#SCXMLEventProcessor'\"/>\n   <send typeexpr=\"Var1\" event=\"event1\"/>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[27]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=['http://www.w3.org/TR/scxml/#SCXMLEventProcessor']></>\n   <{http://www.w3.org/2005/07/scxml}send typeexpr=[Var1] event=[event1]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 176/test176.scxml
check xcanon("<!-- we test that <param> uses the current value of var1, not its initial value.  If the value of\naParam in event1 is 2 so that var2 gets set to 2, success, otherwise failure  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n  <data id=\"Var2\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"2\"/>\n   <send event=\"event1\">\n     <param name=\"aParam\" expr=\"Var1\"/>\n     </send>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"s1\">\n  <assign location=\"Var2\" expr=\"_event.data.aParam\"/>\n  </transition>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n<state id=\"s1\">\n  <transition cond=\"\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n     \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[2]></>\n   <{http://www.w3.org/2005/07/scxml}send event=[event1]>\n     <{http://www.w3.org/2005/07/scxml}param name=[aParam] expr=[Var1]></>\n     </>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s1]>\n  <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[_event.data.aParam]></>\n  </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n     \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 179/test179.scxml
check xcanon("<!-- we test that <content> can be used to populate body of a message --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n  <onentry>\n   <send event=\"event1\">\n   <content>123</content>\n   </send>\n    </onentry>\n    \n  <transition event=\"event1\" cond=\"_event.data == 123\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send event=[event1]>\n   <{http://www.w3.org/2005/07/scxml}content>123</>\n   </>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] cond=[_event.data == 123] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 185/test185.scxml
check xcanon("<!-- we test that <send> respects the delay specification.  If it does, event1 arrives before event2\n and we pass.  Otherwise we fail  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n  <onentry>\n   <send event=\"event2\" delayexpr=\"'1s'\"/>\n   <send event=\"event1\"/>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"s1\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n<state id=\"s1\">\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n       \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send event=[event2] delayexpr=['1s']></>\n   <{http://www.w3.org/2005/07/scxml}send event=[event1]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s1]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n       \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 187/test187.scxml
check xcanon("<!-- we test that delayed <send> is not sent if the sending session terminates.  In this case,\na subscript is invoked which sends the event childToParent delayed by 1 second, and then terminates.  The\nparent session, should not receive childToParent. If it does, we fail.  Otherwise the \n10 sec timer expires and we pass --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n    <onentry>\n      <send event=\"timeout\" delayexpr=\"'1s'\"/>\n      </onentry>\n    <invoke type=\"scxml\">\n    <content>\n      <!-- exit before the delayed send can execute -->\n         <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n           <state id=\"sub0\">\n              <onentry>\n                <send event=\"childToParent\" target=\"#_parent\" delayexpr=\"'.5s'\"/>\n            </onentry>\n          <transition target=\"subFinal\"/>\n          </state>\n      <final id=\"subFinal\"/>\n    </scxml>\n    </content>\n   </invoke>\n   \n    <transition event=\"childToParent\" target=\"fail\"/>\n    <transition event=\"timeout\" target=\"pass\"/>\n</state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n      <{http://www.w3.org/2005/07/scxml}send event=[timeout] delayexpr=['1s']></>\n      </>\n    <{http://www.w3.org/2005/07/scxml}invoke type=[scxml]>\n    <{http://www.w3.org/2005/07/scxml}content>\n      \n         <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n           <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n              <{http://www.w3.org/2005/07/scxml}onentry>\n                <{http://www.w3.org/2005/07/scxml}send event=[childToParent] target=[#_parent] delayexpr=['.5s']></>\n            </>\n          <{http://www.w3.org/2005/07/scxml}transition target=[subFinal]></>\n          </>\n      <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n    </>\n    </>\n   </>\n   \n    <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] target=[fail]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[pass]></>\n</>\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 190/test190.scxml
check xcanon("<!-- we test that #_scxml_sessionid as a target of <send> puts the event on the external queue.  If it does,\nevent1 will be processed before event2, because event1 is added to the internal queue while event2 is\nadded to the external queue (event though event2 is generated first).  we have to make sure that event2\nis actually delivered.  The delayed <send> makes sure another event is generated (so the test doesn't hang) --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n <data id=\"Var1\" expr=\"'#_scxml_'\"/>\n <data id=\"Var2\" expr=\"_sessionid\"/>\n </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n  <assign location=\"Var1\" expr=\"Var1 + Var2\"/>\n   <!-- goes to the external queue -->\n   <send event=\"event2\" targetexpr=\"Var1\"/>\n   <!-- to the internal queue -->\n   <raise event=\"event1\"/>\n   <!-- this should get added to the external queue after event2 -->\n   <send event=\"timeout\"/>\n    </onentry>\n \n <!-- once we've entered the state, we should check for internal events first -->   \n  <transition event=\"event1\" target=\"s1\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n<!-- now check that we get event2 and not a timeout -->\n<state id=\"s1\">\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=['#_scxml_']></>\n <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[_sessionid]></>\n </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + Var2]></>\n   \n   <{http://www.w3.org/2005/07/scxml}send event=[event2] targetexpr=[Var1]></>\n   \n   <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n   \n   <{http://www.w3.org/2005/07/scxml}send event=[timeout]></>\n    </>\n \n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s1]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 192/test192.scxml
check xcanon("<!-- we test that #_invokeid works as  a target of  <send> .  A child  script is invoked and sends us\nchildToParent once its running.  Then we send it the event parentToChild using its invokeid as the target.  \nIf it receives this event, it sends sends the event eventReceived to its parent session (ths session). \nIf we get this event, we pass, otherwise the child script eventually times out sends invoke.done and we fail.\nWe also set a timeout in this process to make sure the test doesn't hang  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n  \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n   <send event=\"timeout\" delay=\"5s\"/>\n   </onentry>\n   \n  <invoke type=\"scxml\" id=\"invokedChild\">\n    <content>\n    <!-- let the parent session know we're running by sending childToParent, then wait for parentToChild.\n       If we get it, send eventReceived.  If we don't we eventually time out -->\n          <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n \n         <state id=\"sub0\">\n            <onentry>\n           <send event=\"childToParent\" target=\"#_parent\"/>\n            <send event=\"timeout\" delay=\"3s\"/>\n          </onentry>\n    \n        <transition event=\"parentToChild\" target=\"subFinal\">\n          <send target=\"#_parent\" event=\"eventReceived\"/>\n         </transition>\n    \n          <transition event=\"timeout\" target=\"subFinal\"/>\n         </state>\n\n        <final id=\"subFinal\"/>\n\n         </scxml>\n      </content>\n     </invoke>\n     \n  <transition event=\"timeout\" target=\"fail\"/> \n  <transition event=\"done.invoke\" target=\"fail\"/>\n  \n<state id=\"s01\">\n    <transition event=\"childToParent\" target=\"s02\">\n         <send target=\"#_invokedChild\" event=\"parentToChild\"/>\n     </transition>\n</state>\n\n<state id=\"s02\">\n  <transition event=\"eventReceived\" target=\"pass\"/>\n  </state>\n\n</state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[5s]></>\n   </>\n   \n  <{http://www.w3.org/2005/07/scxml}invoke type=[scxml] id=[invokedChild]>\n    <{http://www.w3.org/2005/07/scxml}content>\n    \n          <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n \n         <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n            <{http://www.w3.org/2005/07/scxml}onentry>\n           <{http://www.w3.org/2005/07/scxml}send event=[childToParent] target=[#_parent]></>\n            <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></>\n          </>\n    \n        <{http://www.w3.org/2005/07/scxml}transition event=[parentToChild] target=[subFinal]>\n          <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[eventReceived]></>\n         </>\n    \n          <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[subFinal]></>\n         </>\n\n        <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n\n         </>\n      </>\n     </>\n     \n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></> \n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[fail]></>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s01]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] target=[s02]>\n         <{http://www.w3.org/2005/07/scxml}send target=[#_invokedChild] event=[parentToChild]></>\n     </>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s02]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[eventReceived] target=[pass]></>\n  </>\n\n</>\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 194/test194.scxml
check xcanon("<!-- we test that specifying an illegal target for <send> causes the event error.execution to be raised.  If it does,\nwe succeed.  Otherwise we eventually timeout and fail.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n  <onentry>\n   <!-- should cause an error -->\n   <send target=\"baz\" event=\"event2\"/>\n   <!-- this will get added to the external event queue after the error has been raised -->\n   <send event=\"timeout\"/>\n    </onentry>\n \n <!-- once we've entered the state, we should check for internal events first -->   \n  <transition event=\"error.execution\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   \n   <{http://www.w3.org/2005/07/scxml}send target=[baz] event=[event2]></>\n   \n   <{http://www.w3.org/2005/07/scxml}send event=[timeout]></>\n    </>\n \n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 199/test199.scxml
check xcanon("<!-- we test that using an invalid send type results in error.execution --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n<state id=\"s0\">\n  <onentry>\n   <send type=\"27\" event=\"event1\"/>\n   <send event=\"timeout\"/>\n    </onentry>\n \n \n  <transition event=\"error.execution\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send type=[27] event=[event1]></>\n   <{http://www.w3.org/2005/07/scxml}send event=[timeout]></>\n    </>\n \n \n  <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 201/test201.scxml
check xcanon("<!-- we test that the processor supports the basic http event i/o processor.  This is an optional\ntest since platforms are not required to support basic http event i/o --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n<state id=\"s0\">\n  <onentry>\n   <send type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\" targetexpr=\"_ioprocessors['basichttp']['location']\" event=\"event1\"/>\n   <send event=\"timeout\"/>\n    </onentry>\n \n \n  <transition event=\"event1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor] targetexpr=[_ioprocessors['basichttp']['location']] event=[event1]></>\n   <{http://www.w3.org/2005/07/scxml}send event=[timeout]></>\n    </>\n \n \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 207/test207.scxml
check xcanon("<!-- we test that that we can't  cancel an event in another session.  We invoke a child process.  It notifies\nus when it has generated a delayed event with sendid foo.  We try to cancel foo.  The child  process sends us event\n event success if the event is not cancelled, event fail otherwise.  This doesn't test that there is absolutely no way to cancel an event\nraised in another session, but the spec doesn't define any way to refer to an event in another process  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n   \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delayexpr=\"'2s'\"/>\n    </onentry>\n  <invoke type=\"scxml\">\n    <content>\n    <!-- when invoked, we raise a delayed event1 with sendid 'foo' and notify our parent.  Then we wait.\n      If event1 occurs, the parent hasn't succeeded in canceling it and we return pass.  If event2 occurs\n      it means event1 was canceled (because event2 is delayed longer than event1) and we return 'fail'.  -->\n\n\n         <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n           <state id=\"sub0\">\n            <onentry>\n             <send event=\"event1\" id=\"foo\" delayexpr=\"'1s'\"/>\n              <send event=\"event2\" delayexpr=\"'1.5s'\"/>\n              <send target=\"#_parent\" event=\"childToParent\"/>\n              </onentry>\n \n               <transition event=\"event1\" target=\"subFinal\">\n                   <send target=\"#_parent\" event=\"pass\"/>\n                   </transition>\n               <transition event=\"*\" target=\"subFinal\">\n                      <send target=\"#_parent\" event=\"fail\"/>\n              </transition>\n \n               </state>\n            <final id=\"subFinal\"/>\n           </scxml>\n    </content>\n    </invoke>\n  \n  <state id=\"s01\">\n    <transition event=\"childToParent\" target=\"s02\">\n      <cancel sendid=\"foo\"/>\n      </transition>\n   </state>\n   \n <state id=\"s02\">\n  <transition event=\"pass\" target=\"pass\"/>\n  <transition event=\"fail\" target=\"fail\"/>\n  <transition event=\"timeout\" target=\"fail\"/>\n </state>\n \n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delayexpr=['2s']></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}invoke type=[scxml]>\n    <{http://www.w3.org/2005/07/scxml}content>\n    \n\n\n         <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n           <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n            <{http://www.w3.org/2005/07/scxml}onentry>\n             <{http://www.w3.org/2005/07/scxml}send event=[event1] id=[foo] delayexpr=['1s']></>\n              <{http://www.w3.org/2005/07/scxml}send event=[event2] delayexpr=['1.5s']></>\n              <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[childToParent]></>\n              </>\n \n               <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[subFinal]>\n                   <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[pass]></>\n                   </>\n               <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[subFinal]>\n                      <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[fail]></>\n              </>\n \n               </>\n            <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n           </>\n    </>\n    </>\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] target=[s02]>\n      <{http://www.w3.org/2005/07/scxml}cancel sendid=[foo]></>\n      </>\n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s02]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[pass] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[fail] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n </>\n \n</>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 210/test210.scxml
check xcanon("<!-- we test that sendidexpr works with cancel.  If it takes the most recent value of var1, it should cancel \ndelayed event1.  Thus we get event2 first and pass.  If we get event1 or an error first, cancel didn't work and we fail.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"'bar'\"/>\n  </datamodel>\n   \n<state id=\"s0\">\n  <onentry>\n   <send id=\"foo\" event=\"event1\" delayexpr=\"'1s'\"/>\n   <send event=\"event2\" delayexpr=\"'1.5s'\"/>\n   <assign location=\"Var1\" expr=\"'foo'\"/>\n   <cancel sendidexpr=\"Var1\"/>\n    </onentry>\n\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n \n </state>\n\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=['bar']></>\n  </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send id=[foo] event=[event1] delayexpr=['1s']></>\n   <{http://www.w3.org/2005/07/scxml}send event=[event2] delayexpr=['1.5s']></>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=['foo']></>\n   <{http://www.w3.org/2005/07/scxml}cancel sendidexpr=[Var1]></>\n    </>\n\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n \n </>\n\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 216/test216.scxml
check xcanon("<!-- we test that srcexpr is evaluated at runtime.  If the original value of var1 is used, the invocation\nwill fail (assuming that there is no script named 'foo').  If\nthe runtime value is used, the invocation will succeed --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"'foo'\"/>\n   </datamodel> \n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"5s\"/>\n   <assign location=\"Var1\" expr=\"'file:test216sub1.scxml'\"/>\n    </onentry>\n  <invoke srcexpr=\"Var1\" type=\"http://www.w3.org/TR/scxml\"/>\n  <transition event=\"done.invoke\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/> \n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=['foo']></>\n   </> \n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[5s]></>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=['file:test216sub1.scxml']></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}invoke srcexpr=[Var1] type=[http://www.w3.org/TR/scxml]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n</>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 220/test220.scxml
check xcanon("<!-- we test that the scxml type is supported.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"5s\"/>\n    </onentry>\n     <invoke type=\"http://www.w3.org/TR/scxml/\">\n     <content>\n       <!-- when invoked, terminate returning done.invoke. This proves that the invocation succeeded.   -->\n         <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n           <final id=\"subFinal\"/>\n          </scxml></content>\n     </invoke>\n  <transition event=\"done.invoke\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/> \n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[5s]></>\n    </>\n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n     <{http://www.w3.org/2005/07/scxml}content>\n       \n         <{http://www.w3.org/2005/07/scxml}scxml initial=[subFinal] version=[1.0] datamodel=[ecmascript]>\n           <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n          </></>\n     </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n</>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 224/test224.scxml
check xcanon("<!-- we test that the automatically generated id has the form stateid.platformid.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"Var1\"/>\n   <data id=\"Var2\" expr=\"'s0.'\"/>\n   </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n <invoke type=\"http://www.w3.org/TR/scxml/\" idlocation=\"Var1\">\n    <content> \n    <!-- when invoked, terminate returning done.invoke. This proves that the invocation succeeded.   -->\n      <scxml version=\"1.0\" initial=\"subFinal\" datamodel=\"ecmascript\">\n      <final id=\"subFinal\"/>\n      </scxml>\n     </content>\n    </invoke>\n\n  <transition event=\"*\" target=\"s1\"/>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=['s0.']></>\n   </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    </>\n <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] idlocation=[Var1]>\n    <{http://www.w3.org/2005/07/scxml}content> \n    \n      <{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[subFinal] datamodel=[ecmascript]>\n      <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n      </>\n     </>\n    </>\n\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[s1]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 226/test226.scxml
check xcanon("<!-- this is basically just a test that invoke works correctly and that you can pass data\nto the invoked process.  If the invoked session finds aParam==1, it exits, signalling\nsuccess.  otherwise it will hang and the timeout in this doc signifies failure.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    </onentry>\n\n \n   <invoke type=\"http://www.w3.org/TR/scxml/\" src=\"file:test226sub1.scxml\">\n      <param name=\"Var1\" expr=\"1\"/>\n      </invoke>\n\n  <transition event=\"varBound\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></>\n    </>\n\n \n   <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] src=[file:test226sub1.scxml]>\n      <{http://www.w3.org/2005/07/scxml}param name=[Var1] expr=[1]></>\n      </>\n\n  <{http://www.w3.org/2005/07/scxml}transition event=[varBound] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 228/test228.scxml
check xcanon("<!-- test that the invokeid is included in events returned from the invoked process.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"Var1\"/>\n   </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    </onentry>\n \n  <invoke type=\"http://www.w3.org/TR/scxml/\" id=\"foo\">\n   <content>\n     <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n      <final id=\"subFinal\"/>\n       </scxml>\n    </content>\n    </invoke>\n\n  <transition event=\"done.invoke\" target=\"s1\">\n    <assign location=\"Var1\" expr=\"_event.invokeid\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n   </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></>\n    </>\n \n  <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] id=[foo]>\n   <{http://www.w3.org/2005/07/scxml}content>\n     <{http://www.w3.org/2005/07/scxml}scxml initial=[subFinal] version=[1.0] datamodel=[ecmascript]>\n      <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n       </>\n    </>\n    </>\n\n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[s1]>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.invokeid]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 230/test230.scxml
check xcanon("<!-- a manual test that an autofowarded event has the same fields and values as the original event.\nthe child process sends the parent process an event which is forwarded back to it.  \nBoth the parent and child process print out the contents of the event. The tester \nmust check if they are the same and report his result.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    </onentry>\n  <invoke type=\"http://www.w3.org/TR/scxml/\" autoforward=\"true\">\n    <content>\n    <!-- when invoked, send childToParent to parent.  If it is forwarded back to us, print out its\n        fields and terminate.  -->\n        <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n           <state id=\"sub0\">\n            <onentry>\n              <send target=\"#_parent\" event=\"childToParent\"/> \n              <send event=\"timeout\" delay=\"2s\"/>\n             </onentry> \n           <transition event=\"childToParent\" target=\"subFinal\">\n                  <log label=\"name is \" expr=\"_event.name\"/>\n                  <log label=\"type is \" expr=\"_event.type\"/>\n                  <log label=\"sendid is \" expr=\"_event.sendid\"/>\n                 <log label=\"origin is \" expr=\"_event.origin\"/>\n                 <log label=\"origintype is \" expr=\"_event.origintype\"/>\n                 <log label=\"invokeid is \" expr=\"_event.invokeid\"/>\n                 <log label=\"data is \" expr=\"_event.data\"/>\n              </transition>\n          <transition event=\"*\" target=\"subFinal\"/>  \n          </state>\n        <final id=\"subFinal\"/>\n       </scxml>\n       </content>\n       </invoke>\n  <transition event=\"timeout\" target=\"final\"/>\n   \n \n  <state id=\"s01\">\n  <transition event=\"childToParent\" target=\"s02\">\n    <log label=\"name is \" expr=\"_event.name\"/>\n    <log label=\"type is \" expr=\"_event.type\"/>\n    <log label=\"sendid is \" expr=\"_event.sendid\"/>\n    <log label=\"origin is \" expr=\"_event.origin\"/>\n    <log label=\"origintype is \" expr=\"_event.origintype\"/>\n    <log label=\"invokeid is \" expr=\"_event.invokeid\"/>\n    <log label=\"data is \" expr=\"_event.data\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n <state id=\"s02\">\n  <!-- wait till we get the done event to ensure that the child process has time to print out its results -->\n   <transition event=\"done.invoke\" target=\"final\"/>\n   </state>\n\n</state>\n\n<final id=\"final\"/>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] autoforward=[true]>\n    <{http://www.w3.org/2005/07/scxml}content>\n    \n        <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n           <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n            <{http://www.w3.org/2005/07/scxml}onentry>\n              <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[childToParent]></> \n              <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n             </> \n           <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] target=[subFinal]>\n                  <{http://www.w3.org/2005/07/scxml}log label=[name is ] expr=[_event.name]></>\n                  <{http://www.w3.org/2005/07/scxml}log label=[type is ] expr=[_event.type]></>\n                  <{http://www.w3.org/2005/07/scxml}log label=[sendid is ] expr=[_event.sendid]></>\n                 <{http://www.w3.org/2005/07/scxml}log label=[origin is ] expr=[_event.origin]></>\n                 <{http://www.w3.org/2005/07/scxml}log label=[origintype is ] expr=[_event.origintype]></>\n                 <{http://www.w3.org/2005/07/scxml}log label=[invokeid is ] expr=[_event.invokeid]></>\n                 <{http://www.w3.org/2005/07/scxml}log label=[data is ] expr=[_event.data]></>\n              </>\n          <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[subFinal]></>  \n          </>\n        <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n       </>\n       </>\n       </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[final]></>\n   \n \n  <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] target=[s02]>\n    <{http://www.w3.org/2005/07/scxml}log label=[name is ] expr=[_event.name]></>\n    <{http://www.w3.org/2005/07/scxml}log label=[type is ] expr=[_event.type]></>\n    <{http://www.w3.org/2005/07/scxml}log label=[sendid is ] expr=[_event.sendid]></>\n    <{http://www.w3.org/2005/07/scxml}log label=[origin is ] expr=[_event.origin]></>\n    <{http://www.w3.org/2005/07/scxml}log label=[origintype is ] expr=[_event.origintype]></>\n    <{http://www.w3.org/2005/07/scxml}log label=[invokeid is ] expr=[_event.invokeid]></>\n    <{http://www.w3.org/2005/07/scxml}log label=[data is ] expr=[_event.data]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n <{http://www.w3.org/2005/07/scxml}state id=[s02]>\n  \n   <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[final]></>\n   </>\n\n</>\n\n<{http://www.w3.org/2005/07/scxml}final id=[final]></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 233/test233.scxml
check xcanon("<!-- test that finalize markup runs before the event is processed.  The invoked process will\nreturn 2 in _event.data.aParam, so that new value should be in force when we select\nthe transtitions.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n  </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    </onentry>\n  <invoke type=\"http://www.w3.org/TR/scxml/\">\n     <content>\n      <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n          <final id=\"subFinal\">\n            <onentry>\n            <send target=\"#_parent\" event=\"childToParent\">\n            <param name=\"aParam\" expr=\"2\"/>\n               </send> \n          </onentry> \n          </final>\n         </scxml>\n     </content>\n        <finalize>\n      <assign location=\"Var1\" expr=\"_event.data.aParam\"/>\n      </finalize>\n      </invoke>\n      \n  <transition event=\"childToParent\" cond=\"\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n</state>   \n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n  </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n     <{http://www.w3.org/2005/07/scxml}content>\n      <{http://www.w3.org/2005/07/scxml}scxml initial=[subFinal] version=[1.0] datamodel=[ecmascript]>\n          <{http://www.w3.org/2005/07/scxml}final id=[subFinal]>\n            <{http://www.w3.org/2005/07/scxml}onentry>\n            <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[childToParent]>\n            <{http://www.w3.org/2005/07/scxml}param name=[aParam] expr=[2]></>\n               </> \n          </> \n          </>\n         </>\n     </>\n        <{http://www.w3.org/2005/07/scxml}finalize>\n      <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.data.aParam]></>\n      </>\n      </>\n      \n  <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n</>   \n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 235/test235.scxml
check xcanon("<!-- test that done.invoke.id event has the right id.  the invoked child terminates immediately\nand should generate done.invoke.foo   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n  <invoke type=\"http://www.w3.org/TR/scxml/\" id=\"foo\">\n    <content>\n      <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n        <final id=\"subFinal\"/>\n        </scxml>\n        </content>\n        </invoke>\n      \n  <transition event=\"done.invoke.foo\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n</state>   \n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] id=[foo]>\n    <{http://www.w3.org/2005/07/scxml}content>\n      <{http://www.w3.org/2005/07/scxml}scxml initial=[subFinal] version=[1.0] datamodel=[ecmascript]>\n        <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n        </>\n        </>\n        </>\n      \n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke.foo] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n</>   \n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 237/test237.scxml
check xcanon("<!-- test that cancelling works. invoked child sleeps for two seconds, then terminates.  We\nsleep for 1 sec in s0, then move to s1.  This should cause the invocation to get cancelled.\nIf we receive done.invoke, the invocation wasn't cancelled, and we fail. If we receive no events by\nthe time timeout2 fires, success   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout1\" delayexpr=\"'1s'\"/>\n    </onentry>\n  <invoke type=\"http://www.w3.org/TR/scxml/\">\n    <content>\n      <!-- when invoked, sleep for 2 secs then terminate.  Parent will try to cancel this session -->\n         <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n           <state id=\"sub0\">\n            <onentry>\n              <send event=\"timeout\" delayexpr=\"'2s'\"/>\n                </onentry>\n               <transition event=\"timeout\" target=\"subFinal\"/>\n                </state>   \n            <final id=\"subFinal\"/>\n         </scxml>\n         </content>\n          </invoke>\n \n  <transition event=\"timeout1\" target=\"s1\"/>    \n\n</state>\n\n<state id=\"s1\">\n    <onentry>\n    <send event=\"timeout2\" delayexpr=\"'1.5s'\"/>\n    </onentry>\n  <!-- here we should NOT get done.invoke -->\n  <transition event=\"done.invoke\" target=\"fail\"/>\n  <transition event=\"*\" target=\"pass\"/>\n  </state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout1] delayexpr=['1s']></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n    <{http://www.w3.org/2005/07/scxml}content>\n      \n         <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n           <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n            <{http://www.w3.org/2005/07/scxml}onentry>\n              <{http://www.w3.org/2005/07/scxml}send event=[timeout] delayexpr=['2s']></>\n                </>\n               <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[subFinal]></>\n                </>   \n            <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n         </>\n         </>\n          </>\n \n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout1] target=[s1]></>    \n\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout2] delayexpr=['1.5s']></>\n    </>\n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[pass]></>\n  </>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 239/test239sub1.scxml
check xcanon("<!-- when invoked, just terminate.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"final\" version=\"1.0\" datamodel=\"ecmascript\">\n\n <final id=\"final\"/>\n \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[final] version=[1.0] datamodel=[ecmascript]>\n\n <{http://www.w3.org/2005/07/scxml}final id=[final]></>\n \n</>"
# 241/test241.scxml
check xcanon("<!-- The child process will return success ifits Var1 is set to 1, failure otherwise. For this test\nwe try passing in Var1 by param and by namelist and check that we either get two successes\nor two failures.  This test will fail schema validation due to multiple  declarations of\nVar1, but should  run correctly.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n  </datamodel>\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n    <transition event=\"timeout\" target=\"fail\"/>\n   \n   <state id=\"s01\">\n     <invoke type=\"http://www.w3.org/TR/scxml/\" namelist=\"Var1\">\n              <content>\n            <scxml initial=\"sub01\" version=\"1.0\" datamodel=\"ecmascript\">\n             <datamodel>\n               <data id=\"Var1\" expr=\"0\"/>\n                </datamodel>\n   \n           <state id=\"sub01\">\n              <transition cond=\"\" target=\"subFinal1\">\n                  <send target=\"#_parent\" event=\"success\"/>\n                    </transition>\n              <transition target=\"subFinal1\">\n                    <send target=\"#_parent\" event=\"failure\"/>\n                </transition>\n              </state>\n     \n            <final id=\"subFinal1\"/>\n            </scxml>\n       </content>\n       </invoke>\n     <transition event=\"success\" target=\"s02\"/>\n     <transition event=\"failure\" target=\"s03\"/>\n   </state>\n\n<state id=\"s02\">\n      <invoke type=\"http://www.w3.org/TR/scxml/\">\n          <param name=\"Var1\" expr=\"1\"/>\n          <content>\n            <scxml initial=\"sub02\" version=\"1.0\" datamodel=\"ecmascript\">\n             <datamodel>\n               <data id=\"Var1\" expr=\"0\"/>\n                </datamodel>\n   \n           <state id=\"sub02\">\n              <transition cond=\"\" target=\"subFinal2\">\n                  <send target=\"#_parent\" event=\"success\"/>\n                    </transition>\n              <transition target=\"subFinal2\">\n                    <send target=\"#_parent\" event=\"failure\"/>\n                </transition>\n              </state>\n     \n            <final id=\"subFinal2\"/>\n            </scxml>\n       </content>\n        </invoke>\n        <!-- we got success in s01, so we need to do so here -->\n     <transition event=\"success\" target=\"pass\"/>\n     <transition event=\"failure\" target=\"fail\"/>\n  </state>\n  \n<state id=\"s03\">\n      <invoke type=\"http://www.w3.org/TR/scxml/\">\n          <param name=\"Var1\" expr=\"1\"/>\n           <content>\n            <scxml initial=\"sub03\" version=\"1.0\" datamodel=\"ecmascript\">\n             <datamodel>\n               <data id=\"Var1\" expr=\"0\"/>\n                </datamodel>\n   \n           <state id=\"sub03\">\n              <transition cond=\"\" target=\"subFinal3\">\n                  <send target=\"#_parent\" event=\"success\"/>\n                    </transition>\n              <transition target=\"subFinal3\">\n                    <send target=\"#_parent\" event=\"failure\"/>\n                </transition>\n              </state>\n     \n            <final id=\"subFinal3\"/>\n            </scxml>\n       </content>\n        </invoke>\n        <!-- we got failure in s01, so we need to do so here -->\n     <transition event=\"failure\" target=\"pass\"/>\n     <transition event=\"success\" target=\"fail\"/>\n  </state>\n \n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n  </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n    </>\n    <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n   \n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] namelist=[Var1]>\n              <{http://www.w3.org/2005/07/scxml}content>\n            <{http://www.w3.org/2005/07/scxml}scxml initial=[sub01] version=[1.0] datamodel=[ecmascript]>\n             <{http://www.w3.org/2005/07/scxml}datamodel>\n               <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n                </>\n   \n           <{http://www.w3.org/2005/07/scxml}state id=[sub01]>\n              <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[subFinal1]>\n                  <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[success]></>\n                    </>\n              <{http://www.w3.org/2005/07/scxml}transition target=[subFinal1]>\n                    <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[failure]></>\n                </>\n              </>\n     \n            <{http://www.w3.org/2005/07/scxml}final id=[subFinal1]></>\n            </>\n       </>\n       </>\n     <{http://www.w3.org/2005/07/scxml}transition event=[success] target=[s02]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[failure] target=[s03]></>\n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s02]>\n      <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n          <{http://www.w3.org/2005/07/scxml}param name=[Var1] expr=[1]></>\n          <{http://www.w3.org/2005/07/scxml}content>\n            <{http://www.w3.org/2005/07/scxml}scxml initial=[sub02] version=[1.0] datamodel=[ecmascript]>\n             <{http://www.w3.org/2005/07/scxml}datamodel>\n               <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n                </>\n   \n           <{http://www.w3.org/2005/07/scxml}state id=[sub02]>\n              <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[subFinal2]>\n                  <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[success]></>\n                    </>\n              <{http://www.w3.org/2005/07/scxml}transition target=[subFinal2]>\n                    <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[failure]></>\n                </>\n              </>\n     \n            <{http://www.w3.org/2005/07/scxml}final id=[subFinal2]></>\n            </>\n       </>\n        </>\n        \n     <{http://www.w3.org/2005/07/scxml}transition event=[success] target=[pass]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[failure] target=[fail]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s03]>\n      <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n          <{http://www.w3.org/2005/07/scxml}param name=[Var1] expr=[1]></>\n           <{http://www.w3.org/2005/07/scxml}content>\n            <{http://www.w3.org/2005/07/scxml}scxml initial=[sub03] version=[1.0] datamodel=[ecmascript]>\n             <{http://www.w3.org/2005/07/scxml}datamodel>\n               <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n                </>\n   \n           <{http://www.w3.org/2005/07/scxml}state id=[sub03]>\n              <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[subFinal3]>\n                  <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[success]></>\n                    </>\n              <{http://www.w3.org/2005/07/scxml}transition target=[subFinal3]>\n                    <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[failure]></>\n                </>\n              </>\n     \n            <{http://www.w3.org/2005/07/scxml}final id=[subFinal3]></>\n            </>\n       </>\n        </>\n        \n     <{http://www.w3.org/2005/07/scxml}transition event=[failure] target=[pass]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[success] target=[fail]></>\n  </>\n \n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 242/test242sub1.scxml
check xcanon("<!-- when invoked, just terminate.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"final\" version=\"1.0\" datamodel=\"ecmascript\">\n\n <final id=\"final\"/>\n \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[final] version=[1.0] datamodel=[ecmascript]>\n\n <{http://www.w3.org/2005/07/scxml}final id=[final]></>\n \n</>"
# 244/test244.scxml
check xcanon("<!-- test that datamodel values can be specified by  namelist.\ninvoked child will return success ifits Var1 is set to 1, failure otherwise.  \nThis test will fail schema validation due to multiple occurrences of Var1,\nbut should run correctly. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n  </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n   \n     <invoke type=\"http://www.w3.org/TR/scxml/\" namelist=\"Var1\">\n        <content>\n          <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n             <datamodel>\n             <data id=\"Var1\" expr=\"0\"/>\n             </datamodel>\n   \n         <state id=\"sub0\">\n            <transition cond=\"\" target=\"subFinal\">\n             <send target=\"#_parent\" event=\"success\"/>\n              </transition>\n             <transition target=\"subFinal\">\n                 <send target=\"#_parent\" event=\"failure\"/>\n             </transition>\n           </state>    \n            <final id=\"subFinal\"/>\n              </scxml>\n             </content>\n             </invoke>\n     <transition event=\"success\" target=\"pass\"/>\n     <transition event=\"*\" target=\"fail\"/>\n   </state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n  </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n    </>\n   \n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] namelist=[Var1]>\n        <{http://www.w3.org/2005/07/scxml}content>\n          <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n             <{http://www.w3.org/2005/07/scxml}datamodel>\n             <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n             </>\n   \n         <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n            <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[subFinal]>\n             <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[success]></>\n              </>\n             <{http://www.w3.org/2005/07/scxml}transition target=[subFinal]>\n                 <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[failure]></>\n             </>\n           </>    \n            <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n              </>\n             </>\n             </>\n     <{http://www.w3.org/2005/07/scxml}transition event=[success] target=[pass]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 247/test247.scxml
check xcanon("<!-- test that we get done.invoke.  timeout indicates failure  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n   \n     <invoke type=\"http://www.w3.org/TR/scxml/\">\n       <content>\n         <scxml version=\"1.0\" initial=\"subFinal\" datamodel=\"ecmascript\">\n           <final id=\"subFinal\"/>\n           </scxml>\n        </content>\n        </invoke>\n     <transition event=\"done.invoke\" target=\"pass\"/>\n     <transition event=\"timeout\" target=\"fail\"/>\n   </state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n    </>\n   \n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n       <{http://www.w3.org/2005/07/scxml}content>\n         <{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[subFinal] datamodel=[ecmascript]>\n           <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n           </>\n        </>\n        </>\n     <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[pass]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n   </>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 252/test252.scxml
check xcanon("<!-- test that we don't process any events received from the invoked process once it is cancelled.  child\nprocess tries to send us childToParent in an onexit handler.  If we get it, we fail.  \ntimeout indicates success.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delayexpr=\"'1s'\"/>\n    </onentry>\n    \n    <transition event=\"timeout\" target=\"pass\"/>\n    <transition event=\"childToParent\" target=\"fail\"/>\n    <transition event=\"done.invoke\" target=\"fail\"/>\n    \n    <state id=\"s01\">\n      <onentry>\n        <send event=\"foo\"/>\n        </onentry>\n   \n     <invoke type=\"http://www.w3.org/TR/scxml/\">\n       <content>\n         <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n              <state id=\"sub0\">\n             <onentry>\n             <send event=\"timeout\" delayexpr=\"'.5s'\"/>\n             </onentry> \n            <transition event=\"timeout\" target=\"subFinal\"/>\n               <onexit>\n               <send target=\"#_parent\" event=\"childToParent\"/>\n            </onexit>\n          </state>  \n          <final id=\"subFinal\"/>\n          </scxml>\n       </content>\n      </invoke>\n      \n     <!-- this transition will cause the invocation to be cancelled -->\n     <transition event=\"foo\" target=\"s02\"/>\n   </state>\n   \n   <state id=\"s02\"/>\n   \n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delayexpr=['1s']></>\n    </>\n    \n    <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[pass]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] target=[fail]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[fail]></>\n    \n    <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n        <{http://www.w3.org/2005/07/scxml}send event=[foo]></>\n        </>\n   \n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n       <{http://www.w3.org/2005/07/scxml}content>\n         <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n              <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n             <{http://www.w3.org/2005/07/scxml}onentry>\n             <{http://www.w3.org/2005/07/scxml}send event=[timeout] delayexpr=['.5s']></>\n             </> \n            <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[subFinal]></>\n               <{http://www.w3.org/2005/07/scxml}onexit>\n               <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[childToParent]></>\n            </>\n          </>  \n          <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n          </>\n       </>\n      </>\n      \n     \n     <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[s02]></>\n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}state id=[s02]></>\n   \n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 276/test276.scxml
check xcanon("<!-- test that values passed in from parent process override default values specified in the child, test276sub1.scxml.\nThe child returns event1 if var1 has value 1, event0 if it has default value 0.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n   <state id=\"s0\">\n     <invoke type=\"scxml\" src=\"file:test276sub1.scxml\">\n       <param name=\"Var1\" expr=\"1\"/>\n       </invoke>\n       <transition event=\"event1\" target=\"pass\"/>\n       <transition event=\"event0\" target=\"fail\"/>\n   </state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n     <{http://www.w3.org/2005/07/scxml}invoke type=[scxml] src=[file:test276sub1.scxml]>\n       <{http://www.w3.org/2005/07/scxml}param name=[Var1] expr=[1]></>\n       </>\n       <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[pass]></>\n       <{http://www.w3.org/2005/07/scxml}transition event=[event0] target=[fail]></>\n   </>\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n\n\n</>"
# 277/test277.scxml
check xcanon("<!-- test that platform creates undound variable if we assign an illegal value to it.  Thus\n we can assign to it later in state s1.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n   <datamodel>\n     <data id=\"Var1\" expr=\"return\"/>\n     </datamodel>\n     \n <state id=\"s0\">\n    <onentry>\n    <raise event=\"foo\"/>\n    </onentry>\n    \n   <transition event=\"error.execution\" cond=\"typeof Var1 === 'undefined' \" target=\"s1\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n <state id=\"s1\">\n <onentry>\n   <assign location=\"Var1\" expr=\"1\"/>\n   </onentry>\n   <transition cond=\"\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n\n   </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n   <{http://www.w3.org/2005/07/scxml}datamodel>\n     <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[return]></>\n     </>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    </>\n    \n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] cond=[typeof Var1 === 'undefined' ] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[1]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n\n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 279/test279.scxml
check xcanon("<!--  testing that in case of early binding variables are assigned values at init time, before\n the state containing them is visited  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n   \n     \n <state id=\"s0\">\n   <transition cond=\"\" target=\"pass\"/>\n\n  <transition target=\"fail\"/>\n\n   </state>\n   \n<state id=\"s1\">\n  <datamodel>\n    <data id=\"Var1\" expr=\"1\"/>\n    </datamodel>\n  </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n   \n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n    </>\n  </>\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 286/test286.scxml
check xcanon("<!-- test that assigment to a non-declared var causes an error.  the transition on foo catches the case\nwhere no error is raised --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n   \n     \n <state id=\"s0\">\n   <onentry>\n   <assign location=\"foo.bar.baz \" expr=\"1\"/>\n   <raise event=\"foo\"/>\n   </onentry>\n   \n   <transition event=\"error.execution\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n   \n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[foo.bar.baz ] expr=[1]></>\n   <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 294/test294.scxml
check xcanon("<!-- test that a param inside donedata ends up in the data field of the done event and\nthat content inside donedata sets the full value of the event.data field --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n <datamodel>\n       <data id=\"Var1\" expr=\"0\"/>\n    </datamodel>   \n     \n <state id=\"s0\" initial=\"s01\">\n    \n   <transition event=\"done.state.s0\" cond=\"\" target=\"s1\">\n     </transition>\n     \n      <transition event=\"done.state.s0\" target=\"fail\">\n     </transition>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <param name=\"Var1\" expr=\"1\"/>\n      </donedata>\n     </final>\n </state>\n \n <state id=\"s1\" initial=\"s11\">\n    \n   <transition event=\"done.state.s1\" cond=\"_event.data == 'foo'\" target=\"pass\">\n     </transition>\n     \n      <transition event=\"done.state.s1\" target=\"fail\">\n     </transition>\n\n   <state id=\"s11\">\n   <transition target=\"s12\"/>\n   </state>\n   <final id=\"s12\">\n     <donedata>\n      <content>foo</content>\n      </donedata>\n     </final>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n       <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n    </>   \n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n    \n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] cond=[] target=[s1]>\n     </>\n     \n      <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] target=[fail]>\n     </>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s02]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}final id=[s02]>\n     <{http://www.w3.org/2005/07/scxml}donedata>\n      <{http://www.w3.org/2005/07/scxml}param name=[Var1] expr=[1]></>\n      </>\n     </>\n </>\n \n <{http://www.w3.org/2005/07/scxml}state id=[s1] initial=[s11]>\n    \n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s1] cond=[_event.data == 'foo'] target=[pass]>\n     </>\n     \n      <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s1] target=[fail]>\n     </>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s11]>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s12]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}final id=[s12]>\n     <{http://www.w3.org/2005/07/scxml}donedata>\n      <{http://www.w3.org/2005/07/scxml}content>foo</>\n      </>\n     </>\n </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 301/test301.scxml
check xcanon("<!-- the processor should  reject this document because it can't download the script.  \nTherefore  we fail if it runs at all. This test is valid only for datamodels that support scripting --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s0\">\n <script src=\"D:\\foo\"/>\n     \n <state id=\"s0\">\n   <transition target=\"fail\"/>\n   </state>\n   \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s0]>\n <{http://www.w3.org/2005/07/scxml}script src=[D:\\foo]></>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 303/test303.scxml
check xcanon("<!-- to test that scripts are run as part of executable content, we check that it changes the value of a var at the\nright point. This test is valid only for datamodels that support scripting --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n<datamodel>\n<data id=\"Var1\" expr=\"0\"/>\n</datamodel>\n     \n <state id=\"s0\">\n   <onentry>\n   <assign location=\"Var1\" expr=\"2\"/>\n   <script>var Var1 = 1</script>\n   </onentry>\n   <transition cond=\"\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n   \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n<{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n</>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[2]></>\n   <{http://www.w3.org/2005/07/scxml}script>var Var1 = 1</>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 307/test307.scxml
check xcanon("<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\" initial=\"s0\" binding=\"late\">\n\n<!-- with binding=late, in s0 we access a variable that isn't created until we get to s1.  Then in s1\nwe access a non-existent substructure of a variable.  We use log tags to report the values that both operations\nyield, and whether there are errors.  This is a manual test, since the tester must report whether the output\nis the same in the two cases -->\n\n<state id=\"s0\">\n  <onentry>\n    <log label=\"entering s0 value of Var 1 is: \" expr=\"Var1\"/>\n    <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"error\" target=\"s1\"> \n     <log label=\"error in state s0\" expr=\"_event\"/>\n     </transition>\n   <transition event=\"foo\" target=\"s1\">\n     <log label=\"no error in s0\" expr=\"\"/>\n     </transition>\n   </state>\n   \n<state id=\"s1\">\n  <datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n \n  <onentry>\n   <log label=\"entering s1, value of non-existent substructure of Var 1 is: \" expr=\"Var1.bar\"/>\n   <raise event=\"bar\"/>\n   </onentry>\n\n    <transition event=\"error\" target=\"final\"> \n     <log label=\"error in state s1\" expr=\"_event\"/>\n     </transition>\n   <transition event=\"bar\" target=\"final\">\n     <log label=\"No error in s1\" expr=\"\"/>\n     </transition>\n\n</state>\n    \n<final id=\"final\"/>\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0] initial=[s0] binding=[late]>\n\n\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}log label=[entering s0 value of Var 1 is: ] expr=[Var1]></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[s1]> \n     <{http://www.w3.org/2005/07/scxml}log label=[error in state s0] expr=[_event]></>\n     </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[s1]>\n     <{http://www.w3.org/2005/07/scxml}log label=[no error in s0] expr=[]></>\n     </>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n </>\n \n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}log label=[entering s1, value of non-existent substructure of Var 1 is: ] expr=[Var1.bar]></>\n   <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n   </>\n\n    <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[final]> \n     <{http://www.w3.org/2005/07/scxml}log label=[error in state s1] expr=[_event]></>\n     </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[bar] target=[final]>\n     <{http://www.w3.org/2005/07/scxml}log label=[No error in s1] expr=[]></>\n     </>\n\n</>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[final]></>\n   \n</>"
# 310/test310.scxml
check xcanon("<!-- simple test of the in() predicate --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"p\">\n\n     \n <parallel id=\"p\">\n \n   <state id=\"s0\">\n   <transition cond=\"In('s1')\" target=\"pass\"/> \n   <transition target=\"fail\"/>\n   </state>\n\n   <state id=\"s1\"/> \n </parallel>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[p]>\n\n     \n <{http://www.w3.org/2005/07/scxml}parallel id=[p]>\n \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[In('s1')] target=[pass]></> \n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s1]></> \n </>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 312/test312.scxml
check xcanon("<!-- test that assignment with an illegal expr raises an error --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n\n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"return\"/>\n   <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"error.execution\" target=\"pass\"/> \n   <transition event=\".*\" target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[return]></>\n   <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[pass]></> \n   <{http://www.w3.org/2005/07/scxml}transition event=[.*] target=[fail]></>\n   </>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 314/test314.scxml
check xcanon("<!-- this is a manual test because the processor is allowed to reject this document.  But if it executes it,\nit should not raise an error until it gets to s03 and evaluates the illegal expr --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n\n\n<state id=\"s0\" initial=\"s01\">\n  <transition event=\"error.execution\" target=\"fail\"/>\n  \n   <state id=\"s01\">\n      <transition target=\"s02\"/>\n    </state>\n\n   <state id=\"s02\">\n     <transition target=\"s03\"/>\n   </state>\n\n  <state id=\"s03\">\n    <onentry>\n     <assign location=\"Var1\" expr=\"return\"/>\n      <raise event=\"foo\"/>\n   </onentry>\n     <transition event=\"error.execution\" target=\"pass\"/> \n     <transition event=\".*\" target=\"fail\"/>\n  </state>\n   \n</state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n </>\n\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[fail]></>\n  \n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n      <{http://www.w3.org/2005/07/scxml}transition target=[s02]></>\n    </>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s02]>\n     <{http://www.w3.org/2005/07/scxml}transition target=[s03]></>\n   </>\n\n  <{http://www.w3.org/2005/07/scxml}state id=[s03]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[return]></>\n      <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n   </>\n     <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[pass]></> \n     <{http://www.w3.org/2005/07/scxml}transition event=[.*] target=[fail]></>\n  </>\n   \n</>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 319/test319.scxml
check xcanon("<!-- test that _event is not bound before any event has been raised --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\" name=\"machineName\">\n\n <state id=\"s0\">\n   <onentry>\n     <if cond=\"_event\">\n       <raise event=\"bound\"/>\n       <else/>\n         <raise event=\"unbound\"/>\n     </if>\n   </onentry>\n   <transition event=\"unbound\" target=\"pass\"/>\n   <transition event=\"bound\" target=\"fail\"/> \n\n   </state>\n   \n    \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0] name=[machineName]>\n\n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}if cond=[_event]>\n       <{http://www.w3.org/2005/07/scxml}raise event=[bound]></>\n       <{http://www.w3.org/2005/07/scxml}else></>\n         <{http://www.w3.org/2005/07/scxml}raise event=[unbound]></>\n     </>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[unbound] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[bound] target=[fail]></> \n\n   </>\n   \n    \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 322/test322.scxml
check xcanon("<!-- test that _sessionid remains bound to the same value throught the session.  this means that it can't\nbe assigned to  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\" name=\"machineName\">\n<datamodel>\n  <data id=\"Var1\" expr=\"_sessionid\"/>\n  <data id=\"Var2\"/>\n  </datamodel>\n     \n <state id=\"s0\">\n   <transition target=\"s1\"/>\n\n   </state>\n   \n <state id=\"s1\">\n   <onentry>\n    <assign location=\"_sessionid\" expr=\"'otherName'\"/>\n    <raise event=\"foo\"/>\n    </onentry>\n \n   <transition event=\"error.execution\" target=\"s2\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n <state id=\"s2\">\n \n   <transition cond=\"\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>  \n   \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0] name=[machineName]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[_sessionid]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  </>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s1]></>\n\n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}assign location=[_sessionid] expr=['otherName']></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    </>\n \n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s2]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s2]>\n \n   <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>  \n   \n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 324/test324.scxml
check xcanon("<!-- test that _name stays bound till the session ends.  This means that it cannot be assigned to --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">\n\n     \n <state id=\"s0\">\n   <transition cond=\"_name  === 'machineName'\" target=\"s1\"/>\n    <transition target=\"fail\"/>\n   </state>\n   \n <state id=\"s1\">\n   <onentry>\n    <assign location=\"_name\" expr=\"'otherName'\"/>\n    </onentry>\n   <transition cond=\"_name  === 'machineName'\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>  \n   \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript] name=[machineName]>\n\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[_name  === 'machineName'] target=[s1]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}assign location=[_name] expr=['otherName']></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[_name  === 'machineName'] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>  \n   \n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 326/test326.scxml
check xcanon("<!-- test that _ioprocessors stays bound till the session ends.  This means that it cannot be assigned to --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\" name=\"machineName\">\n<datamodel>\n  <data id=\"Var1\" expr=\"_ioprocessors\"/>\n  <data id=\"Var2\"/>\n  </datamodel>\n\n <state id=\"s0\">\n    <transition cond=\"Var1\" target=\"s1\"/> \n   <transition cond=\"true\" target=\"fail\"/>\n   </state> \n      \n   \n <state id=\"s1\">\n   <onentry>\n    <assign location=\"_ioprocessors\" expr=\"'otherName'\"/>\n    <raise event=\"foo\"/>\n    </onentry>\n \n   <transition event=\"error.execution\" target=\"s2\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n <state id=\"s2\">\n   <onentry>\n     <assign location=\"Var2\" expr=\"_ioprocessors\"/>\n     </onentry>\n   <transition cond=\"\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>  \n   \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0] name=[machineName]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[_ioprocessors]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  </>\n\n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n    <{http://www.w3.org/2005/07/scxml}transition cond=[Var1] target=[s1]></> \n   <{http://www.w3.org/2005/07/scxml}transition cond=[true] target=[fail]></>\n   </> \n      \n   \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}assign location=[_ioprocessors] expr=['otherName']></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    </>\n \n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s2]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s2]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[_ioprocessors]></>\n     </>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>  \n   \n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 330/test330.scxml
check xcanon("<!-- check that the required fields are present in both internal and external events --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s0\" datamodel=\"ecmascript\" name=\"machineName\">\n     \n <state id=\"s0\">\n   <onentry>\n     <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" cond=\"'name' in _event &amp;&amp; 'type' in _event &amp;&amp; 'sendid' in _event &amp;&amp; 'origin' in _event &amp;&amp; 'origintype' in _event &amp;&amp; 'invokeid' in _event &amp;&amp; 'data' in _event\" target=\"s1\"/> \n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n <state id=\"s1\">\n   <onentry>\n     <send event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" cond=\"'name' in _event &amp;&amp; 'type' in _event &amp;&amp; 'sendid' in _event &amp;&amp; 'origin' in _event &amp;&amp; 'origintype' in _event &amp;&amp; 'invokeid' in _event &amp;&amp; 'data' in _event\" target=\"pass\"/> \n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n    \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s0] datamodel=[ecmascript] name=[machineName]>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=['name' in _event && 'type' in _event && 'sendid' in _event && 'origin' in _event && 'origintype' in _event && 'invokeid' in _event && 'data' in _event] target=[s1]></> \n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=['name' in _event && 'type' in _event && 'sendid' in _event && 'origin' in _event && 'origintype' in _event && 'invokeid' in _event && 'data' in _event] target=[pass]></> \n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n   \n    \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 332/test332.scxml
check xcanon("<!-- test that sendid is present in error events triggered by send errors --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s0\" datamodel=\"ecmascript\" name=\"machineName\">\n <datamodel>\n   <data id=\"Var1\"/>\n    <data id=\"Var2\"/>\n   </datamodel>    \n\n   \n <state id=\"s0\">\n   <onentry>\n   <!-- this will raise an error and also store the sendid in var1 -->\n     <send target=\"baz\" event=\"foo\" idlocation=\"Var1\"/>\n   </onentry>\n   <transition event=\"error\" target=\"s1\">\n   <!-- get the sendid out of the error event -->\n       <assign location=\"Var2\" expr=\"_event.sendid\"/>\n       </transition>\n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n<state id=\"s1\">\n<!-- make sure that the sendid in the error event matches the one generated when send executed -->\n  <transition cond=\"\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n      \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s0] datamodel=[ecmascript] name=[machineName]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n   </>    \n\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n   \n     <{http://www.w3.org/2005/07/scxml}send target=[baz] event=[foo] idlocation=[Var1]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[s1]>\n   \n       <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[_event.sendid]></>\n       </>\n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n\n  <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n      \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 335/test335.scxml
check xcanon("<!-- test that origin field is blank for internal events --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s0\" datamodel=\"ecmascript\" name=\"machineName\">  \n   \n <state id=\"s0\">\n   <onentry>\n     <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" cond=\"typeof _event.origin === 'undefined' \" target=\"pass\"/>\n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n\n      \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s0] datamodel=[ecmascript] name=[machineName]>  \n   \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=[typeof _event.origin === 'undefined' ] target=[pass]></>\n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n   \n\n      \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 337/test337.scxml
check xcanon("<!-- test that origintype is blank on internal events --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\" name=\"machineName\">  \n   \n <state id=\"s0\">\n   <onentry>\n     <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" cond=\"typeof _event.origintype === 'undefined' \" target=\"pass\"/>\n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n\n      \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0] name=[machineName]>  \n   \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=[typeof _event.origintype === 'undefined' ] target=[pass]></>\n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n   \n\n      \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 339/test339.scxml
check xcanon("<!-- test that invokeid is blank in an event that wasn't returned from an invoked process --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">  \n   \n <state id=\"s0\">\n   <onentry>\n     <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" cond=\"typeof _event.invokeid === 'undefined' \" target=\"pass\"/>\n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n\n      \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript] name=[machineName]>  \n   \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=[typeof _event.invokeid === 'undefined' ] target=[pass]></>\n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n   \n\n      \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 343/test343.scxml
check xcanon("<!--  test that illegal <param> produces error.execution and empty event.data --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n     \n <state id=\"s0\" initial=\"s01\">\n   <!-- we should get the error before the done event -->\n   <transition event=\"error.execution\" target=\"s1\"/>\n   <transition event=\"done.state.s0\" target=\"fail\"/>     \n\n      <transition event=\"done.state.s0\" target=\"fail\">\n     </transition>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <param location=\"foo.bar.baz \" name=\"someParam\"/>\n      </donedata>\n     </final>\n  </state>\n\n \n <!-- if we get here, we received the error event. Now check that the done\n event has empty event.data -->\n \n <state id=\"s1\">\n   <transition event=\"done.state.s0\" cond=\"typeof _event.data === 'undefined'\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n   \n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] target=[fail]></>     \n\n      <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] target=[fail]>\n     </>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s02]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}final id=[s02]>\n     <{http://www.w3.org/2005/07/scxml}donedata>\n      <{http://www.w3.org/2005/07/scxml}param location=[foo.bar.baz ] name=[someParam]></>\n      </>\n     </>\n  </>\n\n \n \n \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] cond=[typeof _event.data === 'undefined'] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 346/test346.scxml
check xcanon("<!-- test that any attempt to change the value of a system variable causes error.execution to be raised.  \nEvent1..4 are there to catch the case where the error event is not raised. In cases where it is, we have\nto dispose of eventn in the next state, hence the targetless transitions (which simply throw away the event.) --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">\n\n   \n <state id=\"s0\">\n   <onentry>\n    <assign location=\"_sessionid\" expr=\"'otherName'\"/>\n    <raise event=\"event1\"/>\n    </onentry>\n \n   <transition event=\"error.execution\" target=\"s1\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n <state id=\"s1\">\n     <onentry>\n    <assign location=\"_event\" expr=\"'otherName'\"/>\n    <raise event=\"event2\"/>\n    </onentry>\n    <!-- throw out event1 if it's still around -->\n   <transition event=\"event1\"/>\n   <transition event=\"error.execution\" target=\"s2\"/>\n   <!-- event1 would trigger this transition if we didn't drop it.  We want this transition to have\n   a very general trigger to catch cases where the wrong error event was raised -->\n   <transition event=\"*\" target=\"fail\"/>\n   </state>  \n   \n<state id=\"s2\">\n     <onentry>\n    <assign location=\"_ioprocessors\" expr=\"'otherName'\"/>\n    <raise event=\"event3\"/>\n    </onentry>\n   <transition event=\"event2\"/>\n   <transition event=\"error.execution\" target=\"s3\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>  \n   \n<state id=\"s3\">\n     <onentry>\n    <assign location=\"_name\" expr=\"'otherName'\"/>\n    <raise event=\"event4\"/>\n    </onentry>\n   <transition event=\"event3\"/>\n   <transition event=\"error.execution\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>  \n   \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript] name=[machineName]>\n\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}assign location=[_sessionid] expr=['otherName']></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n    </>\n \n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n     <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}assign location=[_event] expr=['otherName']></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n    </>\n    \n   <{http://www.w3.org/2005/07/scxml}transition event=[event1]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s2]></>\n   \n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>  \n   \n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n     <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}assign location=[_ioprocessors] expr=['otherName']></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[event3]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[event2]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s3]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>  \n   \n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n     <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}assign location=[_name] expr=['otherName']></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[event4]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[event3]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>  \n   \n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 348/test348.scxml
check xcanon("<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n <!-- test that event param of send sets the name of the event -->\n  \n<state id=\"s0\">\n\n   <onentry>\n     <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" event=\"s0Event\"/>\n     </onentry>\n  <transition event=\"s0Event\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n\n</state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n \n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor] event=[s0Event]></>\n     </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[s0Event] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n\n</>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 350/test350.scxml
check xcanon("<!-- test that target value is used to decide what session to deliver the event to.  A session should be\nable to send an event to itself using its own session ID as the target --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"'#_scxml_'\"/>\n  <data id=\"Var2\" expr=\"_sessionid\"/> \n</datamodel>\n  \n<state id=\"s0\">\n\n   <onentry>\n     <assign location=\"Var1\" expr=\"Var1 + Var2\"/> \n     <send delay=\"5s\" event=\"timeout\"/>\n     <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" targetexpr=\"Var1\" event=\"s0Event\"/> \n     </onentry>\n  <transition event=\"s0Event\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n\n</state>\n\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=['#_scxml_']></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[_sessionid]></> \n</>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + Var2]></> \n     <{http://www.w3.org/2005/07/scxml}send delay=[5s] event=[timeout]></>\n     <{http://www.w3.org/2005/07/scxml}send type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor] targetexpr=[Var1] event=[s0Event]></> \n     </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[s0Event] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n\n</>\n\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 352/test352.scxml
check xcanon("<!-- test the origintype is 'http://www.w3.org/TR/scxml/#SCXMLEventProcessor' --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\"/>\n  </datamodel>\n\n  \n<state id=\"s0\">\n   <onentry>\n     <send delay=\"5s\" event=\"timeout\"/>\n    <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" event=\"s0Event\"/>  \n     </onentry>\n  <transition event=\"s0Event\" target=\"s1\">\n    <assign location=\"Var1\" expr=\"_event.origintype\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\">\n    </transition>\n\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n </state>\n \n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n  </>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send delay=[5s] event=[timeout]></>\n    <{http://www.w3.org/2005/07/scxml}send type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor] event=[s0Event]></>  \n     </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[s0Event] target=[s1]>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.origintype]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]>\n    </>\n\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </>\n \n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 355/test355.scxml
check xcanon("<!-- test that default initial state is first in document order.  If we enter s0 first we succeed, if s1, failure. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n\n     \n<state id=\"s0\">\n  <transition target=\"pass\"/>\n</state>\n\n<state id=\"s1\">\n  <transition target=\"fail\"/>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}transition target=[pass]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 372/test372.scxml
check xcanon("<!-- test that entering a final state generates done.state.parentid after executing the onentry elements.  \nVar1 should be set to 2 (but not 3) by the time the event is raised --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n  </datamodel>\n       \n<state id=\"s0\" initial=\"s0final\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n  <transition event=\"done.state.s0\" cond=\"\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  \n  <final id=\"s0final\">\n    <onentry>\n     <assign location=\"Var1\" expr=\"2\"/>\n     </onentry>\n    <onexit>\n     <assign location=\"Var1\" expr=\"3\"/>\n     </onexit>\n     </final>\n</state>\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n  </>\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s0final]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  \n  <{http://www.w3.org/2005/07/scxml}final id=[s0final]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[2]></>\n     </>\n    <{http://www.w3.org/2005/07/scxml}onexit>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[3]></>\n     </>\n     </>\n</>\n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 376/test376.scxml
check xcanon("<!-- test that each onentry handler is a separate block.  The <send> of event1 will cause an error but\n the increment to var1 should happen anyways --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n       \n<state id=\"s0\">\n  <onentry>\n    <send target=\"baz\" event=\"event1\"/>\n    </onentry>\n  <onentry>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onentry>\n    \n  <transition cond=\"\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n </>\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send target=[baz] event=[event1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 378/test378.scxml
check xcanon("<!-- test that each onexithandler is a separate block.  The <send> of event1 will cause an error but\n the increment to var1 should happen anyways --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n       \n<state id=\"s0\">\n  <onexit>\n    <send target=\"baz\" event=\"event1\"/>\n    </onexit>\n  <onexit>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onexit>\n    \n<transition target=\"s1\"/>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n </>\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onexit>\n    <{http://www.w3.org/2005/07/scxml}send target=[baz] event=[event1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}onexit>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n    </>\n    \n<{http://www.w3.org/2005/07/scxml}transition target=[s1]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 388/test388.scxml
check xcanon("<!-- test that history states works correctly.  The counter Var1 counts how many times\nwe have entered s0.  The initial state is s012.  We then transition to s1, which transitions\nto s0's deep history state.  entering.s012 should be raised, otherwise failure.  Then we transition\nto s02, which transitions to s0's shallow history state.  That should have value s01, and its initial\nstate is s011, so we should get entering.s011, otherwise failure.--><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s012\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  </datamodel>\n       \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onentry>\n    \n  <!-- the first time through, go to s1, setting  a timer just in case something hangs -->\n  <transition event=\"entering.s012\" cond=\"\" target=\"s1\">\n     <send event=\"timeout\" delay=\"2s\"/>\n     </transition>\n  \n  <!-- the second time, we should get entering.s012.  If so, go to s2, otherwise fail -->\n  <transition event=\"entering.s012\" cond=\"\" target=\"s2\"/>\n    <transition event=\"entering\" cond=\"\" target=\"fail\"/>\n    \n  <!-- the third time we should get entering-s011. If so, pass, otherwise fail -->\n  <transition event=\"entering.s011\" cond=\"\" target=\"pass\"/>\n  <transition event=\"entering\" cond=\"\" target=\"fail\"/>\n \n <!-- if we timeout, the state machine is hung somewhere, so fail -->\n <transition event=\"timeout\" target=\"fail\"/>\n  \n  <history type=\"shallow\" id=\"s0HistShallow\">\n    <transition target=\"s02\"/>\n    </history>\n  <history type=\"deep\" id=\"s0HistDeep\">\n    <transition target=\"s022\"/>\n    </history>\n  <state id=\"s01\" initial=\"s011\">\n    <state id=\"s011\">\n       <onentry>\n         <raise event=\"entering.s011\"/>\n         </onentry>\n    </state>\n    <state id=\"s012\">\n      <onentry>\n       <raise event=\"entering.s012\"/>\n        </onentry>\n    </state>\n  </state>\n <state id=\"s02\" initial=\"s021\">\n     <state id=\"s021\">\n       <onentry>\n         <raise event=\"entering.s021\"/>\n         </onentry>\n    </state>\n    <state id=\"s022\">\n      <onentry>\n       <raise event=\"entering.s022\"/>\n        </onentry>\n    </state>\n  </state>\n \n</state>\n\n\n<state id=\"s1\">\n  <transition target=\"s0HistDeep\"/>\n</state>\n\n<state id=\"s2\">\n  <transition target=\"s0HistShallow\"/>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s012] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n  </>\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n    </>\n    \n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[entering.s012] cond=[] target=[s1]>\n     <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n     </>\n  \n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[entering.s012] cond=[] target=[s2]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[entering] cond=[] target=[fail]></>\n    \n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[entering.s011] cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[entering] cond=[] target=[fail]></>\n \n \n <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n  \n  <{http://www.w3.org/2005/07/scxml}history type=[shallow] id=[s0HistShallow]>\n    <{http://www.w3.org/2005/07/scxml}transition target=[s02]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}history type=[deep] id=[s0HistDeep]>\n    <{http://www.w3.org/2005/07/scxml}transition target=[s022]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}state id=[s01] initial=[s011]>\n    <{http://www.w3.org/2005/07/scxml}state id=[s011]>\n       <{http://www.w3.org/2005/07/scxml}onentry>\n         <{http://www.w3.org/2005/07/scxml}raise event=[entering.s011]></>\n         </>\n    </>\n    <{http://www.w3.org/2005/07/scxml}state id=[s012]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n       <{http://www.w3.org/2005/07/scxml}raise event=[entering.s012]></>\n        </>\n    </>\n  </>\n <{http://www.w3.org/2005/07/scxml}state id=[s02] initial=[s021]>\n     <{http://www.w3.org/2005/07/scxml}state id=[s021]>\n       <{http://www.w3.org/2005/07/scxml}onentry>\n         <{http://www.w3.org/2005/07/scxml}raise event=[entering.s021]></>\n         </>\n    </>\n    <{http://www.w3.org/2005/07/scxml}state id=[s022]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n       <{http://www.w3.org/2005/07/scxml}raise event=[entering.s022]></>\n        </>\n    </>\n  </>\n \n</>\n\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition target=[s0HistDeep]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n  <{http://www.w3.org/2005/07/scxml}transition target=[s0HistShallow]></>\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 399/test399.scxml
check xcanon("<!-- test that the event name matching works correctly, including prefix matching and the fact\nthat the event attribute of transition may contain multiple event designators.    --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n       \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n    \n  <!-- this will catch the failure case -->\n  <transition event=\"timeout\" target=\"fail\"/>\n  \n  <state id=\"s01\">\n  <onentry>\n    <raise event=\"foo\"/>\n    </onentry>\n  <!-- test that an event can match against a transition with multiple descriptors -->  \n  <transition event=\"foo bar\" target=\"s02\"/>\n  </state>\n  \n <state id=\"s02\">\n  <onentry>\n    <raise event=\"bar\"/>\n    </onentry>\n  <!-- test that an event can match the second descriptor as well -->  \n  <transition event=\"foo bar\" target=\"s03\"/>\n  </state>\n\n  <state id=\"s03\">\n  <onentry>\n    <raise event=\"foo.zoo\"/>\n    </onentry>\n  <!-- test that a prefix descriptor matches -->  \n  <transition event=\"foo bar\" target=\"s04\"/>\n  </state>\n\n<state id=\"s04\">\n  <onentry>\n    <raise event=\"foos\"/>\n    </onentry>\n  <!-- test that only token prefixes match -->  \n  <transition event=\"foo\" target=\"fail\"/>\n  <transition event=\"foos\" target=\"s05\"/>\n</state>\n\n<state id=\"s05\">\n  <onentry>\n    <raise event=\"foo.zoo\"/>\n    </onentry>\n  <!-- test that .* works at the end of a descriptor -->  \n  <transition event=\"foo.*\" target=\"s06\"/>\n  </state>  \n\n  <state id=\"s06\">\n  <onentry>\n    <raise event=\"foo\"/>\n    </onentry>\n  <!-- test that \"*\" works by itself -->  \n  <transition event=\"*\" target=\"pass\"/>\n  </state>\n  \n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n    </>\n    \n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[foo bar] target=[s02]></>\n  </>\n  \n <{http://www.w3.org/2005/07/scxml}state id=[s02]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[foo bar] target=[s03]></>\n  </>\n\n  <{http://www.w3.org/2005/07/scxml}state id=[s03]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo.zoo]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[foo bar] target=[s04]></>\n  </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s04]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foos]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foos] target=[s05]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s05]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo.zoo]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[foo.*] target=[s06]></>\n  </>  \n\n  <{http://www.w3.org/2005/07/scxml}state id=[s06]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[pass]></>\n  </>\n  \n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 402/test402.scxml
check xcanon("<!-- the assertion that errors are 'like any other event' is pretty broad, but we can check that they\nare pulled off the internal queue in order, and that prefix matching works on them.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n       \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n     <!-- catch the failure case -->\n     <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n  <transition event=\"timeout\" target=\"fail\"/>\n\n <state id=\"s01\">\n   <onentry>\n   <!-- the first internal event.  The error will be the second, and event2 will be the third -->\n      <raise event=\"event1\"/>\n     <!-- assigning to a non-existent location should raise an error -->\n    <assign location=\"foo.bar.baz \" expr=\"2\"/> \n   </onentry>\n       \n  <transition event=\"event1\" target=\"s02\">\n    <raise event=\"event2\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n<state id=\"s02\">\n  <transition event=\"error\" target=\"s03\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n<state id=\"s03\">\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n     \n     <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n\n <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n   \n      <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n     \n    <{http://www.w3.org/2005/07/scxml}assign location=[foo.bar.baz ] expr=[2]></> \n   </>\n       \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s02]>\n    <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n<{http://www.w3.org/2005/07/scxml}state id=[s02]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[s03]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s03]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 403/test403b.scxml
check xcanon("<!-- we test that 'optimally enabled set' really is a set, specifically that if a transition is optimally enabled in\ntwo different states, it is taken only once.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n  <datamodel>\n   <data id=\"Var1\" expr=\"0\"/>\n   </datamodel>\n   \n<state id=\"s0\" initial=\"p0\">\n  <!-- this transition should never be taken because a transition in a lower state should\n  always be selected -->\n  <transition event=\"event1\">\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n      </transition>\n   \n     \n   \n <parallel id=\"p0\">\n\n  <onentry>\n     <raise event=\"event1\"/>\n     <raise event=\"event2\"/>\n    </onentry>\n    \n    <!-- this transition will be selected by both states p0s1 and p0s2, but should be executed only once -->\n    <transition event=\"event1\">\n      <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n      </transition>\n      \n <state id=\"p0s1\">\n   <transition event=\"event2\" cond=\"\" target=\"pass\"/>\n   <transition event=\"event2\" target=\"fail\"/>\n   </state>\n   \n <state id=\"p0s2\"/>  \n \n</parallel>\n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[p0]>\n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1]>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n      </>\n   \n     \n   \n <{http://www.w3.org/2005/07/scxml}parallel id=[p0]>\n\n  <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n     <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n    </>\n    \n    \n    <{http://www.w3.org/2005/07/scxml}transition event=[event1]>\n      <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n      </>\n      \n <{http://www.w3.org/2005/07/scxml}state id=[p0s1]>\n   <{http://www.w3.org/2005/07/scxml}transition event=[event2] cond=[] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[fail]></>\n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[p0s2]></>  \n \n</>\n</>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 404/test404.scxml
check xcanon("<!--  test that states are exited in exit order (children before parents with reverse doc order used to break ties\n before the executable content in the transitions.  event1, event2, event3, event4 should be raised in that \n order when s01p is exited  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n       \n<state id=\"s0\" initial=\"s01p\">\n \n\n\n<parallel id=\"s01p\">\n  <onexit>\n   <!-- this should be the 3rd event raised -->\n   <raise event=\"event3\"/>\n   </onexit>\n   <transition target=\"s02\">\n   <!-- this should be the fourth event raised -->\n   <raise event=\"event4\"/>\n   </transition>\n   \n <state id=\"s01p1\">\n   <onexit>\n   <!-- this should be the second event raised -->\n      <raise event=\"event2\"/>\n   </onexit>\n   </state>\n  \n  <state id=\"s01p2\">\n    <!-- this should be the first event raised -->\n    <onexit>\n     <raise event=\"event1\"/>\n     </onexit>\n    </state>\n </parallel>\n  \n  <state id=\"s02\">\n    <transition event=\"event1\" target=\"s03\"/>\n    <transition event=\"*\" target=\"fail\"/>\n    </state>\n    \n  <state id=\"s03\">\n    <transition event=\"event2\" target=\"s04\"/>\n    <transition event=\"*\" target=\"fail\"/>\n    </state>\n\n  <state id=\"s04\">\n    <transition event=\"event3\" target=\"s05\"/>\n    <transition event=\"*\" target=\"fail\"/>\n    </state>\n    \n  <state id=\"s05\">\n    <transition event=\"event4\" target=\"pass\"/>\n    <transition event=\"*\" target=\"fail\"/>\n    </state>\n   \n </state>\n \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01p]>\n \n\n\n<{http://www.w3.org/2005/07/scxml}parallel id=[s01p]>\n  <{http://www.w3.org/2005/07/scxml}onexit>\n   \n   <{http://www.w3.org/2005/07/scxml}raise event=[event3]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s02]>\n   \n   <{http://www.w3.org/2005/07/scxml}raise event=[event4]></>\n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s01p1]>\n   <{http://www.w3.org/2005/07/scxml}onexit>\n   \n      <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n   </>\n   </>\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s01p2]>\n    \n    <{http://www.w3.org/2005/07/scxml}onexit>\n     <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n     </>\n    </>\n </>\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s02]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s03]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}state id=[s03]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[s04]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n\n  <{http://www.w3.org/2005/07/scxml}state id=[s04]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[event3] target=[s05]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}state id=[s05]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[event4] target=[pass]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n   \n </>\n \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 406/test406.scxml
check xcanon("<!--  Test that states are entered in entry order (parents before children with document order used to break ties)\nafter the executable content in the transition is executed. event1, event2, event3, event4 should be raised in that \norder when the transition in s01 is taken  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s0\" datamodel=\"ecmascript\">\n    \n<state id=\"s0\" initial=\"s01\">\n <onentry>\n  <send event=\"timeout\" delay=\"1s\"/>\n  </onentry>\n  <transition event=\"timeout\" target=\"fail\"/>\n  \n  <state id=\"s01\">\n    <transition target=\"s0p2\">\n     <!-- this should be the first event raised -->\n     <raise event=\"event1\"/>\n     </transition>\n    </state>\n\n<parallel id=\"s0p2\">\n \n  <transition event=\"event1\" target=\"s03\"/>\n   \n <state id=\"s01p21\">\n   <onentry>\n     <!-- third event -->\n     <raise event=\"event3\"/>\n     </onentry>     \n   </state>\n   \n  <state id=\"s01p22\">\n   <onentry>\n   <!-- the fourth event -->\n   <raise event=\"event4\"/>\n   </onentry>\n  </state>\n  \n  <onentry>\n    <!-- this should be the second event raised -->\n    <raise event=\"event2\"/>\n    </onentry>\n  </parallel> \n\n  \n  <state id=\"s03\">\n    <transition event=\"event2\" target=\"s04\"/>\n    <transition event=\"*\" target=\"fail\"/>\n    </state>\n    \n  <state id=\"s04\">\n    <transition event=\"event3\" target=\"s05\"/>\n    <transition event=\"*\" target=\"fail\"/>\n    </state>\n\n    \n  <state id=\"s05\">\n    <transition event=\"event4\" target=\"pass\"/>\n    <transition event=\"*\" target=\"fail\"/>\n    </state>\n   \n </state>  <!-- end s0 -->\n \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s0] datamodel=[ecmascript]>\n    \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n <{http://www.w3.org/2005/07/scxml}onentry>\n  <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n  </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n    <{http://www.w3.org/2005/07/scxml}transition target=[s0p2]>\n     \n     <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n     </>\n    </>\n\n<{http://www.w3.org/2005/07/scxml}parallel id=[s0p2]>\n \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s03]></>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s01p21]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     \n     <{http://www.w3.org/2005/07/scxml}raise event=[event3]></>\n     </>     \n   </>\n   \n  <{http://www.w3.org/2005/07/scxml}state id=[s01p22]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n   \n   <{http://www.w3.org/2005/07/scxml}raise event=[event4]></>\n   </>\n  </>\n  \n  <{http://www.w3.org/2005/07/scxml}onentry>\n    \n    <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n    </>\n  </> \n\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s03]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[s04]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}state id=[s04]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[event3] target=[s05]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n\n    \n  <{http://www.w3.org/2005/07/scxml}state id=[s05]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[event4] target=[pass]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n   \n </>  \n \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 409/test409.scxml
check xcanon("<!-- we test that states are removed from the active states list as they are exited.  When s01's onexit handler\nfires, s011 should not be on the active state list, so in(S011) should be false, and event1 should not\nbe raised.  Therefore the timeout should fire to indicate success   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delayexpr=\"'1s'\"/>\n    </onentry>\n  \n  <transition event=\"timeout\" target=\"pass\"/> \n  <transition event=\"event1\" target=\"fail\"/>\n  \n  <state id=\"s01\" initial=\"s011\">\n    <onexit>\n     <if cond=\"In('s011')\">\n       <raise event=\"event1\"/>\n       </if>\n       </onexit>\n       \n    <state id=\"s011\">\n      <transition target=\"s02\"/>\n      </state>\n  </state> <!-- end s01 -->\n\n<state id=\"s02\"/>\n\n</state> <!-- end s0 -->\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delayexpr=['1s']></>\n    </>\n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[pass]></> \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[fail]></>\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s01] initial=[s011]>\n    <{http://www.w3.org/2005/07/scxml}onexit>\n     <{http://www.w3.org/2005/07/scxml}if cond=[In('s011')]>\n       <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n       </>\n       </>\n       \n    <{http://www.w3.org/2005/07/scxml}state id=[s011]>\n      <{http://www.w3.org/2005/07/scxml}transition target=[s02]></>\n      </>\n  </> \n\n<{http://www.w3.org/2005/07/scxml}state id=[s02]></>\n\n</> \n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 412/test412.scxml
check xcanon("<!-- test that executable content in the <initial> transition executes after the onentry handler on the state\nand before the onentry handler of the child states.  Event1, event2, and event3 should occur in that order. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n  \n  <transition event=\"timeout\" target=\"fail\"/> \n  <transition event=\"event1\" target=\"fail\"/>\n  <transition event=\"event2\" target=\"pass\"/>\n  \n  <state id=\"s01\">\n    <onentry>\n      <raise event=\"event1\"/>\n       </onentry>\n     <initial>\n       <transition target=\"s011\">\n         <raise event=\"event2\"/>\n         </transition>\n      </initial>\n      \n   <state id=\"s011\">\n     <onentry>\n       <raise event=\"event3\"/>\n       </onentry>\n    <transition target=\"s02\"/>\n  </state> \n </state>\n \n<state id=\"s02\">\n  <transition event=\"event1\" target=\"s03\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n<state id=\"s03\">\n  <transition event=\"event2\" target=\"s04\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n\n<state id=\"s04\">\n  <transition event=\"event3\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n</state> <!-- end s0 -->\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    </>\n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></> \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n      <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n       </>\n     <{http://www.w3.org/2005/07/scxml}initial>\n       <{http://www.w3.org/2005/07/scxml}transition target=[s011]>\n         <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n         </>\n      </>\n      \n   <{http://www.w3.org/2005/07/scxml}state id=[s011]>\n     <{http://www.w3.org/2005/07/scxml}onentry>\n       <{http://www.w3.org/2005/07/scxml}raise event=[event3]></>\n       </>\n    <{http://www.w3.org/2005/07/scxml}transition target=[s02]></>\n  </> \n </>\n \n<{http://www.w3.org/2005/07/scxml}state id=[s02]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s03]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s03]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[s04]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s04]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event3] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n  \n</> \n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 415/test415.scxml
check xcanon("<!-- Test that the state machine halts when it enters a top-level final state.  Since\n the initial state is a final state, this machine should halt immediately without\n processing \"event1\" which is raised in the final state's on-entry handler.  This\n is a manual test since there is no platform-independent way to test that event1\n is not processed --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"final\" version=\"1.0\" datamodel=\"ecmascript\">\n  <final id=\"final\">\n    <onentry>\n      <raise event=\"event1\"/>\n      </onentry>\n   </final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[final] version=[1.0] datamodel=[ecmascript]>\n  <{http://www.w3.org/2005/07/scxml}final id=[final]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n      <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n      </>\n   </>\n\n</>"
# 417/test417.scxml
check xcanon("<!-- test that we get the done.state.id event when all of a \nparallel elements children enter final states.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s1\" datamodel=\"ecmascript\">\n\n <state id=\"s1\" initial=\"s1p1\">\n   <onentry>\n     <send event=\"timeout\" delay=\"1s\"/>\n     </onentry>\n   <transition event=\"timeout\" target=\"fail\"/>\n\n  <parallel id=\"s1p1\">\n     <transition event=\"done.state.s1p1\" target=\"pass\"/>\n     \n     <state id=\"s1p11\" initial=\"s1p111\">\n        <state id=\"s1p111\">\n         <transition target=\"s1p11final\"/>\n        </state>\n        <final id=\"s1p11final\"/>\n     </state>\n     \n     <state id=\"s1p12\" initial=\"s1p121\">\n       <state id=\"s1p121\">\n         <transition target=\"s1p12final\"/>\n       </state>\n       <final id=\"s1p12final\"/>\n     </state>\n     \n  </parallel>\n</state> \n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s1] datamodel=[ecmascript]>\n\n <{http://www.w3.org/2005/07/scxml}state id=[s1] initial=[s1p1]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n     </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n\n  <{http://www.w3.org/2005/07/scxml}parallel id=[s1p1]>\n     <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s1p1] target=[pass]></>\n     \n     <{http://www.w3.org/2005/07/scxml}state id=[s1p11] initial=[s1p111]>\n        <{http://www.w3.org/2005/07/scxml}state id=[s1p111]>\n         <{http://www.w3.org/2005/07/scxml}transition target=[s1p11final]></>\n        </>\n        <{http://www.w3.org/2005/07/scxml}final id=[s1p11final]></>\n     </>\n     \n     <{http://www.w3.org/2005/07/scxml}state id=[s1p12] initial=[s1p121]>\n       <{http://www.w3.org/2005/07/scxml}state id=[s1p121]>\n         <{http://www.w3.org/2005/07/scxml}transition target=[s1p12final]></>\n       </>\n       <{http://www.w3.org/2005/07/scxml}final id=[s1p12final]></>\n     </>\n     \n  </>\n</> \n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 421/test421.scxml
check xcanon("<!-- test that internal events take priority over external ones, and that the processor\nkeeps pulling off internal events until it finds one that triggers a transition --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s1\" datamodel=\"ecmascript\">\n\n <state id=\"s1\" initial=\"s11\">\n   <onentry>\n      <send event=\"externalEvent\"/>\n     <raise event=\"internalEvent1\"/>\n     <raise event=\"internalEvent2\"/>\n     <raise event=\"internalEvent3\"/>\n     <raise event=\"internalEvent4\"/>\n     </onentry>\n    \n   <transition event=\"externalEvent\" target=\"fail\"/>\n   \n   <state id=\"s11\">\n     <transition event=\"internalEvent3\" target=\"s12\"/>\n     </state>\n     \n   <state id=\"s12\">\n     <transition event=\"internalEvent4\" target=\"pass\"/>\n    </state>\n\n</state> \n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s1] datamodel=[ecmascript]>\n\n <{http://www.w3.org/2005/07/scxml}state id=[s1] initial=[s11]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n      <{http://www.w3.org/2005/07/scxml}send event=[externalEvent]></>\n     <{http://www.w3.org/2005/07/scxml}raise event=[internalEvent1]></>\n     <{http://www.w3.org/2005/07/scxml}raise event=[internalEvent2]></>\n     <{http://www.w3.org/2005/07/scxml}raise event=[internalEvent3]></>\n     <{http://www.w3.org/2005/07/scxml}raise event=[internalEvent4]></>\n     </>\n    \n   <{http://www.w3.org/2005/07/scxml}transition event=[externalEvent] target=[fail]></>\n   \n   <{http://www.w3.org/2005/07/scxml}state id=[s11]>\n     <{http://www.w3.org/2005/07/scxml}transition event=[internalEvent3] target=[s12]></>\n     </>\n     \n   <{http://www.w3.org/2005/07/scxml}state id=[s12]>\n     <{http://www.w3.org/2005/07/scxml}transition event=[internalEvent4] target=[pass]></>\n    </>\n\n</> \n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 423/test423.scxml
check xcanon("<!-- test that we keep pulling external events off the queue till we find one that matches a transition. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n <state id=\"s0\">\n  <onentry>\n    <send event=\"externalEvent1\"/>\n    <send event=\"externalEvent2\" delayexpr=\"'1s'\"/>\n    <raise event=\"internalEvent\"/>\n    </onentry>\n    <!-- in this state we should process only internalEvent -->\n   <transition event=\"internalEvent\" target=\"s1\"/>\n    <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n <state id=\"s1\">\n <!-- in this state we ignore externalEvent1 and wait for externalEvent2 -->\n   <transition event=\"externalEvent2\" target=\"pass\"/>\n   <transition event=\"internalEvent\" target=\"fail\"/>\n   </state>  \n   \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[externalEvent1]></>\n    <{http://www.w3.org/2005/07/scxml}send event=[externalEvent2] delayexpr=['1s']></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[internalEvent]></>\n    </>\n    \n   <{http://www.w3.org/2005/07/scxml}transition event=[internalEvent] target=[s1]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n \n   <{http://www.w3.org/2005/07/scxml}transition event=[externalEvent2] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[internalEvent] target=[fail]></>\n   </>  \n   \n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 444/test444.scxml
check xcanon("<!--  test that <data> creates a new ecmascript variable. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n  <datamodel>\n    <data id=\"var1\" expr=\"1\"/>\n    </datamodel>\n     \n<state id=\"s0\">\n<!-- test that var1 can be used as an ecmascript variable -->\n  <transition cond=\"++var1==2\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n</state>\n\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[var1] expr=[1]></>\n    </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n\n  <{http://www.w3.org/2005/07/scxml}transition cond=[++var1==2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n</>\n\n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 446/test446.scxml
check xcanon("<!-- in the ECMA data model, test that if the child of <data> is JSON, the processor\n assigns it as the value of the var --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"var1\">[1, 2, 3]</data>\n <data id=\"var2\" src=\"file:test446.txt\"/> \n  </datamodel>\n  \n<state id=\"s0\">\n   <transition cond=\"var1 instanceof Array\" target=\"s1\"/>\n   <transition target=\"fail\"/>\n  </state>\n  \n<state id=\"s1\">\n   <transition cond=\"var2 instanceof Array\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[var1]>[1, 2, 3]</>\n <{http://www.w3.org/2005/07/scxml}data id=[var2] src=[file:test446.txt]></> \n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[var1 instanceof Array] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[var2 instanceof Array] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>  \n\n</>"
# 449/test449.scxml
check xcanon("<!--  test that ecmascript objects are converted to booleans inside cond --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n \n     \n<state id=\"s0\">\n  <transition cond=\"'foo'\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n    </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n \n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=['foo'] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n    </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 452/test452.scxml
check xcanon("<!--  test that we can assign to any location in the datamodel. In this case, we just test that we can assign\nto a substructure (not the top level variable).  This may not be the most idiomatic way to write the test --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n <datamodel>\n   <data id=\"foo\" expr=\"0\"/>\n   </datamodel>\n    <script>\n    function testobject() {\n    this.bar = 0;}\n   </script>    \n<state id=\"s0\">\n <onentry>\n   <assign location=\"foo\" expr=\"new testobject();\"/>\n<!-- try to assign to foo's bar property -->\n   <assign location=\"foo.bar\" expr=\"1\"/>\n   <raise event=\"event1\"/>\n   </onentry>\n<!-- test that we have assigned to foo's bar property -->  \n   <transition event=\"event1\" cond=\"foo.bar == 1\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n    </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[foo] expr=[0]></>\n   </>\n    <{http://www.w3.org/2005/07/scxml}script>\n    function testobject() {\n    this.bar = 0;}\n   </>    \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[foo] expr=[new testobject();]></>\n\n   <{http://www.w3.org/2005/07/scxml}assign location=[foo.bar] expr=[1]></>\n   <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n   </>\n  \n   <{http://www.w3.org/2005/07/scxml}transition event=[event1] cond=[foo.bar == 1] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 456/test456.scxml
check xcanon("<!-- we can't test that _any_ ecmascript is valid inside <script>, so we\njust run a simple one and check that it can update the data model. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  </datamodel>\n  \n <state id=\"s0\">\n  <onentry>\n    <script>\n      Var1+=1\n      </script>\n   </onentry> \n   <transition cond=\"\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n   \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n  </>\n  \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}script>\n      Var1+=1\n      </>\n   </> \n   <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 459/test459.scxml
check xcanon("<!-- test that foreach goes over the array in the right order.  since the array contains 1 2 3, we compare the current \nvalue with the previous value, which is stored in var1. The current value should always be larger.  If\nit ever isn't, set Var4 to 0, indicating failure.  Also check that the final value of the index\nis 2 (meaning that the initial value was 0, not 1) --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/> <!-- contains the previous value -->\n  <data id=\"Var2\"/> <!-- the item which will contain the current value -->\n  <data id=\"Var3\"/>  <!-- the index -->\n  <data id=\"Var4\" expr=\"[1,2,3]\"/>\n  <data id=\"Var5\" expr=\"1\"/> <!-- 1 if success, 0 if failure -->\n  </datamodel>\n  \n   <state id=\"s0\">\n      <onentry>\n        <foreach item=\"Var2\" array=\"Var4\" index=\"Var3\">\n         <if cond=\"Var1&lt;Var2\">\n         <assign location=\"Var1\" expr=\"Var2\"/>\n         <else/>\n         <!-- values are out of order, record failure -->\n         <assign location=\"Var5\" expr=\"0\"/>\n         </if>\n          </foreach>\n        </onentry>\n\n  <!-- check that var1 has its original value  -->\n  <transition cond=\"Var4==0 | Var3 != 2\" target=\"fail\"/>\n  <transition target=\"pass\"/>\n  </state> \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></> \n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></> \n  <{http://www.w3.org/2005/07/scxml}data id=[Var3]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var4] expr=[[1,2,3]]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var5] expr=[1]></> \n  </>\n  \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n        <{http://www.w3.org/2005/07/scxml}foreach item=[Var2] array=[Var4] index=[Var3]>\n         <{http://www.w3.org/2005/07/scxml}if cond=[Var1<Var2]>\n         <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var2]></>\n         <{http://www.w3.org/2005/07/scxml}else></>\n         \n         <{http://www.w3.org/2005/07/scxml}assign location=[Var5] expr=[0]></>\n         </>\n          </>\n        </>\n\n  \n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var4==0 | Var3 != 2] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[pass]></>\n  </> \n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n\n\n</>"
# 487/test487.scxml
check xcanon("<!-- test illegal assignment.  error.execution should be raised.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\"/>\n  </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n  \t<assign location=\"Var1\" expr=\"return\"/>\n   <raise event=\"event\"/>\n   </onentry>\n   \n  <transition event=\"error.execution\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n  </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  \t<{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[return]></>\n   <{http://www.w3.org/2005/07/scxml}raise event=[event]></>\n   </>\n   \n  <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 495/test495.scxml
check xcanon("<!-- test that the scxml event i/o processor puts events in the correct queues.--><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n    <onentry>\n   <!-- default target is external queue -->\n   <send event=\"event1\" type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\"/>\n     <send event=\"event2\" target=\"#_internal\" type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\"/>\n     </onentry>\n     <!-- we should get the internal event first -->\n     <transition event=\"event1\" target=\"fail\"/>\n     <transition event=\"event2\" target=\"s1\"/>\n </state>\n    \n<state id=\"s1\">\n   <transition event=\"event1\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n   \n   <{http://www.w3.org/2005/07/scxml}send event=[event1] type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor]></>\n     <{http://www.w3.org/2005/07/scxml}send event=[event2] target=[#_internal] type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor]></>\n     </>\n     \n     <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[fail]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[s1]></>\n </>\n    \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 500/test500.scxml
check xcanon("<!-- test that location field is found inside entry for SCXML Event I/O processor --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"_ioprocessors['http://www.w3.org/TR/scxml/#SCXMLEventProcessor'].location\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <transition cond=\"Var1\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n   \n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[_ioprocessors['http://www.w3.org/TR/scxml/#SCXMLEventProcessor'].location]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   \n </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 503/test503.scxml
check xcanon("<!-- test that a targetless transition does not exit and reenter its source state --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s1\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>  <!-- how often we have exited s2 -->\n  <data id=\"Var2\" expr=\"0\"/>  <!-- how often the targetless transition in s2 has been executed -->\n  </datamodel>\n    \n <state id=\"s1\">\n   <onentry>\n    <raise event=\"foo\"/>\n    <raise event=\"bar\"/>\n    </onentry>\n   <transition target=\"s2\"/>\n   </state>\n  \n <state id=\"s2\">\n   <onexit>\n   <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n   </onexit>\n   <transition event=\"foo\">\n     <assign location=\"Var2\" expr=\"Var2 + 1\"/>\n     </transition>\n   <!-- make sure the transition on foo was actually taken --> \n  <transition event=\"bar\" cond=\"\" target=\"s3\"/>\n  <transition event=\"bar\" target=\"fail\"/>\n  </state>\n  \n  <state id=\"s3\">\n  <!-- make sure that s2 was exited only once -->\n    <transition cond=\"\" target=\"pass\"/>\n    <transition target=\"fail\"/>\n    </state> \n  \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s1] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[0]></>  \n  </>\n    \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s2]></>\n   </>\n  \n <{http://www.w3.org/2005/07/scxml}state id=[s2]>\n   <{http://www.w3.org/2005/07/scxml}onexit>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo]>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[Var2 + 1]></>\n     </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] cond=[] target=[s3]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] target=[fail]></>\n  </>\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s3]>\n  \n    <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n    </> \n  \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 505/test505.scxml
check xcanon("<!-- test that an internal transition does not exit its source state --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s1\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>  <!-- how often we have exited s1 -->\n  <data id=\"Var2\" expr=\"0\"/>  <!-- how often we have exited s11 -->\n  <data id=\"Var3\" expr=\"0\"/>  <!-- how often the transition for foo has been taken -->\n  </datamodel>\n    \n <state id=\"s1\">\n   <onentry>\n    <raise event=\"foo\"/>\n    <raise event=\"bar\"/>\n    </onentry>\n  <onexit>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onexit>\n  <transition event=\"foo\" type=\"internal\" target=\"s11\">\n     <assign location=\"Var3\" expr=\"Var3 + 1\"/>\n     </transition>\n     \n   <!-- make sure the transition on foo was actually taken --> \n  <transition event=\"bar\" cond=\"\" target=\"s2\"/>\n  <transition event=\"bar\" target=\"fail\"/>\n  \n <state id=\"s11\">\n   <onexit>\n   <assign location=\"Var2\" expr=\"Var2 + 1\"/>\n   </onexit>\n  </state>\n </state>\n  \n<state id=\"s2\">\n  <!-- make sure that s1 was exited once -->\n    <transition cond=\"\" target=\"s3\"/>\n    <transition target=\"fail\"/>\n </state> \n \n  \n<state id=\"s3\">\n  <!-- make sure that s11 was exited twice -->\n    <transition cond=\"\" target=\"pass\"/>\n    <transition target=\"fail\"/>\n </state>\n  \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s1] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var3] expr=[0]></>  \n  </>\n    \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}onexit>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] type=[internal] target=[s11]>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var3] expr=[Var3 + 1]></>\n     </>\n     \n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] cond=[] target=[s2]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] target=[fail]></>\n  \n <{http://www.w3.org/2005/07/scxml}state id=[s11]>\n   <{http://www.w3.org/2005/07/scxml}onexit>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[Var2 + 1]></>\n   </>\n  </>\n </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n  \n    <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[s3]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </> \n \n  \n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n  \n    <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </>\n  \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 509/test509.scxml
check xcanon("<!-- test that Basic HTTP Event I/O processor uses POST method and that it can receive messages\nat the accessURI --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\"/>\n     </onentry>\n     <!-- if the event was send by http and we get it, we succeed -->\n    <transition event=\"test\" cond=\"_event.raw.search('POST') !== -1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[30s]></>\n    <{http://www.w3.org/2005/07/scxml}send event=[test] targetexpr=[_ioprocessors['basichttp']['location']] type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor]></>\n     </>\n     \n    <{http://www.w3.org/2005/07/scxml}transition event=[test] cond=[_event.raw.search('POST') !== -1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 518/test518.scxml
check xcanon("<!-- test that that namelist values get encoded as POST parameters.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"2\"/>\n  </datamodel>\n\n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" namelist=\"Var1\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\"/>\n      </onentry>\n     \n  <transition event=\"test\" cond=\"\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n\n </state>\n \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[2]></>\n  </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[30s]></>\n    <{http://www.w3.org/2005/07/scxml}send event=[test] targetexpr=[_ioprocessors['basichttp']['location']] namelist=[Var1] type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor]></>\n      </>\n     \n  <{http://www.w3.org/2005/07/scxml}transition event=[test] cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n\n </>\n \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 520/test520.scxml
check xcanon("<!-- test that that <content> gets sent as the body of the message.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n    <content>this is some content</content>\n      </send>  \n     </onentry>\n     \n     <!-- if other end sends us back this event, we succeed.  Test for two common\n     ways of encoding -->\n  <transition event=\"HTTP.POST\" cond=\"_event.raw.search(/this+is+some+content/) !== -1\" target=\"pass\"/>\n  <transition event=\"HTTP.POST\" cond=\"_event.raw.search(/this%20is%20some%20content/) !== -1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[30s]></>\n    <{http://www.w3.org/2005/07/scxml}send targetexpr=[_ioprocessors['basichttp']['location']] type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor]>\n    <{http://www.w3.org/2005/07/scxml}content>this is some content</>\n      </>  \n     </>\n     \n     \n  <{http://www.w3.org/2005/07/scxml}transition event=[HTTP.POST] cond=[_event.raw.search(/this+is+some+content/) !== -1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[HTTP.POST] cond=[_event.raw.search(/this%20is%20some%20content/) !== -1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 522/test522.scxml
check xcanon("<!-- test that location field the entry for Basic HTTP Event I/O processor can be used\nto send a message to the processor --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n  \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\" targetexpr=\"_ioprocessors['basichttp']['location']\"/>\n\n     </onentry>\n     <!-- the event we receive should be called 'test', but that's not actually\n     required for this test. Only that the send deliver some event to us.  So if\n     we get something other than timeout or error, we call it success -->\n  <transition event=\"timeout\" target=\"fail\"/>\n  <transition event=\"error\" target=\"fail\"/>\n  <transition event=\"*\" target=\"pass\"/>\n\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[30s]></>\n    <{http://www.w3.org/2005/07/scxml}send event=[test] type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor] targetexpr=[_ioprocessors['basichttp']['location']]></>\n\n     </>\n     \n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[pass]></>\n\n </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 527/test527.scxml
check xcanon("<!-- simple test that 'expr' works with <content> --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n     \n <state id=\"s0\" initial=\"s01\">\n    \n   <transition event=\"done.state.s0\" cond=\"_event.data == 'foo'\" target=\"pass\">\n     </transition>\n     \n      <transition event=\"done.state.s0\" target=\"fail\">\n     </transition>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <content expr=\"'foo'\"/>\n      </donedata>\n     </final>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n    \n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] cond=[_event.data == 'foo'] target=[pass]>\n     </>\n     \n      <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] target=[fail]>\n     </>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s02]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}final id=[s02]>\n     <{http://www.w3.org/2005/07/scxml}donedata>\n      <{http://www.w3.org/2005/07/scxml}content expr=['foo']></>\n      </>\n     </>\n </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 529/test529.scxml
check xcanon("<!-- simple test that children workn with <content> --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n     \n <state id=\"s0\" initial=\"s01\">\n    \n   <transition event=\"done.state.s0\" cond=\"_event.data == 21\" target=\"pass\">\n     </transition>\n     \n      <transition event=\"done.state.s0\" target=\"fail\">\n     </transition>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <content>21</content>\n      </donedata>\n     </final>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n    \n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] cond=[_event.data == 21] target=[pass]>\n     </>\n     \n      <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] target=[fail]>\n     </>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s02]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}final id=[s02]>\n     <{http://www.w3.org/2005/07/scxml}donedata>\n      <{http://www.w3.org/2005/07/scxml}content>21</>\n      </>\n     </>\n </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 531/test531.scxml
check xcanon("<!-- test that that the value of the <param> _scxmleventname gets used as the name\nof the raised event. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    <send targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n      <param name=\"_scxmleventname\" expr=\"'test'\"/>\n      </send>  \n     </onentry>\n     \n     <!-- if we get an event named 'test' we succeed. Otherwise fail -->\n  <transition event=\"test\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></>\n    <{http://www.w3.org/2005/07/scxml}send targetexpr=[_ioprocessors['basichttp']['location']] type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor]>\n      <{http://www.w3.org/2005/07/scxml}param name=[_scxmleventname] expr=['test']></>\n      </>  \n     </>\n     \n     \n  <{http://www.w3.org/2005/07/scxml}transition event=[test] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 533/test533.scxml
check xcanon("<!-- test that an internal transition whose source state is not compound does  exit its source state --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s1\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>  <!-- how often we have exited p -->\n  <data id=\"Var2\" expr=\"0\"/>  <!-- how often we have exited ps1 -->\n  <data id=\"Var3\" expr=\"0\"/>  <!-- how often we have exited ps2 -->\n  <data id=\"Var4\" expr=\"0\"/>  <!-- how often the transition for foo has been taken -->\n  </datamodel>\n    \n <state id=\"s1\">\n   <onentry>\n    <raise event=\"foo\"/>\n    <raise event=\"bar\"/>\n    </onentry>\n   <transition target=\"p\"/>\n   </state>\n\n<parallel id=\"p\">\n  <onexit>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onexit>\n  <transition event=\"foo\" type=\"internal\" target=\"ps1\">\n     <assign location=\"Var4\" expr=\"Var4 + 1\"/>\n     </transition>\n     \n   <!-- make sure the transition on foo was actually taken --> \n  <transition event=\"bar\" cond=\"\" target=\"s2\"/>\n  <transition event=\"bar\" target=\"fail\"/>\n  \n <state id=\"ps1\">\n   <onexit>\n   <assign location=\"Var2\" expr=\"Var2 + 1\"/>\n   </onexit>\n  </state>\n  <state id=\"ps2\">\n   <onexit>\n   <assign location=\"Var3\" expr=\"Var3 + 1\"/>\n   </onexit>\n  </state>\n</parallel>\n  \n<state id=\"s2\">\n  <!-- make sure that p was exited twice -->\n    <transition cond=\"\" target=\"s3\"/>\n    <transition target=\"fail\"/>\n </state> \n \n<state id=\"s3\">\n  <!-- make sure that ps1 was exited twice -->\n    <transition cond=\"\" target=\"s4\"/>\n    <transition target=\"fail\"/>\n </state> \n  \n<state id=\"s4\">\n  <!-- make sure that ps2 was exited twice -->\n    <transition cond=\"\" target=\"pass\"/>\n    <transition target=\"fail\"/>\n </state>\n  \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s1] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var3] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var4] expr=[0]></>  \n  </>\n    \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}transition target=[p]></>\n   </>\n\n<{http://www.w3.org/2005/07/scxml}parallel id=[p]>\n  <{http://www.w3.org/2005/07/scxml}onexit>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] type=[internal] target=[ps1]>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var4] expr=[Var4 + 1]></>\n     </>\n     \n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] cond=[] target=[s2]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] target=[fail]></>\n  \n <{http://www.w3.org/2005/07/scxml}state id=[ps1]>\n   <{http://www.w3.org/2005/07/scxml}onexit>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[Var2 + 1]></>\n   </>\n  </>\n  <{http://www.w3.org/2005/07/scxml}state id=[ps2]>\n   <{http://www.w3.org/2005/07/scxml}onexit>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var3] expr=[Var3 + 1]></>\n   </>\n  </>\n</>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n  \n    <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[s3]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </> \n \n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n  \n    <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[s4]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </> \n  \n<{http://www.w3.org/2005/07/scxml}state id=[s4]>\n  \n    <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </>\n  \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 550/test550.scxml
check xcanon("<!-- test that expr can be used to assign a value to a var.  This test uses early binding --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" binding=\"early\">\n    \n   <state id=\"s0\">\n \n       <transition cond=\"\" target=\"pass\"/>\n       <transition target=\"fail\"/>\n   </state>\n   \n   <state id=\"s1\">\n   \t<datamodel>\n    <data id=\"Var1\" expr=\"2\"/>\n    </datamodel>\n    </state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript] binding=[early]>\n    \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n \n       <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n       <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   \t<{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[2]></>\n    </>\n    </>\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n\n\n</>"
# 552/test552.scxml
check xcanon("<!-- test that src content can be used to assign a value to a var. Edit\ntest552.txt to have a value that's legal for the datamodel in question --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n  <datamodel>\n    <data id=\"Var1\" src=\"file:test552.txt\"/>\n    </datamodel>\n    \n   <state id=\"s0\">\n \n       <transition cond=\"Var1\" target=\"pass\"/>\n       <transition target=\"fail\"/>\n   </state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var1] src=[file:test552.txt]></>\n    </>\n    \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n \n       <{http://www.w3.org/2005/07/scxml}transition cond=[Var1] target=[pass]></>\n       <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n\n\n</>"
# 554/test554.scxml
check xcanon("<!-- test that if the evaluation of <invoke>'s args causes an error, the \ninvocation is cancelled.  In this test, that means that we don't get done.invoke \nbefore the timer goes off.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timer\" delayexpr=\"'1s'\"/>\n    </onentry>\n    \n  <!-- reference an invalid namelist -->\n   <invoke type=\"http://www.w3.org/TR/scxml/\" namelist=\"&quot;foo\">\n      <content>\n       <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n             <final id=\"subFinal\"/>\n            </scxml>\n            </content>\n            </invoke>\n     <transition event=\"timer\" target=\"pass\"/>\n     <transition event=\"done.invoke\" target=\"fail\"/>\n   </state>   \n     \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timer] delayexpr=['1s']></>\n    </>\n    \n  \n   <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] namelist=[\"foo]>\n      <{http://www.w3.org/2005/07/scxml}content>\n       <{http://www.w3.org/2005/07/scxml}scxml initial=[subFinal] version=[1.0] datamodel=[ecmascript]>\n             <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n            </>\n            </>\n            </>\n     <{http://www.w3.org/2005/07/scxml}transition event=[timer] target=[pass]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[fail]></>\n   </>   \n     \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 558/test558.scxml
check xcanon("<!-- in the ECMA data model, test that if the child of <data> is not XML, or if XML is loaded via src=, \n the processor treats the value as a string, does whitespace normalization and assigns it to the var.--><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"var1\">\nthis  is \na string \n</data>\n  <data id=\"var2\" src=\"file:test558.txt\"/> \n  </datamodel>\n  \n<state id=\"s0\">\n   <transition cond=\"var1 == 'this is a string'\" target=\"s1\"/>\n   <transition target=\"fail\"/>\n  </state>\n  \n<state id=\"s1\">\n   <transition cond=\"var2 == 'this is a string'\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[var1]>\nthis  is \na string \n</>\n  <{http://www.w3.org/2005/07/scxml}data id=[var2] src=[file:test558.txt]></> \n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[var1 == 'this is a string'] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[var2 == 'this is a string'] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>  \n\n</>"
# 561/test561.scxml
check xcanon("<!-- in the ECMA data model, test that processor creates an ECMAScript DOM object\n _event.data when receiving XML in an event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n   <onentry>\n    <send event=\"foo\">\n    <content>\n<books xmlns=\"\">\n<book title=\"title1\"/>\n<book title=\"title2\"/>\n</books>\n</content>\n    </send>\n  </onentry>\n  <transition event=\"foo\" cond=\"_event.data.getElementsByTagName('book')[1].getAttribute('title') == 'title2'\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[foo]>\n    <{http://www.w3.org/2005/07/scxml}content>\n<{}books>\n<{}book title=[title1]></>\n<{}book title=[title2]></>\n</>\n</>\n    </>\n  </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=[_event.data.getElementsByTagName('book')[1].getAttribute('title') == 'title2'] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n  \n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>  \n\n</>"
# 567/test567.scxml
check xcanon("<!-- test that that any content in the message other than _scxmleventname is used to populate\n_event.data.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n <data id=\"Var1\" expr=\"2\"/>\n  </datamodel>\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n <!-- in this case, 'test' will be placed in _scxmleventname.  The <param> should\n be used to populate _event.data -->\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n    <param name=\"param1\" expr=\"2\"/>\n      </send>  \n     </onentry>\n     \n     <!-- if we get this event, we succeed -->\n  <transition event=\"test\" target=\"s1\">\n    <assign location=\"Var1\" expr=\"_event.data.param1\"/>\n      </transition>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n  <state id=\"s1\">\n    <transition cond=\"\" target=\"pass\"/>\n    <transition target=\"fail\"/>\n    </state>\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[2]></>\n  </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></>\n \n    <{http://www.w3.org/2005/07/scxml}send event=[test] targetexpr=[_ioprocessors['basichttp']['location']] type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor]>\n    <{http://www.w3.org/2005/07/scxml}param name=[param1] expr=[2]></>\n      </>  \n     </>\n     \n     \n  <{http://www.w3.org/2005/07/scxml}transition event=[test] target=[s1]>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.data.param1]></>\n      </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n    <{http://www.w3.org/2005/07/scxml}transition cond=[] target=[pass]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 570/test570.scxml
check xcanon("<!-- test that we generate done.state.id when all a parallel state's children are in final states --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"p0\" datamodel=\"ecmascript\" version=\"1.0\">\n  <datamodel>\n    <data id=\"Var1\" expr=\"0\"/>\n    </datamodel>\n<parallel id=\"p0\">\n  <onentry>\n   <send event=\"timeout\" delay=\"2s\"/>\n   <raise event=\"e1\"/>\n   <raise event=\"e2\"/>\n   </onentry>\n   <!-- record that we get the first done event -->\n   <transition event=\"done.state.p0s1\">\n     <assign location=\"Var1\" expr=\"1\"/>\n     </transition>\n   <!-- we should get the second done event before done.state.p0 -->\n   <transition event=\"done.state.p0s2\" target=\"s1\"/>\n   <transition event=\"timeout\" target=\"fail\"/>\n\n   \n   <state id=\"p0s1\" initial=\"p0s11\">\n    <state id=\"p0s11\">\n      <transition event=\"e1\" target=\"p0s1final\"/>\n      </state>\n    <final id=\"p0s1final\"/>\n   </state>\n   \n  <state id=\"p0s2\" initial=\"p0s21\">\n    <state id=\"p0s21\">\n       <transition event=\"e2\" target=\"p0s2final\"/>\n     </state>\n    <final id=\"p0s2final\"/>\n   </state>\n  \n </parallel>\n \n <state id=\"s1\">\n  <!-- if we get done.state.p0, success -->\n  <transition event=\"done.state.p0\" cond=\"\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[p0] datamodel=[ecmascript] version=[1.0]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n    </>\n<{http://www.w3.org/2005/07/scxml}parallel id=[p0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n   <{http://www.w3.org/2005/07/scxml}raise event=[e1]></>\n   <{http://www.w3.org/2005/07/scxml}raise event=[e2]></>\n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.p0s1]>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[1]></>\n     </>\n   \n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.p0s2] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n\n   \n   <{http://www.w3.org/2005/07/scxml}state id=[p0s1] initial=[p0s11]>\n    <{http://www.w3.org/2005/07/scxml}state id=[p0s11]>\n      <{http://www.w3.org/2005/07/scxml}transition event=[e1] target=[p0s1final]></>\n      </>\n    <{http://www.w3.org/2005/07/scxml}final id=[p0s1final]></>\n   </>\n   \n  <{http://www.w3.org/2005/07/scxml}state id=[p0s2] initial=[p0s21]>\n    <{http://www.w3.org/2005/07/scxml}state id=[p0s21]>\n       <{http://www.w3.org/2005/07/scxml}transition event=[e2] target=[p0s2final]></>\n     </>\n    <{http://www.w3.org/2005/07/scxml}final id=[p0s2final]></>\n   </>\n  \n </>\n \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[done.state.p0] cond=[] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 577/test577.scxml
check xcanon("<!-- test that that <send> without target in basichttp event i/o processor\ncauses error.communication to get added to internal queue . --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n  <!-- sent by scxml event i/o processor, added to external queue -->\n    <send event=\"event1\"/>\n    <!-- should put error.communication on internal queue -->\n    <send event=\"test\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\"/>\n\n     </onentry>\n     \n  \n  <transition event=\"error.communication\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  \n    <{http://www.w3.org/2005/07/scxml}send event=[event1]></>\n    \n    <{http://www.w3.org/2005/07/scxml}send event=[test] type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor]></>\n\n     </>\n     \n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[error.communication] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 579/test579.scxml
check xcanon("<!-- test that default history content is executed correctly.   The Process MUST execute any executable content in the transition after the parent state's onentry handlers, and, in the case where the history pseudo-state is the target of an <initial> transition, \nthe executable content inside the <initial> transition.  However the Processor MUST\nexecute this content only if there is no stored history.  Once the history state's\nparent state has been visited and exited, the default history content must not be executed --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s0\" datamodel=\"ecmascript\">\n\n       \n<state id=\"s0\">\n\t<datamodel>\n\t\t  <data id=\"Var1\" expr=\"0\"/>\n\t\t</datamodel>\n\t<initial>\n\t\t <transition target=\"sh1\">\n\t\t \t<raise event=\"event2\"/>\n\t\t \t</transition>\n\t\t \t</initial>\n  <onentry>\n  \t<send delayexpr=\"'1s'\" event=\"timeout\"/>\n    <raise event=\"event1\"/>\n    </onentry>\n  <onexit>\n  \t<assign location=\"Var1\" expr=\"Var1 + 1\"/>\n  \t</onexit>\n <history id=\"sh1\">\n \t  <transition target=\"s01\">\n \t  \t <raise event=\"event3\"/>\n \t  \t</transition>\n  \t</history>\n  \t\n  \t<state id=\"s01\">\n  \t\t<transition event=\"event1\" target=\"s02\"/>\n  \t\t<transition event=\"*\" target=\"fail\"/>\n  \t\t</state>\n  \t\t\n  <state id=\"s02\">\n  \t<transition event=\"event2\" target=\"s03\"/>\n  \t<transition event=\"*\" target=\"fail\"/>\n  \t\t\t</state>\n  <state id=\"s03\">\n  \t\n  \t<transition cond=\"\" event=\"event3\" target=\"s0\"/>\n  \t<transition cond=\"\" event=\"event1\" target=\"s2\"/>\n  \t<transition event=\"*\" target=\"fail\"/>\n  \t</state>\n</state> \n\n<state id=\"s2\">\n\t<transition event=\"event2\" target=\"s3\"/>\n\t<transition event=\"*\" target=\"fail\"/>\n\n\t</state>   \n\n<state id=\"s3\">\n\t<transition event=\"event3\" target=\"fail\"/>\n\t<transition event=\"timeout\" target=\"pass\"/>\n\t</state>\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s0] datamodel=[ecmascript]>\n\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n\t<{http://www.w3.org/2005/07/scxml}datamodel>\n\t\t  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n\t\t</>\n\t<{http://www.w3.org/2005/07/scxml}initial>\n\t\t <{http://www.w3.org/2005/07/scxml}transition target=[sh1]>\n\t\t \t<{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n\t\t \t</>\n\t\t \t</>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  \t<{http://www.w3.org/2005/07/scxml}send delayexpr=['1s'] event=[timeout]></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}onexit>\n  \t<{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n  \t</>\n <{http://www.w3.org/2005/07/scxml}history id=[sh1]>\n \t  <{http://www.w3.org/2005/07/scxml}transition target=[s01]>\n \t  \t <{http://www.w3.org/2005/07/scxml}raise event=[event3]></>\n \t  \t</>\n  \t</>\n  \t\n  \t<{http://www.w3.org/2005/07/scxml}state id=[s01]>\n  \t\t<{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s02]></>\n  \t\t<{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  \t\t</>\n  \t\t\n  <{http://www.w3.org/2005/07/scxml}state id=[s02]>\n  \t<{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[s03]></>\n  \t<{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  \t\t\t</>\n  <{http://www.w3.org/2005/07/scxml}state id=[s03]>\n  \t\n  \t<{http://www.w3.org/2005/07/scxml}transition cond=[] event=[event3] target=[s0]></>\n  \t<{http://www.w3.org/2005/07/scxml}transition cond=[] event=[event1] target=[s2]></>\n  \t<{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  \t</>\n</> \n\n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n\t<{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[s3]></>\n\t<{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n\n\t</>   \n\n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n\t<{http://www.w3.org/2005/07/scxml}transition event=[event3] target=[fail]></>\n\t<{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[pass]></>\n\t</>\n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
