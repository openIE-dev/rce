# Checks for lib/text/utf8.rce. Markus Kuhn's UTF-8 decoder capability and
# stress test (vectors/text/UTF-8-test.txt): every line with a non-ASCII
# byte, and the whole file, checked for validity, first-error offset and
# the U+FFFD-substituted code points (generated by scripts/gen/text_gen.py).
# Then Unicode 3.9 Table 3-8 (U+FFFD substitution example), boundary
# cases, and a seeded round-trip sweep.

fn nib(c: i64) -> i64 = if c >= 97 then c - 87 else c - 48

fn unhex(h: &text) -> List[i64]
    var o: List[i64] = []
    var i: usize = 0
    while i + 1 < h.len() bound 1048576
        o.push(nib(h[i] as i64) * 16 + nib(h[i + 1] as i64))
        i += 2
    return o

fn kuhn(h: text, err: i64, cps: List[i64]) -> bool
    let b = unhex(&h)
    let strict = utf8_decode(&b) catch [-1]
    let want_strict = if err < 0 then copy(cps) else [-1]
    return utf8_first_error(&b) == err and utf8_valid(&b) == (err < 0) and utf8_decode_lossy(&b) == cps and strict == want_strict

fn kuhn_file(h: text, err: i64, ncp: i64, nrep: i64) -> bool
    let b = unhex(&h)
    let cps = utf8_decode_lossy(&b)
    var r: i64 = 0
    for c in cps
        if c == REPLACEMENT
            r += 1
    return utf8_first_error(&b) == err and (cps.len() as i64) == ncp and r == nrep

fn rnd(s: i64) -> i64 = (s * 1103515245 + 12345) & 2147483647

# Random scalar values (all four lengths, skipping surrogates) encode,
# validate and decode back; UTF-16 round-trips.
fn sweep(n: i64) -> bool
    var s: i64 = 23
    var cps: List[i64] = []
    for i in 0..n
        s = rnd(s)
        let lim = if i % 4 == 0 then 128 else (if i % 4 == 1 then 2048 else (if i % 4 == 2 then 65536 else 1114112))
        var c = s % lim
        if c >= 55296 and c <= 57343
            c = c - 2048
        cps.push(c)
    let b = utf8_encode(&cps)
    let u = utf16_of_cps(&cps)
    return utf8_valid(&b) and (utf8_decode(&b) catch [-1]) == cps and (utf16_decode(&u) catch [-1]) == cps

fn lossy(h: text) -> List[i64]
    let b = unhex(&h)
    return utf8_decode_lossy(&b)

fn enc(cps: List[i64]) -> List[i64] = utf8_encode(&cps)

fn u16bad(u: List[i64]) -> bool = (utf16_decode(&u) catch [-1]) == [-1]

fn hexb(h: text) -> List[i64] = unhex(&h)

fn u16_of(t: text) -> List[i64]
    let c = codepoints(&t)
    return utf16_of_cps(&c)

fn cps_of(t: text) -> List[i64] = codepoints(&t)

fn count_of(t: text) -> i64 = cp_count(&t)

check sweep(400)
# Unicode 15.0 section 3.9, Table 3-8: 61 F1 80 80 E1 80 C2 62 80 63 80 BF 64
check lossy("61f18080e180c262806380bf64") == [97, 65533, 65533, 65533, 98, 65533, 99, 65533, 65533, 100]
check enc([0, 127, 128, 2047, 2048, 55295, 57344, 65535, 65536, 1114111]) == hexb("007fc280dfbfe0a080ed9fbfee8080efbfbff0908080f48fbfbf")
check lossy("eda080") == [65533, 65533, 65533] and lossy("f4908080") == [65533, 65533, 65533, 65533] and lossy("c0af") == [65533, 65533] and lossy("e080af") == [65533, 65533, 65533]
check u16bad([55296]) and u16bad([56320, 55296]) and u16bad([55296, 65])
check cps_of("a\u{e9}\u{20ac}\u{1f600}") == [97, 233, 8364, 128512] and count_of("a\u{e9}\u{20ac}\u{1f600}") == 4
check u16_of("\u{1f600}") == [55357, 56832]

