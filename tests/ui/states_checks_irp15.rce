# generated by scripts/gen/irp_gen.py; do not edit
# the outcome of an IRP document: the id of the top-level final state
# reached ("pass" or "fail"), or "err <why>" when it is rejected
fn irp(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.err != ""
        return "err " + r.err
    return copy(r.outcome)
fn irp_trace(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return ",".join(r.trace)
fn irp_logs(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return "|".join(r.logs)
# the child's and the parent's logs of the forwarded event agree
fn irp_same(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.logs.len() != 14
        return "logs " + "|".join(r.logs)
    for i in 0..7
        if r.logs[i] != r.logs[i + 7]
            return "differ " + r.logs[i] + " / " + r.logs[i + 7]
    return ""
# a Basic HTTP request (bodies[0]) into a running document: the response
# status, then the outcome
fn irp_http(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let none_: List[text] = []
    let r = run_scxml_http(&doc, &none_, &none_, &no_evs, &bodies)
    let hs = copy(r.http)
    let oc = copy(r.outcome)
    return "|".join(hs) + "|" + oc
# 350/test350.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that target value is used to decide what session to deliver the event to.  A session should be\nable to send an event to itself using its own session ID as the target --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"'#_scxml_'\"/>\n  <data id=\"Var2\" expr=\"_sessionid\"/> \n</datamodel>\n  \n<state id=\"s0\">\n\n   <onentry>\n     <assign location=\"Var1\" expr=\"Var1 + Var2\"/> \n     <send delay=\"5s\" event=\"timeout\"/>\n     <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" targetexpr=\"Var1\" event=\"s0Event\"/> \n     </onentry>\n  <transition event=\"s0Event\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n\n</state>\n\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 351/test351.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that sendid is set in event if present in send, blank otherwise --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\"/>\n  <data id=\"Var2\"/>\n  </datamodel>\n\n  \n<state id=\"s0\">\n\n   <onentry>\n     <send delay=\"5s\" event=\"timeout\"/>\n     <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" id=\"send1\" event=\"s0Event\"/>  \n     </onentry>\n  <transition event=\"s0Event\" target=\"s1\">\n    <assign location=\"Var1\" expr=\"_event.sendid\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\">\n    </transition>\n\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1=='send1'\" target=\"s2\"/>\n  <transition target=\"fail\"/>\n </state>\n \n<state id=\"s2\">\n\n   <onentry>\n     <send delay=\"5s\" event=\"timeout\"/>\n      <send event=\"s0Event2\"/>\n     </onentry>\n  <transition event=\"s0Event2\" target=\"s3\">\n    <assign location=\"Var2\" expr=\"_event.sendid\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n\n<state id=\"s3\">\n  <transition cond=\"!Var2\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n </state>\n\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 352/test352.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test the origintype is 'http://www.w3.org/TR/scxml/#SCXMLEventProcessor' --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\"/>\n  </datamodel>\n\n  \n<state id=\"s0\">\n   <onentry>\n     <send delay=\"5s\" event=\"timeout\"/>\n    <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" event=\"s0Event\"/>  \n     </onentry>\n  <transition event=\"s0Event\" target=\"s1\">\n    <assign location=\"Var1\" expr=\"_event.origintype\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\">\n    </transition>\n\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1=='http://www.w3.org/TR/scxml/#SCXMLEventProcessor'\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n </state>\n \n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 354/test354.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that event.data can be populated using both namelist, param and <content>\nand that correct values are used --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n  <data id=\"Var2\"/>\n  <data id=\"Var3\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n   <onentry>\n     <send delay=\"5s\" event=\"timeout\"/>\n    <send event=\"event1\" type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" namelist=\"Var1\"> \n      <param name=\"param1\" expr=\"2\"/>\n      </send> \n     </onentry>\n  <transition event=\"event1\" target=\"s1\">\n    <assign location=\"Var2\" expr=\"_event.data.Var1\"/>\n    <assign location=\"Var3\" expr=\"_event.data.param1\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\">\n    </transition>\n\n</state>\n\n<state id=\"s1\">\n  \n  <transition cond=\"Var2==1\" target=\"s2\"/>\n  <transition target=\"fail\"/>\n  </state>\n\n<state id=\"s2\">\n    <transition cond=\"Var3==2\" target=\"s3\"/>\n  <transition target=\"fail\"/>\n  </state>\n\n<state id=\"s3\">\n   <onentry>\n     <send delay=\"5s\" event=\"timeout\"/>\n    <send event=\"event2\"> \n      <content>123</content>\n      </send>\n     </onentry>\n  <transition event=\"event2\" cond=\"_event.data == 123\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n\n</state>\n\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 495/test495.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the scxml event i/o processor puts events in the correct queues.--><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n    <onentry>\n   <!-- default target is external queue -->\n   <send event=\"event1\" type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\"/>\n     <send event=\"event2\" target=\"#_internal\" type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\"/>\n     </onentry>\n     <!-- we should get the internal event first -->\n     <transition event=\"event1\" target=\"fail\"/>\n     <transition event=\"event2\" target=\"s1\"/>\n </state>\n    \n<state id=\"s1\">\n   <transition event=\"event1\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 496/test496.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n   <onentry>\n     <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" event=\"event\" target=\"#_scxml_foo\"/>\n     <raise event=\"foo\"/>\n     </onentry>\n   <transition event=\"error.communication\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n    \n\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 500/test500.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that location field is found inside entry for SCXML Event I/O processor --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"_ioprocessors['http://www.w3.org/TR/scxml/#SCXMLEventProcessor'].location\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <transition cond=\"Var1\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n   \n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 501/test501.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the location entry for the SCXML Event I/O processor can be used as the target for an event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"_ioprocessors['http://www.w3.org/TR/scxml/#SCXMLEventProcessor'].location\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n    <send targetexpr=\"Var1\" event=\"foo\"/>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n  <transition event=\"foo\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n   \n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 509/test509.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that Basic HTTP Event I/O processor uses POST method and that it can receive messages\nat the accessURI --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\"/>\n     </onentry>\n     <!-- if the event was send by http and we get it, we succeed -->\n    <transition event=\"test\" cond=\"_event.raw.search('POST') !== -1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 510/test510.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that Basic HTTP messages go into external queue.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n  \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\"/>\n     <!-- this creates an internal event -->\n     <raise event=\"internal\"/>\n  \n      </onentry>\n     <!-- we should get 'internal' first, then 'test' -->\n  <transition event=\"internal\" target=\"s1\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n <state id=\"s1\">\n   <transition event=\"test\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 513/test513.txt (optional)
check irp_http("<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\"><state id=\"s0\"><transition event=\"test\" cond=\"_event.data.key1 == 'value1' &amp;&amp; _event.data.key2 == 'value2'\" target=\"pass\"/><transition event=\"*\" target=\"fail\"/></state><final id=\"pass\"/><final id=\"fail\"/></scxml>", ["request"], ["POST /s0/basichttp HTTP/1.1\r\nHost: scxml.local\r\n_scxmleventname: test\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 23\r\n\r\nkey1=value1&key2=value2"]) == "200 OK|pass"
# 518/test518.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that that namelist values get encoded as POST parameters.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"2\"/>\n  </datamodel>\n\n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" namelist=\"Var1\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\"/>\n      </onentry>\n     \n  <transition event=\"test\" cond=\"_event.raw.search(/Var1=2/) !== -1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n\n </state>\n \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
