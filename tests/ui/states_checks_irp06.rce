# generated by scripts/gen/irp_gen.py; do not edit
# the outcome of an IRP document: the id of the top-level final state
# reached ("pass" or "fail"), or "err <why>" when it is rejected
fn irp(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.err != ""
        return "err " + r.err
    return copy(r.outcome)
fn irp_trace(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return ",".join(r.trace)
fn irp_logs(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return "|".join(r.logs)
# the child's and the parent's logs of the forwarded event agree
fn irp_same(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.logs.len() != 14
        return "logs " + "|".join(r.logs)
    for i in 0..7
        if r.logs[i] != r.logs[i + 7]
            return "differ " + r.logs[i] + " / " + r.logs[i + 7]
    return ""
# a Basic HTTP request (bodies[0]) into a running document: the response
# status, then the outcome
fn irp_http(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let none_: List[text] = []
    let r = run_scxml_http(&doc, &none_, &none_, &no_evs, &bodies)
    let hs = copy(r.http)
    let oc = copy(r.outcome)
    return "|".join(hs) + "|" + oc
# 307/test307.txml (mandatory)
check irp_logs("<?xml version=\"1.0\" encoding=\"UTF-8\"?><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\" initial=\"s0\" binding=\"late\">\n\n<!-- with binding=late, in s0 we access a variable that isn't created until we get to s1.  Then in s1\nwe access a non-existent substructure of a variable.  We use log tags to report the values that both operations\nyield, and whether there are errors.  This is a manual test, since the tester must report whether the output\nis the same in the two cases -->\n\n<state id=\"s0\">\n  <onentry>\n    <log label=\"entering s0 value of Var 1 is: \" expr=\"Var1\"/>\n    <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"error\" target=\"s1\"> \n     <log label=\"error in state s0\" expr=\"_event\"/>\n     </transition>\n   <transition event=\"foo\" target=\"s1\">\n     <log label=\"no error in s0\" expr=\"\"/>\n     </transition>\n   </state>\n   \n<state id=\"s1\">\n  <datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n \n  <onentry>\n   <log label=\"entering s1, value of non-existent substructure of Var 1 is: \" expr=\"Var1.bar\"/>\n   <raise event=\"bar\"/>\n   </onentry>\n\n    <transition event=\"error\" target=\"final\"> \n     <log label=\"error in state s1\" expr=\"_event\"/>\n     </transition>\n   <transition event=\"bar\" target=\"final\">\n     <log label=\"No error in s1\" expr=\"\"/>\n     </transition>\n\n</state>\n    \n<final id=\"final\"/>\n   \n</scxml>", [], []) == "entering s0 value of Var 1 is: :undefined|no error in s0:|entering s1, value of non-existent substructure of Var 1 is: :undefined|No error in s1:"
# 309/test309.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that an expression that cannot be interpreted as a boolean is treated as false --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n<state id=\"s0\"> \n  <transition cond=\"return\" target=\"fail\"/>\n  <transition target=\"pass\"/>\n  </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
# 310/test310.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- simple test of the in() predicate --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"p\">\n\n     \n <parallel id=\"p\">\n \n   <state id=\"s0\">\n   <transition cond=\"In('s1')\" target=\"pass\"/> \n   <transition target=\"fail\"/>\n   </state>\n\n   <state id=\"s1\"/> \n </parallel>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
# 311/test311.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that assignment to a non-existent location yields an error --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n\n<state id=\"s0\">\n  <onentry>\n  \t<send event=\"timeout\" delay=\"1s\"/>\n   <assign location=\"foo.bar.baz \" expr=\"1\"/>\n   </onentry>\n   <transition event=\"error.execution\" target=\"pass\"/> \n   <transition event=\".*\" target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
# 312/test312.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that assignment with an illegal expr raises an error --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n\n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"return\"/>\n   <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"error.execution\" target=\"pass\"/> \n   <transition event=\".*\" target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
# 313/test313.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- this is a manual test. The processor is allowed to reject this doc, but if it executes it with its illegal\nexpression, it must raise an error --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n\n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"return\"/>\n   <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"error.execution\" target=\"pass\"/> \n   <transition event=\".*\" target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
# 314/test314.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- this is a manual test because the processor is allowed to reject this document.  But if it executes it,\nit should not raise an error until it gets to s03 and evaluates the illegal expr --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n\n\n<state id=\"s0\" initial=\"s01\">\n  <transition event=\"error.execution\" target=\"fail\"/>\n  \n   <state id=\"s01\">\n      <transition target=\"s02\"/>\n    </state>\n\n   <state id=\"s02\">\n     <transition target=\"s03\"/>\n   </state>\n\n  <state id=\"s03\">\n    <onentry>\n     <assign location=\"Var1\" expr=\"return\"/>\n      <raise event=\"foo\"/>\n   </onentry>\n     <transition event=\"error.execution\" target=\"pass\"/> \n     <transition event=\".*\" target=\"fail\"/>\n  </state>\n   \n</state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
# 344/test344.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that a cond expression that cannot be evaluated as a \nboolean cond expression evaluates to false and causes error.execution to be raised.\nIn some languages, any valid expression/object can be converted to a boolean, so conf:nonBoolean will\nhave to be mapped onto something that produces a syntax error or something similarly invalid --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n<state id=\"s0\"> \n  <transition cond=\"return\" target=\"fail\"/>\n  <transition target=\"s1\"/>\n  </state>\n  \n<state id=\"s1\">\n  <onentry>\n    <raise event=\"foo\"/>\n    </onentry>\n  <transition event=\"error.execution\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
# 318/test318.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that _event stays bound during the onexit and entry into the next state --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">\n<datamodel>\n <data id=\"Var1\"/>\n </datamodel>\n     \n <state id=\"s0\">\n   <onentry>\n     <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" target=\"s1\"/> \n   </state>\n   \n <state id=\"s1\">\n  <onentry>\n    <raise event=\"bar\"/>\n    <!-- _event should still be bound to 'foo' at this point -->\n    <assign location=\"Var1\" expr=\"_event.name\"/>\n    </onentry>\n   <transition cond=\"Var1=='foo'\" target=\"pass\"/> \n   <transition target=\"fail\"/>\n   </state>\n   \n    \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 319/test319.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that _event is not bound before any event has been raised --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\" name=\"machineName\">\n\n <state id=\"s0\">\n   <onentry>\n     <if cond=\"_event\">\n       <raise event=\"bound\"/>\n       <else/>\n         <raise event=\"unbound\"/>\n     </if>\n   </onentry>\n   <transition event=\"unbound\" target=\"pass\"/>\n   <transition event=\"bound\" target=\"fail\"/> \n\n   </state>\n   \n    \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 321/test321.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that _sessionid is bound on startup --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\" name=\"machineName\">\n<datamodel>\n  <data id=\"Var1\" expr=\"_sessionid\"/>\n  </datamodel>\n     \n <state id=\"s0\">\n<transition cond=\"Var1\" target=\"pass\"/> \n   <transition cond=\"true\" target=\"fail\"/>\n   </state>\n   \n    \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 322/test322.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that _sessionid remains bound to the same value throught the session.  this means that it can't\nbe assigned to  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\" name=\"machineName\">\n<datamodel>\n  <data id=\"Var1\" expr=\"_sessionid\"/>\n  <data id=\"Var2\"/>\n  </datamodel>\n     \n <state id=\"s0\">\n   <transition target=\"s1\"/>\n\n   </state>\n   \n <state id=\"s1\">\n   <onentry>\n    <assign location=\"_sessionid\" expr=\"'otherName'\"/>\n    <raise event=\"foo\"/>\n    </onentry>\n \n   <transition event=\"error.execution\" target=\"s2\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n <state id=\"s2\">\n \n   <transition cond=\"Var1==_sessionid\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>  \n   \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
