# generated by scripts/gen/irp_gen.py; do not edit
# the outcome of an IRP document: the id of the top-level final state
# reached ("pass" or "fail"), or "err <why>" when it is rejected
fn irp(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.err != ""
        return "err " + r.err
    return copy(r.outcome)
fn irp_trace(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return ",".join(r.trace)
fn irp_logs(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return "|".join(r.logs)
# the child's and the parent's logs of the forwarded event agree
fn irp_same(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.logs.len() != 14
        return "logs " + "|".join(r.logs)
    for i in 0..7
        if r.logs[i] != r.logs[i + 7]
            return "differ " + r.logs[i] + " / " + r.logs[i + 7]
    return ""
# a Basic HTTP request (bodies[0]) into a running document: the response
# status, then the outcome
fn irp_http(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let none_: List[text] = []
    let r = run_scxml_http(&doc, &none_, &none_, &no_evs, &bodies)
    let hs = copy(r.http)
    let oc = copy(r.outcome)
    return "|".join(hs) + "|" + oc
# 338/test338.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that invokeid is set correctly in events received from an invoked process.  timeout event catches the \ncase where the invoke doesn't work correctly --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\"/>\n  <data id=\"Var2\"/>\n  </datamodel>\n  \n   <state id=\"s0\">\n      <onentry>\n        <send event=\"timeout\" delay=\"2s\"/>\n        </onentry>\n     <invoke idlocation=\"Var1\" type=\"http://www.w3.org/TR/scxml/\">\n     <content>\n       <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">     \n       <final id=\"sub0\">\n         <onentry>\n            <send target=\"#_parent\" event=\"event1\"/>\n        </onentry>\n        </final>\n       </scxml>\n      </content>\n    </invoke>\n       <transition event=\"event1\" target=\"s1\">\n         <assign location=\"Var2\" expr=\"_event.invokeid\"/>\n         </transition>\n       <transition event=\"event0\" target=\"fail\"/>\n   </state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1===Var2\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>", [], []) == "pass"
# 339/test339.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that invokeid is blank in an event that wasn't returned from an invoked process --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">  \n   \n <state id=\"s0\">\n   <onentry>\n     <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" cond=\"typeof _event.invokeid === 'undefined' \" target=\"pass\"/>\n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n\n      \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 342/test342.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that eventexpr works and sets the name field of the resulting event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">  \n <datamodel>\n   <data id=\"Var1\" expr=\"'foo'\"/>\n   <data id=\"Var2\"/>\n   </datamodel>\n     \n <state id=\"s0\">\n   <onentry>\n     <send eventexpr=\"Var1\"/>\n   </onentry>\n   <transition event=\"foo\" target=\"s1\">\n      <assign location=\"Var2\" expr=\"_event.name\"/>\n      </transition>\n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n<state id=\"s1\">\n  <transition cond=\"Var1===Var2\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n      \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 346/test346.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that any attempt to change the value of a system variable causes error.execution to be raised.  \nEvent1..4 are there to catch the case where the error event is not raised. In cases where it is, we have\nto dispose of eventn in the next state, hence the targetless transitions (which simply throw away the event.) --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">\n\n   \n <state id=\"s0\">\n   <onentry>\n    <assign location=\"_sessionid\" expr=\"'otherName'\"/>\n    <raise event=\"event1\"/>\n    </onentry>\n \n   <transition event=\"error.execution\" target=\"s1\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n <state id=\"s1\">\n     <onentry>\n    <assign location=\"_event\" expr=\"'otherName'\"/>\n    <raise event=\"event2\"/>\n    </onentry>\n    <!-- throw out event1 if it's still around -->\n   <transition event=\"event1\"/>\n   <transition event=\"error.execution\" target=\"s2\"/>\n   <!-- event1 would trigger this transition if we didn't drop it.  We want this transition to have\n   a very general trigger to catch cases where the wrong error event was raised -->\n   <transition event=\"*\" target=\"fail\"/>\n   </state>  \n   \n<state id=\"s2\">\n     <onentry>\n    <assign location=\"_ioprocessors\" expr=\"'otherName'\"/>\n    <raise event=\"event3\"/>\n    </onentry>\n   <transition event=\"event2\"/>\n   <transition event=\"error.execution\" target=\"s3\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>  \n   \n<state id=\"s3\">\n     <onentry>\n    <assign location=\"_name\" expr=\"'otherName'\"/>\n    <raise event=\"event4\"/>\n    </onentry>\n   <transition event=\"event3\"/>\n   <transition event=\"error.execution\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>  \n   \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 172/test172.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that eventexpr uses the current value of var1, not its initial value  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"'event1'\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"'event2'\"/>\n   <send eventexpr=\"Var1\"/>\n    </onentry>\n    \n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 173/test173.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that targetexpr uses the current value of var1, not its initial value\n(If it uses the initial value, it will generate an error.  If it uses the current value, event1 will be raised  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"27\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"'#_internal'\"/>\n   <send targetexpr=\"Var1\" event=\"event1\"/>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 174/test174.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that typeexpr uses the current value of var1, not its initial value\n(If it uses the initial value, it will generate an error.  If it uses the current value, event1 will be raised  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"27\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"'http://www.w3.org/TR/scxml/#SCXMLEventProcessor'\"/>\n   <send typeexpr=\"Var1\" event=\"event1\"/>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 175/test175.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that delayexpr uses the current value of var1, not its initial value\n(If it uses the initial value, event2 will be generated first, before event1.  If it uses the current value, \nevent1 will be raised first.  Succeed if event1 occurs before event2, otherwise fail --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"'0s'\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"'1s'\"/>\n   <send delayexpr=\"Var1\" event=\"event2\"/>\n   <send delayexpr=\"'.5s'\" event=\"event1\"/>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"s1\"/>\n  <transition event=\"event2\" target=\"fail\"/>\n </state>\n\n<state id=\"s1\">\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 176/test176.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that <param> uses the current value of var1, not its initial value.  If the value of\naParam in event1 is 2 so that var2 gets set to 2, success, otherwise failure  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n  <data id=\"Var2\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"2\"/>\n   <send event=\"event1\">\n     <param name=\"aParam\" expr=\"Var1\"/>\n     </send>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"s1\">\n  <assign location=\"Var2\" expr=\"_event.data.aParam\"/>\n  </transition>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n<state id=\"s1\">\n  <transition cond=\"Var2==2\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n     \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 178/test178.txml (mandatory)
check irp_logs("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that multiple key/value pairs are included, even when the keys are the same.\nThis is a manual test.  The tester must look at the log output and verify that both\nkeys are there.  (This test uses the SCXML Event I/O processor, which is the only\none that all platforms must support.  It does not specify the message format, so \nwe cannot test _event.raw directly.  Therefore we print it out for visual \ninspection.) --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n  \n<state id=\"s0\">\n  <onentry>\n   <send event=\"event1\">\n    <param name=\"Var1\" expr=\"2\"/>\n    <param name=\"Var1\" expr=\"3\"/>\n    </send>\n     </onentry>\n\n  <transition event=\"event1\" target=\"final\">\n   <log label=\"_event \" expr=\"_event.raw\"/>\n   </transition>\n  <transition event=\"*\" target=\"fail\"/>\n \n </state>\n\n\n<final id=\"final\"/>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "_event :Var1=2&Var1=3"
# 179/test179.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that <content> can be used to populate body of a message --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n  <onentry>\n   <send event=\"event1\">\n   <content>123</content>\n   </send>\n    </onentry>\n    \n  <transition event=\"event1\" cond=\"_event.data == 123\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 183/test183.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that <send> stores the value of the sendid in idlocation.  If it does,\nvar1 has a value and we pass.  Otherwise we fail  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\"/>\n\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <send event=\"event1\" idlocation=\"Var1\"/>\n    </onentry>\n    \n  <transition cond=\"Var1\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n </state>\n\n     \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
