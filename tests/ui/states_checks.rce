# compact-notation checks: the IRP section-3 subset (vectors/ui/scxml-irp) through the compact chart
fn oc(src: text) -> text
    let none_evs: List[text] = []
    let r = run(&src, &none_evs)
    if r.err != ""
        return "error " + r.err
    return r.outcome
# test355.scxml
check oc("machine\nstate _scxml root - -\nstate s0 atomic _scxml -\nstate s1 atomic _scxml -\nstate pass final _scxml -\nstate fail final _scxml -\ntransition s0 - - ext pass\nend\ntransition s1 - - ext fail\nend\nonentry pass\nlog Outcome\nend\nonentry fail\nlog Outcome\nend") == "pass"
