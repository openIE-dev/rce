# generated by scripts/gen/irp_gen.py; do not edit
# the outcome of an IRP document: the id of the top-level final state
# reached ("pass" or "fail"), or "err <why>" when it is rejected
fn irp(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.err != ""
        return "err " + r.err
    return copy(r.outcome)
fn irp_trace(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return ",".join(r.trace)
fn irp_logs(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return "|".join(r.logs)
# the child's and the parent's logs of the forwarded event agree
fn irp_same(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.logs.len() != 14
        return "logs " + "|".join(r.logs)
    for i in 0..7
        if r.logs[i] != r.logs[i + 7]
            return "differ " + r.logs[i] + " / " + r.logs[i + 7]
    return ""
# a Basic HTTP request (bodies[0]) into a running document: the response
# status, then the outcome
fn irp_http(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let none_: List[text] = []
    let r = run_scxml_http(&doc, &none_, &none_, &no_evs, &bodies)
    let hs = copy(r.http)
    let oc = copy(r.outcome)
    return "|".join(hs) + "|" + oc
# 525/test525.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that <foreach> does a shallow copy, so that modifying the array does not change\nthe iteration behavior. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n  <datamodel>\n    <data id=\"Var1\">\n      [1,2,3]\n      </data>\n    <data id=\"Var2\" expr=\"0\"/>  <!-- counts the number of iterations -->\n    </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n  <foreach item=\"Var3\" array=\"Var1\">\n    <assign location=\"Var1\" expr=\"[].concat(Var1, [4])\"/>\n    <assign location=\"Var2\" expr=\"Var2 + 1\"/>\n    </foreach>\n   </onentry>\n   \n   <transition cond=\"Var2==3\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n</state>\n\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 158/test158.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that executable content executes in document order.  if event1 occurs then event2, succeed, otherwise fail --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <raise event=\"event1\"/>\n   <raise event=\"event2\"/>\n    </onentry>\n  <transition event=\"event1\" target=\"s1\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n<state id=\"s1\">\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 159/test159.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that any error raised by an element of executable content causes all subsequent elements to be skipped.\nThe send tag will raise an error so var1 should not be incremented.  If it is fail, otherwise succeed --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <send event=\"thisWillFail\" target=\"baz\"/>\n   <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onentry>\n  <transition cond=\"Var1==1\" target=\"fail\"/>\n  <transition target=\"pass\"/>\n </state>\n\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 276/test276.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that values passed in from parent process override default values specified in the child, test276sub1.scxml.\nThe child returns event1 if var1 has value 1, event0 if it has default value 0.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n   <state id=\"s0\">\n     <invoke type=\"scxml\" src=\"file:test276sub1.scxml\">\n       <param name=\"Var1\" expr=\"1\"/>\n       </invoke>\n       <transition event=\"event1\" target=\"pass\"/>\n       <transition event=\"event0\" target=\"fail\"/>\n   </state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>", ["test276sub1.scxml"], ["<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- define var1 with default value 0.  Parent will invoke this process setting var1 = 1.  Return event1 if var1 == 1, event0 otherwise --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n   <datamodel>\n     <data id=\"Var1\" expr=\"0\"/>\n     </datamodel>\n     \n <state id=\"s0\">\n \n     \n  <transition cond=\"Var1==1\" target=\"final\">\n     <send target=\"#_parent\" event=\"event1\"/>\n     </transition>\n     \n  <transition target=\"final\">\n     <send target=\"#_parent\" event=\"event0\"/>\n     </transition>\n     \n   </state>\n   \n   <final id=\"final\"/>\n     \n</scxml>"]) == "pass"
# 277/test277.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that platform creates undound variable if we assign an illegal value to it.  Thus\n we can assign to it later in state s1.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n   <datamodel>\n     <data id=\"Var1\" expr=\"return\"/>\n     </datamodel>\n     \n <state id=\"s0\">\n    <onentry>\n    <raise event=\"foo\"/>\n    </onentry>\n    \n   <transition event=\"error.execution\" cond=\"typeof Var1 === 'undefined' \" target=\"s1\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n <state id=\"s1\">\n <onentry>\n   <assign location=\"Var1\" expr=\"1\"/>\n   </onentry>\n   <transition cond=\"Var1==1\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n\n   </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 279/test279.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  testing that in case of early binding variables are assigned values at init time, before\n the state containing them is visited  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n   \n     \n <state id=\"s0\">\n   <transition cond=\"Var1==1\" target=\"pass\"/>\n\n  <transition target=\"fail\"/>\n\n   </state>\n   \n<state id=\"s1\">\n  <datamodel>\n    <data id=\"Var1\" expr=\"1\"/>\n    </datamodel>\n  </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 280/test280.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test late binding.  var2 won't get bound until s1 is entered, so it shouldn't  have a value in s0 and\naccessing it should cause an error. It should get bound before the onentry code in s1 so it should  be\npossible access it there and assign its value to var1 --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" binding=\"late\">\n \n <datamodel>\n   <data id=\"Var1\"/>\n   </datamodel>  \n     \n <state id=\"s0\">\n   <transition cond=\"typeof Var2 === 'undefined' \" target=\"s1\"/>\n  <transition target=\"fail\"/>\n   </state>\n   \n<state id=\"s1\">\n  <datamodel>\n    <data id=\"Var2\" expr=\"1\"/>\n    </datamodel>\n    <onentry>\n    <assign location=\"Var1\" expr=\"Var2\"/>\n    </onentry>\n    <transition cond=\"Var1===Var2\" target=\"pass\"/>\n    <transition target=\"fail\"/>\n  </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 550/test550.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that expr can be used to assign a value to a var.  This test uses early binding --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" binding=\"early\">\n    \n   <state id=\"s0\">\n \n       <transition cond=\"Var1==2\" target=\"pass\"/>\n       <transition target=\"fail\"/>\n   </state>\n   \n   <state id=\"s1\">\n   \t<datamodel>\n    <data id=\"Var1\" expr=\"2\"/>\n    </datamodel>\n    </state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>", [], []) == "pass"
# 551/test551.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that inline content can be used to assign a value to a var.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" binding=\"early\" datamodel=\"ecmascript\">\n\n    \n   <state id=\"s0\">\n \n       <transition cond=\"Var1\" target=\"pass\"/>\n       <transition target=\"fail\"/>\n   </state>\n   \n<state id=\"s1\">\n\t  <datamodel>\n    <data id=\"Var1\">\n     [1,2,3]\n     </data>\n    </datamodel>\n    </state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>", [], []) == "pass"
# 552/test552.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that src content can be used to assign a value to a var. Edit\ntest552.txt to have a value that's legal for the datamodel in question --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n  <datamodel>\n    <data id=\"Var1\" src=\"file:test552.txt\"/>\n    </datamodel>\n    \n   <state id=\"s0\">\n \n       <transition cond=\"Var1\" target=\"pass\"/>\n       <transition target=\"fail\"/>\n   </state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>", ["test552.txt"], ["2"]) == "pass"
# 286/test286.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that assigment to a non-declared var causes an error.  the transition on foo catches the case\nwhere no error is raised --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n   \n     \n <state id=\"s0\">\n   <onentry>\n   <assign location=\"foo.bar.baz \" expr=\"1\"/>\n   <raise event=\"foo\"/>\n   </onentry>\n   \n   <transition event=\"error.execution\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 287/test287.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- a simple test that a legal value may be assigned to a valid data model location --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\" initial=\"s0\">\n   \n<datamodel>\n    <data id=\"Var1\" expr=\"0\"/>\n    </datamodel>   \n     \n <state id=\"s0\">\n   <onentry>\n   <assign location=\"Var1\" expr=\"1\"/>\n   </onentry>\n   \n   <transition cond=\"Var1==1\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
