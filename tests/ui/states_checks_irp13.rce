# generated by scripts/gen/irp_gen.py; do not edit
# the outcome of an IRP document: the id of the top-level final state
# reached ("pass" or "fail"), or "err <why>" when it is rejected
fn irp(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.err != ""
        return "err " + r.err
    return copy(r.outcome)
fn irp_trace(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return ",".join(r.trace)
fn irp_logs(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return "|".join(r.logs)
# the child's and the parent's logs of the forwarded event agree
fn irp_same(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.logs.len() != 14
        return "logs " + "|".join(r.logs)
    for i in 0..7
        if r.logs[i] != r.logs[i + 7]
            return "differ " + r.logs[i] + " / " + r.logs[i + 7]
    return ""
# a Basic HTTP request (bodies[0]) into a running document: the response
# status, then the outcome
fn irp_http(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let none_: List[text] = []
    let r = run_scxml_http(&doc, &none_, &none_, &no_evs, &bodies)
    let hs = copy(r.http)
    let oc = copy(r.outcome)
    return "|".join(hs) + "|" + oc
# 449/test449.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that ecmascript objects are converted to booleans inside cond --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n \n     \n<state id=\"s0\">\n  <transition cond=\"'foo'\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n    </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 451/test451.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- simple test of the in() predicate --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"p\">\n\n     \n <parallel id=\"p\">\n \n   <state id=\"s0\">\n   <transition cond=\"In('s1')\" target=\"pass\"/> \n   <transition target=\"fail\"/>\n   </state>\n\n   <state id=\"s1\"/> \n </parallel>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
# 452/test452.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that we can assign to any location in the datamodel. In this case, we just test that we can assign\nto a substructure (not the top level variable).  This may not be the most idiomatic way to write the test --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n <datamodel>\n   <data id=\"foo\" expr=\"0\"/>\n   </datamodel>\n    <script>\n    function testobject() {\n    this.bar = 0;}\n   </script>    \n<state id=\"s0\">\n <onentry>\n   <assign location=\"foo\" expr=\"new testobject();\"/>\n<!-- try to assign to foo's bar property -->\n   <assign location=\"foo.bar\" expr=\"1\"/>\n   <raise event=\"event1\"/>\n   </onentry>\n<!-- test that we have assigned to foo's bar property -->  \n   <transition event=\"event1\" cond=\"foo.bar == 1\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n    </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 453/test453.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that we can use any ecmascript expression as a value expression. \nIn this case, we just test that we can assign\na function to a variable and then call it.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n <datamodel>\n   <data id=\"var1\" expr=\"function(invar) {return invar + 1;}\"/>\n   </datamodel>\n\n<state id=\"s0\">\n  <onentry>\n   <raise event=\"event1\"/>\n   </onentry>\n<!-- test that we can call the function -->  \n   <transition event=\"event1\" cond=\"var1(2) == 3\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n    </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 456/test456.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we can't test that _any_ ecmascript is valid inside <script>, so we\njust run a simple one and check that it can update the data model. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  </datamodel>\n  \n <state id=\"s0\">\n  <onentry>\n    <script>\n      Var1+=1\n      </script>\n   </onentry> \n   <transition cond=\"Var1==1\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n   \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 446/test446.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- in the ECMA data model, test that if the child of <data> is JSON, the processor\n assigns it as the value of the var --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"var1\">[1, 2, 3]</data>\n <data id=\"var2\" src=\"file:test446.txt\"/> \n  </datamodel>\n  \n<state id=\"s0\">\n   <transition cond=\"var1 instanceof Array\" target=\"s1\"/>\n   <transition target=\"fail\"/>\n  </state>\n  \n<state id=\"s1\">\n   <transition cond=\"var2 instanceof Array\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>", ["test446.txt"], ["[1,2,3]"]) == "pass"
# 557/test557.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- in the ECMA data model, test that if the child of <data> is XML, or if XML is loaded via src=, the processor\n assigns it as the value of the var --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"var1\">\n   <books xmlns=\"\">\n     <book title=\"title1\"/>\n     <book title=\"title2\"/>\n   </books>  \n</data>\n <data id=\"var2\" src=\"file:test557.txt\"/> \n  </datamodel>\n  \n<state id=\"s0\">\n   <transition cond=\"var1.getElementsByTagName('book')[0].getAttribute('title') == 'title1'\" target=\"s1\"/>\n   <transition target=\"fail\"/>\n  </state>\n  \n<state id=\"s1\">\n   <transition cond=\"var2.getElementsByTagName('book')[1].getAttribute('title') == 'title2'\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>", ["test557.txt"], ["<books xmlns=\"\">\n     <book title=\"title1\"/>\n     <book title=\"title2\"/>\n   </books> "]) == "pass"
# 558/test558.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- in the ECMA data model, test that if the child of <data> is not XML, or if XML is loaded via src=, \n the processor treats the value as a string, does whitespace normalization and assigns it to the var.--><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"var1\">\nthis  is \na string \n</data>\n  <data id=\"var2\" src=\"file:test558.txt\"/> \n  </datamodel>\n  \n<state id=\"s0\">\n   <transition cond=\"var1 == 'this is a string'\" target=\"s1\"/>\n   <transition target=\"fail\"/>\n  </state>\n  \n<state id=\"s1\">\n   <transition cond=\"var2 == 'this is a string'\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>", ["test558.txt"], ["\nthis  is \na string "]) == "pass"
# 560/test560.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- in the ECMA data model, test that processor creates correct structure in\n _event.data when receiving KVPs in an event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n   <onentry>\n    <send event=\"foo\">\n    <param name=\"aParam\" expr=\"1\"/>\n    </send>\n  </onentry>\n  <transition event=\"foo\" cond=\"_event.data.aParam == 1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>", [], []) == "pass"
# 578/test578.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- in the ECMA data model, test that processor creates an ECMAScript object\n _event.data when receiving JSON in an event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n   <onentry>\n    <send event=\"foo\">\n    <content>{ \"productName\" : \"bar\", \"size\" : 27 }</content>\n    </send>\n  </onentry>\n  <transition event=\"foo\" cond=\"_event.data.productName == 'bar'\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>", [], []) == "pass"
# 561/test561.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- in the ECMA data model, test that processor creates an ECMAScript DOM object\n _event.data when receiving XML in an event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n   <onentry>\n    <send event=\"foo\">\n    <content>\n<books xmlns=\"\">\n<book title=\"title1\"/>\n<book title=\"title2\"/>\n</books>\n</content>\n    </send>\n  </onentry>\n  <transition event=\"foo\" cond=\"_event.data.getElementsByTagName('book')[1].getAttribute('title') == 'title2'\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>", [], []) == "pass"
# 562/test562.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- in the ECMA data model, test that processor creates space normalized string in\n _event.data when receiving anything other than KVPs or XML in an event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n   <onentry>\n    <send event=\"foo\">\n    <content>\nthis is  a  \nstring\n</content>\n    </send>\n  </onentry>\n  <transition event=\"foo\" cond=\"_event.data == 'this is a string'\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>", [], []) == "pass"
