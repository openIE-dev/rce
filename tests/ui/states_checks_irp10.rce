# generated by scripts/gen/irp_gen.py; do not edit
# the outcome of an IRP document: the id of the top-level final state
# reached ("pass" or "fail"), or "err <why>" when it is rejected
fn irp(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.err != ""
        return "err " + r.err
    return copy(r.outcome)
fn irp_trace(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return ",".join(r.trace)
fn irp_logs(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return "|".join(r.logs)
# the child's and the parent's logs of the forwarded event agree
fn irp_same(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.logs.len() != 14
        return "logs " + "|".join(r.logs)
    for i in 0..7
        if r.logs[i] != r.logs[i + 7]
            return "differ " + r.logs[i] + " / " + r.logs[i + 7]
    return ""
# a Basic HTTP request (bodies[0]) into a running document: the response
# status, then the outcome
fn irp_http(doc: text, _names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let none_: List[text] = []
    let r = run_scxml_http(&doc, &none_, &none_, &no_evs, &bodies)
    let hs = copy(r.http)
    let oc = copy(r.outcome)
    return "|".join(hs) + "|" + oc
# 208/test208.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that cancel works.  We cancel delayed event1.  If cancel works, we get event2 first and pass.  If\nwe get event1 or an error first, cancel didn't work and we fail.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n   \n<state id=\"s0\">\n  <onentry>\n   <send id=\"foo\" event=\"event1\" delayexpr=\"'1s'\"/>\n   <send event=\"event2\" delayexpr=\"'1.5s'\"/>\n   <cancel sendid=\"foo\"/>\n    </onentry>\n\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n \n </state>\n\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 210/test210.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that sendidexpr works with cancel.  If it takes the most recent value of var1, it should cancel \ndelayed event1.  Thus we get event2 first and pass.  If we get event1 or an error first, cancel didn't work and we fail.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"'bar'\"/>\n  </datamodel>\n   \n<state id=\"s0\">\n  <onentry>\n   <send id=\"foo\" event=\"event1\" delayexpr=\"'1s'\"/>\n   <send event=\"event2\" delayexpr=\"'1.5s'\"/>\n   <assign location=\"Var1\" expr=\"'foo'\"/>\n   <cancel sendidexpr=\"Var1\"/>\n    </onentry>\n\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n \n </state>\n\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 215/test215.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that typexpr is evaluated at runtime.  If the original value of var1 is used, the invocation\nwill fail (test215sub1.scxml is not of type 'foo', even if the platform supports foo as a type).  If\nthe runtime value is used, the invocation will succeed --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"'foo'\"/>\n   </datamodel> \n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"5s\"/>\n    <assign location=\"Var1\" expr=\"'http://www.w3.org/TR/scxml/'\"/>\n    </onentry>\n  <invoke typeexpr=\"Var1\">\n    <content>\n        <!-- when invoked, terminate returning done.invoke. This proves that the invocation succeeded.   -->\n        <scxml initial=\"subFinal\" datamodel=\"ecmascript\" version=\"1.0\">\n      <final id=\"subFinal\"/>\n        </scxml>\n    </content>\n    </invoke>\n  <transition event=\"done.invoke\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/> \n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 216/test216.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that srcexpr is evaluated at runtime.  If the original value of var1 is used, the invocation\nwill fail (assuming that there is no script named 'foo').  If\nthe runtime value is used, the invocation will succeed --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"'foo'\"/>\n   </datamodel> \n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"5s\"/>\n   <assign location=\"Var1\" expr=\"'file:test216sub1.scxml'\"/>\n    </onentry>\n  <invoke srcexpr=\"Var1\" type=\"http://www.w3.org/TR/scxml\"/>\n  <transition event=\"done.invoke\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/> \n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", ["test216sub1.scxml"], ["<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- when invoked, terminate returning done.invoke. This proves that the invocation succeeded.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"final\" version=\"1.0\" datamodel=\"ecmascript\">\n\n<final id=\"final\"/>\n\n</scxml>"]) == "pass"
# 220/test220.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that the scxml type is supported.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"5s\"/>\n    </onentry>\n     <invoke type=\"http://www.w3.org/TR/scxml/\">\n     <content>\n       <!-- when invoked, terminate returning done.invoke. This proves that the invocation succeeded.   -->\n         <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n           <final id=\"subFinal\"/>\n          </scxml></content>\n     </invoke>\n  <transition event=\"done.invoke\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/> \n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 223/test223.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that idlocation is supported.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"Var1\"/>\n   </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n     <invoke type=\"http://www.w3.org/TR/scxml/\" idlocation=\"Var1\">\n     <content>\n     <!-- when invoked, terminate returning done.invoke. This proves that the invocation succeeded.   -->\n       <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n       <final id=\"subFinal\"/>\n        </scxml>\n       </content>\n    </invoke>\n  <transition event=\"*\" target=\"s1\"/>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 224/test224.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that the automatically generated id has the form stateid.platformid.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"Var1\"/>\n   <data id=\"Var2\" expr=\"'s0.'\"/>\n   </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n <invoke type=\"http://www.w3.org/TR/scxml/\" idlocation=\"Var1\">\n    <content> \n    <!-- when invoked, terminate returning done.invoke. This proves that the invocation succeeded.   -->\n      <scxml version=\"1.0\" initial=\"subFinal\" datamodel=\"ecmascript\">\n      <final id=\"subFinal\"/>\n      </scxml>\n     </content>\n    </invoke>\n\n  <transition event=\"*\" target=\"s1\"/>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"(function(str, starts){if (starts === '') return true;if (str == null || starts == null) return false;str = String(str); starts = String(starts);return str.length &gt;= starts.length &amp;&amp; str.slice(0, starts.length) === starts;})(Var1, Var2)\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 225/test225.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that the automatically generated id is unique, we call invoke twice and compare the ids.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"Var1\"/>\n   <data id=\"Var2\"/>\n   </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n\n   <invoke type=\"http://www.w3.org/TR/scxml/\" idlocation=\"Var1\">\n      <content>\n      <scxml initial=\"subFinal1\" version=\"1.0\" datamodel=\"ecmascript\">\n         <final id=\"subFinal1\"/>\n        </scxml>\n     </content>\n     </invoke>\n   <invoke type=\"http://www.w3.org/TR/scxml/\" idlocation=\"Var2\">\n      <content>\n      <scxml initial=\"subFinal2\" version=\"1.0\" datamodel=\"ecmascript\">\n         <final id=\"subFinal2\"/>\n        </scxml>\n     </content>\n     </invoke>\n\n  <transition event=\"*\" target=\"s1\"/>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1===Var2\" target=\"fail\"/>\n  <transition target=\"pass\"/>\n  </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 226/test226.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- this is basically just a test that invoke works correctly and that you can pass data\nto the invoked process.  If the invoked session finds aParam==1, it exits, signalling\nsuccess.  otherwise it will hang and the timeout in this doc signifies failure.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    </onentry>\n\n \n   <invoke type=\"http://www.w3.org/TR/scxml/\" src=\"file:test226sub1.scxml\">\n      <param name=\"Var1\" expr=\"1\"/>\n      </invoke>\n\n  <transition event=\"varBound\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", ["test226sub1.scxml"], ["<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- when invoked, if var1 has a value notify parent. Then terminate.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n<datamodel>\n  <data id=\"Var1\"/>\n  </datamodel>\n\n<state id=\"s0\">\n  <transition cond=\"Var1\" target=\"final\">\n    <send target=\"#_parent\" event=\"varBound\"/>\n    </transition>\n  <transition target=\"final\"/>\n  </state>\n  \n<final id=\"final\"/>\n\n</scxml>"]) == "pass"
# 228/test228.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the invokeid is included in events returned from the invoked process.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"Var1\"/>\n   </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    </onentry>\n \n  <invoke type=\"http://www.w3.org/TR/scxml/\" id=\"foo\">\n   <content>\n     <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n      <final id=\"subFinal\"/>\n       </scxml>\n    </content>\n    </invoke>\n\n  <transition event=\"done.invoke\" target=\"s1\">\n    <assign location=\"Var1\" expr=\"_event.invokeid\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1=='foo'\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 229/test229.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that autofoward works. If the child  process receives back a copy of the\nchildToParent event that it sends to this doc, it sends eventReceived, signalling success. (Note\nthat this doc is not required to process that event explicitly.  It should be forwarded in any case.) Otherwise\nit eventually times out and the done.invoke signals failure   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    </onentry>\n \n  <invoke type=\"http://www.w3.org/TR/scxml/\" autoforward=\"true\">\n    <content>\n      <!-- when invoked, send childToParent to parent.  \n      If it is forwarded back to us, send\n      eventReceived to signal success and terminate.  \n      Otherwise wait for timer to expire and terminate.  -->\n     <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n        <state id=\"sub0\">\n          <onentry>\n             <send target=\"#_parent\" event=\"childToParent\"/> \n              <send event=\"timeout\" delay=\"3s\"/> \n            </onentry> \n         <transition event=\"childToParent\" target=\"subFinal\">\n         <send target=\"#_parent\" event=\"eventReceived\"/>\n          </transition>\n           <transition event=\"*\" target=\"subFinal\"/>\n       </state>\n        <final id=\"subFinal\"/>\n        </scxml>\n    </content>\n    </invoke>\n\n  <transition event=\"childToParent\"/>\n  <transition event=\"eventReceived\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 230/test230.txml (mandatory)
check irp_same("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- a manual test that an autofowarded event has the same fields and values as the original event.\nthe child process sends the parent process an event which is forwarded back to it.  \nBoth the parent and child process print out the contents of the event. The tester \nmust check if they are the same and report his result.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    </onentry>\n  <invoke type=\"http://www.w3.org/TR/scxml/\" autoforward=\"true\">\n    <content>\n    <!-- when invoked, send childToParent to parent.  If it is forwarded back to us, print out its\n        fields and terminate.  -->\n        <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n           <state id=\"sub0\">\n            <onentry>\n              <send target=\"#_parent\" event=\"childToParent\"/> \n              <send event=\"timeout\" delay=\"2s\"/>\n             </onentry> \n           <transition event=\"childToParent\" target=\"subFinal\">\n                  <log label=\"name is \" expr=\"_event.name\"/>\n                  <log label=\"type is \" expr=\"_event.type\"/>\n                  <log label=\"sendid is \" expr=\"_event.sendid\"/>\n                 <log label=\"origin is \" expr=\"_event.origin\"/>\n                 <log label=\"origintype is \" expr=\"_event.origintype\"/>\n                 <log label=\"invokeid is \" expr=\"_event.invokeid\"/>\n                 <log label=\"data is \" expr=\"_event.data\"/>\n              </transition>\n          <transition event=\"*\" target=\"subFinal\"/>  \n          </state>\n        <final id=\"subFinal\"/>\n       </scxml>\n       </content>\n       </invoke>\n  <transition event=\"timeout\" target=\"final\"/>\n   \n \n  <state id=\"s01\">\n  <transition event=\"childToParent\" target=\"s02\">\n    <log label=\"name is \" expr=\"_event.name\"/>\n    <log label=\"type is \" expr=\"_event.type\"/>\n    <log label=\"sendid is \" expr=\"_event.sendid\"/>\n    <log label=\"origin is \" expr=\"_event.origin\"/>\n    <log label=\"origintype is \" expr=\"_event.origintype\"/>\n    <log label=\"invokeid is \" expr=\"_event.invokeid\"/>\n    <log label=\"data is \" expr=\"_event.data\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n <state id=\"s02\">\n  <!-- wait till we get the done event to ensure that the child process has time to print out its results -->\n   <transition event=\"done.invoke\" target=\"final\"/>\n   </state>\n\n</state>\n\n<final id=\"final\"/>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == ""
