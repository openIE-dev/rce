# generated by scripts/gen/irp_gen.py; do not edit
# the outcome of an IRP document: the id of the top-level final state
# reached ("pass" or "fail"), or "err <why>" when it is rejected
fn irp(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.err != ""
        return "err " + r.err
    return copy(r.outcome)
fn irp_trace(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return ",".join(r.trace)
fn irp_logs(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return "|".join(r.logs)
# the child's and the parent's logs of the forwarded event agree
fn irp_same(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.logs.len() != 14
        return "logs " + "|".join(r.logs)
    for i in 0..7
        if r.logs[i] != r.logs[i + 7]
            return "differ " + r.logs[i] + " / " + r.logs[i + 7]
    return ""
# a Basic HTTP request (bodies[0]) into a running document: the response
# status, then the outcome
fn irp_http(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let none_: List[text] = []
    let r = run_scxml_http(&doc, &none_, &none_, &no_evs, &bodies)
    let hs = copy(r.http)
    let oc = copy(r.outcome)
    return "|".join(hs) + "|" + oc
# 519/test519.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that that <param> values get encoded as POST parameters.  . --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n      <param name=\"param1\" expr=\"1\"/>\n       </send>  \n     </onentry>\n     \n     <!-- if other end sends us back this event, we succeed -->\n  <transition event=\"test\" cond=\"_event.raw.search('param1=1') !== -1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 520/test520.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that that <content> gets sent as the body of the message.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n    <content>this is some content</content>\n      </send>  \n     </onentry>\n     \n     <!-- if other end sends us back this event, we succeed.  Test for two common\n     ways of encoding -->\n  <transition event=\"HTTP.POST\" cond=\"_event.raw.search(/this+is+some+content/) !== -1\" target=\"pass\"/>\n  <transition event=\"HTTP.POST\" cond=\"_event.raw.search(/this%20is%20some%20content/) !== -1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 522/test522.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that location field the entry for Basic HTTP Event I/O processor can be used\nto send a message to the processor --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n  \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\" targetexpr=\"_ioprocessors['basichttp']['location']\"/>\n\n     </onentry>\n     <!-- the event we receive should be called 'test', but that's not actually\n     required for this test. Only that the send deliver some event to us.  So if\n     we get something other than timeout or error, we call it success -->\n  <transition event=\"timeout\" target=\"fail\"/>\n  <transition event=\"error\" target=\"fail\"/>\n  <transition event=\"*\" target=\"pass\"/>\n\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 531/test531.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that that the value of the <param> _scxmleventname gets used as the name\nof the raised event. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    <send targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n      <param name=\"_scxmleventname\" expr=\"'test'\"/>\n      </send>  \n     </onentry>\n     \n     <!-- if we get an event named 'test' we succeed. Otherwise fail -->\n  <transition event=\"test\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 532/test532.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that that if _scxmleventname  is not present, the name of the HTTP method is used\nas the name of the resulting event. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    <send targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n    <!-- this content will be ignored, but it's here to make sure we have a message body -->\n      <content>some content</content>\n      </send>  \n     </onentry>\n     \n  <transition event=\"HTTP.POST\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 534/test534.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that that <send> 'event' value gets sent as the param _scxmleventname . --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n        </send>  \n     </onentry>\n     \n     <!-- if other end sends us back this event, we succeed -->\n  <transition event=\"test\" cond=\"_event.raw.search('_scxmleventname=test') !== -1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 567/test567.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that that any content in the message other than _scxmleventname is used to populate\n_event.data.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n <data id=\"Var1\" expr=\"2\"/>\n  </datamodel>\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n <!-- in this case, 'test' will be placed in _scxmleventname.  The <param> should\n be used to populate _event.data -->\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n    <param name=\"param1\" expr=\"2\"/>\n      </send>  \n     </onentry>\n     \n     <!-- if we get this event, we succeed -->\n  <transition event=\"test\" target=\"s1\">\n    <assign location=\"Var1\" expr=\"_event.data.param1\"/>\n      </transition>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n  <state id=\"s1\">\n    <transition cond=\"Var1==2\" target=\"pass\"/>\n    <transition target=\"fail\"/>\n    </state>\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 577/test577.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that that <send> without target in basichttp event i/o processor\ncauses error.communication to get added to internal queue . --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n  <!-- sent by scxml event i/o processor, added to external queue -->\n    <send event=\"event1\"/>\n    <!-- should put error.communication on internal queue -->\n    <send event=\"test\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\"/>\n\n     </onentry>\n     \n  \n  <transition event=\"error.communication\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
