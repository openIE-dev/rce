# generated by scripts/gen/irp_gen.py; do not edit
# the outcome of an IRP document: the id of the top-level final state
# reached ("pass" or "fail"), or "err <why>" when it is rejected
fn irp(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.err != ""
        return "err " + r.err
    return copy(r.outcome)
fn irp_trace(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return ",".join(r.trace)
fn irp_logs(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return "|".join(r.logs)
# the child's and the parent's logs of the forwarded event agree
fn irp_same(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.logs.len() != 14
        return "logs " + "|".join(r.logs)
    for i in 0..7
        if r.logs[i] != r.logs[i + 7]
            return "differ " + r.logs[i] + " / " + r.logs[i + 7]
    return ""
# a Basic HTTP request (bodies[0]) into a running document: the response
# status, then the outcome
fn irp_http(doc: text, _names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let none_: List[text] = []
    let r = run_scxml_http(&doc, &none_, &none_, &no_evs, &bodies)
    let hs = copy(r.http)
    let oc = copy(r.outcome)
    return "|".join(hs) + "|" + oc
# 355/test355.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that default initial state is first in document order.  If we enter s0 first we succeed, if s1, failure. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n\n     \n<state id=\"s0\">\n  <transition target=\"pass\"/>\n</state>\n\n<state id=\"s1\">\n  <transition target=\"fail\"/>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 576/test576.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the 'initial' value of scxml is respected.  We set the value to deeply nested non-default parallel siblings and\ntest that both are entered. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s11p112 s11p122\" datamodel=\"ecmascript\" version=\"1.0\">\n\n     \n<state id=\"s0\">\n  <transition target=\"fail\"/>\n</state>\n\n<state id=\"s1\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n  <transition event=\"timeout\" target=\"fail\"/>\n  <state id=\"s11\" initial=\"s111\">\n    <state id=\"s111\"/>\n    <parallel id=\"s11p1\">\n       <state id=\"s11p11\" initial=\"s11p111\">\n         <state id=\"s11p111\"/>\n         <state id=\"s11p112\">\n           <onentry>\n             <raise event=\"In-s11p112\"/>\n             </onentry>\n         </state>\n       </state>\n       <state id=\"s11p12\" initial=\"s11p121\">\n        <state id=\"s11p121\"/>\n        <state id=\"s11p122\">\n          <transition event=\"In-s11p112\" target=\"pass\"/>\n          </state>\n       </state>\n      </parallel>\n  </state>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 364/test364.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that default initial states are entered when a compound state is entered.  First we test\nthe 'initial' attribute, then the initial element, then default to the first child in document order.  \nIf we get to s01111 we succeed, if any other state, failure.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" initial=\"s1\" version=\"1.0\">\n\n<state id=\"s1\" initial=\"s11p112 s11p122\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n  <transition event=\"timeout\" target=\"fail\"/>\n  <state id=\"s11\" initial=\"s111\">\n    <state id=\"s111\"/>\n    <parallel id=\"s11p1\">\n       <state id=\"s11p11\" initial=\"s11p111\">\n         <state id=\"s11p111\"/>\n         <state id=\"s11p112\">\n           <onentry>\n             <raise event=\"In-s11p112\"/>\n             </onentry>\n         </state>\n       </state>\n       <state id=\"s11p12\" initial=\"s11p121\">\n        <state id=\"s11p121\"/>\n        <state id=\"s11p122\">\n          <transition event=\"In-s11p112\" target=\"s2\"/>\n          </state>\n       </state>\n      </parallel>\n  </state>\n</state>\n\n<state id=\"s2\">\n\t <initial>\n\t \t<transition target=\"s21p112 s21p122\"/>\n\t \t</initial>\n  <transition event=\"timeout\" target=\"fail\"/>\n  <state id=\"s21\" initial=\"s211\">\n    <state id=\"s211\"/>\n    <parallel id=\"s21p1\">\n       <state id=\"s21p11\" initial=\"s21p111\">\n         <state id=\"s21p111\"/>\n         <state id=\"s21p112\">\n           <onentry>\n             <raise event=\"In-s21p112\"/>\n             </onentry>\n         </state>\n       </state>\n       <state id=\"s21p12\" initial=\"s21p121\">\n        <state id=\"s21p121\"/>\n        <state id=\"s21p122\">\n          <transition event=\"In-s21p112\" target=\"s3\"/>\n          </state>\n       </state>\n      </parallel>\n  </state>\n</state>\n      \n<state id=\"s3\">\n <transition target=\"fail\"/>\n  <state id=\"s31\">\n    <state id=\"s311\">\n       <state id=\"s3111\">\n           <transition target=\"pass\"/>\n       </state>\n       <state id=\"s3112\"/>\n    <state id=\"s312\"/>\n  <state id=\"s32\"/>\n</state>\n</state>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 372/test372.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that entering a final state generates done.state.parentid after executing the onentry elements.  \nVar1 should be set to 2 (but not 3) by the time the event is raised --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n  </datamodel>\n       \n<state id=\"s0\" initial=\"s0final\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n  <transition event=\"done.state.s0\" cond=\"Var1==2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  \n  <final id=\"s0final\">\n    <onentry>\n     <assign location=\"Var1\" expr=\"2\"/>\n     </onentry>\n    <onexit>\n     <assign location=\"Var1\" expr=\"3\"/>\n     </onexit>\n     </final>\n</state>\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 570/test570.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that we generate done.state.id when all a parallel state's children are in final states --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"p0\" datamodel=\"ecmascript\" version=\"1.0\">\n  <datamodel>\n    <data id=\"Var1\" expr=\"0\"/>\n    </datamodel>\n<parallel id=\"p0\">\n  <onentry>\n   <send event=\"timeout\" delay=\"2s\"/>\n   <raise event=\"e1\"/>\n   <raise event=\"e2\"/>\n   </onentry>\n   <!-- record that we get the first done event -->\n   <transition event=\"done.state.p0s1\">\n     <assign location=\"Var1\" expr=\"1\"/>\n     </transition>\n   <!-- we should get the second done event before done.state.p0 -->\n   <transition event=\"done.state.p0s2\" target=\"s1\"/>\n   <transition event=\"timeout\" target=\"fail\"/>\n\n   \n   <state id=\"p0s1\" initial=\"p0s11\">\n    <state id=\"p0s11\">\n      <transition event=\"e1\" target=\"p0s1final\"/>\n      </state>\n    <final id=\"p0s1final\"/>\n   </state>\n   \n  <state id=\"p0s2\" initial=\"p0s21\">\n    <state id=\"p0s21\">\n       <transition event=\"e2\" target=\"p0s2final\"/>\n     </state>\n    <final id=\"p0s2final\"/>\n   </state>\n  \n </parallel>\n \n <state id=\"s1\">\n  <!-- if we get done.state.p0, success -->\n  <transition event=\"done.state.p0\" cond=\"Var1==1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 375/test375.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that onentry handlers are executed in document order.  event1 should be raised before event2 --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n\n\n       \n<state id=\"s0\">\n  <onentry>\n    <raise event=\"event1\"/>\n    </onentry>\n  <onentry>\n    <raise event=\"event2\"/>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"s1\"/>\n  <transition event=\"*\" target=\"fail\"/>\n\n</state>\n\n<state id=\"s1\">\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 376/test376.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that each onentry handler is a separate block.  The <send> of event1 will cause an error but\n the increment to var1 should happen anyways --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n       \n<state id=\"s0\">\n  <onentry>\n    <send target=\"baz\" event=\"event1\"/>\n    </onentry>\n  <onentry>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onentry>\n    \n  <transition cond=\"Var1==2\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 377/test377.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that onexit handlers are executed in document order.  event1 should be raised before event2 --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n\n\n       \n<state id=\"s0\">\n  <onexit>\n    <raise event=\"event1\"/>\n    </onexit>\n  <onexit>\n    <raise event=\"event2\"/>\n    </onexit>\n    \n  <transition target=\"s1\"/>\n </state>\n \n <state id=\"s1\">\n    \n  <transition event=\"event1\" target=\"s2\"/>\n  <transition event=\"*\" target=\"fail\"/>\n\n</state>\n\n<state id=\"s2\">\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 378/test378.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that each onexithandler is a separate block.  The <send> of event1 will cause an error but\n the increment to var1 should happen anyways --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n       \n<state id=\"s0\">\n  <onexit>\n    <send target=\"baz\" event=\"event1\"/>\n    </onexit>\n  <onexit>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onexit>\n    \n<transition target=\"s1\"/>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1==2\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 387/test387.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the default history state works correctly.  From initial state s3 we take a transition to s0's default\nshallow history state.  That should generate \"enteringS011\", which takes us to s4.  In s4, we\ntransition to s1's default deep history state. We should end up in s122, generating \"enteringS122\".  Otherwise failure.--><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s3\" version=\"1.0\" datamodel=\"ecmascript\">\n\n       \n<state id=\"s0\" initial=\"s01\">\n\n  <transition event=\"enteringS011\" target=\"s4\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  \n  <history type=\"shallow\" id=\"s0HistShallow\">\n    <transition target=\"s01\"/>\n    </history>\n  <history type=\"deep\" id=\"s0HistDeep\">\n    <transition target=\"s022\"/>\n    </history>\n  <state id=\"s01\" initial=\"s011\">\n    <state id=\"s011\">\n       <onentry>\n         <raise event=\"enteringS011\"/>\n         </onentry>\n    </state>\n    <state id=\"s012\">\n      <onentry>\n       <raise event=\"enteringS012\"/>\n        </onentry>\n    </state>\n  </state>\n <state id=\"s02\" initial=\"s021\">\n     <state id=\"s021\">\n       <onentry>\n         <raise event=\"enteringS021\"/>\n         </onentry>\n    </state>\n    <state id=\"s022\">\n      <onentry>\n       <raise event=\"enteringS022\"/>\n        </onentry>\n    </state>\n  </state>\n \n</state>\n\n<state id=\"s1\" initial=\"s11\">\n \n  <transition event=\"enteringS122\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  \n  <history type=\"shallow\" id=\"s1HistShallow\">\n    <transition target=\"s11\"/>\n    </history>\n  <history type=\"deep\" id=\"s1HistDeep\">\n    <transition target=\"s122\"/>\n    </history>\n  <state id=\"s11\" initial=\"s111\">\n    <state id=\"s111\">\n       <onentry>\n         <raise event=\"enteringS111\"/>\n         </onentry>\n    </state>\n    <state id=\"s112\">\n      <onentry>\n       <raise event=\"enteringS112\"/>\n        </onentry>\n    </state>\n  </state>\n <state id=\"s12\" initial=\"s121\">\n     <state id=\"s121\">\n       <onentry>\n         <raise event=\"enteringS121\"/>\n         </onentry>\n    </state>\n    <state id=\"s122\">\n      <onentry>\n       <raise event=\"enteringS122\"/>\n        </onentry>\n    </state>\n  </state>\n \n</state>\n\n\n<state id=\"s3\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n   </onentry>\n  <transition target=\"s0HistShallow\"/>\n</state>\n\n<state id=\"s4\">\n  <transition target=\"s1HistDeep\"/>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 579/test579.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that default history content is executed correctly.   The Process MUST execute any executable content in the transition after the parent state's onentry handlers, and, in the case where the history pseudo-state is the target of an <initial> transition, \nthe executable content inside the <initial> transition.  However the Processor MUST\nexecute this content only if there is no stored history.  Once the history state's\nparent state has been visited and exited, the default history content must not be executed --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s0\" datamodel=\"ecmascript\">\n\n       \n<state id=\"s0\">\n\t<datamodel>\n\t\t  <data id=\"Var1\" expr=\"0\"/>\n\t\t</datamodel>\n\t<initial>\n\t\t <transition target=\"sh1\">\n\t\t \t<raise event=\"event2\"/>\n\t\t \t</transition>\n\t\t \t</initial>\n  <onentry>\n  \t<send delayexpr=\"'1s'\" event=\"timeout\"/>\n    <raise event=\"event1\"/>\n    </onentry>\n  <onexit>\n  \t<assign location=\"Var1\" expr=\"Var1 + 1\"/>\n  \t</onexit>\n <history id=\"sh1\">\n \t  <transition target=\"s01\">\n \t  \t <raise event=\"event3\"/>\n \t  \t</transition>\n  \t</history>\n  \t\n  \t<state id=\"s01\">\n  \t\t<transition event=\"event1\" target=\"s02\"/>\n  \t\t<transition event=\"*\" target=\"fail\"/>\n  \t\t</state>\n  \t\t\n  <state id=\"s02\">\n  \t<transition event=\"event2\" target=\"s03\"/>\n  \t<transition event=\"*\" target=\"fail\"/>\n  \t\t\t</state>\n  <state id=\"s03\">\n  \t\n  \t<transition cond=\"Var1==0\" event=\"event3\" target=\"s0\"/>\n  \t<transition cond=\"Var1==1\" event=\"event1\" target=\"s2\"/>\n  \t<transition event=\"*\" target=\"fail\"/>\n  \t</state>\n</state> \n\n<state id=\"s2\">\n\t<transition event=\"event2\" target=\"s3\"/>\n\t<transition event=\"*\" target=\"fail\"/>\n\n\t</state>   \n\n<state id=\"s3\">\n\t<transition event=\"event3\" target=\"fail\"/>\n\t<transition event=\"timeout\" target=\"pass\"/>\n\t</state>\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 580/test580.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that a history state never ends up part of the configuration --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"p1\" datamodel=\"ecmascript\">\n\t<datamodel>\n\t\t  <data id=\"Var1\" expr=\"0\"/>\n\t\t</datamodel>\n\t\n<parallel id=\"p1\">\n  <onentry>\n  \t<send delay=\"2s\" event=\"timeout\"/>\n    </onentry>\n   \n   \n  <state id=\"s0\">\n <transition cond=\"In('sh1')\" target=\"fail\"/>\n <transition event=\"timeout\" target=\"fail\"/>\n  \t</state>\n \n           \n<state id=\"s1\">\n\t<initial>\n\t\t <transition target=\"sh1\"/>\n\t\t \t</initial>\n\n\n <history id=\"sh1\">\n \t  <transition target=\"s11\"/>\n   \t</history>\n  \t\n  \t<state id=\"s11\">\n  \t\t<transition cond=\"In('sh1')\" target=\"fail\"/>\n  \t\t<transition target=\"s12\"/>\n  \t\t</state>\n  \t\t\n  \t<state id=\"s12\"/>\n  <transition cond=\"In('sh1')\" target=\"fail\"/>\n <transition cond=\"Var1==0\" target=\"sh1\"/>\n <transition cond=\"Var1==1\" target=\"pass\"/>\n   <onexit>\n  \t<assign location=\"Var1\" expr=\"Var1 + 1\"/>\n  \t</onexit>\n </state>\n \n\n </parallel>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
