# generated by scripts/gen/irp_gen.py; do not edit
# the outcome of an IRP document: the id of the top-level final state
# reached ("pass" or "fail"), or "err <why>" when it is rejected
fn irp(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.err != ""
        return "err " + r.err
    return copy(r.outcome)
fn irp_trace(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return ",".join(r.trace)
fn irp_logs(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return "|".join(r.logs)
# the child's and the parent's logs of the forwarded event agree
fn irp_same(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.logs.len() != 14
        return "logs " + "|".join(r.logs)
    for i in 0..7
        if r.logs[i] != r.logs[i + 7]
            return "differ " + r.logs[i] + " / " + r.logs[i + 7]
    return ""
# a Basic HTTP request (bodies[0]) into a running document: the response
# status, then the outcome
fn irp_http(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let none_: List[text] = []
    let r = run_scxml_http(&doc, &none_, &none_, &no_evs, &bodies)
    let hs = copy(r.http)
    let oc = copy(r.outcome)
    return "|".join(hs) + "|" + oc
# 245/test245.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that non-existent datamodel values are not set.  Var2 is not defined in \ninvoked child's datamodel.  It will will return success if its Var2 remains unbound, failure otherwise.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var2\" expr=\"3\"/>\n  </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n   \n     <invoke type=\"http://www.w3.org/TR/scxml/\" namelist=\"Var2\">\n       <content>\n          <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n               <state id=\"sub0\">\n               <transition cond=\"Var2\" target=\"subFinal\">\n                <send target=\"#_parent\" event=\"failure\"/>\n            </transition>\n            <transition target=\"subFinal\">\n              <send target=\"#_parent\" event=\"success\"/>\n              </transition>\n          </state>    \n           <final id=\"subFinal\"/>\n           </scxml>\n           </content>\n          </invoke>\n          \n     <transition event=\"success\" target=\"pass\"/>\n     <transition event=\"*\" target=\"fail\"/>\n   </state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 247/test247.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that we get done.invoke.  timeout indicates failure  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n   \n     <invoke type=\"http://www.w3.org/TR/scxml/\">\n       <content>\n         <scxml version=\"1.0\" initial=\"subFinal\" datamodel=\"ecmascript\">\n           <final id=\"subFinal\"/>\n           </scxml>\n        </content>\n        </invoke>\n     <transition event=\"done.invoke\" target=\"pass\"/>\n     <transition event=\"timeout\" target=\"fail\"/>\n   </state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 250/test250.txml (mandatory)
check irp_logs("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the onexit handlers run in the invoked process if it is cancelled.  This has to be a\nmanual test, since this process won't accept any events from the child  process once it has been cancelled.\nTester must examine log output from child process to determine success   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"foo\"/>\n    </onentry>\n   \n     <invoke type=\"http://www.w3.org/TR/scxml/\">\n         <content>\n           <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n             <state id=\"sub0\" initial=\"sub01\">\n               <onentry>\n                <send event=\"timeout\" delay=\"2s\"/>\n                  </onentry>\n                 <transition event=\"timeout\" target=\"subFinal\"/>\n              <onexit>\n                 <log expr=\"'Exiting sub0'\"/>\n                </onexit> \n             <state id=\"sub01\">\n             <onexit>\n             <log expr=\"'Exiting sub01'\"/>\n           </onexit>\n        </state>\n      </state>     \n        <final id=\"subFinal\">\n          <onentry>\n           <log expr=\"'entering final state, invocation was not cancelled'\"/>\n          </onentry>\n         </final> \n      </scxml>\n      </content>\n      </invoke>\n      \n     <!-- this transition will cause the invocation to be cancelled -->\n     <transition event=\"foo\" target=\"final\"/>\n   </state>\n \n<final id=\"final\"/>\n</scxml>", [], []) == "Exiting sub01|Exiting sub0"
# 252/test252.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that we don't process any events received from the invoked process once it is cancelled.  child\nprocess tries to send us childToParent in an onexit handler.  If we get it, we fail.  \ntimeout indicates success.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delayexpr=\"'1s'\"/>\n    </onentry>\n    \n    <transition event=\"timeout\" target=\"pass\"/>\n    <transition event=\"childToParent\" target=\"fail\"/>\n    <transition event=\"done.invoke\" target=\"fail\"/>\n    \n    <state id=\"s01\">\n      <onentry>\n        <send event=\"foo\"/>\n        </onentry>\n   \n     <invoke type=\"http://www.w3.org/TR/scxml/\">\n       <content>\n         <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n              <state id=\"sub0\">\n             <onentry>\n             <send event=\"timeout\" delayexpr=\"'.5s'\"/>\n             </onentry> \n            <transition event=\"timeout\" target=\"subFinal\"/>\n               <onexit>\n               <send target=\"#_parent\" event=\"childToParent\"/>\n            </onexit>\n          </state>  \n          <final id=\"subFinal\"/>\n          </scxml>\n       </content>\n      </invoke>\n      \n     <!-- this transition will cause the invocation to be cancelled -->\n     <transition event=\"foo\" target=\"s02\"/>\n   </state>\n   \n   <state id=\"s02\"/>\n   \n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 253/test253.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the scxml event processor is used in both directions.  If child process uses the \nscxml event i/o processor to communicate with us, send it an event.  It will send back success if\nthis process uses the scxml processor to send the message to it, otherwise failure.  For this test we allow \n'scxml' as an alternative to the full url.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\"/>\n  </datamodel>\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n    \n    <transition event=\"timeout\" target=\"fail\"/>\n    \n    <invoke type=\"scxml\" id=\"foo\">\n      <content>\n      <!-- inform parent we're running then wait for it to send us an event.  If it uses the scxml event i/o\n             processor to do so, return success, otherwise return failure.   -->\n       <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n         <datamodel>\n          <data id=\"Var2\"/>\n           </datamodel>\n            <state id=\"sub0\">\n              <onentry>\n               <send target=\"#_parent\" event=\"childRunning\"/>\n            </onentry>\n   \n           <transition event=\"parentToChild\" target=\"sub1\">\n           <assign location=\"Var2\" expr=\"_event.origintype\"/>\n          </transition>\n         </state>\n          <state id=\"sub1\">\n            <transition cond=\"Var2=='http://www.w3.org/TR/scxml/#SCXMLEventProcessor'\" target=\"subFinal\">\n             <send target=\"#_parent\" event=\"success\"/>\n                </transition>\n            <transition cond=\"Var2=='scxml'\" target=\"subFinal\">\n             <send target=\"#_parent\" event=\"success\"/>\n              </transition>\n            <transition target=\"subFinal\">\n                <send target=\"#_parent\" event=\"failure\"/>\n             </transition>\n           </state>\n          <final id=\"subFinal\"/>\n            </scxml>\n        </content>\n        </invoke>\n    \n    <state id=\"s01\">\n    <transition event=\"childRunning\" target=\"s02\">\n       <assign location=\"Var1\" expr=\"_event.origintype\"/>\n       </transition>\n   </state>\n    \n    <state id=\"s02\">\n\n     <transition cond=\"Var1=='http://www.w3.org/TR/scxml/#SCXMLEventProcessor'\" target=\"s03\">\n        <send target=\"#_foo\" event=\"parentToChild\"/>\n        </transition>\n    <transition cond=\"Var1=='scxml'\" target=\"s03\">\n        <send target=\"#_foo\" event=\"parentToChild\"/>\n        </transition>\n \n    <transition target=\"fail\"/>\n\n    </state>        \n\n     \n     <state id=\"s03\">\n       <transition event=\"success\" target=\"pass\"/>\n       <transition event=\"fail\" target=\"fail\"/>\n  \n     </state>   \n\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 530/test530.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that <content> child is evaluated when <invoke> is. Var1 is initialized\nwith an integer value, then set to an scxml script in the onentry to s0.  If <content>\nis evaluated at the right time, we should get invoke.done, otherwise an error  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n  <datamodel>\n    <data id=\"Var1\" expr=\"1\"/>\n    </datamodel>\n    \n    <state id=\"s0\">\n      <onentry>\n        <assign location=\"Var1\">\n           <scxml version=\"1.0\"><final/></scxml>\n           </assign>\n        <send event=\"timeout\" delay=\"2s\"/>\n        </onentry>\n        \n      <invoke type=\"http://www.w3.org/TR/scxml/\">\n        <content expr=\"Var1\"/>\n        </invoke>\n        \n        <transition event=\"done.invoke\" target=\"pass\"/>\n        <transition event=\"*\" target=\"fail\"/>\n    </state>\n    \n    <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n    <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n  </scxml>", [], []) == "pass"
# 554/test554.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that if the evaluation of <invoke>'s args causes an error, the \ninvocation is cancelled.  In this test, that means that we don't get done.invoke \nbefore the timer goes off.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timer\" delayexpr=\"'1s'\"/>\n    </onentry>\n    \n  <!-- reference an invalid namelist -->\n   <invoke type=\"http://www.w3.org/TR/scxml/\" namelist=\"&#34;foo\">\n      <content>\n       <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n             <final id=\"subFinal\"/>\n            </scxml>\n            </content>\n            </invoke>\n     <transition event=\"timer\" target=\"pass\"/>\n     <transition event=\"done.invoke\" target=\"fail\"/>\n   </state>   \n     \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 436/test436.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that in() predicate works in null data model --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"null\" version=\"1.0\" initial=\"p\">\n\n     \n <parallel id=\"p\">\n \n   <state id=\"ps0\">\n   <transition cond=\"In('s1')\" target=\"fail\"/>\n   <transition cond=\"In('ps1')\" target=\"pass\"/> \n   <transition target=\"fail\"/>\n   </state>\n\n   <state id=\"ps1\"/> \n </parallel>\n \n <state id=\"s1\"/>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
# 278/test278.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n<!-- test that a variable can be accessed from a state that is outside its lexical scope -->   \n     \n <state id=\"s0\">\n   <transition cond=\"Var1==1\" target=\"pass\"/>\n\n  <transition target=\"fail\"/>\n\n   </state>\n   \n<state id=\"s1\">\n  <datamodel>\n    <data id=\"Var1\" expr=\"1\"/>\n    </datamodel>\n  </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 444/test444.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that <data> creates a new ecmascript variable. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n  <datamodel>\n    <data id=\"var1\" expr=\"1\"/>\n    </datamodel>\n     \n<state id=\"s0\">\n<!-- test that var1 can be used as an ecmascript variable -->\n  <transition cond=\"++var1==2\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n</state>\n\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 445/test445.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that ecmascript objects defined by <data> have value undefined if <data> does not assign a value --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n  <datamodel>\n    <data id=\"var1\"/>\n    </datamodel>\n     \n<state id=\"s0\">\n\n  <transition cond=\"var1==undefined\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n</state>\n\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 448/test448.txml (optional)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that all ecmascript objects are placed in a single global scope --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n \n     \n<state id=\"s0\">\n<!-- test that a parent state can access a variable defined in a child -->\n  <transition cond=\"var1==1\" target=\"s1\"/>\n  <transition target=\"fail\"/>\n   <state id=\"s01\">\n    <datamodel>\n      <data id=\"var1\" expr=\"1\"/>\n       </datamodel>\n    </state>\n </state>  \n    <state id=\"s1\" initial=\"s01p\">  \n     <parallel id=\"s01p\">\n       <state id=\"s01p1\">\n  <!-- test that we can access a variable defined in a parallel sibling state -->\n           <transition cond=\"var2==1\" target=\"pass\"/>\n           <transition target=\"fail\"/>\n       </state>\n       <state id=\"s01p2\">\n           <datamodel>\n           <data id=\"var2\" expr=\"1\"/>\n          </datamodel>\n       </state>\n     </parallel>\n    </state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
