# generated by scripts/gen/irp_gen.py; do not edit
# the outcome of an IRP document: the id of the top-level final state
# reached ("pass" or "fail"), or "err <why>" when it is rejected
fn irp(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.err != ""
        return "err " + r.err
    return copy(r.outcome)
fn irp_trace(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return ",".join(r.trace)
fn irp_logs(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    return "|".join(r.logs)
# the child's and the parent's logs of the forwarded event agree
fn irp_same(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let r = run_scxml(&doc, &names, &bodies, &no_evs)
    if r.logs.len() != 14
        return "logs " + "|".join(r.logs)
    for i in 0..7
        if r.logs[i] != r.logs[i + 7]
            return "differ " + r.logs[i] + " / " + r.logs[i + 7]
    return ""
# a Basic HTTP request (bodies[0]) into a running document: the response
# status, then the outcome
fn irp_http(doc: text, names: List[text], bodies: List[text]) -> text
    let no_evs: List[text] = []
    let none_: List[text] = []
    let r = run_scxml_http(&doc, &none_, &none_, &no_evs, &bodies)
    let hs = copy(r.http)
    let oc = copy(r.outcome)
    return "|".join(hs) + "|" + oc
# 487/test487.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test illegal assignment.  error.execution should be raised.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\"/>\n  </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n  \t<assign location=\"Var1\" expr=\"return\"/>\n   <raise event=\"event\"/>\n   </onentry>\n   \n  <transition event=\"error.execution\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>", [], []) == "pass"
# 294/test294.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that a param inside donedata ends up in the data field of the done event and\nthat content inside donedata sets the full value of the event.data field --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n <datamodel>\n       <data id=\"Var1\" expr=\"0\"/>\n    </datamodel>   \n     \n <state id=\"s0\" initial=\"s01\">\n    \n   <transition event=\"done.state.s0\" cond=\"_event.data['Var1']==1\" target=\"s1\">\n     </transition>\n     \n      <transition event=\"done.state.s0\" target=\"fail\">\n     </transition>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <param name=\"Var1\" expr=\"1\"/>\n      </donedata>\n     </final>\n </state>\n \n <state id=\"s1\" initial=\"s11\">\n    \n   <transition event=\"done.state.s1\" cond=\"_event.data == 'foo'\" target=\"pass\">\n     </transition>\n     \n      <transition event=\"done.state.s1\" target=\"fail\">\n     </transition>\n\n   <state id=\"s11\">\n   <transition target=\"s12\"/>\n   </state>\n   <final id=\"s12\">\n     <donedata>\n      <content>foo</content>\n      </donedata>\n     </final>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 527/test527.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- simple test that 'expr' works with <content> --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n     \n <state id=\"s0\" initial=\"s01\">\n    \n   <transition event=\"done.state.s0\" cond=\"_event.data == 'foo'\" target=\"pass\">\n     </transition>\n     \n      <transition event=\"done.state.s0\" target=\"fail\">\n     </transition>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <content expr=\"'foo'\"/>\n      </donedata>\n     </final>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 528/test528.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that illegal 'expr' produces error.execution and empty event.data --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n     \n <state id=\"s0\" initial=\"s01\">\n   <!-- we should get the error before the done event -->\n   <transition event=\"error.execution\" target=\"s1\"/>\n   <transition event=\"done.state.s0\" target=\"fail\"/>     \n\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <content expr=\"return\"/>\n      </donedata>\n     </final>\n  </state>\n\n \n <!-- if we get here, we received the error event. Now check that the done\n event has empty event.data -->\n \n <state id=\"s1\">\n   <transition event=\"done.state.s0\" cond=\"typeof _event.data === 'undefined'\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 529/test529.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- simple test that children workn with <content> --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n     \n <state id=\"s0\" initial=\"s01\">\n    \n   <transition event=\"done.state.s0\" cond=\"_event.data == 21\" target=\"pass\">\n     </transition>\n     \n      <transition event=\"done.state.s0\" target=\"fail\">\n     </transition>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <content>21</content>\n      </donedata>\n     </final>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 298/test298.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- reference a non-existent data model location in param in donedata and see that the right error is raised --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n <datamodel>\n       <data id=\"Var1\" expr=\"0\"/>\n    </datamodel>   \n     \n <state id=\"s0\" initial=\"s01\">\n \t<onentry>\n \t\t<send event=\"timeout\" delay=\"1s\"/>\n \t\t</onentry>\n \t\t\n    <transition event=\"error.execution\" target=\"pass\"/>\n       <transition event=\"*\" target=\"fail\"/>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <param name=\"Var3\" location=\"foo.bar.baz \"/>\n      </donedata>\n     </final>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>", [], []) == "pass"
# 343/test343.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that illegal <param> produces error.execution and empty event.data --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n     \n <state id=\"s0\" initial=\"s01\">\n   <!-- we should get the error before the done event -->\n   <transition event=\"error.execution\" target=\"s1\"/>\n   <transition event=\"done.state.s0\" target=\"fail\"/>     \n\n      <transition event=\"done.state.s0\" target=\"fail\">\n     </transition>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <param location=\"foo.bar.baz \" name=\"someParam\"/>\n      </donedata>\n     </final>\n  </state>\n\n \n <!-- if we get here, we received the error event. Now check that the done\n event has empty event.data -->\n \n <state id=\"s1\">\n   <transition event=\"done.state.s0\" cond=\"typeof _event.data === 'undefined'\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 488/test488.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that illegal expr in <param> produces error.execution and empty event.data --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n     \n <state id=\"s0\" initial=\"s01\">\n   <!-- we should get the error before the done event -->\n   <transition event=\"error.execution\" target=\"s1\"/>\n   <transition event=\"done.state.s0\" target=\"fail\"/>     \n\n      <transition event=\"done.state.s0\" target=\"fail\">\n     </transition>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <param expr=\"return\" name=\"someParam\"/>\n      </donedata>\n     </final>\n  </state>\n\n \n <!-- if we get here, we received the error event. Now check that the done\n event has empty event.data -->\n \n <state id=\"s1\">\n   <transition event=\"done.state.s0\" cond=\"typeof _event.data === 'undefined'\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>", [], []) == "pass"
# 301/test301.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- the processor should  reject this document because it can't download the script.  \nTherefore  we fail if it runs at all. This test is valid only for datamodels that support scripting --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s0\">\n <script src=\"D:\\foo\"/>\n     \n <state id=\"s0\">\n   <transition target=\"fail\"/>\n   </state>\n   \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "err script src not found"
# 302/test302.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that a script is evaluated at load time.  <conf:script> shoudl assign the value 1 to \nVar1.  Hence, if script is evaluated at download time, Var1 has a value in the initial state s0.\nThis test is valid only for datamodels that support scripting --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n <script>var Var1 = 1</script>\n     \n <state id=\"s0\">\n   <transition cond=\"Var1==1\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n   \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
# 303/test303.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- to test that scripts are run as part of executable content, we check that it changes the value of a var at the\nright point. This test is valid only for datamodels that support scripting --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n<datamodel>\n<data id=\"Var1\" expr=\"0\"/>\n</datamodel>\n     \n <state id=\"s0\">\n   <onentry>\n   <assign location=\"Var1\" expr=\"2\"/>\n   <script>var Var1 = 1</script>\n   </onentry>\n   <transition cond=\"Var1==1\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n   \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
# 304/test304.txml (mandatory)
check irp("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that a variable declared by a script can be accessed like any other part of the data model --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\" initial=\"s0\">\n <script>var Var1 = 1</script>\n     \n <state id=\"s0\">\n   <transition cond=\"Var1==1\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n   \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>", [], []) == "pass"
