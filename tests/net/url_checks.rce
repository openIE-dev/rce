# WPT urltestdata.json checks for net.url (generated by
# scripts/gen/url_gen.py; do not edit). Each expected value is
# href|protocol|username|password|host|hostname|port|pathname|search|hash,
# or FAIL.

fn wpt(i: text, b: text, hb: bool) -> text
    if hb
        let base = parse(&b) catch url_empty()
        if base.scheme == ""
            return "FAIL"
        let r = parse_with(&i, &base) catch |e| url_empty()
        return show(&i, &r, &base, true)
    let e = url_empty()
    let r = parse(&i) catch url_empty()
    return show(&i, &r, &e, false)

fn why(i: &text, b: &UrlParts, hb: bool) -> text
    let r = (if hb then parse_with(i, b) else parse(i)) catch |e| url_with_why(e)
    return r.scheme

fn url_with_why(e: BadUrl) -> UrlParts
    var x = url_empty()
    x.scheme = "FAIL"
    return x

fn show(i: &text, r: &UrlParts, b: &UrlParts, hb: bool) -> text
    if r.scheme == ""
        return why(i, b, hb)
    return href(r) + "|" + proto(r) + "|" + r.username + "|" + r.password + "|" + host_text(r) + "|" + hostname(r) + "|" + port_text(r) + "|" + pathname(r) + "|" + search(r) + "|" + hash(r)

check wpt("http://example\t.\norg", "http://example.org/foo/bar", true) == "http://example.org/|http:|||example.org|example.org||/||"
check wpt("http://user:pass@foo:21/bar;par?b#c", "http://example.org/foo/bar", true) == "http://user:pass@foo:21/bar;par?b#c|http:|user|pass|foo:21|foo|21|/bar;par|?b|#c"
