# generated by scripts/gen/stats_nist_gen.py from NIST StRD (NoInt2); checked by LRE
# (log relative error = correct significant digits) against a floor.

fn stx_lre(q: f64, c: f64) -> f64
    if q == c
        return 16.0
    let e = if c == 0.0 then st_abs(q) else st_abs(q - c) / st_abs(c)
    return 0.0 - special.log(e) / 2.302585092994046

const STX_Y: List[f64] = [3.0, 4.0, 4.0]
const STX_X: List[f64] = [4.0, 5.0, 6.0]

fn stx_design(x: &[f64], deg: i64, ic: bool) -> linalg.Mat
    let m = x.len()
    var a: List[f64] = []
    var p: i64 = deg
    if ic
        p = deg + 1
    for j in 0..(p as usize)
        let e = if ic then j as i64 else (j as i64) + 1
        for i in 0..m
            var v = 1.0
            for _ in 0..(e as usize)
                v = v * x[i]
            a.push(v)
    return linalg.mat(m, p as usize, a) catch linalg.zeros(1, 1)

const STX_A: linalg.Mat = stx_design(&STX_X, 1, false)

const STX: Ols = ols(&STX_A, &STX_Y, false) catch Ols(coef: [], se: [], resid_sd: 0.0, r2: 0.0, ss_reg: 0.0, ss_res: 0.0, df_reg: 0, df_res: 0, f: 0.0, exact: false)
check STX.df_reg == 1  # NIST NoInt2 df
check STX.df_res == 2  # NIST NoInt2 df
check stx_lre(STX.coef[0], 0.727272727272727) >= 12.0  # NIST NoInt2 B0, NIST certified 0.727272727272727
check stx_lre(STX.coef[0], 0.7272727272727273) >= 12.0  # NIST NoInt2 B0, exact for the binary64 data (mpmath)
check stx_lre(STX.se[0], 0.0420827318078432) >= 12.0  # NIST NoInt2 sd(B0), NIST certified 0.0420827318078432
check stx_lre(STX.se[0], 0.04208273180784325) >= 12.0  # NIST NoInt2 sd(B0), exact for the binary64 data (mpmath)
check stx_lre(STX.resid_sd, 0.369274472937998) >= 12.0  # NIST NoInt2 residual sd, NIST certified 0.369274472937998
check stx_lre(STX.resid_sd, 0.3692744729379982) >= 12.0  # NIST NoInt2 residual sd, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.993348115299335) >= 12.0  # NIST NoInt2 R^2, NIST certified 0.993348115299335
check stx_lre(STX.r2, 0.9933481152993349) >= 12.0  # NIST NoInt2 R^2, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_reg, 40.7272727272727) >= 12.0  # NIST NoInt2 SS regression, NIST certified 40.7272727272727
check stx_lre(STX.ss_reg, 40.72727272727273) >= 12.0  # NIST NoInt2 SS regression, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_res, 0.272727272727273) >= 12.0  # NIST NoInt2 SS residual, NIST certified 0.272727272727273
check stx_lre(STX.ss_res, 0.2727272727272727) >= 12.0  # NIST NoInt2 SS residual, exact for the binary64 data (mpmath)
check stx_lre(STX.f, 298.6666666666667) >= 12.0  # NIST NoInt2 F, NIST certified 298.6666666666667
check stx_lre(STX.f, 298.6666666666667) >= 12.0  # NIST NoInt2 F, exact for the binary64 data (mpmath)
