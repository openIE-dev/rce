# generated by scripts/gen/stats_nist_gen.py from NIST StRD (NumAcc1); checked by LRE
# (log relative error = correct significant digits) against a floor.

fn stx_lre(q: f64, c: f64) -> f64
    if q == c
        return 16.0
    let e = if c == 0.0 then st_abs(q) else st_abs(q - c) / st_abs(c)
    return 0.0 - special.log(e) / 2.302585092994046

const STX_Y: List[f64] = [10000001.0, 10000003.0, 10000002.0]

check stx_lre(mean(&STX_Y) catch 0.0, 10000002.0) >= 12.0  # NIST NumAcc1 mean, NIST certified 10000002.0
check stx_lre(mean(&STX_Y) catch 0.0, 10000002.0) >= 12.0  # NIST NumAcc1 mean, exact for the binary64 data (mpmath)
check stx_lre(stdev(&STX_Y, 1) catch 0.0, 1.0) >= 12.0  # NIST NumAcc1 sd, NIST certified 1.0
check stx_lre(stdev(&STX_Y, 1) catch 0.0, 1.0) >= 12.0  # NIST NumAcc1 sd, exact for the binary64 data (mpmath)
check stx_lre(autocorr1(&STX_Y) catch 0.0, -0.5) >= 12.0  # NIST NumAcc1 r(1), NIST certified -0.5
check stx_lre(autocorr1(&STX_Y) catch 0.0, -0.5) >= 12.0  # NIST NumAcc1 r(1), exact for the binary64 data (mpmath)
