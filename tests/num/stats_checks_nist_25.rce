check stx_lre(STX.coef[2], 1.0) >= 12.0  # NIST Wampler5 B2, exact for the binary64 data (mpmath)
check stx_lre(STX.se[2], 7793435.24331583) >= 12.0  # NIST Wampler5 sd(B2), NIST certified 7793435.24331583
check stx_lre(STX.se[2], 7793435.243315831) >= 12.0  # NIST Wampler5 sd(B2), exact for the binary64 data (mpmath)
check stx_lre(STX.coef[3], 1.0) >= 12.0  # NIST Wampler5 B3, NIST certified 1.0
check stx_lre(STX.coef[3], 1.0) >= 12.0  # NIST Wampler5 B3, exact for the binary64 data (mpmath)
check stx_lre(STX.se[3], 1014755.0755035) >= 12.0  # NIST Wampler5 sd(B3), NIST certified 1014755.0755035
check stx_lre(STX.se[3], 1014755.0755034965) >= 12.0  # NIST Wampler5 sd(B3), exact for the binary64 data (mpmath)
check stx_lre(STX.coef[4], 1.0) >= 12.0  # NIST Wampler5 B4, NIST certified 1.0
check stx_lre(STX.coef[4], 1.0) >= 12.0  # NIST Wampler5 B4, exact for the binary64 data (mpmath)
