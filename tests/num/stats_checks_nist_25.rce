check stx_lre(STX.resid_sd, 23601450.237926766) >= 12.0  # NIST Wampler5 residual sd, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.0022466892157494) >= 12.0  # NIST Wampler5 R^2, NIST certified 0.0022466892157494
check stx_lre(STX.r2, 0.002246689215749398) >= 12.0  # NIST Wampler5 R^2, exact for the binary64 data (mpmath)
