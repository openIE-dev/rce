# generated by scripts/gen/stats_nist_gen.py from NIST StRD (Pontius); checked by LRE
# (log relative error = correct significant digits) against a floor.

fn stx_lre(q: f64, c: f64) -> f64
    if q == c
        return 16.0
    let e = if c == 0.0 then st_abs(q) else st_abs(q - c) / st_abs(c)
    return 0.0 - special.log(e) / 2.302585092994046

const STX_Y: List[f64] = [0.11019, 0.21956, 0.32949, 0.43899, 0.54803, 0.65694, 0.76562, 0.87487, 0.98292, 1.09146, 1.20001, 1.30822, 1.41599, 1.52399, 1.63194, 1.73947, 1.84646, 1.95392, 2.06128, 2.16844, 0.11052, 0.22018, 0.32939, 0.43886, 0.54798, 0.65739, 0.76596, 0.87474, 0.983, 1.0915, 1.20004, 1.30818, 1.41613, 1.52408, 1.63159, 1.73965, 1.84696, 1.95445, 2.06177, 2.16829]
const STX_X: List[f64] = [150000.0, 300000.0, 450000.0, 600000.0, 750000.0, 900000.0, 1050000.0, 1200000.0, 1350000.0, 1500000.0, 1650000.0, 1800000.0, 1950000.0, 2100000.0, 2250000.0, 2400000.0, 2550000.0, 2700000.0, 2850000.0, 3000000.0, 150000.0, 300000.0, 450000.0, 600000.0, 750000.0, 900000.0, 1050000.0, 1200000.0, 1350000.0, 1500000.0, 1650000.0, 1800000.0, 1950000.0, 2100000.0, 2250000.0, 2400000.0, 2550000.0, 2700000.0, 2850000.0, 3000000.0]

fn stx_design(x: &[f64], deg: i64, ic: bool) -> linalg.Mat
    let m = x.len()
    var a: List[f64] = []
    var p: i64 = deg
    if ic
        p = deg + 1
    for j in 0..(p as usize)
        let e = if ic then j as i64 else (j as i64) + 1
        for i in 0..m
            var v = 1.0
            for _ in 0..(e as usize)
                v = v * x[i]
            a.push(v)
    return linalg.mat(m, p as usize, a) catch linalg.zeros(1, 1)

const STX_A: linalg.Mat = stx_design(&STX_X, 2, true)

const STX: Ols = ols(&STX_A, &STX_Y, true) catch Ols(coef: [], se: [], resid_sd: 0.0, r2: 0.0, ss_reg: 0.0, ss_res: 0.0, df_reg: 0, df_res: 0, f: 0.0, exact: false)
check STX.df_reg == 2  # NIST Pontius df
check STX.df_res == 37  # NIST Pontius df
check stx_lre(STX.coef[0], 0.000673565789473684) >= 12.0  # NIST Pontius B0, NIST certified 0.000673565789473684
check stx_lre(STX.coef[0], 0.0006735657894736632) >= 12.0  # NIST Pontius B0, exact for the binary64 data (mpmath)
check stx_lre(STX.se[0], 0.000107938612033077) >= 12.0  # NIST Pontius sd(B0), NIST certified 0.000107938612033077
check stx_lre(STX.se[0], 0.00010793861203307534) >= 12.0  # NIST Pontius sd(B0), exact for the binary64 data (mpmath)
check stx_lre(STX.coef[1], 7.32059160401003e-07) >= 12.0  # NIST Pontius B1, NIST certified 7.32059160401003e-07
check stx_lre(STX.coef[1], 7.320591604010026e-07) >= 12.0  # NIST Pontius B1, exact for the binary64 data (mpmath)
check stx_lre(STX.se[1], 1.57817399981659e-10) >= 12.0  # NIST Pontius sd(B1), NIST certified 1.57817399981659e-10
check stx_lre(STX.se[1], 1.5781739998165632e-10) >= 12.0  # NIST Pontius sd(B1), exact for the binary64 data (mpmath)
check stx_lre(STX.coef[2], -3.16081871345029e-15) >= 12.0  # NIST Pontius B2, NIST certified -3.16081871345029e-15
check stx_lre(STX.coef[2], -3.1608187134503054e-15) >= 12.0  # NIST Pontius B2, exact for the binary64 data (mpmath)
check stx_lre(STX.se[2], 4.86652849992036e-17) >= 12.0  # NIST Pontius sd(B2), NIST certified 4.86652849992036e-17
check stx_lre(STX.se[2], 4.866528499920286e-17) >= 12.0  # NIST Pontius sd(B2), exact for the binary64 data (mpmath)
check stx_lre(STX.resid_sd, 0.000205177424076185) >= 12.0  # NIST Pontius residual sd, NIST certified 0.000205177424076185
check stx_lre(STX.resid_sd, 0.00020517742407618158) >= 12.0  # NIST Pontius residual sd, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.999999900178537) >= 12.0  # NIST Pontius R^2, NIST certified 0.999999900178537
check stx_lre(STX.r2, 0.9999999001785371) >= 12.0  # NIST Pontius R^2, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_reg, 15.6040343244198) >= 12.0  # NIST Pontius SS regression, NIST certified 15.6040343244198
check stx_lre(STX.ss_reg, 15.604034324419812) >= 12.0  # NIST Pontius SS regression, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_res, 1.55761768796992e-06) >= 12.0  # NIST Pontius SS residual, NIST certified 1.55761768796992e-06
check stx_lre(STX.ss_res, 1.5576176879698784e-06) >= 12.0  # NIST Pontius SS residual, exact for the binary64 data (mpmath)
check stx_lre(STX.f, 185330865.995752) >= 12.0  # NIST Pontius F, NIST certified 185330865.995752
check stx_lre(STX.f, 185330865.9957571) >= 12.0  # NIST Pontius F, exact for the binary64 data (mpmath)
