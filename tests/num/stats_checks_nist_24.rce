check stx_lre(STX.coef[2], 1.0) >= 12.0  # NIST Wampler4 B2, exact for the binary64 data (mpmath)
check stx_lre(STX.se[2], 77934.3524331583) >= 12.0  # NIST Wampler4 sd(B2), NIST certified 77934.3524331583
check stx_lre(STX.se[2], 77934.3524331583) >= 12.0  # NIST Wampler4 sd(B2), exact for the binary64 data (mpmath)
check stx_lre(STX.coef[3], 1.0) >= 12.0  # NIST Wampler4 B3, NIST certified 1.0
