check stx_lre(STX.se[3], 10147.550755035) >= 12.0  # NIST Wampler4 sd(B3), NIST certified 10147.550755035
check stx_lre(STX.se[3], 10147.550755034965) >= 12.0  # NIST Wampler4 sd(B3), exact for the binary64 data (mpmath)
check stx_lre(STX.coef[4], 1.0) >= 12.0  # NIST Wampler4 B4, NIST certified 1.0
check stx_lre(STX.coef[4], 1.0) >= 12.0  # NIST Wampler4 B4, exact for the binary64 data (mpmath)
