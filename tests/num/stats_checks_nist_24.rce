check stx_lre(STX.resid_sd, 236014.50237926765) >= 12.0  # NIST Wampler4 residual sd, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.957478440825662) >= 12.0  # NIST Wampler4 R^2, NIST certified 0.957478440825662
