# generated by scripts/gen/stats_nist_gen.py from NIST StRD (Norris); checked by LRE
# (log relative error = correct significant digits) against a floor.

fn stx_lre(q: f64, c: f64) -> f64
    if q == c
        return 16.0
    let e = if c == 0.0 then st_abs(q) else st_abs(q - c) / st_abs(c)
    return 0.0 - special.log(e) / 2.302585092994046

const STX_Y: List[f64] = [0.1, 338.8, 118.1, 888.0, 9.2, 228.1, 668.5, 998.5, 449.1, 778.9, 559.2, 0.3, 0.1, 778.1, 668.8, 339.3, 448.9, 10.8, 557.7, 228.3, 998.0, 888.8, 119.6, 0.3, 0.6, 557.6, 339.3, 888.0, 998.5, 778.9, 10.2, 117.6, 228.9, 668.4, 449.2, 0.2]
const STX_X: List[f64] = [0.2, 337.4, 118.2, 884.6, 10.1, 226.5, 666.3, 996.3, 448.6, 777.0, 558.2, 0.4, 0.6, 775.5, 666.9, 338.0, 447.5, 11.6, 556.0, 228.1, 995.8, 887.6, 120.2, 0.3, 0.3, 556.8, 339.1, 887.2, 999.0, 779.0, 11.1, 118.3, 229.2, 669.1, 448.9, 0.5]

fn stx_design(x: &[f64], deg: i64, ic: bool) -> linalg.Mat
    let m = x.len()
    var a: List[f64] = []
    var p: i64 = deg
    if ic
        p = deg + 1
    for j in 0..(p as usize)
        let e = if ic then j as i64 else (j as i64) + 1
        for i in 0..m
            var v = 1.0
            for _ in 0..(e as usize)
                v = v * x[i]
            a.push(v)
    return linalg.mat(m, p as usize, a) catch linalg.zeros(1, 1)

const STX_A: linalg.Mat = stx_design(&STX_X, 1, true)

const STX: Ols = ols(&STX_A, &STX_Y, true) catch Ols(coef: [], se: [], resid_sd: 0.0, r2: 0.0, ss_reg: 0.0, ss_res: 0.0, df_reg: 0, df_res: 0, f: 0.0, exact: false)
check STX.df_reg == 1  # NIST Norris df
check STX.df_res == 34  # NIST Norris df
check stx_lre(STX.coef[0], -0.262323073774029) >= 12.0  # NIST Norris B0, NIST certified -0.262323073774029
check stx_lre(STX.coef[0], -0.26232307377402675) >= 12.0  # NIST Norris B0, exact for the binary64 data (mpmath)
check stx_lre(STX.se[0], 0.232818234301152) >= 12.0  # NIST Norris sd(B0), NIST certified 0.232818234301152
check stx_lre(STX.se[0], 0.2328182343011548) >= 12.0  # NIST Norris sd(B0), exact for the binary64 data (mpmath)
check stx_lre(STX.coef[1], 1.00211681802045) >= 12.0  # NIST Norris B1, NIST certified 1.00211681802045
check stx_lre(STX.coef[1], 1.0021168180204545) >= 12.0  # NIST Norris B1, exact for the binary64 data (mpmath)
check stx_lre(STX.se[1], 0.000429796848199937) >= 12.0  # NIST Norris sd(B1), NIST certified 0.000429796848199937
check stx_lre(STX.se[1], 0.0004297968481999412) >= 12.0  # NIST Norris sd(B1), exact for the binary64 data (mpmath)
check stx_lre(STX.resid_sd, 0.884796396144373) >= 12.0  # NIST Norris residual sd, NIST certified 0.884796396144373
check stx_lre(STX.resid_sd, 0.8847963961443813) >= 12.0  # NIST Norris residual sd, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.999993745883712) >= 12.0  # NIST Norris R^2, NIST certified 0.999993745883712
check stx_lre(STX.r2, 0.9999937458837117) >= 12.0  # NIST Norris R^2, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_reg, 4255954.13232369) >= 12.0  # NIST Norris SS regression, NIST certified 4255954.13232369
check stx_lre(STX.ss_reg, 4255954.132323693) >= 12.0  # NIST Norris SS regression, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_res, 26.6173985294224) >= 12.0  # NIST Norris SS residual, NIST certified 26.6173985294224
check stx_lre(STX.ss_res, 26.61739852942289) >= 12.0  # NIST Norris SS residual, exact for the binary64 data (mpmath)
check stx_lre(STX.f, 5436385.54079785) >= 12.0  # NIST Norris F, NIST certified 5436385.54079785
check stx_lre(STX.f, 5436385.540797737) >= 12.0  # NIST Norris F, exact for the binary64 data (mpmath)
