# generated by scripts/gen/stats_nist_gen.py from NIST StRD (SiRstv); checked by LRE
# (log relative error = correct significant digits) against a floor.

fn stx_lre(q: f64, c: f64) -> f64
    if q == c
        return 16.0
    let e = if c == 0.0 then st_abs(q) else st_abs(q - c) / st_abs(c)
    return 0.0 - special.log(e) / 2.302585092994046

const STX_G: List[List[f64]] = [[196.3052, 196.124, 196.189, 196.2569, 196.3403], [196.3042, 196.3825, 196.1669, 196.3257, 196.0422], [196.1303, 196.2005, 196.2889, 196.0343, 196.1811], [196.2795, 196.1748, 196.1494, 196.1485, 195.9885], [196.2119, 196.1051, 196.185, 196.0052, 196.209]]

const STX: Anova = f_oneway(&STX_G) catch Anova(ss_between: 0.0, ss_within: 0.0, df_between: 0, df_within: 0, ms_between: 0.0, ms_within: 0.0, f: 0.0, p: 0.0, r2: 0.0, resid_sd: 0.0)

check STX.df_between == 4  # NIST SiRstv df
check STX.df_within == 20  # NIST SiRstv df
check stx_lre(STX.ss_between, 0.0511462616) >= 12.0  # NIST SiRstv SS between, NIST certified 0.0511462616
check stx_lre(STX.ss_between, 0.05114626159999952) >= 12.0  # NIST SiRstv SS between, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_between, 0.0127865654) >= 12.0  # NIST SiRstv MS between, NIST certified 0.0127865654
check stx_lre(STX.ms_between, 0.01278656539999988) >= 12.0  # NIST SiRstv MS between, exact for the binary64 data (mpmath)
check stx_lre(STX.f, 1.18046237440255) >= 12.0  # NIST SiRstv F, NIST certified 1.18046237440255
check stx_lre(STX.f, 1.1804623744024467) >= 12.0  # NIST SiRstv F, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_within, 0.21663656) >= 12.0  # NIST SiRstv SS within, NIST certified 0.21663656
check stx_lre(STX.ss_within, 0.2166365600000165) >= 12.0  # NIST SiRstv SS within, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_within, 0.010831828) >= 12.0  # NIST SiRstv MS within, NIST certified 0.010831828
check stx_lre(STX.ms_within, 0.010831828000000824) >= 12.0  # NIST SiRstv MS within, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.190999039051129) >= 12.0  # NIST SiRstv R^2, NIST certified 0.190999039051129
check stx_lre(STX.r2, 0.19099903905111612) >= 12.0  # NIST SiRstv R^2, exact for the binary64 data (mpmath)
check stx_lre(STX.resid_sd, 0.104076068334656) >= 12.0  # NIST SiRstv residual sd, NIST certified 0.104076068334656
check stx_lre(STX.resid_sd, 0.10407606833466003) >= 12.0  # NIST SiRstv residual sd, exact for the binary64 data (mpmath)
