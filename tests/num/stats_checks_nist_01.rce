# generated by scripts/gen/stats_nist_gen.py from NIST StRD (Lottery); checked by LRE
# (log relative error = correct significant digits) against a floor.

fn stx_lre(q: f64, c: f64) -> f64
    if q == c
        return 16.0
    let e = if c == 0.0 then st_abs(q) else st_abs(q - c) / st_abs(c)
    return 0.0 - special.log(e) / 2.302585092994046

const STX_Y: List[f64] = [162.0, 671.0, 933.0, 414.0, 788.0, 730.0, 817.0, 33.0, 536.0, 875.0, 670.0, 236.0, 473.0, 167.0, 877.0, 980.0, 316.0, 950.0, 456.0, 92.0, 517.0, 557.0, 956.0, 954.0, 104.0, 178.0, 794.0, 278.0, 147.0, 773.0, 437.0, 435.0, 502.0, 610.0, 582.0, 780.0, 689.0, 562.0, 964.0, 791.0, 28.0, 97.0, 848.0, 281.0, 858.0, 538.0, 660.0, 972.0, 671.0, 613.0, 867.0, 448.0, 738.0, 966.0, 139.0, 636.0, 847.0, 659.0, 754.0, 243.0, 122.0, 455.0, 195.0, 968.0, 793.0, 59.0, 730.0, 361.0, 574.0, 522.0, 97.0, 762.0, 431.0, 158.0, 429.0, 414.0, 22.0, 629.0, 788.0, 999.0, 187.0, 215.0, 810.0, 782.0, 47.0, 34.0, 108.0, 986.0, 25.0, 644.0, 829.0, 630.0, 315.0, 567.0, 919.0, 331.0, 207.0, 412.0, 242.0, 607.0, 668.0, 944.0, 749.0, 168.0, 864.0, 442.0, 533.0, 805.0, 372.0, 63.0, 458.0, 777.0, 416.0, 340.0, 436.0, 140.0, 919.0, 350.0, 510.0, 572.0, 905.0, 900.0, 85.0, 389.0, 473.0, 758.0, 444.0, 169.0, 625.0, 692.0, 140.0, 897.0, 672.0, 288.0, 312.0, 860.0, 724.0, 226.0, 884.0, 508.0, 976.0, 741.0, 476.0, 417.0, 831.0, 15.0, 318.0, 432.0, 241.0, 114.0, 799.0, 955.0, 833.0, 358.0, 935.0, 146.0, 630.0, 830.0, 440.0, 642.0, 356.0, 373.0, 271.0, 715.0, 367.0, 393.0, 190.0, 669.0, 8.0, 861.0, 108.0, 795.0, 269.0, 590.0, 326.0, 866.0, 64.0, 523.0, 862.0, 840.0, 219.0, 382.0, 998.0, 4.0, 628.0, 305.0, 747.0, 247.0, 34.0, 747.0, 729.0, 645.0, 856.0, 974.0, 24.0, 568.0, 24.0, 694.0, 608.0, 480.0, 410.0, 729.0, 947.0, 293.0, 53.0, 930.0, 223.0, 203.0, 677.0, 227.0, 62.0, 455.0, 387.0, 318.0, 562.0, 242.0, 428.0, 968.0]

check stx_lre(mean(&STX_Y) catch 0.0, 518.95871559633) >= 12.0  # NIST Lottery mean, NIST certified 518.95871559633
