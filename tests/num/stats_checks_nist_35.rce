const STX: Anova = f_oneway(&STX_G) catch Anova(ss_between: 0.0, ss_within: 0.0, df_between: 0, df_within: 0, ms_between: 0.0, ms_within: 0.0, f: 0.0, p: 0.0, r2: 0.0, resid_sd: 0.0)

check STX.df_between == 8  # NIST SmLs09 df
check STX.df_within == 18000  # NIST SmLs09 df
check stx_lre(STX.ss_between, 160.08) >= 3.4  # NIST SmLs09 SS between, NIST certified 160.08
check stx_lre(STX.ss_between, 160.09949443572512) >= 12.0  # NIST SmLs09 SS between, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_between, 20.01) >= 3.4  # NIST SmLs09 MS between, NIST certified 20.01
check stx_lre(STX.ms_between, 20.01243680446564) >= 12.0  # NIST SmLs09 MS between, exact for the binary64 data (mpmath)
check stx_lre(STX.f, 2001.0) >= 3.6  # NIST SmLs09 F, NIST certified 2001.0
check stx_lre(STX.f, 2001.1349262209505) >= 12.0  # NIST SmLs09 F, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_within, 180.0) >= 3.7  # NIST SmLs09 SS within, NIST certified 180.0
check stx_lre(STX.ss_within, 180.00978232919425) >= 12.0  # NIST SmLs09 SS within, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_within, 0.01) >= 3.7  # NIST SmLs09 MS within, NIST certified 0.01
check stx_lre(STX.ms_within, 0.010000543462733014) >= 12.0  # NIST SmLs09 MS within, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.470712773465067) >= 3.9  # NIST SmLs09 R^2, NIST certified 0.470712773465067
check stx_lre(STX.r2, 0.47072957244381347) >= 12.0  # NIST SmLs09 R^2, exact for the binary64 data (mpmath)
check stx_lre(STX.resid_sd, 0.1) >= 4.0  # NIST SmLs09 residual sd, NIST certified 0.1
check stx_lre(STX.resid_sd, 0.1000027172767471) >= 12.0  # NIST SmLs09 residual sd, exact for the binary64 data (mpmath)
