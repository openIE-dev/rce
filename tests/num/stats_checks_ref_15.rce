# generated by scripts/gen/stats_scipy_gen.py: scipy.stats 1.18.1 distributions (pdf/cdf/sf/ppf), relative error per family

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

check stx_rel(chi2_pdf(120.0, 10.0) catch -1.0, 2.3642579059280375e-21) <= 2e-13  # scipy.stats chi2_pdf
check stx_rel(chi2_cdf(120.0, 10.0) catch -1.0, 1.0) <= 2e-13  # scipy.stats chi2_cdf
check stx_rel(chi2_sf(120.0, 10.0) catch -1.0, 5.060046065842555e-21) <= 2e-13  # scipy.stats chi2_sf
check stx_rel(chi2_pdf(600.0, 10.0) catch -1.0, 8.687587875319977e-123) <= 2e-13  # scipy.stats chi2_pdf
check stx_rel(chi2_cdf(600.0, 10.0) catch -1.0, 1.0) <= 2e-13  # scipy.stats chi2_cdf
check stx_rel(chi2_sf(600.0, 10.0) catch -1.0, 1.7609176946831897e-122) <= 2e-13  # scipy.stats chi2_sf
check stx_rel(chi2_ppf(1e-10, 10.0) catch -1.0, 0.05233106563190542) <= 1e-12  # scipy.stats chi2_ppf
check stx_rel(chi2_ppf(0.0001, 10.0) catch -1.0, 0.8889203579128959) <= 1e-12  # scipy.stats chi2_ppf
check stx_rel(chi2_ppf(0.025, 10.0) catch -1.0, 3.2469727802368413) <= 1e-12  # scipy.stats chi2_ppf
check stx_rel(chi2_ppf(0.2, 10.0) catch -1.0, 6.179079256039391) <= 1e-12  # scipy.stats chi2_ppf
check stx_rel(chi2_ppf(0.5, 10.0) catch -1.0, 9.34181776559197) <= 1e-12  # scipy.stats chi2_ppf
