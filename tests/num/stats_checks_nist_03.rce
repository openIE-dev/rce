# generated by scripts/gen/stats_nist_gen.py from NIST StRD (Mavro); checked by LRE
# (log relative error = correct significant digits) against a floor.

fn stx_lre(q: f64, c: f64) -> f64
    if q == c
        return 16.0
    let e = if c == 0.0 then st_abs(q) else st_abs(q - c) / st_abs(c)
    return 0.0 - special.log(e) / 2.302585092994046

const STX_Y: List[f64] = [2.0018, 2.0017, 2.0018, 2.0019, 2.0018, 2.0017, 2.0015, 2.0014, 2.0015, 2.0015, 2.0017, 2.0018, 2.0018, 2.0019, 2.0019, 2.0021, 2.002, 2.0016, 2.0014, 2.0013, 2.0013, 2.0015, 2.0015, 2.0016, 2.0015, 2.0014, 2.0013, 2.0014, 2.0015, 2.0014, 2.0015, 2.0016, 2.0015, 2.0016, 2.0019, 2.002, 2.002, 2.0021, 2.0022, 2.0023, 2.0024, 2.0025, 2.0027, 2.0026, 2.0026, 2.0026, 2.0027, 2.0026, 2.0025, 2.0024]

check stx_lre(mean(&STX_Y) catch 0.0, 2.001856) >= 12.0  # NIST Mavro mean, NIST certified 2.001856
check stx_lre(mean(&STX_Y) catch 0.0, 2.001856) >= 12.0  # NIST Mavro mean, exact for the binary64 data (mpmath)
check stx_lre(stdev(&STX_Y, 1) catch 0.0, 0.000429123454003053) >= 12.0  # NIST Mavro sd, NIST certified 0.000429123454003053
check stx_lre(stdev(&STX_Y, 1) catch 0.0, 0.0004291234540030854) >= 12.0  # NIST Mavro sd, exact for the binary64 data (mpmath)
check stx_lre(autocorr1(&STX_Y) catch 0.0, 0.937989183438248) >= 12.0  # NIST Mavro r(1), NIST certified 0.937989183438248
check stx_lre(autocorr1(&STX_Y) catch 0.0, 0.9379891834382589) >= 12.0  # NIST Mavro r(1), exact for the binary64 data (mpmath)
