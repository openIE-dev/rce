# generated by scripts/gen/stats_scipy_gen.py: scipy.stats 1.18.1 distributions (pdf/cdf/sf/ppf), relative error per family

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

check stx_rel(beta_pdf(0.999, 0.5, 0.5) catch -1.0, 10.070879119947087) <= 2e-12  # scipy.stats beta_pdf
check stx_rel(beta_cdf(0.999, 0.5, 0.5) catch -1.0, 0.9798649583666235) <= 2e-12  # scipy.stats beta_cdf
check stx_rel(beta_sf(0.999, 0.5, 0.5) catch -1.0, 0.0201350416333775) <= 2e-12  # scipy.stats beta_sf
check stx_rel(beta_pdf(0.999999999, 0.5, 0.5) catch -1.0, 10065.842568271062) <= 2e-12  # scipy.stats beta_pdf
check stx_rel(beta_cdf(0.999999999, 0.5, 0.5) catch -1.0, 0.9999798683143246) <= 2e-12  # scipy.stats beta_cdf
check stx_rel(beta_sf(0.999999999, 0.5, 0.5) catch -1.0, 2.013168456046863e-05) <= 2e-12  # scipy.stats beta_sf
check stx_rel(beta_ppf(1e-10, 0.5, 0.5) catch -1.0, 2.4674011002723397e-20) <= 2e-12  # scipy.stats beta_ppf
