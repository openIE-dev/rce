# generated by scripts/gen/special_gen.py: FDLIBM 5.3 bit for bit; mpmath 1.4.1 (200 bits) within 1 ulp

# helpers: distance in ulps between two finite doubles of the same sign
fn ulps(a: f64, b: f64) -> i64
    let x = f64_bits(a)
    let y = f64_bits(b)
    if (x < 0) != (y < 0)
        return 1000000
    return if x > y then x - y else y - x

