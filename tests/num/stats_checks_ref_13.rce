check stx_rel(chi2_ppf(0.2, 3.0) catch -1.0, 1.0051740130523492) <= 1e-12  # scipy.stats chi2_ppf
check stx_rel(chi2_ppf(0.5, 3.0) catch -1.0, 2.3659738843753377) <= 1e-12  # scipy.stats chi2_ppf
