# generated by scripts/gen/stats_scipy_gen.py: scipy.stats 1.18.1 distributions (pdf/cdf/sf/ppf), relative error per family

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

check stx_rel(chi2_ppf(1e-10, 3.0) catch -1.0, 5.20939762143448e-07) <= 1e-12  # scipy.stats chi2_ppf
check stx_rel(chi2_ppf(0.0001, 3.0) catch -1.0, 0.005214832329027977) <= 1e-12  # scipy.stats chi2_ppf
