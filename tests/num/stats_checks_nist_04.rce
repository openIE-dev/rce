# generated by scripts/gen/stats_nist_gen.py from NIST StRD (Michelso); checked by LRE
# (log relative error = correct significant digits) against a floor.

fn stx_lre(q: f64, c: f64) -> f64
    if q == c
        return 16.0
    let e = if c == 0.0 then st_abs(q) else st_abs(q - c) / st_abs(c)
    return 0.0 - special.log(e) / 2.302585092994046

const STX_Y: List[f64] = [299.85, 299.74, 299.9, 300.07, 299.93, 299.85, 299.95, 299.98, 299.98, 299.88, 300.0, 299.98, 299.93, 299.65, 299.76, 299.81, 300.0, 300.0, 299.96, 299.96, 299.96, 299.94, 299.96, 299.94, 299.88, 299.8, 299.85, 299.88, 299.9, 299.84, 299.83, 299.79, 299.81, 299.88, 299.88, 299.83, 299.8, 299.79, 299.76, 299.8, 299.88, 299.88, 299.88, 299.86, 299.72, 299.72, 299.62, 299.86, 299.97, 299.95, 299.88, 299.91, 299.85, 299.87, 299.84, 299.84, 299.85, 299.84, 299.84, 299.84, 299.89, 299.81, 299.81, 299.82, 299.8, 299.77, 299.76, 299.74, 299.75, 299.76, 299.91, 299.92, 299.89, 299.86, 299.88, 299.72, 299.84, 299.85, 299.85, 299.78, 299.89, 299.84, 299.78, 299.81, 299.76, 299.81, 299.79, 299.81, 299.82, 299.85, 299.87, 299.87, 299.81, 299.74, 299.81, 299.94, 299.95, 299.8, 299.81, 299.87]

check stx_lre(mean(&STX_Y) catch 0.0, 299.8524) >= 12.0  # NIST Michelso mean, NIST certified 299.8524
check stx_lre(mean(&STX_Y) catch 0.0, 299.8524) >= 12.0  # NIST Michelso mean, exact for the binary64 data (mpmath)
check stx_lre(stdev(&STX_Y, 1) catch 0.0, 0.0790105478190518) >= 12.0  # NIST Michelso sd, NIST certified 0.0790105478190518
check stx_lre(stdev(&STX_Y, 1) catch 0.0, 0.07901054781905066) >= 12.0  # NIST Michelso sd, exact for the binary64 data (mpmath)
check stx_lre(autocorr1(&STX_Y) catch 0.0, 0.535199668621283) >= 12.0  # NIST Michelso r(1), NIST certified 0.535199668621283
check stx_lre(autocorr1(&STX_Y) catch 0.0, 0.5351996686212636) >= 12.0  # NIST Michelso r(1), exact for the binary64 data (mpmath)
