# generated by scripts/gen/stats_nist_gen.py from NIST StRD (AtmWtAg); checked by LRE
# (log relative error = correct significant digits) against a floor.

fn stx_lre(q: f64, c: f64) -> f64
    if q == c
        return 16.0
    let e = if c == 0.0 then st_abs(q) else st_abs(q - c) / st_abs(c)
    return 0.0 - special.log(e) / 2.302585092994046

const STX_G: List[List[f64]] = [[107.8681568, 107.8681465, 107.8681572, 107.8681785, 107.8681446, 107.8681903, 107.8681526, 107.8681494, 107.8681616, 107.8681587, 107.8681519, 107.8681486, 107.8681419, 107.8681569, 107.8681508, 107.8681672, 107.8681385, 107.8681518, 107.8681662, 107.8681424, 107.868136, 107.8681333, 107.868161, 107.8681477], [107.8681079, 107.8681344, 107.8681513, 107.8681197, 107.8681604, 107.8681385, 107.8681642, 107.8681365, 107.8681151, 107.8681082, 107.8681517, 107.8681448, 107.8681198, 107.8681482, 107.8681334, 107.8681609, 107.8681101, 107.8681512, 107.8681469, 107.868136, 107.8681254, 107.8681261, 107.868145, 107.8681368]]

const STX: Anova = f_oneway(&STX_G) catch Anova(ss_between: 0.0, ss_within: 0.0, df_between: 0, df_within: 0, ms_between: 0.0, ms_within: 0.0, f: 0.0, p: 0.0, r2: 0.0, resid_sd: 0.0)

check STX.df_between == 1  # NIST AtmWtAg df
check STX.df_within == 46  # NIST AtmWtAg df
check stx_lre(STX.ss_between, 3.638341875e-09) >= 9.7  # NIST AtmWtAg SS between, NIST certified 3.638341875e-09
check stx_lre(STX.ss_between, 3.6383418747907132e-09) >= 12.0  # NIST AtmWtAg SS between, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_between, 3.638341875e-09) >= 9.7  # NIST AtmWtAg MS between, NIST certified 3.638341875e-09
check stx_lre(STX.ms_between, 3.6383418747907132e-09) >= 12.0  # NIST AtmWtAg MS between, exact for the binary64 data (mpmath)
check stx_lre(STX.f, 15.946733567793) >= 9.6  # NIST AtmWtAg F, NIST certified 15.946733567793
check stx_lre(STX.f, 15.946733566676926) >= 12.0  # NIST AtmWtAg F, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_within, 1.04951729166667e-08) >= 10.4  # NIST AtmWtAg SS within, NIST certified 1.04951729166667e-08
check stx_lre(STX.ss_within, 1.049517291679747e-08) >= 12.0  # NIST AtmWtAg SS within, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_within, 2.28155932971014e-10) >= 10.4  # NIST AtmWtAg MS within, NIST certified 2.28155932971014e-10
check stx_lre(STX.ms_within, 2.2815593297385806e-10) >= 12.0  # NIST AtmWtAg MS within, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.257426544538321) >= 9.7  # NIST AtmWtAg R^2, NIST certified 0.257426544538321
check stx_lre(STX.r2, 0.2574265445249428) >= 12.0  # NIST AtmWtAg R^2, exact for the binary64 data (mpmath)
check stx_lre(STX.resid_sd, 1.5104831444641e-05) >= 10.7  # NIST AtmWtAg residual sd, NIST certified 1.5104831444641e-05
check stx_lre(STX.resid_sd, 1.5104831444735094e-05) >= 12.0  # NIST AtmWtAg residual sd, exact for the binary64 data (mpmath)
