# generated by scripts/gen/stats_scipy_gen.py: seeded variates vs an independent RFC 8439 ChaCha20 (rand.det stream layout)

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

fn stx_draws() -> List[f64]
    let sd: List[i64] = [3, 10, 17, 24, 31, 38, 45, 52, 59, 66, 73, 80, 87, 94, 101, 108, 115, 122, 129, 136, 143, 150, 157, 164, 171, 178, 185, 192, 199, 206, 213, 220]
    var r = det.from_seed(&sd, 5) catch det.Rng(key: [], stream: 0, block: 0, buf: [], pos: 16)
    var v: List[f64] = []
    for _ in 0..40
        v.push(uniform(&mut r))
    for _ in 0..40
        v.push(uniform_open(&mut r))
    for _ in 0..40
        v.push(normal(&mut r, 1.5, 2.0))
    for _ in 0..40
        v.push(exponential(&mut r, 3.0))
    return v

const STV: List[f64] = stx_draws()

