# generated by scripts/gen/stats_scipy_gen.py: scipy.stats 1.18.1 distributions (pdf/cdf/sf/ppf), relative error per family

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

check stx_rel(beta_ppf(0.0001, 10.0, 0.7) catch -1.0, 0.4317777189350366) <= 2e-12  # scipy.stats beta_ppf
check stx_rel(beta_ppf(0.025, 10.0, 0.7) catch -1.0, 0.7360633043684983) <= 2e-12  # scipy.stats beta_ppf
