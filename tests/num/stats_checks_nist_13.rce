fn stx_design(x: &[f64], deg: i64, ic: bool) -> linalg.Mat
    let m = x.len()
    var a: List[f64] = []
    var p: i64 = deg
    if ic
        p = deg + 1
    for j in 0..(p as usize)
        let e = if ic then j as i64 else (j as i64) + 1
        for i in 0..m
            var v = 1.0
            for _ in 0..(e as usize)
                v = v * x[i]
            a.push(v)
    return linalg.mat(m, p as usize, a) catch linalg.zeros(1, 1)

const STX_A: linalg.Mat = stx_design(&STX_X, 10, true)

const STQ: OlsQr = ols_qr(&STX_A) catch OlsQr(q: linalg.zeros(1, 1), r: linalg.zeros(1, 1))
const STB: List[f64] = ols_coef(&STX_A, &STQ, &STX_Y) catch []
const STE: List[f64] = []
const STX: Ols = ols_from(&STX_A, &STX_Y, true, STB, &STE) catch Ols(coef: [], se: [], resid_sd: 0.0, r2: 0.0, ss_reg: 0.0, ss_res: 0.0, df_reg: 0, df_res: 0, f: 0.0, exact: false)
