const STX: Anova = f_oneway(&STX_G) catch Anova(ss_between: 0.0, ss_within: 0.0, df_between: 0, df_within: 0, ms_between: 0.0, ms_within: 0.0, f: 0.0, p: 0.0, r2: 0.0, resid_sd: 0.0)

check STX.df_between == 8  # NIST SmLs06 df
check STX.df_within == 18000  # NIST SmLs06 df
check stx_lre(STX.ss_between, 160.08) >= 9.4  # NIST SmLs06 SS between, NIST certified 160.08
check stx_lre(STX.ss_between, 160.0800000185892) >= 12.0  # NIST SmLs06 SS between, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_between, 20.01) >= 9.4  # NIST SmLs06 MS between, NIST certified 20.01
check stx_lre(STX.ms_between, 20.01000000232365) >= 12.0  # NIST SmLs06 MS between, exact for the binary64 data (mpmath)
check stx_lre(STX.f, 2001.0) >= 9.6  # NIST SmLs06 F, NIST certified 2001.0
check stx_lre(STX.f, 2001.0000001288329) >= 12.0  # NIST SmLs06 F, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_within, 180.0) >= 9.7  # NIST SmLs06 SS within, NIST certified 180.0
check stx_lre(STX.ss_within, 180.00000000931323) >= 12.0  # NIST SmLs06 SS within, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_within, 0.01) >= 9.7  # NIST SmLs06 MS within, NIST certified 0.01
check stx_lre(STX.ms_within, 0.0100000000005174) >= 12.0  # NIST SmLs06 MS within, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.470712773465067) >= 9.9  # NIST SmLs06 R^2, NIST certified 0.470712773465067
check stx_lre(STX.r2, 0.4707127734811079) >= 12.0  # NIST SmLs06 R^2, exact for the binary64 data (mpmath)
check stx_lre(STX.resid_sd, 0.1) >= 10.0  # NIST SmLs06 residual sd, NIST certified 0.1
check stx_lre(STX.resid_sd, 0.100000000002587) >= 12.0  # NIST SmLs06 residual sd, exact for the binary64 data (mpmath)
