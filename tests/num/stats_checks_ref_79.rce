# generated by scripts/gen/stats_scipy_gen.py: scipy.stats 1.18.1 distributions (pdf/cdf/sf/ppf), relative error per family

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

check stx_rel(poisson_cdf(17, 5.0) catch -1.0, 0.99999458366173) <= 1e-12  # scipy.stats poisson_cdf
check stx_rel(poisson_sf(17, 5.0) catch -1.0, 5.416338269948656e-06) <= 1e-12  # scipy.stats poisson_sf
check (poisson_ppf(0.001, 5.0) catch -1) == 0  # scipy.stats poisson_ppf
check (poisson_ppf(0.2, 5.0) catch -1) == 3  # scipy.stats poisson_ppf
check (poisson_ppf(0.5, 5.0) catch -1) == 5  # scipy.stats poisson_ppf
check (poisson_ppf(0.9, 5.0) catch -1) == 8  # scipy.stats poisson_ppf
check (poisson_ppf(0.999, 5.0) catch -1) == 13  # scipy.stats poisson_ppf
check stx_rel(poisson_pmf(0, 50.0) catch -1.0, 1.9287498479639178e-22) <= 1e-12  # scipy.stats poisson_pmf
check stx_rel(poisson_cdf(0, 50.0) catch -1.0, 1.9287498479639183e-22) <= 1e-12  # scipy.stats poisson_cdf
check stx_rel(poisson_sf(0, 50.0) catch -1.0, 1.0) <= 1e-12  # scipy.stats poisson_sf
check stx_rel(poisson_pmf(1, 50.0) catch -1.0, 9.643749239819592e-21) <= 1e-12  # scipy.stats poisson_pmf
check stx_rel(poisson_cdf(1, 50.0) catch -1.0, 9.836624224615988e-21) <= 1e-12  # scipy.stats poisson_cdf
check stx_rel(poisson_sf(1, 50.0) catch -1.0, 1.0) <= 1e-12  # scipy.stats poisson_sf
