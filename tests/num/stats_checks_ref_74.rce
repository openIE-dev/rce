# generated by scripts/gen/stats_scipy_gen.py: scipy.stats 1.18.1 distributions (pdf/cdf/sf/ppf), relative error per family

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

check (binom_ppf(0.001, 100, 0.01) catch -1) == 0  # scipy.stats binom_ppf
check (binom_ppf(0.2, 100, 0.01) catch -1) == 0  # scipy.stats binom_ppf
check (binom_ppf(0.5, 100, 0.01) catch -1) == 1  # scipy.stats binom_ppf
check (binom_ppf(0.9, 100, 0.01) catch -1) == 2  # scipy.stats binom_ppf
check (binom_ppf(0.999, 100, 0.01) catch -1) == 5  # scipy.stats binom_ppf
check stx_rel(binom_pmf(0, 1000, 0.5) catch -1.0, 9.332636185031775e-302) <= 1e-12  # scipy.stats binom_pmf
check stx_rel(binom_cdf(0, 1000, 0.5) catch -1.0, 9.332636185032189e-302) <= 1e-12  # scipy.stats binom_cdf
check stx_rel(binom_sf(0, 1000, 0.5) catch -1.0, 1.0) <= 1e-12  # scipy.stats binom_sf
check stx_rel(binom_pmf(1, 1000, 0.5) catch -1.0, 9.332636185031565e-299) <= 1e-12  # scipy.stats binom_pmf
check stx_rel(binom_cdf(1, 1000, 0.5) catch -1.0, 9.341968821217221e-299) <= 1e-12  # scipy.stats binom_cdf
check stx_rel(binom_sf(1, 1000, 0.5) catch -1.0, 1.0) <= 1e-12  # scipy.stats binom_sf
check stx_rel(binom_pmf(100, 1000, 0.5) catch -1.0, 5.958935980362969e-162) <= 1e-12  # scipy.stats binom_pmf
check stx_rel(binom_cdf(100, 1000, 0.5) catch -1.0, 6.701717790006182e-162) <= 1e-12  # scipy.stats binom_cdf
