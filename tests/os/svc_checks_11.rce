    return launchd_relaunch(&k, exited, st)
fn scr(kinds: text, flag: bool, crashed: bool, code: i64) -> i64
    let a = if kinds == "" then [] else kinds.split(",")
    let p = ScmPolicy(actions: a, nonzero_is_failure: flag)
    return scm_runs(&p, crashed, code, 5)
