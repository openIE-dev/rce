check vp("99999999999999999999.18446744073709551616.10") == "err value of major version number exceeds u64::MAX"
check vp("10.99999999999999999999.9+01") == "err value of minor version number exceeds u64::MAX"
check vp("0.9.591") == "ok 0.9.591"
check vp("0.2.10-rc.bc1b.") == "err empty identifier segment in pre-release identifier"
check vp("2.18446744073709551615.18446744073709551615") == "ok 2.18446744073709551615.18446744073709551615"
check vp("99999999999999999999.18446744073709551616.18446744073709551615-007.") == "err value of major version number exceeds u64::MAX"
check vp("640") == "err unexpected end of input while parsing major version number"
check vp("2.00.18446744073709551616-Z10") == "err invalid leading zero in minor version number"
check vp("0.9223372036854775808.18446744073709551616") == "err value of patch version number exceeds u64::MAX"
check vp("0.4.421") == "ok 0.4.421"
