check cp("~2.01.1-rc.1\u{0}") == "err invalid leading zero in minor version number"
check cp(" >=10.x.*-alpha.1") == "err unexpected character '-' after patch version number"
check cp("3.0.2-rc.1 ") == "ok ^3.0.2-rc.1"
