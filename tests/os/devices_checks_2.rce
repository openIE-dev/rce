fn nums(t: text) -> List[i64]
    var o: List[i64] = []
    if t == ""
        return o
    for p in t.split(" ")
        var v: i64 = 0
        for c in p.chars()
            v = v * 10 + (c[0] as i64 - 48)
        o.push(v)
    return o
fn dec(x0: i64) -> text
    let d = "0123456789".chars()
    var x = if x0 < 0 then 0 - x0 else x0
    var s = ""
    while true bound 20
        s = d[(x % 10) as usize] + s
        x = x / 10
        if x == 0
            break
    return if x0 < 0 then "-" + s else s
