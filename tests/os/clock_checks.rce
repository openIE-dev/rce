
# ---- generated by scripts/gen/clock_gen.py; Dur? models a Rust value that
# may panic (none = panicked).
fn N(s: i64, n: i64) -> Dur?
    let r = dur_new(s, n) catch Dur(secs: -1, nanos: 0)
    return if r.secs < 0 then none else some(r)
fn fr(r: Dur) -> Dur? = if r.secs < 0 then none else some(r)
fn Fsecs(n: i64) -> Dur? = fr(from_secs(n) catch Dur(secs: -1, nanos: 0))
fn Fmillis(n: i64) -> Dur? = fr(from_millis(n) catch Dur(secs: -1, nanos: 0))
fn Fmicros(n: i64) -> Dur? = fr(from_micros(n) catch Dur(secs: -1, nanos: 0))
fn Fnanos(n: i64) -> Dur? = fr(from_nanos(n) catch Dur(secs: -1, nanos: 0))
fn Fmins(n: i64) -> Dur? = fr(from_mins(n) catch Dur(secs: -1, nanos: 0))
fn Fhours(n: i64) -> Dur? = fr(from_hours(n) catch Dur(secs: -1, nanos: 0))
fn Fdays(n: i64) -> Dur? = fr(from_days(n) catch Dur(secs: -1, nanos: 0))
fn Fweeks(n: i64) -> Dur? = fr(from_weeks(n) catch Dur(secs: -1, nanos: 0))
fn dk(d: Dur?) -> text
    match d
        some(x) -> return x.secs.tostr() + "." + x.nanos.tostr()
        none -> return "none"
fn G(d: Dur?) -> Dur = d.or(Dur(secs: -1, nanos: -1))
fn bad(d: Dur?) -> bool = G(d).secs < 0
fn Oadd(a: Dur?, b: Dur?) -> Dur?
    if bad(copy(a)) or bad(copy(b))
        return none
    let x = G(a)
    let y = G(b)
    return checked_add(&x, &y)
fn Osub(a: Dur?, b: Dur?) -> Dur?
    if bad(copy(a)) or bad(copy(b))
        return none
    let x = G(a)
    let y = G(b)
    return checked_sub(&x, &y)
fn Osatadd(a: Dur?, b: Dur?) -> Dur?
    if bad(copy(a)) or bad(copy(b))
        return none
    let x = G(a)
    let y = G(b)
    return some(saturating_add(&x, &y))
fn Osatsub(a: Dur?, b: Dur?) -> Dur?
    if bad(copy(a)) or bad(copy(b))
        return none
    let x = G(a)
    let y = G(b)
    return some(saturating_sub(&x, &y))
fn Oabs(a: Dur?, b: Dur?) -> Dur?
    if bad(copy(a)) or bad(copy(b))
        return none
    let x = G(a)
    let y = G(b)
    return some(abs_diff(&x, &y))
fn Omul(a: Dur?, k: i64) -> Dur?
    if bad(copy(a))
        return none
    let x = G(a)
    return checked_mul(&x, k)
fn Osatmul(a: Dur?, k: i64) -> Dur?
    if bad(copy(a))
        return none
    let x = G(a)
    return some(saturating_mul(&x, k))
fn Odiv(a: Dur?, k: i64) -> Dur?
    if bad(copy(a))
        return none
    let x = G(a)
    return checked_div(&x, k)
fn Isecs(a: Dur?) -> i64 = G(a).secs
fn Imillis(a: Dur?) -> i64
    let x = G(a)
    return subsec_millis(&x)
fn Imicros(a: Dur?) -> i64
    let x = G(a)
    return subsec_micros(&x)
fn Inanos(a: Dur?) -> i64
    let x = G(a)
    return subsec_nanos(&x)
fn Osum(ds: List[Dur?]) -> Dur?
    var xs: List[Dur] = []
    for d in ds
        if bad(copy(d))
            return none
        xs.push(G(copy(d)))
    return dur_sum(&xs)
fn fm(a: Dur?, prec: i64, width: i64, al: text, plus: bool) -> text
    let x = G(a)
    return dur_debug_with(&x, prec, width, &al, plus)

# creation
check dk(Fsecs(1)) != dk(Fsecs(0))
check dk(Oadd(Fsecs(1), Fsecs(2))) == dk(Fsecs(3))
check dk(Oadd(Fmillis(10), Fsecs(4))) == dk(N(4, 10000000))
check dk(Fmillis(4000)) == dk(N(4, 0))
# new_overflow
check dk(N(9223372036854775807, 1000000000)) == "none"
# from_mins_overflow
check dk(Fmins(153722867280912931)) == "none"
# from_hours_overflow
check dk(Fhours(2562047788015216)) == "none"
# from_days_overflow
check dk(Fdays(106751991167301)) == "none"
# from_weeks_overflow
check dk(Fweeks(15250284452472)) == "none"
# from_nanos_u128_overflow
check dk(none) == "none"
# constructor_weeks
check dk(Fweeks(1)) == dk(Fsecs(604800))
check dk(Fweeks(0)) == dk(N(0, 0))
# constructor_days
check dk(Fdays(1)) == dk(Fsecs(86400))
check dk(Fdays(0)) == dk(N(0, 0))
# constructor_hours
check dk(Fhours(1)) == dk(Fsecs(3600))
check dk(Fhours(0)) == dk(N(0, 0))
# constructor_minutes
check dk(Fmins(1)) == dk(Fsecs(60))
check dk(Fmins(0)) == dk(N(0, 0))
# secs
check Isecs(N(0, 0)) == 0
check Isecs(N(0, 500000005)) == 0
check Isecs(N(0, 1050000001)) == 1
check Isecs(Fsecs(1)) == 1
check Isecs(Fmillis(999)) == 0
check Isecs(Fmillis(1001)) == 1
check Isecs(Fmicros(999999)) == 0
check Isecs(Fmicros(1000001)) == 1
check Isecs(Fnanos(999999999)) == 0
check Isecs(Fnanos(1000000001)) == 1
check Isecs(Fnanos(999999999)) == 0
check Isecs(Fnanos(1000000001)) == 1
# millis
check Imillis(N(0, 0)) == 0
check Imillis(N(0, 500000005)) == 500
check Imillis(N(0, 1050000001)) == 50
check Imillis(Fsecs(1)) == 0
check Imillis(Fmillis(999)) == 999
check Imillis(Fmillis(1001)) == 1
check Imillis(Fmicros(999999)) == 999
check Imillis(Fmicros(1001000)) == 1
check Imillis(Fnanos(999999999)) == 999
check Imillis(Fnanos(1001000000)) == 1
check Imillis(Fnanos(999999999)) == 999
check Imillis(Fnanos(1001000001)) == 1
# micros
check Imicros(N(0, 0)) == 0
check Imicros(N(0, 500000005)) == 500000
check Imicros(N(0, 1050000001)) == 50000
check Imicros(Fsecs(1)) == 0
check Imicros(Fmillis(999)) == 999000
check Imicros(Fmillis(1001)) == 1000
check Imicros(Fmicros(999999)) == 999999
check Imicros(Fmicros(1000001)) == 1
check Imicros(Fnanos(999999999)) == 999999
check Imicros(Fnanos(1000001000)) == 1
check Imicros(Fnanos(999999999)) == 999999
check Imicros(Fnanos(1000001000)) == 1
# nanos
check Inanos(N(0, 0)) == 0
check Inanos(N(0, 5)) == 5
check Inanos(N(0, 1000000001)) == 1
check Inanos(Fsecs(1)) == 0
check Inanos(Fmillis(999)) == 999000000
check Inanos(Fmillis(1001)) == 1000000
check Inanos(Fmicros(999999)) == 999999000
check Inanos(Fmicros(1000001)) == 1000
check Inanos(Fnanos(999999999)) == 999999999
check Inanos(Fnanos(1000000001)) == 1
check Inanos(Fnanos(999999999)) == 999999999
check Inanos(Fnanos(1000000001)) == 1
# abs_diff
check dk(Oabs(N(2, 0), N(1, 0))) == dk(N(1, 0))
check dk(Oabs(N(1, 0), N(2, 0))) == dk(N(1, 0))
check dk(Oabs(N(1, 0), N(1, 0))) == dk(N(0, 0))
check dk(Oabs(N(1, 1), N(0, 2))) == dk(N(0, 999999999))
check dk(Oabs(N(1, 1), N(2, 1))) == dk(N(1, 0))
check dk(Oabs(N(9223372036854775807, 999999999), N(9223372036854775807, 999999999))) == dk(N(0, 0))
check dk(Oabs(N(0, 0), N(0, 0))) == dk(N(0, 0))
check dk(Oabs(N(9223372036854775807, 999999999), N(0, 0))) == dk(N(9223372036854775807, 999999999))
check dk(Oabs(N(0, 0), N(9223372036854775807, 999999999))) == dk(N(9223372036854775807, 999999999))
# add
check dk(Oadd(N(0, 0), N(0, 1))) == dk(N(0, 1))
check dk(Oadd(N(0, 500000000), N(0, 500000001))) == dk(N(1, 1))
# checked_add
check dk(Oadd(N(0, 0), N(0, 1))) == dk(N(0, 1))
check dk(Oadd(N(0, 500000000), N(0, 500000001))) == dk(N(1, 1))
check dk(Oadd(N(1, 0), N(9223372036854775807, 0))) == dk(none)
# saturating_add
check dk(Osatadd(N(0, 0), N(0, 1))) == dk(N(0, 1))
check dk(Osatadd(N(0, 500000000), N(0, 500000001))) == dk(N(1, 1))
check dk(Osatadd(N(1, 0), N(9223372036854775807, 0))) == dk(N(9223372036854775807, 999999999))
# sub
check dk(Osub(N(0, 1), N(0, 0))) == dk(N(0, 1))
check dk(Osub(N(0, 500000001), N(0, 500000000))) == dk(N(0, 1))
check dk(Osub(N(1, 0), N(0, 1))) == dk(N(0, 999999999))
# checked_sub
check dk(Osub(N(0, 1), N(0, 0))) == dk(N(0, 1))
check dk(Osub(N(1, 0), N(0, 1))) == dk(N(0, 999999999))
check dk(Osub(N(0, 0), N(0, 1))) == dk(none)
check dk(Osub(N(0, 0), N(1, 0))) == dk(none)
# saturating_sub
check dk(Osatsub(N(0, 1), N(0, 0))) == dk(N(0, 1))
check dk(Osatsub(N(1, 0), N(0, 1))) == dk(N(0, 999999999))
check dk(Osatsub(N(0, 0), N(0, 1))) == dk(N(0, 0))
check dk(Osatsub(N(0, 0), N(1, 0))) == dk(N(0, 0))
# sub_bad1
check dk(Osub(N(0, 0), N(0, 1))) == "none"
# sub_bad2
check dk(Osub(N(0, 0), N(1, 0))) == "none"
# mul
check dk(Omul(N(0, 1), 2)) == dk(N(0, 2))
check dk(Omul(N(1, 1), 3)) == dk(N(3, 3))
check dk(Omul(N(0, 500000001), 4)) == dk(N(2, 4))
check dk(Omul(N(0, 500000001), 4000)) == dk(N(2000, 4000))
# checked_mul
check dk(Omul(N(0, 1), 2)) == dk(N(0, 2))
check dk(Omul(N(1, 1), 3)) == dk(N(3, 3))
check dk(Omul(N(0, 500000001), 4)) == dk(N(2, 4))
check dk(Omul(N(0, 500000001), 4000)) == dk(N(2000, 4000))
check dk(Omul(N(9223372036854775806, 0), 2)) == dk(none)
# saturating_mul
check dk(Osatmul(N(0, 1), 2)) == dk(N(0, 2))
check dk(Osatmul(N(1, 1), 3)) == dk(N(3, 3))
check dk(Osatmul(N(0, 500000001), 4)) == dk(N(2, 4))
check dk(Osatmul(N(0, 500000001), 4000)) == dk(N(2000, 4000))
check dk(Osatmul(N(9223372036854775806, 0), 2)) == dk(N(9223372036854775807, 999999999))
# div
check dk(Odiv(N(0, 1), 2)) == dk(N(0, 0))
check dk(Odiv(N(1, 1), 3)) == dk(N(0, 333333333))
check dk(Odiv(N(1, 1), 7)) == dk(N(0, 142857143))
check dk(Odiv(N(99, 999999000), 100)) == dk(N(0, 999999990))
# checked_div
check dk(Odiv(N(2, 0), 2)) == dk(N(1, 0))
check dk(Odiv(N(1, 0), 2)) == dk(N(0, 500000000))
check dk(Odiv(N(2, 0), 0)) == dk(none)
# correct_sum
fn durs() -> List[Dur?] = [N(1, 999999999), N(2, 999999999), N(0, 999999999), N(0, 999999999), N(0, 999999999), N(5, 0)]
check dk(Osum(durs())) == dk(N(12, 999999995))
