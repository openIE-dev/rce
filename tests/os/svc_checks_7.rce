check rs("on-watchdog", "simple", "signal", "dumped", 11, "SIGSEGV", "", true) == "0 manual stop"
check rs("on-watchdog", "simple", "signal", "dumped", 11, "", "11 SIGSEGV", false) == "1 forced by exit status"
check rs("on-watchdog", "simple", "core-dump", "exited", 0, "", "", false) == "0 restart setting"
check rs("on-watchdog", "simple", "core-dump", "exited", 0, "3", "", false) == "0 restart setting"
