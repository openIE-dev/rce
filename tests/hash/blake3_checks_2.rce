# Checks for lib/hash/blake3.rce: the official BLAKE3 test vectors
# (vectors/hash/blake3/test_vectors.json), all three modes, full 131-byte
# extended outputs, plus properties. Shard files split the vectors so each
# stays within one comptime fuel budget (scripts/gen/blake3_gen.py).

fn pat(n: i64) -> List[i64]
    var o: List[i64] = []
    for i in 0..n
        o.push(i % 251)
    return o

fn hx(b: &[i64]) -> text
    let ds = "0123456789abcdef".chars()
    var s = ""
    for x in b
        s = s + copy(ds[(x >> 4) as usize]) + copy(ds[(x & 15) as usize])
    return s

fn bytes_of(s: text) -> List[i64]
    var o: List[i64] = []
    var i: usize = 0
    while i < s.len() bound 4096
        o.push(s[i] as i64)
        i += 1
    return o

fn v_hash(n: i64) -> text
    let p = pat(n)
    let h = blake3_xof(&p, 131)
    return hx(&h)

fn v_keyed(n: i64) -> text
    let p = pat(n)
    let k = bytes_of("whats the Elvish word for friend")
    let h = blake3_keyed(&k, &p, 131)
    return hx(&h)

fn v_derive(n: i64) -> text
    let p = pat(n)
    let c = bytes_of("BLAKE3 2019-12-27 16:29:52 test vectors context")
    let h = blake3_derive_key(&c, &p, 131)
    return hx(&h)

# property: the 32-byte hash is the prefix of every longer XOF output
fn prefix_ok(n: i64) -> bool
    let p = pat(n)
    let a = blake3(&p)
    let b = blake3_xof(&p, 200)
    var ok = true
    for i in 0..32
        ok = ok and a[i] == b[i]
    return ok

check v_hash(8192) == "aae792484c8efe4f19e2ca7d371d8c467ffb10748d8a5a1ae579948f718a2a635fe51a27db045a567c1ad51be5aa34c01c6651c4d9b5b5ac5d0fd58cf18dd61a47778566b797a8c67df7b1d60b97b19288d2d877bb2df417ace009dcb0241ca1257d62712b6a4043b4ff33f690d849da91ea3bf711ed583cb7b7a7da2839ba71309bbf"
check v_keyed(8192) == "dc9637c8845a770b4cbf76b8daec0eebf7dc2eac11498517f08d44c8fc00d58a4834464159dcbc12a0ba0c6d6eb41bac0ed6585cabfe0aca36a375e6c5480c22afdc40785c170f5a6b8a1107dbee282318d00d915ac9ed1143ad40765ec120042ee121cd2baa36250c618adaf9e27260fda2f94dea8fb6f08c04f8f10c78292aa46102"
