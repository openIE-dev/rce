# rce-version: 0.6
fn par_total(xs: [f64; 4]) -> f64
    var total: f64 = 0.0
    for i in 0..4 par
        total += xs[i]
    total
fn main()
    let xs: [f64; 4] = [1e16, 1.0, 1.0, -1e16]
    emit xs.fold(0.0, fn(a: f64, x: f64) => a + x)
    emit xs.sum()
    emit par_total(xs)
