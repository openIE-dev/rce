# Generated by scripts/gen/feed_gen.py; do not edit.
fn chain(evs: List[text], shs: List[text]) -> List[text]
    var log: List[Entry] = []
    var hs: List[text] = []
    for i in 0..evs.len()
        let j = events.json_parse(&evs[i]) catch events.JsNull
        let e = append(&log, j, copy(shs[i]))
        hs.push(copy(e.hash))
        log.push(e)
    return hs
fn mklog(evs: List[text], shs: List[text]) -> List[Entry]
    var log: List[Entry] = []
    for i in 0..evs.len()
        let j = events.json_parse(&evs[i]) catch events.JsNull
        log.push(append(&log, j, copy(shs[i])))
    return log
fn tamper(evs: List[text], shs: List[text], at: usize, ev: text) -> i64
    var log = mklog(evs, shs)
    log[at].ev = events.json_parse(&ev) catch events.JsNull
    return verify(&log)
fn relink(evs: List[text], shs: List[text], at: usize) -> i64
    var log = mklog(evs, shs)
    log[at].prev_hash = copy(GENESIS)
    log[at].hash = entry_hash(&log[at].ev, &log[at].prev_hash, log[at].seq, &log[at].state_hash)
    return verify(&log)
fn resume(evs: List[text], shs: List[text], tok: text) -> i64
    let log = mklog(evs, shs)
    let t = token_parse(&tok) catch Token(height: -1, digest: "")
    return resume_at(&log, &t) catch -1
fn tipt(evs: List[text], shs: List[text]) -> text
    let log = mklog(evs, shs)
    let t = tip(&log)
    return token_text(&t)
fn er(server: bool, code: i64, labels: List[text], cmd: text, wire: i64) -> Err = Err(server: server, code: code, labels: labels, cmd: cmd, wire: wire)
fn rs(server: bool, code: i64, labels: List[text], cmd: text, wire: i64) -> bool
    let e = er(server, code, labels, cmd, wire)
    return resumable(&e)
fn ptext(p: &Pos) -> text = "sa=" + p.start_after + ",ra=" + p.resume_after + ",op=" + p.start_at_op_time
# A scripted server: `nev` documents (ids t1..tn) arrive after the stream
# opens, one per getMore (batchSize 1, each batch's postBatchResumeToken
# is its document's id); the first `times` getMores fail with `e`; an
# aggregate fails with `ae` when ae.cmd is "aggregate" (the initial one
# when `ainit`, else the first resume). Result: the documents returned,
# the positions of the resume aggregates, and "ok" or "err<code>".
fn sim(e: Err, times: i64, ae: Err, ainit: bool, nev: i64, start: Pos, noid: bool) -> text
    var cs = cs_start(&start)
    var docs: List[text] = []
    var aggs: List[text] = []
    if ainit and ae.cmd == "aggregate"
        let _x = cs_error(&mut cs, &ae)
        return "|" + "|err" + cs.err_code.tostr()
    let z = ""
    let op1 = "op1"
    cs_initial(&mut cs, 0, &z, &op1)
    var failed: i64 = 0
    var next: i64 = 1
    var aggfail = not ainit and ae.cmd == "aggregate"
    var pending = false
    var steps: i64 = 0
    while next <= nev and not cs.closed and steps < 64 bound 64
        steps += 1
        if pending
            let p = resume_pos(&cs)
            aggs.push(ptext(&p))
            pending = false
            if aggfail
                aggfail = false
                pending = cs_error(&mut cs, &ae)
            else
                cs_batch(&mut cs, 0, &z)
        elif failed < times
            failed += 1
            pending = cs_error(&mut cs, &e)
        else
            let id = if noid then "" else "t" + next.tostr()
            if cs_doc(&mut cs, &id, true, &id)
                docs.push(id)
            next += 1
    let st = if cs.closed then "err" + cs.err_code.tostr() else "ok"
    return ",".join(docs) + "|" + ";".join(aggs) + "|" + st
const OK: Err = Err(server: true, code: 0, labels: [], cmd: "", wire: 0)
const NOPOS: Pos = Pos(start_after: "", resume_after: "", start_at_op_time: "")
fn pos(sa: text, ra: text, op: text) -> Pos = Pos(start_after: sa, resume_after: ra, start_at_op_time: op)
fn tok_after(start: Pos, docs: i64, last: bool, pbrt: text, empty: bool) -> text
    var cs = cs_start(&start)
    let _z = ""
    if empty
        cs_batch(&mut cs, 0, &pbrt)
    var i: i64 = 0
    while i < docs bound 64
        i += 1
        let id = "d" + i.tostr()
        let _b = cs_doc(&mut cs, &id, last and i == docs, &pbrt)
    return get_resume_token(&cs)
fn tp(t: text) -> text
    let k = token_parse(&t) catch Token(height: -1, digest: "ERR")
    return token_text(&k)
fn tok_batch(start: Pos, n: i64, pbrt: text) -> text
    var cs = cs_start(&start)
    cs_batch(&mut cs, n, &pbrt)
    return get_resume_token(&cs)
fn sc(f: List[i64], o: List[i64]) -> i64 = split_complete(&f, &o) catch -1
fn hl(sids: List[text], seqs: List[text]) -> List[Hist]
    var o: List[Hist] = []
    for i in 0..sids.len()
        o.push(Hist(session_id: copy(sids[i]), last_seq: copy(seqs[i])))
    return o
fn cmp(ss: text, sq: text, shs: List[text], shq: List[text], ts: text, tq: text, ths: List[text], thq: List[text]) -> text
    let a = Ckpt(session_id: ss, last_seq: sq, history: hl(shs, shq))
    let b = Ckpt(session_id: ts, last_seq: tq, history: hl(ths, thq))
    return compare_logs(&a, &b).last_seq
fn ckshow(c: &Ckpt) -> text
    var o = c.session_id + "/" + c.last_seq + ":"
    for h in c.history
        o = o + h.session_id + "=" + h.last_seq + ","
    return o
fn rec(ss: text, sq: text, shs: List[text], shq: List[text], sess: text, seq: text) -> text
    let a = Ckpt(session_id: ss, last_seq: sq, history: hl(shs, shq))
    let r = record(&a, &sess, &seq)
    return ckshow(&r)
# admission: a script of offers "key/cursor/height", "tick" and
# "ack:<durable>"; result: the outcome of each step.
fn adm(window: i64, bud: i64, script: List[text]) -> List[text]
    var ib = inbox(window, bud)
    var out: List[text] = []
    for s in script
        if s == "tick"
            tick(&mut ib)
            out.push("tick")
        elif s.startswith("ack:")
            let p = s.split(":")
            out.push("ack=" + ack(&mut ib, p[1].toint()))
        else
            let p = s.split("/")
            out.push(offr(&mut ib, &p[0], &p[1], p[2].toint()))
    out.push("dups=" + ib.dups.tostr() + " overflow=" + ib.overflow.tostr() + " acked=" + ib.acked + " pending=" + ib.pending.len().tostr())
    return out
fn sim_after_doc_ra() -> text
    let st = pos("sa0", "", "")
    var cs = cs_start(&st)
    let id = "t1"
    let z = ""
    let _b = cs_doc(&mut cs, &id, false, &z)
    let p = resume_pos(&cs)
    return ptext(&p)
