    let m = or_merge(&x, &y)
    return ",".join(or_elems(&m))
fn orm3(a: List[text], b: List[text], c: List[text], left: bool) -> text
    let x = orrun(a)
    let y = orrun(b)
    let z = orrun(c)
    let xy = or_merge(&x, &y)
    let yz = or_merge(&y, &z)
    let m = if left then or_merge(&xy, &z) else or_merge(&x, &yz)
    return ",".join(or_elems(&m))
fn lw(a: i64, ra: text, b: i64, rb: text) -> text
    let x = Lww(ts: a, replica: ra, value: "x")
