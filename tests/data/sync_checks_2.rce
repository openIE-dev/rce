        let f = amfields(&x)
        let it = sy_text(&f[0])
        let id = opid_parse(&it) catch OpId(ctr: -1, who: "")
        let ps = amids(&f[4])
        out.push(MapOp(id: id, key: sy_text(&f[1]), del: sy_text(&f[2]) == "del", value: copy(f[3]), pred: ps))
fn amfields(x: &events.Jv) -> List[events.Jv]
    match x
        events.JsArr(items: ys) -> return copy(ys)
        _ -> return []
fn amids(x: &events.Jv) -> List[OpId]
    var out: List[OpId] = []
