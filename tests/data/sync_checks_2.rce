fn jv(t: text) -> events.Jv
    return events.json_parse(&t) catch events.JsStr(t: "unparsable")
fn jpt(d: text, p: text, want: text) -> text
    let doc = jv(d)
    let pa = jv(p)
    let w = jv(want)
    let r = patch_apply(&doc, &pa) catch |e| events.JsStr(t: "error: " + e.why)
    return if json_eq(&r, &w) then "ok" else events.json_canon(&r)
fn jpe(d: text, p: text) -> text
    let doc = jv(d)
    let pa = jv(p)
    let r = patch_apply(&doc, &pa) catch |_e| events.JsStr(t: "error")
    return events.json_canon(&r)
fn dfl(a: text, b: text) -> text
    let x = jv(a)
    let y = jv(b)
    let ops = diff(&x, &y)
    let pa = events.JsArr(items: ops)
    let r = patch_apply(&x, &pa) catch |e| events.JsStr(t: "error: " + e.why)
    return if json_eq(&r, &y) then "ok" else events.json_canon(&r)
fn pp(p: text) -> text
    let ts = ptr_parse(&p) catch |_e| ["\u{0}"]
    if ts.len() == 1 and ts[0] == "\u{0}"
        return "error"
    var o: List[text] = []
    for t in ts
        let j = events.JsStr(t: copy(t))
        o.push(events.json_canon(&j))
    return "[" + ",".join(o) + "]"
fn amops(t: text) -> List[MapOp]
    let j = jv(t)
