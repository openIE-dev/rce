fn pnrun(xs: List[text]) -> PN
    var c = PN(p: [], n: [])
    for x in xs
        let f = x.split(",")
        let r = copy(f[0])
        let by = if f[1].startswith("-") then -(f[1].split("-")[1].toint()) else f[1].toint()
        c = pn_add(&c, &r, by)
    return c
fn pnm(a: List[text], b: List[text]) -> text
    let x = pnrun(a)
