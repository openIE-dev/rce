fn am(t: text) -> text
    let ops = amops(t)
    let m = map_state(&ops)
    return events.json_canon(&m)
fn amm(a: text, b: text) -> text
    let x = amops(a)
    let y = amops(b)
    let m = map_merge(&x, &y)
    let st = map_state(&m)
    return events.json_canon(&st)
