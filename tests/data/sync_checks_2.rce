fn rcfind(cs: &[Client], n: &text) -> usize
    for i in 0..cs.len()
        if cs[i].name == n
            return i
    return 0
fn rc(script: List[text]) -> text
    var srv = server_new()
    var cs: List[Client] = []
    for n in ["c1", "c2", "c3"]
        cs.push(client_new(&n))
    var _sent: List[Mut] = []
    for line in script
        let f = line.split("|")
        let i = rcfind(&cs, &f[1])
        if f[0] == "m"
            let a = jv(copy(f[4]))
            cs[i] = client_mutate(&cs[i], &f[2], &f[3], &a)
        elif f[0] == "push"
            let ms = copy(cs[i].pending)
            srv = push(&srv, &ms) catch |_e| copy(srv)
        elif f[0] == "pull"
            let pl = pull(&srv, &cs[i].base, &cs[i].name)
            cs[i] = client_pull(&cs[i], &pl) catch |_e| copy(cs[i])
        elif f[0] == "gap"
            let ms = copy(cs[i].pending)
            var late: List[Mut] = []
            for k in 1..ms.len()
                late.push(copy(ms[k]))
            let r = push(&srv, &late) catch |_e| Server(db: events.JsNull, lmids: [], log: [], version: -1)
            if r.version != -1 or ms.len() < 2
                return "gap accepted"
    let st = replay(&srv.log)
    var o = events.json_canon(&srv.db) + " " + (if json_eq(&st, &srv.db) then "replay=db" else "replay!=db")
    for c in cs
        let v = view(&c)
        o = o + " " + events.json_canon(&v) + "/" + c.pending.len().tostr()
    return o
