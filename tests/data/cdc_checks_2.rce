fn pgm(lsns: List[text], hexes: List[text]) -> List[PgMsg]
    var ms: List[PgMsg] = []
    for i in 0..lsns.len()
        ms.push(PgMsg(lsn: copy(lsns[i]), hex: copy(hexes[i])))
    return ms
fn pgl(lsns: List[text], hexes: List[text]) -> List[text]
    let ms = pgm(lsns, hexes)
    let cs = pg_decode(&ms) catch []
    return cs.map(fn(c: Change) => change_json(&c))
fn pgn(lsns: List[text], hexes: List[text]) -> i64
    let ms = pgm(lsns, hexes)
    let cs = pg_decode(&ms) catch []
    return cs.len() as i64
fn pgi(lsns: List[text], hexes: List[text], i: usize) -> text
    let ms = pgm(lsns, hexes)
    let cs = pg_decode(&ms) catch []
    if i >= cs.len()
        return "none"
    return change_json(&cs[i])
fn pgt(lsns: List[text], hexes: List[text]) -> List[text]
    let ms = pgm(lsns, hexes)
    return pg_txs(&ms) catch |e| [copy(e.why)]
