fn jv(t: text) -> events.Jv
    return events.json_parse(&t) catch events.JsStr(t: "unparsable")
fn jpt(d: text, p: text, want: text) -> text
    let doc = jv(d)
    let pa = jv(p)
    let w = jv(want)
    let r = patch_apply(&doc, &pa) catch |e| events.JsStr(t: "error: " + e.why)
    return if json_eq(&r, &w) then "ok" else events.json_canon(&r)
fn jpe(d: text, p: text) -> text
    let doc = jv(d)
    let pa = jv(p)
    let r = patch_apply(&doc, &pa) catch |_e| events.JsStr(t: "error")
    return events.json_canon(&r)
fn dfl(a: text, b: text) -> text
    let x = jv(a)
    let y = jv(b)
    let ops = diff(&x, &y)
    let pa = events.JsArr(items: ops)
    let r = patch_apply(&x, &pa) catch |e| events.JsStr(t: "error: " + e.why)
    return if json_eq(&r, &y) then "ok" else events.json_canon(&r)
fn pp(p: text) -> text
    let ts = ptr_parse(&p) catch |_e| ["\u{0}"]
    if ts.len() == 1 and ts[0] == "\u{0}"
        return "error"
    var o: List[text] = []
    for t in ts
        let j = events.JsStr(t: copy(t))
        o.push(events.json_canon(&j))
    return "[" + ",".join(o) + "]"
fn amops(t: text) -> List[MapOp]
    let j = jv(t)
    var out: List[MapOp] = []
    match j
        events.JsArr(items: xs) -> amops_add(xs, &mut out)
        _ -> mp_none()
    return out
fn amops_add(xs: &[events.Jv], out: &mut List[MapOp])
    for x in xs
        let f = amfields(&x)
        let it = sy_text(&f[0])
        let id = opid_parse(&it) catch OpId(ctr: -1, who: "")
        let ps = amids(&f[4])
        out.push(MapOp(id: id, key: sy_text(&f[1]), del: sy_text(&f[2]) == "del", value: copy(f[3]), pred: ps))
fn amfields(x: &events.Jv) -> List[events.Jv]
    match x
        events.JsArr(items: ys) -> return copy(ys)
        _ -> return []
fn amids(x: &events.Jv) -> List[OpId]
    var out: List[OpId] = []
    let ys = amfields(x)
    for y in ys
        let t = sy_text(&y)
        out.push(opid_parse(&t) catch OpId(ctr: -1, who: ""))
    return out
fn am(t: text) -> text
    let ops = amops(t)
    let m = map_state(&ops)
    return events.json_canon(&m)
fn amm(a: text, b: text) -> text
    let x = amops(a)
    let y = amops(b)
    let m = map_merge(&x, &y)
    let st = map_state(&m)
    return events.json_canon(&st)
fn amc(t: text, k: text) -> text
    let ops = amops(t)
    return ",".join(map_conflicts(&ops, &k))
fn pnrun(xs: List[text]) -> PN
    var c = PN(p: [], n: [])
    for x in xs
        let f = x.split(",")
        let r = copy(f[0])
        let by = if f[1].startswith("-") then -(f[1].split("-")[1].toint()) else f[1].toint()
        c = pn_add(&c, &r, by)
    return c
fn pnm(a: List[text], b: List[text]) -> text
    let x = pnrun(a)
    let y = pnrun(b)
    let m = pn_merge(&x, &y)
    return pn_text(&m) + " " + pn_value(&m).tostr()
fn pnm3(a: List[text], b: List[text], c: List[text], left: bool) -> text
    let x = pnrun(a)
    let y = pnrun(b)
    let z = pnrun(c)
    let xy = pn_merge(&x, &y)
    let yz = pn_merge(&y, &z)
    let m = if left then pn_merge(&xy, &z) else pn_merge(&x, &yz)
    return pn_text(&m) + " " + pn_value(&m).tostr()
fn orrun(xs: List[text]) -> OrSet
    var s = OrSet(adds: [], gone: [])
    for x in xs
        let f = x.split(",")
        if f[0] == "add"
            s = or_add(&s, &f[1], &f[2])
        else
            s = or_remove(&s, &f[1])
    return s
fn orm(a: List[text], b: List[text]) -> text
    let x = orrun(a)
    let y = orrun(b)
    let m = or_merge(&x, &y)
    return ",".join(or_elems(&m))
fn orm3(a: List[text], b: List[text], c: List[text], left: bool) -> text
    let x = orrun(a)
    let y = orrun(b)
    let z = orrun(c)
    let xy = or_merge(&x, &y)
    let yz = or_merge(&y, &z)
    let m = if left then or_merge(&xy, &z) else or_merge(&x, &yz)
    return ",".join(or_elems(&m))
fn lw(a: i64, ra: text, b: i64, rb: text) -> text
    let x = Lww(ts: a, replica: ra, value: "x")
    let y = Lww(ts: b, replica: rb, value: "y")
    let m = lww_merge(&x, &y)
    return m.value
fn rcfind(cs: &[Client], n: &text) -> usize
    for i in 0..cs.len()
        if cs[i].name == n
            return i
    return 0
fn rc(script: List[text]) -> text
    var srv = server_new()
    var cs: List[Client] = []
    for n in ["c1", "c2", "c3"]
        cs.push(client_new(&n))
    var _sent: List[Mut] = []
    for line in script
        let f = line.split("|")
        let i = rcfind(&cs, &f[1])
        if f[0] == "m"
            let a = jv(copy(f[4]))
            cs[i] = client_mutate(&cs[i], &f[2], &f[3], &a)
        elif f[0] == "push"
            let ms = copy(cs[i].pending)
            srv = push(&srv, &ms) catch |_e| copy(srv)
        elif f[0] == "pull"
            let pl = pull(&srv, &cs[i].base, &cs[i].name)
            cs[i] = client_pull(&cs[i], &pl) catch |_e| copy(cs[i])
        elif f[0] == "gap"
            let ms = copy(cs[i].pending)
            var late: List[Mut] = []
            for k in 1..ms.len()
                late.push(copy(ms[k]))
            let r = push(&srv, &late) catch |_e| Server(db: events.JsNull, lmids: [], log: [], version: -1)
            if r.version != -1 or ms.len() < 2
                return "gap accepted"
    let st = replay(&srv.log)
    var o = events.json_canon(&srv.db) + " " + (if json_eq(&st, &srv.db) then "replay=db" else "replay!=db")
    for c in cs
        let v = view(&c)
        o = o + " " + events.json_canon(&v) + "/" + c.pending.len().tostr()
    return o
fn items(t: text) -> List[events.Jv]
    let j = jv(t)
    return amfields(&j)
fn rchanges(t: text) -> List[RowChange]
    var out: List[RowChange] = []
    let xs = items(t)
    for x in xs
        let f = amfields(&x)
        out.push(RowChange(action: sy_text(&f[0]), old: copy(f[1]), new: copy(f[2])))
    return out
fn tbl(b: text, c: text) -> text
    let rs = items(b)
    let cs = rchanges(c)
    let t = table_apply(&rs, &cs) catch |e| [events.JsStr(t: e.why)]
    let j = events.JsArr(items: t)
    return events.json_canon(&j)
fn sbx(b: text, c: text, q: text) -> text
    let rs = items(b)
    let cs = rchanges(c)
    let t = table_apply(&rs, &cs) catch |e| [events.JsStr(t: e.why)]
    var conds: List[Cond] = []
    let qs = items(q)
    for x in qs
        let f = amfields(&x)
        conds.push(Cond(col: sy_text(&f[0]), op: sy_text(&f[1]), value: copy(f[2])))
    let u = sub_update(&rs, &t, &conds)
    let d = events.JsArr(items: copy(u.deletes))
    let i = events.JsArr(items: copy(u.inserts))
    return events.json_canon(&d) + " " + events.json_canon(&i)
fn nq(a: text, b: text) -> bool
    let x = jv(a)
    let y = jv(b)
    return json_eq(&x, &y)
fn mp(d: text, p: text) -> text
    let doc = jv(d)
    let pa = jv(p)
    let r = merge_patch(&doc, &pa)
    return events.json_canon(&r)
