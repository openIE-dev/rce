fn hdrs(hs: List[text]) -> List[Hdr]
    var o: List[Hdr] = []
    var i: usize = 0
    while i + 1 < hs.len() bound 4096
        o.push(Hdr(name: copy(hs[i]), value: copy(hs[i + 1])))
