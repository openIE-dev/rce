fn am(t: text) -> text
    let ops = amops(t)
    let m = map_state(&ops)
    return events.json_canon(&m)
fn amm(a: text, b: text) -> text
    let x = amops(a)
    let y = amops(b)
    let m = map_merge(&x, &y)
    let st = map_state(&m)
    return events.json_canon(&st)
fn amc(t: text, k: text) -> text
    let ops = amops(t)
    return ",".join(map_conflicts(&ops, &k))
fn pnrun(xs: List[text]) -> PN
    var c = PN(p: [], n: [])
    for x in xs
        let f = x.split(",")
        let r = copy(f[0])
        let by = if f[1].startswith("-") then -(f[1].split("-")[1].toint()) else f[1].toint()
        c = pn_add(&c, &r, by)
    return c
fn pnm(a: List[text], b: List[text]) -> text
    let x = pnrun(a)
    let y = pnrun(b)
    let m = pn_merge(&x, &y)
    return pn_text(&m) + " " + pn_value(&m).tostr()
fn pnm3(a: List[text], b: List[text], c: List[text], left: bool) -> text
    let x = pnrun(a)
    let y = pnrun(b)
    let z = pnrun(c)
    let xy = pn_merge(&x, &y)
    let yz = pn_merge(&y, &z)
    let m = if left then pn_merge(&xy, &z) else pn_merge(&x, &yz)
    return pn_text(&m) + " " + pn_value(&m).tostr()
fn orrun(xs: List[text]) -> OrSet
    var s = OrSet(adds: [], gone: [])
    for x in xs
        let f = x.split(",")
        if f[0] == "add"
            s = or_add(&s, &f[1], &f[2])
        else
            s = or_remove(&s, &f[1])
    return s
fn orm(a: List[text], b: List[text]) -> text
    let x = orrun(a)
    let y = orrun(b)
    let m = or_merge(&x, &y)
    return ",".join(or_elems(&m))
fn orm3(a: List[text], b: List[text], c: List[text], left: bool) -> text
    let x = orrun(a)
    let y = orrun(b)
    let z = orrun(c)
    let xy = or_merge(&x, &y)
    let yz = or_merge(&y, &z)
    let m = if left then or_merge(&xy, &z) else or_merge(&x, &yz)
    return ",".join(or_elems(&m))
fn lw(a: i64, ra: text, b: i64, rb: text) -> text
    let x = Lww(ts: a, replica: ra, value: "x")
    let y = Lww(ts: b, replica: rb, value: "y")
    let m = lww_merge(&x, &y)
    return m.value
fn rcfind(cs: &[Client], n: &text) -> usize
    for i in 0..cs.len()
        if cs[i].name == n
            return i
    return 0
fn rc(script: List[text]) -> text
    var srv = server_new()
    var cs: List[Client] = []
    for n in ["c1", "c2", "c3"]
        cs.push(client_new(&n))
    var _sent: List[Mut] = []
    for line in script
        let f = line.split("|")
        let i = rcfind(&cs, &f[1])
        if f[0] == "m"
            let a = jv(copy(f[4]))
            cs[i] = client_mutate(&cs[i], &f[2], &f[3], &a)
        elif f[0] == "push"
            let ms = copy(cs[i].pending)
            srv = push(&srv, &ms) catch |_e| copy(srv)
        elif f[0] == "pull"
            let pl = pull(&srv, &cs[i].base, &cs[i].name)
            cs[i] = client_pull(&cs[i], &pl) catch |_e| copy(cs[i])
        elif f[0] == "gap"
            let ms = copy(cs[i].pending)
            var late: List[Mut] = []
            for k in 1..ms.len()
                late.push(copy(ms[k]))
            let r = push(&srv, &late) catch |_e| Server(db: events.JsNull, lmids: [], log: [], version: -1)
            if r.version != -1 or ms.len() < 2
                return "gap accepted"
    let st = replay(&srv.log)
    var o = events.json_canon(&srv.db) + " " + (if json_eq(&st, &srv.db) then "replay=db" else "replay!=db")
    for c in cs
        let v = view(&c)
        o = o + " " + events.json_canon(&v) + "/" + c.pending.len().tostr()
    return o
fn items(t: text) -> List[events.Jv]
    let j = jv(t)
