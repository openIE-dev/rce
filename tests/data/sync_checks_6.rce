    for x in xs
        let f = amfields(&x)
        out.push(RowChange(action: sy_text(&f[0]), old: copy(f[1]), new: copy(f[2])))
    return out
fn tbl(b: text, c: text) -> text
    let rs = items(b)
    let cs = rchanges(c)
    let t = table_apply(&rs, &cs) catch |e| [events.JsStr(t: e.why)]
    let j = events.JsArr(items: t)
    return events.json_canon(&j)
fn sbx(b: text, c: text, q: text) -> text
    let rs = items(b)
    let cs = rchanges(c)
    let t = table_apply(&rs, &cs) catch |e| [events.JsStr(t: e.why)]
    var conds: List[Cond] = []
    let qs = items(q)
    for x in qs
        let f = amfields(&x)
        conds.push(Cond(col: sy_text(&f[0]), op: sy_text(&f[1]), value: copy(f[2])))
    let u = sub_update(&rs, &t, &conds)
    let d = events.JsArr(items: copy(u.deletes))
    let i = events.JsArr(items: copy(u.inserts))
    return events.json_canon(&d) + " " + events.json_canon(&i)
fn nq(a: text, b: text) -> bool
    let x = jv(a)
    let y = jv(b)
    return json_eq(&x, &y)
