        events.JsArr(items: xs) -> amops_add(xs, &mut out)
        _ -> mp_none()
    return out
fn amops_add(xs: &[events.Jv], out: &mut List[MapOp])
    for x in xs
        let f = amfields(&x)
        let it = sy_text(&f[0])
        let id = opid_parse(&it) catch OpId(ctr: -1, who: "")
        let ps = amids(&f[4])
        out.push(MapOp(id: id, key: sy_text(&f[1]), del: sy_text(&f[2]) == "del", value: copy(f[3]), pred: ps))
fn amfields(x: &events.Jv) -> List[events.Jv]
    match x
        events.JsArr(items: ys) -> return copy(ys)
        _ -> return []
fn amids(x: &events.Jv) -> List[OpId]
    var out: List[OpId] = []
    let ys = amfields(x)
    for y in ys
        let t = sy_text(&y)
        out.push(opid_parse(&t) catch OpId(ctr: -1, who: ""))
