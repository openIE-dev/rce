# Host checks for lib/energy/energy.rce: each event does one Ed25519
# operation (about 30M fuel, more than a module's comptime budget), so
# scripts/check.sh runs them with `rce host run` on one flattened file
# (scripts/flatten.py), one event per input line so each gets its own
# fuel, and requires the final state good = 6, bad = 0. Envelopes are from
# scripts/gen/energy_gen.py (cryptography Ed25519, RFC 8032 test seeds).
# It is run appended to the module and tests/energy/energy_checks.rce
# (for sample and hexb).
# events: Seal0, Verify0, Verify4, Substituted, WrongSigner, SealWrongSeed

state H
    good: i64 = 0
    bad: i64 = 0

event Seal0
event Verify0
event Verify4
event Substituted
event WrongSigner
event SealWrongSeed

# ---- generated by scripts/gen/energy_gen.py host
step H on Seal0
    let r = sample(0)
    let e = seal_receipt(&r, "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb") catch []
    if e == hexb("")
        good += 1
    else
        bad += 1
step H on Verify0
    let e = hexb("")
    if verify(&e)
        good += 1
    else
        bad += 1
step H on Verify4
    let e = hexb("")
    if verify(&e)
        good += 1
    else
        bad += 1
# payload substitution (C23): same signature over a different payload_hash
step H on Substituted
    let e = hexb("")
    if not verify(&e)
        good += 1
    else
        bad += 1
# wrong steward (C5): signed by the RFC 8032 test 1 key, steward is test 2
step H on WrongSigner
    let e = hexb("")
    if not verify(&e)
        good += 1
    else
        bad += 1
step H on SealWrongSeed
    let r = sample(0)
    if (seal_receipt(&r, "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60") catch [7]) == [7]
        good += 1
    else
        bad += 1
