{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "rce",
      "camelcase": "Rce",
      "title": "RCE",
      "scope": "source.rce",
      "file-types": ["rce"],
      "injection-regex": "^rce$",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "RCE grammar for tree-sitter",
    "authors": [{ "name": "The RCE contributors" }],
    "links": {
      "repository": "https://github.com/openIE-dev/rce/tree/main/tree-sitter"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false
  }
}
