# Helpers of the generated col.seq checks (scripts/gen/seq_gen.py writes
# them in front of every shard). Each t_ function runs one function of
# col.seq on literal input and compares with the CPython 3.13 result. The
# key functions and comparators match the Python ones in seq_gen.py.
# Nested lists are written flat with their lengths (t_nest), because a
# list literal whose elements are list literals of different lengths does
# not type check in this checker.

fn t_nest[T](flat: List[T], lens: List[usize]) -> List[List[T]]
    var o: List[List[T]] = []
    var i: usize = 0
    for m in lens
        var cur: List[T] = []
        for _j in 0..m
            cur.push(copy(flat[i]))
            i += 1
        o.push(cur)
    return o

fn t_groups[K, T](keys: List[K], flat: List[T], lens: List[usize]) -> List[(K, List[T])]
    let g = t_nest(flat, lens)
    var o: List[(K, List[T])] = []
    var i: usize = 0
    for k in keys
        o.push((copy(k), copy(g[i])))
        i += 1
    return o

fn t_pairs[A, B](a: List[A], b: List[B]) -> List[(A, B)]
    var o: List[(A, B)] = []
    var i: usize = 0
    for x in a
        o.push((copy(x), copy(b[i])))
        i += 1
    return o

# Python: abs(x) % 5, abs(x) // 4, len(s), (abs(x) % 3, -x), p[0]
fn t_k0(x: &i64) -> i64 = x.abs() % 5
fn t_k1(x: &i64) -> i64 = x.abs() / 4
fn t_k2(s: &text) -> usize = s.len_chars()
fn t_k3(x: &i64) -> (i64, i64) = (x.abs() % 3, 0 - x)
fn t_kp(p: &(i64, i64)) -> i64 = p.0

# Python cmp_to_key comparators: by abs(x); descending; text by length
# then descending code points.
fn t_c0(a: &i64, b: &i64) -> i64 = if a.abs() < b.abs() then -1 else (if b.abs() < a.abs() then 1 else 0)
fn t_c1(a: &i64, b: &i64) -> i64 = if a < b then 1 else (if b < a then -1 else 0)
fn t_c2(a: &text, b: &text) -> i64
    let la = a.len_chars()
    let lb = b.len_chars()
    if la != lb
        return if la < lb then -1 else 1
    if a == b
        return 0
    return if b < a then -1 else 1

# Python: abs(x) % 3 == 0; a + b; max(a, b); 2 * acc + x
fn t_p0(x: &i64) -> bool = x.abs() % 3 == 0
fn t_add(a: &i64, b: &i64) -> i64 = a + b
fn t_max(a: &i64, b: &i64) -> i64 = if a < b then b + 0 else a + 0
fn t_lin(acc: &i64, x: &i64) -> i64 = 2 * acc + x

# ---- sorting
fn t_sorted(xs: List[i64], asc: List[i64], desc: List[i64]) -> bool = seq_sorted(&xs) == asc and seq_sorted_desc(&xs) == desc and seq_is_sorted(&asc)
fn t_sorted_t(xs: List[text], asc: List[text], desc: List[text]) -> bool = seq_sorted(&xs) == asc and seq_sorted_desc(&xs) == desc
fn t_arg(xs: List[i64], a: List[usize], k0: List[usize], k0d: List[usize], c0: List[usize]) -> bool
    return seq_argsort(&xs) == a and seq_argsort_by_key(&xs, t_k0) == k0 and seq_argsort_by_key_desc(&xs, t_k0) == k0d and seq_argsort_with(&xs, t_c0) == c0
fn t_sbk(xs: List[i64], k0: List[i64], k0d: List[i64], k1: List[i64], k3: List[i64], k3d: List[i64]) -> bool
    return seq_sort_by_key(&xs, t_k0) == k0 and seq_sort_by_key_desc(&xs, t_k0) == k0d and seq_sort_by_key(&xs, t_k1) == k1 and seq_sort_by_key(&xs, t_k3) == k3 and seq_sort_by_key_desc(&xs, t_k3) == k3d
fn t_sbk_t(xs: List[text], k2: List[text], k2d: List[text]) -> bool = seq_sort_by_key(&xs, t_k2) == k2 and seq_sort_by_key_desc(&xs, t_k2) == k2d
fn t_sw(xs: List[i64], c0: List[i64], c1: List[i64]) -> bool = seq_sort_with(&xs, t_c0) == c0 and seq_sort_with(&xs, t_c1) == c1
fn t_sw_t(xs: List[text], c2: List[text]) -> bool = seq_sort_with(&xs, t_c2) == c2
fn t_gather(xs: List[i64], idx: List[usize], want: List[i64]) -> bool = (seq_gather(&xs, &idx) catch [0 - 999]) == want
fn t_try_gather(xs: &[i64], idx: &[usize]) -> usize ! SeqBadIndex
    let _r = try seq_gather(xs, idx)
    return SQ_MAXU
fn t_gather_bad(xs: List[i64], idx: List[usize], at: usize) -> bool = (t_try_gather(&xs, &idx) catch |e| e.index) == at
fn t_issorted(xs: List[i64], plain: bool, k0: bool) -> bool = seq_is_sorted(&xs) == plain and seq_is_sorted_by_key(&xs, t_k0) == k0
fn t_nth(xs: List[i64], n: usize, want: i64?, wk0: i64?) -> bool = seq_nth(&xs, n) == want and seq_nth_by_key(&xs, n, t_k0) == wk0
fn t_top(xs: List[i64], k: usize, small: List[i64], large: List[i64], sk0: List[i64], lk0: List[i64]) -> bool
    return seq_nsmallest(&xs, k) == small and seq_nlargest(&xs, k) == large and seq_nsmallest_by_key(&xs, k, t_k0) == sk0 and seq_nlargest_by_key(&xs, k, t_k0) == lk0
fn t_top_t(xs: List[text], k: usize, small: List[text], large: List[text], sk2: List[text], lk2: List[text]) -> bool
    return seq_nsmallest(&xs, k) == small and seq_nlargest(&xs, k) == large and seq_nsmallest_by_key(&xs, k, t_k2) == sk2 and seq_nlargest_by_key(&xs, k, t_k2) == lk2

# ---- searching
fn t_bis(xs: List[i64], x: i64, l: usize, r: usize) -> bool = seq_bisect_left(&xs, &x) == l and seq_bisect_right(&xs, &x) == r
fn t_bis_t(xs: List[text], x: text, l: usize, r: usize) -> bool = seq_bisect_left(&xs, &x) == l and seq_bisect_right(&xs, &x) == r
fn t_bis_in(xs: List[i64], x: i64, lo: usize, hi: usize, l: usize, r: usize) -> bool = seq_bisect_left_in(&xs, &x, lo, hi) == l and seq_bisect_right_in(&xs, &x, lo, hi) == r
fn t_bisk(xs: List[i64], k: i64, l: usize, r: usize) -> bool = seq_bisect_left_by_key(&xs, &k, t_k1) == l and seq_bisect_right_by_key(&xs, &k, t_k1) == r
fn t_bs(xs: List[i64], x: i64, want: usize?) -> bool = seq_bsearch(&xs, &x) == want
fn t_ins(xs: List[i64], x: i64, want: List[i64]) -> bool
    var a = copy(xs)
    var b = copy(xs)
    seq_insort_left(&mut a, x)
    seq_insort_right(&mut b, x)
    return a == want and b == want
fn t_insk(xs: List[(i64, i64)], x: (i64, i64), wl: List[(i64, i64)], wr: List[(i64, i64)]) -> bool
    var a = copy(xs)
    var b = copy(xs)
    seq_insort_left_by_key(&mut a, copy(x), t_kp)
    seq_insort_right_by_key(&mut b, x, t_kp)
    return a == wl and b == wr
fn t_merge(a: List[i64], b: List[i64], want: List[i64]) -> bool = (seq_merge(&a, &b) catch [0 - 999]) == want
fn t_merge_all(flat: List[i64], lens: List[usize], want: List[i64], wk0: List[i64]) -> bool
    let ls = t_nest(flat, lens)
    return (seq_merge_all(&ls) catch [0 - 999]) == want and (seq_merge_all_by_key(&ls, t_k0) catch [0 - 999]) == wk0

# ---- grouping and transformation
fn t_runs(xs: List[i64], keys: List[i64], flat: List[i64], lens: List[usize]) -> bool = seq_group_runs(&xs, t_k0) == t_groups(keys, flat, lens)
fn t_gby(xs: List[i64], keys: List[i64], flat: List[i64], lens: List[usize]) -> bool = seq_group_by(&xs, t_k0) == t_groups(keys, flat, lens)
fn t_gby_t(xs: List[text], keys: List[usize], flat: List[text], lens: List[usize]) -> bool = seq_group_runs(&xs, t_k2).len() >= keys.len() and seq_group_by(&xs, t_k2) == t_groups(keys, flat, lens)
fn t_chunks(xs: List[i64], n: usize, flat: List[i64], lens: List[usize]) -> bool = (seq_chunks(&xs, n) catch []) == t_nest(flat, lens)
fn t_windows(xs: List[i64], n: usize, flat: List[i64], lens: List[usize]) -> bool = (seq_windows(&xs, n) catch []) == t_nest(flat, lens)
fn t_try_sizes(xs: &[i64], n: usize) -> bool ! SeqBadSize
    let _a = try seq_chunks(xs, n)
    let _b = try seq_windows(xs, n)
    return true
fn t_size_bad(xs: List[i64], n: usize) -> bool = not (t_try_sizes(&xs, n) catch false)
fn t_pairwise(xs: List[i64], a: List[i64], b: List[i64]) -> bool = seq_pairwise(&xs) == t_pairs(a, b)
fn t_zip(a: List[i64], b: List[text], wa: List[i64], wb: List[text]) -> bool = seq_zip(&a, &b) == t_pairs(wa, wb)
fn t_zipl(a: List[i64], b: List[text], wa: List[i64], wb: List[text]) -> bool
    let fa: i64 = 0 - 1
    let fb = "-"
    return seq_zip_longest(&a, &b, &fa, &fb) == t_pairs(wa, wb)
fn t_try_zipx(a: &[i64], b: &[text]) -> usize ! SeqLenMismatch
    let z = try seq_zip_exact(a, b)
    return z.len()
fn t_zipx(a: List[i64], b: List[text], ok: bool) -> bool
    let n = t_try_zipx(&a, &b) catch |e| e.a + e.b + 1000000
    return if ok then n == a.len() else n == a.len() + b.len() + 1000000
fn t_unzip(ps: List[(i64, text)], a: List[i64], b: List[text]) -> bool
    let u = seq_unzip(&ps)
    return u.0 == a and u.1 == b and seq_zip(&a, &b) == ps
fn t_enum(xs: List[text], idx: List[usize]) -> bool = seq_enumerate(&xs) == t_pairs(idx, xs)
fn t_flatten(flat: List[i64], lens: List[usize]) -> bool
    let ls = t_nest(copy(flat), lens)
    return (seq_flatten(&ls) catch [0 - 999]) == flat
fn t_dedupe(xs: List[i64], want: List[i64], wk0: List[i64], runs: List[i64]) -> bool
    return seq_dedupe(&xs) == want and seq_dedupe_by_key(&xs, t_k0) == wk0 and seq_dedupe_runs(&xs) == runs
fn t_dedupe_t(xs: List[text], want: List[text], wk2: List[text], runs: List[text]) -> bool
    return seq_dedupe(&xs) == want and seq_dedupe_by_key(&xs, t_k2) == wk2 and seq_dedupe_runs(&xs) == runs
fn t_counter(xs: List[i64], keys: List[i64], cnts: List[usize], n: usize, mk: List[i64], mc: List[usize]) -> bool
    return seq_counter(&xs) == t_pairs(keys, cnts) and seq_most_common(&xs, n) == t_pairs(mk, mc)
fn t_counter_t(xs: List[text], keys: List[text], cnts: List[usize], n: usize, mk: List[text], mc: List[usize]) -> bool
    return seq_counter(&xs) == t_pairs(keys, cnts) and seq_most_common(&xs, n) == t_pairs(mk, mc)
fn t_partition(xs: List[i64], yes: List[i64], no: List[i64]) -> bool
    let p = seq_partition(&xs, t_p0)
    return p.0 == yes and p.1 == no
fn t_acc(xs: List[i64], sums: List[i64], maxes: List[i64]) -> bool = seq_accumulate(&xs, t_add) == sums and seq_accumulate(&xs, t_max) == maxes
fn t_scan(xs: List[i64], init: i64, want: List[i64]) -> bool = seq_scan(&xs, init, t_lin) == want
fn t_product(a: List[i64], b: List[text], wa: List[i64], wb: List[text]) -> bool = (seq_product(&a, &b) catch []) == t_pairs(wa, wb)
fn t_prod_all(flat: List[i64], lens: List[usize], limit: usize, wf: List[i64], wl: List[usize]) -> bool
    let ls = t_nest(flat, lens)
    return (seq_product_all(&ls, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
fn t_perm(xs: List[i64], r: usize, limit: usize, wf: List[i64], wl: List[usize]) -> bool = (seq_permutations(&xs, r, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
fn t_comb(xs: List[i64], r: usize, limit: usize, wf: List[i64], wl: List[usize]) -> bool = (seq_combinations(&xs, r, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
fn t_comb_rep(xs: List[i64], r: usize, limit: usize, wf: List[i64], wl: List[usize]) -> bool = (seq_combinations_rep(&xs, r, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
# A refusal (SeqTooLarge) is compared as the sentinel [[-999]]; no input
# holds -999.
fn t_cur_mk(mode: i64, n: usize, r: usize) -> SeqCursor
    let z: List[usize] = [0]
    if mode == 1
        return seq_cursor_permutations(n, r) catch seq_cursor_product(&z)
    if mode == 2
        return seq_cursor_combinations(n, r) catch seq_cursor_product(&z)
    return seq_cursor_combinations_rep(n, r) catch seq_cursor_product(&z)
fn t_cursor(mode: i64, n: usize, r: usize, wf: List[usize], wl: List[usize]) -> bool
    var c = t_cur_mk(mode, n, r)
    var o: List[List[usize]] = []
    var go = true
    while go bound 100000
        let t = seq_cursor_next(&mut c)
        match t
            some(idx) -> o.push(copy(idx))
            none -> go = false
    let tail = seq_cursor_next(&mut c)
    return o == t_nest(wf, wl) and seq_cursor_done(&c) and tail == none
fn t_cycle(xs: List[i64], start: usize, n: usize, want: List[i64]) -> bool = (seq_cycle(&xs, start, n) catch [0 - 999]) == want
fn t_interleave(flat: List[i64], lens: List[usize], want: List[i64]) -> bool
    let ls = t_nest(flat, lens)
    return (seq_interleave(&ls) catch [0 - 999]) == want

# ---- chunked state: xs is fed in parts of the lengths in cuts
fn t_counts_feed(xs: List[i64], cuts: List[usize], keys: List[i64], cnts: List[usize], n: usize, mk: List[i64], mc: List[usize], probe: i64, pc: usize) -> bool
    let parts = t_nest(xs, cuts)
    var c: SeqCounts[i64] = seq_counts_new()
    var ok = true
    for p in parts
        let d = seq_counts_feed(&mut c, &p) catch 0
        ok = ok and d == seq_counts_len(&c)
    return ok and seq_counts_len(&c) == keys.len() and seq_counts_list(&c) == t_pairs(keys, cnts) and seq_counts_most_common(&c, n) == t_pairs(mk, mc) and seq_counts_get(&c, &probe) == pc
fn t_seen_feed(xs: List[i64], cuts: List[usize], want: List[i64]) -> bool
    let parts = t_nest(xs, cuts)
    var s: SeqSeen[i64] = seq_seen_new()
    var o: List[i64] = []
    for p in parts
        let got = seq_seen_feed(&mut s, &p) catch [0 - 999]
        for g in got
            o.push(g)
    return o == want and seq_seen_len(&s) == want.len()
fn t_top_feed(xs: List[i64], cuts: List[usize], k: usize, small: List[i64], large: List[i64], sk0: List[i64], lk0: List[i64]) -> bool
    let parts = t_nest(xs, cuts)
    var a: SeqTop[i64] = t_top_mk(k, false)
    var b: SeqTop[i64] = t_top_mk(k, true)
    var c: SeqTop[i64] = t_top_mk(k, false)
    var d: SeqTop[i64] = t_top_mk(k, true)
    for p in parts
        seq_top_feed(&mut a, &p)
        seq_top_feed(&mut b, &p)
        seq_top_feed_by_key(&mut c, &p, t_k0)
        seq_top_feed_by_key(&mut d, &p, t_k0)
    return seq_top_list(&a) == small and seq_top_list(&b) == large and seq_top_list(&c) == sk0 and seq_top_list(&d) == lk0
fn t_win_feed(xs: List[i64], cuts: List[usize], n: usize, flat: List[i64], lens: List[usize]) -> bool
    let parts = t_nest(xs, cuts)
    var w: SeqWin[i64] = t_win_mk(n)
    var o: List[List[i64]] = []
    for p in parts
        let got = seq_win_feed(&mut w, &p)
        for g in got
            o.push(copy(g))
    return o == t_nest(flat, lens)
fn t_batch_feed(xs: List[i64], cuts: List[usize], n: usize, flat: List[i64], lens: List[usize]) -> bool
    let parts = t_nest(xs, cuts)
    var b: SeqBatch[i64] = t_batch_mk(n)
    var o: List[List[i64]] = []
    for p in parts
        let got = seq_batch_feed(&mut b, &p)
        for g in got
            o.push(copy(g))
    let last = seq_batch_end(&mut b)
    if last.len() > 0
        o.push(last)
    return o == t_nest(flat, lens)
fn t_runs_feed(xs: List[i64], cuts: List[usize], keys: List[i64], flat: List[i64], lens: List[usize]) -> bool
    let parts = t_nest(xs, cuts)
    var st: SeqRuns[i64, i64] = seq_runs_new()
    var o: List[(i64, List[i64])] = []
    for p in parts
        let got = seq_runs_feed(&mut st, &p, t_k0) catch []
        for g in got
            o.push(copy(g))
    let last = seq_runs_end(&mut st)
    for g in last
        o.push(copy(g))
    return o == t_groups(keys, flat, lens)
fn t_top0[T]() -> SeqTop[T] = SeqTop(k: 0, largest: false, items: [], pos: [], seen: 0)
fn t_win0[T]() -> SeqWin[T] = SeqWin(n: 1, buf: [])
fn t_batch0[T]() -> SeqBatch[T] = SeqBatch(n: 1, buf: [])
fn t_top_mk(k: usize, largest: bool) -> SeqTop[i64] = seq_top_new(k, largest) catch t_top0()
fn t_win_mk(n: usize) -> SeqWin[i64] = seq_win_new(n) catch t_win0()
fn t_batch_mk(n: usize) -> SeqBatch[i64] = seq_batch_new(n) catch t_batch0()
