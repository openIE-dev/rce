fn dk(code: i64, arg: i64, mods: i64, act: i64, locks: i64) -> DomKey
    let k = Key(code: code, arg: arg, mods: mods, act: act, locks: locks)
    return dom_key(&k)
fn dkey(code: i64, arg: i64) -> text = dk(code, arg, 0, PRESS, 0).key
# every non-character key maps to a named UI Events key value
fn all_named() -> bool
    var c: i64 = 1
    while c <= 27
        if c != K_CHAR and c != K_FN and c != K_MEDIA and c != K_MODIFIER
            if not is_named_key(dkey(c, 0))
                return false
        c += 1
    var i: i64 = 0
    while i < 13
        if not is_named_key(dkey(K_MEDIA, i))
            return false
        i += 1
    i = 0
    while i < 14
        if not is_named_key(dkey(K_MODIFIER, i))
            return false
        i += 1
    i = 1
    while i <= 35
        if not is_named_key(dkey(K_FN, i))
            return false
        i += 1
    return true
check all_named()
check dkey(K_UP, 0) == "ArrowUp"
check dkey(K_ESC, 0) == "Escape"
check dkey(K_MENU, 0) == "ContextMenu"
check dkey(K_KEYPADBEGIN, 0) == "Clear"
check dkey(K_BACKTAB, 0) == "Tab"
check dkey(K_NULL, 0) == "Unidentified"
check dkey(K_FN, 13) == "F13"
check dkey(K_CHAR, 97) == "a"
check dkey(K_CHAR, 233) == "é"
check dkey(K_CHAR, 128512) == "😀"
check dkey(K_MEDIA, 10) == "AudioVolumeDown"
check dkey(K_MODIFIER, 12) == "AltGraph"
check dkey(K_MODIFIER, 13) == "Unidentified"
check dk(K_MODIFIER, 7, 2, PRESS, 0).location == LOC_RIGHT
check dk(K_MODIFIER, 1, 2, PRESS, 0).key == "Control"
check dk(K_MODIFIER, 1, 2, PRESS, 0).location == LOC_LEFT
check dk(K_CHAR, 49, 0, PRESS, S_KEYPAD).location == LOC_NUMPAD
check dk(K_CHAR, 97, M_CONTROL | M_ALT, RELEASE, 0).up
check dk(K_CHAR, 97, M_CONTROL | M_ALT, RELEASE, 0).ctrl
check dk(K_CHAR, 97, M_CONTROL | M_ALT, RELEASE, 0).alt
check not dk(K_CHAR, 97, M_CONTROL | M_ALT, RELEASE, 0).shift
check dk(K_CHAR, 97, M_SUPER, REPEAT, 0).meta and dk(K_CHAR, 97, M_SUPER, REPEAT, 0).repeat
check dk(K_CHAR, 97, M_META, PRESS, S_CAPS_LOCK | S_NUM_LOCK).meta
check dk(K_CHAR, 97, 0, PRESS, S_CAPS_LOCK).caps and not dk(K_CHAR, 97, 0, PRESS, S_CAPS_LOCK).num
check dk(K_CHAR, 97, M_HYPER, PRESS, S_NUM_LOCK).num and not dk(K_CHAR, 97, M_HYPER, PRESS, 0).meta
check dk(K_CHAR, 65, M_SHIFT, PRESS, 0).shift
# key strings and the implicit function key names
check is_key_value("a") and is_key_value("é") and is_key_value("ab")
check not is_key_value("") and not is_key_value("\n") and not is_key_value("a\u{85}")
check not is_named_key("F0") and not is_named_key("F01") and not is_named_key("F") and not is_named_key("Soft0")
check not is_named_key("f1") and not is_named_key("F1x") and is_named_key("F99")
check not is_code("KeyÄ") and not is_code("Escape ") and not is_code("Soft1") and is_code("F99")
check not code_required("F13") and code_required("KeyA") and not key_required("Soft1")
# pointer: terminal mouse to PointerEvent with a pressed-button bitmask
fn ms(act: i64, button: i64) -> Mouse = Mouse(act: act, button: button, col: 3, row: 4, mods: 0)
fn seq() -> List[i64]
    var st = PointerState(buttons: 0)
    var o: List[i64] = []
    let evs = [ms(MS_DOWN, B_LEFT), ms(MS_DRAG, B_LEFT), ms(MS_DOWN, B_RIGHT), ms(MS_UP, B_LEFT), ms(MS_MOVED, 0), ms(MS_UP, B_RIGHT), ms(MS_SCROLL_UP, 0), ms(MS_DRAG, B_MIDDLE)]
    for m in evs
        let p = dom_pointer(&mut st, &m)
        o.push(p.act)
        o.push(p.button)
        o.push(p.buttons)
    return o
check seq() == [1, 0, 1, 3, -1, 1, 1, 2, 3, 2, 0, 2, 3, -1, 2, 2, 2, 0, 0, -1, 0, 3, -1, 4]
fn pm(mods: i64) -> Pointer
    var st = PointerState(buttons: 0)
    let m = Mouse(act: MS_DOWN, button: B_MIDDLE, col: 9, row: 8, mods: mods)
    return dom_pointer(&mut st, &m)
check pm(M_SHIFT | M_CONTROL).shift and pm(M_SHIFT | M_CONTROL).ctrl and not pm(M_SHIFT | M_CONTROL).alt
check pm(M_ALT).alt and pm(M_ALT).x == 9 and pm(M_ALT).y == 8 and pm(M_ALT).button == PB_AUX and pm(M_ALT).buttons == 4
check pm(0).ptype == "mouse" and pm(0).primary and pm(0).id == 1
fn wh(act: i64) -> List[i64]
    let m = ms(act, 0)
    let w = dom_wheel(&m)
    return [w.dx, w.dy, w.mode, w.x, w.y]
check wh(MS_SCROLL_UP) == [0, -1, 1, 3, 4]
check wh(MS_SCROLL_DOWN) == [0, 1, 1, 3, 4]
check wh(MS_SCROLL_LEFT) == [-1, 0, 1, 3, 4]
check wh(MS_SCROLL_RIGHT) == [1, 0, 1, 3, 4]
check wh(MS_DOWN) == [0, 0, -1, 3, 4]
check buttons_bit(6) == 0
# composition order
check ime_step(0, IME_START) == 1 and ime_step(1, IME_UPDATE) == 1 and ime_step(1, IME_END) == 0
check ime_step(0, IME_UPDATE) == -1 and ime_step(0, IME_END) == -1 and ime_step(1, IME_START) == -1
# is_upper is char::is_uppercase (Unicode 17.0)
check is_upper(65) and is_upper(90) and not is_upper(97) and not is_upper(64) and not is_upper(91)
check is_upper(192) and not is_upper(215) and is_upper(8544) and not is_upper(8560) and is_upper(127280)
# streams keep an incomplete sequence pending, and a later read finishes it
fn two() -> text
    let a: List[i64] = [27, 91, 49]
    let b: List[i64] = [59, 53, 65, 120]
    let none_yet: List[i64] = []
    let d1 = advance(&none_yet, &a, false, false)
    let d2 = advance(&d1.pending, &b, false, false)
    var o = d1.events.len().tostr() + ":"
    for e in d2.events
        o = o + ev_text(&e) + ";"
    return o
check two() == "0:key Up 2 p 0;key c120 0 p 0;"
# a lone ESC waits while more input is available
check per([27], true, false) == "none" and per([27], false, false) == "key Esc 0 p 0"
check per([10], false, true) == "key c106 2 p 0" and per([10], false, false) == "key Enter 0 p 0"
# confirmed with scripts/ref/input_ref ("one" mode): a byte above 126
# does not end a CSI sequence; Rust's integer parse takes a leading "+"
check per([27, 91, 50, 49, 200], false, false) == "none" and per([27, 91, 49, 255], false, false) == "none"
check per([27, 91, 53, 59, 43, 51, 126], false, false) == "key PageUp 4 p 0"
check per([27, 91, 57, 55, 59, 43, 50, 117], false, false) == "key c97 1 p 0"
check per([27, 91, 60, 43, 48, 59, 43, 49, 59, 43, 49, 77], false, false) == "mouse Down(Left) 0 0 0"
check per([27, 91, 60, 48, 59, 43, 59, 49, 77], false, false) == "err"
check per([27, 91, 43, 53, 126], false, false) == "err"
check per([27, 91, 53, 55, 52, 49, 52, 117], false, false) == "key Enter 0 p 1"
check per([27, 91, 57, 55, 58, 49, 49, 49, 52, 49, 49, 50, 59, 50, 117], false, false) == "key c97 1 p 0"
check per([27, 91, 57, 55, 58, 53, 53, 50, 57, 54, 59, 50, 117], false, false) == "key c97 1 p 0"
check per([27, 91, 60, 48, 59, 49, 59, 49, 59, 255, 77], false, false) == "err"
# more_after: a read ending in ESC waits when the host says more input is ready
fn esc_more() -> List[i64]
    let none_yet: List[i64] = []
    let a: List[i64] = [27]
    let d = advance(&none_yet, &a, true, false)
    return [d.events.len() as i64, d.pending.len() as i64]
check esc_more() == [0, 1]
