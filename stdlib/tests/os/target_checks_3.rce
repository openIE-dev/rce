# Generated by scripts/gen/target_gen.py; do not edit.
fn opshow(o: &Op) -> text
    if o.opk == "run"
        return "run:" + ",".join(o.args) + "|" + ",".join(o.env) + "|" + o.root
    if o.opk == "wait"
        return "wait:" + o.exit_code.tostr()
    if o.opk == "read" or o.opk == "write"
        return o.opk + ":" + o.id + ":" + o.payload
    if o.opk == "kill"
        return "kill:" + o.signal
    return copy(o.opk)
fn pp(t: text) -> text
    let p = plan_parse(&t) catch |e| Plan(ops: [], proposals: [], world: "!" + e.why, legacy: false)
    if p.world.startswith("!")
        return copy(p.world)
    var o: List[text] = []
    for x in p.ops
        o.push(opshow(&x))
    return ";".join(o) + "#" + p.world + "#" + ",".join(p.proposals)
fn vd(t: text, so: text, se: text, ec: i64, tmo: bool) -> text
    let p = plan_parse(&t) catch Plan(ops: [], proposals: [], world: "!", legacy: false)
    let ob = Observed(stdout: so, stderr: se, exit_code: ec, timed_out: tmo)
    return verdict(&p, &ob)
fn oc(ex: bool, ef: bool, fl: bool) -> text = outcome(ex, ef, fl)
fn of(ex: bool, ef: bool, fl: bool) -> bool
    let o = outcome(ex, ef, fl)
    return is_failure(&o)
fn bk(c: text, t: text) -> text = binding(&c, &t)
fn bc(t: text) -> text = ",".join(bound_caps(&t))
check pp("{\"env\": {\"X_1\": \"a\"}}") == "run:|X_1=a|;wait:0#wasi:cli/command#"
check pp("{\"world\": \"wasi:cli/command\"}") == "run:||;wait:0#wasi:cli/command#"
check pp("{\"operations\": [{\"type\": \"wait\", \"exit_code\": 255}, {\"type\": \"kill\", \"signal\": \"SIGSTKFLT\"}], \"world\": \"wasi:http/service\"}") == "wait:255;kill:SIGSTKFLT#wasi:http/service#"
check pp("{\"root\": \"dir\", \"stdout\": \"\", \"stderr\": \"a\"}") == "run:||dir;read:stdout:;read:stderr:a;wait:0#wasi:cli/command#"
check pp("{\"operations\": [{\"type\": \"run\", \"args\": [\"\\u00fc\", \"\\u00e9\\n\"]}], \"proposals\": []}") == "run:ü,é\n||#wasi:cli/command#"
check pp("{\"operations\": [{\"type\": \"read\", \"id\": \"stdin\"}, {\"type\": \"Run\"}]}") == "!Unsupported operation type Run"
