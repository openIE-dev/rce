# derived checks (hand-written; appended by scripts/gen/perm_gen.py)
fn cred(u: i64, g: i64, gs: List[i64]) -> Cred = Cred(uid: u, gid: g, groups: gs)
fn mayc(c: Cred, m: i64, o: i64, g: i64, w: i64) -> bool = may(&c, m, o, g, w)
check mayc(cred(1, 1, []), 448, 1, 9, R_OK | W_OK | X_OK)
check not mayc(cred(1, 1, []), 63, 1, 1, R_OK)
check mayc(cred(2, 9, []), 32, 1, 9, R_OK)
check not mayc(cred(2, 9, []), 36, 1, 9, W_OK)
check mayc(cred(2, 5, [7, 9]), 56, 1, 9, R_OK | W_OK | X_OK)
check not mayc(cred(2, 5, [7, 9]), 7, 1, 9, R_OK)
check mayc(cred(3, 3, []), 4, 1, 9, R_OK)
check not mayc(cred(3, 3, []), 4, 1, 9, R_OK | X_OK)
check mayc(cred(3, 3, []), 0, 1, 9, 0)
fn sp(t: text) -> text
    let s = sid_parse(&t) catch Sid(authority: -1, subs: [])
    return sid_text(&s)
fn sb(t: text) -> List[i64]
    let s = sid_parse(&t) catch Sid(authority: -1, subs: [])
    return sid_bytes(&s)
fn sfb(b: List[i64]) -> text
    let s = sid_from_bytes(&b) catch Sid(authority: -1, subs: [])
    return sid_text(&s)
check sp("S-1-1-0") == "S-1-1-0"
check sp("S-1-5-18") == "S-1-5-18"
