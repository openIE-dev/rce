fn ac(has: bool, d: List[Ace], t: List[text], w: i64) -> bool = access_check(has, &d, &t, w)
const TOK: List[text] = ["S-1-1-0", "S-1-5-32-545", "S-1-5-21-1-2-3-1001"]
check ac(false, [], TOK, 983551)
check not ac(true, [], TOK, 1)
check ac(true, [Ace(allow: true, sid: "S-1-1-0", mask: 3)], TOK, 3)
check not ac(true, [Ace(allow: true, sid: "S-1-1-0", mask: 1)], TOK, 3)
check ac(true, [Ace(allow: true, sid: "S-1-1-0", mask: 1), Ace(allow: true, sid: "S-1-5-32-545", mask: 2)], TOK, 3)
check not ac(true, [Ace(allow: false, sid: "S-1-5-21-1-2-3-1001", mask: 2), Ace(allow: true, sid: "S-1-1-0", mask: 3)], TOK, 3)
check ac(true, [Ace(allow: true, sid: "S-1-1-0", mask: 3), Ace(allow: false, sid: "S-1-5-21-1-2-3-1001", mask: 2)], TOK, 3)
check ac(true, [Ace(allow: false, sid: "S-1-5-21-1-2-3-1001", mask: 4), Ace(allow: true, sid: "S-1-1-0", mask: 3)], TOK, 3)
check not ac(true, [Ace(allow: true, sid: "S-1-5-18", mask: 3)], TOK, 1)
check not ac(true, [Ace(allow: false, sid: "S-1-5-18", mask: 1), Ace(allow: true, sid: "S-1-5-32-545", mask: 1), Ace(allow: false, sid: "S-1-1-0", mask: 2)], TOK, 3)
check ac(true, [Ace(allow: true, sid: "S-1-1-0", mask: 1)], TOK, 0)
check ll_fs_rights(0) == 0 and ll_fs_rights(1) == 8191 and ll_fs_rights(2) == 16383 and ll_fs_rights(3) == 32767 and ll_fs_rights(4) == 32767 and ll_fs_rights(5) == 65535 and ll_fs_rights(6) == 65535
check ll_net_rights(3) == 0 and ll_net_rights(4) == 3 and ll_scopes(5) == 0 and ll_scopes(6) == 3
fn lla(ls: List[Layer], p: List[text], w: i64) -> bool = ll_allowed(&ls, &p, w)
const L1: Layer = Layer(handled: 15, rules: [Rule(path: ["usr"], rights: 13), Rule(path: ["tmp"], rights: 15)])
const L2: Layer = Layer(handled: 2, rules: [Rule(path: ["tmp", "a"], rights: 2)])
check lla([L1], ["usr", "bin", "ls"], LL_READ_FILE | LL_EXECUTE)
check not lla([L1], ["usr", "bin", "ls"], LL_WRITE_FILE)
check lla([L1], ["usr", "bin", "ls"], LL_MAKE_REG)
check not lla([L1], ["etc", "passwd"], LL_READ_FILE)
check lla([L1], ["tmp", "x"], LL_WRITE_FILE)
check not lla([L1, L2], ["tmp", "x"], LL_WRITE_FILE)
check lla([L1, L2], ["tmp", "a", "f"], LL_WRITE_FILE)
check not lla([L1, L2], ["tmp"], LL_WRITE_FILE)
check lla([], ["anything"], 65535)
check not lla([L1], ["us"], LL_READ_FILE)
check lla([L1], ["usr"], LL_READ_DIR)
fn gl(m: text) -> i64 = grant_ll(&m)
fn gm(m: text) -> i64 = grant_mode(&m)
check gl("r") == 12 and gl("x") == 1 and gl("w") == 29106 and gl("rwx") == 29119 and gl("") == 0
check gm("rwx") == 448 and gm("r") == 256 and gm("wx") == 192
check ll_grant(29119) == "rwx" and ll_grant(12) == "r" and ll_grant(8) == "" and ll_grant(65535) == "rwx" and ll_grant(29106) == "w"
check octal(2541) == "4755" and octal(8) == "0010" and octal(33188) == "0644"
# a deny ACE only blocks bits not already granted by an earlier allow (MS-DTYP 2.5.3.2)
check ac(true, [Ace(allow: true, sid: "S-1-1-0", mask: 1), Ace(allow: false, sid: "S-1-1-0", mask: 1), Ace(allow: true, sid: "S-1-1-0", mask: 2)], TOK, 3)
