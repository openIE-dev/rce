    return lock_text(&l) == t
fn lk_sum(t: text) -> text
    let l = lk(copy(t))
    var o: List[text] = [l.version.tostr()]
    for p in l.packages
        o.push(p.name + "|" + p.version + "|" + p.source + "|" + p.checksum + "|" + ",".join(p.deps))
    return ";".join(o)
fn lk_err(t: text) -> text
