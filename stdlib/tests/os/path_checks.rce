check wasi_s("./a//b/") == ["a", "b"]
check wasi_s("a/../b") == ["b"]
check wasi_s("") == []
check wasi_s(".") == []
check wasi_s("a/..") == []
check wasi_s("..") == ["ERR"]
check wasi_s("a/../..") == ["ERR"]
check wasi_s("/etc/passwd") == ["ERR"]
check wasi_s("a/./../b/../../c") == ["ERR"]
check wasi_s("x/y/../../z") == ["z"]
check pre_s(["/", "/tmp", "/tmp/x"], "/tmp/x/y") == Preopen(index: 2, rel: "y")
check pre_s(["/", "/tmp"], "/tmp") == Preopen(index: 1, rel: ".")
check pre_s(["/data"], "/etc") == Preopen(index: -1, rel: "ERR")
check pre_s(["/a/b", "/a"], "/a/b/../c") == Preopen(index: 1, rel: "c")
check pre_s(["/a", "/a"], "/a/z") == Preopen(index: 1, rel: "z")
check pre_s(["/"], "//x/./y") == Preopen(index: 0, rel: "x/y")
check pre_s(["rel"], "/rel/x") == Preopen(index: -1, rel: "ERR")
check pre_s(["/"], "x") == Preopen(index: -1, rel: "ERR")
