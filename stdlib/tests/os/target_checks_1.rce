check pp("{\"env\": {\"A\": \"0\"}, \"stdout\": \"0\", \"stderr\": \"é\\n\"}") == "run:|A=0|;read:stdout:0;read:stderr:é\n;wait:0#wasi:cli/command#"
check pp("{\"operations\": [{\"type\": \"kill\", \"signal\": \"SIGIOT\"}, {\"type\": \"kill\", \"signal\": \"SIGXFSZ\"}, {\"type\": \"run\"}]}") == "kill:SIGABRT;kill:SIGXFSZ;run:||#wasi:cli/command#"
check pp("{\"args\": [\"hello\", \"hello\"], \"exit_code\": 255, \"stdout\": \"x y\", \"operations\": []}") == "!Cannot mix configuration styles"
check pp("{\"operations\": [{\"type\": \"nope\"}, {\"type\": \"run\"}, {\"type\": \"run\", \"args\": [\"é\\n\", \"--flag\"]}, {\"type\": \"read\", \"id\": \"stdin\", \"payload\": \"a\"}], \"proposals\": [\"sockets\", \"http\"], \"stdout\": \"x\"}") == "!Cannot mix configuration styles"
check pp("{\"debug\": true}") == "run:||;wait:0#wasi:cli/command#"
check pp("{\"args\": [\"x y\", \"\\n\"], \"env\": {}, \"exit_code\": 0}") == "run:x y,\n||;wait:0#wasi:cli/command#"
check pp("{\"args\": [\"fs-tests.dir\", \"fs-tests.dir\", \"hello\"], \"stdout\": \"--flag\", \"stderr\": \"fs-tests.dir\"}") == "run:fs-tests.dir,fs-tests.dir,hello||;read:stdout:--flag;read:stderr:fs-tests.dir;wait:0#wasi:cli/command#"
check pp("{}") == "run:||;wait:0#wasi:cli/command#"
check pp("{\"operations\": [{\"type\": \"read\", \"id\": \"stdout\", \"payload\": \"\\n\"}], \"world\": \"wasi:http/service\"}") == "read:stdout:\n#wasi:http/service#"
check pp("{\"args\": [], \"root\": \"fs-tests.dir\", \"exit_code\": 42, \"stderr\": \"\\n\"}") == "run:||fs-tests.dir;read:stderr:\n;wait:42#wasi:cli/command#"
check pp("{\"args\": [], \"exit_code\": 0}") == "run:||;wait:0#wasi:cli/command#"
check pp("{\"operations\": [{\"type\": \"run\", \"env\": {\"A\": \"--flag\"}}, {}]}") == "!Unsupported operation type None"
check pp("{\"args\": [\"0\", \"a\", \"0\"], \"exit_code\": 0}") == "run:0,a,0||;wait:0#wasi:cli/command#"
check pp("{\"args\": [\"\\n\", \"é\\n\", \"\"], \"stdout\": \"\\n\"}") == "run:\n,é\n,||;read:stdout:\n;wait:0#wasi:cli/command#"
check pp("{\"exit_code\": 42, \"stdout\": \"\\n\"}") == "run:||;read:stdout:\n;wait:42#wasi:cli/command#"
check pp("{\"operations\": [], \"stdout\": \"x\"}") == "!Cannot mix configuration styles"
check pp("{\"args\": [\"fs-tests.dir\"], \"exit_code\": 0, \"stderr\": \"\\n\"}") == "run:fs-tests.dir||;read:stderr:\n;wait:0#wasi:cli/command#"
check pp("{\"args\": [\"fs-tests.dir\", \"\\n\", \"\\n\"], \"env\": {\"PATH\": \"hello\"}}") == "run:fs-tests.dir,\n,\n|PATH=hello|;wait:0#wasi:cli/command#"
check pp("{\"args\": [\"hello\", \"fs-tests.dir\", \"0\"], \"stdout\": \"ü\"}") == "run:hello,fs-tests.dir,0||;read:stdout:ü;wait:0#wasi:cli/command#"
check pp("{\"exit_code\": -1, \"stdout\": \"--flag\"}") == "run:||;read:stdout:--flag;wait:-1#wasi:cli/command#"
check pp("{\"operations\": [], \"world\": \"wasi:cli/run\"}") == "!Unknown WASI world: wasi:cli/run"
check pp("{\"args\": [], \"env\": {}, \"stdout\": \"ü\", \"stderr\": \"ü\"}") == "run:||;read:stdout:ü;read:stderr:ü;wait:0#wasi:cli/command#"
check pp("{\"args\": [\"\\n\", \"--flag\"]}") == "run:\n,--flag||;wait:0#wasi:cli/command#"
check pp("{\"world\": \"wasi:http/service\"}") == "run:||;wait:0#wasi:cli/command#"
