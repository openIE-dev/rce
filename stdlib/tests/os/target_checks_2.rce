check pp("{\"args\": [\"hello\"], \"exit_code\": 42, \"stderr\": \"hello\"}") == "run:hello||;read:stderr:hello;wait:42#wasi:cli/command#"
check pp("{\"operations\": [{\"type\": \"nope\"}, {\"type\": \"Run\"}, {\"type\": \"nope\"}, {\"type\": \"write\", \"id\": \"stdin\", \"payload\": \"hello\"}], \"proposals\": [], \"world\": \"wasi:http/service\"}") == "!Unsupported operation type nope"
check pp("{\"operations\": [{\"type\": \"wait\", \"exit_code\": 0}, {\"type\": \"wait\"}, {\"type\": \"run\", \"args\": []}]}") == "wait:0;wait:0;run:||#wasi:cli/command#"
check pp("{\"args\": [\"fs-tests.dir\", \"--flag\", \"fs-tests.dir\"], \"env\": {\"B\": \"\"}, \"exit_code\": 255}") == "run:fs-tests.dir,--flag,fs-tests.dir|B=|;wait:255#wasi:cli/command#"
check pp("{\"operations\": []}") == "#wasi:cli/command#"
check pp("{\"operations\": [{\"type\": \"kill\", \"signal\": \"SIGALRM\"}], \"debug\": true}") == "kill:SIGALRM#wasi:cli/command#"
check pp("{\"args\": [\"x y\", \"--flag\", \"\"], \"env\": {\"B\": \"fs-tests.dir\"}, \"stderr\": \"hello\"}") == "run:x y,--flag,|B=fs-tests.dir|;read:stderr:hello;wait:0#wasi:cli/command#"
check pp("{\"operations\": [{\"type\": \"run\"}], \"proposals\": [\"sockets\", \"threads\"], \"world\": \"wasi:http/service\"}") == "!'threads' is not a valid WasiProposal"
check pp("{\"operations\": [{}, {\"type\": \"nope\"}, {\"type\": \"wait\", \"exit_code\": 0}]}") == "!Unsupported operation type None"
check pp("{\"operations\": [{\"type\": \"read\", \"id\": \"stdin\"}, {\"type\": \"nope\"}, {\"type\": \"read\", \"payload\": \"\\u00fc\"}]}") == "!Unsupported operation type nope"
check pp("{\"args\": [], \"root\": \"fs-tests.dir\", \"stderr\": \"--flag\"}") == "run:||fs-tests.dir;read:stderr:--flag;wait:0#wasi:cli/command#"
check pp("{\"args\": [\"\\n\", \"x y\", \"--flag\"], \"env\": {}, \"exit_code\": 0}") == "run:\n,x y,--flag||;wait:0#wasi:cli/command#"
check pp("{\"args\": [\"\", \"ü\", \"é\\n\"], \"exit_code\": 1, \"stdout\": \"ü\", \"operations\": []}") == "!Cannot mix configuration styles"
