    var i: usize = 1
    while i < cs.len() bound 16777216
        o = o + cs[i]
        i += 1
    return o
fn vp(t: text) -> text
    let v = version_parse(&t) catch |e| Version(major: "!", minor: e.why, patch: "", pre: "", build: "")
