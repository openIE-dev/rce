check rp(">3.1.0,>ÿ=10.0.01") == "err unexpected character 'ÿ' while parsing major version number"
check rp("<3.1") == "ok <3.1"
check rp("> 0.2.X-pre, ~2.1.0") == "err expected comma after patch version number, found '-'"
check rp(">10.3.3") == "ok >10.3.3"
check rp(">=1.*,10.*.*") == "ok >=1, 10.*"
