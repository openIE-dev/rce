# ---- 1.4.13 hover_focus_content
fn tip(shown: bool) -> text = "div\n.b#b|tabindex=0|focused=true" + (if shown then "\n.t#tip|role=tooltip|popup=hover\n..~Hint" else "")
check tfx("hover_focus_content", [sp("start", 0, tip(true)), sp("hover tip", 16, tip(true)), sp("tick", 16, tip(true)), sp("key Escape", 16, tip(false))]) == ""
check tfx("hover_focus_content", [sp("start", 0, tip(true)), sp("hover tip", 16, tip(true)), sp("key Escape", 16, tip(true))]) == "fails@2"
check tfx("hover_focus_content", [sp("start", 0, tip(true)), sp("hover tip", 16, tip(true)), sp("tick", 16, tip(false))]) == "fails@-1,undecided@-1"
check tfx("hover_focus_content", [sp("start", 0, tip(true))]) == "undecided@-1,undecided@-1"

# ---- 2.2.1 timing_adjustable
fn tl(left: i64, warn: bool) -> text = "div|time-limit-ms=60000|time-extend-action=extend|time-left-ms=" + left.tostr() + (if warn then "\n.w|time-warning=true" else "")
check tfx("timing_adjustable", [sp("start", 0, tl(60000, false)), sp("tick", 40000, tl(20000, true)), sp("tick", 20000, tl(0, true))]) == ""
check tfx("timing_adjustable", [sp("start", 0, tl(60000, false)), sp("tick", 50000, tl(10000, true))]) == "fails@0"
check tfx("timing_adjustable", [sp("start", 0, tl(60000, false)), sp("tick", 60000, tl(0, false))]) == "fails@0"
check tfx("timing_adjustable", [sp("start", 0, tl(60000, false))]) == "undecided@0"
check tfx("timing_adjustable", [sp("start", 0, "div|time-limit-ms=60000")]) == "fails@0"
check tfx("timing_adjustable", [sp("start", 0, "div|time-limit-ms=60000|time-off-action=off")]) == ""
check tfx("timing_adjustable", [sp("start", 0, "div|time-limit-ms=60000|time-adjust-action=adjust|time-adjust-max-ms=600000")]) == ""
check tfx("timing_adjustable", [sp("start", 0, "div|context=a"), sp("tick", 16, "div|context=b")]) == "fails@0"

# ---- 2.2.2 pause_stop_hide
fn clk(t: text, pa: bool) -> text = "div\n.c#clock" + (if pa then "|pause-action=pause-clock" else "") + "\n..~" + t + "\n.p#pb|role=button|action=pause-clock|tabindex=0\n..~Pause"
check tfx("pause_stop_hide", [sp("start", 0, clk("10:00", true)), sp("tick", 1000, clk("10:01", true)), sp("activate pb", 16, clk("10:01", true)), sp("tick", 1000, clk("10:01", true))]) == ""
check tfx("pause_stop_hide", [sp("start", 0, clk("10:00", false)), sp("tick", 1000, clk("10:01", false))]) == "fails@1"
check tfx("pause_stop_hide", [sp("start", 0, clk("10:00", true)), sp("tick", 1000, clk("10:01", true)), sp("activate pb", 16, clk("10:01", true)), sp("tick", 1000, clk("10:02", true))]) == "fails@1"
check tfx("pause_stop_hide", [sp("start", 0, clk("10:00", true)), sp("tick", 1000, clk("10:01", true))]) == "undecided@-1"
check tfx("pause_stop_hide", [sp("start", 0, "div\n.m|moving=true|duration-ms=8000")]) == "fails@1"
check tfx("pause_stop_hide", [sp("start", 0, "div\n.m|moving=true|duration-ms=3000")]) == ""

# ---- 2.3.1 three_flashes
fn flash(a: text, b: text, ms: i64, n: i64, sizes: text) -> List[Step]
    var t: List[Step] = []
    for i in 0..n
        let c = if i % 2 == 0 then copy(a) else copy(b)
        t.push(sp(if i == 0 then "start" else "tick", if i == 0 then 0 else ms, "div\n.f#f|bg=" + c + sizes))
    return t
check tfx("three_flashes", flash("#000000", "#ffffff", 100, 10, "|w=400|h=400")) == "fails@-1"
check tfx("three_flashes", flash("#000000", "#ffffff", 100, 10, "|w=100|h=100")) == ""
check tfx("three_flashes", flash("#000000", "#ffffff", 100, 10, "|w=1000|h=30")) == ""
check tfx("three_flashes", flash("#000000", "#ffffff", 100, 10, "|w=1000|h=80")) == "fails@-1"
check tfx("three_flashes", flash("#000000", "#ffffff", 100, 10, "")) == "undecided@-1"
check tfx("three_flashes", flash("#000000", "#ffffff", 300, 10, "|w=400|h=400")) == ""
check tfx("three_flashes", flash("#ff0000", "#cc0000", 100, 10, "|w=400|h=400")) == "undecided@-1"
check tfx("three_flashes", flash("#202020", "#303030", 100, 10, "|w=400|h=400")) == ""

# ---- 3.2.1 on_focus
fn fov(c: text, f: text) -> text = "div|context=" + c + "\n.a#a|tabindex=0" + (if f == "a" then "|focused=true" else "") + "\n.b#b|tabindex=0" + (if f == "b" then "|focused=true" else "")
check tfx("on_focus", [sp("start", 0, fov("x", "")), sp("focus a", 16, fov("x", "a")), sp("focus b", 16, fov("x", "b"))]) == ""
check tfx("on_focus", [sp("start", 0, fov("x", "")), sp("focus a", 16, fov("x", "a")), sp("focus b", 16, fov("y", "b"))]) == "fails@0"
check tfx("on_focus", [sp("start", 0, fov("x", "")), sp("focus a", 16, fov("x", "a")), sp("focus b", 16, fov("x", "a"))]) == "fails@1"
check tfx("on_focus", [sp("start", 0, fov("x", "")), sp("focus a", 16, fov("x", "a"))]) == "undecided@-1"
check tfx("on_focus", [sp("start", 0, "div\n.x|tabindex=0")]) == "undecided@1"

# ---- 3.2.2 on_input
fn inp(c: text, val: text) -> text = "div|context=" + c + "\n.i#q|role=textbox|aria-label=Search|tabindex=0|focused=true" + (if val != "" then "|value=" + val else "")
check tfx("on_input", [sp("start", 0, inp("x", "")), sp("input q", 16, inp("x", "door"))]) == ""
check tfx("on_input", [sp("start", 0, inp("x", "")), sp("input q", 16, inp("y", "door"))]) == "fails@0"
check tfx("on_input", [sp("start", 0, inp("x", ""))]) == "undecided@-1"

# ---- 3.2.3 consistent_navigation, 3.2.4 consistent_identification, 3.2.6 consistent_help
fn nav(c: text, a: text, b: text) -> text = "div|context=" + c + "\n.n|role=navigation\n..a|role=link|action=go-" + a + "\n...~" + a + "\n..b|role=link|action=go-" + b + "\n...~" + b
check tfx("consistent_navigation", [sp("start", 0, nav("p1", "Home", "About")), sp("navigate", 16, nav("p2", "Home", "About"))]) == ""
check tfx("consistent_navigation", [sp("start", 0, nav("p1", "Home", "About")), sp("navigate", 16, nav("p2", "About", "Home"))]) == "fails@-1"
fn srch(c: text, lb: text) -> text = "div|context=" + c + "\n.b|role=button|action=search\n..~" + lb
check tfx("consistent_identification", [sp("start", 0, srch("p1", "Search")), sp("navigate", 16, srch("p2", "Search"))]) == ""
check tfx("consistent_identification", [sp("start", 0, srch("p1", "Search")), sp("navigate", 16, srch("p2", "Find"))]) == "fails@1"
fn hlp(c: text, a: text, b: text) -> text = "div|context=" + c + "\n.x|help=" + a + "\n.y|help=" + b
check tfx("consistent_help", [sp("start", 0, hlp("p1", "contact", "faq")), sp("navigate", 16, hlp("p2", "contact", "faq"))]) == ""
check tfx("consistent_help", [sp("start", 0, hlp("p1", "contact", "faq")), sp("navigate", 16, hlp("p2", "faq", "contact"))]) == "fails@-1"

# ---- 3.3.7 redundant_entry
fn em(c: text, extra: text) -> text = "div|context=" + c + "\n.i#e" + c + "|role=textbox|aria-label=Email" + extra
check tfx("redundant_entry", [sp("start", 0, em("a", "|entry=email|value=a@b.c")), sp("navigate", 16, em("b", "|entry=email|value=a@b.c"))]) == ""
check tfx("redundant_entry", [sp("start", 0, em("a", "|entry=email|value=a@b.c")), sp("navigate", 16, em("b", "|entry=email"))]) == "fails@1"
check tfx("redundant_entry", [sp("start", 0, em("a", "|entry=email|value=a@b.c")), sp("navigate", 16, em("b", ""))]) == "undecided@1"

# ---- 4.1.3 status_messages
check tfx("status_messages", [sp("start", 0, "div\n.s#s|role=status\n..~Saved 0"), sp("activate x", 16, "div\n.s#s|role=status\n..~Saved 1")]) == ""
check tfx("status_messages", [sp("start", 0, "div\n.s|status-msg=true\n..~Saved")]) == "fails@1"
check tfx("status_messages", [sp("start", 0, "div\n.p#p\n..~Count 0"), sp("tick", 16, "div\n.p#p\n..~Count 1")]) == "undecided@2"
check tfx("status_messages", [sp("start", 0, "div\n.p#p|status-msg=false\n..~Count 0"), sp("tick", 16, "div\n.p#p|status-msg=false\n..~Count 1")]) == ""

# ---- verdicts: a door panel that reaches full WCAG 2.2 AA through exact
# rules and attestations, and what each missing piece does
fn att(ids: text) -> text
    var o = ""
    for i in ids.words()
        o = o + "|attest-" + i + "=A. Reviewer;2026-10-31"
    return o
fn door(focus: bool, extra: text) -> text = "div|lang=en|title=Door|context=door|fg=#000000|bg=#ffffff|font-px=16" + extra + "\n.m|role=main\n..h|role=heading|aria-level=1\n...~Door\n..b#open|role=button|action=open|tabindex=0|w=44|h=44|border=#000000|focus-outline=#005fcc" + (if focus then "|focused=true" else "") + "\n...~Open"
fn door_attest() -> text = att("1.3.1 1.3.2 1.3.3 1.4.1 1.4.4 1.4.10 1.4.11 1.4.12 2.4.2 2.4.5 2.4.6 3.1.1 3.1.2 3.3.4")
fn door_trace(extra: text) -> List[Step] = [sp("start", 0, door(false, copy(extra))), sp("focus open", 16, door(true, copy(extra)))]
fn outcomes(t: List[Step], k: text) -> i64
    var n: i64 = 0
    for x in report(&t)
        if x.outcome == k
            n += 1
    return n
check um(door_trace(door_attest())).len() == 0
check outcomes(door_trace(door_attest()), "attested") == 14
check outcomes(door_trace(door_attest()), "meets") + outcomes(door_trace(door_attest()), "not applicable") == 41
check vd("2.1.1", door_trace(door_attest())) == "meets"
check vd("1.2.2", door_trace(door_attest())) == "not applicable"
check vd("2.4.6", door_trace(door_attest())) == "attested"
# one attestation missing: that criterion is undecided, nothing else changes
check um(door_trace(att("1.3.1 1.3.2 1.3.3 1.4.1 1.4.4 1.4.10 1.4.11 1.4.12 2.4.2 2.4.5 3.1.1 3.1.2 3.3.4"))).len() == 1
check umt(door_trace(att("1.3.1 1.3.2 1.3.3 1.4.1 1.4.4 1.4.10 1.4.11 1.4.12 2.4.2 2.4.5 3.1.1 3.1.2 3.3.4"))) == "2.4.6 undecided: needs human attestation: whether headings and labels describe topic or purpose"
# a malformed attestation is undecided
check vd("2.4.6", door_trace(door_attest() + "|attest-2.4.6=nobody")) == "undecided"
# one view alone: the button is never focused, so 3.2.1 is undecided
check vd("3.2.1", [sp("start", 0, door(false, door_attest()))]) == "undecided"
# an attestation never covers an exact failure
check vd("2.4.2", door_trace(door_attest() + "|title=")) == "fails"
# an exception claimed on a node needs an attestation
check vdv("1.4.3", "div|fg=#cccccc|bg=#ffffff\n.p|exempt=1.4.3\n..~Logo") == "undecided"
check vdv("1.4.3", "div|fg=#cccccc|bg=#ffffff|attest-1.4.3=A. Reviewer;2026-10-31\n.p\n..~Logo") == "fails"
check vdv("1.4.3", "div|fg=#cccccc|bg=#ffffff\n.~Logo") == "fails"
check vdv("1.2.1", "div") == "not applicable"
check vdv("2.4.5", "div") == "undecided"

# two flashing nodes whose parts in one field sum past the threshold: undecided without positions
fn flash2(n: i64) -> List[Step]
    var t: List[Step] = []
    for i in 0..n
        let c = if i % 2 == 0 then "#000000" else "#ffffff"
        t.push(sp(if i == 0 then "start" else "tick", if i == 0 then 0 else 100, "div\n.f#f|w=341|h=40|bg=" + c + "\n.g#g|w=341|h=40|bg=" + c))
    return t
check tfx("three_flashes", flash2(10)) == "undecided@-1"
