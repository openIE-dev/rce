# Fixtures for ui.rules: for every rule a view (or trace) that meets it and
# one that fails it, written in a small notation. tv(s) builds a view from
# lines: the first is the root, each further line starts with one dot per
# level below the root, then either "~TEXT" (a text node) or
# "TAG#KEY|NAME=VALUE|..." (an element; "#KEY" and the attributes are
# optional). fx(rule, s) lists the findings of one rule as
# "OUTCOME@NODE", comma-separated ("" when there are none).
fn rest(cs: &[text], start: usize) -> text
    var r = ""
    for j in start..cs.len()
        r = r + cs[j]
    return r

fn tv(s: text) -> View
    let ls = s.split("\n")
    var v = view.view_new("div", "")
    var stack: List[i64] = [0]
    for i in 0..ls.len()
        let cs = ls[i].chars()
        var d: usize = 0
        while d < cs.len() and cs[d] == "." bound 64
            d += 1
        let body = rest(&cs, d)
        var n: i64 = 0
        if i > 0 and body.startswith("~")
            let bc = body.chars()
            let _ = view.add_text(&mut v, stack[d - 1], rest(&bc, 1))
        else
            let parts = body.split("|")
            let tk = parts[0].split("#")
            if i == 0
                v = view.view_new(copy(tk[0]), if tk.len() > 1 then copy(tk[1]) else "")
            else
                n = view.add_el(&mut v, stack[d - 1], copy(tk[0]), if tk.len() > 1 then copy(tk[1]) else "")
            for j in 1..parts.len()
                let kv = parts[j].split("=")
                var val = copy(kv[1])
                for x in 2..kv.len()
                    val = val + "=" + kv[x]
                view.set_attr(&mut v, n, copy(kv[0]), val)
            while stack.len() > d bound 64
                let _ = stack.pop()
            stack.push(n)
    return v

fn shw(fs: &[Finding]) -> text
    var o: List[text] = []
    for f in fs
        o.push(f.outcome + "@" + f.at.tostr())
    return ",".join(o)

fn fx(rule: text, s: text) -> text
    let v = tv(s)
    let fs = view_findings(&rule, &v)
    return shw(&fs)

fn sp(ev: text, ms: i64, s: text) -> Step = Step(ev: ev, ms: ms, v: tv(s))

fn tfx(rule: text, t: List[Step]) -> text
    let fs = rule_findings(&rule, &t)
    return shw(&fs)

fn vd(sc: text, t: List[Step]) -> text
    for x in report(&t)
        if x.sc == sc
            return x.outcome
    return "?"

fn vdv(sc: text, s: text) -> text = vd(sc, [sp("start", 0, s)])

fn hr(s: text) -> bool = has_rule(&s)
fn sz(s: text) -> i64
    let v = tv(s)
    return view.size(&v)
fn avt(s: text, n: i64, name: text) -> text
    let v = tv(s)
    return av(&v, n, name)
fn tof(s: text) -> text
    let v = tv(s)
    return text_of(&v, 0)
fn nmof(s: text, n: i64) -> text
    let v = tv(s)
    return name_of(&v, n)
fn ford(s: text) -> List[i64]
    let v = tv(s)
    return focus_order(&v)
fn iok(s: text) -> bool = int_ok(&s)
fn lok(s: text) -> bool = lang_ok(&s)
fn und(s: text) -> i64
    let st0 = sp("start", 0, s)
    let x = frame_of(&st0)
    return undersized(&x)
fn um(t: List[Step]) -> List[Verdict] = unmet(&t)
fn umt(t: List[Step]) -> text
    let u = unmet(&t)
    return verdict_text(&u[0])

# ---- the table: every A and AA criterion once, one class each, every
# E, L and P row names a rule of this module, every rule is used once
fn table_ok() -> bool
    let cs = criteria()
    var ids: List[text] = []
    var used: List[text] = []
    for c in cs
        if ids.contains(c.id)
            return false
        ids.push(copy(c.id))
        if not (c.level == "A" or c.level == "AA")
            return false
        if c.class == "H"
            if c.rule != "-" or c.human == ""
                return false
        elif c.class == "E" or c.class == "L" or c.class == "P"
            if not has_rule(&c.rule) or used.contains(c.rule)
                return false
            used.push(copy(c.rule))
            if c.class == "P" and c.human == ""
                return false
        else
            return false
    return used.len() == rule_names().len()

fn class_count(k: text) -> i64
    var n: i64 = 0
    for c in criteria()
        if c.class == k
            n += 1
    return n

fn class_ids(k: text) -> text
    var o: List[text] = []
    for c in criteria()
        if c.class == k
            o.push(copy(c.id))
    return " ".join(o)

check criteria().len() == 55
check table_ok() == true
check class_count("E") == 16
check class_count("L") == 10
check class_count("P") == 22
check class_count("H") == 7
check class_ids("L") == "1.4.13 2.2.1 2.2.2 3.2.1 3.2.2 3.2.3 3.2.4 3.2.6 3.3.7 4.1.3"
check class_ids("H") == "1.3.2 1.3.3 1.4.1 1.4.5 2.4.5 2.4.6 3.3.3"
check hr("no_such_rule") == false

