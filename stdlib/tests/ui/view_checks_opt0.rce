# generated by scripts/gen/view_gen.py; do not edit
# test helpers for ui.view (prepended to every tests/ui/view_checks*.rce)
# A list "1,2,s:x" is a <div> whose children are tokens as in
# scripts/ref/view_ref/vue_ref.js: "N" a keyed <span>, "t#N" a keyed <t>
# (key and label N), "t:x" an unkeyed <t> labelled x, "~x" a text node x,
# "!" a comment (an unkeyed "!" element, what Vue renders for null).
# Elements hold their label as attribute l and as a text child.
fn lv(s: text) -> View
    var v = view_new("div", "")
    if s == ""
        return v
    for t in s.split(",")
        var n: i64 = -1
        var l = copy(t)
        if t == "!"
            n = add_el(&mut v, 0, "!", "")
        elif t.startswith("~")
            let p = t.split("~")
            let _ = add_text(&mut v, 0, copy(p[1]))
        else
            let p = t.split(":")
            let q = t.split("#")
            if p.len() == 2
                n = add_el(&mut v, 0, copy(p[0]), "")
                l = copy(p[1])
            elif q.len() == 2
                n = add_el(&mut v, 0, copy(q[0]), copy(q[1]))
                l = copy(q[1])
            else
                n = add_el(&mut v, 0, "span", copy(t))
        if n >= 0 and t != "!"
            set_attr(&mut v, n, "l", copy(l))
            let _ = add_text(&mut v, n, l)
    return v
fn lab(a: &View, b: &View, n: i64) -> text
    if n < 0
        return "-"
    let off = size(a)
    let k = "l"
    var r = attr(a, 0, &k)
    if n < off
        r = attr(a, n, &k)
    else
        r = attr(b, n - off, &k)
    match r
        some(x) -> return copy(x)
        none -> return "?"
fn lab_or_text(a: &View, b: &View, n: i64) -> text
    if n < 0
        return "-"
    let off = size(a)
    if n < off
        if a.tag[n as usize] == ""
            return copy(a.text[n as usize])
        if a.tag[n as usize] == "!"
            return "!"
    else
        if b.tag[(n - off) as usize] == ""
            return copy(b.text[(n - off) as usize])
        if b.tag[(n - off) as usize] == "!"
            return "!"
    return lab(a, b, n)
fn same_tree(a: &View, b: &View) -> bool
    let x = view_cbor(a)
    let y = view_cbor(b)
    return x == y
# Vue-style log of the container operations; "BAD" if the replay differs
fn vue(s: text, t: text) -> text
    let a = lv(s)
    let b = lv(t)
    let ops = diff_vue(&a, &b)
    let r = apply(&a, &b, &ops)
    if not same_tree(&r, &b)
        return "BAD"
    let off = size(&a)
    var o: List[text] = []
    for x in ops
        if x.op == OP_REMOVE and x.nd < off and a.parent[x.nd as usize] == 0
            o.push("r " + lab_or_text(&a, &b, x.nd))
        elif x.op == OP_CREATE and x.parent == 0
            o.push("c " + lab_or_text(&a, &b, x.nd) + " " + lab_or_text(&a, &b, x.before))
        elif x.op == OP_MOVE and x.parent == 0
            o.push("m " + lab_or_text(&a, &b, x.nd) + " " + lab_or_text(&a, &b, x.before))
    return ";".join(o)
# container operations of the optimal diff; -1 if the replay differs
fn cost(s: text, t: text) -> i64
    let a = lv(s)
    let b = lv(t)
    let ops = diff(&a, &b)
    let r = apply(&a, &b, &ops)
    if not same_tree(&r, &b)
        return -1
    var n: i64 = 0
    for x in ops
        if x.op == OP_REMOVE or x.op == OP_CREATE or x.op == OP_MOVE
            if x.op != OP_REMOVE or a.parent[x.nd as usize] == 0
                n += 1
    return n
fn moves(s: text, t: text) -> i64
    let a = lv(s)
    let b = lv(t)
    var n: i64 = 0
    for x in diff(&a, &b)
        if x.op == OP_MOVE
            n += 1
    return n
# A tree in prefix form, tokens separated by spaces: "<t" opens an
# element (then "#k" sets its key and "@n=v" an attribute), ">" closes
# it, "~x" is a text node. The first token opens the root.
fn tv(s: text) -> View
    let ts = s.split(" ")
    let r = ts[0].split("<")
    var v = view_new(copy(r[1]), "")
    var st: List[i64] = [0]
    var cur: i64 = 0
    for i in 1..ts.len()
        let t = copy(ts[i])
        if t == ">"
            let _ = st.pop()
            if st.len() > 0
                cur = st[st.len() - 1]
        elif t.startswith("<")
            let p = t.split("<")
            cur = add_el(&mut v, cur, copy(p[1]), "")
            st.push(cur)
        elif t.startswith("#")
            let p = t.split("#")
            v.key[cur as usize] = copy(p[1])
        elif t.startswith("@")
            let p = t.split("@")
            let q = p[1].split("=")
            set_attr(&mut v, cur, copy(q[0]), copy(q[1]))
        elif t.startswith("~")
            let p = t.split("~")
            let _ = add_text(&mut v, cur, copy(p[1]))
    return v
# hex digest of the replayed tree, "BAD" if it differs from b, "NOTOK"
# if an input is malformed
fn rt(s: text, t: text) -> text
    let a = tv(s)
    let b = tv(t)
    if not view_ok(&a) or not view_ok(&b)
        return "NOTOK"
    let ops = diff(&a, &b)
    let r = apply(&a, &b, &ops)
    if not same_tree(&r, &b)
        return "BAD"
    let d = view_digest(&r)
    return hex(&d)
fn ops_of(s: text, t: text) -> text
    let a = tv(s)
    let b = tv(t)
    var o: List[text] = []
    for x in diff(&a, &b)
        o.push(op_text(&x))
    return ";".join(o)
fn cbor_hex(s: text) -> text
    let v = tv(s)
    let c = view_cbor(&v)
    return hex(&c)
fn fd(seq: i64, s: text) -> text
    let v = tv(s)
    let d = frame_digest(seq, &v)
    return hex(&d)
