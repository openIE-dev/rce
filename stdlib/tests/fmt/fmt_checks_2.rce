# Checks for lib/fmt/fmt.rce, part 2: full and partial regex matching
# against CPython re (re.ASCII; "$" as "\\Z"), generated by
# scripts/gen/fmt_gen.py over a pattern x input grid.

fn re_ok(p: text, s: text, full: bool, part: bool) -> bool
    let r = re_compile(&p) catch Regex(code: [], classes: [], ngroups: 0, names: [], nest: [], nloops: 0)
    return r.code.len() > 0 and re_is_match(&r, &s) == full and re_contains(&r, &s) == part

