check ck_rsplit("\\s+", "  a b  c ", 2, ["", "a", "b  c "])
check ck_rsplit("\\s+", "  a b  c ", -1, ["  a b  c "])
check ck_rsplit("", "abc", 0, ["", "a", "b", "c", ""])
check ck_rsplit("", "abc", 1, ["", "abc"])
check ck_rsplit("", "abc", 2, ["", "a", "bc"])
check ck_rsplit("", "abc", -1, ["abc"])
check ck_rsplit("\\b", "ab cd", 0, ["", "ab", " ", "cd", ""])
check ck_rsplit("\\b", "ab cd", 1, ["", "ab cd"])
check ck_rsplit("\\b", "ab cd", 2, ["", "ab", " cd"])
check ck_rsplit("\\b", "ab cd", -1, ["ab cd"])
check ck_rsplit("(?:x)", "axbx", 0, ["a", "b", ""])
check ck_rsplit("(?:x)", "axbx", 1, ["a", "bx"])
check ck_rsplit("(?:x)", "axbx", 2, ["a", "b", ""])
check ck_rsplit("(?:x)", "axbx", -1, ["axbx"])
check ck_rsplit("[,;]\\s*", "a, b;c", 0, ["a", "b", "c"])
check ck_rsplit("[,;]\\s*", "a, b;c", 1, ["a", "b;c"])
check ck_rsplit("[,;]\\s*", "a, b;c", 2, ["a", "b", "c"])
check ck_rsplit("[,;]\\s*", "a, b;c", -1, ["a, b;c"])
check ck_rsplit("é", "aébé", 0, ["a", "b", ""])
check ck_rsplit("é", "aébé", 1, ["a", "bé"])
check ck_rsplit("é", "aébé", 2, ["a", "b", ""])
check ck_rsplit("é", "aébé", -1, ["aébé"])
check ck_rsplit("z", "abc", 0, ["abc"])
check ck_rsplit("z", "abc", 1, ["abc"])
check ck_rsplit("z", "abc", 2, ["abc"])
check ck_rsplit("z", "abc", -1, ["abc"])
check ck_rsplit("a|b", "cabd", 0, ["c", "", "d"])
check ck_rsplit("a|b", "cabd", 1, ["c", "bd"])
check ck_rsplit("a|b", "cabd", 2, ["c", "", "d"])
check ck_rsplit("a|b", "cabd", -1, ["cabd"])
