# Checks for lib/fmt/fmt.rce, part 1 (parts 2-4: the regex grid; parts
# 5 and later: scripts/gen/fmt_ext_gen.py).
# CPython is the oracle (scripts/gen/fmt_gen.py, seed 20261015): integer
# text in radixes 2..36 at the i64 extremes and random values, strict
# parse refusals, ',' grouping and '0N' padding as in str.format,
# templates against str.format, regex syntax refusals, and inputs that
# make backtracking regex engines exponential.

fn int_ok(v: i64, b: i64, s: text) -> bool
    let p = int_parse(&s, b) catch 0
    let q = int_parse(&s, b) catch 1
    return int_to(v, b) == s and p == v and q == v

fn int_bad(s: text, b: i64) -> bool = (int_parse(&s, b) catch -1) == -1 and (int_parse(&s, b) catch -2) == -2

fn parse_is(s: text, b: i64, v: i64) -> bool = (int_parse(&s, b) catch 1) == v and (int_parse(&s, b) catch 2) == v

fn fmt_ok(t: text, a: List[text], want: text) -> bool = (format(&t, &a) catch "\u{0}ERR") == want

fn fmt_bad(t: text, a: List[text]) -> bool = (format(&t, &a) catch "ERR") == "ERR" and (format(&t, &a) catch "ERR2") == "ERR2"

fn gd(v: i64, c: text) -> text = group_dec(v, &c)

fn re_bad(p: text) -> bool
    let r = re_compile(&p) catch Regex(code: [], classes: [-7], ngroups: 0, names: [], nest: [], nloops: 0)
    return r.classes == [-7]

fn rx(p: text) -> Regex = re_compile(&p) catch Regex(code: [5, 0, 0], classes: [], ngroups: 0, names: [], nest: [0], nloops: 0)

fn rep(s: text, n: i64) -> text
    var o = ""
    for _ in 0..n
        o = o + copy(s)
    return o

# (a?){n}a{n} on a^n: 2^n paths for a backtracker, linear here
fn pathological(n: i64) -> bool
    let p = rep("a?", n) + rep("a", n)
    let r = rx(p)
    let s = rep("a", n)
    let s2 = rep("a", n - 1)
    return re_is_match(&r, &s) and not re_is_match(&r, &s2)

fn nested(n: i64) -> bool
    let r = rx("(x+x+)+y")
    let s = rep("x", n)
    let s2 = s + "y"
    return not re_contains(&r, &s) and re_is_match(&r, &s2)

check pathological(25)
check nested(40)
fn pads() -> bool
    let a = "7"
    let b = "é"
    let c = "long"
    let sp = " "
    let dot = "."
    let z = "0"
    return pad_left(&a, 3, &sp) == "  7" and pad_right(&b, 3, &dot) == "é.." and pad_left(&c, 2, &z) == "long"

check int_dec(-7) == "-7" and int_hex(255) == "ff" and pads()

