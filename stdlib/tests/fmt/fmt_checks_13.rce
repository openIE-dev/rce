# Checks for lib/fmt/fmt.rce, part 13: float parsing against the
# parse-number-fxx-test-data sample in vectors/fmt/ and CPython 3.13
# float(), generated by scripts/gen/fmt_ext_gen.py.

# Helpers shared by the generated parts 5 and later (each part is
# checked appended to the module on its own).

fn ck_fi(v: i64, s: text, want: text) -> bool = (fmt_int(v, &s) catch "\u{0}ERR") == want

fn ck_fi_bad(v: i64, s: text) -> bool = (fmt_int(v, &s) catch "\u{0}ERR") == "\u{0}ERR"

fn ck_ft(v: text, s: text, want: text) -> bool = (fmt_text(&v, &s) catch "\u{0}ERR") == want

fn ck_ft_bad(v: text, s: text) -> bool = (fmt_text(&v, &s) catch "\u{0}ERR") == "\u{0}ERR"

fn ck_ff(x: f64, s: text, want: text) -> bool = (fmt_float(x, &s) catch "\u{0}ERR") == want

fn ck_ff_bad(x: f64, s: text) -> bool = (fmt_float(x, &s) catch "\u{0}ERR") == "\u{0}ERR"

fn ck_frepr(x: f64, want: text) -> bool = float_repr(x) == want

fn ck_ffix(x: f64, p: i64, want: text) -> bool = (float_fixed(x, p) catch "\u{0}ERR") == want

fn ck_fexp(x: f64, p: i64, want: text) -> bool = (float_exp(x, p) catch "\u{0}ERR") == want

fn ck_fexact(x: f64, want: text) -> bool = float_exact(x) == want

fn ck_fixbad(x: f64, p: i64) -> bool = (float_fixed(x, p) catch "\u{0}ERR") == "\u{0}ERR"

fn ck_expbad(x: f64, p: i64) -> bool = (float_exp(x, p) catch "\u{0}ERR") == "\u{0}ERR"

# float_parse as text (float text is shortest round-trip, so equal text
# is equal bits, the sign of zero included)
fn ck_fpt(s: text) -> text ! BadFloat = (try float_parse(&s)).tostr()

fn ck_fp(s: text, want: f64) -> bool
    let sc = float_scan(&s, 0)
    let n = s.len_bytes() as i64
    return sc.value.tostr() == want.tostr() and not sc.overflow and sc.end == n and (ck_fpt(s) catch "ERR") == want.tostr()

# overflow: refused by float_parse, the largest value with the sign from
# float_scan
fn ck_fpo(s: text) -> bool
    let e = float_parse(&s) catch |e| (if e.overflow then 1.0 else 2.0)
    let sc = float_scan(&s, 0)
    let big = if s[0] == 45 then 0.0 - 1.7976931348623157e308 else 1.7976931348623157e308
    return e == 1.0 and sc.overflow and sc.value == big

fn ck_fpbad(s: text, at: i64) -> bool
    let a = float_parse(&s) catch |e| (if e.overflow then -2.0 else (e.at as f64) + 0.5)
    return a == (at as f64) + 0.5

fn ck_fscan(s: text, at: i64, v: f64, end: i64) -> bool
    let sc = float_scan(&s, at)
    return sc.value.tostr() == v.tostr() and sc.end == end and not sc.overflow

fn ck_fscan_ovf(s: text, at: i64, v: f64, end: i64) -> bool
    let sc = float_scan(&s, at)
    return sc.value == v and sc.end == end and sc.overflow

fn ck_rcomp(p: text) -> Regex = re_compile(&p) catch Regex(code: [], classes: [], ngroups: 0, names: [], nest: [], nloops: 0)

fn ck_rbad(p: text) -> bool
    let r = re_compile(&p) catch Regex(code: [], classes: [-7], ngroups: 0, names: [], nest: [], nloops: 0)
    return r.classes == [-7]

fn ck_slots(m: &ReMatch) -> List[i64] = if m.found then copy(m.slots) else []

# search, match and fullmatch spans of every group (byte offsets)
fn ck_rx(p: text, s: text, a: List[i64], b: List[i64], c: List[i64]) -> bool
    let r = ck_rcomp(p)
    let ma = re_find(&r, &s)
    let mb = re_match(&r, &s)
    let mc = re_fullmatch(&r, &s)
    return r.code.len() > 0 and ck_slots(&ma) == a and ck_slots(&mb) == b and ck_slots(&mc) == c and re_contains(&r, &s) == ma.found and re_is_match(&r, &s) == mc.found and ck_rgroups(&ma, &s, &a)

# re_group agrees with the slots
fn ck_rgroups(m: &ReMatch, s: &text, sl: &[i64]) -> bool
    var ok = true
    var k: usize = 0
    while k + 1 < sl.len() bound 1000
        let want = if sl[k] < 0 then "" else s[sl[k] as usize:sl[k + 1] as usize]
        ok = ok and re_group(m, s, (k / 2) as i64) == want
        k += 2
    return ok

fn ck_rall(p: text, s: text, want: List[i64]) -> bool
    let r = ck_rcomp(p)
    var flat: List[i64] = []
    for m in re_find_all(&r, &s)
        for x in m.slots
            flat.push(x)
    return r.code.len() > 0 and flat == want

fn ck_rat(p: text, s: text, at: i64, want: List[i64]) -> bool
    let r = ck_rcomp(p)
    let m = re_find_at(&r, &s, at)
    return r.code.len() > 0 and ck_slots(&m) == want

fn ck_rnames(p: text, names: List[text], want: List[i64], n: i64) -> bool
    let r = ck_rcomp(p)
    var ok = re_groups(&r) == n
    var k: usize = 0
    while k < names.len() bound 100
        ok = ok and re_group_index(&r, &names[k]) == want[k]
        k += 1
    return ok

# the resumable search fed k characters at a time
fn ck_rscan(p: text, s: text, k: i64, want: List[i64]) -> bool
    let r = ck_rcomp(p)
    var st = re_scan_new(&r)
    let cs = s.chars()
    var i: usize = 0
    while i < cs.len() bound 100000
        var chunk = ""
        var j: i64 = 0
        while j < k and i < cs.len() bound 100
            chunk = chunk + copy(cs[i])
            i += 1
            j += 1
        re_scan_feed(&r, &mut st, &chunk)
    let m = re_scan_end(&r, &mut st)
    return r.code.len() > 0 and ck_slots(&m) == want

fn ck_rsub(p: text, s: text, t: text, count: i64, want: text) -> bool
    let r = ck_rcomp(p)
    return r.code.len() > 0 and (re_replace(&r, &s, &t, count) catch "\u{0}ERR") == want

fn ck_rsub_bad(p: text, t: text) -> bool
    let r = ck_rcomp(p)
    let s = "a"
    return r.code.len() > 0 and (re_replace(&r, &s, &t, 0) catch "\u{0}ERR") == "\u{0}ERR"

fn ck_rsplit(p: text, s: text, m: i64, want: List[text]) -> bool
    let r = ck_rcomp(p)
    return r.code.len() > 0 and re_split(&r, &s, m) == want

