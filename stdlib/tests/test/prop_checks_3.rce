# Checks for lib/test/prop.rce: float_to_lex, lex_to_float and choice_from_index for floats.
# Generated by scripts/gen/prop_gen.py with Hypothesis 6.170.12 and
# CPython 3.13; do not edit.

fn fsame(a: f64, b: f64) -> bool = a == b and tp_fneg(a) == tp_fneg(b)

fn lf_ok(lex: u64, fin: bool, x: f64, mant: u64) -> bool
    let l = prop_lex_float(lex)
    if not fin
        return not l.finite and l.mant == mant
    return l.finite and fsame(l.value, x)

