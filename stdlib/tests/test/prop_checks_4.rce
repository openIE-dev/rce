# minimal examples: hypothesis.find(strategy, condition) with derandomize=True,
# max_examples=1000, against prop_find under seed 1
# int_ge: Hypothesis find gives 1000
check find_val(fg_int, fc_ge, prop_cfg(1)) == 1000
# int_le: Hypothesis find gives -500
check find_val(fg_int, fc_le, prop_cfg(1)) == (0 - 500)
# sum: Hypothesis find gives [100]
check find_val(fg_list, fc_sum, prop_cfg(1)) == [100]
# len3: Hypothesis find gives [0, 0, 0]
check find_val(fg_list, fc_len, prop_cfg(1)) == [0, 0, 0]
# notpal: Hypothesis find gives [0, 1]
check find_val(fg_list, fc_pal, prop_cfg(1)) == [0, 1]
# unsorted: Hypothesis find gives [0, -1]
check find_val(fg_list, fc_unsorted, prop_cfg(1)) == [0, (0 - 1)]
# pairsum: Hypothesis find gives (1, 1000)
check find_val(fg_pair, fc_pairsum, prop_cfg(1)) == (1, 1000)
# eqpair: Hypothesis find gives (11, 11)
check find_val(fg_pair100, fc_eq, prop_cfg_cases(1, 1000)) == (11, 11)
# dup: Hypothesis find gives [0, 0]
check find_val(fg_l100, fc_dup, prop_cfg(1)) == [0, 0]
