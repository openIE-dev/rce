# Checks for lib/test/prop.rce: minimal examples from Hypothesis find(), second half.
# Generated by scripts/gen/prop_gen.py with Hypothesis 6.170.12 and
# CPython 3.13; do not edit.

fn fg_int(s: &mut PropSrc) -> i64 = draw_int(s, -1000000, 1000000)
fn fg_one(s: &mut PropSrc) -> i64 = draw_int(s, -1000, 1000)
fn fg_c100(s: &mut PropSrc) -> i64 = draw_int(s, 0, 100)
fn fg_c10(s: &mut PropSrc) -> i64 = draw_int(s, 0, 10)
fn fg_list(s: &mut PropSrc) -> List[i64] = draw_list(s, fg_one, 0, 20)
fn fg_l100(s: &mut PropSrc) -> List[i64] = draw_list(s, fg_c100, 0, 20)
fn fg_pair(s: &mut PropSrc) -> (i64, i64)
    let a = draw_int(s, 0, 1000)
    let b = draw_int(s, 0, 1000)
    return (a, b)
fn fg_pair100(s: &mut PropSrc) -> (i64, i64)
    let a = draw_int(s, 0, 100)
    let b = draw_int(s, 0, 100)
    return (a, b)
fn fg_text(s: &mut PropSrc) -> text
    let cs = prop_chars_ascii()
    return draw_text(s, &cs, 0, 10)
fn fg_float(s: &mut PropSrc) -> f64 = draw_float(s)
fn fg_unit(s: &mut PropSrc) -> f64 = draw_float_in(s, 0.0, 1.0)
fn fg_dict(s: &mut PropSrc) -> Map[i64, i64] = draw_map(s, fg_c10, fg_c10, 0, 10)
struct FgPerson
    name: text
    age: i64
fn fg_rec(s: &mut PropSrc) -> FgPerson
    let r: List[i64] = [97, 122]
    let cs = prop_chars(&r)
    prop_span_start(s)
    let n = draw_text(s, &cs, 0, 8)
    let a = draw_int(s, 0, 150)
    prop_span_stop(s)
    return FgPerson(name: n, age: a)
fn fg_bools(s: &mut PropSrc) -> (bool, bool)
    let a = draw_bool(s)
    let b = draw_bool(s)
    return (a, b)
fn fc_ge(x: &i64) -> bool = x >= 1000
fn fc_le(x: &i64) -> bool = x <= -500
fn fc_sum(xs: &List[i64]) -> bool = xs.sum() >= 100
fn fc_len(xs: &List[i64]) -> bool = xs.len() >= 3
fn fc_pal(xs: &List[i64]) -> bool = xs.reverse() != xs
fn fc_unsorted(xs: &List[i64]) -> bool
    var ys = copy(xs)
    ys.sort()
    return ys != xs
fn fc_pairsum(t: &(i64, i64)) -> bool = t.0 + t.1 > 1000
fn fc_eq(t: &(i64, i64)) -> bool = t.0 == t.1 and t.0 > 10
fn fc_dup(xs: &List[i64]) -> bool = set_of(copy(xs)).len() < xs.len()
fn fc_max(xs: &List[i64]) -> bool = xs.len() > 0 and xs.fold(0, fn(a: i64, b: i64) => a.max(b)) >= 50
fn fc_text2(t: &text) -> bool = t.len_chars() >= 2
fn fc_texta(t: &text) -> bool = t.contains("a")
fn fc_fgt(x: &f64) -> bool = x > 1.5
fn fc_fle(x: &f64) -> bool = x <= -0.5
fn fc_unit(x: &f64) -> bool = x > 0.3
fn fc_frac(x: &f64) -> bool = x > 0.0 and x != x.floor()
fn fc_dict(m: &Map[i64, i64]) -> bool = m.len() >= 2
fn fc_rec(r: &FgPerson) -> bool = r.age >= 18 and r.name.len_bytes() > 0
fn fc_bools(t: &(bool, bool)) -> bool = t.0 or t.1
fn fsame(a: f64, b: f64) -> bool = a == b and tp_fneg(a) == tp_fneg(b)
fn find_val[T](g: fn(&mut PropSrc) -> T, c: fn(&T) -> bool, cfg: PropCfg) -> T
    let r = prop_find(g, c, cfg)
    return prop_value(&r, g)
fn fg_rec_is(p: FgPerson, name: text, age: i64) -> bool = p.name == name and p.age == age

# minimal examples: hypothesis.find(strategy, condition) with derandomize=True,
# max_examples=1000, against prop_find under seed 1
# max50: Hypothesis find gives [50]
check find_val(fg_l100, fc_max, prop_cfg(1)) == [50]
# text2: Hypothesis find gives '00'
check find_val(fg_text, fc_text2, prop_cfg(1)) == "00"
# texta: Hypothesis find gives 'a'
check find_val(fg_text, fc_texta, prop_cfg(1)) == "a"
# fgt: Hypothesis find gives 2.0
check fsame(find_val(fg_float, fc_fgt, prop_cfg(1)), 2.0)
# fle: Hypothesis find gives -1.0
check fsame(find_val(fg_float, fc_fle, prop_cfg(1)), (-1.0))
# unit: Hypothesis find gives 1.0
check fsame(find_val(fg_unit, fc_unit, prop_cfg(1)), 1.0)
# frac: Hypothesis find gives 0.5. Hypothesis stops at 0.5; test.prop reaches 1.5, whose float_to_lex index is smaller.
check fsame(find_val(fg_float, fc_frac, prop_cfg(1)), 1.5) and prop_float_lex(1.5) < prop_float_lex(0.5)
# dict2: Hypothesis find gives {0: 0, 1: 0}
check find_val(fg_dict, fc_dict, prop_cfg(1)) == {0: 0, 1: 0}
# rec: Hypothesis find gives ('a', 18)
check fg_rec_is(find_val(fg_rec, fc_rec, prop_cfg(1)), "a", 18)
# bools: Hypothesis find gives (False, True)
check find_val(fg_bools, fc_bools, prop_cfg(1)) == (false, true)
