# Checks for lib/test/prop.rce: integer choice indices and the character shrink order.
# Generated by scripts/gen/prop_gen.py with Hypothesis 6.170.12 and
# CPython 3.13; do not edit.

fn iv_ok(v: i64, lo: i64, hi: i64, idx: u64) -> bool = prop_int_index(v, lo, hi) == idx and prop_int_value(idx, lo, hi) == v

fn cv_ok(r: List[i64], i: i64, c: i64) -> bool
    let cs = prop_chars(&r)
    return prop_char_at(&cs, i) == c and prop_char_index(&cs, c) == i

