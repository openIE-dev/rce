fn tn_fmt(b: List[i64]) -> text = uuid_format(&b) catch "bad"

fn tn_16(s: text) -> List[i64] = uuid_parse(&s) catch [1]

fn tn_v1(t: i64, cs: i64, nd: i64) -> text
    let u = uuid_v1(t, cs, nd) catch [1]
    return tn_fmt(u)

fn tn_v6(t: i64, cs: i64, nd: i64) -> text
    let u = uuid_v6(t, cs, nd) catch [1]
    let t2 = uuid_ticks_of(&u) catch -9
