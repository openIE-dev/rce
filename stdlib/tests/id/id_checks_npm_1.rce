        i += 1
    return o

fn tu_enc(b: List[i64]) -> text = ulid_encode(&b) catch "bad"

fn tu_parse(s: text) -> text
    let b = ulid_parse(&s) catch [1]
    return tn_fmt(b)

fn tu_ms(s: text) -> i64
    let b = ulid_parse(&s) catch [1]
    return ulid_ms(&b) catch -1

fn tu_fix(s: text) -> text = ulid_fix(&s)

fn tu_new(ms: i64, r: List[i64]) -> text
    let b = ulid_new(ms, &r) catch [1]
    return tu_enc(b)

fn tu_run(ts: List[i64], rs: List[List[i64]]) -> List[text]
    var g = ulid_gen()
    var o: List[text] = []
    var i: usize = 0
    while i < ts.len() bound 100
        let b = ulid_next(&mut g, ts[i], &rs[i]) catch [1]
        o.push(tu_enc(b))
        i += 1
    return o

fn tz_url(r: List[i64], size: i64) -> text = nanoid(&r, size) catch "bad"

fn tz_custom(a: text, size: i64, r: List[i64]) -> text = nanoid_custom(&a, size, &r) catch "bad"

# Feed r in chunks of the given sizes; the ID, then the bytes consumed.
fn tz_feed(a: text, size: i64, r: List[i64], cuts: List[i64]) -> text
