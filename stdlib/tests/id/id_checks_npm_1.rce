    let m2 = ulid_ms(&u) catch -9
    let v = uuid_version(&u) catch -9
    return tn_fmt(u) + " " + m.tostr() + " " + m2.tostr() + " " + v.tostr()

fn tn_v7run(ms0: i64, seq0: i64, ts: List[i64], rs: List[List[i64]]) -> List[text]
    var g = Uuid7Gen(ms: ms0, seq: seq0)
