# Checks for lib/energy/energy.rce (no signatures: those cost an Ed25519
# operation each and run per event in tests/energy/energy_host.rce).
# JCP conformance/v1 receipts (official, vectors/energy/); base58 vectors
# of draft-msporny-base58-03; did:key ids, jcp/2 cores,
# content ids, Sig_structures and COSE_Sign1 envelopes, replay and group
# accounting against cbor2, blake3 and cryptography
# (scripts/gen/energy_gen.py); malformed envelopes do not open.

fn hexb(h: text) -> List[i64]
    var o: List[i64] = []
    var i: usize = 0
    while i + 1 < h.len_bytes() bound 16777216
        o.push(hnib(h[i] as i64) * 16 + hnib(h[i + 1] as i64))
        i += 2
    return o

fn b58_ok(data: text, s: text) -> bool
    let b = hexb(data)
    let d = base58_decode(&s) catch [999]
    return base58_encode(&b) == s and d == b

fn did_ok(pk: text, d: text) -> bool
    let b = hexb(pk)
    let back = did_key_pk(&d) catch []
    return did_key(&b) == d and back == b

fn core_ok(n: i64, want: text, id: text) -> bool
    let r = sample(n)
    let c = receipt_core(&r) catch []
    let i = receipt_id(&r) catch ""
    let back = decode_core(&c) catch sample(99)
    return hex_of(&c) == want and i == id and back == r

fn sigs_ok(n: i64, want: text) -> bool
    let r = sample(n)
    let c = receipt_core(&r) catch []
    let ph = protected_header(&r.steward)
    let ss = sig_structure(&ph, &c)
    return hex_of(&ss) == want

fn env_ok(n: i64, sig: text, want: text) -> bool
    let r = sample(n)
    let c = receipt_core(&r) catch []
    let s = hexb(sig)
    let e = envelope(&c, &r.steward, &s)
    let o = open_envelope(&e) catch OpenedReceipt(receipt: sample(99), prot: [], payload: [], kid: "", sig: [])
    return hex_of(&e) == want and o.receipt == r and o.sig == s and o.kid == r.steward

fn stream() -> List[Receipt]
    var rs: List[Receipt] = []
    for i in 0..6
        rs.push(sample(i))
    return rs

fn spent_ok(g: text, v: i64) -> bool
    let st = stream()
    let led = replay(&st)
    return spent(&led, &g) == v

fn tally_ok(g: text, sub: text, a: i64, d: i64, j: i64) -> bool
    var hit = false
    let st = stream()
    for t in tally(&st)
        if t.grant_id == g and t.subject == sub
            hit = t.allowed == a and t.denied == d and t.joules_uj == j
    return hit

fn opens_v1(e: text) -> bool
    let b = hexb(e)
    let o = open_envelope(&b) catch OpenedReceipt(receipt: sample(99), prot: [], payload: [], kid: "", sig: [])
    return o.receipt.profile == "jcp/1" and o.receipt.payload_hash == ""

fn rejects(_why: text, e: text) -> bool
    let b = hexb(e)
    let o = open_envelope(&b) catch OpenedReceipt(receipt: sample(99), prot: [], payload: [], kid: "refused", sig: [])
    return o.kid == "refused"

fn mint_fails() -> bool
    var r = sample(0)
    r.profile = "jcp/1"
    let a = receipt_core(&r) catch [7]
    var r2 = sample(1)
    r2.deny_reason = ""
    let b = receipt_core(&r2) catch [7]
    var r3 = sample(0)
    r3.budget_remaining_uj = r3.budget_uj + 1
    let c = receipt_core(&r3) catch [7]
    var r4 = sample(0)
    r4.provenance = "Guess"
    let d = receipt_core(&r4) catch [7]
    return a == [7] and b == [7] and c == [7] and d == [7]

fn bad_dids() -> bool
    let x = "did:key:z6Mk"
    let y = "did:web:example.com"
    let z = "did:key:z0OIl"
    let a = did_key_pk(&x) catch [7]
    let b = did_key_pk(&y) catch [7]
    let c = did_key_pk(&z) catch [7]
    return a == [7] and b == [7] and c == [7]

# JCP conformance/v1 (vectors.json, legacy_jcp1.json, dual_ceilings.json):
# the envelope opens, its payload is the published signed core, the fields
# decode to the published wire values, and a jcp/2 core re-mints to the
# same bytes and content id.
fn conf_ok(e: text, core: text, w: Receipt) -> bool
    let b = hexb(e)
    let o = open_envelope(&b) catch opened_none()
    let c = hexb(core)
    let again = if w.profile == "jcp/2" then (receipt_core(&w) catch []) else copy(c)
    return o.payload == c and o.receipt == w and again == c and o.kid == w.steward

check mint_fails()
check bad_dids()
# remaining budget follows the stream (allow debits, deny does not)
fn conserve_ok() -> bool
    let st = stream()
    let bad = [sample(0), sample(2), sample(1), sample(3)]
    let skip = [sample(2)]
    let ok2 = [sample(0), sample(1)]
    return conserves(&st) and conserves(&ok2) and not conserves(&skip) and not conserves(&bad)

check conserve_ok()

