# Checks for lib/enc/enc.rce. Official vectors: RFC 4648 section 10
# (base64), RFC 8949 Appendix A (CBOR, the items within the enc model) and
# the 4.2.1 key-order example, RFC 8785 3.2.2.2 and 3.2.3 (JCS); varint and
# zigzag values from the protobuf encoding guide; strict-decoder rejections;
# a seeded round-trip sweep. The Appendix A part is generated by
# scripts/gen/enc_gen.py.

fn nib(c: i64) -> i64 = if c >= 97 then c - 87 else c - 48

fn unhex(h: &text) -> List[i64]
    var o: List[i64] = []
    var i: usize = 0
    while i + 1 < h.len_bytes() bound 4096
        o.push(nib(h[i] as i64) * 16 + nib(h[i + 1] as i64))
        i += 2
    return o

fn cbor_enc_only(v: Cbor, h: text) -> bool = cbor_encode(&v) == unhex(&h)

fn cbor_rt(v: Cbor, h: text) -> bool
    let b = unhex(&h)
    let d = cbor_decode(&b) catch CSimple(v: 99)
    return cbor_encode(&v) == b and d == v

fn cmap_hex(v: Cbor, h: text) -> bool = cbor_enc_only(v, h)

fn rejects(h: text) -> bool
    let b = unhex(&h)
    let d = cbor_decode(&b) catch CSimple(v: 99)
    return d == CSimple(v: 99)

fn b64(s: text) -> text
    let b = bytes_of(&s)
    return b64_encode(&b, false, true)

fn b64_rt(s: text, e: text) -> bool
    let b = bytes_of(&s)
    let d = b64_decode(&e, false, true) catch [999]
    return b64_encode(&b, false, true) == e and d == b

fn b64_bad(e: text, url: bool, pad: bool) -> bool
    let d = b64_decode(&e, url, pad) catch [999]
    return d == [999]

fn var_rt(v: i64, h: text) -> bool
    let b = unhex(&h)
    let r = uvarint_decode(&b, 0) catch VarOut(v: -1, next: -1)
    return uvarint(v) == b and r.v == v and r.next == (b.len() as i64)

fn var_bad(h: text) -> bool
    let b = unhex(&h)
    let r = uvarint_decode(&b, 0) catch VarOut(v: -1, next: -1)
    return r.next == -1

fn rnd(s: i64) -> i64 = (s * 1103515245 + 12345) & 2147483647

# Seeded sweep: base64 (both alphabets, with and without padding) and
# varints round-trip; CBOR of random int/bytes arrays and maps round-trips.
fn sweep(n: i64) -> bool
    var s: i64 = 17
    var ok = true
    for i in 0..n
        var b: List[i64] = []
        for _k in 0..(i % 13)
            s = rnd(s)
            b.push(s & 255)
        for m in 0..4
            let url = m % 2 == 1
            let pad = m < 2
            let e = b64_encode(&b, url, pad)
            ok = ok and (b64_decode(&e, url, pad) catch [999]) == b
        s = rnd(s)
        let v = (s * 4294967296 + s) >> (s & 31)
        let vb = uvarint(v)
        ok = ok and (uvarint_decode(&vb, 0) catch VarOut(v: -1, next: -1)).v == v
        ok = ok and unzigzag(zigzag(v - 4611686018427387904)) == v - 4611686018427387904
        let c = CArr(items: [CInt(v: v), CInt(v: 0 - v), CBytes(b: copy(b)), CMap(keys: [CInt(v: v % 1000), CInt(v: 0 - (v % 1000) - 1)], vals: [CSimple(v: 21), CText(t: "x")])])
        let cb = cbor_encode(&c)
        ok = ok and (cbor_decode(&cb) catch CSimple(v: 99)) == c
    return ok

check sweep(60)

# RFC 4648 section 10
check b64_rt("", "") and b64_rt("f", "Zg==") and b64_rt("fo", "Zm8=") and b64_rt("foo", "Zm9v")
check b64_rt("foob", "Zm9vYg==") and b64_rt("fooba", "Zm9vYmE=") and b64_rt("foobar", "Zm9vYmFy")
check b64_bad("Zg=", false, true) and b64_bad("Zh==", false, true) and b64_bad("Zm9v YmFy", false, true) and b64_bad("Zm+v", true, true) and b64_bad("Zg==", false, false) and b64_bad("Z", false, false)

# protobuf encoding guide: 1, 150, 300; LEB128 624485; zigzag table
check var_rt(0, "00") and var_rt(1, "01") and var_rt(150, "9601") and var_rt(300, "ac02") and var_rt(624485, "e58e26")
check var_rt(9223372036854775807, "ffffffffffffffff7f") and var_bad("8000") and var_bad("80") and var_bad("ffffffffffffffffff01")
check zigzag(0) == 0 and zigzag(-1) == 1 and zigzag(1) == 2 and zigzag(-2) == 3 and zigzag(2147483647) == 4294967294 and zigzag(-2147483648) == 4294967295
check unzigzag(4294967295) == -2147483648 and unzigzag(4294967294) == 2147483647

# RFC 8949 4.2.1: keys 10, 100, -1, "z", "aa", [100], [-1], false sort in this order
check cmap_hex(CMap(keys: [CSimple(v: 20), CText(t: "aa"), CInt(v: -1), CArr(items: [CInt(v: -1)]), CInt(v: 100), CText(t: "z"), CArr(items: [CInt(v: 100)]), CInt(v: 10)], vals: [CInt(v: 0), CInt(v: 0), CInt(v: 0), CInt(v: 0), CInt(v: 0), CInt(v: 0), CInt(v: 0), CInt(v: 0)]), "a80a001864002000617a006261610081186400812000f400")

# strict decoder: non-shortest head, indefinite length, unsorted and
# duplicate keys, trailing bytes, simple < 32 in two bytes, float, > i64,
# truncation, non-ASCII text (needs spec)
check rejects("1817") and rejects("9f01ff") and rejects("a203040102") and rejects("a201020103")
check rejects("0001") and rejects("f818") and rejects("f93c00") and rejects("1b8000000000000000") and rejects("1903") and rejects("62c3bc")

# RFC 8785 3.2.2.2 string example and 3.2.3 sorting example
fn jc(j: JsonDoc) -> text = jcs(&j)

check jc(JStr(t: "\u{20ac}$\u{f}\nA'B\"\\\\\"/")) == "\"\u{20ac}$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\""
check jc(JObj(keys: ["\u{20ac}", "\r", "\u{fb33}", "1", "\u{1f600}", "\u{80}", "\u{f6}"], vals: [JStr(t: "Euro Sign"), JStr(t: "Carriage Return"), JStr(t: "Hebrew Letter Dalet With Dagesh"), JStr(t: "One"), JStr(t: "Emoji: Grinning Face"), JStr(t: "Control"), JStr(t: "Latin Small Letter O With Diaeresis")])) == "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\u{80}\":\"Control\",\"\u{f6}\":\"Latin Small Letter O With Diaeresis\",\"\u{20ac}\":\"Euro Sign\",\"\u{1f600}\":\"Emoji: Grinning Face\",\"\u{fb33}\":\"Hebrew Letter Dalet With Dagesh\"}"
check jc(JArr(items: [JNull, JBool(v: true), JBool(v: false), JInt(v: -0), JInt(v: 9007199254740992), JArr(items: []), JObj(keys: [], vals: [])])) == "[null,true,false,0,9007199254740992,[],{}]"

# RFC 8949 Appendix A
# 0
check cbor_rt(CInt(v: 0), "00")
# 1
check cbor_rt(CInt(v: 1), "01")
# 10
check cbor_rt(CInt(v: 10), "0a")
# 23
check cbor_rt(CInt(v: 23), "17")
# 24
check cbor_rt(CInt(v: 24), "1818")
# 25
check cbor_rt(CInt(v: 25), "1819")
# 100
check cbor_rt(CInt(v: 100), "1864")
# 1000
check cbor_rt(CInt(v: 1000), "1903e8")
# 1000000
check cbor_rt(CInt(v: 1000000), "1a000f4240")
# 1000000000000
check cbor_rt(CInt(v: 1000000000000), "1b000000e8d4a51000")
# -1
check cbor_rt(CInt(v: -1), "20")
# -10
check cbor_rt(CInt(v: -10), "29")
# -100
check cbor_rt(CInt(v: -100), "3863")
# -1000
check cbor_rt(CInt(v: -1000), "3903e7")
# false
check cbor_rt(CSimple(v: 20), "f4")
# true
check cbor_rt(CSimple(v: 21), "f5")
# null
check cbor_rt(CSimple(v: 22), "f6")
# undefined
check cbor_rt(CSimple(v: 23), "f7")
# simple(16)
check cbor_rt(CSimple(v: 16), "f0")
# simple(255)
check cbor_rt(CSimple(v: 255), "f8ff")
# 0("2013-03-21T20:04:00Z")
check cbor_rt(CTag(tag: 0, item: Box(CText(t: "2013-03-21T20:04:00Z"))), "c074323031332d30332d32315432303a30343a30305a")
# 1(1363896240)
check cbor_rt(CTag(tag: 1, item: Box(CInt(v: 1363896240))), "c11a514b67b0")
# 23(h'01020304')
check cbor_rt(CTag(tag: 23, item: Box(CBytes(b: [1, 2, 3, 4]))), "d74401020304")
# 24(h'6449455446')
check cbor_rt(CTag(tag: 24, item: Box(CBytes(b: [100, 73, 69, 84, 70]))), "d818456449455446")
# 32("http://www.example.com")
check cbor_rt(CTag(tag: 32, item: Box(CText(t: "http://www.example.com"))), "d82076687474703a2f2f7777772e6578616d706c652e636f6d")
# h''
check cbor_rt(CBytes(b: []), "40")
# h'01020304'
check cbor_rt(CBytes(b: [1, 2, 3, 4]), "4401020304")
# ""
check cbor_rt(CText(t: ""), "60")
# "a"
check cbor_rt(CText(t: "a"), "6161")
# "IETF"
check cbor_rt(CText(t: "IETF"), "6449455446")
# "\"\\"
check cbor_rt(CText(t: "\"\\"), "62225c")
# "\u00fc"
check cbor_enc_only(CText(t: "\u{fc}"), "62c3bc")
# "\u6c34"
check cbor_enc_only(CText(t: "\u{6c34}"), "63e6b0b4")
# "\ud800\udd51"
check cbor_enc_only(CText(t: "\u{10151}"), "64f0908591")
# []
check cbor_rt(CArr(items: []), "80")
# [1, 2, 3]
check cbor_rt(CArr(items: [CInt(v: 1), CInt(v: 2), CInt(v: 3)]), "83010203")
# [1, [2, 3], [4, 5]]
check cbor_rt(CArr(items: [CInt(v: 1), CArr(items: [CInt(v: 2), CInt(v: 3)]), CArr(items: [CInt(v: 4), CInt(v: 5)])]), "8301820203820405")
# [1, 2, ..., 25]
check cbor_rt(CArr(items: [CInt(v: 1), CInt(v: 2), CInt(v: 3), CInt(v: 4), CInt(v: 5), CInt(v: 6), CInt(v: 7), CInt(v: 8), CInt(v: 9), CInt(v: 10), CInt(v: 11), CInt(v: 12), CInt(v: 13), CInt(v: 14), CInt(v: 15), CInt(v: 16), CInt(v: 17), CInt(v: 18), CInt(v: 19), CInt(v: 20), CInt(v: 21), CInt(v: 22), CInt(v: 23), CInt(v: 24), CInt(v: 25)]), "98190102030405060708090a0b0c0d0e0f101112131415161718181819")
# {}
check cbor_rt(CMap(keys: [], vals: []), "a0")
# {1: 2, 3: 4}
check cbor_rt(CMap(keys: [CInt(v: 1), CInt(v: 3)], vals: [CInt(v: 2), CInt(v: 4)]), "a201020304")
# {"a": 1, "b": [2, 3]}
check cbor_rt(CMap(keys: [CText(t: "a"), CText(t: "b")], vals: [CInt(v: 1), CArr(items: [CInt(v: 2), CInt(v: 3)])]), "a26161016162820203")
# ["a", {"b": "c"}]
check cbor_rt(CArr(items: [CText(t: "a"), CMap(keys: [CText(t: "b")], vals: [CText(t: "c")])]), "826161a161626163")
# {"a": "A", ..., "e": "E"}
check cbor_rt(CMap(keys: [CText(t: "a"), CText(t: "b"), CText(t: "c"), CText(t: "d"), CText(t: "e")], vals: [CText(t: "A"), CText(t: "B"), CText(t: "C"), CText(t: "D"), CText(t: "E")]), "a56161614161626142616361436164614461656145")
