# replace_n cpython
check t_replace_n("__under__", "", "", 1) == "__under__"
# replace_n cpython
check t_replace_n("__under__", "", "", 2) == "__under__"
# replace_n cpython
check t_replace_n("__under__", "ss", "-", 1) == "__under__"
# replace_n cpython
check t_replace_n("__under__", "ss", "-", 2) == "__under__"
# replace_n cpython
check t_replace_n("__under__", "__u", "\u{df}\u{df}", 1) == "\u{df}\u{df}nder__"
# replace_n cpython
check t_replace_n("__under__", "__u", "\u{df}\u{df}", 2) == "\u{df}\u{df}nder__"
# replace_n cpython
check t_replace_n("__under__", "a", "b", 0) == "__under__"
# replace_n cpython
check t_replace_n("\n", "", "-", 1) == "-\n"
# replace_n cpython
check t_replace_n("\n", "", "-", 2) == "-\n-"
# replace_n cpython
check t_replace_n("\n", "aa", "\u{df}\u{df}", 1) == "\n"
# replace_n cpython
check t_replace_n("\n", "aa", "\u{df}\u{df}", 2) == "\n"
# replace_n cpython
check t_replace_n("\n", "\n", "XYZ", 1) == "XYZ"
# replace_n cpython
check t_replace_n("\n", "\n", "XYZ", 2) == "XYZ"
# replace_n cpython
check t_replace_n("\n", "a", "b", 0) == "\n"
# replace_n cpython
check t_replace_n("tab\there", "", "\u{df}\u{df}", 1) == "\u{df}\u{df}tab\there"
# replace_n cpython
check t_replace_n("tab\there", "", "\u{df}\u{df}", 2) == "\u{df}\u{df}t\u{df}\u{df}ab\there"
# replace_n cpython
check t_replace_n("tab\there", "ab", "XYZ", 1) == "tXYZ\there"
# replace_n cpython
check t_replace_n("tab\there", "ab", "XYZ", 2) == "tXYZ\there"
# replace_n cpython
check t_replace_n("tab\there", "ta", "", 1) == "b\there"
# replace_n cpython
check t_replace_n("tab\there", "ta", "", 2) == "b\there"
# replace_n cpython
check t_replace_n("tab\there", "a", "b", 0) == "tab\there"
# replace_n cpython
check t_replace_n("\u{e9}", "", "XYZ", 1) == "XYZ\u{e9}"
# replace_n cpython
check t_replace_n("\u{e9}", "", "XYZ", 2) == "XYZ\u{e9}XYZ"
# replace_n cpython
check t_replace_n("\u{e9}", "\u{df}", "", 1) == "\u{e9}"
# replace_n cpython
check t_replace_n("\u{e9}", "\u{df}", "", 2) == "\u{e9}"
# replace_n cpython
check t_replace_n("\u{e9}", "\u{e9}", "-", 1) == "-"
# replace_n cpython
check t_replace_n("\u{e9}", "\u{e9}", "-", 2) == "-"
# replace_n cpython
check t_replace_n("\u{e9}", "a", "b", 0) == "\u{e9}"
# replace_n cpython
check t_replace_n("na\u{ef}ve", "", "", 1) == "na\u{ef}ve"
# replace_n cpython
check t_replace_n("na\u{ef}ve", "", "", 2) == "na\u{ef}ve"
# replace_n cpython
check t_replace_n("na\u{ef}ve", "x", "-", 1) == "na\u{ef}ve"
# replace_n cpython
check t_replace_n("na\u{ef}ve", "x", "-", 2) == "na\u{ef}ve"
# replace_n cpython
check t_replace_n("na\u{ef}ve", "n", "\u{df}\u{df}", 1) == "\u{df}\u{df}a\u{ef}ve"
# replace_n cpython
check t_replace_n("na\u{ef}ve", "n", "\u{df}\u{df}", 2) == "\u{df}\u{df}a\u{ef}ve"
# replace_n cpython
check t_replace_n("na\u{ef}ve", "a", "b", 0) == "na\u{ef}ve"
# replace_n cpython
check t_replace_n("\u{df}", "", "-", 1) == "-\u{df}"
# replace_n cpython
check t_replace_n("\u{df}", "", "-", 2) == "-\u{df}-"
# replace_n cpython
check t_replace_n("\u{df}", "\r\n", "\u{df}\u{df}", 1) == "\u{df}"
# replace_n cpython
check t_replace_n("\u{df}", "\r\n", "\u{df}\u{df}", 2) == "\u{df}"
# replace_n cpython
check t_replace_n("\u{df}", "\u{df}", "XYZ", 1) == "XYZ"
# replace_n cpython
check t_replace_n("\u{df}", "\u{df}", "XYZ", 2) == "XYZ"
# replace_n cpython
check t_replace_n("\u{df}", "a", "b", 0) == "\u{df}"
# replace_n cpython
check t_replace_n("\u{131}i", "", "\u{df}\u{df}", 1) == "\u{df}\u{df}\u{131}i"
