# rsplitn derived
check t_rsplitn("\u{390}j\u{2126}\u{672c}7\u{5ea}\u{30c6}o\u{926}\u{1f88}@\u{3042}", "", -1) == ["", "\u{390}", "j", "\u{2126}", "\u{672c}", "7", "\u{5ea}", "\u{30c6}", "o", "\u{926}", "\u{1f88}", "@", "\u{3042}", ""]
