# splitlines cpython
check t_splitlines("", false) == []
# splitlines cpython
check t_splitlines("", true) == []
# splitlines cpython
check t_splitlines("A", false) == ["A"]
# splitlines cpython
check t_splitlines("A", true) == ["A"]
# splitlines cpython
check t_splitlines("Hello, World!", false) == ["Hello, World!"]
# splitlines cpython
check t_splitlines("Hello, World!", true) == ["Hello, World!"]
# splitlines cpython
check t_splitlines("they're bill's friends", false) == ["they're bill's friends"]
# splitlines cpython
check t_splitlines("they're bill's friends", true) == ["they're bill's friends"]
# splitlines cpython
check t_splitlines("\tTab\tSeparated\t", false) == ["\tTab\tSeparated\t"]
# splitlines cpython
check t_splitlines("\tTab\tSeparated\t", true) == ["\tTab\tSeparated\t"]
# splitlines cpython
check t_splitlines("a\n\nb\n", false) == ["a", "", "b"]
# splitlines cpython
check t_splitlines("a\n\nb\n", true) == ["a\n", "\n", "b\n"]
# splitlines cpython
check t_splitlines("camelCaseWord", false) == ["camelCaseWord"]
# splitlines cpython
check t_splitlines("camelCaseWord", true) == ["camelCaseWord"]
