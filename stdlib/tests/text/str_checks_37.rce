check t_splitlines("a1b2c3", false) == ["a1b2c3"]
# splitlines cpython
check t_splitlines("a1b2c3", true) == ["a1b2c3"]
# splitlines cpython
check t_splitlines("ABC123def", false) == ["ABC123def"]
# splitlines cpython
check t_splitlines("ABC123def", true) == ["ABC123def"]
# splitlines cpython
check t_splitlines("-17", false) == ["-17"]
# splitlines cpython
check t_splitlines("-17", true) == ["-17"]
# splitlines cpython
check t_splitlines("...", false) == ["..."]
