# rsplitn cpython
check t_rsplitn("...", "\r\n", 0) == ["..."]
# rsplitn cpython
check t_rsplitn("...", "\r\n", 1) == ["..."]
# rsplitn cpython
check t_rsplitn("...", "\r\n", 2) == ["..."]
# rsplitn cpython
check t_rsplitn("...", "..", -1) == [".", ""]
# rsplitn cpython
check t_rsplitn("...", "..", 0) == ["..."]
# rsplitn cpython
check t_rsplitn("...", "..", 1) == [".", ""]
# rsplitn cpython
check t_rsplitn("...", "..", 2) == [".", ""]
# rsplitn cpython
check t_rsplitn("a.b.c", "ab", -1) == ["a.b.c"]
# rsplitn cpython
check t_rsplitn("a.b.c", "ab", 0) == ["a.b.c"]
# rsplitn cpython
check t_rsplitn("a.b.c", "ab", 1) == ["a.b.c"]
# rsplitn cpython
check t_rsplitn("a.b.c", "ab", 2) == ["a.b.c"]
# rsplitn cpython
check t_rsplitn("a.b.c", "b.", -1) == ["a.", "c"]
# rsplitn cpython
check t_rsplitn("a.b.c", "b.", 0) == ["a.b.c"]
# rsplitn cpython
check t_rsplitn("a.b.c", "b.", 1) == ["a.", "c"]
# rsplitn cpython
check t_rsplitn("a.b.c", "b.", 2) == ["a.", "c"]
# rsplitn derived
check t_rsplitn("a.b.c", "", -1) == ["", "a", ".", "b", ".", "c", ""]
# rsplitn derived
check t_rsplitn("a.b.c", "", 0) == ["a.b.c"]
# rsplitn derived
check t_rsplitn("a.b.c", "", 1) == ["a.b.c", ""]
