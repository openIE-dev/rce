check t_repeat("\u{1e900}\u{1e922} Adlam", 0) == ""
# repeat cpython
check t_repeat("\u{1e900}\u{1e922} Adlam", 3) == "\u{1e900}\u{1e922} Adlam\u{1e900}\u{1e922} Adlam\u{1e900}\u{1e922} Adlam"
