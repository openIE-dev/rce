check t_rsplit_once("\u{1c6}\u{ce}\u{a0}!\u{ff41}\u{149}f\u{ff43}\u{5d9}\u{418}z\u{435}~\u{1c4}", ",") == []
# rsplit_once cpython
check t_rsplit_once("\u{1c6}\u{ce}\u{a0}!\u{ff41}\u{149}f\u{ff43}\u{5d9}\u{418}z\u{435}~\u{1c4}", "\u{ff43}\u{5d9}") == ["\u{1c6}\u{ce}\u{a0}!\u{ff41}\u{149}f", "\u{418}z\u{435}~\u{1c4}"]
# rsplit_once cpython
check t_rsplit_once("\u{ff41}\u{13a0}\u{307}\u{438}\u{2170}\u{378}\u{1f88}\u{2028}~", "\u{e9}") == []
# rsplit_once cpython
check t_rsplit_once("\u{ff41}\u{13a0}\u{307}\u{438}\u{2170}\u{378}\u{1f88}\u{2028}~", "\u{2170}\u{378}") == ["\u{ff41}\u{13a0}\u{307}\u{438}", "\u{1f88}\u{2028}~"]
# rsplit_once cpython
check t_rsplit_once("@\u{ff23}\u{212b}\u{24d0}\u{b}", "aa") == []
# rsplit_once cpython
check t_rsplit_once("@\u{ff23}\u{212b}\u{24d0}\u{b}", "\u{212b}\u{24d0}") == ["@\u{ff23}", "\u{b}"]
# rsplit_once derived
check t_rsplit_once("@\u{ff23}\u{212b}\u{24d0}\u{b}", "") == ["@\u{ff23}\u{212b}\u{24d0}\u{b}", ""]
