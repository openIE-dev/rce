check t_rfind_in("A", "", -3, 4) == 1
# rfind_in derived
check t_rfind_in("A", "", 1, 2) == 1
# rfind_in cpython
check t_rfind_in("A", "", 1, 0) == -1
# rfind_in cpython
check t_rfind_in("A", "\u{3a3}", 1, 0) == -1
