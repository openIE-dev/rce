check t_slice_step("\u{390}j\u{2126}\u{672c}7\u{5ea}\u{30c6}o\u{926}\u{1f88}@\u{3042}", none, none, -1) == "\u{3042}@\u{1f88}\u{926}o\u{30c6}\u{5ea}7\u{672c}\u{2126}j\u{390}"
