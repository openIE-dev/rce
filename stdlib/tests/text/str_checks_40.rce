check t_slice_step("t\u{440}\u{438}\u{639}\u{0}\u{301}", none, none, -1) == "\u{301}\u{0}\u{639}\u{438}\u{440}t"
# slice_step cpython
check t_slice_step("\u{1c}\u{440}\u{415}\u{e0}'\u{200e}\u{43c}\u{1c8}\u{fc}\u{412}*\u{2028}\u{94d}", none, some(-3), 3) == "\u{1c}\u{e0}\u{43c}\u{412}"
# slice_step cpython
check t_slice_step("\u{1c}\u{440}\u{415}\u{e0}'\u{200e}\u{43c}\u{1c8}\u{fc}\u{412}*\u{2028}\u{94d}", none, none, -1) == "\u{94d}\u{2028}*\u{412}\u{fc}\u{1c8}\u{43c}\u{200e}'\u{e0}\u{415}\u{440}\u{1c}"
# slice_step cpython
check t_slice_step("\u{1c}\u{440}\u{415}\u{e0}'\u{200e}\u{43c}\u{1c8}\u{fc}\u{412}*\u{2028}\u{94d}", some(-14), none, 3) == "\u{1c}\u{e0}\u{43c}\u{412}\u{94d}"
# slice_step cpython
check t_slice_step("\u{1c}\u{440}\u{415}\u{e0}'\u{200e}\u{43c}\u{1c8}\u{fc}\u{412}*\u{2028}\u{94d}", none, none, -1) == "\u{94d}\u{2028}*\u{412}\u{fc}\u{1c8}\u{43c}\u{200e}'\u{e0}\u{415}\u{440}\u{1c}"
# slice_step cpython
check t_slice_step("\u{b2}\u{200b}\u{5e2}\u{10428}<\u{e9}p\u{415}l\u{d55c}me", none, some(5), 3) == "\u{b2}\u{10428}"
# slice_step cpython
check t_slice_step("\u{b2}\u{200b}\u{5e2}\u{10428}<\u{e9}p\u{415}l\u{d55c}me", none, none, 1) == "\u{b2}\u{200b}\u{5e2}\u{10428}<\u{e9}p\u{415}l\u{d55c}me"
# slice_step cpython
check t_slice_step("\u{b2}\u{200b}\u{5e2}\u{10428}<\u{e9}p\u{415}l\u{d55c}me", none, some(8), -1) == "em\u{d55c}"
# slice_step cpython
check t_slice_step("\u{b2}\u{200b}\u{5e2}\u{10428}<\u{e9}p\u{415}l\u{d55c}me", none, none, -1) == "em\u{d55c}l\u{415}p\u{e9}<\u{10428}\u{5e2}\u{200b}\u{b2}"
# slice_step cpython
check t_slice_step("9g\u{24b6}]\u{30ad}\u{212a}\u{13f8}i>\u{394}\u{432}\u{ff22}", none, some(6), -3) == "\u{ff22}>"
# slice_step cpython
check t_slice_step("9g\u{24b6}]\u{30ad}\u{212a}\u{13f8}i>\u{394}\u{432}\u{ff22}", none, none, 2) == "9\u{24b6}\u{30ad}\u{13f8}>\u{432}"
# slice_step cpython
check t_slice_step("9g\u{24b6}]\u{30ad}\u{212a}\u{13f8}i>\u{394}\u{432}\u{ff22}", some(-1), none, -3) == "\u{ff22}>\u{212a}\u{24b6}"
# slice_step cpython
check t_slice_step("9g\u{24b6}]\u{30ad}\u{212a}\u{13f8}i>\u{394}\u{432}\u{ff22}", none, none, -1) == "\u{ff22}\u{432}\u{394}>i\u{13f8}\u{212a}\u{30ad}]\u{24b6}g9"
# slice_step cpython
check t_slice_step("\u{390}j\u{2126}\u{672c}7\u{5ea}\u{30c6}o\u{926}\u{1f88}@\u{3042}", some(-4), none, -2) == "\u{926}\u{30c6}7\u{2126}\u{390}"
# slice_step cpython
check t_slice_step("\u{390}j\u{2126}\u{672c}7\u{5ea}\u{30c6}o\u{926}\u{1f88}@\u{3042}", none, some(-7), 3) == "\u{390}\u{672c}"
# slice_step cpython
check t_slice_step("\u{390}j\u{2126}\u{672c}7\u{5ea}\u{30c6}o\u{926}\u{1f88}@\u{3042}", some(-12), some(6), -3) == ""
