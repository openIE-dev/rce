# generated by scripts/gen/xml_gen.py; do not edit
# canonical dump: "<{ns}local a=[v]...>" children "</>", attributes as
# written minus namespace declarations, comments dropped (as lxml's tree)
fn xc(x: &Xml, n: i64) -> text bound 256
    if x.nk[n as usize] == TEXT
        return copy(x.txt[n as usize])
    var o = "<{" + x.ns[n as usize] + "}" + x.name[n as usize]
    for k in 0..x.an[n as usize].len()
        let a = copy(x.an[n as usize][k])
        if a != "xmlns" and not a.startswith("xmlns:")
            o = o + " " + a + "=[" + x.av[n as usize][k] + "]"
    o = o + ">"
    for k in x.kids[n as usize]
        o = o + xc(x, k)
    return o + "</>"
fn xcanon(s: text) -> text
    let x = parse(&s)
    if not x.ok
        return "err " + x.why
    return xc(&x, doc_root(&x))
# 147/test147.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the first clause that evaluates to true - and only that clause - is executed.\nOnly one event should be raised, and it should be bar --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n  <if cond=\"false\">\n    <raise event=\"foo\"/>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n  <elseif cond=\"true\"/>\n    <raise event=\"bar\"/>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n  <else/>\n    <raise event=\"baz\"/>\n   <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </if>\n   <raise event=\"bat\"/>\n    </onentry>\n  <transition event=\"bar\" cond=\"Var1==1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n   \n </state>\n\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  <{http://www.w3.org/2005/07/scxml}if cond=[false]>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n  <{http://www.w3.org/2005/07/scxml}elseif cond=[true]></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n  <{http://www.w3.org/2005/07/scxml}else></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[baz]></>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}raise event=[bat]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] cond=[Var1==1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   \n </>\n\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 149/test149.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that neither if clause executes, so that bat is the only event raised. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n  <if cond=\"false\">\n    <raise event=\"foo\"/>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n  <elseif cond=\"false\"/>\n    <raise event=\"bar\"/>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n </if>\n   <raise event=\"bat\"/>\n    </onentry>\n  <transition event=\"bat\" cond=\"Var1==0\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  <{http://www.w3.org/2005/07/scxml}if cond=[false]>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n  <{http://www.w3.org/2005/07/scxml}elseif cond=[false]></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n </>\n   <{http://www.w3.org/2005/07/scxml}raise event=[bat]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[bat] cond=[Var1==0] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 151/test151.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that foreach causes a new variable to be declared if 'item' doesn't already exist.  Also\ntest that it will use an existing var if it does exist. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\"/>\n  <data id=\"Var2\"/>\n  <data id=\"Var3\">\n    [1,2,3]\n    </data>\n  </datamodel>\n  \n   <state id=\"s0\">\n      <onentry>\n<!-- first use declared variables -->\n        <foreach item=\"Var1\" index=\"Var2\" array=\"Var3\"/>\n        <raise event=\"foo\"/>\n        </onentry>\n   <transition event=\"error\" target=\"fail\"/>\n   <transition event=\"*\" target=\"s1\"/> \n   </state>\n   \n<state id=\"s1\">\n     <onentry>\n<!-- now use undeclared variables -->\n        <foreach item=\"Var4\" index=\"Var5\" array=\"Var3\"/>\n        <raise event=\"bar\"/>\n        </onentry>\n   <transition event=\"error\" target=\"fail\"/>\n   <transition event=\"*\" target=\"s2\"/> \n   </state>\n\n<state id=\"s2\">\n  <!-- check that var5 is bound -->\n  <transition cond=\"Var5\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var3]>\n    [1,2,3]\n    </>\n  </>\n  \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n\n        <{http://www.w3.org/2005/07/scxml}foreach item=[Var1] index=[Var2] array=[Var3]></>\n        <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n        </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[fail]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[s1]></> \n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n     <{http://www.w3.org/2005/07/scxml}onentry>\n\n        <{http://www.w3.org/2005/07/scxml}foreach item=[Var4] index=[Var5] array=[Var3]></>\n        <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n        </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[fail]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[s2]></> \n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n  \n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var5] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n\n\n</>"
# 153/test153.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that foreach goes over the array in the right order.  since the array contains 1 2 3, we compare the current \nvalue with the previous value, which is stored in var1. The current value should always be larger.  If\nit ever isn't, set Var4 to 0, indicating failure --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/> <!-- contains the previous value -->\n  <data id=\"Var2\"/> <!-- the item which will contain the current value -->\n  <data id=\"Var3\">\n    [1,2,3]\n    </data>\n  <data id=\"Var4\" expr=\"1\"/> <!-- 1 if success, 0 if failure -->\n  </datamodel>\n  \n   <state id=\"s0\">\n      <onentry>\n        <foreach item=\"Var2\" array=\"Var3\">\n         <if cond=\"Var1&lt;Var2\">\n         <assign location=\"Var1\" expr=\"Var2\"/>\n         <else/>\n         <!-- values are out of order, record failure -->\n         <assign location=\"Var4\" expr=\"0\"/>\n         </if>\n          </foreach>\n        </onentry>\n\n  <!-- check that var1 has its original value  -->\n  <transition cond=\"Var4==0\" target=\"fail\"/>\n  <transition target=\"pass\"/>\n  </state> \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></> \n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></> \n  <{http://www.w3.org/2005/07/scxml}data id=[Var3]>\n    [1,2,3]\n    </>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var4] expr=[1]></> \n  </>\n  \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n        <{http://www.w3.org/2005/07/scxml}foreach item=[Var2] array=[Var3]>\n         <{http://www.w3.org/2005/07/scxml}if cond=[Var1<Var2]>\n         <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var2]></>\n         <{http://www.w3.org/2005/07/scxml}else></>\n         \n         <{http://www.w3.org/2005/07/scxml}assign location=[Var4] expr=[0]></>\n         </>\n          </>\n        </>\n\n  \n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var4==0] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[pass]></>\n  </> \n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n\n\n</>"
# 156/test156.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that an error causes the foreach to stop execution.  The second piece of executable content\nshould cause an error, so var1 should be incremented only once --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  <data id=\"Var2\"/>\n  <data id=\"Var3\">\n  [1,2,3]\n  </data>\n  </datamodel>\n  \n   <state id=\"s0\">\n      <onentry>\n        <foreach item=\"Var2\" array=\"Var3\">\n          <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n          <!-- assign an illegal value to a non-existent var -->\n          <assign location=\"Var5\" expr=\"return\"/>\n          </foreach>\n        </onentry>\n\n  <transition cond=\"Var1==1\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state> \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var3]>\n  [1,2,3]\n  </>\n  </>\n  \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n        <{http://www.w3.org/2005/07/scxml}foreach item=[Var2] array=[Var3]>\n          <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n          \n          <{http://www.w3.org/2005/07/scxml}assign location=[Var5] expr=[return]></>\n          </>\n        </>\n\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </> \n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n</>"
# 159/test159.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that any error raised by an element of executable content causes all subsequent elements to be skipped.\nThe send tag will raise an error so var1 should not be incremented.  If it is fail, otherwise succeed --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <send event=\"thisWillFail\" target=\"baz\"/>\n   <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onentry>\n  <transition cond=\"Var1==1\" target=\"fail\"/>\n  <transition target=\"pass\"/>\n </state>\n\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send event=[thisWillFail] target=[baz]></>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[pass]></>\n </>\n\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 173/test173.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that targetexpr uses the current value of var1, not its initial value\n(If it uses the initial value, it will generate an error.  If it uses the current value, event1 will be raised  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"27\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"'#_internal'\"/>\n   <send targetexpr=\"Var1\" event=\"event1\"/>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[27]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=['#_internal']></>\n   <{http://www.w3.org/2005/07/scxml}send targetexpr=[Var1] event=[event1]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 175/test175.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that delayexpr uses the current value of var1, not its initial value\n(If it uses the initial value, event2 will be generated first, before event1.  If it uses the current value, \nevent1 will be raised first.  Succeed if event1 occurs before event2, otherwise fail --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"'0s'\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"'1s'\"/>\n   <send delayexpr=\"Var1\" event=\"event2\"/>\n   <send delayexpr=\"'.5s'\" event=\"event1\"/>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"s1\"/>\n  <transition event=\"event2\" target=\"fail\"/>\n </state>\n\n<state id=\"s1\">\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=['0s']></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=['1s']></>\n   <{http://www.w3.org/2005/07/scxml}send delayexpr=[Var1] event=[event2]></>\n   <{http://www.w3.org/2005/07/scxml}send delayexpr=['.5s'] event=[event1]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s1]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[fail]></>\n </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 178/test178.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that multiple key/value pairs are included, even when the keys are the same.\nThis is a manual test.  The tester must look at the log output and verify that both\nkeys are there.  (This test uses the SCXML Event I/O processor, which is the only\none that all platforms must support.  It does not specify the message format, so \nwe cannot test _event.raw directly.  Therefore we print it out for visual \ninspection.) --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n  \n<state id=\"s0\">\n  <onentry>\n   <send event=\"event1\">\n    <param name=\"Var1\" expr=\"2\"/>\n    <param name=\"Var1\" expr=\"3\"/>\n    </send>\n     </onentry>\n\n  <transition event=\"event1\" target=\"final\">\n   <log label=\"_event \" expr=\"_event.raw\"/>\n   </transition>\n  <transition event=\"*\" target=\"fail\"/>\n \n </state>\n\n\n<final id=\"final\"/>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send event=[event1]>\n    <{http://www.w3.org/2005/07/scxml}param name=[Var1] expr=[2]></>\n    <{http://www.w3.org/2005/07/scxml}param name=[Var1] expr=[3]></>\n    </>\n     </>\n\n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[final]>\n   <{http://www.w3.org/2005/07/scxml}log label=[_event ] expr=[_event.raw]></>\n   </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n \n </>\n\n\n<{http://www.w3.org/2005/07/scxml}final id=[final]></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 183/test183.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that <send> stores the value of the sendid in idlocation.  If it does,\nvar1 has a value and we pass.  Otherwise we fail  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\"/>\n\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <send event=\"event1\" idlocation=\"Var1\"/>\n    </onentry>\n    \n  <transition cond=\"Var1\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n </state>\n\n     \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send event=[event1] idlocation=[Var1]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </>\n\n     \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 186/test186.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that <send> evals its args when it is evaluated, not when the delay interval expires and the\nmessage is actually sent.  If it does, aParam will have the value of 1 (even though var1 has been incremented\nin the interval.)  If var2 ends up == 1, we pass.  Otherwise we fail  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n <data id=\"Var1\" expr=\"1\"/>\n <data id=\"Var2\"/>\n </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n   <send event=\"event1\" delayexpr=\"'1s'\">\n     <param name=\"aParam\" expr=\"Var1\"/>\n     </send>\n   <assign location=\"Var1\" expr=\"2\"/>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"s1\">\n    <assign location=\"Var2\" expr=\"_event.data.aParam\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n<state id=\"s1\">\n  <transition cond=\"Var2==1\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n       \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send event=[event1] delayexpr=['1s']>\n     <{http://www.w3.org/2005/07/scxml}param name=[aParam] expr=[Var1]></>\n     </>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[2]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s1]>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[_event.data.aParam]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var2==1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n       \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 189/test189.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that #_internal as a target of <send> puts the event on the internal queue.  If it does,\nevent1 will be processed before event2, because event1 is added to the internal queue while event2 is\nadded to the external queue (event though event2 is generated first)  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n  <onentry>\n   <!-- goes to the external queue -->\n   <send event=\"event2\"/>\n   <!-- to the internal queue -->\n   <send event=\"event1\" target=\"#_internal\"/>\n    </onentry>\n \n <!-- once we've entered the state, we should check for internal events first -->   \n  <transition event=\"event1\" target=\"pass\"/>\n  <transition event=\"event2\" target=\"fail\"/>\n </state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   \n   <{http://www.w3.org/2005/07/scxml}send event=[event2]></>\n   \n   <{http://www.w3.org/2005/07/scxml}send event=[event1] target=[#_internal]></>\n    </>\n \n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[fail]></>\n </>\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 191/test191.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that #_parent works as  a target of  <send> .  a subscript is invoked and sends the event \nchildToParent to its parent session (ths session) using #_parent as the target. If we get this event, we\npass, otherwise we fail.  The timer insures that some event is generated and that the test does not hang. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n    <onentry>\n      <send event=\"timeout\" delay=\"5s\"/>\n      </onentry>\n    <invoke type=\"scxml\">\n    <content>\n       <!-- send an event to the parent session using #_parent as the target -->\n        <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n          <state id=\"sub0\">\n            <onentry>\n             <send event=\"childToParent\" target=\"#_parent\"/>\n             </onentry>\n          <transition target=\"subFinal\"/>\n         </state>\n       <final id=\"subFinal\"/>\n        </scxml> \n    </content>\n    </invoke>\n    <transition event=\"childToParent\" target=\"pass\"/>\n    <transition event=\"*\" target=\"fail\"/>\n</state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n      <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[5s]></>\n      </>\n    <{http://www.w3.org/2005/07/scxml}invoke type=[scxml]>\n    <{http://www.w3.org/2005/07/scxml}content>\n       \n        <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n          <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n            <{http://www.w3.org/2005/07/scxml}onentry>\n             <{http://www.w3.org/2005/07/scxml}send event=[childToParent] target=[#_parent]></>\n             </>\n          <{http://www.w3.org/2005/07/scxml}transition target=[subFinal]></>\n         </>\n       <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n        </> \n    </>\n    </>\n    <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] target=[pass]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n</>\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 193/test193.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that omitting target and targetexpr of <send> when using the\nSCXML event i/o processor puts the event on the external queue.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n  <onentry>\n  \t  <send event=\"internal\"/>\n   <!-- this should put event1 in the external queue -->\n   <send event=\"event1\" type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\"/>\n   <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n  \n  <transition event=\"event1\" target=\"fail\"/>\n  <transition event=\"internal\" target=\"s1\"/>\n </state>\n \n <state id=\"s1\">\n \t<transition event=\"event1\" target=\"pass\"/>\n \t<transition event=\"timeout\" target=\"fail\"/>\n \t\n \t</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  \t  <{http://www.w3.org/2005/07/scxml}send event=[internal]></>\n   \n   <{http://www.w3.org/2005/07/scxml}send event=[event1] type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor]></>\n   <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    </>\n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[internal] target=[s1]></>\n </>\n \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n \t<{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[pass]></>\n \t<{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n \t\n \t</>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 198/test198.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that if type is not provided <send> uses the scxml event i/o processor.  The only way to tell\nwhat processor was used is to look at the origintype of the resulting event  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n<state id=\"s0\">\n  <onentry>\n   <send event=\"event1\"/>\n   <send event=\"timeout\"/>\n    </onentry>\n\n  \n  <transition event=\"event1\" cond=\" _event.origintype == 'http://www.w3.org/TR/scxml/#SCXMLEventProcessor'\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send event=[event1]></>\n   <{http://www.w3.org/2005/07/scxml}send event=[timeout]></>\n    </>\n\n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] cond=[ _event.origintype == 'http://www.w3.org/TR/scxml/#SCXMLEventProcessor'] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 200/test200.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that the processor supports the scxml event i/o processor --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n<state id=\"s0\">\n  <onentry>\n   <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" event=\"event1\"/>\n   <send event=\"timeout\"/>\n    </onentry>\n \n \n  <transition event=\"event1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor] event=[event1]></>\n   <{http://www.w3.org/2005/07/scxml}send event=[timeout]></>\n    </>\n \n \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 205/test205.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that the processor doesn't  change the message.  We can't test that it never does this, but\nat least we can check that the event name and included data are the same as we sent.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n   <data id=\"Var1\"/>\n   </datamodel>\n   \n<state id=\"s0\">\n  <onentry>\n   <send event=\"event1\">\n     <param name=\"aParam\" expr=\"1\"/>\n     </send>\n   <send event=\"timeout\"/>\n    </onentry>\n \n \n  <transition event=\"event1\" target=\"s1\">\n     <assign location=\"Var1\" expr=\"_event.data.aParam\"/>\n     </transition>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1==1\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state> \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send event=[event1]>\n     <{http://www.w3.org/2005/07/scxml}param name=[aParam] expr=[1]></>\n     </>\n   <{http://www.w3.org/2005/07/scxml}send event=[timeout]></>\n    </>\n \n \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s1]>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.data.aParam]></>\n     </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </> \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 208/test208.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that cancel works.  We cancel delayed event1.  If cancel works, we get event2 first and pass.  If\nwe get event1 or an error first, cancel didn't work and we fail.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n   \n<state id=\"s0\">\n  <onentry>\n   <send id=\"foo\" event=\"event1\" delayexpr=\"'1s'\"/>\n   <send event=\"event2\" delayexpr=\"'1.5s'\"/>\n   <cancel sendid=\"foo\"/>\n    </onentry>\n\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n \n </state>\n\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send id=[foo] event=[event1] delayexpr=['1s']></>\n   <{http://www.w3.org/2005/07/scxml}send event=[event2] delayexpr=['1.5s']></>\n   <{http://www.w3.org/2005/07/scxml}cancel sendid=[foo]></>\n    </>\n\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n \n </>\n\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 215/test215.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that typexpr is evaluated at runtime.  If the original value of var1 is used, the invocation\nwill fail (test215sub1.scxml is not of type 'foo', even if the platform supports foo as a type).  If\nthe runtime value is used, the invocation will succeed --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"'foo'\"/>\n   </datamodel> \n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"5s\"/>\n    <assign location=\"Var1\" expr=\"'http://www.w3.org/TR/scxml/'\"/>\n    </onentry>\n  <invoke typeexpr=\"Var1\">\n    <content>\n        <!-- when invoked, terminate returning done.invoke. This proves that the invocation succeeded.   -->\n        <scxml initial=\"subFinal\" datamodel=\"ecmascript\" version=\"1.0\">\n      <final id=\"subFinal\"/>\n        </scxml>\n    </content>\n    </invoke>\n  <transition event=\"done.invoke\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/> \n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=['foo']></>\n   </> \n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[5s]></>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=['http://www.w3.org/TR/scxml/']></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}invoke typeexpr=[Var1]>\n    <{http://www.w3.org/2005/07/scxml}content>\n        \n        <{http://www.w3.org/2005/07/scxml}scxml initial=[subFinal] datamodel=[ecmascript] version=[1.0]>\n      <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n        </>\n    </>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n</>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 216/test216sub1.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- when invoked, terminate returning done.invoke. This proves that the invocation succeeded.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"final\" version=\"1.0\" datamodel=\"ecmascript\">\n\n<final id=\"final\"/>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[final] version=[1.0] datamodel=[ecmascript]>\n\n<{http://www.w3.org/2005/07/scxml}final id=[final]></>\n\n</>"
# 223/test223.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that idlocation is supported.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"Var1\"/>\n   </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n     <invoke type=\"http://www.w3.org/TR/scxml/\" idlocation=\"Var1\">\n     <content>\n     <!-- when invoked, terminate returning done.invoke. This proves that the invocation succeeded.   -->\n       <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n       <final id=\"subFinal\"/>\n        </scxml>\n       </content>\n    </invoke>\n  <transition event=\"*\" target=\"s1\"/>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n   </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    </>\n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] idlocation=[Var1]>\n     <{http://www.w3.org/2005/07/scxml}content>\n     \n       <{http://www.w3.org/2005/07/scxml}scxml initial=[subFinal] version=[1.0] datamodel=[ecmascript]>\n       <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n        </>\n       </>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[s1]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 225/test225.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that the automatically generated id is unique, we call invoke twice and compare the ids.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"Var1\"/>\n   <data id=\"Var2\"/>\n   </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n\n   <invoke type=\"http://www.w3.org/TR/scxml/\" idlocation=\"Var1\">\n      <content>\n      <scxml initial=\"subFinal1\" version=\"1.0\" datamodel=\"ecmascript\">\n         <final id=\"subFinal1\"/>\n        </scxml>\n     </content>\n     </invoke>\n   <invoke type=\"http://www.w3.org/TR/scxml/\" idlocation=\"Var2\">\n      <content>\n      <scxml initial=\"subFinal2\" version=\"1.0\" datamodel=\"ecmascript\">\n         <final id=\"subFinal2\"/>\n        </scxml>\n     </content>\n     </invoke>\n\n  <transition event=\"*\" target=\"s1\"/>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1===Var2\" target=\"fail\"/>\n  <transition target=\"pass\"/>\n  </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n   </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    </>\n\n   <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] idlocation=[Var1]>\n      <{http://www.w3.org/2005/07/scxml}content>\n      <{http://www.w3.org/2005/07/scxml}scxml initial=[subFinal1] version=[1.0] datamodel=[ecmascript]>\n         <{http://www.w3.org/2005/07/scxml}final id=[subFinal1]></>\n        </>\n     </>\n     </>\n   <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] idlocation=[Var2]>\n      <{http://www.w3.org/2005/07/scxml}content>\n      <{http://www.w3.org/2005/07/scxml}scxml initial=[subFinal2] version=[1.0] datamodel=[ecmascript]>\n         <{http://www.w3.org/2005/07/scxml}final id=[subFinal2]></>\n        </>\n     </>\n     </>\n\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[s1]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1===Var2] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[pass]></>\n  </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 226/test226sub1.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- when invoked, if var1 has a value notify parent. Then terminate.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n<datamodel>\n  <data id=\"Var1\"/>\n  </datamodel>\n\n<state id=\"s0\">\n  <transition cond=\"Var1\" target=\"final\">\n    <send target=\"#_parent\" event=\"varBound\"/>\n    </transition>\n  <transition target=\"final\"/>\n  </state>\n  \n<final id=\"final\"/>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n  </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1] target=[final]>\n    <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[varBound]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition target=[final]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}final id=[final]></>\n\n</>"
# 229/test229.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that autofoward works. If the child  process receives back a copy of the\nchildToParent event that it sends to this doc, it sends eventReceived, signalling success. (Note\nthat this doc is not required to process that event explicitly.  It should be forwarded in any case.) Otherwise\nit eventually times out and the done.invoke signals failure   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    </onentry>\n \n  <invoke type=\"http://www.w3.org/TR/scxml/\" autoforward=\"true\">\n    <content>\n      <!-- when invoked, send childToParent to parent.  \n      If it is forwarded back to us, send\n      eventReceived to signal success and terminate.  \n      Otherwise wait for timer to expire and terminate.  -->\n     <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n        <state id=\"sub0\">\n          <onentry>\n             <send target=\"#_parent\" event=\"childToParent\"/> \n              <send event=\"timeout\" delay=\"3s\"/> \n            </onentry> \n         <transition event=\"childToParent\" target=\"subFinal\">\n         <send target=\"#_parent\" event=\"eventReceived\"/>\n          </transition>\n           <transition event=\"*\" target=\"subFinal\"/>\n       </state>\n        <final id=\"subFinal\"/>\n        </scxml>\n    </content>\n    </invoke>\n\n  <transition event=\"childToParent\"/>\n  <transition event=\"eventReceived\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></>\n    </>\n \n  <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] autoforward=[true]>\n    <{http://www.w3.org/2005/07/scxml}content>\n      \n     <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n        <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n          <{http://www.w3.org/2005/07/scxml}onentry>\n             <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[childToParent]></> \n              <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></> \n            </> \n         <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] target=[subFinal]>\n         <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[eventReceived]></>\n          </>\n           <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[subFinal]></>\n       </>\n        <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n        </>\n    </>\n    </>\n\n  <{http://www.w3.org/2005/07/scxml}transition event=[childToParent]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[eventReceived] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 232/test232.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that a parent process can receive multiple events from a child process   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    </onentry>\n  <invoke type=\"http://www.w3.org/TR/scxml/\">\n    <content>\n    <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n      <final id=\"subFinal\">\n           <onentry>\n             <send target=\"#_parent\" event=\"childToParent1\"/> \n               <send target=\"#_parent\" event=\"childToParent2\"/>\n             </onentry> \n       </final>\n         </scxml>\n    </content>\n    </invoke>\n  <transition event=\"timeout\" target=\"fail\"/>\n   \n \n  <state id=\"s01\">\n  <transition event=\"childToParent1\" target=\"s02\"/>\n </state>\n \n <state id=\"s02\">\n   <transition event=\"childToParent2\" target=\"s03\"/>\n   </state>\n   \n<state id=\"s03\">\n  <transition event=\"done.invoke\" target=\"pass\"/>\n  </state>   \n\n</state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n    <{http://www.w3.org/2005/07/scxml}content>\n    <{http://www.w3.org/2005/07/scxml}scxml initial=[subFinal] version=[1.0] datamodel=[ecmascript]>\n      <{http://www.w3.org/2005/07/scxml}final id=[subFinal]>\n           <{http://www.w3.org/2005/07/scxml}onentry>\n             <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[childToParent1]></> \n               <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[childToParent2]></>\n             </> \n       </>\n         </>\n    </>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n   \n \n  <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[childToParent1] target=[s02]></>\n </>\n \n <{http://www.w3.org/2005/07/scxml}state id=[s02]>\n   <{http://www.w3.org/2005/07/scxml}transition event=[childToParent2] target=[s03]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s03]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[pass]></>\n  </>   \n\n</>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 234/test234.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that only finalize markup in the invoking state runs.  the first invoked process will\nreturn 2 in _event.data.aParam, while second invoked process sleeps without returning any events. \nOnly the first finalize should execute.  So when we get to s1 var1 should have value 2 but \nvar2 should still be set to 1  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"p0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n  <data id=\"Var2\" expr=\"1\"/>\n  </datamodel>\n<parallel id=\"p0\">\n    <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    </onentry>   \n    <transition event=\"timeout\" target=\"fail\"/>  \n    \n   <state id=\"p01\">\n    <invoke type=\"http://www.w3.org/TR/scxml/\">\n       <content>\n       <scxml version=\"1.0\" initial=\"subFinal1\" datamodel=\"ecmascript\">\n          <final id=\"subFinal1\">\n           <onentry>\n            <send target=\"#_parent\" event=\"childToParent\">\n            <param name=\"aParam\" expr=\"2\"/>\n          </send> \n         </onentry> \n          </final>\n            </scxml>\n         </content>\n      <finalize>\n        <assign location=\"Var1\" expr=\"_event.data.aParam\"/>\n        </finalize>\n        </invoke>\n      \n      <transition event=\"childToParent\" cond=\"Var1==2\" target=\"s1\"/>\n       <transition event=\"childToParent\" target=\"fail\"/>\n    </state> \n\n   <state id=\"p02\">\n     <invoke type=\"http://www.w3.org/TR/scxml/\">\n       <content>\n       <scxml version=\"1.0\" initial=\"sub0\" datamodel=\"ecmascript\">\n         <state id=\"sub0\">\n           <onentry>\n              <send event=\"timeout\" delay=\"2s\"/>\n            </onentry>\n             <transition event=\"timeout\" target=\"subFinal2\"/>\n             </state>\n              <final id=\"subFinal2\"/>\n              </scxml>\n        </content>\n      <finalize>\n        <assign location=\"Var2\" expr=\"_event.data.aParam\"/>\n         </finalize>\n      </invoke>\n  </state>\n\n</parallel>    \n\n  \n<state id=\"s1\">\n  <transition cond=\"Var2==1\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n  \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[p0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[1]></>\n  </>\n<{http://www.w3.org/2005/07/scxml}parallel id=[p0]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></>\n    </>   \n    <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>  \n    \n   <{http://www.w3.org/2005/07/scxml}state id=[p01]>\n    <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n       <{http://www.w3.org/2005/07/scxml}content>\n       <{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[subFinal1] datamodel=[ecmascript]>\n          <{http://www.w3.org/2005/07/scxml}final id=[subFinal1]>\n           <{http://www.w3.org/2005/07/scxml}onentry>\n            <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[childToParent]>\n            <{http://www.w3.org/2005/07/scxml}param name=[aParam] expr=[2]></>\n          </> \n         </> \n          </>\n            </>\n         </>\n      <{http://www.w3.org/2005/07/scxml}finalize>\n        <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.data.aParam]></>\n        </>\n        </>\n      \n      <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] cond=[Var1==2] target=[s1]></>\n       <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] target=[fail]></>\n    </> \n\n   <{http://www.w3.org/2005/07/scxml}state id=[p02]>\n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n       <{http://www.w3.org/2005/07/scxml}content>\n       <{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[sub0] datamodel=[ecmascript]>\n         <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n           <{http://www.w3.org/2005/07/scxml}onentry>\n              <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n            </>\n             <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[subFinal2]></>\n             </>\n              <{http://www.w3.org/2005/07/scxml}final id=[subFinal2]></>\n              </>\n        </>\n      <{http://www.w3.org/2005/07/scxml}finalize>\n        <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[_event.data.aParam]></>\n         </>\n      </>\n  </>\n\n</>    \n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var2==1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 236/test236.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that done.invoke.id event is the last event we receive.  the invoked process sends childToParent\nin the exit handler of its final state.  We should get it before the done.invoke, and we should get no\nevents after the done.invoke.  Hence timeout indicates success   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delayexpr=\"'2s'\"/>\n    </onentry>\n  <invoke type=\"http://www.w3.org/TR/scxml/\">\n    <content>\n      <scxml initial=\"subFinal\" version=\"1.0\" datamodel=\"ecmascript\">\n       <final id=\"subFinal\">\n          <onexit>\n           <send target=\"#_parent\" event=\"childToParent\"/>\n            </onexit>\n           </final>\n         </scxml>\n      </content>\n      </invoke>\n \n  <transition event=\"childToParent\" target=\"s1\"/>    \n  <transition event=\"done.invoke\" target=\"fail\"/>\n</state>\n\n<state id=\"s1\">\n  <!-- here we should get done.invoke -->\n  <transition event=\"done.invoke\" target=\"s2\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n<state id=\"s2\">\n  <transition event=\"timeout\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>   \n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delayexpr=['2s']></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n    <{http://www.w3.org/2005/07/scxml}content>\n      <{http://www.w3.org/2005/07/scxml}scxml initial=[subFinal] version=[1.0] datamodel=[ecmascript]>\n       <{http://www.w3.org/2005/07/scxml}final id=[subFinal]>\n          <{http://www.w3.org/2005/07/scxml}onexit>\n           <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[childToParent]></>\n            </>\n           </>\n         </>\n      </>\n      </>\n \n  <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] target=[s1]></>    \n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[fail]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[s2]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>   \n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 239/test239.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that markup can be specified both by 'src' and by <content>  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n    <transition event=\"timeout\" target=\"fail\"/>\n    \n   <state id=\"s01\">\n     <invoke type=\"http://www.w3.org/TR/scxml/\" src=\"file:test239sub1.scxml\"/>\n     <transition event=\"done.invoke\" target=\"s02\"/>\n   </state>\n\n<state id=\"s02\">\n      <invoke type=\"http://www.w3.org/TR/scxml/\">\n        <!-- identical to test239sub1.scxml.  -->\n          <content>\n            <scxml version=\"1.0\" initial=\"final\" datamodel=\"ecmascript\">\n             <final id=\"final\"/>\n              </scxml>\n            </content>\n        </invoke>\n \n  <transition event=\"done.invoke\" target=\"pass\"/>\n  </state>\n  \n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n    </>\n    <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n    \n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] src=[file:test239sub1.scxml]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[s02]></>\n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s02]>\n      <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n        \n          <{http://www.w3.org/2005/07/scxml}content>\n            <{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[final] datamodel=[ecmascript]>\n             <{http://www.w3.org/2005/07/scxml}final id=[final]></>\n              </>\n            </>\n        </>\n \n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[pass]></>\n  </>\n  \n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 240/test240.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that datamodel values can be specified both by 'namelist' and by <param>.\ninvoked child will return success if its Var1 is set to 1, failure otherwise. This\ntest will fail schema validation because of the multiple occurences of Var1, but\nshould run correctly. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n  </datamodel>\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n    <transition event=\"timeout\" target=\"fail\"/>\n   \n   <state id=\"s01\">\n     <invoke type=\"http://www.w3.org/TR/scxml/\" namelist=\"Var1\">\n       <content>\n         <scxml initial=\"sub01\" version=\"1.0\" datamodel=\"ecmascript\">\n           <datamodel>\n             <data id=\"Var1\" expr=\"0\"/>\n               </datamodel>\n                   <state id=\"sub01\">\n                      <transition cond=\"Var1===1\" target=\"subFinal1\">\n                     <send target=\"#_parent\" event=\"success\"/>\n                     </transition>\n                  <transition target=\"subFinal1\">\n                 <send target=\"#_parent\" event=\"failure\"/>\n                 </transition>\n               </state>\n         <final id=\"subFinal1\"/>\n          </scxml>\n        </content>\n        </invoke>\n     <transition event=\"success\" target=\"s02\"/>\n     <transition event=\"failure\" target=\"fail\"/>\n   </state>\n\n<state id=\"s02\">\n      <invoke type=\"http://www.w3.org/TR/scxml/\">\n          <param name=\"Var1\" expr=\"1\"/>\n       <content>\n         <scxml initial=\"sub02\" version=\"1.0\" datamodel=\"ecmascript\">\n           <datamodel>\n             <data id=\"Var1\" expr=\"0\"/>\n               </datamodel>\n   \n                  <state id=\"sub02\">\n                      <transition cond=\"Var1==1\" target=\"subFinal2\">\n                     <send target=\"#_parent\" event=\"success\"/>\n                     </transition>\n                  <transition target=\"subFinal2\">\n                 <send target=\"#_parent\" event=\"failure\"/>\n                 </transition>\n               </state>\n         <final id=\"subFinal2\"/>\n          </scxml>\n        </content>\n        </invoke>\n     <transition event=\"success\" target=\"pass\"/>\n     <transition event=\"failure\" target=\"fail\"/>\n  </state>\n \n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n  </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n    </>\n    <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n   \n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] namelist=[Var1]>\n       <{http://www.w3.org/2005/07/scxml}content>\n         <{http://www.w3.org/2005/07/scxml}scxml initial=[sub01] version=[1.0] datamodel=[ecmascript]>\n           <{http://www.w3.org/2005/07/scxml}datamodel>\n             <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n               </>\n                   <{http://www.w3.org/2005/07/scxml}state id=[sub01]>\n                      <{http://www.w3.org/2005/07/scxml}transition cond=[Var1===1] target=[subFinal1]>\n                     <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[success]></>\n                     </>\n                  <{http://www.w3.org/2005/07/scxml}transition target=[subFinal1]>\n                 <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[failure]></>\n                 </>\n               </>\n         <{http://www.w3.org/2005/07/scxml}final id=[subFinal1]></>\n          </>\n        </>\n        </>\n     <{http://www.w3.org/2005/07/scxml}transition event=[success] target=[s02]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[failure] target=[fail]></>\n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s02]>\n      <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n          <{http://www.w3.org/2005/07/scxml}param name=[Var1] expr=[1]></>\n       <{http://www.w3.org/2005/07/scxml}content>\n         <{http://www.w3.org/2005/07/scxml}scxml initial=[sub02] version=[1.0] datamodel=[ecmascript]>\n           <{http://www.w3.org/2005/07/scxml}datamodel>\n             <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n               </>\n   \n                  <{http://www.w3.org/2005/07/scxml}state id=[sub02]>\n                      <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[subFinal2]>\n                     <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[success]></>\n                     </>\n                  <{http://www.w3.org/2005/07/scxml}transition target=[subFinal2]>\n                 <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[failure]></>\n                 </>\n               </>\n         <{http://www.w3.org/2005/07/scxml}final id=[subFinal2]></>\n          </>\n        </>\n        </>\n     <{http://www.w3.org/2005/07/scxml}transition event=[success] target=[pass]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[failure] target=[fail]></>\n  </>\n \n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 242/test242.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that markup specified  by 'src' and by <content> is treated the same way.  That means that\neither we get done.invoke in both cases or in neither case (in which case we timeout) --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout1\" delay=\"1s\"/>\n    </onentry>\n    <transition event=\"timeout\" target=\"fail\"/>\n\n     <invoke type=\"http://www.w3.org/TR/scxml/\" src=\"file:test242sub1.scxml\"/>\n     <transition event=\"done.invoke\" target=\"s02\"/>\n     <transition event=\"timeout1\" target=\"s03\"/>\n   </state>\n\n<state id=\"s02\">\n    <onentry>\n    <send event=\"timeout2\" delay=\"1s\"/>\n    </onentry>\n      <invoke type=\"http://www.w3.org/TR/scxml/\">\n        <!-- identical to test242sub1.scxml.  -->\n          <content>\n            <scxml version=\"1.0\" initial=\"subFinal1\" datamodel=\"ecmascript\">\n             <final id=\"subFinal1\"/>\n              </scxml>\n            </content>\n        </invoke>\n <!-- we got done.invoke last time, so we need it this time too -->\n  <transition event=\"done.invoke\" target=\"pass\"/>\n  <transition event=\"timeout2\" target=\"fail\"/>\n </state>\n \n<state id=\"s03\">\n    <onentry>\n    <send event=\"timeout3\" delay=\"1s\"/>\n    </onentry>\n      <invoke type=\"http://www.w3.org/TR/scxml/\">\n        <!-- identical to test242sub1.scxml.  -->\n          <content>\n            <scxml version=\"1.0\" initial=\"subFinal2\" datamodel=\"ecmascript\">\n             <final id=\"subFinal2\"/>\n              </scxml>\n            </content>\n        </invoke>\n <!-- we got timeout last time, so we need it this time too -->\n  <transition event=\"timeout3\" target=\"pass\"/>\n  <transition event=\"done.invoke\" target=\"fail\"/>\n </state>\n  \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout1] delay=[1s]></>\n    </>\n    <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n\n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] src=[file:test242sub1.scxml]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[s02]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[timeout1] target=[s03]></>\n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s02]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout2] delay=[1s]></>\n    </>\n      <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n        \n          <{http://www.w3.org/2005/07/scxml}content>\n            <{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[subFinal1] datamodel=[ecmascript]>\n             <{http://www.w3.org/2005/07/scxml}final id=[subFinal1]></>\n              </>\n            </>\n        </>\n \n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout2] target=[fail]></>\n </>\n \n<{http://www.w3.org/2005/07/scxml}state id=[s03]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout3] delay=[1s]></>\n    </>\n      <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n        \n          <{http://www.w3.org/2005/07/scxml}content>\n            <{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[subFinal2] datamodel=[ecmascript]>\n             <{http://www.w3.org/2005/07/scxml}final id=[subFinal2]></>\n              </>\n            </>\n        </>\n \n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout3] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[fail]></>\n </>\n  \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 243/test243.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that datamodel values can be specified by param.\ntest240sub1 will return success ifits Var1 is set to 1, failure otherwise.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n   \n      <invoke type=\"http://www.w3.org/TR/scxml/\">\n          <param name=\"Var1\" expr=\"1\"/>\n          <content>\n            <scxml version=\"1.0\" initial=\"sub0\" datamodel=\"ecmascript\">\n             <datamodel>\n              <data id=\"Var1\" expr=\"0\"/>\n                </datamodel>\n   \n            <state id=\"sub0\">\n              <transition cond=\"Var1==1\" target=\"subFinal\">\n                 <send target=\"#_parent\" event=\"success\"/>\n                   </transition>\n                  <transition target=\"subFinal\">\n                   <send target=\"#_parent\" event=\"failure\"/>\n                    </transition>\n                 </state>\n              <final id=\"subFinal\"/>\n               </scxml>\n               </content>\n           </invoke>\n     <transition event=\"success\" target=\"pass\"/>\n     <transition event=\"*\" target=\"fail\"/>\n   </state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n    </>\n   \n      <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n          <{http://www.w3.org/2005/07/scxml}param name=[Var1] expr=[1]></>\n          <{http://www.w3.org/2005/07/scxml}content>\n            <{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[sub0] datamodel=[ecmascript]>\n             <{http://www.w3.org/2005/07/scxml}datamodel>\n              <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n                </>\n   \n            <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n              <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[subFinal]>\n                 <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[success]></>\n                   </>\n                  <{http://www.w3.org/2005/07/scxml}transition target=[subFinal]>\n                   <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[failure]></>\n                    </>\n                 </>\n              <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n               </>\n               </>\n           </>\n     <{http://www.w3.org/2005/07/scxml}transition event=[success] target=[pass]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 245/test245.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that non-existent datamodel values are not set.  Var2 is not defined in \ninvoked child's datamodel.  It will will return success if its Var2 remains unbound, failure otherwise.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var2\" expr=\"3\"/>\n  </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n   \n     <invoke type=\"http://www.w3.org/TR/scxml/\" namelist=\"Var2\">\n       <content>\n          <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n               <state id=\"sub0\">\n               <transition cond=\"Var2\" target=\"subFinal\">\n                <send target=\"#_parent\" event=\"failure\"/>\n            </transition>\n            <transition target=\"subFinal\">\n              <send target=\"#_parent\" event=\"success\"/>\n              </transition>\n          </state>    \n           <final id=\"subFinal\"/>\n           </scxml>\n           </content>\n          </invoke>\n          \n     <transition event=\"success\" target=\"pass\"/>\n     <transition event=\"*\" target=\"fail\"/>\n   </state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[3]></>\n  </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n    </>\n   \n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/] namelist=[Var2]>\n       <{http://www.w3.org/2005/07/scxml}content>\n          <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n               <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n               <{http://www.w3.org/2005/07/scxml}transition cond=[Var2] target=[subFinal]>\n                <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[failure]></>\n            </>\n            <{http://www.w3.org/2005/07/scxml}transition target=[subFinal]>\n              <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[success]></>\n              </>\n          </>    \n           <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n           </>\n           </>\n          </>\n          \n     <{http://www.w3.org/2005/07/scxml}transition event=[success] target=[pass]></>\n     <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 250/test250.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the onexit handlers run in the invoked process if it is cancelled.  This has to be a\nmanual test, since this process won't accept any events from the child  process once it has been cancelled.\nTester must examine log output from child process to determine success   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\">\n  <onentry>\n    <send event=\"foo\"/>\n    </onentry>\n   \n     <invoke type=\"http://www.w3.org/TR/scxml/\">\n         <content>\n           <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n             <state id=\"sub0\" initial=\"sub01\">\n               <onentry>\n                <send event=\"timeout\" delay=\"2s\"/>\n                  </onentry>\n                 <transition event=\"timeout\" target=\"subFinal\"/>\n              <onexit>\n                 <log expr=\"'Exiting sub0'\"/>\n                </onexit> \n             <state id=\"sub01\">\n             <onexit>\n             <log expr=\"'Exiting sub01'\"/>\n           </onexit>\n        </state>\n      </state>     \n        <final id=\"subFinal\">\n          <onentry>\n           <log expr=\"'entering final state, invocation was not cancelled'\"/>\n          </onentry>\n         </final> \n      </scxml>\n      </content>\n      </invoke>\n      \n     <!-- this transition will cause the invocation to be cancelled -->\n     <transition event=\"foo\" target=\"final\"/>\n   </state>\n \n<final id=\"final\"/>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[foo]></>\n    </>\n   \n     <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n         <{http://www.w3.org/2005/07/scxml}content>\n           <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n             <{http://www.w3.org/2005/07/scxml}state id=[sub0] initial=[sub01]>\n               <{http://www.w3.org/2005/07/scxml}onentry>\n                <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n                  </>\n                 <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[subFinal]></>\n              <{http://www.w3.org/2005/07/scxml}onexit>\n                 <{http://www.w3.org/2005/07/scxml}log expr=['Exiting sub0']></>\n                </> \n             <{http://www.w3.org/2005/07/scxml}state id=[sub01]>\n             <{http://www.w3.org/2005/07/scxml}onexit>\n             <{http://www.w3.org/2005/07/scxml}log expr=['Exiting sub01']></>\n           </>\n        </>\n      </>     \n        <{http://www.w3.org/2005/07/scxml}final id=[subFinal]>\n          <{http://www.w3.org/2005/07/scxml}onentry>\n           <{http://www.w3.org/2005/07/scxml}log expr=['entering final state, invocation was not cancelled']></>\n          </>\n         </> \n      </>\n      </>\n      </>\n      \n     \n     <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[final]></>\n   </>\n \n<{http://www.w3.org/2005/07/scxml}final id=[final]></>\n</>"
# 253/test253.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the scxml event processor is used in both directions.  If child process uses the \nscxml event i/o processor to communicate with us, send it an event.  It will send back success if\nthis process uses the scxml processor to send the message to it, otherwise failure.  For this test we allow \n'scxml' as an alternative to the full url.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\"/>\n  </datamodel>\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n    \n    <transition event=\"timeout\" target=\"fail\"/>\n    \n    <invoke type=\"scxml\" id=\"foo\">\n      <content>\n      <!-- inform parent we're running then wait for it to send us an event.  If it uses the scxml event i/o\n             processor to do so, return success, otherwise return failure.   -->\n       <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n         <datamodel>\n          <data id=\"Var2\"/>\n           </datamodel>\n            <state id=\"sub0\">\n              <onentry>\n               <send target=\"#_parent\" event=\"childRunning\"/>\n            </onentry>\n   \n           <transition event=\"parentToChild\" target=\"sub1\">\n           <assign location=\"Var2\" expr=\"_event.origintype\"/>\n          </transition>\n         </state>\n          <state id=\"sub1\">\n            <transition cond=\"Var2=='http://www.w3.org/TR/scxml/#SCXMLEventProcessor'\" target=\"subFinal\">\n             <send target=\"#_parent\" event=\"success\"/>\n                </transition>\n            <transition cond=\"Var2=='scxml'\" target=\"subFinal\">\n             <send target=\"#_parent\" event=\"success\"/>\n              </transition>\n            <transition target=\"subFinal\">\n                <send target=\"#_parent\" event=\"failure\"/>\n             </transition>\n           </state>\n          <final id=\"subFinal\"/>\n            </scxml>\n        </content>\n        </invoke>\n    \n    <state id=\"s01\">\n    <transition event=\"childRunning\" target=\"s02\">\n       <assign location=\"Var1\" expr=\"_event.origintype\"/>\n       </transition>\n   </state>\n    \n    <state id=\"s02\">\n\n     <transition cond=\"Var1=='http://www.w3.org/TR/scxml/#SCXMLEventProcessor'\" target=\"s03\">\n        <send target=\"#_foo\" event=\"parentToChild\"/>\n        </transition>\n    <transition cond=\"Var1=='scxml'\" target=\"s03\">\n        <send target=\"#_foo\" event=\"parentToChild\"/>\n        </transition>\n \n    <transition target=\"fail\"/>\n\n    </state>        \n\n     \n     <state id=\"s03\">\n       <transition event=\"success\" target=\"pass\"/>\n       <transition event=\"fail\" target=\"fail\"/>\n  \n     </state>   \n\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n  </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n    </>\n    \n    <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n    \n    <{http://www.w3.org/2005/07/scxml}invoke type=[scxml] id=[foo]>\n      <{http://www.w3.org/2005/07/scxml}content>\n      \n       <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n         <{http://www.w3.org/2005/07/scxml}datamodel>\n          <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n           </>\n            <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n              <{http://www.w3.org/2005/07/scxml}onentry>\n               <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[childRunning]></>\n            </>\n   \n           <{http://www.w3.org/2005/07/scxml}transition event=[parentToChild] target=[sub1]>\n           <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[_event.origintype]></>\n          </>\n         </>\n          <{http://www.w3.org/2005/07/scxml}state id=[sub1]>\n            <{http://www.w3.org/2005/07/scxml}transition cond=[Var2=='http://www.w3.org/TR/scxml/#SCXMLEventProcessor'] target=[subFinal]>\n             <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[success]></>\n                </>\n            <{http://www.w3.org/2005/07/scxml}transition cond=[Var2=='scxml'] target=[subFinal]>\n             <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[success]></>\n              </>\n            <{http://www.w3.org/2005/07/scxml}transition target=[subFinal]>\n                <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[failure]></>\n             </>\n           </>\n          <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n            </>\n        </>\n        </>\n    \n    <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[childRunning] target=[s02]>\n       <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.origintype]></>\n       </>\n   </>\n    \n    <{http://www.w3.org/2005/07/scxml}state id=[s02]>\n\n     <{http://www.w3.org/2005/07/scxml}transition cond=[Var1=='http://www.w3.org/TR/scxml/#SCXMLEventProcessor'] target=[s03]>\n        <{http://www.w3.org/2005/07/scxml}send target=[#_foo] event=[parentToChild]></>\n        </>\n    <{http://www.w3.org/2005/07/scxml}transition cond=[Var1=='scxml'] target=[s03]>\n        <{http://www.w3.org/2005/07/scxml}send target=[#_foo] event=[parentToChild]></>\n        </>\n \n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n\n    </>        \n\n     \n     <{http://www.w3.org/2005/07/scxml}state id=[s03]>\n       <{http://www.w3.org/2005/07/scxml}transition event=[success] target=[pass]></>\n       <{http://www.w3.org/2005/07/scxml}transition event=[fail] target=[fail]></>\n  \n     </>   \n\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 276/test276sub1.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- define var1 with default value 0.  Parent will invoke this process setting var1 = 1.  Return event1 if var1 == 1, event0 otherwise --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n   <datamodel>\n     <data id=\"Var1\" expr=\"0\"/>\n     </datamodel>\n     \n <state id=\"s0\">\n \n     \n  <transition cond=\"Var1==1\" target=\"final\">\n     <send target=\"#_parent\" event=\"event1\"/>\n     </transition>\n     \n  <transition target=\"final\">\n     <send target=\"#_parent\" event=\"event0\"/>\n     </transition>\n     \n   </state>\n   \n   <final id=\"final\"/>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n   <{http://www.w3.org/2005/07/scxml}datamodel>\n     <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n     </>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n \n     \n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[final]>\n     <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[event1]></>\n     </>\n     \n  <{http://www.w3.org/2005/07/scxml}transition target=[final]>\n     <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[event0]></>\n     </>\n     \n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[final]></>\n     \n</>"
# 278/test278.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n<!-- test that a variable can be accessed from a state that is outside its lexical scope -->   \n     \n <state id=\"s0\">\n   <transition cond=\"Var1==1\" target=\"pass\"/>\n\n  <transition target=\"fail\"/>\n\n   </state>\n   \n<state id=\"s1\">\n  <datamodel>\n    <data id=\"Var1\" expr=\"1\"/>\n    </datamodel>\n  </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n   \n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[pass]></>\n\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n    </>\n  </>\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 280/test280.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test late binding.  var2 won't get bound until s1 is entered, so it shouldn't  have a value in s0 and\naccessing it should cause an error. It should get bound before the onentry code in s1 so it should  be\npossible access it there and assign its value to var1 --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" binding=\"late\">\n \n <datamodel>\n   <data id=\"Var1\"/>\n   </datamodel>  \n     \n <state id=\"s0\">\n   <transition cond=\"typeof Var2 === 'undefined' \" target=\"s1\"/>\n  <transition target=\"fail\"/>\n   </state>\n   \n<state id=\"s1\">\n  <datamodel>\n    <data id=\"Var2\" expr=\"1\"/>\n    </datamodel>\n    <onentry>\n    <assign location=\"Var1\" expr=\"Var2\"/>\n    </onentry>\n    <transition cond=\"Var1===Var2\" target=\"pass\"/>\n    <transition target=\"fail\"/>\n  </state>\n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript] binding=[late]>\n \n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n   </>  \n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[typeof Var2 === 'undefined' ] target=[s1]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[1]></>\n    </>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var2]></>\n    </>\n    <{http://www.w3.org/2005/07/scxml}transition cond=[Var1===Var2] target=[pass]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 287/test287.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- a simple test that a legal value may be assigned to a valid data model location --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\" initial=\"s0\">\n   \n<datamodel>\n    <data id=\"Var1\" expr=\"0\"/>\n    </datamodel>   \n     \n <state id=\"s0\">\n   <onentry>\n   <assign location=\"Var1\" expr=\"1\"/>\n   </onentry>\n   \n   <transition cond=\"Var1==1\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0] initial=[s0]>\n   \n<{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n    </>   \n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[1]></>\n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 298/test298.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- reference a non-existent data model location in param in donedata and see that the right error is raised --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n <datamodel>\n       <data id=\"Var1\" expr=\"0\"/>\n    </datamodel>   \n     \n <state id=\"s0\" initial=\"s01\">\n \t<onentry>\n \t\t<send event=\"timeout\" delay=\"1s\"/>\n \t\t</onentry>\n \t\t\n    <transition event=\"error.execution\" target=\"pass\"/>\n       <transition event=\"*\" target=\"fail\"/>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <param name=\"Var3\" location=\"foo.bar.baz \"/>\n      </donedata>\n     </final>\n </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n       <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n    </>   \n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n \t<{http://www.w3.org/2005/07/scxml}onentry>\n \t\t<{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n \t\t</>\n \t\t\n    <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[pass]></>\n       <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s02]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}final id=[s02]>\n     <{http://www.w3.org/2005/07/scxml}donedata>\n      <{http://www.w3.org/2005/07/scxml}param name=[Var3] location=[foo.bar.baz ]></>\n      </>\n     </>\n </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 302/test302.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that a script is evaluated at load time.  <conf:script> shoudl assign the value 1 to \nVar1.  Hence, if script is evaluated at download time, Var1 has a value in the initial state s0.\nThis test is valid only for datamodels that support scripting --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n <script>var Var1 = 1</script>\n     \n <state id=\"s0\">\n   <transition cond=\"Var1==1\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n   \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n <{http://www.w3.org/2005/07/scxml}script>var Var1 = 1</>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 304/test304.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that a variable declared by a script can be accessed like any other part of the data model --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\" initial=\"s0\">\n <script>var Var1 = 1</script>\n     \n <state id=\"s0\">\n   <transition cond=\"Var1==1\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n   \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0] initial=[s0]>\n <{http://www.w3.org/2005/07/scxml}script>var Var1 = 1</>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 309/test309.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that an expression that cannot be interpreted as a boolean is treated as false --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n<state id=\"s0\"> \n  <transition cond=\"return\" target=\"fail\"/>\n  <transition target=\"pass\"/>\n  </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]> \n  <{http://www.w3.org/2005/07/scxml}transition cond=[return] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[pass]></>\n  </>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 311/test311.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that assignment to a non-existent location yields an error --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n\n<state id=\"s0\">\n  <onentry>\n  \t<send event=\"timeout\" delay=\"1s\"/>\n   <assign location=\"foo.bar.baz \" expr=\"1\"/>\n   </onentry>\n   <transition event=\"error.execution\" target=\"pass\"/> \n   <transition event=\".*\" target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  \t<{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n   <{http://www.w3.org/2005/07/scxml}assign location=[foo.bar.baz ] expr=[1]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[pass]></> \n   <{http://www.w3.org/2005/07/scxml}transition event=[.*] target=[fail]></>\n   </>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 313/test313.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- this is a manual test. The processor is allowed to reject this doc, but if it executes it with its illegal\nexpression, it must raise an error --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n </datamodel>\n\n<state id=\"s0\">\n  <onentry>\n   <assign location=\"Var1\" expr=\"return\"/>\n   <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"error.execution\" target=\"pass\"/> \n   <transition event=\".*\" target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[return]></>\n   <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[pass]></> \n   <{http://www.w3.org/2005/07/scxml}transition event=[.*] target=[fail]></>\n   </>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 318/test318.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that _event stays bound during the onexit and entry into the next state --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">\n<datamodel>\n <data id=\"Var1\"/>\n </datamodel>\n     \n <state id=\"s0\">\n   <onentry>\n     <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" target=\"s1\"/> \n   </state>\n   \n <state id=\"s1\">\n  <onentry>\n    <raise event=\"bar\"/>\n    <!-- _event should still be bound to 'foo' at this point -->\n    <assign location=\"Var1\" expr=\"_event.name\"/>\n    </onentry>\n   <transition cond=\"Var1=='foo'\" target=\"pass\"/> \n   <transition target=\"fail\"/>\n   </state>\n   \n    \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript] name=[machineName]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n </>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[s1]></> \n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n    \n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.name]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[Var1=='foo'] target=[pass]></> \n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n   \n    \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 321/test321.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that _sessionid is bound on startup --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\" name=\"machineName\">\n<datamodel>\n  <data id=\"Var1\" expr=\"_sessionid\"/>\n  </datamodel>\n     \n <state id=\"s0\">\n<transition cond=\"Var1\" target=\"pass\"/> \n   <transition cond=\"true\" target=\"fail\"/>\n   </state>\n   \n    \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0] name=[machineName]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[_sessionid]></>\n  </>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n<{http://www.w3.org/2005/07/scxml}transition cond=[Var1] target=[pass]></> \n   <{http://www.w3.org/2005/07/scxml}transition cond=[true] target=[fail]></>\n   </>\n   \n    \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 323/test323.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that _name is bound on startup --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">\n<datamodel>\n  <data id=\"Var1\" expr=\"_name\"/>\n  </datamodel>\n     \n <state id=\"s0\">\n<transition cond=\"Var1\" target=\"pass\"/> \n   <transition cond=\"true\" target=\"fail\"/>\n   </state>\n   \n    \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript] name=[machineName]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[_name]></>\n  </>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n<{http://www.w3.org/2005/07/scxml}transition cond=[Var1] target=[pass]></> \n   <{http://www.w3.org/2005/07/scxml}transition cond=[true] target=[fail]></>\n   </>\n   \n    \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 325/test325.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that _ioprocessors is bound at startup.  I'm not sure how to test for a set value or\nhow to test that the entries in it do represent I/O processors, since the set that each implementation\nsupports may be different.  Suggestions welcome --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\" name=\"machineName\">\n<datamodel>\n  <data id=\"Var1\" expr=\"_ioprocessors\"/>\n  </datamodel>\n\n\n <state id=\"s0\">\n    <transition cond=\"Var1\" target=\"pass\"/> \n   <transition target=\"fail\"/>\n   </state>\n   \n    \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0] name=[machineName]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[_ioprocessors]></>\n  </>\n\n\n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n    <{http://www.w3.org/2005/07/scxml}transition cond=[Var1] target=[pass]></> \n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n   \n    \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 329/test329.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that none of the system variables can be modified --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">\n   <datamodel>\n     <data id=\"Var1\"/>\n     <data id=\"Var2\"/>\n     <data id=\"Var3\"/>\n     <data id=\"Var4\"/>\n     </datamodel>\n        \n <state id=\"s0\">\n   <onentry>\n     <!-- get _event bound so we can use it in s1-->\n     <raise event=\"foo\"/>\n     <assign location=\"Var1\" expr=\"_sessionid\"/>\n     <assign location=\"_sessionid\" expr=\"27\"/>\n   </onentry>\n\n   <transition event=\"foo\" cond=\"Var1==_sessionid\" target=\"s1\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n <state id=\"s1\">\n  <onentry>\n     <assign location=\"Var2\" expr=\"_event\"/>\n     <assign location=\"_event\" expr=\"27\"/>\n    </onentry>\n   <transition cond=\"Var2==_event\" target=\"s2\"/>\n   <transition target=\"fail\"/>\n   </state>  \n   \n<state id=\"s2\">\n  <onentry>\n     <assign location=\"Var3\" expr=\"_name\"/>\n     <assign location=\"_name\" expr=\"27\"/>\n    </onentry>\n   <transition cond=\"Var3==_name\" target=\"s3\"/>\n   <transition target=\"fail\"/>\n   </state> \n\n   \n<state id=\"s3\">\n  <onentry>\n     <assign location=\"Var4\" expr=\"_ioprocessors\"/>\n     <assign location=\"_ioprocessors\" expr=\"27\"/>\n    </onentry>\n   <transition cond=\"Var4==_ioprocessors\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>  \n   \n   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript] name=[machineName]>\n   <{http://www.w3.org/2005/07/scxml}datamodel>\n     <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n     <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n     <{http://www.w3.org/2005/07/scxml}data id=[Var3]></>\n     <{http://www.w3.org/2005/07/scxml}data id=[Var4]></>\n     </>\n        \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     \n     <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_sessionid]></>\n     <{http://www.w3.org/2005/07/scxml}assign location=[_sessionid] expr=[27]></>\n   </>\n\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=[Var1==_sessionid] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[_event]></>\n     <{http://www.w3.org/2005/07/scxml}assign location=[_event] expr=[27]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[Var2==_event] target=[s2]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>  \n   \n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var3] expr=[_name]></>\n     <{http://www.w3.org/2005/07/scxml}assign location=[_name] expr=[27]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[Var3==_name] target=[s3]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </> \n\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var4] expr=[_ioprocessors]></>\n     <{http://www.w3.org/2005/07/scxml}assign location=[_ioprocessors] expr=[27]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[Var4==_ioprocessors] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>  \n   \n   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 331/test331.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\" name=\"machineName\">\n\n<!-- test that _event.type is set correctly for internal, platform, and external events -->\n<datamodel>\n <data id=\"Var1\"/>\n </datamodel>\n     \n <state id=\"s0\">\n   <onentry>\n   <!-- internal event -->\n     <raise event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" target=\"s1\"> \n     <assign location=\"Var1\" expr=\"_event.type\"/>\n     </transition>\n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1=='internal'\" target=\"s2\"/>\n  <transition target=\"fail\"/>\n  </state>\n   \n<state id=\"s2\">\n   <onentry>\n   <!-- this will generate an error, which is a platform event -->\n     <assign location=\"foo.bar.baz \" expr=\"1\"/>\n   </onentry>\n   <transition event=\"error\" target=\"s3\">\n     <assign location=\"Var1\" expr=\"_event.type\"/>\n     </transition> \n      <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n<state id=\"s3\">\n  <transition cond=\"Var1=='platform'\" target=\"s4\"/>\n  <transition target=\"fail\"/>\n  </state>\n   \n <state id=\"s4\">\n   <onentry>\n   <!-- external event -->\n     <send event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" target=\"s5\">\n   <assign location=\"Var1\" expr=\"_event.type\"/>\n     </transition>   \n      <transition event=\"*\" target=\"fail\"/>\n   </state>\n   \n<state id=\"s5\">\n  <transition cond=\"Var1=='external'\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n   \n    \n  <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n  <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0] name=[machineName]>\n\n\n<{http://www.w3.org/2005/07/scxml}datamodel>\n <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n </>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n   \n     <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[s1]> \n     <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.type]></>\n     </>\n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1=='internal'] target=[s2]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n   \n     <{http://www.w3.org/2005/07/scxml}assign location=[foo.bar.baz ] expr=[1]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[s3]>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.type]></>\n     </> \n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1=='platform'] target=[s4]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s4]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n   \n     <{http://www.w3.org/2005/07/scxml}send event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[s5]>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.type]></>\n     </>   \n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s5]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1=='external'] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n   \n    \n  <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n  <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 333/test333.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- make sure sendid is blank in a non-error event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s0\" datamodel=\"ecmascript\" name=\"machineName\">  \n   \n <state id=\"s0\">\n   <onentry>\n     <send event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" cond=\"typeof _event.sendid === 'undefined' \" target=\"pass\"/>\n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n\n      \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s0] datamodel=[ecmascript] name=[machineName]>  \n   \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=[typeof _event.sendid === 'undefined' ] target=[pass]></>\n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n   \n\n      \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 336/test336.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the origin field of an external event contains a URL that lets you send back to the originator.  In\nthis case it's the same session, so if we get bar we succeed --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\" name=\"machineName\">  \n   \n <state id=\"s0\">\n   <onentry>\n     <send event=\"foo\"/>\n   </onentry>\n   <transition event=\"foo\" target=\"s1\">\n     <send event=\"bar\" targetexpr=\"_event.origin\" typeexpr=\"_event.origintype\"/>\n      </transition>\n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n<state id=\"s1\">\n  <onentry>\n    <send event=\"baz\"/>\n    </onentry>\n  <transition event=\"bar\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n      \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0] name=[machineName]>  \n   \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send event=[foo]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[s1]>\n     <{http://www.w3.org/2005/07/scxml}send event=[bar] targetexpr=[_event.origin] typeexpr=[_event.origintype]></>\n      </>\n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[baz]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n      \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 338/test338.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that invokeid is set correctly in events received from an invoked process.  timeout event catches the \ncase where the invoke doesn't work correctly --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\"/>\n  <data id=\"Var2\"/>\n  </datamodel>\n  \n   <state id=\"s0\">\n      <onentry>\n        <send event=\"timeout\" delay=\"2s\"/>\n        </onentry>\n     <invoke idlocation=\"Var1\" type=\"http://www.w3.org/TR/scxml/\">\n     <content>\n       <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">     \n       <final id=\"sub0\">\n         <onentry>\n            <send target=\"#_parent\" event=\"event1\"/>\n        </onentry>\n        </final>\n       </scxml>\n      </content>\n    </invoke>\n       <transition event=\"event1\" target=\"s1\">\n         <assign location=\"Var2\" expr=\"_event.invokeid\"/>\n         </transition>\n       <transition event=\"event0\" target=\"fail\"/>\n   </state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1===Var2\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  </>\n  \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n        <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n        </>\n     <{http://www.w3.org/2005/07/scxml}invoke idlocation=[Var1] type=[http://www.w3.org/TR/scxml/]>\n     <{http://www.w3.org/2005/07/scxml}content>\n       <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript] name=[machineName]>     \n       <{http://www.w3.org/2005/07/scxml}final id=[sub0]>\n         <{http://www.w3.org/2005/07/scxml}onentry>\n            <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[event1]></>\n        </>\n        </>\n       </>\n      </>\n    </>\n       <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s1]>\n         <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[_event.invokeid]></>\n         </>\n       <{http://www.w3.org/2005/07/scxml}transition event=[event0] target=[fail]></>\n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1===Var2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n\n\n</>"
# 342/test342.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that eventexpr works and sets the name field of the resulting event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">  \n <datamodel>\n   <data id=\"Var1\" expr=\"'foo'\"/>\n   <data id=\"Var2\"/>\n   </datamodel>\n     \n <state id=\"s0\">\n   <onentry>\n     <send eventexpr=\"Var1\"/>\n   </onentry>\n   <transition event=\"foo\" target=\"s1\">\n      <assign location=\"Var2\" expr=\"_event.name\"/>\n      </transition>\n      <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n<state id=\"s1\">\n  <transition cond=\"Var1===Var2\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n      \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript] name=[machineName]>  \n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=['foo']></>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n   </>\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send eventexpr=[Var1]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[s1]>\n      <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[_event.name]></>\n      </>\n      <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1===Var2] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n      \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 344/test344.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that a cond expression that cannot be evaluated as a \nboolean cond expression evaluates to false and causes error.execution to be raised.\nIn some languages, any valid expression/object can be converted to a boolean, so conf:nonBoolean will\nhave to be mapped onto something that produces a syntax error or something similarly invalid --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n<state id=\"s0\"> \n  <transition cond=\"return\" target=\"fail\"/>\n  <transition target=\"s1\"/>\n  </state>\n  \n<state id=\"s1\">\n  <onentry>\n    <raise event=\"foo\"/>\n    </onentry>\n  <transition event=\"error.execution\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]> \n  <{http://www.w3.org/2005/07/scxml}transition cond=[return] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[s1]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 347/test347.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the scxml event I/O processor works by sending events back and forth between an invoked child\nand its parent process --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n  \n<state id=\"s0\" initial=\"s01\">\n     <invoke id=\"child\" type=\"scxml\">\n      <content>\n      <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\" name=\"machineName\">  \n         <state id=\"sub0\">\n           <onentry>\n             <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" target=\"#_parent\" event=\"childToParent\"/>\n         </onentry>\n      <transition event=\"parentToChild\" target=\"subFinal\"/>\n     </state>\n     <final id=\"subFinal\"/>\n       </scxml>\n     </content>\n        </invoke>\n   <onentry>\n     <send delay=\"20s\" event=\"timeout\"/>\n     </onentry>\n  <transition event=\"timeout\" target=\"fail\"/>\n        \n  <state id=\"s01\">\n      <transition event=\"childToParent\" target=\"s02\"/>\n      </state>\n    \n   <state id=\"s02\">\n     <onentry>\n       <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" target=\"#_child\" event=\"parentToChild\"/>\n       </onentry>\n   <transition event=\"done.invoke\" target=\"pass\"/>\n   <transition event=\"error\" target=\"fail\"/>\n   </state>\n</state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n     <{http://www.w3.org/2005/07/scxml}invoke id=[child] type=[scxml]>\n      <{http://www.w3.org/2005/07/scxml}content>\n      <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript] name=[machineName]>  \n         <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n           <{http://www.w3.org/2005/07/scxml}onentry>\n             <{http://www.w3.org/2005/07/scxml}send type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor] target=[#_parent] event=[childToParent]></>\n         </>\n      <{http://www.w3.org/2005/07/scxml}transition event=[parentToChild] target=[subFinal]></>\n     </>\n     <{http://www.w3.org/2005/07/scxml}final id=[subFinal]></>\n       </>\n     </>\n        </>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send delay=[20s] event=[timeout]></>\n     </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n        \n  <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n      <{http://www.w3.org/2005/07/scxml}transition event=[childToParent] target=[s02]></>\n      </>\n    \n   <{http://www.w3.org/2005/07/scxml}state id=[s02]>\n     <{http://www.w3.org/2005/07/scxml}onentry>\n       <{http://www.w3.org/2005/07/scxml}send type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor] target=[#_child] event=[parentToChild]></>\n       </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[fail]></>\n   </>\n</>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 349/test349.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that value in origin field can be used to send an event back to the sender --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n\n   <onentry>\n     <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" event=\"s0Event\"/>\n     </onentry>\n  <transition event=\"s0Event\" target=\"s2\">\n    <assign location=\"Var1\" expr=\"_event.origin\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\"/>\n\n</state>\n\n<state id=\"s2\">\n  <onentry>\n   <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" targetexpr=\"Var1\" event=\"s0Event2\"/>\n   </onentry>\n   <transition event=\"s0Event2\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n</state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor] event=[s0Event]></>\n     </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[s0Event] target=[s2]>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.origin]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}send type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor] targetexpr=[Var1] event=[s0Event2]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[s0Event2] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n</>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 351/test351.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that sendid is set in event if present in send, blank otherwise --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\"/>\n  <data id=\"Var2\"/>\n  </datamodel>\n\n  \n<state id=\"s0\">\n\n   <onentry>\n     <send delay=\"5s\" event=\"timeout\"/>\n     <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" id=\"send1\" event=\"s0Event\"/>  \n     </onentry>\n  <transition event=\"s0Event\" target=\"s1\">\n    <assign location=\"Var1\" expr=\"_event.sendid\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\">\n    </transition>\n\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1=='send1'\" target=\"s2\"/>\n  <transition target=\"fail\"/>\n </state>\n \n<state id=\"s2\">\n\n   <onentry>\n     <send delay=\"5s\" event=\"timeout\"/>\n      <send event=\"s0Event2\"/>\n     </onentry>\n  <transition event=\"s0Event2\" target=\"s3\">\n    <assign location=\"Var2\" expr=\"_event.sendid\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n\n<state id=\"s3\">\n  <transition cond=\"!Var2\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n </state>\n\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  </>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send delay=[5s] event=[timeout]></>\n     <{http://www.w3.org/2005/07/scxml}send type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor] id=[send1] event=[s0Event]></>  \n     </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[s0Event] target=[s1]>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[_event.sendid]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]>\n    </>\n\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1=='send1'] target=[s2]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </>\n \n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send delay=[5s] event=[timeout]></>\n      <{http://www.w3.org/2005/07/scxml}send event=[s0Event2]></>\n     </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[s0Event2] target=[s3]>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[_event.sendid]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[!Var2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </>\n\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 354/test354.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that event.data can be populated using both namelist, param and <content>\nand that correct values are used --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"1\"/>\n  <data id=\"Var2\"/>\n  <data id=\"Var3\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n   <onentry>\n     <send delay=\"5s\" event=\"timeout\"/>\n    <send event=\"event1\" type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" namelist=\"Var1\"> \n      <param name=\"param1\" expr=\"2\"/>\n      </send> \n     </onentry>\n  <transition event=\"event1\" target=\"s1\">\n    <assign location=\"Var2\" expr=\"_event.data.Var1\"/>\n    <assign location=\"Var3\" expr=\"_event.data.param1\"/>\n    </transition>\n  <transition event=\"*\" target=\"fail\">\n    </transition>\n\n</state>\n\n<state id=\"s1\">\n  \n  <transition cond=\"Var2==1\" target=\"s2\"/>\n  <transition target=\"fail\"/>\n  </state>\n\n<state id=\"s2\">\n    <transition cond=\"Var3==2\" target=\"s3\"/>\n  <transition target=\"fail\"/>\n  </state>\n\n<state id=\"s3\">\n   <onentry>\n     <send delay=\"5s\" event=\"timeout\"/>\n    <send event=\"event2\"> \n      <content>123</content>\n      </send>\n     </onentry>\n  <transition event=\"event2\" cond=\"_event.data == 123\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n\n</state>\n\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var3]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send delay=[5s] event=[timeout]></>\n    <{http://www.w3.org/2005/07/scxml}send event=[event1] type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor] namelist=[Var1]> \n      <{http://www.w3.org/2005/07/scxml}param name=[param1] expr=[2]></>\n      </> \n     </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s1]>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[_event.data.Var1]></>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var3] expr=[_event.data.param1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]>\n    </>\n\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  \n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var2==1] target=[s2]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n    <{http://www.w3.org/2005/07/scxml}transition cond=[Var3==2] target=[s3]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send delay=[5s] event=[timeout]></>\n    <{http://www.w3.org/2005/07/scxml}send event=[event2]> \n      <{http://www.w3.org/2005/07/scxml}content>123</>\n      </>\n     </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] cond=[_event.data == 123] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n\n</>\n\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 364/test364.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that default initial states are entered when a compound state is entered.  First we test\nthe 'initial' attribute, then the initial element, then default to the first child in document order.  \nIf we get to s01111 we succeed, if any other state, failure.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" initial=\"s1\" version=\"1.0\">\n\n<state id=\"s1\" initial=\"s11p112 s11p122\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n  <transition event=\"timeout\" target=\"fail\"/>\n  <state id=\"s11\" initial=\"s111\">\n    <state id=\"s111\"/>\n    <parallel id=\"s11p1\">\n       <state id=\"s11p11\" initial=\"s11p111\">\n         <state id=\"s11p111\"/>\n         <state id=\"s11p112\">\n           <onentry>\n             <raise event=\"In-s11p112\"/>\n             </onentry>\n         </state>\n       </state>\n       <state id=\"s11p12\" initial=\"s11p121\">\n        <state id=\"s11p121\"/>\n        <state id=\"s11p122\">\n          <transition event=\"In-s11p112\" target=\"s2\"/>\n          </state>\n       </state>\n      </parallel>\n  </state>\n</state>\n\n<state id=\"s2\">\n\t <initial>\n\t \t<transition target=\"s21p112 s21p122\"/>\n\t \t</initial>\n  <transition event=\"timeout\" target=\"fail\"/>\n  <state id=\"s21\" initial=\"s211\">\n    <state id=\"s211\"/>\n    <parallel id=\"s21p1\">\n       <state id=\"s21p11\" initial=\"s21p111\">\n         <state id=\"s21p111\"/>\n         <state id=\"s21p112\">\n           <onentry>\n             <raise event=\"In-s21p112\"/>\n             </onentry>\n         </state>\n       </state>\n       <state id=\"s21p12\" initial=\"s21p121\">\n        <state id=\"s21p121\"/>\n        <state id=\"s21p122\">\n          <transition event=\"In-s21p112\" target=\"s3\"/>\n          </state>\n       </state>\n      </parallel>\n  </state>\n</state>\n      \n<state id=\"s3\">\n <transition target=\"fail\"/>\n  <state id=\"s31\">\n    <state id=\"s311\">\n       <state id=\"s3111\">\n           <transition target=\"pass\"/>\n       </state>\n       <state id=\"s3112\"/>\n    <state id=\"s312\"/>\n  <state id=\"s32\"/>\n</state>\n</state>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] initial=[s1] version=[1.0]>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1] initial=[s11p112 s11p122]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}state id=[s11] initial=[s111]>\n    <{http://www.w3.org/2005/07/scxml}state id=[s111]></>\n    <{http://www.w3.org/2005/07/scxml}parallel id=[s11p1]>\n       <{http://www.w3.org/2005/07/scxml}state id=[s11p11] initial=[s11p111]>\n         <{http://www.w3.org/2005/07/scxml}state id=[s11p111]></>\n         <{http://www.w3.org/2005/07/scxml}state id=[s11p112]>\n           <{http://www.w3.org/2005/07/scxml}onentry>\n             <{http://www.w3.org/2005/07/scxml}raise event=[In-s11p112]></>\n             </>\n         </>\n       </>\n       <{http://www.w3.org/2005/07/scxml}state id=[s11p12] initial=[s11p121]>\n        <{http://www.w3.org/2005/07/scxml}state id=[s11p121]></>\n        <{http://www.w3.org/2005/07/scxml}state id=[s11p122]>\n          <{http://www.w3.org/2005/07/scxml}transition event=[In-s11p112] target=[s2]></>\n          </>\n       </>\n      </>\n  </>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n\t <{http://www.w3.org/2005/07/scxml}initial>\n\t \t<{http://www.w3.org/2005/07/scxml}transition target=[s21p112 s21p122]></>\n\t \t</>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}state id=[s21] initial=[s211]>\n    <{http://www.w3.org/2005/07/scxml}state id=[s211]></>\n    <{http://www.w3.org/2005/07/scxml}parallel id=[s21p1]>\n       <{http://www.w3.org/2005/07/scxml}state id=[s21p11] initial=[s21p111]>\n         <{http://www.w3.org/2005/07/scxml}state id=[s21p111]></>\n         <{http://www.w3.org/2005/07/scxml}state id=[s21p112]>\n           <{http://www.w3.org/2005/07/scxml}onentry>\n             <{http://www.w3.org/2005/07/scxml}raise event=[In-s21p112]></>\n             </>\n         </>\n       </>\n       <{http://www.w3.org/2005/07/scxml}state id=[s21p12] initial=[s21p121]>\n        <{http://www.w3.org/2005/07/scxml}state id=[s21p121]></>\n        <{http://www.w3.org/2005/07/scxml}state id=[s21p122]>\n          <{http://www.w3.org/2005/07/scxml}transition event=[In-s21p112] target=[s3]></>\n          </>\n       </>\n      </>\n  </>\n</>\n      \n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}state id=[s31]>\n    <{http://www.w3.org/2005/07/scxml}state id=[s311]>\n       <{http://www.w3.org/2005/07/scxml}state id=[s3111]>\n           <{http://www.w3.org/2005/07/scxml}transition target=[pass]></>\n       </>\n       <{http://www.w3.org/2005/07/scxml}state id=[s3112]></>\n    <{http://www.w3.org/2005/07/scxml}state id=[s312]></>\n  <{http://www.w3.org/2005/07/scxml}state id=[s32]></>\n</>\n</>\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 375/test375.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that onentry handlers are executed in document order.  event1 should be raised before event2 --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n\n\n       \n<state id=\"s0\">\n  <onentry>\n    <raise event=\"event1\"/>\n    </onentry>\n  <onentry>\n    <raise event=\"event2\"/>\n    </onentry>\n    \n  <transition event=\"event1\" target=\"s1\"/>\n  <transition event=\"*\" target=\"fail\"/>\n\n</state>\n\n<state id=\"s1\">\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n\n\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s1]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 377/test377.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that onexit handlers are executed in document order.  event1 should be raised before event2 --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n\n\n       \n<state id=\"s0\">\n  <onexit>\n    <raise event=\"event1\"/>\n    </onexit>\n  <onexit>\n    <raise event=\"event2\"/>\n    </onexit>\n    \n  <transition target=\"s1\"/>\n </state>\n \n <state id=\"s1\">\n    \n  <transition event=\"event1\" target=\"s2\"/>\n  <transition event=\"*\" target=\"fail\"/>\n\n</state>\n\n<state id=\"s2\">\n  <transition event=\"event2\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n</state>\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n\n\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onexit>\n    <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}onexit>\n    <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}transition target=[s1]></>\n </>\n \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s2]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n</>\n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 387/test387.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the default history state works correctly.  From initial state s3 we take a transition to s0's default\nshallow history state.  That should generate \"enteringS011\", which takes us to s4.  In s4, we\ntransition to s1's default deep history state. We should end up in s122, generating \"enteringS122\".  Otherwise failure.--><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s3\" version=\"1.0\" datamodel=\"ecmascript\">\n\n       \n<state id=\"s0\" initial=\"s01\">\n\n  <transition event=\"enteringS011\" target=\"s4\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  \n  <history type=\"shallow\" id=\"s0HistShallow\">\n    <transition target=\"s01\"/>\n    </history>\n  <history type=\"deep\" id=\"s0HistDeep\">\n    <transition target=\"s022\"/>\n    </history>\n  <state id=\"s01\" initial=\"s011\">\n    <state id=\"s011\">\n       <onentry>\n         <raise event=\"enteringS011\"/>\n         </onentry>\n    </state>\n    <state id=\"s012\">\n      <onentry>\n       <raise event=\"enteringS012\"/>\n        </onentry>\n    </state>\n  </state>\n <state id=\"s02\" initial=\"s021\">\n     <state id=\"s021\">\n       <onentry>\n         <raise event=\"enteringS021\"/>\n         </onentry>\n    </state>\n    <state id=\"s022\">\n      <onentry>\n       <raise event=\"enteringS022\"/>\n        </onentry>\n    </state>\n  </state>\n \n</state>\n\n<state id=\"s1\" initial=\"s11\">\n \n  <transition event=\"enteringS122\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  \n  <history type=\"shallow\" id=\"s1HistShallow\">\n    <transition target=\"s11\"/>\n    </history>\n  <history type=\"deep\" id=\"s1HistDeep\">\n    <transition target=\"s122\"/>\n    </history>\n  <state id=\"s11\" initial=\"s111\">\n    <state id=\"s111\">\n       <onentry>\n         <raise event=\"enteringS111\"/>\n         </onentry>\n    </state>\n    <state id=\"s112\">\n      <onentry>\n       <raise event=\"enteringS112\"/>\n        </onentry>\n    </state>\n  </state>\n <state id=\"s12\" initial=\"s121\">\n     <state id=\"s121\">\n       <onentry>\n         <raise event=\"enteringS121\"/>\n         </onentry>\n    </state>\n    <state id=\"s122\">\n      <onentry>\n       <raise event=\"enteringS122\"/>\n        </onentry>\n    </state>\n  </state>\n \n</state>\n\n\n<state id=\"s3\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n   </onentry>\n  <transition target=\"s0HistShallow\"/>\n</state>\n\n<state id=\"s4\">\n  <transition target=\"s1HistDeep\"/>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s3] version=[1.0] datamodel=[ecmascript]>\n\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n\n  <{http://www.w3.org/2005/07/scxml}transition event=[enteringS011] target=[s4]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  \n  <{http://www.w3.org/2005/07/scxml}history type=[shallow] id=[s0HistShallow]>\n    <{http://www.w3.org/2005/07/scxml}transition target=[s01]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}history type=[deep] id=[s0HistDeep]>\n    <{http://www.w3.org/2005/07/scxml}transition target=[s022]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}state id=[s01] initial=[s011]>\n    <{http://www.w3.org/2005/07/scxml}state id=[s011]>\n       <{http://www.w3.org/2005/07/scxml}onentry>\n         <{http://www.w3.org/2005/07/scxml}raise event=[enteringS011]></>\n         </>\n    </>\n    <{http://www.w3.org/2005/07/scxml}state id=[s012]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n       <{http://www.w3.org/2005/07/scxml}raise event=[enteringS012]></>\n        </>\n    </>\n  </>\n <{http://www.w3.org/2005/07/scxml}state id=[s02] initial=[s021]>\n     <{http://www.w3.org/2005/07/scxml}state id=[s021]>\n       <{http://www.w3.org/2005/07/scxml}onentry>\n         <{http://www.w3.org/2005/07/scxml}raise event=[enteringS021]></>\n         </>\n    </>\n    <{http://www.w3.org/2005/07/scxml}state id=[s022]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n       <{http://www.w3.org/2005/07/scxml}raise event=[enteringS022]></>\n        </>\n    </>\n  </>\n \n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1] initial=[s11]>\n \n  <{http://www.w3.org/2005/07/scxml}transition event=[enteringS122] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  \n  <{http://www.w3.org/2005/07/scxml}history type=[shallow] id=[s1HistShallow]>\n    <{http://www.w3.org/2005/07/scxml}transition target=[s11]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}history type=[deep] id=[s1HistDeep]>\n    <{http://www.w3.org/2005/07/scxml}transition target=[s122]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}state id=[s11] initial=[s111]>\n    <{http://www.w3.org/2005/07/scxml}state id=[s111]>\n       <{http://www.w3.org/2005/07/scxml}onentry>\n         <{http://www.w3.org/2005/07/scxml}raise event=[enteringS111]></>\n         </>\n    </>\n    <{http://www.w3.org/2005/07/scxml}state id=[s112]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n       <{http://www.w3.org/2005/07/scxml}raise event=[enteringS112]></>\n        </>\n    </>\n  </>\n <{http://www.w3.org/2005/07/scxml}state id=[s12] initial=[s121]>\n     <{http://www.w3.org/2005/07/scxml}state id=[s121]>\n       <{http://www.w3.org/2005/07/scxml}onentry>\n         <{http://www.w3.org/2005/07/scxml}raise event=[enteringS121]></>\n         </>\n    </>\n    <{http://www.w3.org/2005/07/scxml}state id=[s122]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n       <{http://www.w3.org/2005/07/scxml}raise event=[enteringS122]></>\n        </>\n    </>\n  </>\n \n</>\n\n\n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n   </>\n  <{http://www.w3.org/2005/07/scxml}transition target=[s0HistShallow]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s4]>\n  <{http://www.w3.org/2005/07/scxml}transition target=[s1HistDeep]></>\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 396/test396.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the value in _event.name matches the event name used to match against transitions  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n       \n<state id=\"s0\">\n  <onentry>\n    <raise event=\"foo\"/>\n    </onentry>\n\n    \n  <transition event=\"foo\" cond=\"_event.name == 'foo'\" target=\"pass\"/>\n  <transition event=\"foo\" target=\"fail\"/>\n\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    </>\n\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=[_event.name == 'foo'] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[fail]></>\n\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 401/test401.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that errors go in the internal event queue.  We send ourselves an external event foo, then perform\nand operation that raises an error. Then check that the error event is processed first, even though\nit was raised second  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n       \n<state id=\"s0\">\n  <onentry>\n     <send event=\"foo\"/>\n     <!-- assigning to a non-existent location should raise an error -->\n    <assign location=\"foo.bar.baz \" expr=\"2\"/>\n    </onentry>\n\n    \n  <transition event=\"foo\" target=\"fail\"/>\n  <transition event=\"error\" target=\"pass\"/>\n\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send event=[foo]></>\n     \n    <{http://www.w3.org/2005/07/scxml}assign location=[foo.bar.baz ] expr=[2]></>\n    </>\n\n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[error] target=[pass]></>\n\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 403/test403a.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test one part of 'optimal enablement' meaning that of all transitions that are enabled, we chose the ones\nin child states over parent states, and use document order to break ties. We have\na parent state s0 with two children, s01 and s02. In s01, we test that a) if\na transition in the child matches, we don't consider matches in the parent and b)\nthat if two transitions match in any state, we take the first in document order.\nIn s02 we test that we take a transition in the parent if there is no\nmatching transition in the child. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n       \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n     <!-- catch the failure case -->\n     <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n  <transition event=\"timeout\" target=\"fail\"/>\n  <transition event=\"event1\" target=\"fail\"/>\n  <transition event=\"event2\" target=\"pass\"/>\n\n <state id=\"s01\">\n   <onentry>\n   <!-- this should be caught by the first transition in this state, taking us to S02 -->\n      <raise event=\"event1\"/>\n   </onentry>\n       \n  <transition event=\"event1\" target=\"s02\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n<state id=\"s02\">\n  <onentry>\n  <!-- since the local transition has a cond that evaluates to false this should be caught by a \n    transition in the parent state, taking us to pass -->\n    <raise event=\"event2\"/>\n    </onentry>\n  <transition event=\"event1\" target=\"fail\"/>\n  <transition event=\"event2\" cond=\"false\" target=\"fail\"/>\n  </state>\n\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n     \n     <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n\n <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n   \n      <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n   </>\n       \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s02]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n<{http://www.w3.org/2005/07/scxml}state id=[s02]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  \n    <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] cond=[false] target=[fail]></>\n  </>\n\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 403/test403c.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test 'optimally enabled set', specifically that preemption works correctly --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n  <datamodel>\n   <data id=\"Var1\" expr=\"0\"/>\n   </datamodel>\n   \n<state id=\"s0\" initial=\"p0\">\n  <onentry>\n     <raise event=\"event1\"/>\n     <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n  <transition event=\"event2\" target=\"fail\"/>   \n  <transition event=\"timeout\" target=\"fail\"/>\n   \n <parallel id=\"p0\">\n \t\n \t<state id=\"p0s1\">\n \t\t<transition event=\"event1\"/>\n \t\t<transition event=\"event2\"/>\n \t\t</state>\n \n <state id=\"p0s2\">\n   <transition event=\"event1\" target=\"p0s1\">\n     <raise event=\"event2\"/>\n     </transition>\n     \n   </state>\n   \n <state id=\"p0s3\">\n   <!-- this transition should be blocked by the one in p0s2-->\n   <transition event=\"event1\" target=\"fail\"/>\n   <!-- this transition will preempt the one that p0s2 inherits\n   from an ancestor  -->\n   <transition event=\"event2\" target=\"s1\"/>\n\n   </state> \n\n<state id=\"p0s4\">\n\t<!-- this transition never gets preempted, should fire twice -->\n\t<transition event=\"*\">\n\t\t<assign location=\"Var1\" expr=\"Var1 + 1\"/>\n\t\t</transition>\n\t</state> \n \n</parallel>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1==2\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n  </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[p0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n     <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[fail]></>   \n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n   \n <{http://www.w3.org/2005/07/scxml}parallel id=[p0]>\n \t\n \t<{http://www.w3.org/2005/07/scxml}state id=[p0s1]>\n \t\t<{http://www.w3.org/2005/07/scxml}transition event=[event1]></>\n \t\t<{http://www.w3.org/2005/07/scxml}transition event=[event2]></>\n \t\t</>\n \n <{http://www.w3.org/2005/07/scxml}state id=[p0s2]>\n   <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[p0s1]>\n     <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n     </>\n     \n   </>\n   \n <{http://www.w3.org/2005/07/scxml}state id=[p0s3]>\n   \n   <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[fail]></>\n   \n   <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[s1]></>\n\n   </> \n\n<{http://www.w3.org/2005/07/scxml}state id=[p0s4]>\n\t\n\t<{http://www.w3.org/2005/07/scxml}transition event=[*]>\n\t\t<{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n\t\t</>\n\t</> \n \n</>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==2] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 405/test405.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that the executable content in the transitions is executed in document order after \nthe states are exited. event1, event2, event3, event4 should be raised in that order when the\nstate machine is entered  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n    \n<state id=\"s0\" initial=\"s01p\">\n <onentry>\n  <send event=\"timeout\" delay=\"1s\"/>\n  </onentry>\n  <transition event=\"timeout\" target=\"fail\"/>\n\n<parallel id=\"s01p\">\n  <transition event=\"event1\" target=\"s02\"/>\n\n   \n <state id=\"s01p1\" initial=\"s01p11\">\n    <state id=\"s01p11\">\n      <onexit>\n       <!-- this should be the second event raised -->\n       <raise event=\"event2\"/>\n       </onexit>\n      <transition target=\"s01p12\">\n        <!-- this should be the third event raised -->\n        <raise event=\"event3\"/>\n        </transition>\n   </state>\n    <state id=\"s01p12\"/>\n </state>  <!-- end s01p1 -->\n \n <state id=\"s01p2\" initial=\"s01p21\">\n    <state id=\"s01p21\">\n      <onexit>\n       <!-- this should be the first event raised -->\n       <raise event=\"event1\"/>\n       </onexit>\n      <transition target=\"s01p22\">\n        <!-- this should be the fourth event raised -->\n        <raise event=\"event4\"/>\n        </transition>\n   </state>\n    <state id=\"s01p22\"/>\n    \n </state>  <!-- end s01p2 -->\n </parallel> \n\n  \n  <state id=\"s02\">\n    <transition event=\"event2\" target=\"s03\"/>\n    <transition event=\"*\" target=\"fail\"/>\n    </state>\n    \n  <state id=\"s03\">\n    <transition event=\"event3\" target=\"s04\"/>\n    <transition event=\"*\" target=\"fail\"/>\n    </state>\n\n    \n  <state id=\"s04\">\n    <transition event=\"event4\" target=\"pass\"/>\n    <transition event=\"*\" target=\"fail\"/>\n    </state>\n   \n </state>  <!-- end s01 -->\n \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n    \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01p]>\n <{http://www.w3.org/2005/07/scxml}onentry>\n  <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n  </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n\n<{http://www.w3.org/2005/07/scxml}parallel id=[s01p]>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[s02]></>\n\n   \n <{http://www.w3.org/2005/07/scxml}state id=[s01p1] initial=[s01p11]>\n    <{http://www.w3.org/2005/07/scxml}state id=[s01p11]>\n      <{http://www.w3.org/2005/07/scxml}onexit>\n       \n       <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n       </>\n      <{http://www.w3.org/2005/07/scxml}transition target=[s01p12]>\n        \n        <{http://www.w3.org/2005/07/scxml}raise event=[event3]></>\n        </>\n   </>\n    <{http://www.w3.org/2005/07/scxml}state id=[s01p12]></>\n </>  \n \n <{http://www.w3.org/2005/07/scxml}state id=[s01p2] initial=[s01p21]>\n    <{http://www.w3.org/2005/07/scxml}state id=[s01p21]>\n      <{http://www.w3.org/2005/07/scxml}onexit>\n       \n       <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n       </>\n      <{http://www.w3.org/2005/07/scxml}transition target=[s01p22]>\n        \n        <{http://www.w3.org/2005/07/scxml}raise event=[event4]></>\n        </>\n   </>\n    <{http://www.w3.org/2005/07/scxml}state id=[s01p22]></>\n    \n </>  \n </> \n\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s02]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[s03]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n    \n  <{http://www.w3.org/2005/07/scxml}state id=[s03]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[event3] target=[s04]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n\n    \n  <{http://www.w3.org/2005/07/scxml}state id=[s04]>\n    <{http://www.w3.org/2005/07/scxml}transition event=[event4] target=[pass]></>\n    <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n   \n </>  \n \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 407/test407.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- a simple test that onexit handlers work. var1 should be incremented when we leave s0 --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n <data id=\"Var1\" expr=\"0\"/>\n </datamodel>\n       \n<state id=\"s0\">\n  <onexit>\n     <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onexit>\n  <transition target=\"s1\"/>\n</state>\n\n<state id=\"s1\">\n  <transition cond=\"Var1==1\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n </>\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onexit>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition target=[s1]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 411/test411.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that states are added to the active states list as they are entered and before onentry handlers\nare executed.  When s0's onentry handler fires we should not be in s01.  But when s01's onentry handler\nfires, we should be in s01.  Therefore event1 should not fire, but event2 should.  Either event1 or\ntimeout also indicates failure  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n     \n<state id=\"s0\" initial=\"s01\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    <if cond=\"In('s01')\">\n      <raise event=\"event1\"/>\n      </if>\n    </onentry>\n  \n  <transition event=\"timeout\" target=\"fail\"/> \n  <transition event=\"event1\" target=\"fail\"/>\n  <transition event=\"event2\" target=\"pass\"/>\n  \n  <state id=\"s01\">\n    <onentry>\n     <if cond=\"In('s01')\">\n       <raise event=\"event2\"/>\n       </if>\n       </onentry>\n  </state> \n\n</state> <!-- end s0 -->\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    <{http://www.w3.org/2005/07/scxml}if cond=[In('s01')]>\n      <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n      </>\n    </>\n  \n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></> \n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event2] target=[pass]></>\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n    <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}if cond=[In('s01')]>\n       <{http://www.w3.org/2005/07/scxml}raise event=[event2]></>\n       </>\n       </>\n  </> \n\n</> \n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 413/test413.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the state machine is put into the configuration specified by the initial element, without regard\nto any other defaults.  we should start off in s2p111 and s2p122.  the atomic\nstates we should not enter all have immediate transitions to failure in them --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s2p112 s2p122\" version=\"1.0\" datamodel=\"ecmascript\">\n\n <state id=\"s1\">\n   <transition target=\"fail\"/>\n   </state>\n       \n<state id=\"s2\" initial=\"s2p1\">\n\n<parallel id=\"s2p1\">\n  <!-- this transition will be triggered only if we end up in an illegal configuration where we're in\n  either s2p112 or s2p122, but not both of them -->\n  <transition target=\"fail\"/>\n  \n  <state id=\"s2p11\" initial=\"s2p111\">\n    <state id=\"s2p111\">\n      <transition target=\"fail\"/>\n    </state>\n    \n    <state id=\"s2p112\">\n      <transition cond=\"In('s2p122')\" target=\"pass\"/>\n      </state>\n\n  </state> <!-- end s2p11 -->\n  \n  <state id=\"s2p12\" initial=\"s2p121\">\n    <state id=\"s2p121\">\n       <transition target=\"fail\"/>\n     </state>\n    \n    <state id=\"s2p122\">\n      <transition cond=\"In('s2p112')\" target=\"pass\"/>\n    </state>\n  </state>\n  \n</parallel>\n\n</state>  <!-- end s2 -->\n \n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s2p112 s2p122] version=[1.0] datamodel=[ecmascript]>\n\n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n       \n<{http://www.w3.org/2005/07/scxml}state id=[s2] initial=[s2p1]>\n\n<{http://www.w3.org/2005/07/scxml}parallel id=[s2p1]>\n  \n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s2p11] initial=[s2p111]>\n    <{http://www.w3.org/2005/07/scxml}state id=[s2p111]>\n      <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n    </>\n    \n    <{http://www.w3.org/2005/07/scxml}state id=[s2p112]>\n      <{http://www.w3.org/2005/07/scxml}transition cond=[In('s2p122')] target=[pass]></>\n      </>\n\n  </> \n  \n  <{http://www.w3.org/2005/07/scxml}state id=[s2p12] initial=[s2p121]>\n    <{http://www.w3.org/2005/07/scxml}state id=[s2p121]>\n       <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n     </>\n    \n    <{http://www.w3.org/2005/07/scxml}state id=[s2p122]>\n      <{http://www.w3.org/2005/07/scxml}transition cond=[In('s2p112')] target=[pass]></>\n    </>\n  </>\n  \n</>\n\n</>  \n \n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 416/test416.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the done.state.id gets generated when we enter the final state of a compound state --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s1\" datamodel=\"ecmascript\">\n\n <state id=\"s1\" initial=\"s11\">\n   <onentry>\n     <send event=\"timeout\" delay=\"1s\"/>\n     </onentry>\n   <transition event=\"timeout\" target=\"fail\"/>\n   \n   <state id=\"s11\" initial=\"s111\">\n     <transition event=\"done.state.s11\" target=\"pass\"/>\n     <state id=\"s111\">\n       <transition target=\"s11final\"/>\n       </state>\n     <final id=\"s11final\"/>\n   </state>\n </state>      \n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s1] datamodel=[ecmascript]>\n\n <{http://www.w3.org/2005/07/scxml}state id=[s1] initial=[s11]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n     </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n   \n   <{http://www.w3.org/2005/07/scxml}state id=[s11] initial=[s111]>\n     <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s11] target=[pass]></>\n     <{http://www.w3.org/2005/07/scxml}state id=[s111]>\n       <{http://www.w3.org/2005/07/scxml}transition target=[s11final]></>\n       </>\n     <{http://www.w3.org/2005/07/scxml}final id=[s11final]></>\n   </>\n </>      \n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 419/test419.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that eventless transitions take precedence over event-driven ones --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s1\" datamodel=\"ecmascript\">\n\n <state id=\"s1\">\n   <onentry>\n     <raise event=\"internalEvent\"/>\n     <send event=\"externalEvent\"/>\n     </onentry>\n    \n   <transition event=\"*\" target=\"fail\"/>\n   <transition target=\"pass\"/>\n\n</state> \n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s1] datamodel=[ecmascript]>\n\n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}raise event=[internalEvent]></>\n     <{http://www.w3.org/2005/07/scxml}send event=[externalEvent]></>\n     </>\n    \n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[pass]></>\n\n</> \n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 422/test422.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- Test that at the end of a macrostep, the processor executes all invokes in states\nthat have been entered and not exited during the step.  (The invokes are supposed to be executed\nin document order, but we can test that since each invocation is separate and they may take\ndifferent amounts to time to start up.)  In this case, there are three invoke statements,\nin states s1, s11 and s12.  Each invoked process returns an event named after its parent state.\nThe invokes in s1 and s12 should execute, but not the one\nin s11. So we should receive invokeS1, invokeS12, but not invokeS12.  Furthermore, when the timeout fires, var1 should equal 2.--><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"s1\" datamodel=\"ecmascript\">\n<datamodel>\n\t <data id=\"Var1\" expr=\"0\"/>\n\t</datamodel>\n <state id=\"s1\" initial=\"s11\">\n \t <onentry>\n \t \t<send event=\"timeout\" delayexpr=\"'2s'\"/>\n \t \t</onentry>\n \t   <transition event=\"invokeS1 invokeS12\">\n \t   \t<assign location=\"Var1\" expr=\"Var1 + 1\"/>\n \t   \t</transition>\n \t   \t<transition event=\"invokeS11\" target=\"fail\"/>\n \t  \n \t  <transition event=\"timeout\" cond=\"Var1==2\" target=\"pass\"/>\n \t  <transition event=\"timeout\" target=\"fail\"/>\n     <invoke>\n     \t  <content>\n        <!-- when invoked, send 'foo' to parent, then terminate.   -->\n          <scxml initial=\"sub0\" version=\"1.0\" datamodel=\"ecmascript\">\n            <state id=\"sub0\">\n            \t <onentry>\n                <send target=\"#_parent\" event=\"invokeS1\"/>\n               </onentry>\n                <transition target=\"subFinal0\"/>\n              </state>\n           <final id=\"subFinal0\"/>\n        </scxml>\n      </content>\n     \t </invoke>\n     \n   <state id=\"s11\">\n   \t<invoke>\n   \t\t    \t  <content>\n        <!-- when invoked, send 'foo' to parent, then terminate.   -->\n          <scxml initial=\"sub1\" version=\"1.0\" datamodel=\"ecmascript\">\n            <state id=\"sub1\">\n           \t <onentry>\n                <send target=\"#_parent\" event=\"invokeS11\"/>\n               </onentry>\n                <transition target=\"subFinal1\"/>\n              </state>\n           <final id=\"subFinal1\"/>\n            </scxml>\n      </content>\n      </invoke>\n   \t  <transition target=\"s12\"/>\n   \t</state>\n  <state id=\"s12\">\n  \t<invoke>\n     <content>\n        <!-- when invoked, send 'foo' to parent, then terminate.   -->\n          <scxml initial=\"sub2\" version=\"1.0\" datamodel=\"ecmascript\">\n            <state id=\"sub2\">\n            \t <onentry>\n                <send target=\"#_parent\" event=\"invokeS12\"/>\n               </onentry>\n                <transition target=\"subFinal2\"/>\n              </state>\n           <final id=\"subFinal2\"/>\n            </scxml>\n      </content>\n  \t\t</invoke>\n  \t</state>\n </state>\n     \n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[s1] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n\t <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n\t</>\n <{http://www.w3.org/2005/07/scxml}state id=[s1] initial=[s11]>\n \t <{http://www.w3.org/2005/07/scxml}onentry>\n \t \t<{http://www.w3.org/2005/07/scxml}send event=[timeout] delayexpr=['2s']></>\n \t \t</>\n \t   <{http://www.w3.org/2005/07/scxml}transition event=[invokeS1 invokeS12]>\n \t   \t<{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n \t   \t</>\n \t   \t<{http://www.w3.org/2005/07/scxml}transition event=[invokeS11] target=[fail]></>\n \t  \n \t  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] cond=[Var1==2] target=[pass]></>\n \t  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n     <{http://www.w3.org/2005/07/scxml}invoke>\n     \t  <{http://www.w3.org/2005/07/scxml}content>\n        \n          <{http://www.w3.org/2005/07/scxml}scxml initial=[sub0] version=[1.0] datamodel=[ecmascript]>\n            <{http://www.w3.org/2005/07/scxml}state id=[sub0]>\n            \t <{http://www.w3.org/2005/07/scxml}onentry>\n                <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[invokeS1]></>\n               </>\n                <{http://www.w3.org/2005/07/scxml}transition target=[subFinal0]></>\n              </>\n           <{http://www.w3.org/2005/07/scxml}final id=[subFinal0]></>\n        </>\n      </>\n     \t </>\n     \n   <{http://www.w3.org/2005/07/scxml}state id=[s11]>\n   \t<{http://www.w3.org/2005/07/scxml}invoke>\n   \t\t    \t  <{http://www.w3.org/2005/07/scxml}content>\n        \n          <{http://www.w3.org/2005/07/scxml}scxml initial=[sub1] version=[1.0] datamodel=[ecmascript]>\n            <{http://www.w3.org/2005/07/scxml}state id=[sub1]>\n           \t <{http://www.w3.org/2005/07/scxml}onentry>\n                <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[invokeS11]></>\n               </>\n                <{http://www.w3.org/2005/07/scxml}transition target=[subFinal1]></>\n              </>\n           <{http://www.w3.org/2005/07/scxml}final id=[subFinal1]></>\n            </>\n      </>\n      </>\n   \t  <{http://www.w3.org/2005/07/scxml}transition target=[s12]></>\n   \t</>\n  <{http://www.w3.org/2005/07/scxml}state id=[s12]>\n  \t<{http://www.w3.org/2005/07/scxml}invoke>\n     <{http://www.w3.org/2005/07/scxml}content>\n        \n          <{http://www.w3.org/2005/07/scxml}scxml initial=[sub2] version=[1.0] datamodel=[ecmascript]>\n            <{http://www.w3.org/2005/07/scxml}state id=[sub2]>\n            \t <{http://www.w3.org/2005/07/scxml}onentry>\n                <{http://www.w3.org/2005/07/scxml}send target=[#_parent] event=[invokeS12]></>\n               </>\n                <{http://www.w3.org/2005/07/scxml}transition target=[subFinal2]></>\n              </>\n           <{http://www.w3.org/2005/07/scxml}final id=[subFinal2]></>\n            </>\n      </>\n  \t\t</>\n  \t</>\n </>\n     \n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 436/test436.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that in() predicate works in null data model --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"null\" version=\"1.0\" initial=\"p\">\n\n     \n <parallel id=\"p\">\n \n   <state id=\"ps0\">\n   <transition cond=\"In('s1')\" target=\"fail\"/>\n   <transition cond=\"In('ps1')\" target=\"pass\"/> \n   <transition target=\"fail\"/>\n   </state>\n\n   <state id=\"ps1\"/> \n </parallel>\n \n <state id=\"s1\"/>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[null] version=[1.0] initial=[p]>\n\n     \n <{http://www.w3.org/2005/07/scxml}parallel id=[p]>\n \n   <{http://www.w3.org/2005/07/scxml}state id=[ps0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[In('s1')] target=[fail]></>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[In('ps1')] target=[pass]></> \n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[ps1]></> \n </>\n \n <{http://www.w3.org/2005/07/scxml}state id=[s1]></>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 445/test445.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that ecmascript objects defined by <data> have value undefined if <data> does not assign a value --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n  <datamodel>\n    <data id=\"var1\"/>\n    </datamodel>\n     \n<state id=\"s0\">\n\n  <transition cond=\"var1==undefined\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n</state>\n\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[var1]></>\n    </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n\n  <{http://www.w3.org/2005/07/scxml}transition cond=[var1==undefined] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n</>\n\n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 448/test448.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that all ecmascript objects are placed in a single global scope --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n \n     \n<state id=\"s0\">\n<!-- test that a parent state can access a variable defined in a child -->\n  <transition cond=\"var1==1\" target=\"s1\"/>\n  <transition target=\"fail\"/>\n   <state id=\"s01\">\n    <datamodel>\n      <data id=\"var1\" expr=\"1\"/>\n       </datamodel>\n    </state>\n </state>  \n    <state id=\"s1\" initial=\"s01p\">  \n     <parallel id=\"s01p\">\n       <state id=\"s01p1\">\n  <!-- test that we can access a variable defined in a parallel sibling state -->\n           <transition cond=\"var2==1\" target=\"pass\"/>\n           <transition target=\"fail\"/>\n       </state>\n       <state id=\"s01p2\">\n           <datamodel>\n           <data id=\"var2\" expr=\"1\"/>\n          </datamodel>\n       </state>\n     </parallel>\n    </state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n \n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n\n  <{http://www.w3.org/2005/07/scxml}transition cond=[var1==1] target=[s1]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n    <{http://www.w3.org/2005/07/scxml}datamodel>\n      <{http://www.w3.org/2005/07/scxml}data id=[var1] expr=[1]></>\n       </>\n    </>\n </>  \n    <{http://www.w3.org/2005/07/scxml}state id=[s1] initial=[s01p]>  \n     <{http://www.w3.org/2005/07/scxml}parallel id=[s01p]>\n       <{http://www.w3.org/2005/07/scxml}state id=[s01p1]>\n  \n           <{http://www.w3.org/2005/07/scxml}transition cond=[var2==1] target=[pass]></>\n           <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n       </>\n       <{http://www.w3.org/2005/07/scxml}state id=[s01p2]>\n           <{http://www.w3.org/2005/07/scxml}datamodel>\n           <{http://www.w3.org/2005/07/scxml}data id=[var2] expr=[1]></>\n          </>\n       </>\n     </>\n    </>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 451/test451.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- simple test of the in() predicate --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"p\">\n\n     \n <parallel id=\"p\">\n \n   <state id=\"s0\">\n   <transition cond=\"In('s1')\" target=\"pass\"/> \n   <transition target=\"fail\"/>\n   </state>\n\n   <state id=\"s1\"/> \n </parallel>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n   \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[p]>\n\n     \n <{http://www.w3.org/2005/07/scxml}parallel id=[p]>\n \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[In('s1')] target=[pass]></> \n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s1]></> \n </>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n   \n</>"
# 453/test453.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that we can use any ecmascript expression as a value expression. \nIn this case, we just test that we can assign\na function to a variable and then call it.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n <datamodel>\n   <data id=\"var1\" expr=\"function(invar) {return invar + 1;}\"/>\n   </datamodel>\n\n<state id=\"s0\">\n  <onentry>\n   <raise event=\"event1\"/>\n   </onentry>\n<!-- test that we can call the function -->  \n   <transition event=\"event1\" cond=\"var1(2) == 3\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n    </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[var1] expr=[function(invar) {return invar + 1;}]></>\n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   <{http://www.w3.org/2005/07/scxml}raise event=[event1]></>\n   </>\n  \n   <{http://www.w3.org/2005/07/scxml}transition event=[event1] cond=[var1(2) == 3] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 457/test457.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that an the legal iterable collections are arrays, namely objects that satisfy instanceof(Array) in ECMAScript.\n \t     the legal values for the 'item' attribute on foreach are legal ECMAScript variable names.. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>\n  <data id=\"Var2\"/>\n  <data id=\"Var3\"/>\n  <data id=\"Var4\" expr=\"7\"/>\n  <data id=\"Var5\" expr=\"[1,2,3]\"/>\n  <data id=\"Var6\"/>\n  </datamodel>\n  \n   <state id=\"s0\">\n      <onentry>\n<!-- invalid array, legal item -->\n        <foreach item=\"Var2\" index=\"Var3\" array=\"Var4\">\n          <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n          </foreach>\n        <raise event=\"foo\"/>\n        </onentry>\n   <transition event=\"error.execution\" target=\"s1\"/>\n   <transition event=\"*\" target=\"fail\"/> \n   </state>\n   \n   <state id=\"s1\">\n      <onentry>\n<!-- illegal item, legal array -->\n        <foreach item=\"'continue'\" index=\"Var3\" array=\"Var5\">\n          <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n          </foreach>\n        <raise event=\"bar\"/>\n        </onentry>\n   <transition event=\"error.execution\" target=\"s2\"/>\n   <transition event=\"bar\" target=\"fail\"/> \n   </state>\n\n<state id=\"s2\">\n  <!-- check that var1 has its original value (so executable content never got executed -->\n  <transition cond=\"Var1==0\" target=\"s3\"/>\n  <transition target=\"fail\"/>\n  </state> \n\n\n<!-- finally check that a legal array works properly -->\n<state id=\"s3\">\n\t<onentry>\n\t\t<assign location=\"Var6\" expr=\"0\"/>\n    <foreach item=\"Var2\" array=\"Var5\">\n\t  <assign location=\"Var6\" expr=\"Var6 + Var2\"/>\n\t</foreach>\n\t</onentry>\n\t  <transition cond=\"Var6==6\" target=\"pass\"/>\n\t  <transition target=\"fail\"/>\n </state>   \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var2]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var3]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var4] expr=[7]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var5] expr=[[1,2,3]]></>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var6]></>\n  </>\n  \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n\n        <{http://www.w3.org/2005/07/scxml}foreach item=[Var2] index=[Var3] array=[Var4]>\n          <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n          </>\n        <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n        </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></> \n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n\n        <{http://www.w3.org/2005/07/scxml}foreach item=['continue'] index=[Var3] array=[Var5]>\n          <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n          </>\n        <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n        </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s2]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[bar] target=[fail]></> \n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n  \n  <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==0] target=[s3]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </> \n\n\n\n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n\t<{http://www.w3.org/2005/07/scxml}onentry>\n\t\t<{http://www.w3.org/2005/07/scxml}assign location=[Var6] expr=[0]></>\n    <{http://www.w3.org/2005/07/scxml}foreach item=[Var2] array=[Var5]>\n\t  <{http://www.w3.org/2005/07/scxml}assign location=[Var6] expr=[Var6 + Var2]></>\n\t</>\n\t</>\n\t  <{http://www.w3.org/2005/07/scxml}transition cond=[Var6==6] target=[pass]></>\n\t  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </>   \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n\n\n</>"
# 460/test460.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that <foreach> does a shallow copy, so that modifying the array does not change\nthe iteration behavior. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n  <datamodel>\n    <data id=\"Var1\" expr=\"[1,2,3]\"/>\n    <data id=\"Var2\" expr=\"0\"/>  <!-- counts the number of iterations -->\n    </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n  <foreach item=\"Var3\" array=\"Var1\">\n    <assign location=\"Var1\" expr=\"[].concat(Var1, [4])\"/>\n    <assign location=\"Var2\" expr=\"Var2 + 1\"/>\n    </foreach>\n   </onentry>\n   \n   <transition cond=\"Var2==3\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n</state>\n\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[[1,2,3]]></>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[0]></>  \n    </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  <{http://www.w3.org/2005/07/scxml}foreach item=[Var3] array=[Var1]>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[[].concat(Var1, [4])]></>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[Var2 + 1]></>\n    </>\n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}transition cond=[Var2==3] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n</>\n\n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 488/test488.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that illegal expr in <param> produces error.execution and empty event.data --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n     \n <state id=\"s0\" initial=\"s01\">\n   <!-- we should get the error before the done event -->\n   <transition event=\"error.execution\" target=\"s1\"/>\n   <transition event=\"done.state.s0\" target=\"fail\"/>     \n\n      <transition event=\"done.state.s0\" target=\"fail\">\n     </transition>\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <param expr=\"return\" name=\"someParam\"/>\n      </donedata>\n     </final>\n  </state>\n\n \n <!-- if we get here, we received the error event. Now check that the done\n event has empty event.data -->\n \n <state id=\"s1\">\n   <transition event=\"done.state.s0\" cond=\"typeof _event.data === 'undefined'\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n   \n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] target=[fail]></>     \n\n      <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] target=[fail]>\n     </>\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s02]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}final id=[s02]>\n     <{http://www.w3.org/2005/07/scxml}donedata>\n      <{http://www.w3.org/2005/07/scxml}param expr=[return] name=[someParam]></>\n      </>\n     </>\n  </>\n\n \n \n \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] cond=[typeof _event.data === 'undefined'] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 496/test496.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n   <onentry>\n     <send type=\"http://www.w3.org/TR/scxml/#SCXMLEventProcessor\" event=\"event\" target=\"#_scxml_foo\"/>\n     <raise event=\"foo\"/>\n     </onentry>\n   <transition event=\"error.communication\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n    \n\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n     <{http://www.w3.org/2005/07/scxml}send type=[http://www.w3.org/TR/scxml/#SCXMLEventProcessor] event=[event] target=[#_scxml_foo]></>\n     <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n     </>\n   <{http://www.w3.org/2005/07/scxml}transition event=[error.communication] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n    \n\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 501/test501.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the location entry for the SCXML Event I/O processor can be used as the target for an event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"_ioprocessors['http://www.w3.org/TR/scxml/#SCXMLEventProcessor'].location\"/>\n  </datamodel>\n  \n<state id=\"s0\">\n  <onentry>\n    <send targetexpr=\"Var1\" event=\"foo\"/>\n    <send event=\"timeout\" delay=\"2s\"/>\n    </onentry>\n  <transition event=\"foo\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n   \n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[_ioprocessors['http://www.w3.org/TR/scxml/#SCXMLEventProcessor'].location]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send targetexpr=[Var1] event=[foo]></>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   \n </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 504/test504.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that an external transition exits all states up the the LCCA --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s1\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>  <!-- how often we have exited p -->\n  <data id=\"Var2\" expr=\"0\"/>  <!-- how often we have exited ps1 -->\n  <data id=\"Var3\" expr=\"0\"/>  <!-- how often we have exited ps2 -->\n  <data id=\"Var4\" expr=\"0\"/>  <!-- how often the transition for foo has been taken -->\n  <data id=\"Var5\" expr=\"0\"/>  <!-- how often we have exited s2  -->\n  </datamodel>\n    \n <state id=\"s1\">\n   <onentry>\n    <raise event=\"foo\"/>\n    <raise event=\"bar\"/>\n    </onentry>\n   <transition target=\"p\"/>\n   </state>\n   \n<state id=\"s2\">\n\t <onexit>\n\t \t<assign location=\"Var5\" expr=\"Var5 + 1\"/>\n\t \t</onexit>\n\n<parallel id=\"p\">\n  <onexit>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onexit>\n  <transition event=\"foo\" target=\"ps1\">\n     <assign location=\"Var4\" expr=\"Var4 + 1\"/>\n     </transition>\n     \n   <!-- make sure the transition on foo was actually taken --> \n  <transition event=\"bar\" cond=\"Var4==1\" target=\"s3\"/>\n  <transition event=\"bar\" target=\"fail\"/>\n  \n <state id=\"ps1\">\n   <onexit>\n   <assign location=\"Var2\" expr=\"Var2 + 1\"/>\n   </onexit>\n  </state>\n  <state id=\"ps2\">\n   <onexit>\n   <assign location=\"Var3\" expr=\"Var3 + 1\"/>\n   </onexit>\n  </state>\n</parallel>\n</state>\n  \n<state id=\"s3\">\n  <!-- make sure that p was exited twice -->\n    <transition cond=\"Var1==2\" target=\"s4\"/>\n    <transition target=\"fail\"/>\n </state> \n \n<state id=\"s4\">\n  <!-- make sure that ps1 was exited twice -->\n    <transition cond=\"Var2==2\" target=\"s5\"/>\n    <transition target=\"fail\"/>\n </state> \n  \n<state id=\"s5\">\n  <!-- make sure that ps2 was exited twice -->\n    <transition cond=\"Var3==2\" target=\"s6\"/>\n    <transition target=\"fail\"/>\n </state>\n \n<state id=\"s6\">\n\t<!-- make sure that s1 was exited once -->\n\t<transition cond=\"Var5==1\" target=\"pass\"/>\n\t<transition target=\"fail\"/>\n\t</state>\n  \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s1] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var3] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var4] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var5] expr=[0]></>  \n  </>\n    \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}transition target=[p]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s2]>\n\t <{http://www.w3.org/2005/07/scxml}onexit>\n\t \t<{http://www.w3.org/2005/07/scxml}assign location=[Var5] expr=[Var5 + 1]></>\n\t \t</>\n\n<{http://www.w3.org/2005/07/scxml}parallel id=[p]>\n  <{http://www.w3.org/2005/07/scxml}onexit>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] target=[ps1]>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var4] expr=[Var4 + 1]></>\n     </>\n     \n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] cond=[Var4==1] target=[s3]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] target=[fail]></>\n  \n <{http://www.w3.org/2005/07/scxml}state id=[ps1]>\n   <{http://www.w3.org/2005/07/scxml}onexit>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[Var2 + 1]></>\n   </>\n  </>\n  <{http://www.w3.org/2005/07/scxml}state id=[ps2]>\n   <{http://www.w3.org/2005/07/scxml}onexit>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var3] expr=[Var3 + 1]></>\n   </>\n  </>\n</>\n</>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n  \n    <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==2] target=[s4]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </> \n \n<{http://www.w3.org/2005/07/scxml}state id=[s4]>\n  \n    <{http://www.w3.org/2005/07/scxml}transition cond=[Var2==2] target=[s5]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </> \n  \n<{http://www.w3.org/2005/07/scxml}state id=[s5]>\n  \n    <{http://www.w3.org/2005/07/scxml}transition cond=[Var3==2] target=[s6]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </>\n \n<{http://www.w3.org/2005/07/scxml}state id=[s6]>\n\t\n\t<{http://www.w3.org/2005/07/scxml}transition cond=[Var5==1] target=[pass]></>\n\t<{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n\t</>\n  \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 506/test506.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that an internal transition whose targets are not proper descendants of its source state\nbehaves like an external transition --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s1\" version=\"1.0\" datamodel=\"ecmascript\">\n<datamodel>\n  <data id=\"Var1\" expr=\"0\"/>  <!-- how often we have exited s2 -->\n  <data id=\"Var2\" expr=\"0\"/>  <!-- how often we have exited s21 -->\n  <data id=\"Var3\" expr=\"0\"/>  <!-- how often the transition for foo has been taken -->\n  </datamodel>\n    \n <state id=\"s1\">\n   <onentry>\n    <raise event=\"foo\"/>\n    <raise event=\"bar\"/>\n    </onentry>\n   <transition target=\"s2\"/>\n   </state>\n\n<state id=\"s2\" initial=\"s21\">\n  <onexit>\n    <assign location=\"Var1\" expr=\"Var1 + 1\"/>\n    </onexit>\n  <transition event=\"foo\" type=\"internal\" target=\"s2\">\n     <assign location=\"Var3\" expr=\"Var3 + 1\"/>\n     </transition>\n     \n   <!-- make sure the transition on foo was actually taken --> \n  <transition event=\"bar\" cond=\"Var3==1\" target=\"s3\"/>\n  <transition event=\"bar\" target=\"fail\"/>\n  \n <state id=\"s21\">\n   <onexit>\n   <assign location=\"Var2\" expr=\"Var2 + 1\"/>\n   </onexit>\n  </state>\n\n</state>\n  \n<state id=\"s3\">\n  <!-- make sure that s2 was exited twice -->\n    <transition cond=\"Var1==2\" target=\"s4\"/>\n    <transition target=\"fail\"/>\n </state> \n \n<state id=\"s4\">\n  <!-- make sure that s21 was exited twice -->\n    <transition cond=\"Var2==2\" target=\"pass\"/>\n    <transition target=\"fail\"/>\n </state> \n  \n  \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n     \n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s1] version=[1.0] datamodel=[ecmascript]>\n<{http://www.w3.org/2005/07/scxml}datamodel>\n  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[0]></>  \n  <{http://www.w3.org/2005/07/scxml}data id=[Var3] expr=[0]></>  \n  </>\n    \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}raise event=[foo]></>\n    <{http://www.w3.org/2005/07/scxml}raise event=[bar]></>\n    </>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s2]></>\n   </>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s2] initial=[s21]>\n  <{http://www.w3.org/2005/07/scxml}onexit>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] type=[internal] target=[s2]>\n     <{http://www.w3.org/2005/07/scxml}assign location=[Var3] expr=[Var3 + 1]></>\n     </>\n     \n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] cond=[Var3==1] target=[s3]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[bar] target=[fail]></>\n  \n <{http://www.w3.org/2005/07/scxml}state id=[s21]>\n   <{http://www.w3.org/2005/07/scxml}onexit>\n   <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[Var2 + 1]></>\n   </>\n  </>\n\n</>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s3]>\n  \n    <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==2] target=[s4]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </> \n \n<{http://www.w3.org/2005/07/scxml}state id=[s4]>\n  \n    <{http://www.w3.org/2005/07/scxml}transition cond=[Var2==2] target=[pass]></>\n    <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n </> \n  \n  \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n     \n</>"
# 510/test510.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that Basic HTTP messages go into external queue.   --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n  \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\"/>\n     <!-- this creates an internal event -->\n     <raise event=\"internal\"/>\n  \n      </onentry>\n     <!-- we should get 'internal' first, then 'test' -->\n  <transition event=\"internal\" target=\"s1\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n <state id=\"s1\">\n   <transition event=\"test\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[30s]></>\n    <{http://www.w3.org/2005/07/scxml}send event=[test] targetexpr=[_ioprocessors['basichttp']['location']] type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor]></>\n     \n     <{http://www.w3.org/2005/07/scxml}raise event=[internal]></>\n  \n      </>\n     \n  <{http://www.w3.org/2005/07/scxml}transition event=[internal] target=[s1]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}transition event=[test] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 519/test519.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that that <param> values get encoded as POST parameters.  . --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n      <param name=\"param1\" expr=\"1\"/>\n       </send>  \n     </onentry>\n     \n     <!-- if other end sends us back this event, we succeed -->\n  <transition event=\"test\" cond=\"_event.raw.search('param1=1') !== -1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[30s]></>\n    <{http://www.w3.org/2005/07/scxml}send event=[test] targetexpr=[_ioprocessors['basichttp']['location']] type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor]>\n      <{http://www.w3.org/2005/07/scxml}param name=[param1] expr=[1]></>\n       </>  \n     </>\n     \n     \n  <{http://www.w3.org/2005/07/scxml}transition event=[test] cond=[_event.raw.search('param1=1') !== -1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 521/test521.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that the processor raises error.communication if it cannot dispatch the event.\n(To create an undispatchable event, we choose a non-existent session as target).  If it raises\nthe error event, we succeed.  Otherwise we eventually timeout and fail.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n  \n<state id=\"s0\">\n  <onentry>\n   <!-- should cause an error -->\n   <send target=\"#_scxml_foo\" event=\"event2\"/>\n   <!-- this will get added to the external event queue after the error has been raised -->\n   <send event=\"timeout\"/>\n    </onentry>\n \n <!-- once we've entered the state, we should check for internal events first -->   \n  <transition event=\"error.communication\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   \n   <{http://www.w3.org/2005/07/scxml}send target=[#_scxml_foo] event=[event2]></>\n   \n   <{http://www.w3.org/2005/07/scxml}send event=[timeout]></>\n    </>\n \n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[error.communication] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 525/test525.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that <foreach> does a shallow copy, so that modifying the array does not change\nthe iteration behavior. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" datamodel=\"ecmascript\" version=\"1.0\">\n  <datamodel>\n    <data id=\"Var1\">\n      [1,2,3]\n      </data>\n    <data id=\"Var2\" expr=\"0\"/>  <!-- counts the number of iterations -->\n    </datamodel>\n     \n<state id=\"s0\">\n  <onentry>\n  <foreach item=\"Var3\" array=\"Var1\">\n    <assign location=\"Var1\" expr=\"[].concat(Var1, [4])\"/>\n    <assign location=\"Var2\" expr=\"Var2 + 1\"/>\n    </foreach>\n   </onentry>\n   \n   <transition cond=\"Var2==3\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n</state>\n\n\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml datamodel=[ecmascript] version=[1.0]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var1]>\n      [1,2,3]\n      </>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var2] expr=[0]></>  \n    </>\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  <{http://www.w3.org/2005/07/scxml}foreach item=[Var3] array=[Var1]>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[[].concat(Var1, [4])]></>\n    <{http://www.w3.org/2005/07/scxml}assign location=[Var2] expr=[Var2 + 1]></>\n    </>\n   </>\n   \n   <{http://www.w3.org/2005/07/scxml}transition cond=[Var2==3] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n</>\n\n\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 528/test528.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--  test that illegal 'expr' produces error.execution and empty event.data --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s0\">\n\n     \n <state id=\"s0\" initial=\"s01\">\n   <!-- we should get the error before the done event -->\n   <transition event=\"error.execution\" target=\"s1\"/>\n   <transition event=\"done.state.s0\" target=\"fail\"/>     \n\n\n   <state id=\"s01\">\n   <transition target=\"s02\"/>\n   </state>\n   <final id=\"s02\">\n     <donedata>\n      <content expr=\"return\"/>\n      </donedata>\n     </final>\n  </state>\n\n \n <!-- if we get here, we received the error event. Now check that the done\n event has empty event.data -->\n \n <state id=\"s1\">\n   <transition event=\"done.state.s0\" cond=\"typeof _event.data === 'undefined'\" target=\"pass\"/>\n   <transition event=\"*\" target=\"fail\"/>\n   </state>\n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] datamodel=[ecmascript] initial=[s0]>\n\n     \n <{http://www.w3.org/2005/07/scxml}state id=[s0] initial=[s01]>\n   \n   <{http://www.w3.org/2005/07/scxml}transition event=[error.execution] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] target=[fail]></>     \n\n\n   <{http://www.w3.org/2005/07/scxml}state id=[s01]>\n   <{http://www.w3.org/2005/07/scxml}transition target=[s02]></>\n   </>\n   <{http://www.w3.org/2005/07/scxml}final id=[s02]>\n     <{http://www.w3.org/2005/07/scxml}donedata>\n      <{http://www.w3.org/2005/07/scxml}content expr=[return]></>\n      </>\n     </>\n  </>\n\n \n \n \n <{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}transition event=[done.state.s0] cond=[typeof _event.data === 'undefined'] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n   </>\n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 530/test530.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that <content> child is evaluated when <invoke> is. Var1 is initialized\nwith an integer value, then set to an scxml script in the onentry to s0.  If <content>\nis evaluated at the right time, we should get invoke.done, otherwise an error  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n  <datamodel>\n    <data id=\"Var1\" expr=\"1\"/>\n    </datamodel>\n    \n    <state id=\"s0\">\n      <onentry>\n        <assign location=\"Var1\">\n           <scxml version=\"1.0\"><final/></scxml>\n           </assign>\n        <send event=\"timeout\" delay=\"2s\"/>\n        </onentry>\n        \n      <invoke type=\"http://www.w3.org/TR/scxml/\">\n        <content expr=\"Var1\"/>\n        </invoke>\n        \n        <transition event=\"done.invoke\" target=\"pass\"/>\n        <transition event=\"*\" target=\"fail\"/>\n    </state>\n    \n    <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n    <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n  </scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n  <{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[1]></>\n    </>\n    \n    <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n      <{http://www.w3.org/2005/07/scxml}onentry>\n        <{http://www.w3.org/2005/07/scxml}assign location=[Var1]>\n           <{http://www.w3.org/2005/07/scxml}scxml version=[1.0]><{http://www.w3.org/2005/07/scxml}final></></>\n           </>\n        <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[2s]></>\n        </>\n        \n      <{http://www.w3.org/2005/07/scxml}invoke type=[http://www.w3.org/TR/scxml/]>\n        <{http://www.w3.org/2005/07/scxml}content expr=[Var1]></>\n        </>\n        \n        <{http://www.w3.org/2005/07/scxml}transition event=[done.invoke] target=[pass]></>\n        <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n    </>\n    \n    <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n    <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n  </>"
# 532/test532.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that that if _scxmleventname  is not present, the name of the HTTP method is used\nas the name of the resulting event. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"3s\"/>\n    <send targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n    <!-- this content will be ignored, but it's here to make sure we have a message body -->\n      <content>some content</content>\n      </send>  \n     </onentry>\n     \n  <transition event=\"HTTP.POST\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[3s]></>\n    <{http://www.w3.org/2005/07/scxml}send targetexpr=[_ioprocessors['basichttp']['location']] type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor]>\n    \n      <{http://www.w3.org/2005/07/scxml}content>some content</>\n      </>  \n     </>\n     \n  <{http://www.w3.org/2005/07/scxml}transition event=[HTTP.POST] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 534/test534.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that that <send> 'event' value gets sent as the param _scxmleventname . --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n   \n<state id=\"s0\">\n  <onentry>\n    <send event=\"timeout\" delay=\"30s\"/>\n    <send event=\"test\" targetexpr=\"_ioprocessors['basichttp']['location']\" type=\"http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor\">\n        </send>  \n     </onentry>\n     \n     <!-- if other end sends us back this event, we succeed -->\n  <transition event=\"test\" cond=\"_event.raw.search('_scxmleventname=test') !== -1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[30s]></>\n    <{http://www.w3.org/2005/07/scxml}send event=[test] targetexpr=[_ioprocessors['basichttp']['location']] type=[http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor]>\n        </>  \n     </>\n     \n     \n  <{http://www.w3.org/2005/07/scxml}transition event=[test] cond=[_event.raw.search('_scxmleventname=test') !== -1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 551/test551.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that inline content can be used to assign a value to a var.  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" binding=\"early\" datamodel=\"ecmascript\">\n\n    \n   <state id=\"s0\">\n \n       <transition cond=\"Var1\" target=\"pass\"/>\n       <transition target=\"fail\"/>\n   </state>\n   \n<state id=\"s1\">\n\t  <datamodel>\n    <data id=\"Var1\">\n     [1,2,3]\n     </data>\n    </datamodel>\n    </state>\n\n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n   \n\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] binding=[early] datamodel=[ecmascript]>\n\n    \n   <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n \n       <{http://www.w3.org/2005/07/scxml}transition cond=[Var1] target=[pass]></>\n       <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n   \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n\t  <{http://www.w3.org/2005/07/scxml}datamodel>\n    <{http://www.w3.org/2005/07/scxml}data id=[Var1]>\n     [1,2,3]\n     </>\n    </>\n    </>\n\n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n   \n\n\n</>"
# 553/test553.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- we test that the processor does not dispatch the event if evaluation\nof <send>'s args causes an error..  --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" datamodel=\"ecmascript\" version=\"1.0\">\n\n  \n<state id=\"s0\">\n  <onentry>\n   <!-- timeout event -->\n   <send event=\"timeout\" delayexpr=\"'1s'\"/>\n   <!-- generate an invalid namelist -->\n   <send event=\"event1\" namelist=\"&#34;foo\"/> \n    </onentry>\n \n <!-- if we get the timeout before event1, we assume that event1 hasn't been sent\n We ignore the error event here because this assertion doesn't mention it -->   \n  <transition event=\"timeout\" target=\"pass\"/>\n  <transition event=\"event1\" target=\"fail\"/>\n </state>\n \n\n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] datamodel=[ecmascript] version=[1.0]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n   \n   <{http://www.w3.org/2005/07/scxml}send event=[timeout] delayexpr=['1s']></>\n   \n   <{http://www.w3.org/2005/07/scxml}send event=[event1] namelist=[\"foo]></> \n    </>\n \n    \n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[event1] target=[fail]></>\n </>\n \n\n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 557/test557.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- in the ECMA data model, test that if the child of <data> is XML, or if XML is loaded via src=, the processor\n assigns it as the value of the var --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n <datamodel>\n   <data id=\"var1\">\n   <books xmlns=\"\">\n     <book title=\"title1\"/>\n     <book title=\"title2\"/>\n   </books>  \n</data>\n <data id=\"var2\" src=\"file:test557.txt\"/> \n  </datamodel>\n  \n<state id=\"s0\">\n   <transition cond=\"var1.getElementsByTagName('book')[0].getAttribute('title') == 'title1'\" target=\"s1\"/>\n   <transition target=\"fail\"/>\n  </state>\n  \n<state id=\"s1\">\n   <transition cond=\"var2.getElementsByTagName('book')[1].getAttribute('title') == 'title2'\" target=\"pass\"/>\n   <transition target=\"fail\"/>\n   </state>\n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n <{http://www.w3.org/2005/07/scxml}datamodel>\n   <{http://www.w3.org/2005/07/scxml}data id=[var1]>\n   <{}books>\n     <{}book title=[title1]></>\n     <{}book title=[title2]></>\n   </>  \n</>\n <{http://www.w3.org/2005/07/scxml}data id=[var2] src=[file:test557.txt]></> \n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[var1.getElementsByTagName('book')[0].getAttribute('title') == 'title1'] target=[s1]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n  </>\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n   <{http://www.w3.org/2005/07/scxml}transition cond=[var2.getElementsByTagName('book')[1].getAttribute('title') == 'title2'] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   </>\n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>  \n\n</>"
# 560/test560.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- in the ECMA data model, test that processor creates correct structure in\n _event.data when receiving KVPs in an event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n   <onentry>\n    <send event=\"foo\">\n    <param name=\"aParam\" expr=\"1\"/>\n    </send>\n  </onentry>\n  <transition event=\"foo\" cond=\"_event.data.aParam == 1\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[foo]>\n    <{http://www.w3.org/2005/07/scxml}param name=[aParam] expr=[1]></>\n    </>\n  </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=[_event.data.aParam == 1] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n  \n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>  \n\n</>"
# 562/test562.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- in the ECMA data model, test that processor creates space normalized string in\n _event.data when receiving anything other than KVPs or XML in an event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n   <onentry>\n    <send event=\"foo\">\n    <content>\nthis is  a  \nstring\n</content>\n    </send>\n  </onentry>\n  <transition event=\"foo\" cond=\"_event.data == 'this is a string'\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[foo]>\n    <{http://www.w3.org/2005/07/scxml}content>\nthis is  a  \nstring\n</>\n    </>\n  </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=[_event.data == 'this is a string'] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n  \n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>  \n\n</>"
# 569/test569.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that location field is found inside entry for SCXML Event I/O processor in the ECMAScript\ndata model.  The tests for the relevant event i/o processors will test that it can be used to\nsend events. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n  <transition cond=\"_ioprocessors['scxml'].location\" target=\"pass\"/>\n  <transition target=\"fail\"/>\n   \n </state>\n  \n   <final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n   <final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[_ioprocessors['scxml'].location] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n   \n </>\n  \n   <{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n   <{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
# 576/test576.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that the 'initial' value of scxml is respected.  We set the value to deeply nested non-default parallel siblings and\ntest that both are entered. --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s11p112 s11p122\" datamodel=\"ecmascript\" version=\"1.0\">\n\n     \n<state id=\"s0\">\n  <transition target=\"fail\"/>\n</state>\n\n<state id=\"s1\">\n  <onentry>\n    <send event=\"timeout\" delay=\"1s\"/>\n    </onentry>\n  <transition event=\"timeout\" target=\"fail\"/>\n  <state id=\"s11\" initial=\"s111\">\n    <state id=\"s111\"/>\n    <parallel id=\"s11p1\">\n       <state id=\"s11p11\" initial=\"s11p111\">\n         <state id=\"s11p111\"/>\n         <state id=\"s11p112\">\n           <onentry>\n             <raise event=\"In-s11p112\"/>\n             </onentry>\n         </state>\n       </state>\n       <state id=\"s11p12\" initial=\"s11p121\">\n        <state id=\"s11p121\"/>\n        <state id=\"s11p122\">\n          <transition event=\"In-s11p112\" target=\"pass\"/>\n          </state>\n       </state>\n      </parallel>\n  </state>\n</state>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s11p112 s11p122] datamodel=[ecmascript] version=[1.0]>\n\n     \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n  <{http://www.w3.org/2005/07/scxml}transition target=[fail]></>\n</>\n\n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[timeout] delay=[1s]></>\n    </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n  <{http://www.w3.org/2005/07/scxml}state id=[s11] initial=[s111]>\n    <{http://www.w3.org/2005/07/scxml}state id=[s111]></>\n    <{http://www.w3.org/2005/07/scxml}parallel id=[s11p1]>\n       <{http://www.w3.org/2005/07/scxml}state id=[s11p11] initial=[s11p111]>\n         <{http://www.w3.org/2005/07/scxml}state id=[s11p111]></>\n         <{http://www.w3.org/2005/07/scxml}state id=[s11p112]>\n           <{http://www.w3.org/2005/07/scxml}onentry>\n             <{http://www.w3.org/2005/07/scxml}raise event=[In-s11p112]></>\n             </>\n         </>\n       </>\n       <{http://www.w3.org/2005/07/scxml}state id=[s11p12] initial=[s11p121]>\n        <{http://www.w3.org/2005/07/scxml}state id=[s11p121]></>\n        <{http://www.w3.org/2005/07/scxml}state id=[s11p122]>\n          <{http://www.w3.org/2005/07/scxml}transition event=[In-s11p112] target=[pass]></>\n          </>\n       </>\n      </>\n  </>\n</>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n</>"
# 578/test578.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- in the ECMA data model, test that processor creates an ECMAScript object\n _event.data when receiving JSON in an event --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" initial=\"s0\" version=\"1.0\" datamodel=\"ecmascript\">\n\n  \n<state id=\"s0\">\n   <onentry>\n    <send event=\"foo\">\n    <content>{ \"productName\" : \"bar\", \"size\" : 27 }</content>\n    </send>\n  </onentry>\n  <transition event=\"foo\" cond=\"_event.data.productName == 'bar'\" target=\"pass\"/>\n  <transition event=\"*\" target=\"fail\"/>\n  </state>\n  \n    \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>  \n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml initial=[s0] version=[1.0] datamodel=[ecmascript]>\n\n  \n<{http://www.w3.org/2005/07/scxml}state id=[s0]>\n   <{http://www.w3.org/2005/07/scxml}onentry>\n    <{http://www.w3.org/2005/07/scxml}send event=[foo]>\n    <{http://www.w3.org/2005/07/scxml}content>{ \"productName\" : \"bar\", \"size\" : 27 }</>\n    </>\n  </>\n  <{http://www.w3.org/2005/07/scxml}transition event=[foo] cond=[_event.data.productName == 'bar'] target=[pass]></>\n  <{http://www.w3.org/2005/07/scxml}transition event=[*] target=[fail]></>\n  </>\n  \n    \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>  \n\n</>"
# 580/test580.scxml
check xcanon("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-- test that a history state never ends up part of the configuration --><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:conf=\"http://www.w3.org/2005/scxml-conformance\" version=\"1.0\" initial=\"p1\" datamodel=\"ecmascript\">\n\t<datamodel>\n\t\t  <data id=\"Var1\" expr=\"0\"/>\n\t\t</datamodel>\n\t\n<parallel id=\"p1\">\n  <onentry>\n  \t<send delay=\"2s\" event=\"timeout\"/>\n    </onentry>\n   \n   \n  <state id=\"s0\">\n <transition cond=\"In('sh1')\" target=\"fail\"/>\n <transition event=\"timeout\" target=\"fail\"/>\n  \t</state>\n \n           \n<state id=\"s1\">\n\t<initial>\n\t\t <transition target=\"sh1\"/>\n\t\t \t</initial>\n\n\n <history id=\"sh1\">\n \t  <transition target=\"s11\"/>\n   \t</history>\n  \t\n  \t<state id=\"s11\">\n  \t\t<transition cond=\"In('sh1')\" target=\"fail\"/>\n  \t\t<transition target=\"s12\"/>\n  \t\t</state>\n  \t\t\n  \t<state id=\"s12\"/>\n  <transition cond=\"In('sh1')\" target=\"fail\"/>\n <transition cond=\"Var1==0\" target=\"sh1\"/>\n <transition cond=\"Var1==1\" target=\"pass\"/>\n   <onexit>\n  \t<assign location=\"Var1\" expr=\"Var1 + 1\"/>\n  \t</onexit>\n </state>\n \n\n </parallel>\n \n<final id=\"pass\"><onentry><log label=\"Outcome\" expr=\"'pass'\"/></onentry></final>\n<final id=\"fail\"><onentry><log label=\"Outcome\" expr=\"'fail'\"/></onentry></final>\n\n</scxml>") == "<{http://www.w3.org/2005/07/scxml}scxml version=[1.0] initial=[p1] datamodel=[ecmascript]>\n\t<{http://www.w3.org/2005/07/scxml}datamodel>\n\t\t  <{http://www.w3.org/2005/07/scxml}data id=[Var1] expr=[0]></>\n\t\t</>\n\t\n<{http://www.w3.org/2005/07/scxml}parallel id=[p1]>\n  <{http://www.w3.org/2005/07/scxml}onentry>\n  \t<{http://www.w3.org/2005/07/scxml}send delay=[2s] event=[timeout]></>\n    </>\n   \n   \n  <{http://www.w3.org/2005/07/scxml}state id=[s0]>\n <{http://www.w3.org/2005/07/scxml}transition cond=[In('sh1')] target=[fail]></>\n <{http://www.w3.org/2005/07/scxml}transition event=[timeout] target=[fail]></>\n  \t</>\n \n           \n<{http://www.w3.org/2005/07/scxml}state id=[s1]>\n\t<{http://www.w3.org/2005/07/scxml}initial>\n\t\t <{http://www.w3.org/2005/07/scxml}transition target=[sh1]></>\n\t\t \t</>\n\n\n <{http://www.w3.org/2005/07/scxml}history id=[sh1]>\n \t  <{http://www.w3.org/2005/07/scxml}transition target=[s11]></>\n   \t</>\n  \t\n  \t<{http://www.w3.org/2005/07/scxml}state id=[s11]>\n  \t\t<{http://www.w3.org/2005/07/scxml}transition cond=[In('sh1')] target=[fail]></>\n  \t\t<{http://www.w3.org/2005/07/scxml}transition target=[s12]></>\n  \t\t</>\n  \t\t\n  \t<{http://www.w3.org/2005/07/scxml}state id=[s12]></>\n  <{http://www.w3.org/2005/07/scxml}transition cond=[In('sh1')] target=[fail]></>\n <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==0] target=[sh1]></>\n <{http://www.w3.org/2005/07/scxml}transition cond=[Var1==1] target=[pass]></>\n   <{http://www.w3.org/2005/07/scxml}onexit>\n  \t<{http://www.w3.org/2005/07/scxml}assign location=[Var1] expr=[Var1 + 1]></>\n  \t</>\n </>\n \n\n </>\n \n<{http://www.w3.org/2005/07/scxml}final id=[pass]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['pass']></></></>\n<{http://www.w3.org/2005/07/scxml}final id=[fail]><{http://www.w3.org/2005/07/scxml}onentry><{http://www.w3.org/2005/07/scxml}log label=[Outcome] expr=['fail']></></></>\n\n</>"
