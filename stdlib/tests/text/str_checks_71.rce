check t_digest(t_replace(t_build(["\u{4e2d}", "ba", "\u{4e2d}"], [300000, 10, 300000]), "\u{4e2d}b", "\u{df}\u{df}\u{df}")) == "600021:c5ac6fbd0fea998e97914c88f2b9834b4387f8d71ad9248d464907e1de3c860d"
