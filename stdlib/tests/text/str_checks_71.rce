check t_digest(t_replace_n(t_build(["\u{4e2d}", "ba", "\u{4e2d}"], [300000, 10, 300000]), "\u{4e2d}b", "", 3)) == "600018:4c3dd329e25722aefd3e3e5a2491c2c25aead509a0486b90651862aa925a37c3"
# big_splitn cpython
check t_dlist(t_splitn(t_build(["\u{4e2d}", "ba", "\u{4e2d}"], [300000, 10, 300000]), "\u{4e2d}b", -1)) == "2:2f00c6903bb5802a67445a87d958320dfdfd00b00a1071a2b2f71e373a049951"
# big_splitn cpython
check t_dlist(t_splitn(t_build(["\u{4e2d}", "ba", "\u{4e2d}"], [300000, 10, 300000]), "\u{4e2d}b", 2)) == "2:2f00c6903bb5802a67445a87d958320dfdfd00b00a1071a2b2f71e373a049951"
# big_splitlines cpython
check t_dlist(t_splitlines(t_build(["\u{4e2d}", "ba", "\u{4e2d}"], [300000, 10, 300000]), false)) == "1:e7038293ecadd82ca3b6ab98676cc91c1f6e98a2eebb89af5ad543bdcac31a95"
