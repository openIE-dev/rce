check t_case("\u{457} \u{458} \u{459} \u{45a} \u{45b} \u{45c} \u{45d} \u{45e} \u{45f} \u{460} \u{461} \u{462} \u{463} \u{464} \u{465} \u{466} \u{467} \u{468} \u{469} \u{46a} \u{46b} \u{46c} \u{46d} \u{46e} \u{46f} \u{470} \u{471} \u{472} \u{473} \u{474} \u{475} \u{476} \u{477} \u{478} \u{479} \u{47a} \u{47b} \u{47c} \u{47d} \u{47e}") == ["\u{407} \u{408} \u{409} \u{40a} \u{40b} \u{40c} \u{40d} \u{40e} \u{40f} \u{460} \u{460} \u{462} \u{462} \u{464} \u{464} \u{466} \u{466} \u{468} \u{468} \u{46a} \u{46a} \u{46c} \u{46c} \u{46e} \u{46e} \u{470} \u{470} \u{472} \u{472} \u{474} \u{474} \u{476} \u{476} \u{478} \u{478} \u{47a} \u{47a} \u{47c} \u{47c} \u{47e}", "\u{457} \u{458} \u{459} \u{45a} \u{45b} \u{45c} \u{45d} \u{45e} \u{45f} \u{461} \u{461} \u{463} \u{463} \u{465} \u{465} \u{467} \u{467} \u{469} \u{469} \u{46b} \u{46b} \u{46d} \u{46d} \u{46f} \u{46f} \u{471} \u{471} \u{473} \u{473} \u{475} \u{475} \u{477} \u{477} \u{479} \u{479} \u{47b} \u{47b} \u{47d} \u{47d} \u{47f}", "\u{457} \u{458} \u{459} \u{45a} \u{45b} \u{45c} \u{45d} \u{45e} \u{45f} \u{461} \u{461} \u{463} \u{463} \u{465} \u{465} \u{467} \u{467} \u{469} \u{469} \u{46b} \u{46b} \u{46d} \u{46d} \u{46f} \u{46f} \u{471} \u{471} \u{473} \u{473} \u{475} \u{475} \u{477} \u{477} \u{479} \u{479} \u{47b} \u{47b} \u{47d} \u{47d} \u{47f}", "\u{407} \u{408} \u{409} \u{40a} \u{40b} \u{40c} \u{40d} \u{40e} \u{40f} \u{460} \u{460} \u{462} \u{462} \u{464} \u{464} \u{466} \u{466} \u{468} \u{468} \u{46a} \u{46a} \u{46c} \u{46c} \u{46e} \u{46e} \u{470} \u{470} \u{472} \u{472} \u{474} \u{474} \u{476} \u{476} \u{478} \u{478} \u{47a} \u{47a} \u{47c} \u{47c} \u{47e}", "\u{407} \u{458} \u{459} \u{45a} \u{45b} \u{45c} \u{45d} \u{45e} \u{45f} \u{461} \u{461} \u{463} \u{463} \u{465} \u{465} \u{467} \u{467} \u{469} \u{469} \u{46b} \u{46b} \u{46d} \u{46d} \u{46f} \u{46f} \u{471} \u{471} \u{473} \u{473} \u{475} \u{475} \u{477} \u{477} \u{479} \u{479} \u{47b} \u{47b} \u{47d} \u{47d} \u{47f}", "\u{407} \u{408} \u{409} \u{40a} \u{40b} \u{4