check t_count_in("\u{7f}\u{390}\u{85}", "", 1, 7) == 3
# count_in derived
check t_count_in("\u{7f}\u{390}\u{85}", "", -6, 6) == 4
# count_in cpython
check t_count_in("\u{7f}\u{390}\u{85}", "", 1, 3) == 2
# count_in cpython
check t_count_in("\u{7f}\u{390}\u{85}", "a", 1, 3) == 0
