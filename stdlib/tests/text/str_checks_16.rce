check t_count_in("n\u{38e}\u{1c9}/\u{1d401}\u{13a0}\u{ff}\u{1c4}\u{3007}\u{131}tw3", "\u{1d401}\u{13a0}\u{ff}", -26, -6) == 1
# count_in derived
check t_count_in("n\u{38e}\u{1c9}/\u{1d401}\u{13a0}\u{ff}\u{1c4}\u{3007}\u{131}tw3", "", 12, -24) == 0
# count_in cpython
check t_count_in("n\u{38e}\u{1c9}/\u{1d401}\u{13a0}\u{ff}\u{1c4}\u{3007}\u{131}tw3", "", 24, 10) == 0
# count_in cpython
check t_count_in("n\u{38e}\u{1c9}/\u{1d401}\u{13a0}\u{ff}\u{1c4}\u{3007}\u{131}tw3", "\r\n", 24, 10) == 0
