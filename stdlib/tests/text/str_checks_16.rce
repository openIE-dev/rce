check t_count_in("o\u{b}\u{ff23}}\u{5ea}\u{10d0}\u{fb05}\u{4e16}\u{4e16}\u{1c4}m", "m", -14, -25) == 0
# count_in derived
check t_count_in("o\u{b}\u{ff23}}\u{5ea}\u{10d0}\u{fb05}\u{4e16}\u{4e16}\u{1c4}m", "", 16, 8) == 0
# count_in cpython
check t_count_in("o\u{b}\u{ff23}}\u{5ea}\u{10d0}\u{fb05}\u{4e16}\u{4e16}\u{1c4}m", "", 5, 2) == 0
# count_in cpython
check t_count_in("o\u{b}\u{ff23}}\u{5ea}\u{10d0}\u{fb05}\u{4e16}\u{4e16}\u{1c4}m", " ", 5, 2) == 0
# count_in cpython-bytes
check t_count_in("f\u{fb00}", "\u{fb00}", 4, -6) == 0
