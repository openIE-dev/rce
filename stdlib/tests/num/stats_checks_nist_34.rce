const STX: Anova = f_oneway(&STX_G) catch Anova(ss_between: 0.0, ss_within: 0.0, df_between: 0, df_within: 0, ms_between: 0.0, ms_within: 0.0, f: 0.0, p: 0.0, r2: 0.0, resid_sd: 0.0)

check STX.df_between == 8  # NIST SmLs08 df
check STX.df_within == 1800  # NIST SmLs08 df
check stx_lre(STX.ss_between, 16.08) >= 3.4  # NIST SmLs08 SS between, NIST certified 16.08
check stx_lre(STX.ss_between, 16.081914284204238) >= 12.0  # NIST SmLs08 SS between, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_between, 2.01) >= 3.4  # NIST SmLs08 MS between, NIST certified 2.01
check stx_lre(STX.ms_between, 2.0102392855255298) >= 12.0  # NIST SmLs08 MS between, exact for the binary64 data (mpmath)
check stx_lre(STX.f, 201.0) >= 3.6  # NIST SmLs08 F, NIST certified 201.0
check stx_lre(STX.f, 201.01300409594845) >= 12.0  # NIST SmLs08 F, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_within, 18.0) >= 3.7  # NIST SmLs08 SS within, NIST certified 18.0
check stx_lre(STX.ss_within, 18.00097824625708) >= 12.0  # NIST SmLs08 SS within, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_within, 0.01) >= 3.7  # NIST SmLs08 MS within, NIST certified 0.01
check stx_lre(STX.ms_within, 0.010000543470142823) >= 12.0  # NIST SmLs08 MS within, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.471830985915493) >= 3.9  # NIST SmLs08 R^2, NIST certified 0.471830985915493
check stx_lre(STX.r2, 0.4718471083353959) >= 12.0  # NIST SmLs08 R^2, exact for the binary64 data (mpmath)
check stx_lre(STX.resid_sd, 0.1) >= 4.0  # NIST SmLs08 residual sd, NIST certified 0.1
check stx_lre(STX.resid_sd, 0.10000271731379513) >= 12.0  # NIST SmLs08 residual sd, exact for the binary64 data (mpmath)
