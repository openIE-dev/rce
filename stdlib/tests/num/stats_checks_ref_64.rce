# generated by scripts/gen/stats_scipy_gen.py: scipy.stats 1.18.1 distributions (pdf/cdf/sf/ppf), relative error per family

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

check stx_rel(f_ppf(0.9999, 5.0, 10.0) catch -1.0, 18.12031981760292) <= 2e-12  # scipy.stats f_ppf
check stx_rel(f_ppf(0.9999999999990905, 5.0, 10.0) catch -1.0, 835.2852350596662) <= 2e-12  # scipy.stats f_ppf
