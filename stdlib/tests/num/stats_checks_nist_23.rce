check stx_lre(STX.se[5], 0.11232485467931194) >= 12.0  # NIST Wampler3 sd(B5), exact for the binary64 data (mpmath)
check stx_lre(STX.resid_sd, 2360.14502379268) >= 12.0  # NIST Wampler3 residual sd, NIST certified 2360.14502379268
check stx_lre(STX.resid_sd, 2360.1450237926765) >= 12.0  # NIST Wampler3 residual sd, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.99999555902582) >= 12.0  # NIST Wampler3 R^2, NIST certified 0.99999555902582
check stx_lre(STX.r2, 0.9999955590258199) >= 12.0  # NIST Wampler3 R^2, exact for the binary64 data (mpmath)
