# generated by scripts/gen/stats_scipy_gen.py: scipy.stats 1.18.1 distributions (pdf/cdf/sf/ppf), relative error per family

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

check stx_rel(beta_pdf(0.999, 1.0, 1.0) catch -1.0, 0.9999999999999996) <= 2e-12  # scipy.stats beta_pdf
check stx_rel(beta_cdf(0.999, 1.0, 1.0) catch -1.0, 0.999) <= 2e-12  # scipy.stats beta_cdf
check stx_rel(beta_sf(0.999, 1.0, 1.0) catch -1.0, 0.0010000000000000009) <= 2e-12  # scipy.stats beta_sf
check stx_rel(beta_pdf(0.999999999, 1.0, 1.0) catch -1.0, 0.9999999999999996) <= 2e-12  # scipy.stats beta_pdf
check stx_rel(beta_cdf(0.999999999, 1.0, 1.0) catch -1.0, 0.999999999) <= 2e-12  # scipy.stats beta_cdf
check stx_rel(beta_sf(0.999999999, 1.0, 1.0) catch -1.0, 9.999999717180685e-10) <= 2e-12  # scipy.stats beta_sf
check stx_rel(beta_ppf(1e-10, 1.0, 1.0) catch -1.0, 1e-10) <= 2e-12  # scipy.stats beta_ppf
