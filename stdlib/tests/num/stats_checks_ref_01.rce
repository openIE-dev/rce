check stx_rel(norm_isf(0.0001, 0.0, 1.0) catch -1.0, 3.7190164854556804) <= 1e-14  # scipy.stats norm_isf
check stx_rel(norm_isf(0.025, 0.0, 1.0) catch -1.0, 1.9599639845400545) <= 1e-14  # scipy.stats norm_isf
