# generated by scripts/gen/stats_scipy_gen.py: scipy.stats 1.18.1 distributions (pdf/cdf/sf/ppf), relative error per family

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

check stx_rel(beta_pdf(0.999, 10.0, 0.7) catch -1.0, 30.079321742634587) <= 2e-12  # scipy.stats beta_pdf
check stx_rel(beta_cdf(0.999, 10.0, 0.7) catch -1.0, 0.9568011453034005) <= 2e-12  # scipy.stats beta_cdf
check stx_rel(beta_sf(0.999, 10.0, 0.7) catch -1.0, 0.04319885469659947) <= 2e-12  # scipy.stats beta_sf
check stx_rel(beta_pdf(0.999999999, 10.0, 0.7) catch -1.0, 1915.0435066881564) <= 2e-12  # scipy.stats beta_pdf
check stx_rel(beta_cdf(0.999999999, 10.0, 0.7) catch -1.0, 0.9999972642236248) <= 2e-12  # scipy.stats beta_cdf
check stx_rel(beta_sf(0.999999999, 10.0, 0.7) catch -1.0, 2.735776375236417e-06) <= 2e-12  # scipy.stats beta_sf
check stx_rel(beta_ppf(1e-10, 10.0, 0.7) catch -1.0, 0.10975184233714924) <= 2e-12  # scipy.stats beta_ppf
