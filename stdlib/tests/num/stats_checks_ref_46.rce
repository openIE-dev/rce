# generated by scripts/gen/stats_scipy_gen.py: scipy.stats 1.18.1 distributions (pdf/cdf/sf/ppf), relative error per family

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

check stx_rel(beta_ppf(0.025, 50.0, 60.0) catch -1.0, 0.36288116766539236) <= 2e-12  # scipy.stats beta_ppf
check stx_rel(beta_ppf(0.2, 50.0, 60.0) catch -1.0, 0.4144854140955774) <= 2e-12  # scipy.stats beta_ppf
