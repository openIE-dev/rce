# generated by scripts/gen/stats_nist_gen.py from NIST StRD (NoInt1); checked by LRE
# (log relative error = correct significant digits) against a floor.

fn stx_lre(q: f64, c: f64) -> f64
    if q == c
        return 16.0
    let e = if c == 0.0 then st_abs(q) else st_abs(q - c) / st_abs(c)
    return 0.0 - special.cr_log(e) / 2.302585092994046

const STX_Y: List[f64] = [130.0, 131.0, 132.0, 133.0, 134.0, 135.0, 136.0, 137.0, 138.0, 139.0, 140.0]
const STX_X: List[f64] = [60.0, 61.0, 62.0, 63.0, 64.0, 65.0, 66.0, 67.0, 68.0, 69.0, 70.0]

fn stx_design(x: &[f64], deg: i64, ic: bool) -> linalg.Mat
    let m = x.len()
    var a: List[f64] = []
    var p: i64 = deg
    if ic
        p = deg + 1
    for j in 0..(p as usize)
        let e = if ic then j as i64 else (j as i64) + 1
        for i in 0..m
            var v = 1.0
            for _ in 0..(e as usize)
                v = v * x[i]
            a.push(v)
    return linalg.mat(m, p as usize, a) catch linalg.zeros(1, 1)

const STX_A: linalg.Mat = stx_design(&STX_X, 1, false)

const STX: Ols = ols(&STX_A, &STX_Y, false) catch Ols(coef: [], se: [], resid_sd: 0.0, r2: 0.0, ss_reg: 0.0, ss_res: 0.0, df_reg: 0, df_res: 0, f: 0.0, exact: false)
check STX.df_reg == 1  # NIST NoInt1 df
check STX.df_res == 10  # NIST NoInt1 df
check stx_lre(STX.coef[0], 2.07438016528926) >= 12.0  # NIST NoInt1 B0, NIST certified 2.07438016528926
check stx_lre(STX.coef[0], 2.074380165289256) >= 12.0  # NIST NoInt1 B0, exact for the binary64 data (mpmath)
check stx_lre(STX.se[0], 0.0165289256198347) >= 12.0  # NIST NoInt1 sd(B0), NIST certified 0.0165289256198347
check stx_lre(STX.se[0], 0.01652892561983471) >= 12.0  # NIST NoInt1 sd(B0), exact for the binary64 data (mpmath)
check stx_lre(STX.resid_sd, 3.56753034006338) >= 12.0  # NIST NoInt1 residual sd, NIST certified 3.56753034006338
check stx_lre(STX.resid_sd, 3.567530340063379) >= 12.0  # NIST NoInt1 residual sd, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.999365492298663) >= 12.0  # NIST NoInt1 R^2, NIST certified 0.999365492298663
check stx_lre(STX.r2, 0.9993654922986628) >= 12.0  # NIST NoInt1 R^2, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_reg, 200457.727272727) >= 12.0  # NIST NoInt1 SS regression, NIST certified 200457.727272727
check stx_lre(STX.ss_reg, 200457.72727272726) >= 12.0  # NIST NoInt1 SS regression, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_res, 127.272727272727) >= 12.0  # NIST NoInt1 SS residual, NIST certified 127.272727272727
check stx_lre(STX.ss_res, 127.27272727272727) >= 12.0  # NIST NoInt1 SS residual, exact for the binary64 data (mpmath)
check stx_lre(STX.f, 15750.25) >= 12.0  # NIST NoInt1 F, NIST certified 15750.25
check stx_lre(STX.f, 15750.25) >= 12.0  # NIST NoInt1 F, exact for the binary64 data (mpmath)
