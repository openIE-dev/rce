check stx_rel(gamma_ppf(0.975, 0.5, 1.0) catch -1.0, 2.511943093657444) <= 1e-12  # scipy.stats gamma_ppf
check stx_rel(gamma_ppf(0.9999, 0.5, 1.0) catch -1.0, 7.568352613311803) <= 1e-12  # scipy.stats gamma_ppf
check stx_rel(gamma_ppf(0.9999999999990905, 0.5, 1.0) catch -1.0, 25.51516783374865) <= 1e-12  # scipy.stats gamma_ppf
