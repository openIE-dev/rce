# generated by scripts/gen/linalg_gen2.py: DGEEV bit for bit; DSYEV/DGESVD by LAPACK test ratios

# Test helpers for num.linalg (prepended to every generated shard by
# scripts/gen/linalg_gen.py). Results are flattened to List[f64] so one
# check compares every bit of a factorization.

fn tm(m: usize, n: usize, a: List[f64]) -> Mat = mat(m, n, a) catch zeros(0, 0)

fn t_lu(m: usize, n: usize, a: List[f64]) -> List[f64]
    let x = tm(m, n, a)
    let f = lu(&x)
    var r = copy(f.lu.a)
    for p in &f.piv
        r.push(p as f64)
    r.push(f.info as f64)
    return r

fn t_lus(n: usize, a: List[f64], trans: bool, nrhs: usize, b: List[f64]) -> List[f64]
    let x = tm(n, n, a)
    let y = tm(n, nrhs, b)
    let f = lu(&x)
    let s = lu_solve(&f, trans, &y) catch zeros(0, 0)
    return s.a

fn t_chol(n: usize, a: List[f64]) -> List[f64]
    let x = tm(n, n, a)
    let l = chol(&x) catch |_e| zeros(1, 1)
    return l.a

fn t_chol_info(n: usize, a: List[f64]) -> i64
    let x = tm(n, n, a)
    let l = chol(&x) catch |e| Mat(m: 0, n: 0, a: [e.at as f64])
    return if l.m == 0 then l.a[0] as i64 else -1

fn t_chols(n: usize, a: List[f64], nrhs: usize, b: List[f64]) -> List[f64]
    let x = tm(n, n, a)
    let y = tm(n, nrhs, b)
    let l = chol(&x) catch zeros(1, 1)
    let s = chol_solve(&l, &y) catch zeros(0, 0)
    return s.a

fn t_qr(m: usize, n: usize, a: List[f64]) -> List[f64]
    let x = tm(m, n, a)
    let f = qr(&x)
    var r = copy(f.qr.a)
    for t in &f.tau
        r.push(t)
    return r

fn t_q(m: usize, n: usize, a: List[f64]) -> List[f64]
    let x = tm(m, n, a)
    let f = qr(&x)
    return qr_q(&f).a

fn t_ls(m: usize, n: usize, a: List[f64], nrhs: usize, b: List[f64]) -> List[f64]
    let x = tm(m, n, a)
    let y = tm(m, nrhs, b)
    let s = lstsq(&x, &y) catch zeros(0, 0)
    return s.a

fn t_gemm(ta: bool, tb: bool, m: usize, n: usize, k: usize, alpha: f64, a: List[f64], b: List[f64], beta: f64, c: List[f64]) -> List[f64]
    let am = if ta then k else m
    let an = if ta then m else k
    let bm = if tb then n else k
    let bn = if tb then k else n
    let x = tm(am, an, a)
    let y = tm(bm, bn, b)
    let z = tm(m, n, c)
    let r = gemm(ta, tb, alpha, &x, &y, beta, &z) catch zeros(0, 0)
    return r.a

fn t_gemv(trans: bool, m: usize, n: usize, alpha: f64, a: List[f64], x: List[f64], beta: f64, y: List[f64]) -> List[f64]
    let am = tm(m, n, a)
    return gemv(trans, alpha, &am, &x, beta, &y) catch []

fn t_ger(m: usize, n: usize, alpha: f64, x: List[f64], y: List[f64], a: List[f64]) -> List[f64]
    let am = tm(m, n, a)
    let r = ger(alpha, &x, &y, &am) catch zeros(0, 0)
    return r.a

fn t_trsm(upper: bool, trans: bool, unit: bool, m: usize, n: usize, alpha: f64, a: List[f64], b: List[f64]) -> List[f64]
    var w = copy(a)
    for v in &b
        w.push(v)
    trsm_b(&mut w, upper, trans, unit, m, n, alpha, 0, m, m * m, m)
    var r: List[f64] = []
    for i in 0..(m * n)
        r.push(w[m * m + i])
    return r

fn t_axpy(alpha: f64, x: List[f64], y: List[f64]) -> List[f64]
    var w = copy(y)
    daxpy(x.len(), alpha, &x, 0, 1, &mut w, 0, 1)
    return w

fn t_nrm2(x: List[f64]) -> f64 = dnrm2(x.len(), &x, 0, 1)
fn t_asum(x: List[f64]) -> f64 = dasum(x.len(), &x, 0, 1)
fn t_amax(x: List[f64]) -> i64 = idamax(x.len(), &x, 0, 1) as i64
fn t_dot(x: List[f64], y: List[f64]) -> f64 = ddot(x.len(), &x, 0, 1, &y, 0, 1)
fn t_dots(n: usize, x: List[f64], ox: usize, ix: usize, y: List[f64], oy: usize, iy: usize) -> f64 = ddot(n, &x, ox, ix, &y, oy, iy)

fn t_eig(n: usize, a: List[f64]) -> List[f64]
    let x = tm(n, n, a)
    let e = eigvals(&x) catch Eigvals(re: [], im: [])
    var r = copy(e.re)
    for v in &e.im
        r.push(v)
    return r

# LAPACK test ratios (TESTING/EIG dsyt21, dbdt01, dort01 with the 1-norm,
# DLANGE 'O'); a result passes below THRESH = 30 as in LAPACK's sep.in
# and svd.in drivers; ulp = 2^-52 (DLAMCH 'P').
fn t_norm1(m: usize, n: usize, a: &[f64]) -> f64
    var r = 0.0
    for j in 0..n
        var s = 0.0
        for i in 0..m
            s = s + la_abs(a[i + j * m])
        r = r.max(s)
    return r

# || A - U diag(d) V^T ||_1 / (n ||A||_1 ulp)   (V = U for eigh)
fn t_resid(m: usize, n: usize, a: &[f64], u: &Mat, d: &[f64], v: &Mat) -> f64
    let k = d.len()
    var r = copy(a)
    for j in 0..n
        for i in 0..m
            var s = 0.0
            for l in 0..k
                s = s + u.a[i + l * m] * d[l] * v.a[j + l * n]
            r[i + j * m] = r[i + j * m] - s
    let an = t_norm1(m, n, a)
    let dn = t_norm1(m, n, &r)
    let ulp = 2.0 * LA_EPS
    let mx = (if m > n then m else n) as f64
    if an == 0.0
        return dn / ulp
    return dn / an / (mx * ulp)

# || I - U^T U ||_1 / (n ulp) for an m x k U.
fn t_orth(u: &Mat) -> f64
    let k = u.n
    var r: List[f64] = []
    for j in 0..k
        for i in 0..k
            var s = ddot(u.m, &u.a, i * u.m, 1, &u.a, j * u.m, 1)
            if i == j
                s = 1.0 - s
            r.push(s)
    let mx = (if u.m > k then u.m else k) as f64
    return t_norm1(k, k, &r) / (mx * 2.0 * LA_EPS)

# max |w_i - ref_i| / (n ||A||_1 ulp): eigenvalue or singular value
# agreement with LAPACK, ordered alike.
fn t_vals(w: &[f64], r: &[f64], an: f64, n: usize) -> f64
    var e = 0.0
    for i in 0..w.len()
        e = e.max(la_abs(w[i] - r[i]))
    if an == 0.0
        return e
    return e / (an * (n as f64) * 2.0 * LA_EPS)

# [residual ratio, orthogonality ratio, value ratio] for eigh vs DSYEV.
fn t_eigh(n: usize, a: List[f64], ref: List[f64]) -> List[f64]
    let x = tm(n, n, copy(a))
    let e = eigh(&x) catch Eigh(values: [], vectors: zeros(0, 0))
    let an = t_norm1(n, n, &a)
    return [t_resid(n, n, &a, &e.vectors, &e.values, &e.vectors), t_orth(&e.vectors), t_vals(&e.values, &ref, an, n)]

fn t_svd(m: usize, n: usize, a: List[f64], ref: List[f64]) -> List[f64]
    let x = tm(m, n, copy(a))
    let f = svd(&x)
    let an = t_norm1(m, n, &a)
    return [t_resid(m, n, &a, &f.u, &f.s, &f.v), t_orth(&f.u), t_orth(&f.v), t_vals(&f.s, &ref, an, if m > n then m else n)]

fn t_below(r: List[f64], th: f64) -> bool
    if r.len() == 0
        return false
    for x in &r
        if not (x < th)
            return false
    return true

check t_eig(3, [-0.38043177699484576, -0.5030408156352681, -0.3516055726967535, -0.8737019877828771, 0.022327463852754414, 0.6466953247374845, -0.11821191595932334, -0.34347510027993233, 0.6393299024344228]) == [-0.8697377690202666, 0.5754816791562989, 0.5754816791562989, 0.0, 0.4164952348519816, -0.4164952348519816]  # dgeev rand6
