# generated by scripts/gen/stats_nist_gen.py from NIST StRD (SmLs01); checked by LRE
# (log relative error = correct significant digits) against a floor.

fn stx_lre(q: f64, c: f64) -> f64
    if q == c
        return 16.0
    let e = if c == 0.0 then st_abs(q) else st_abs(q - c) / st_abs(c)
    return 0.0 - special.cr_log(e) / 2.302585092994046

const STX_G: List[List[f64]] = [[1.4, 1.3, 1.5, 1.3, 1.5, 1.3, 1.5, 1.3, 1.5, 1.3, 1.5, 1.3, 1.5, 1.3, 1.5, 1.3, 1.5, 1.3, 1.5, 1.3, 1.5], [1.3, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4], [1.5, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6], [1.3, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4], [1.5, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6], [1.3, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4], [1.5, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6], [1.3, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4, 1.2, 1.4], [1.5, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6, 1.4, 1.6]]

const STX: Anova = f_oneway(&STX_G) catch Anova(ss_between: 0.0, ss_within: 0.0, df_between: 0, df_within: 0, ms_between: 0.0, ms_within: 0.0, f: 0.0, p: 0.0, r2: 0.0, resid_sd: 0.0)

check STX.df_between == 8  # NIST SmLs01 df
check STX.df_within == 180  # NIST SmLs01 df
check stx_lre(STX.ss_between, 1.68) >= 12.0  # NIST SmLs01 SS between, NIST certified 1.68
check stx_lre(STX.ss_between, 1.680000000000001) >= 12.0  # NIST SmLs01 SS between, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_between, 0.21) >= 12.0  # NIST SmLs01 MS between, NIST certified 0.21
check stx_lre(STX.ms_between, 0.21000000000000013) >= 12.0  # NIST SmLs01 MS between, exact for the binary64 data (mpmath)
check stx_lre(STX.f, 21.0) >= 12.0  # NIST SmLs01 F, NIST certified 21.0
check stx_lre(STX.f, 21.0) >= 12.0  # NIST SmLs01 F, exact for the binary64 data (mpmath)
check stx_lre(STX.ss_within, 1.8) >= 12.0  # NIST SmLs01 SS within, NIST certified 1.8
check stx_lre(STX.ss_within, 1.800000000000001) >= 12.0  # NIST SmLs01 SS within, exact for the binary64 data (mpmath)
check stx_lre(STX.ms_within, 0.01) >= 12.0  # NIST SmLs01 MS within, NIST certified 0.01
check stx_lre(STX.ms_within, 0.010000000000000005) >= 12.0  # NIST SmLs01 MS within, exact for the binary64 data (mpmath)
check stx_lre(STX.r2, 0.482758620689655) >= 12.0  # NIST SmLs01 R^2, NIST certified 0.482758620689655
check stx_lre(STX.r2, 0.4827586206896552) >= 12.0  # NIST SmLs01 R^2, exact for the binary64 data (mpmath)
check stx_lre(STX.resid_sd, 0.1) >= 12.0  # NIST SmLs01 residual sd, NIST certified 0.1
check stx_lre(STX.resid_sd, 0.10000000000000003) >= 12.0  # NIST SmLs01 residual sd, exact for the binary64 data (mpmath)
