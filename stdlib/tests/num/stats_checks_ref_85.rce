# generated by scripts/gen/stats_scipy_gen.py: seeded variates vs an independent RFC 8439 ChaCha20 (rand.det stream layout)

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

# the draws of a rand.det generator seeded with [3, 10, 17, 24, 31, 38, 45, 52, 59, 66, 73, 80, 87, 94, 101, 108, 115, 122, 129, 136, 143, 150, 157, 164, 171, 178, 185, 192, 199, 206, 213, 220], stream 5
