# generated by scripts/gen/stats_scipy_gen.py: scipy.stats 1.18.1 distributions (pdf/cdf/sf/ppf), relative error per family

fn stx_rel(q: f64, c: f64) -> f64 = if q == c then 0.0 else st_abs(q - c) / st_abs(c)

check stx_rel(chi2_pdf(15.0, 100.0) catch -1.0, 3.432878463816168e-24) <= 2e-13  # scipy.stats chi2_pdf
check stx_rel(chi2_cdf(15.0, 100.0) catch -1.0, 1.2067458812766902e-24) <= 2e-13  # scipy.stats chi2_cdf
check stx_rel(chi2_sf(15.0, 100.0) catch -1.0, 1.0) <= 2e-13  # scipy.stats chi2_sf
