# Checks for lib/time/time.rce. Howard Hinnant's round-trip test from
# "chrono-Compatible Low-Level Date Algorithms" (every day maps back to
# itself, consecutive days advance the date by one and the weekday by one)
# over windows around era and century boundaries and a strided sweep of
# +-10^8 days; his fixed points; RFC 3339 section 5.8 examples; CPython
# datetime cross-checks (scripts/gen/time_gen.py).

fn date_ok(y: i64, m: i64, d: i64, z: i64, wd: i64, iso: List[i64], yd: i64) -> bool
    let c = civil_from_days(z)
    return days_from_civil(y, m, d) == z and c.y == y and c.m == m and c.d == d and weekday_from_days(z) == wd and iso_week(y, m, d) == iso and ordinal_day(y, m, d) == yd

fn fmt_ok(t: i64, off: i64, s: text) -> bool = format_rfc3339(t, off, 9) == s and (parse_rfc3339(&s) catch -1) == t

# Hinnant: for z in [lo, lo + n) the date of z + 1 is the next calendar day
# of the date of z, round trip holds, weekday advances mod 7.
fn hinnant(lo: i64, n: i64) -> bool
    var ok = true
    var prev = civil_from_days(lo - 1)
    var pw = weekday_from_days(lo - 1)
    for i in 0..n
        let z = lo + i
        let c = civil_from_days(z)
        let w = weekday_from_days(z)
        ok = ok and days_from_civil(c.y, c.m, c.d) == z and valid_civil(c.y, c.m, c.d)
        ok = ok and w == (pw + 1) % 7 and w >= 0 and w < 7
        if prev.d == days_in_month(prev.y, prev.m)
            if prev.m == 12
                ok = ok and c.y == prev.y + 1 and c.m == 1 and c.d == 1
            else
                ok = ok and c.y == prev.y and c.m == prev.m + 1 and c.d == 1
        else
            ok = ok and c.y == prev.y and c.m == prev.m and c.d == prev.d + 1
        prev = c
        pw = w
    return ok

fn stride(n: i64) -> bool
    var ok = true
    for i in 0..n
        let z = (i - n / 2) * 99991
        let c = civil_from_days(z)
        ok = ok and days_from_civil(c.y, c.m, c.d) == z and weekday_from_days(z) == fmod(z + 4, 7)
    return ok

fn rfc(s: text) -> i64 = parse_rfc3339(&s) catch -1

fn add_m(y: i64, m: i64, d: i64, n: i64) -> List[i64]
    let c0 = Civil(y: y, m: m, d: d)
    let c = add_months(&c0, n)
    return [c.y, c.m, c.d]

check hinnant(-800, 1600)
check hinnant(days_from_civil(1999, 12, 1), 800)
check hinnant(days_from_civil(-401, 12, 1), 800)
check hinnant(days_from_civil(2099, 12, 1), 500)
check stride(2001)
check days_from_civil(1970, 1, 1) == 0 and weekday_from_days(0) == 4 and days_from_civil(2000, 3, 1) == 11017 and days_from_civil(0, 3, 1) == -719468
check days_from_civil(-1, 12, 31) == -719529 and civil_from_days(-719529).y == -1
check is_leap(2000) and not is_leap(1900) and is_leap(2024) and is_leap(0) and is_leap(-4) and not is_leap(-100)
check add_m(2024, 1, 31, 1) == [2024, 2, 29] and add_m(2023, 1, 31, 1) == [2023, 2, 28] and add_m(2024, 3, 15, -15) == [2022, 12, 15] and add_m(2024, 12, 31, 2) == [2025, 2, 28]
check iso_week(2008, 12, 29) == [2009, 1, 1] and iso_week(2010, 1, 3) == [2009, 53, 7] and iso_week(2021, 1, 4) == [2021, 1, 1]
check floor_to(-1, SEC) == -1000000000 and floor_to(1999999999, SEC) == 1000000000 and dur_of(1, 2, 3, 4) == 3723000000004

# RFC 3339 section 5.8
check rfc("1985-04-12T23:20:50.52Z") == 482196050520000000
check rfc("1996-12-19T16:39:57-08:00") == 851042397000000000
check rfc("1937-01-01T12:00:27.87+00:20") == -1041337172130000000
check rfc("1990-12-31T23:59:60Z") == -1 and rfc("1990-12-31T15:59:60-08:00") == -1
check rfc("1985-04-12t23:20:50z") == 482196050000000000 and rfc("1985-02-29T00:00:00Z") == -1 and rfc("1985-04-12T23:20:50.Z") == -1 and rfc("1985-04-12T23:20:50.1234567890Z") == -1 and rfc("1985-04-12T23:20:50") == -1 and rfc("1985-04-12T24:00:00Z") == -1
check format_rfc3339(482196050520000000, 0, 3) == "1985-04-12T23:20:50.520Z" and format_rfc3339(851042397000000000, -480, 0) == "1996-12-19T16:39:57-08:00" and format_rfc3339(-1, 0, 9) == "1969-12-31T23:59:59.999999999Z"

