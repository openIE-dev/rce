check genc([gti("0b\nay1", 42), gk("\u{7f}' \u{8}\u{0}日", "s", "€y"), gk("y\u{2028}", "s", "=/b \u{0}\t😀"), gk("\u{1}\u{c}/z", "b", "false"), gk("1yy", "s", "x1\u{1}\u{1f}x\t9")]) == "0bay1=42 \u{7f}'日=€y y\u{2028}=\"=/b \\u0000\\t😀\" /z=false 1yy=\"x1\\u0001\\u001fx\\t9\""
check gskip([gti("0b\nay1", 42), gk("\u{7f}' \u{8}\u{0}日", "s", "€y"), gk("y\u{2028}", "s", "=/b \u{0}\t😀"), gk("\u{1}\u{c}/z", "b", "false"), gk("1yy", "s", "x1\u{1}\u{1f}x\t9")]) == "0bay1=42 \u{7f}'日=€y y\u{2028}=\"=/b \\u0000\\t😀\" /z=false 1yy=\"x1\\u0001\\u001fx\\t9\""
check genc([gk("\u{0}\\\u{c}\u{fffd}", "s", "\"xcz日ya\u{2028}"), gk(" ", "s", "x\u{c}é日\u{8}日"), gk("\u{7f}€-\u{1f}", "s", "null"), gk("€😀", "b", "true"), gk("uc日😀zy", "s", "a\u{8}\u{0}\u{2028}a\u{7f}1")]) == "ERR"
check gskip([gk("\u{0}\\\u{c}\u{fffd}", "s", "\"xcz日ya\u{2028}"), gk(" ", "s", "x\u{c}é日\u{8}日"), gk("\u{7f}€-\u{1f}", "s", "null"), gk("€😀", "b", "true"), gk("uc日😀zy", "s", "a\u{8}\u{0}\u{2028}a\u{7f}1")]) == "\\=\"\\\"xcz日ya\u{2028}\" \u{7f}€-=\"null\" €😀=true uc日😀zy=\"a\\u0008\\u0000\u{2028}a\u{7f}1\""
check genc([gk("z日9", "s", "\n"), gk("z日0\\", "b", "true"), gk("\u{fffd}", "s", "€"), gk("u\t/", "s", "9\ra")]) == "ERR"
check gskip([gk("z日9", "s", "\n"), gk("z日0\\", "b", "true"), gk("\u{fffd}", "s", "€"), gk("u\t/", "s", "9\ra")]) == "z日9=\"\\n\" z日0\\=true u/=\"9\\ra\""
check genc([gk("😀日\u{1}\t", "s", "😀\u{2028}\u{fffd}\n"), gk("😀\u{fffd}-'", "s", "/\u{2028} \u{fffd}\""), gk("\u{2028}u\u{8}'=z", "s", "'\n9a9"), gk("acz", "n", "")]) == "😀日=\"😀\u{2028}\\ufffd\\n\" 😀-'=\"/\u{2028} \\ufffd\\\"\" \u{2028}u'z=\"'\\n9a9\" acz=null"
check gskip([gk("😀日\u{1}\t", "s", "😀\u{2028}\u{fffd}\n"), gk("😀\u{fffd}-'", "s", "/\u{2028} \u{fffd}\""), gk("\u{2028}u\u{8}'=z", "s", "'\n9a9"), gk("acz", "n", "")]) == "😀日=\"😀\u{2028}\\ufffd\\n\" 😀-'=\"/\u{2028} \\ufffd\\\"\" \u{2028}u'z=\"'\\n9a9\" acz=null"
check genc([gti("\r=zb", (0 - 9223372036854775807 - 1)), gk("😀", "s", "zé\u{1f}\\")]) == "zb=-9223372036854775808 😀=\"zé\\u001f\\\\\""
check gskip([gti("\r=zb", (0 - 9223372036854775807 - 1)), gk("😀", "s", "zé\u{1f}\\")]) == "zb=-9223372036854775808 😀=\"zé\\u001f\\\\\""
check genc([gk("-\u{1}\u{8}", "s", "null"), gk("'\"a\n\u{c}", "s", ""), gk("b", "s", "é"), gk("xy\u{8}\n\u{2028}", "s", "\\\"\u{8}ay"), gk("\n\u{0}€a", "s", "")]) == "-=\"null\" 'a= b=é xy\u{2028}=\"\\\\\\\"\\u0008ay\" €a="
check gskip([gk("-\u{1}\u{8}", "s", "null"), gk("'\"a\n\u{c}", "s", ""), gk("b", "s", "é"), gk("xy\u{8}\n\u{2028}", "s", "\\\"\u{8}ay"), gk("\n\u{0}€a", "s", "")]) == "-=\"null\" 'a= b=é xy\u{2028}=\"\\\\\\\"\\u0008ay\" €a="
check genc([gk("1\u{2028}a", "n", ""), gti("/😀\u{7f}x", 0), gk("😀\n\u{0}", "s", "日yz\"€-\"\u{1f}"), gk("x\t", "n", "")]) == "1\u{2028}a=null /😀\u{7f}x=0 😀=\"日yz\\\"€-\\\"\\u001f\" x=null"
check gskip([gk("1\u{2028}a", "n", ""), gti("/😀\u{7f}x", 0), gk("😀\n\u{0}", "s", "日yz\"€-\"\u{1f}"), gk("x\t", "n", "")]) == "1\u{2028}a=null /😀\u{7f}x=0 😀=\"日yz\\\"€-\\\"\\u001f\" x=null"
check genc([gk("\u{2028}", "b", "false"), gti("\u{7f}😀日\u{1}", (0 - 9223372036854775807 - 1)), gk("\u{0}z\\\u{2028}", "s", "\u{0}\r z"), gk("x09\u{0}\\b", "s", "x=y"), gk("\"", "s", "\u{1}é")]) == "ERR"
check gskip([gk("\u{2028}", "b", "false"), gti("\u{7f}😀日\u{1}", (0 - 9223372036854775807 - 1)), gk("\u{0}z\\\u{2028}", "s", "\u{0}\r z"), gk("x09\u{0}\\b", "s", "x=y"), gk("\"", "s", "\u{1}é")]) == "\u{2028}=false \u{7f}😀日=-9223372036854775808 z\\\u{2028}=\"\\u0000\\r z\" x09\\b=\"x=y\""
check gdec("") == []
check gdec("   ") == []
check gdec("a") == ["a", ""]
check gdec("a b c") == ["a", "", "b", "", "c", ""]
check gdec("a=") == ["a", ""]
check gdec("a= b") == ["a", "", "b", ""]
check gdec("a=\"\"") == ["a", ""]
check gdec("a=\"\" b") == ["a", "", "b", ""]
check gdec("=a") == ["!0:unexpected '='"]
check gdec("a==b") == ["!2:unexpected '='"]
check gdec("a=b=c") == ["!3:unexpected '='"]
check gdec("a=\"x") == ["!4:unterminated quoted value"]
check gdec("a=\"x\\\"") == ["!6:unterminated quoted value"]
check gdec("a=\"\\q\"") == ["!6:invalid quoted value"]
check gdec("a=\"\u{1}\\n\"") == ["!7:invalid quoted value"]
check gdec("a=\"\u{1}\"") == ["a", "\u{1}"]
check gdec("\u{fffd}k=1") == ["!4:invalid key"]
check gdec("k\u{fffd}") == ["!4:invalid key"]
check gdec("k\u{fffd}=1") == ["!4:invalid key"]
check gdec("é=1") == ["é", "1"]
check gdec("a\"b=1") == ["!1:unexpected '\"'"]
check gdec("a=b\"c") == ["!3:unexpected '\"'"]
check gdec("a=\"x\"b=2") == ["a", "x", "b", "2"]
check gdec("a=\"x\"\"") == ["a", "x", "!5:unexpected '\"'"]
check gdec("a=\"\\ud800\"") == ["a", "\u{fffd}"]
check gdec("a=\"\\ud800\\u0041\"") == ["a", "\u{fffd}A"]
check gdec("a=\"\\udc00\\ud800\"") == ["a", "\u{fffd}\u{fffd}"]
check gdec("a=\"\\ud83d\\ude00\"") == ["a", "😀"]
check gdec("a=\"\\u12\"") == ["!8:invalid quoted value"]
check gdec("a=\"\\u12g4\"") == ["!10:invalid quoted value"]
