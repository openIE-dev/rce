check gdec("x-é=\"b=\u{7f}9\" c=\"\\u001f9-x\\u0001\"\u{2028}\u{7f}=\"é-\\u0008\\u000c\\n\"") == ["x-é", "b=\u{7f}9", "c", "\u{1f}9-x\u{1}", "\u{2028}\u{7f}", "é-\u{8}\u{c}\n"]
