# line reader
check read([""], true) == RdOut(lines: [], rest: "")
check read(["a"], false) == RdOut(lines: [], rest: "a")
check read(["a"], true) == RdOut(lines: ["a"], rest: "")
check read(["a\n"], true) == RdOut(lines: ["a"], rest: "")
check read(["a\r\n", "b"], true) == RdOut(lines: ["a", "b"], rest: "")
check read(["a\r", "\nb\n"], true) == RdOut(lines: ["a", "b"], rest: "")
check read(["\n\n"], true) == RdOut(lines: ["", ""], rest: "")
check read(["x\ry\n"], true) == RdOut(lines: ["x\ry"], rest: "")
check read(["é€", "\n😀"], true) == RdOut(lines: ["é€", "😀"], rest: "")
check read(["a\r"], true) == RdOut(lines: ["a"], rest: "")
check read(["a\r\r\n"], true) == RdOut(lines: ["a\r"], rest: "")
check read([" ", "😀aé z\n😀😀\r€\nb\raab", "😀\n\n€b€z"], false) == RdOut(lines: [" 😀aé z", "😀😀\r€", "b\raab😀", ""], rest: "€b€z")
check read(["\raé é", "\nzb \n\n", "\n \n éa€\n", "\r€ 😀\né ", " b\r€"], true) == RdOut(lines: ["\raé é", "zb ", "", "", " ", " éa€", "\r€ 😀", "é  b\r€"], rest: "")
check read(["\na", "\nb\r😀", "z", "z\r😀€\n"], false) == RdOut(lines: ["", "a", "b\r😀zz\r😀€"], rest: "")
