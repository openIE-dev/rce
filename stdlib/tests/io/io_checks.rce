# Checks for io. Every vector is derived (scripts/gen/io_gen.py, a Python
# model of each part); the path rule is the one of the reference host's
# file adapter, and tests/io/io_host.rce runs it against that adapter.

fn rok(s: text, d: text?, e: text) -> bool = result_ok(&s, d, &e)
fn rget(s: text, d: text?, e: text) -> text? = delivered(&s, d, &e)
fn sk(s: text) -> bool = status_known(&s)
fn pok(p: text, list: bool) -> bool = path_ok(&p, list)

struct Op
    add: bool
    what: text
    tag: text
    req: u64

struct PendOut
    ids: List[u64]
    tags: List[text]
    out: usize
    settled: u64
    stray: u64

fn pend(ops: List[Op]) -> PendOut
    var p = pending_new()
    var ids: List[u64] = []
    var tags: List[text] = []
    var i: usize = 0
    while i < ops.len() bound 64
        let o = copy(ops[i])
        if o.add
            ids.push(issue(&mut p, &o.what, &o.tag))
        else
            let t = settle(&mut p, &o.what, o.req)
            tags.push(t.or("-"))
        i += 1
    return PendOut(ids: ids, tags: tags, out: outstanding(&p), settled: p.settled, stray: p.stray)

struct RdOut
    lines: List[text]
    rest: text

fn read(chunks: List[text], fin: bool) -> RdOut
    var r = reader_new()
    var out: List[text] = []
    var i: usize = 0
    while i < chunks.len() bound 64
        let ls = feed(&mut r, &chunks[i])
        var j: usize = 0
        while j < ls.len() bound 64
            out.push(copy(ls[j]))
            j += 1
        i += 1
    if fin
        let ls = finish(&mut r)
        var j: usize = 0
        while j < ls.len() bound 4
            out.push(copy(ls[j]))
            j += 1
    if r.lines != (out.len() as u64)
        return RdOut(lines: [], rest: "lines miscounted")
    return RdOut(lines: out, rest: copy(r.rest))

fn after_eof() -> bool
    var r = reader_new()
    let x = "x\ny"
    let z = "z\n"
    let a = feed(&mut r, &x)
    let b = finish(&mut r)
    let c = feed(&mut r, &z)
    let d = finish(&mut r)
    return a == ["x"] and b == ["y"] and c.len() == 0 and d.len() == 0 and r.eof and r.lines == 2

struct WrOut
    chunks: List[text]
    sent: u64
    done: bool

fn wr(data: text, max: usize, acks: List[i64]) -> WrOut
    var w = writer_new(&data, max)
    var chunks: List[text] = []
    var i: usize = 0
    while i < acks.len() bound 64
        let c = next_chunk(&mut w)
        if c == none
            return WrOut(chunks: ["no chunk"], sent: 0, done: false)
        chunks.push(c.or(""))
        if next_chunk(&mut w) != none
            return WrOut(chunks: ["two in flight"], sent: 0, done: false)
        if acks[i] < 0
            nack(&mut w)
        else
            let s = ack(&mut w, acks[i] as u64) catch 999999
            if s != w.sent
                return WrOut(chunks: ["ack failed"], sent: 0, done: false)
        i += 1
    if writer_done(&w) and next_chunk(&mut w) != none
        return WrOut(chunks: ["chunk after done"], sent: 0, done: false)
    return WrOut(chunks: chunks, sent: w.sent, done: writer_done(&w))

fn ack_fails(data: text, max: usize, n: u64, first: u64) -> bool
    var w = writer_new(&data, max)
    let _c = next_chunk(&mut w)
    if first > 0
        let _a = ack(&mut w, first) catch 999999
        let _c2 = next_chunk(&mut w)
    let r = ack(&mut w, n) catch 999999
    return r == 999999

fn idle_ack() -> bool
    let t = "abc"
    var w = writer_new(&t, 2)
    let r = ack(&mut w, 0) catch 999999
    return r == 999999

fn bad_acks() -> bool
    let beyond = ack_fails("hello", 2, 3, 0)
    let inside = ack_fails("é", 4, 1, 0)
    let inside2 = ack_fails("a€b", 8, 2, 0)
    let fine = not ack_fails("a€b", 8, 4, 0)
    let second = ack_fails("abcd", 2, 3, 2)
    return beyond and inside and inside2 and fine and second and idle_ack()

# ---- generated by scripts/gen/io_gen.py
# status and result shape (HC-3)
check sk("delivered") == true
check sk("failed") == true
check sk("timed_out") == true
check sk("unreachable") == true
check sk("Delivered") == false
check sk("ok") == false
check sk("") == false
check sk("timedout") == false
check rok("delivered", some("x"), "") == true
check rget("delivered", some("x"), "") == some("x")
check rok("delivered", none, "") == false
check rget("delivered", none, "") == none
check rok("delivered", some("x"), "e") == false
check rget("delivered", some("x"), "e") == none
check rok("delivered", some(""), "") == true
check rget("delivered", some(""), "") == some("")
check rok("failed", none, "no such file") == true
check rget("failed", none, "no such file") == none
check rok("failed", some("x"), "e") == false
check rget("failed", some("x"), "e") == none
check rok("failed", none, "") == true
check rget("failed", none, "") == none
check rok("timed_out", none, "") == true
check rget("timed_out", none, "") == none
check rok("unreachable", none, "no adapter") == true
check rget("unreachable", none, "no adapter") == none
check rok("unreachable", some("x"), "") == false
check rget("unreachable", some("x"), "") == none
check rok("bogus", none, "") == false
check rget("bogus", none, "") == none
check rok("bogus", some("x"), "") == false
check rget("bogus", some("x"), "") == none
