# needs: crypto pq
# pqxdh_sk answers "" for an empty shared secret or DH (an ML-KEM decapsulation whose input fails its checks answers "") and still derives for real inputs.
check pqxdh_sk("00", "") == "" and pqxdh_sk("", "00") == ""
check pqxdh_sk("0011", "22").len() == 64
check pqxdh_sk("0011", "22") != pqxdh_sk("0011", "23")
