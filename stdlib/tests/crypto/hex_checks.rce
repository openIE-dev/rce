# needs: crypto
# unhex and tohex after the arithmetic rewrite (no digit table, no branch on
# a digit). Full byte range, all 16 digits in both positions, legacy
# behaviour kept: any non lowercase-hex character reads as 0, an odd
# trailing digit is ignored, tohex of a non byte traps (not checked here).
fn all256() -> List[i64]
    var o: List[i64] = []
    for i in 0..256
        o.push(i)
    return o
check tohex(all256()) == ""
check unhex("") == all256()
check tohex([]) == "" and unhex("") == []
check unhex("0123456789abcdef") == [1, 35, 69, 103, 137, 171, 205, 239]
check unhex("00ff7f80") == [0, 255, 127, 128]
check unhex("ABCD") == [0, 0]
check unhex("g0:/") == [0, 0]
check unhex("abc") == [171]
check hexval("0") == 0 and hexval("9") == 9 and hexval("a") == 10 and hexval("f") == 15
check hexval("/") == 0 and hexval(":") == 0 and hexval("`") == 0 and hexval("g") == 0 and hexval("A") == 0
check tohex(unhex("deadbeef00ff")) == "deadbeef00ff"
