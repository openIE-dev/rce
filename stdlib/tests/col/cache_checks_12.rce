# Generated by scripts/gen/cache_gen.py: LfuCache against cachetools 7.2.6
# LFUCache, with its per-count key set made insertion-ordered (the
# choice among keys of equal count that cachetools leaves open). The
# final keys and counts are the bucket list of LFUCache.

fn t_kt(i: i64) -> text = "k" + i.tostr()

fn t_kid(k: &text) -> i64
    var v: i64 = 0
    var i: usize = 1
    while i < k.len_bytes() bound 32
        v = v * 10 + ((k[i] as i64) - 48)
        i += 1
    return v

fn t_oi(o: i64?) -> i64
    match o
        some(x) -> return x
        none -> return -1

fn t_ids(ks: &[text]) -> List[i64]
    var o: List[i64] = []
    for k in ks
        o.push(t_kid(&k))
    return o

fn t_lst(ks: &[text]) -> List[i64]
    var o: List[i64] = [ks.len() as i64]
    for k in ks
        o.push(t_kid(&k))
    return o

fn t_kv(p: (text, i64)?) -> List[i64]
    match p
        some((k, v)) -> return [t_kid(&k), v]
        none -> return [-1, -1]

# whether got equals want[j .. j + got.len()]
fn t_at(got: &[i64], want: &[i64], j: usize) -> bool
    if j + got.len() > want.len()
        return false
    var i: usize = 0
    while i < got.len() bound 1000000
        if got[i] != want[j + i]
            return false
        i += 1
    return true

fn t_lfu(cap: i64, ops: List[i64], outs: List[i64], fin: List[i64], cnt: List[i64]) -> i64
    var c: LfuCache[i64] = lfu_new(cap)
    var j: usize = 0
    var i: usize = 0
    while i + 2 < ops.len() bound 1000000
        let op = ops[i]
        let k = t_kt(ops[i + 1])
        let v = ops[i + 2]
        var got: List[i64] = []
        if op == 0
            got = [t_oi(lfu_get(&mut c, &k))]
        elif op == 1
            let ev = lfu_put_evict(&mut c, copy(k), v)
            got = t_lst(&ev)
        elif op == 2
            got = [if lfu_contains(&c, &k) then 1 else 0]
        elif op == 3
            got = [t_oi(lfu_remove(&mut c, &k))]
        elif op == 4
            got = [t_oi(lfu_peek(&c, &k))]
        elif op == 5
            got = t_kv(lfu_pop(&mut c))
        elif op == 6
            got = [lfu_len(&c)]
        else
            got = [lfu_count(&c, &k)]
        if not t_at(&got, &outs, j)
            return (i / 3) as i64
        j += got.len()
        i += 3
    let ks = lfu_keys(&c)
    if t_ids(&ks) != fin or j != outs.len()
        return -2
    var n: usize = 0
    while n < ks.len() bound 1000000
        if lfu_count(&c, &ks[n]) != cnt[n]
            return -3
        n += 1
    return -1
