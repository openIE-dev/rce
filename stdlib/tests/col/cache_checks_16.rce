# Generated by scripts/gen/cache_gen.py: values whose canonical JSON is longer
# than one text (N9). Expected parts and hashes come from the canonical
# text of scripts/canonical-json-vectors.py, cut by the generator.

fn t_map(ks: List[CVal], vs: List[CVal]) -> CVal = cv_map(&ks, &vs)

fn t_set(xs: List[CVal]) -> CVal = cv_set(&xs)

fn t_canon(v: CVal, want: text) -> bool = cv_canon(&v) == want

fn t_hash(v: CVal, want: text) -> bool = cv_hash(&v) == want

# unit repeated n times (n a power of two)
fn t_rep(unit: text, n: i64) -> text
    var s = unit
    var k: i64 = 1
    while k < n bound 64
        s = s + s
        k = k * 2
    return s

# [pre, rep(unit, n) k times]
fn t_texts(pre: text, unit: text, n: i64, k: i64) -> CVal
    let t = t_rep(unit, n)
    var o: List[CVal] = [CvText(t: pre)]
    for _i in 0..k
        o.push(CvText(t: copy(t)))
    return CvList(items: o)

fn t_ints(n: i64, m: i64) -> CVal
    var o: List[CVal] = []
    for i in 0..n
        o.push(CvInt(v: (i * 7919) % m))
    return CvList(items: o)

fn t_parts_ok(v: CVal, max: i64, nparts: i64, first: text, last: text) -> bool
    let ps = cv_canon_parts(&v, max)
    return ps.len() as i64 == nparts and ps[0].sha256() == first and ps[ps.len() - 1].sha256() == last
check t_parts_ok(t_texts("a", "\u{e9}", 65536, 8), 1000000, 2, "18473ca3d8a3aa490abaa5f54da0bbaa47cf133cba1e34a1f341278c38e4ef43", "7749437a540117958316e216bad64be60656eb8199351f28a03b66043de61bcc")
