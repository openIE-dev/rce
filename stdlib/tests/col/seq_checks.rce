    return (seq_flatten(&ls) catch [0 - 999]) == flat and parts
fn t_dedupe(xs: List[i64], want: List[i64], wk0: List[i64], runs: List[i64]) -> bool
    return seq_dedupe(&xs) == want and seq_dedupe_by_key(&xs, t_k0) == wk0 and seq_dedupe_runs(&xs) == runs
