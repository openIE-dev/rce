fn t_insk(xs: List[(i64, i64)], x: (i64, i64), wl: List[(i64, i64)], wr: List[(i64, i64)], il: usize, ir: usize) -> bool
    var a = copy(xs)
    var b = copy(xs)
    let pa = seq_insort_left_by_key(&mut a, copy(x), t_kp) catch SQ_MAXU
    let pb = seq_insort_right_by_key(&mut b, x, t_kp) catch SQ_MAXU
    return a == wl and b == wr and pa == il and pb == ir
fn t_merge(a: List[i64], b: List[i64], want: List[i64]) -> bool = (seq_merge(&a, &b) catch [0 - 999]) == want
fn t_merge_all(flat: List[i64], lens: List[usize], want: List[i64], wk0: List[i64]) -> bool
    let ls = t_nest(flat, lens)
    return (seq_merge_all(&ls) catch [0 - 999]) == want and (seq_merge_all_by_key(&ls, t_k0) catch [0 - 999]) == wk0

# Two sorted streams a and b arrive in chunks of the lengths in ac and bc;
# each step merges what it can, the rest stays buffered for the next.
fn t_merge_step(a: List[i64], ac: List[usize], b: List[i64], bc: List[usize], n: usize, want: List[i64]) -> bool
    let pa = t_nest(a, ac)
    let pb = t_nest(b, bc)
    var qa: usize = 0
    var qb: usize = 0
    var ba: List[i64] = []
    var bb: List[i64] = []
    var o: List[i64] = []
    var go = true
    while go bound 10000
        if ba.len() == 0 and qa < pa.len()
            ba = copy(pa[qa])
            qa += 1
        if bb.len() == 0 and qb < pb.len()
            bb = copy(pb[qb])
            qb += 1
        let st = seq_merge_step(&ba, &bb, qa == pa.len(), qb == pb.len(), n)
        for x in st.0
            o.push(x)
        ba = copy(ba[st.1:ba.len()])
        bb = copy(bb[st.2:bb.len()])
        go = not (ba.len() == 0 and bb.len() == 0 and qa == pa.len() and qb == pb.len())
    return o == want

# ---- grouping and transformation
fn t_runs(xs: List[i64], keys: List[i64], flat: List[i64], lens: List[usize]) -> bool = seq_group_runs(&xs, t_k0) == t_groups(keys, flat, lens)
fn t_gby(xs: List[i64], keys: List[i64], flat: List[i64], lens: List[usize]) -> bool = seq_group_by(&xs, t_k0) == t_groups(keys, flat, lens)
fn t_gby_t(xs: List[text], keys: List[usize], flat: List[text], lens: List[usize]) -> bool = seq_group_runs(&xs, t_k2).len() >= keys.len() and seq_group_by(&xs, t_k2) == t_groups(keys, flat, lens)
fn t_chunks(xs: List[i64], n: usize, flat: List[i64], lens: List[usize]) -> bool = (seq_chunks(&xs, n) catch []) == t_nest(flat, lens)
fn t_windows(xs: List[i64], n: usize, flat: List[i64], lens: List[usize]) -> bool = (seq_windows(&xs, n) catch []) == t_nest(flat, lens)
fn t_try_sizes(xs: &[i64], n: usize) -> bool ! SeqBadSize
