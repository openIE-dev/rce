# Generated by scripts/gen/seq_gen.py (CPython 3.13.16, seeds 20261025 and 20261027); do not edit.
# Helpers of the generated col.seq checks (scripts/gen/seq_gen.py writes
# them in front of every shard). Each t_ function runs one function of
# col.seq on literal input and compares with the CPython 3.13 result. The
# key functions and comparators match the Python ones in seq_gen.py.
# Nested lists are written flat with their lengths (t_nest), because a
# list literal whose elements are list literals of different lengths does
# not type check in this checker.

fn t_nest[T](flat: List[T], lens: List[usize]) -> List[List[T]]
    var o: List[List[T]] = []
    var i: usize = 0
    for m in lens
        var cur: List[T] = []
        for _j in 0..m
            cur.push(copy(flat[i]))
            i += 1
        o.push(cur)
    return o

fn t_groups[K, T](keys: List[K], flat: List[T], lens: List[usize]) -> List[(K, List[T])]
    let g = t_nest(flat, lens)
    var o: List[(K, List[T])] = []
    var i: usize = 0
    for k in keys
        o.push((copy(k), copy(g[i])))
        i += 1
    return o

fn t_pairs[A, B](a: List[A], b: List[B]) -> List[(A, B)]
    var o: List[(A, B)] = []
    var i: usize = 0
    for x in a
        o.push((copy(x), copy(b[i])))
        i += 1
    return o

# Python: abs(x) % 5, abs(x) // 4, len(s), (abs(x) % 3, -x), p[0]
fn t_k0(x: &i64) -> i64 = x.abs() % 5
fn t_k1(x: &i64) -> i64 = x.abs() / 4
fn t_k2(s: &text) -> usize = s.len_chars()
fn t_k3(x: &i64) -> (i64, i64) = (x.abs() % 3, 0 - x)
fn t_kp(p: &(i64, i64)) -> i64 = p.0

# Python cmp_to_key comparators: by abs(x); descending; text by length
# then descending code points.
fn t_c0(a: &i64, b: &i64) -> i64 = if a.abs() < b.abs() then -1 else (if b.abs() < a.abs() then 1 else 0)
fn t_c1(a: &i64, b: &i64) -> i64 = if a < b then 1 else (if b < a then -1 else 0)
fn t_c2(a: &text, b: &text) -> i64
    let la = a.len_chars()
    let lb = b.len_chars()
    if la != lb
        return if la < lb then -1 else 1
    if a == b
        return 0
    return if b < a then -1 else 1

# Python: abs(x) % 3 == 0; a + b; max(a, b); 2 * acc + x
fn t_p0(x: &i64) -> bool = x.abs() % 3 == 0
fn t_add(a: &i64, b: &i64) -> i64 = a + b
fn t_max(a: &i64, b: &i64) -> i64 = if a < b then b + 0 else a + 0
fn t_lin(acc: &i64, x: &i64) -> i64 = 2 * acc + x

