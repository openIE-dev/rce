    return seq_dedupe(&xs) == want and seq_dedupe_by_key(&xs, t_k2) == wk2 and seq_dedupe_runs(&xs) == runs
fn t_counter(xs: List[i64], keys: List[i64], cnts: List[usize], n: usize, mk: List[i64], mc: List[usize]) -> bool
    return seq_counter(&xs) == t_pairs(keys, cnts) and seq_most_common(&xs, n) == t_pairs(mk, mc)
fn t_counter_t(xs: List[text], keys: List[text], cnts: List[usize], n: usize, mk: List[text], mc: List[usize]) -> bool
    return seq_counter(&xs) == t_pairs(keys, cnts) and seq_most_common(&xs, n) == t_pairs(mk, mc)
fn t_partition(xs: List[i64], yes: List[i64], no: List[i64]) -> bool
    let p = seq_partition(&xs, t_p0)
    return p.0 == yes and p.1 == no
fn t_acc(xs: List[i64], sums: List[i64], maxes: List[i64]) -> bool = seq_accumulate(&xs, t_add) == sums and seq_accumulate(&xs, t_max) == maxes
fn t_scan(xs: List[i64], init: i64, want: List[i64]) -> bool = seq_scan(&xs, init, t_lin) == want
fn t_product(a: List[i64], b: List[text], wa: List[i64], wb: List[text]) -> bool = (seq_product(&a, &b) catch []) == t_pairs(wa, wb)
fn t_prod_all(flat: List[i64], lens: List[usize], limit: usize, wf: List[i64], wl: List[usize]) -> bool
    let ls = t_nest(flat, lens)
    return (seq_product_all(&ls, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
fn t_perm(xs: List[i64], r: usize, limit: usize, wf: List[i64], wl: List[usize]) -> bool = (seq_permutations(&xs, r, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
fn t_comb(xs: List[i64], r: usize, limit: usize, wf: List[i64], wl: List[usize]) -> bool = (seq_combinations(&xs, r, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
fn t_comb_rep(xs: List[i64], r: usize, limit: usize, wf: List[i64], wl: List[usize]) -> bool = (seq_combinations_rep(&xs, r, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
# A refusal (SeqTooLarge) is compared as the sentinel [[-999]]; no input
# holds -999.
fn t_cur_mk(mode: i64, n: usize, r: usize) -> SeqCursor
    let z: List[usize] = [0]
    if mode == 1
        return seq_cursor_permutations(n, r) catch seq_cursor_product(&z)
    if mode == 2
        return seq_cursor_combinations(n, r) catch seq_cursor_product(&z)
    return seq_cursor_combinations_rep(n, r) catch seq_cursor_product(&z)
fn t_cursor(mode: i64, n: usize, r: usize, wf: List[usize], wl: List[usize]) -> bool
    var c = t_cur_mk(mode, n, r)
    var o: List[List[usize]] = []
    var go = true
    while go bound 100000
        let t = seq_cursor_next(&mut c)
        match t
            some(idx) -> o.push(copy(idx))
            none -> go = false
    let tail = seq_cursor_next(&mut c)
    return o == t_nest(wf, wl) and seq_cursor_done(&c) and tail == none
fn t_cycle(xs: List[i64], start: usize, n: usize, want: List[i64]) -> bool = (seq_cycle(&xs, start, n) catch [0 - 999]) == want
fn t_interleave(flat: List[i64], lens: List[usize], want: List[i64]) -> bool
    let ls = t_nest(flat, lens)
    let parts = t_parts_rr(&ls, 1) == want and t_parts_rr(&ls, 2) == want and t_parts_rr(&ls, 3) == want and t_parts_rr(&ls, 0).len() == 0
    return (seq_interleave(&ls) catch [0 - 999]) == want and parts

# ---- chunked state: xs is fed in parts of the lengths in cuts
fn t_counts_feed(xs: List[i64], cuts: List[usize], keys: List[i64], cnts: List[usize], n: usize, mk: List[i64], mc: List[usize], probe: i64, pc: usize) -> bool
    let parts = t_nest(xs, cuts)
    var c: SeqCounts[i64] = seq_counts_new()
    var ok = true
    for p in parts
        let d = seq_counts_feed(&mut c, &p) catch 0
        ok = ok and d == seq_counts_len(&c)
    return ok and seq_counts_len(&c) == keys.len() and seq_counts_list(&c) == t_pairs(keys, cnts) and seq_counts_most_common(&c, n) == t_pairs(mk, mc) and seq_counts_get(&c, &probe) == pc
fn t_seen_feed(xs: List[i64], cuts: List[usize], want: List[i64]) -> bool
    let parts = t_nest(xs, cuts)
    var s: SeqSeen[i64] = seq_seen_new()
    var o: List[i64] = []
    for p in parts
        let got = seq_seen_feed(&mut s, &p) catch [0 - 999]
        for g in got
            o.push(g)
    return o == want and seq_seen_len(&s) == want.len()
fn t_top_feed(xs: List[i64], cuts: List[usize], k: usize, small: List[i64], large: List[i64], sk0: List[i64], lk0: List[i64]) -> bool
    let parts = t_nest(xs, cuts)
    var a: SeqTop[i64] = t_top_mk(k, false)
    var b: SeqTop[i64] = t_top_mk(k, true)
    var c: SeqTop[i64] = t_top_mk(k, false)
    var d: SeqTop[i64] = t_top_mk(k, true)
    for p in parts
        seq_top_feed(&mut a, &p)
        seq_top_feed(&mut b, &p)
        seq_top_feed_by_key(&mut c, &p, t_k0)
        seq_top_feed_by_key(&mut d, &p, t_k0)
    return seq_top_list(&a) == small and seq_top_list(&b) == large and seq_top_list(&c) == sk0 and seq_top_list(&d) == lk0
fn t_win_feed(xs: List[i64], cuts: List[usize], n: usize, flat: List[i64], lens: List[usize]) -> bool
    let parts = t_nest(xs, cuts)
    var w: SeqWin[i64] = t_win_mk(n)
    var o: List[List[i64]] = []
    for p in parts
        let got = seq_win_feed(&mut w, &p) catch [[0 - 999]]
        for g in got
            o.push(copy(g))
    return o == t_nest(flat, lens)
fn t_batch_feed(xs: List[i64], cuts: List[usize], n: usize, flat: List[i64], lens: List[usize]) -> bool
    let parts = t_nest(xs, cuts)
    var b: SeqBatch[i64] = t_batch_mk(n)
    var o: List[List[i64]] = []
    for p in parts
        let got = seq_batch_feed(&mut b, &p)
        for g in got
            o.push(copy(g))
    let last = seq_batch_end(&mut b)
    if last.len() > 0
        o.push(last)
    return o == t_nest(flat, lens)
fn t_runs_feed(xs: List[i64], cuts: List[usize], keys: List[i64], flat: List[i64], lens: List[usize]) -> bool
    let parts = t_nest(xs, cuts)
    var st: SeqRuns[i64, i64] = seq_runs_new()
    var o: List[(i64, List[i64])] = []
    for p in parts
        let got = seq_runs_feed(&mut st, &p, t_k0) catch []
        for g in got
            o.push(copy(g))
    let last = seq_runs_end(&mut st)
    for g in last
        o.push(copy(g))
    return o == t_groups(keys, flat, lens)
fn t_top0[T]() -> SeqTop[T] = SeqTop(k: 0, largest: false, items: [], pos: [], seen: 0)
fn t_win0[T]() -> SeqWin[T] = SeqWin(n: 1, buf: [])
fn t_batch0[T]() -> SeqBatch[T] = SeqBatch(n: 1, buf: [])
fn t_top_mk(k: usize, largest: bool) -> SeqTop[i64] = seq_top_new(k, largest) catch t_top0()
fn t_win_mk(n: usize) -> SeqWin[i64] = seq_win_new(n) catch t_win0()
fn t_batch_mk(n: usize) -> SeqBatch[i64] = seq_batch_new(n) catch t_batch0()

