fn t_sorted(xs: List[i64], asc: List[i64], desc: List[i64]) -> bool = seq_sorted(&xs) == asc and seq_sorted_desc(&xs) == desc and seq_is_sorted(&asc)
fn t_sorted_t(xs: List[text], asc: List[text], desc: List[text]) -> bool = seq_sorted(&xs) == asc and seq_sorted_desc(&xs) == desc
