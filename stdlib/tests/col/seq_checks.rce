# The parts of size w at 0, w, 2w, ... (and one past the end) put back
# together give the whole result.
fn t_parts_flat(ls: &[List[i64]], w: usize) -> List[i64]
    var o: List[i64] = []
    var at: usize = 0
    var go = true
    while go bound 1000
        let p = seq_flatten_part(ls, at, w) catch [0 - 999]
        for x in p
            o.push(x)
        go = p.len() == w and w > 0
        at += w
    return o
fn t_parts_rr(ls: &[List[i64]], w: usize) -> List[i64]
    var o: List[i64] = []
    var at: usize = 0
    var go = true
    while go bound 1000
        let p = seq_interleave_part(ls, at, w) catch [0 - 999]
        for x in p
            o.push(x)
        go = p.len() == w and w > 0
        at += w
