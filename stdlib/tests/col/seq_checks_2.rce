# ---- grouping and transformation
fn t_runs(xs: List[i64], keys: List[i64], flat: List[i64], lens: List[usize]) -> bool = seq_group_runs(&xs, t_k0) == t_groups(keys, flat, lens)
fn t_gby(xs: List[i64], keys: List[i64], flat: List[i64], lens: List[usize]) -> bool = seq_group_by(&xs, t_k0) == t_groups(keys, flat, lens)
