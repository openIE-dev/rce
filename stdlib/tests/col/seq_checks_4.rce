    let parts = t_parts_rr(&ls, 1) == want and t_parts_rr(&ls, 2) == want and t_parts_rr(&ls, 3) == want and t_parts_rr(&ls, 0).len() == 0
    return (seq_interleave(&ls) catch [0 - 999]) == want and parts

# ---- chunked state: xs is fed in parts of the lengths in cuts
fn t_counts_feed(xs: List[i64], cuts: List[usize], keys: List[i64], cnts: List[usize], n: usize, mk: List[i64], mc: List[usize], probe: i64, pc: usize) -> bool
    let parts = t_nest(xs, cuts)
    var c: SeqCounts[i64] = seq_counts_new()
    var ok = true
    for p in parts
        let d = seq_counts_feed(&mut c, &p) catch 0
        ok = ok and d == seq_counts_len(&c)
    return ok and seq_counts_len(&c) == keys.len() and seq_counts_list(&c) == t_pairs(keys, cnts) and seq_counts_most_common(&c, n) == t_pairs(mk, mc) and seq_counts_get(&c, &probe) == pc
fn t_seen_feed(xs: List[i64], cuts: List[usize], want: List[i64]) -> bool
    let parts = t_nest(xs, cuts)
    var s: SeqSeen[i64] = seq_seen_new()
    var o: List[i64] = []
    for p in parts
        let got = seq_seen_feed(&mut s, &p) catch [0 - 999]
        for g in got
            o.push(g)
    return o == want and seq_seen_len(&s) == want.len()
fn t_top_feed(xs: List[i64], cuts: List[usize], k: usize, small: List[i64], large: List[i64], sk0: List[i64], lk0: List[i64]) -> bool
    let parts = t_nest(xs, cuts)
    var a: SeqTop[i64] = t_top_mk(k, false)
    var b: SeqTop[i64] = t_top_mk(k, true)
    var c: SeqTop[i64] = t_top_mk(k, false)
    var d: SeqTop[i64] = t_top_mk(k, true)
    for p in parts
        seq_top_feed(&mut a, &p)
        seq_top_feed(&mut b, &p)
        seq_top_feed_by_key(&mut c, &p, t_k0)
        seq_top_feed_by_key(&mut d, &p, t_k0)
    return seq_top_list(&a) == small and seq_top_list(&b) == large and seq_top_list(&c) == sk0 and seq_top_list(&d) == lk0
fn t_win_feed(xs: List[i64], cuts: List[usize], n: usize, flat: List[i64], lens: List[usize]) -> bool
    let parts = t_nest(xs, cuts)
    var w: SeqWin[i64] = t_win_mk(n)
    var o: List[List[i64]] = []
    for p in parts
        let got = seq_win_feed(&mut w, &p)
        for g in got
            o.push(copy(g))
    return o == t_nest(flat, lens)
fn t_batch_feed(xs: List[i64], cuts: List[usize], n: usize, flat: List[i64], lens: List[usize]) -> bool
    let parts = t_nest(xs, cuts)
    var b: SeqBatch[i64] = t_batch_mk(n)
    var o: List[List[i64]] = []
    for p in parts
        let got = seq_batch_feed(&mut b, &p)
        for g in got
            o.push(copy(g))
    let last = seq_batch_end(&mut b)
    if last.len() > 0
        o.push(last)
    return o == t_nest(flat, lens)
fn t_runs_feed(xs: List[i64], cuts: List[usize], keys: List[i64], flat: List[i64], lens: List[usize]) -> bool
    let parts = t_nest(xs, cuts)
    var st: SeqRuns[i64, i64] = seq_runs_new()
    var o: List[(i64, List[i64])] = []
    for p in parts
        let got = seq_runs_feed(&mut st, &p, t_k0) catch []
        for g in got
            o.push(copy(g))
    let last = seq_runs_end(&mut st)
    for g in last
        o.push(copy(g))
    return o == t_groups(keys, flat, lens)
fn t_top0[T]() -> SeqTop[T] = SeqTop(k: 0, largest: false, items: [], pos: [], seen: 0)
fn t_win0[T]() -> SeqWin[T] = SeqWin(n: 1, buf: [])
fn t_batch0[T]() -> SeqBatch[T] = SeqBatch(n: 1, buf: [])
fn t_top_mk(k: usize, largest: bool) -> SeqTop[i64] = seq_top_new(k, largest) catch t_top0()
fn t_win_mk(n: usize) -> SeqWin[i64] = seq_win_new(n) catch t_win0()
fn t_batch_mk(n: usize) -> SeqBatch[i64] = seq_batch_new(n) catch t_batch0()

