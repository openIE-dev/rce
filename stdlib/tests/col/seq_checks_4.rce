fn t_chunks(xs: List[i64], n: usize, flat: List[i64], lens: List[usize]) -> bool = (seq_chunks(&xs, n) catch []) == t_nest(flat, lens)
fn t_windows(xs: List[i64], n: usize, flat: List[i64], lens: List[usize]) -> bool = (seq_windows(&xs, n) catch []) == t_nest(flat, lens)
