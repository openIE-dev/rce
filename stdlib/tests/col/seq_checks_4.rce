fn t_top_t(xs: List[text], k: usize, small: List[text], large: List[text], sk2: List[text], lk2: List[text]) -> bool
    return seq_nsmallest(&xs, k) == small and seq_nlargest(&xs, k) == large and seq_nsmallest_by_key(&xs, k, t_k2) == sk2 and seq_nlargest_by_key(&xs, k, t_k2) == lk2

# ---- searching
fn t_bis(xs: List[i64], x: i64, l: usize, r: usize) -> bool = seq_bisect_left(&xs, &x) == l and seq_bisect_right(&xs, &x) == r
fn t_bis_t(xs: List[text], x: text, l: usize, r: usize) -> bool = seq_bisect_left(&xs, &x) == l and seq_bisect_right(&xs, &x) == r
fn t_bis_in(xs: List[i64], x: i64, lo: usize, hi: usize, l: usize, r: usize) -> bool = seq_bisect_left_in(&xs, &x, lo, hi) == l and seq_bisect_right_in(&xs, &x, lo, hi) == r
fn t_bisk(xs: List[i64], k: i64, l: usize, r: usize) -> bool = seq_bisect_left_by_key(&xs, &k, t_k1) == l and seq_bisect_right_by_key(&xs, &k, t_k1) == r
fn t_bs(xs: List[i64], x: i64, want: usize?) -> bool = seq_bsearch(&xs, &x) == want
