fn t_acc(xs: List[i64], sums: List[i64], maxes: List[i64]) -> bool = seq_accumulate(&xs, t_add) == sums and seq_accumulate(&xs, t_max) == maxes
fn t_scan(xs: List[i64], init: i64, want: List[i64]) -> bool = seq_scan(&xs, init, t_lin) == want
fn t_product(a: List[i64], b: List[text], wa: List[i64], wb: List[text]) -> bool = (seq_product(&a, &b) catch []) == t_pairs(wa, wb)
fn t_prod_all(flat: List[i64], lens: List[usize], limit: usize, wf: List[i64], wl: List[usize]) -> bool
    let ls = t_nest(flat, lens)
    return (seq_product_all(&ls, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
fn t_perm(xs: List[i64], r: usize, limit: usize, wf: List[i64], wl: List[usize]) -> bool = (seq_permutations(&xs, r, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
fn t_comb(xs: List[i64], r: usize, limit: usize, wf: List[i64], wl: List[usize]) -> bool = (seq_combinations(&xs, r, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
fn t_comb_rep(xs: List[i64], r: usize, limit: usize, wf: List[i64], wl: List[usize]) -> bool = (seq_combinations_rep(&xs, r, limit) catch t_nest([0 - 999], [1])) == t_nest(wf, wl)
# A refusal (SeqTooLarge) is compared as the sentinel [[-999]]; no input
# holds -999.
fn t_cur_mk(mode: i64, n: usize, r: usize) -> SeqCursor
    let z: List[usize] = [0]
    if mode == 1
        return seq_cursor_permutations(n, r) catch seq_cursor_product(&z)
    if mode == 2
        return seq_cursor_combinations(n, r) catch seq_cursor_product(&z)
    return seq_cursor_combinations_rep(n, r) catch seq_cursor_product(&z)
fn t_cursor(mode: i64, n: usize, r: usize, wf: List[usize], wl: List[usize]) -> bool
    var c = t_cur_mk(mode, n, r)
    var o: List[List[usize]] = []
    var go = true
    while go bound 100000
        let t = seq_cursor_next(&mut c)
        match t
            some(idx) -> o.push(copy(idx))
            none -> go = false
    let tail = seq_cursor_next(&mut c)
    return o == t_nest(wf, wl) and seq_cursor_done(&c) and tail == none
fn t_cycle(xs: List[i64], start: usize, n: usize, want: List[i64]) -> bool = (seq_cycle(&xs, start, n) catch [0 - 999]) == want
fn t_interleave(flat: List[i64], lens: List[usize], want: List[i64]) -> bool
