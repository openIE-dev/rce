fn t_sbk(xs: List[i64], k0: List[i64], k0d: List[i64], k1: List[i64], k3: List[i64], k3d: List[i64]) -> bool
    return seq_sort_by_key(&xs, t_k0) == k0 and seq_sort_by_key_desc(&xs, t_k0) == k0d and seq_sort_by_key(&xs, t_k1) == k1 and seq_sort_by_key(&xs, t_k3) == k3 and seq_sort_by_key_desc(&xs, t_k3) == k3d
fn t_sbk_t(xs: List[text], k2: List[text], k2d: List[text]) -> bool = seq_sort_by_key(&xs, t_k2) == k2 and seq_sort_by_key_desc(&xs, t_k2) == k2d
fn t_sw(xs: List[i64], c0: List[i64], c1: List[i64]) -> bool = seq_sort_with(&xs, t_c0) == c0 and seq_sort_with(&xs, t_c1) == c1
fn t_sw_t(xs: List[text], c2: List[text]) -> bool = seq_sort_with(&xs, t_c2) == c2
fn t_gather(xs: List[i64], idx: List[usize], want: List[i64]) -> bool = (seq_gather(&xs, &idx) catch [0 - 999]) == want
