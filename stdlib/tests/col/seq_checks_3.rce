fn t_bis(xs: List[i64], x: i64, l: usize, r: usize) -> bool = seq_bisect_left(&xs, &x) == l and seq_bisect_right(&xs, &x) == r
fn t_bis_t(xs: List[text], x: text, l: usize, r: usize) -> bool = seq_bisect_left(&xs, &x) == l and seq_bisect_right(&xs, &x) == r
fn t_bis_in(xs: List[i64], x: i64, lo: usize, hi: usize, l: usize, r: usize) -> bool = seq_bisect_left_in(&xs, &x, lo, hi) == l and seq_bisect_right_in(&xs, &x, lo, hi) == r
