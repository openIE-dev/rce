# Two sorted streams a and b arrive in chunks of the lengths in ac and bc;
# each step merges what it can, the rest stays buffered for the next.
fn t_merge_step(a: List[i64], ac: List[usize], b: List[i64], bc: List[usize], n: usize, want: List[i64]) -> bool
    let pa = t_nest(a, ac)
    let pb = t_nest(b, bc)
    var qa: usize = 0
    var qb: usize = 0
    var ba: List[i64] = []
    var bb: List[i64] = []
    var o: List[i64] = []
    var go = true
    while go bound 10000
        if ba.len() == 0 and qa < pa.len()
            ba = copy(pa[qa])
            qa += 1
        if bb.len() == 0 and qb < pb.len()
            bb = copy(pb[qb])
            qb += 1
        let st = seq_merge_step(&ba, &bb, qa == pa.len(), qb == pb.len(), n)
        for x in st.0
            o.push(x)
        ba = copy(ba[st.1:ba.len()])
        bb = copy(bb[st.2:bb.len()])
        go = not (ba.len() == 0 and bb.len() == 0 and qa == pa.len() and qb == pb.len())
    return o == want

