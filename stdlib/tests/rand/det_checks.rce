check qr_ok([286331153, 16909060, 2609737539, 19088743], [3928658676, 3407673550, 1166100270, 1484899515])
# RFC 8439 2.3.2 block function
check block_ok("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", 1, "000000090000004a00000000", "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e")
