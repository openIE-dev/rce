# Checks for lib/core/exact.rce (run by scripts/check.sh, appended to it).
# Hand vectors and properties first, then generated vectors: dectest
# (official General Decimal Arithmetic tests, vectors/core/exact/) and
# CPython int/fractions cross-checks (seed 20261015).

fn bp(s: text) -> Big = big_parse(s) catch big_zero()

fn bad_at(s: text) -> i64 = big_to_int(big_parse(s) catch |e| big_from_int(e.at))

fn dp(s: text) -> Dec = dec_parse(s) catch Dec(coef: big_zero(), exp: 0)

fn fact(n: i64) -> Big
    var r = big_from_int(1)
    for i in 1..(n + 1)
        r = big_mul(r, big_from_int(i))
    return r

# Seeded property sweep: for pseudo-random a, b (b != 0)
#   a == quot(a, b) * b + rem(a, b), |rem| < |b|
#   a == div(a, b) * b + mod(a, b), mod has the sign of b
#   (a + b) - b == a, a * b == b * a, tostr/parse round trip
#   isqrt(n)^2 <= n < (isqrt(n) + 1)^2
fn prop_sweep(seed: i64, n: i64) -> bool
    var s = seed
    var ok = true
    for _i in 0..n
        s = (s * 1103515245 + 12345) & 2147483647
        let x = big_mul(big_from_int(s * 4294967296 + s), big_from_int((s >> 7) - 8000000))
        s = (s * 1103515245 + 12345) & 2147483647
        let y = big_add(big_from_int(s >> (s & 15)), big_from_int(if s % 2 == 0 then -3 else 5))
        let q = big_quot(copy(x), copy(y))
        let r = big_rem(copy(x), copy(y))
        ok = ok and big_add(big_mul(q, copy(y)), copy(r)) == x and mag_cmp(&r.mag, &y.mag) < 0
        let d = big_div(copy(x), copy(y))
        let m = big_mod(copy(x), copy(y))
        ok = ok and big_add(big_mul(d, copy(y)), copy(m)) == x and (big_sign(copy(m)) == 0 or m.neg == y.neg)
        ok = ok and big_sub(big_add(copy(x), copy(y)), copy(y)) == x
        ok = ok and big_mul(copy(x), copy(y)) == big_mul(copy(y), copy(x))
        ok = ok and bp(big_tostr(copy(x))) == x
        let nn = big_abs(copy(x))
        let rt = big_isqrt(copy(nn))
        let rt1 = big_add(copy(rt), big_from_int(1))
        ok = ok and big_cmp(big_mul(copy(rt), copy(rt)), copy(nn)) <= 0 and big_cmp(copy(nn), big_mul(copy(rt1), copy(rt1))) < 0
    return ok

check prop_sweep(1, 40)
check big_tostr(fact(30)) == "265252859812191058636308480000000"
check big_tostr(big_pow(big_from_int(2), 256)) == "115792089237316195423570985008687907853269984665640564039457584007913129639936"
check big_tostr(big_from_int(-9223372036854775807 - 1)) == "-9223372036854775808"
check big_to_int(big_from_int(-9223372036854775807 - 1)) == -9223372036854775807 - 1
check big_fits_int(bp("9223372036854775807")) and not big_fits_int(bp("9223372036854775808")) and big_fits_int(bp("-9223372036854775808"))
check bad_at("12a") == 2
check bad_at("-") == 1
check big_tostr(bp("-000123")) == "-123"
check big_tostr(big_shr(bp("-5"), 1)) == "-3"
check big_tostr(big_shl(bp("3"), 100)) == "3802951800684688204490109616128"
check rat_tostr(rat_from_ints(6, -4)) == "-3/2"
check rat_tostr(rat_add(rat_from_ints(1, 3), rat_from_ints(1, 6))) == "1/2"
check rat_cmp(rat_from_ints(1, 3), rat_from_ints(1, 2)) == -1
check big_tostr(rat_round(rat_from_ints(5, 2), HALF_EVEN)) == "2" and big_tostr(rat_round(rat_from_ints(7, 2), HALF_EVEN)) == "4"
check big_tostr(rat_round(rat_from_ints(-5, 2), HALF_UP)) == "-3" and big_tostr(rat_round(rat_from_ints(-5, 2), FLOOR)) == "-3" and big_tostr(rat_round(rat_from_ints(-5, 2), CEILING)) == "-2" and big_tostr(rat_round(rat_from_ints(-5, 2), DOWN)) == "-2"
check dec_tostr(dp("-12.340")) == "-12.340"
check dec_tostr(dec_div(dp("1"), dp("3"), -5, HALF_EVEN)) == "0.33333"
check dec_tostr(dec_quantize(dp("2.675"), -2, HALF_EVEN)) == "2.68"
check dec_tostr(Dec(coef: bp("5"), exp: -3)) == "0.005"
check fx_mul(fx_from_int(3, 16), 98304, 16, HALF_EVEN) == 294912
