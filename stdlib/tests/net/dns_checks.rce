# Checks for net.dns against dnspython 2.9.0 (scripts/gen/dns_gen.py).

fn hexb(h: text) -> List[i64]
    var o: List[i64] = []
    let cs = h.chars()
    var i: usize = 0
    while i + 1 < cs.len() bound 16777216
        o.push(hv(cs[i][0] as i64) * 16 + hv(cs[i + 1][0] as i64))
        i += 2
    return o

fn hv(x: i64) -> i64 = if x <= 57 then x - 48 else x - 87

fn none_dns() -> Dns = Dns(id: -1, flags: 0, questions: [], answers: [], authority: [], additional: [])

fn dec(h: text) -> Dns
    let b = hexb(h)
    return decode(&b) catch none_dns()

fn dec_ok(h: text) -> bool = dec(h).id >= 0

fn enc(m: Dns) -> text
    let b = encode(&m) catch [256]
    let hs = "0123456789abcdef".chars()
    var o = ""
    for x in b
        o = o + copy(hs[(x >> 4) as usize]) + copy(hs[(x & 15) as usize])
    return o

fn nw(t: text) -> text = enc_bytes(name_wire(&t) catch [256])
fn nw_ok(t: text) -> bool = (name_wire(&t) catch [256]) != [256]
fn rn_at(h: text, off: i64) -> text
    let b = hexb(h)
    let r = read_name(&b, off) catch NameAt(name: "ERR", next: 0)
    return r.name

fn rn(h: text) -> text
    let b = hexb(h)
    let r = read_name(&b, 0) catch NameAt(name: "ERR", next: 0)
    return r.name

fn enc_bytes(b: List[i64]) -> text
    let hs = "0123456789abcdef".chars()
    var o = ""
    for x in b
        o = o + copy(hs[(x >> 4) as usize]) + copy(hs[(x & 15) as usize])
    return o

fn atx(b: List[i64]) -> text = a_text(&b)

fn flags_ok() -> bool
    let f = make_flags(true, 2, true, false, true, true, 3)
    return qr(f) and opcode(f) == 2 and aa(f) and not tc(f) and rd(f) and ra(f) and rcode(f) == 3 and f == 38275

fn query_ok() -> bool
    let n = "example.com."
    let m = query(4660, &n, AAAA)
    let b = encode(&m) catch []
    let back = decode(&b) catch none_dns()
    return enc_bytes(b) == "123401000001000000000000076578616d706c6503636f6d00001c0001" and back == m

fn rdata_ok() -> bool
    let h = "mx.example."
    let m = mx_rdata(10, &h) catch []
    let parts = ["v=spf1", ""]
    let t = txt_rdata(&parts) catch []
    return m == [0, 10, 2, 109, 120, 7, 101, 120, 97, 109, 112, 108, 101, 0] and t == [6, 118, 61, 115, 112, 102, 49, 0] and a_rdata(1, 2, 3, 260) == [1, 2, 3, 4]

check flags_ok()
check query_ok()

