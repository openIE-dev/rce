# h11 agreed on 71 accepted messages, differed on 5
check hser(true, "GET", "/", 0, "", ["Host"], ["x"], "") == "GET / HTTP/1.1\r\nHost: x\r\n\r\n"
check hser(true, "POST", "/up", 0, "", ["Host", "Content-Type"], ["x", "text/plain"], "payload") == "POST /up HTTP/1.1\r\nHost: x\r\nContent-Type: text/plain\r\nContent-Length: 7\r\n\r\npayload"
check hser(false, "", "", 200, "OK", ["Server"], ["rce"], "hello") == "HTTP/1.1 200 OK\r\nServer: rce\r\nContent-Length: 5\r\n\r\nhello"
check hser(false, "", "", 204, "No Content", [], [], "") == "HTTP/1.1 204 No Content\r\n\r\n"
check hser(false, "", "", 304, "Not Modified", ["ETag"], ["\"a\""], "") == "HTTP/1.1 304 Not Modified\r\nETag: \"a\"\r\n\r\n"
check hser(false, "", "", 404, "Not Found", [], [], "") == "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n"
check hser(true, "PUT", "/c", 0, "", ["Host", "Transfer-Encoding"], ["x", "chunked"], "3\r\nabc\r\n0\r\n\r\n") == "PUT /c HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
check hc("", 4) == "0\r\n\r\n"
check hc("abc", 1) == "1\r\na\r\n1\r\nb\r\n1\r\nc\r\n0\r\n\r\n"
check hc("hello world", 4) == "4\r\nhell\r\n4\r\no wo\r\n3\r\nrld\r\n0\r\n\r\n"
check hc("xxxxxxxxxxxxxxxxxxxx", 16) == "10\r\nxxxxxxxxxxxxxxxx\r\n4\r\nxxxx\r\n0\r\n\r\n"
check hc("ab", 0) == "1\r\na\r\n1\r\nb\r\n0\r\n\r\n"
