# Checks for net.http: expected values from a Python model of the
# module's rules, each accepted message also parsed by h11 0.16.0
# (scripts/gen/http_gen.py; differences are marked).

fn btext(b: &[i64]) -> text
    var o = ""
    for x in b
        o = o + (if x == 13 then "\r" else (if x == 10 then "\n" else (if x == 9 then "\t" else ch(x))))
    return o

fn pairs(ns: &[text], vs: &[text]) -> text
    var ps: List[text] = []
    for i in 0..ns.len()
        ps.push(ns[i] + "=" + vs[i])
    return ";".join(ps)

fn hp(raw: text, req: bool, headreq: bool, eof: bool) -> text
    let b = bytes_of(&raw)
    let m = parse_message(&b, req, headreq, eof) catch |e| message_with(e.why)
    if m.used < 0
        return "ERR:" + m.reason
    let ver = m.major.tostr() + "." + m.minor.tostr()
    return m.method + "|" + m.target + "|" + ver + "|" + m.status.tostr() + "|" + m.reason + "|" + pairs(&m.names, &m.values) + "|" + btext(&m.body) + "|" + pairs(&m.trailer_names, &m.trailer_values) + "|" + m.used.tostr()

fn message_with(why: text) -> Message
    var m = message_empty()
    m.used = -1
    m.reason = why
    return m

fn hser(req: bool, method: text, target: text, status: i64, reason: text, names: List[text], values: List[text], body: text) -> text
    var m = message_empty()
    m.request = req
    m.method = method
    m.target = target
    m.status = status
    m.reason = reason
    m.names = names
    m.values = values
    m.body = bytes_of(&body)
    let o = serialize(&m) catch [0]
    return btext(&o)

fn hc(data: text, size: i64) -> text
    let b = bytes_of(&data)
    let o = chunk(&b, size)
    return btext(&o)

fn header_join() -> bool
    let ns = ["A", "b", "a"]
    let vs = ["1", "2", "3"]
    let n = "a"
    let z = "zz"
    return header(&ns, &vs, &n) == some("1, 3") and header(&ns, &vs, &z) == none

fn bad_serialize_fails() -> bool
    var m = message_empty()
    m.method = "G T"
    let a = serialize(&m) catch [0]
    var r = message_empty()
    r.request = false
    r.status = 99
    let b = serialize(&r) catch [0]
    var f = message_empty()
    f.method = "GET"
    f.names = ["X"]
    f.values = ["a\r\nInjected: 1"]
    let c = serialize(&f) catch [0]
    return a == [0] and b == [0] and c == [0]

check header_join()
check bad_serialize_fails()

# ---- generated by scripts/gen/http_gen.py
check hp("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n", true, false, false) == "GET|/|1.1|0||Host=example.com|||37"
# h11 differs on the next case (h11 is more lenient or stricter here)
check hp("\r\nGET /a?b HTTP/1.1\r\nHost: x\r\n\r\n", true, false, false) == "GET|/a?b|1.1|0||Host=x|||32"
check hp("POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello", true, false, false) == "POST|/p|1.1|0||Host=x;Content-Length=5|hello||53"
check hp("POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhel", true, false, false) == "ERR:incomplete body"
# h11 differs on the next case (h11 is more lenient or stricter here)
check hp("POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: 5, 5\r\n\r\nhelloEXTRA", true, false, false) == "POST|/p|1.1|0||Host=x;Content-Length=5, 5|hello||56"
check hp("POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello!", true, false, false) == "ERR:Content-Length"
check hp("POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: -1\r\n\r\n", true, false, false) == "ERR:Content-Length"
check hp("POST /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6;ext=1\r\n world\r\n0\r\nX-T: 1\r\n\r\n", true, false, false) == "POST|/p|1.1|0||Host=x;Transfer-Encoding=chunked|hello world|X-T=1|97"
check hp("POST /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nContent-Length: 3\r\n\r\n0\r\n\r\n", true, false, false) == "ERR:both Transfer-Encoding and Content-Length"
check hp("POST /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip\r\n\r\n", true, false, false) == "ERR:transfer coding"
check hp("POST /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked, chunked\r\n\r\n0\r\n\r\n", true, false, false) == "ERR:chunked twice"
check hp("POST /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nz\r\n", true, false, false) == "ERR:chunk size"
check hp("POST /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabcX\r\n0\r\n\r\n", true, false, false) == "ERR:chunk end"
check hp("POST /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", true, false, false) == "POST|/p|1.1|0||Host=x;Transfer-Encoding=chunked|0123456789||77"
check hp("GET / HTTP/1.1\r\nHost : x\r\n\r\n", true, false, false) == "ERR:field name"
check hp("GET / HTTP/1.1\r\nHost: x\r\n folded\r\n\r\n", true, false, false) == "ERR:obs-fold"
