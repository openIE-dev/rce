check jpt("{\"foo\": \"bar\"}", "[{\"op\": \"add\", \"path\": \"/FOO\", \"value\": \"BAR\"}]", "{\"foo\": \"bar\", \"FOO\": \"BAR\"}") == "ok"
check jpt("{\"foo\": {\"bar\": {\"baz\": [{\"boo\": \"net\"}]}}}", "[{\"op\": \"copy\", \"from\": \"/foo\", \"path\": \"/bak\"}, {\"op\": \"replace\", \"path\": \"/bak/bar/baz/0/boo\", \"value\": \"qux\"}]", "{\"foo\": {\"bar\": {\"baz\": [{\"boo\": \"net\"}]}}, \"bak\": {\"bar\": {\"baz\": [{\"boo\": \"qux\"}]}}}") == "ok"
check jpt("{\"foo\": {\"bar\": {\"baz\": [{\"boo\": \"net\"}]}}}", "[{\"op\": \"copy\", \"from\": \"/foo\", \"path\": \"/bak\"}, {\"op\": \"replace\", \"path\": \"/foo/bar/baz/0/boo\", \"value\": \"qux\"}]", "{\"foo\": {\"bar\": {\"baz\": [{\"boo\": \"qux\"}]}}, \"bak\": {\"bar\": {\"baz\": [{\"boo\": \"net\"}]}}}") == "ok"
check jpe("{\"q\": {\"bar\": 2}}", "[{\"op\": \"add\", \"path\": \"/a/b\", \"value\": 1}]") == "\"error\""
check jpt("{\"foo\": \"bar\"}", "[{\"op\": \"add\", \"path\": \"/baz\", \"value\": \"qux\"}]", "{\"baz\": \"qux\", \"foo\": \"bar\"}") == "ok"
check jpt("{\"foo\": [\"bar\", \"baz\"]}", "[{\"op\": \"add\", \"path\": \"/foo/1\", \"value\": \"qux\"}]", "{\"foo\": [\"bar\", \"qux\", \"baz\"]}") == "ok"
check jpt("{\"baz\": \"qux\", \"foo\": \"bar\"}", "[{\"op\": \"remove\", \"path\": \"/baz\"}]", "{\"foo\": \"bar\"}") == "ok"
check jpt("{\"foo\": [\"bar\", \"qux\", \"baz\"]}", "[{\"op\": \"remove\", \"path\": \"/foo/1\"}]", "{\"foo\": [\"bar\", \"baz\"]}") == "ok"
check jpt("{\"baz\": \"qux\", \"foo\": \"bar\"}", "[{\"op\": \"replace\", \"path\": \"/baz\", \"value\": \"boo\"}]", "{\"baz\": \"boo\", \"foo\": \"bar\"}") == "ok"
check jpt("{\"foo\": {\"bar\": \"baz\", \"waldo\": \"fred\"}, \"qux\": {\"corge\": \"grault\"}}", "[{\"op\": \"move\", \"from\": \"/foo/waldo\", \"path\": \"/qux/thud\"}]", "{\"foo\": {\"bar\": \"baz\"}, \"qux\": {\"corge\": \"grault\", \"thud\": \"fred\"}}") == "ok"
check jpt("{\"foo\": [\"all\", \"grass\", \"cows\", \"eat\"]}", "[{\"op\": \"move\", \"from\": \"/foo/1\", \"path\": \"/foo/3\"}]", "{\"foo\": [\"all\", \"cows\", \"eat\", \"grass\"]}") == "ok"
check jpt("{\"baz\": \"qux\", \"foo\": [\"a\", 2, \"c\"]}", "[{\"op\": \"test\", \"path\": \"/baz\", \"value\": \"qux\"}, {\"op\": \"test\", \"path\": \"/foo/1\", \"value\": 2}]", "{\"baz\": \"qux\", \"foo\": [\"a\", 2, \"c\"]}") == "ok"
check jpe("{\"baz\": \"qux\"}", "[{\"op\": \"test\", \"path\": \"/baz\", \"value\": \"bar\"}]") == "\"error\""
check jpt("{\"foo\": \"bar\"}", "[{\"op\": \"add\", \"path\": \"/child\", \"value\": {\"grandchild\": {}}}]", "{\"foo\": \"bar\", \"child\": {\"grandchild\": {}}}") == "ok"
check jpt("{\"foo\": \"bar\"}", "[{\"op\": \"add\", \"path\": \"/baz\", \"value\": \"qux\", \"xyz\": 123}]", "{\"foo\": \"bar\", \"baz\": \"qux\"}") == "ok"
check jpe("{\"foo\": \"bar\"}", "[{\"op\": \"add\", \"path\": \"/baz/bat\", \"value\": \"qux\"}]") == "\"error\""
check jpe("{\"foo\": \"bar\"}", "[{\"op\": \"add\", \"path\": \"/baz\", \"value\": \"qux\", \"op\": \"remove\"}]") == "\"error\""
check jpt("{\"/\": 9, \"~1\": 10}", "[{\"op\": \"test\", \"path\": \"/~01\", \"value\": 10}]", "{\"/\": 9, \"~1\": 10}") == "ok"
check jpe("{\"/\": 9, \"~1\": 10}", "[{\"op\": \"test\", \"path\": \"/~01\", \"value\": \"10\"}]") == "\"error\""
check jpt("{\"foo\": [\"bar\"]}", "[{\"op\": \"add\", \"path\": \"/foo/-\", \"value\": [\"abc\", \"def\"]}]", "{\"foo\": [\"bar\", [\"abc\", \"def\"]]}") == "ok"
check mp("{\"a\": \"b\"}", "{\"a\": \"c\"}") == "{\"a\":\"c\"}"
check mp("{\"a\": \"b\"}", "{\"b\": \"c\"}") == "{\"a\":\"b\",\"b\":\"c\"}"
check mp("{\"a\": \"b\"}", "{\"a\": null}") == "{}"
check mp("{\"a\": \"b\", \"b\": \"c\"}", "{\"a\": null}") == "{\"b\":\"c\"}"
check mp("{\"a\": [\"b\"]}", "{\"a\": \"c\"}") == "{\"a\":\"c\"}"
check mp("{\"a\": \"c\"}", "{\"a\": [\"b\"]}") == "{\"a\":[\"b\"]}"
check mp("{\"a\": {\"b\": \"c\"}}", "{\"a\": {\"b\": \"d\", \"c\": null}}") == "{\"a\":{\"b\":\"d\"}}"
check mp("{\"a\": [{\"b\": \"c\"}]}", "{\"a\": [1]}") == "{\"a\":[1]}"
