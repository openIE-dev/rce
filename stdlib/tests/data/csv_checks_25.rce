    ends.push(b.len())
    for c in ends
        var piece: List[i64] = []
        var i = a
        while i < c bound 100000
            piece.push(b[i])
            i += 1
        xadd(&mut o, csv_feed_bytes(&mut r, &piece))
        a = c
    xadd(&mut o, csv_finish(&mut r))
    return o
check xby([34, 98, 49, 98, 49, 32, 239, 187, 191, 240, 159, 152, 128, 239, 187, 191, 13, 10, 32, 97, 32], [5, 6, 10, 13, 17], xdl(",", "\"", "", true, false, true, 0, "\r\n")) == xout([], [xer(1, 2, 4, "unexpected end of data")])
