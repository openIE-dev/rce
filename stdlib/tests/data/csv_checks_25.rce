    for c in m.chars()
        q.push(c == "1")
    return q
fn xrw(row: u64, line: u64, fs: List[text], m: text) -> CsvRow = CsvRow(row: row, line: line, fields: fs, quoted: xq(m))
fn xer(row: u64, line: u64, col: u64, why: text) -> CsvErr = CsvErr(row: row, line: line, col: col, why: why)
