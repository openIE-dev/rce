# Generated by scripts/gen/cdc_gen.py; do not edit.
fn pgm(lsns: List[text], hexes: List[text]) -> List[PgMsg]
    var ms: List[PgMsg] = []
    for i in 0..lsns.len()
        ms.push(PgMsg(lsn: copy(lsns[i]), hex: copy(hexes[i])))
    return ms
fn pgl(lsns: List[text], hexes: List[text]) -> List[text]
    let ms = pgm(lsns, hexes)
    let cs = pg_decode(&ms) catch []
    return cs.map(fn(c: Change) => change_json(&c))
fn pgn(lsns: List[text], hexes: List[text]) -> i64
    let ms = pgm(lsns, hexes)
    let cs = pg_decode(&ms) catch []
    return cs.len() as i64
fn pgi(lsns: List[text], hexes: List[text], i: usize) -> text
    let ms = pgm(lsns, hexes)
    let cs = pg_decode(&ms) catch []
    if i >= cs.len()
        return "none"
    return change_json(&cs[i])
fn pgt(lsns: List[text], hexes: List[text]) -> List[text]
    let ms = pgm(lsns, hexes)
    return pg_txs(&ms) catch |e| [copy(e.why)]
fn w2(lines: List[text]) -> text
    let cs = wal2json_v2(&lines) catch []
    return changes_json(&cs)
fn w1(docs: List[text]) -> text
    let cs = wal2json_v1(&docs) catch []
    return changes_json(&cs)
fn dz(t: text) -> text
    let c = from_debezium(&t) catch |e| mk("error", copy(e.why), "", events.JsNull, events.JsNull, events.JsNull, events.JsNull, "", "")
    return change_json(&c)
fn mgc(t: text) -> text
    let c = from_mongo(&t) catch |e| mk("error", copy(e.why), "", events.JsNull, events.JsNull, events.JsNull, events.JsNull, "", "")
    return change_json(&c)
fn mgu(pre: text, ud: text) -> text
    let p = events.json_parse(&pre) catch events.JsNull
    let u = events.json_parse(&ud) catch events.JsNull
    let r = apply_update(&p, &u)
    return events.json_canon(&r)
fn mgt(d: text) -> text = token_time(&d) catch |e| copy(e.why)
fn cc(t: text, db: text) -> List[text]
    let cs = couch_changes(&t, &db) catch |e| [mk("error", copy(e.why), "", events.JsNull, events.JsNull, events.JsNull, events.JsNull, "", "")]
    return cs.map(fn(c: Change) => change_json(&c))
fn cls(t: text) -> text = couch_last_seq(&t) catch |_e| "error"
fn ccl(ls: List[text], db: text) -> List[text]
    let cs = couch_continuous(&ls, &db) catch |e| [mk("error", copy(e.why), "", events.JsNull, events.JsNull, events.JsNull, events.JsNull, "", "")]
    return cs.map(fn(c: Change) => change_json(&c))
fn sq(h: text) -> List[text]
    let cs = sqlite_changes(&h) catch |e| [mk("error", copy(e.why), "", events.JsNull, events.JsNull, events.JsNull, events.JsNull, "", "")]
    return cs.map(fn(c: Change) => change_json(&c))
fn bv(h: text) -> text
    let b = hex_bytes(&h) catch []
    let v = bytes_value(&b)
    return events.json_canon(&v)
fn fe(t: text) -> text
    let c = from_debezium(&t) catch |e| mk("error", copy(e.why), "", events.JsNull, events.JsNull, events.JsNull, events.JsNull, "", "")
    let v = feed_event(&c)
    return events.json_canon(&v)
fn rj(h: text) -> text = resp_json(&h) catch |e| "error " + e.why
fn re(h: text, s: text) -> List[text]
    let cs = redis_entries(&h, &s) catch |e| [mk("error", copy(e.why), "", events.JsNull, events.JsNull, events.JsNull, events.JsNull, "", "")]
    return cs.map(fn(c: Change) => change_json(&c))
fn jc(h: text) -> text
    let c = js_change(&h) catch |e| mk("error", copy(e.why), "", events.JsNull, events.JsNull, events.JsNull, events.JsNull, "", "")
    return change_json(&c)
fn pa(h: text) -> text = puback(&h) catch |e| "error " + e.why
fn am(r: text) -> text
    let m = ack_meta(&r) catch |e| AckMeta(domain: "error", stream: copy(e.why), consumer: "", delivered: 0, stream_seq: 0, consumer_seq: 0, ts: "", pending: 0)
    return ack_text(&m)
