fn show_body(b: &Body) -> text
    match b
        BEmpty -> return ""
        BText(t: t) -> return copy(t)
        BBytes(b: x) -> return "base64:" + enc.b64_encode(x, false, true)
fn show_hdrs(hs: &[Hdr]) -> List[text]
    var o: List[text] = []
    for h in hs
        let l = h.name + ": " + h.value
        var j = o.len()
        o.push(copy(l))
        while j > 0 and o[j - 1] > l bound 4096
            o[j] = copy(o[j - 1])
            j -= 1
