check xw([CsvStr(t: "")], xdl(",", "\"", "", true, false, false, 3, "\r\n")) == "ERR 1 single empty field record must be quoted"
check xw([CsvStr(t: "\t\t")], xdl(",", "\"", "", true, false, false, 3, "\r\n")) == "\t\t\r\n"
check xw([CsvStr(t: "")], xdl(",", "\"", "", true, false, false, 3, "\r\n")) == "ERR 1 single empty field record must be quoted"
check xw([CsvStr(t: "xé\""), CsvStr(t: " ;\\\r")], xdl(",", "\"", "", true, false, false, 3, "\r\n")) == "ERR 1 need to escape, but no escapechar set"
check xw([CsvStr(t: ""), CsvStr(t: "'\r")], xdl(",", "\"", "", true, false, false, 3, "\r\n")) == "ERR 2 need to escape, but no escapechar set"
check xw([CsvStr(t: "😀a"), CsvStr(t: "'\" ")], xdl(",", "\"", "", true, false, false, 3, "\r\n")) == "ERR 2 need to escape, but no escapechar set"
check xw([CsvStr(t: "\n\t"), CsvStr(t: ""), CsvStr(t: "|;bé"), CsvStr(t: "|")], xdl(",", "\"", "", true, false, false, 3, "\r\n")) == "ERR 1 need to escape, but no escapechar set"
check xw([CsvStr(t: "b"), CsvStr(t: "a\n"), CsvStr(t: ""), CsvStr(t: "\\\r")], xdl(",", "\"", "", true, false, false, 3, "\r\n")) == "ERR 2 need to escape, but no escapechar set"
# seeded random records under space delimiter, QUOTE_NONE, escapechar
check xw([CsvNull], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "ERR 1 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([CsvNull], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "ERR 1 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([CsvStr(t: "😀"), CsvStr(t: ",\\é;"), CsvStr(t: "\\\ra")], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "😀 ,\\\\é; \\\\\\\ra\r\n"
check xw([CsvStr(t: ""), CsvStr(t: "x\nb'"), CsvNull, CsvStr(t: "a ")], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "ERR 1 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([CsvNum(t: "3.14159"), CsvStr(t: "é,,"), CsvStr(t: "é'x;"), CsvStr(t: "\n")], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "3.14159 é,, é'x; \\\n\r\n"
check xw([CsvStr(t: "\r")], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "\\\r\r\n"
check xw([CsvStr(t: "\r"), CsvNum(t: "1.5"), CsvStr(t: ";\r"), CsvStr(t: "")], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "ERR 4 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([CsvNull], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "ERR 1 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([CsvStr(t: ";")], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == ";\r\n"
check xw([CsvStr(t: "\n\n")], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "\\\n\\\n\r\n"
check xw([CsvStr(t: "\t\\|")], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "\t\\\\|\r\n"
check xw([CsvStr(t: "x"), CsvStr(t: "'")], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "x '\r\n"
check xw([CsvNum(t: "1.5"), CsvStr(t: ""), CsvStr(t: "\r b ")], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "ERR 2 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([CsvStr(t: "\ra\\b")], xdl(" ", "\"", "\\", true, true, false, 3, "\r\n")) == "\\\ra\\\\b\r\n"
# seeded random records under space delimiter, QUOTE_NOTNULL
check xw([CsvStr(t: "\n;"), CsvStr(t: "x\r"), CsvStr(t: "")], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "\"\n;\" \"x\r\" \"\"\r\n"
check xw([CsvNum(t: "1000000000000")], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "\"1000000000000\"\r\n"
check xw([CsvStr(t: ";a"), CsvNum(t: "-7")], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "\";a\" \"-7\"\r\n"
check xw([CsvStr(t: "\n"), CsvStr(t: ";"), CsvNum(t: "1e+20"), CsvNum(t: "1e+20")], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "\"\n\" \";\" \"1e+20\" \"1e+20\"\r\n"
check xw([], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "\r\n"
check xw([CsvStr(t: "\r;aé"), CsvStr(t: "")], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "\"\r;aé\" \"\"\r\n"
check xw([CsvStr(t: "")], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "\"\"\r\n"
check xw([CsvStr(t: "|😀"), CsvNum(t: "1.5"), CsvStr(t: "\tx😀"), CsvNull], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "ERR 4 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "\r\n"
check xw([CsvStr(t: " "), CsvStr(t: " ';"), CsvStr(t: "x'\\")], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "\" \" \" ';\" \"x'\\\"\r\n"
check xw([CsvStr(t: "'"), CsvNull, CsvStr(t: "|'\t "), CsvStr(t: "")], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "ERR 2 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([CsvNull], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "ERR 1 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "\r\n"
check xw([CsvStr(t: "\n'\na"), CsvStr(t: "\n"), CsvStr(t: "")], xdl(" ", "\"", "", true, true, false, 5, "\r\n")) == "\"\n'\na\" \"\n\" \"\"\r\n"
# seeded random records under space delimiter, QUOTE_STRINGS
check xw([CsvStr(t: " "), CsvStr(t: "\t"), CsvStr(t: "")], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "\" \" \"\t\" \"\"\r\n"
check xw([CsvNum(t: "inf"), CsvStr(t: ""), CsvStr(t: "")], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "inf \"\" \"\"\r\n"
check xw([CsvStr(t: ""), CsvNull, CsvStr(t: "éx")], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "ERR 2 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([CsvStr(t: ""), CsvNull, CsvStr(t: "é😀'")], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "ERR 2 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([CsvNull], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "ERR 1 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([CsvNum(t: "1000000000000"), CsvStr(t: "\\\\"), CsvStr(t: " '"), CsvStr(t: ",")], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "1000000000000 \"\\\\\" \" '\" \",\"\r\n"
check xw([CsvNull, CsvStr(t: ""), CsvStr(t: ",\né\r")], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "ERR 1 empty field must be quoted if delimiter is a space and skipinitialspace is true"
check xw([CsvStr(t: "😀")], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "\"😀\"\r\n"
check xw([], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "\r\n"
check xw([CsvStr(t: "bé "), CsvStr(t: "\\")], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "\"bé \" \"\\\"\r\n"
check xw([], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "\r\n"
check xw([CsvStr(t: "\t"), CsvStr(t: ""), CsvStr(t: "'\t,;"), CsvNum(t: "0")], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "\"\t\" \"\" \"'\t,;\" 0\r\n"
check xw([CsvNum(t: "1.5"), CsvStr(t: "b"), CsvStr(t: "😀\r\\\n")], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "1.5 \"b\" \"😀\r\\\n\"\r\n"
check xw([CsvStr(t: " x")], xdl(" ", "\"", "", true, true, false, 4, "\r\n")) == "\" x\"\r\n"
# csv.writer.writerows (several records in one text)
check xws([xr([]), xr(["\n 😀"]), xr(["a\\", ""]), xr(["\" a\r", "😀b", ""])], xdl(",", "\"", "", true, false, false, 0, "\r\n")) == "\r\n\"\n 😀\"\r\na\\,\r\n\"\"\" a\r\",😀b,\r\n"
check xws([xr(["'a", "😀\n b", "\n"]), xr(["é\\\né", " ", "😀"]), xr(["x,;"]), xr([])], xdl(",", "\"", "", true, false, true, 0, "\r\n")) == "'a,\"😀\n b\",\"\n\"\r\n\"é\\\né\", ,😀\r\n\"x,;\"\r\n\r\n"
check xws([xr([", ", "\n", "\\"])], xdl("\t", "\"", "", true, false, false, 0, "\r\n")) == ", \t\"\n\"\t\\\r\n"
check xws([xr(["\n\r\n,", "'"]), xr(["é \t😀", "',ba"]), xr(["\n ", ""])], xdl(",", "\"", "", true, false, false, 1, "\n")) == "\"\n\r\n,\",\"'\"\n\"é \t😀\",\"',ba\"\n\"\n \",\"\"\n"
check xws([xr([]), xr([",", "ax"])], xdl(",", "\"", "", true, true, false, 0, "\r\n")) == "\r\n\",\",ax\r\n"
check xws([xr(["\n"]), xr([])], xdl(",", "\"", "\\", true, false, false, 0, "\r\n")) == "\"\n\"\r\n\r\n"
check xws([xr(["\r", ""])], xdl(",", "\"", "\\", false, false, false, 0, "\r\n")) == "\"\r\",\r\n"
check xws([xr([]), xr([])], xdl(",", "\"", "\\", true, false, false, 3, "\r\n")) == "\r\n\r\n"
check xws([xr([]), xr([]), xr([",\r", "'\"a", ";\n\t😀"])], xdl(",", "", "", true, false, false, 3, "\r\n")) == "ERR 3 1 need to escape, but no escapechar set"
check xws([xr([])], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\r\n"
# dialect validation: csv.reader(io.StringIO(""), **dialect) and its error
check xde(xdl(",", "\"", "", true, false, false, 0, "\r\n")) == ""
check xde(xdl("", "\"", "", true, false, false, 0, "\r\n")) == "\"delimiter\" must be a 1-character string"
check xde(xdl("ab", "\"", "", true, false, false, 0, "\r\n")) == "\"delimiter\" must be a 1-character string"
check xde(xdl("\r", "\"", "", true, false, false, 0, "\r\n")) == "bad delimiter value"
check xde(xdl("\n", "\"", "", true, false, false, 0, "\r\n")) == "bad delimiter value"
check xde(xdl(" ", "\"", "", true, false, false, 0, "\r\n")) == ""
check xde(xdl("\"", "\"", "", true, false, false, 0, "\r\n")) == "bad delimiter or quotechar value"
check xde(xdl("\\", "\"", "", true, false, false, 0, "\r\n")) == ""
check xde(xdl(";", "\"", "", true, false, false, 0, "\r\n")) == ""
check xde(xdl("!", "\"", "", true, false, false, 0, "\r\n")) == ""
check xde(xdl(",", "", "", true, false, false, 0, "\r\n")) == "quotechar must be set if quoting enabled"
check xde(xdl(",", "", "", true, false, false, 3, "\r\n")) == ""
check xde(xdl(",", "", "", true, true, false, 0, "\r\n")) == "quotechar must be set if quoting enabled"
check xde(xdl(",", "'", "", true, false, false, 0, "\r\n")) == ""
check xde(xdl(",", "'", "", true, false, false, 3, "\r\n")) == ""
check xde(xdl(",", "'", "", true, true, false, 0, "\r\n")) == ""
