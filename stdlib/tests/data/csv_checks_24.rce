check xtb("東京;a b;x,y;price\r\n\"a\n,\";😀;;\\ \t\r\n\"\n\";\\;éé;'\r\n", xdl(";", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["東京", "a b", "x,y", "price"]), [xm(["東京", "a b", "x,y", "price"], ["a\n,", "😀", "", "\\ \t"]), xm(["東京", "a b", "x,y", "price"], ["\n", "\\", "éé", "'"])], [])
check xtb("note,id,qty,it's\r\n' ,,\"\"\"\",\"éa,\"\r\né,éé,é\t,\"\"\"\\b\"\r\n\"x\n\",x\\,\"😀\"\"\",'\r\n,\"😀\r\",x|,\",\"\r\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["note", "id", "qty", "it's"]), [xm(["note", "id", "qty", "it's"], ["' ", "", "\"", "éa,"]), xm(["note", "id", "qty", "it's"], ["é", "éé", "é\t", "\"\\b"]), xm(["note", "id", "qty", "it's"], ["x\n", "x\\", "😀\"", "'"]), xm(["note", "id", "qty", "it's"], ["", "😀\r", "x|", ","])], [])
check xtb("東京\r\n\"|;\n\"\r\na\t\r\n;éa\r\n\\😀\r\n", xdl(",", "\"", "", true, false, true, 0, "\r\n")) == xtab(xr(["東京"]), [xm(["東京"], ["|;\n"]), xm(["東京"], ["a\t"]), xm(["東京"], [";éa"]), xm(["東京"], ["\\😀"])], [])
check xtb("a b\r\n\r\n\",\"\r\n\t\r\n \r\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["a b"]), [xm(["a b"], [","]), xm(["a b"], ["\t"]), xm(["a b"], [" "])], [])
check xtb("naïve\r\n", xdl("\t", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["naïve"]), [], [])
check xtb("price\tnaïve\r\n\ta;\r\n\"\\\n\t\"\t\" \r\r\"\r\n;😀\t'x,\r\n|😀\t,x\r\n;b\t\\\r\n", xdl("\t", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["price", "naïve"]), [xm(["price", "naïve"], ["", "a;"]), xm(["price", "naïve"], ["\\\n\t", " \r\r"]), xm(["price", "naïve"], [";😀", "'x,"]), xm(["price", "naïve"], ["|😀", ",x"]), xm(["price", "naïve"], [";b", "\\"])], [])
check xtb("city\tname\tx,y\t東京\r\n\";é\n\"\t \t\"\n'\"\t\r\n", xdl("\t", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["city", "name", "x,y", "東京"]), [xm(["city", "name", "x,y", "東京"], [";é\n", " ", "\n'", ""])], [])
check xtb("a b,\"say \"\"hi\"\"\"\r\n😀,\"\"\"\"\"\"\r\n\"\n\",\"é\n\"\r\nbaa,\r\n\tb;,,\", \",|'😀\r\n\"\\,\",x,\\\r\néa,|b\r\n", xdl(",", "\"", "", true, true, false, 0, "\r\n")) == xtab(xr(["a b", "say \"hi\""]), [xm(["a b", "say \"hi\""], ["😀", "\"\""]), xm(["a b", "say \"hi\""], ["\n", "é\n"]), xm(["a b", "say \"hi\""], ["baa", ""]), xm(["a b", "say \"hi\""], ["éa", "|b"])], [xer(5, 7, 3, "expected 2 fields, found 4"), xer(6, 8, 3, "expected 2 fields, found 3")])
check xtb("id,price\r\n,\"\"\"\t\"\r\n,'\r\né,\r\n\"\r\",\"\n\"\r\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["id", "price"]), [xm(["id", "price"], ["", "\"\t"]), xm(["id", "price"], ["", "'"]), xm(["id", "price"], ["é", ""]), xm(["id", "price"], ["\r", "\n"])], [])
check xtb("id,id,\"say \"\"hi\"\"\",a b\r\n\"\"\"x|\",\"b,😀\", b,\r\n;',|\\|, ',\"\\,\",,\"\"\"|\"\r\n|a',\"\n\",,\"x\n\n\"\r\n😀, b|,,\"\n,\"\"\"\r\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["id", "id", "say \"hi\"", "a b"]), [xm(["id", "id", "say \"hi\"", "a b"], ["\"x|", "b,😀", " b", ""]), xm(["id", "id", "say \"hi\"", "a b"], ["|a'", "\n", "", "x\n\n"]), xm(["id", "id", "say \"hi\"", "a b"], ["😀", " b|", "", "\n,\""])], [xer(3, 3, 5, "expected 4 fields, found 6")])
check xtb("x,y;\"say \"\"hi\"\"\"\r\n\"\r\r\t\";😀 '\r\n;,\r\n\"\"\"ax\";😀\\|\r\n\"\"\"\";\\,\r\n,;😀\r\n", xdl(";", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["x,y", "say \"hi\""]), [xm(["x,y", "say \"hi\""], ["\r\r\t", "😀 '"]), xm(["x,y", "say \"hi\""], ["", ","]), xm(["x,y", "say \"hi\""], ["\"ax", "😀\\|"]), xm(["x,y", "say \"hi\""], ["\"", "\\,"]), xm(["x,y", "say \"hi\""], [",", "😀"])], [])
check xtb("city,Zoë,東京\r\nb,\" ,\n\",a\\\r\n\tx\r\n\",\"\"x\",,\"\"\"\\;\"\r\n", xdl(",", "\"", "", true, false, true, 0, "\r\n")) == xtab(xr(["city", "Zoë", "東京"]), [xm(["city", "Zoë", "東京"], ["b", " ,\n", "a\\"]), xm(["city", "Zoë", "東京"], [",\"x", "", "\"\\;"])], [xer(3, 4, 2, "expected 3 fields, found 1")])
