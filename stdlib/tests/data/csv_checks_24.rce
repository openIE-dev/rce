check xtb("x,y\r\n", xdl(";", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["x,y"]), [], [])
check xtb("a b,id\r\n\"a\n\n\",éa\r\n,',é\\,\r\n,\t\r\n\"\r\",\"\t,\"\r\n,é\r\n\"\n\"\"\"\r\n", xdl(",", "\"", "", true, false, true, 0, "\r\n")) == xtab(xr(["a b", "id"]), [xm(["a b", "id"], ["a\n\n", "éa"]), xm(["a b", "id"], ["", "\t"]), xm(["a b", "id"], ["\r", "\t,"]), xm(["a b", "id"], ["", "é"])], [xer(3, 5, 3, "expected 2 fields, found 4"), xer(7, 11, 2, "expected 2 fields, found 1")])
check xtb("東京,price\r\nx,😀,😀\r\nxb,\"\n\"\r\n,\r\n\"\n;\n\",\r\n,\"\tx\n\"\r\n,\"\n\"\r\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["東京", "price"]), [xm(["東京", "price"], ["xb", "\n"]), xm(["東京", "price"], ["", ""]), xm(["東京", "price"], ["\n;\n", ""]), xm(["東京", "price"], ["", "\tx\n"]), xm(["東京", "price"], ["", "\n"])], [xer(2, 2, 3, "expected 2 fields, found 3")])
