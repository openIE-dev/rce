# header rows: csv_table against csv.DictReader; ragged rows are errors
check xtb("a,b\n1,2\n3\n4,5,6\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["a", "b"]), [xm(["a", "b"], ["1", "2"])], [xer(3, 3, 2, "expected 2 fields, found 1"), xer(4, 4, 3, "expected 2 fields, found 3")])
check xtb("\n\na,b\n\n1,2\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["a", "b"]), [xm(["a", "b"], ["1", "2"])], [])
check xtb("a,a\n1,2\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["a", "a"]), [xm(["a", "a"], ["1", "2"])], [])
check xtb("a\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["a"]), [], [])
check xtb("", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr([]), [], [])
check xtb("a,b\r\n\"x,y\",z\r\n,\r\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["a", "b"]), [xm(["a", "b"], ["x,y", "z"]), xm(["a", "b"], ["", ""])], [])
check xtb("k\n\"unterminated", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["k"]), [xm(["k"], ["unterminated"])], [])
check xtb("a,b\n1,\"2\"x\n3,4\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["a", "b"]), [xm(["a", "b"], ["1", "2x"]), xm(["a", "b"], ["3", "4"])], [])
check xtb("a,b\n1,\"2\"x\n3,4\n", xdl(",", "\"", "", true, false, true, 0, "\r\n")) == xtab(xr(["a", "b"]), [xm(["a", "b"], ["3", "4"])], [xer(2, 2, 6, "',' expected after '\"'")])
check xtb("Zoë\ta b\r\n\té😀\t\"\"\"a\"\r\n\\é|\t\r\nx\txéx\r\n\t\t''\t\r\n\t\r\nx\\\tab'\r\n", xdl("\t", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["Zoë", "a b"]), [xm(["Zoë", "a b"], ["\\é|", ""]), xm(["Zoë", "a b"], ["x", "xéx"]), xm(["Zoë", "a b"], ["", ""]), xm(["Zoë", "a b"], ["x\\", "ab'"])], [xer(2, 2, 3, "expected 2 fields, found 3"), xer(5, 5, 3, "expected 2 fields, found 4")])
check xtb("Zoë;東京;東京\r\n\"\"\"\\\"\r\n;;\\|a\r\nx;|;a\tx;\"\"\"\t|\"\r\n;;\r\n", xdl(";", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["Zoë", "東京", "東京"]), [xm(["Zoë", "東京", "東京"], ["", "", "\\|a"]), xm(["Zoë", "東京", "東京"], ["", "", ""])], [xer(2, 2, 2, "expected 3 fields, found 1"), xer(4, 4, 4, "expected 3 fields, found 4")])
check xtb("naïve\tcity\r\n\t\r\n\";\r\"\t\r\n", xdl("\t", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["naïve", "city"]), [xm(["naïve", "city"], ["", ""]), xm(["naïve", "city"], [";\r", ""])], [])
check xtb("note\r\na';\r\n\\\r\n\"\r\t\"\r\n\"\"\r\n", xdl(",", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["note"]), [xm(["note"], ["a';"]), xm(["note"], ["\\"]), xm(["note"], ["\r\t"]), xm(["note"], [""])], [])
check xtb("city\tx,y\r\n\t\" \t\"\r\n\t😀\r\n,x\t😀 '\r\nxb'\t\"\"\"\"\r\n😀'\t''\r\n", xdl("\t", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["city", "x,y"]), [xm(["city", "x,y"], ["", " \t"]), xm(["city", "x,y"], ["", "😀"]), xm(["city", "x,y"], [",x", "😀 '"]), xm(["city", "x,y"], ["xb'", "\""]), xm(["city", "x,y"], ["😀'", "''"])], [])
check xtb("it's\r\n😀\t \r\n\";\"\"😀\",\" \rx\",\r\n\"\"\r\n\"\"\r\n😀\r\n\r\n", xdl(",", "\"", "", true, true, false, 0, "\r\n")) == xtab(xr(["it's"]), [xm(["it's"], ["😀\t "]), xm(["it's"], [""]), xm(["it's"], [""]), xm(["it's"], ["😀"])], [xer(3, 4, 2, "expected 1 fields, found 3")])
check xtb("a b\tqty\tcity\r\n\"; \"\"\"\t\t\"\n b\"\r\n\"b\t\"\t\t,😀😀\r\n\t\"\"\"\"\t\"\r|\"\r\n\"\"\r\n\t \t😀\r\n\t\r\n", xdl("\t", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["a b", "qty", "city"]), [xm(["a b", "qty", "city"], ["; \"", "", "\n b"]), xm(["a b", "qty", "city"], ["b\t", "", ",😀😀"]), xm(["a b", "qty", "city"], ["", "\"", "\r|"]), xm(["a b", "qty", "city"], ["", " ", "😀"])], [xer(5, 7, 2, "expected 3 fields, found 1"), xer(7, 9, 3, "expected 3 fields, found 2")])
check xtb("naïve\tnaïve\tit's\r\na\t\t😀x\t\"😀,\t\"\t|\r\n\t😀|\r\n\"\t\"\t\\'\t\"\né\"\r\n\"é\t,\"\t\t\"|\r\"\r\n", xdl("\t", "\"", "", true, false, false, 0, "\r\n")) == xtab(xr(["naïve", "naïve", "it's"]), [xm(["naïve", "naïve", "it's"], ["\t", "\\'", "\né"]), xm(["naïve", "naïve", "it's"], ["é\t,", "", "|\r"])], [xer(2, 2, 4, "expected 3 fields, found 5"), xer(3, 3, 3, "expected 3 fields, found 2")])
check xtb("price,note,id\r\n\\,',x\r\n\t,bb,\r\n,\"\r\",\\,\";\n\",''\r\n", xdl(",", "\"", "", true, false, true, 0, "\r\n")) == xtab(xr(["price", "note", "id"]), [xm(["price", "note", "id"], ["\\", "'", "x"]), xm(["price", "note", "id"], ["\t", "bb", ""])], [xer(4, 6, 4, "expected 3 fields, found 5")])
