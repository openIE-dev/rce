# UTF-8 bytes in chunks: sequences cut by a chunk end, a byte-order mark,
# ill-formed bytes replaced by U+FFFD and reported where they are
check xby([239, 187, 191, 97, 44, 98, 10], [1, 2, 3, 4, 5, 6], csv_excel()) == xout([xrw(1, 1, ["a", "b"], "00")], [])
check xby([239, 187], [1], csv_excel()) == xout([xrw(1, 1, ["\u{fffd}"], "0")], [xer(1, 1, 1, "invalid UTF-8 (replaced by U+FFFD)")])
check xby([239, 187, 88], [1, 2], csv_excel()) == xout([xrw(1, 1, ["\u{fffd}X"], "0")], [xer(1, 1, 1, "invalid UTF-8 (replaced by U+FFFD)")])
check xby([97, 44, 255, 10, 226, 130], [1, 2, 3, 4, 5], csv_excel()) == xout([xrw(1, 1, ["a", "\u{fffd}"], "00"), xrw(2, 2, ["\u{fffd}"], "0")], [xer(1, 1, 3, "invalid UTF-8 (replaced by U+FFFD)"), xer(2, 2, 1, "invalid UTF-8 (replaced by U+FFFD)")])
check xby([240, 159, 152, 128, 44, 226, 130, 172, 10], [1, 2, 3, 4, 5, 6, 7, 8], csv_excel()) == xout([xrw(1, 1, ["😀", "€"], "00")], [])
check xby([34, 97, 128, 98, 34, 44, 99, 10], [1, 2, 3, 4, 5, 6, 7], csv_excel()) == xout([xrw(1, 1, ["a\u{fffd}b", "c"], "10")], [xer(1, 1, 3, "invalid UTF-8 (replaced by U+FFFD)")])
check xby([239, 187, 191, 239, 187, 191, 120, 10], [1, 2, 3, 4, 5, 6, 7], csv_excel()) == xout([xrw(1, 1, ["\u{feff}x"], "0")], [])
check xby([], [], csv_excel()) == xout([], [])
check xby([44, 97, 10, 97, 32, 237, 160, 128, 34, 255, 32, 44, 34, 10], [8, 9, 11, 12, 13], xdl(",", "\"", "", true, false, true, 0, "\r\n")) == xout([xrw(1, 1, ["", "a"], "00")], [xer(2, 2, 3, "invalid UTF-8 (replaced by U+FFFD)"), xer(2, 2, 4, "invalid UTF-8 (replaced by U+FFFD)"), xer(2, 2, 5, "invalid UTF-8 (replaced by U+FFFD)"), xer(2, 2, 7, "invalid UTF-8 (replaced by U+FFFD)"), xer(2, 2, 12, "unexpected end of data")])
