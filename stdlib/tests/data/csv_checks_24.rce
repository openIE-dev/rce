check xtb("name\r\n\"\"\r\nx\r\n\"\"\r\na\\\r\n\"\"\"\"\r\na\r\n", xdl(",", "\"", "", true, true, false, 0, "\r\n")) == xtab(xr(["name"]), [xm(["name"], [""]), xm(["name"], ["x"]), xm(["name"], [""]), xm(["name"], ["a\\"]), xm(["name"], ["\""]), xm(["name"], ["a"])], [])
