check xw([], xdl(",", "\"", "\\", true, false, false, 3, "\r\n")) == "\r\n"
check xw([CsvStr(t: "x"), CsvStr(t: "😀|\"😀"), CsvStr(t: "x|x\\"), CsvStr(t: "")], xdl(",", "\"", "\\", true, false, false, 3, "\r\n")) == "x,😀|\\\"😀,x|x\\\\,\r\n"
check xw([CsvStr(t: "b")], xdl(",", "\"", "\\", true, false, false, 3, "\r\n")) == "b\r\n"
check xw([CsvStr(t: "\n"), CsvStr(t: ";"), CsvStr(t: "\t\\;\n")], xdl(",", "\"", "\\", true, false, false, 3, "\r\n")) == "\\\n,;,\t\\\\;\\\n\r\n"
check xw([CsvStr(t: "😀é\r"), CsvStr(t: " \n"), CsvStr(t: "😀"), CsvStr(t: "")], xdl(",", "\"", "\\", true, false, false, 3, "\r\n")) == "😀é\\\r, \\\n,😀,\r\n"
check xw([CsvStr(t: "")], xdl(",", "\"", "\\", true, false, false, 3, "\r\n")) == "ERR 1 single empty field record must be quoted"
check xw([CsvStr(t: "\n"), CsvStr(t: "\t|;b"), CsvStr(t: "\t")], xdl(",", "\"", "\\", true, false, false, 3, "\r\n")) == "\\\n,\t|;b,\t\r\n"
# seeded random records under QUOTE_NONE, no quotechar
check xw([CsvStr(t: "\\\"")], xdl(",", "", "", true, false, false, 3, "\r\n")) == "\\\"\r\n"
check xw([], xdl(",", "", "", true, false, false, 3, "\r\n")) == "\r\n"
check xw([CsvStr(t: "é a"), CsvStr(t: "x\"😀;"), CsvStr(t: "x\r\t"), CsvStr(t: "\ra;\\")], xdl(",", "", "", true, false, false, 3, "\r\n")) == "ERR 3 need to escape, but no escapechar set"
check xw([], xdl(",", "", "", true, false, false, 3, "\r\n")) == "\r\n"
check xw([CsvStr(t: "\\\\x")], xdl(",", "", "", true, false, false, 3, "\r\n")) == "\\\\x\r\n"
check xw([], xdl(",", "", "", true, false, false, 3, "\r\n")) == "\r\n"
check xw([CsvStr(t: " ,"), CsvStr(t: "\\\t|"), CsvStr(t: "\t"), CsvStr(t: "")], xdl(",", "", "", true, false, false, 3, "\r\n")) == "ERR 1 need to escape, but no escapechar set"
check xw([CsvStr(t: "',\n"), CsvStr(t: "\r\n"), CsvStr(t: "\t,😀"), CsvStr(t: "x\n")], xdl(",", "", "", true, false, false, 3, "\r\n")) == "ERR 1 need to escape, but no escapechar set"
check xw([CsvStr(t: "\n\n"), CsvStr(t: "xb😀")], xdl(",", "", "", true, false, false, 3, "\r\n")) == "ERR 1 need to escape, but no escapechar set"
check xw([CsvStr(t: ""), CsvStr(t: "é|\n\""), CsvStr(t: "xé ")], xdl(",", "", "", true, false, false, 3, "\r\n")) == "ERR 2 need to escape, but no escapechar set"
check xw([CsvStr(t: "| "), CsvStr(t: ";😀"), CsvStr(t: "ba'")], xdl(",", "", "", true, false, false, 3, "\r\n")) == "| ,;😀,ba'\r\n"
check xw([], xdl(",", "", "", true, false, false, 3, "\r\n")) == "\r\n"
check xw([], xdl(",", "", "", true, false, false, 3, "\r\n")) == "\r\n"
check xw([CsvStr(t: "\""), CsvStr(t: "a"), CsvStr(t: ","), CsvStr(t: "a 😀")], xdl(",", "", "", true, false, false, 3, "\r\n")) == "ERR 3 need to escape, but no escapechar set"
# seeded random records under QUOTE_NONNUMERIC
check xw([CsvStr(t: "")], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\"\"\r\n"
check xw([CsvNull, CsvNum(t: "1"), CsvStr(t: "\\\n\r"), CsvStr(t: "b")], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\"\",1,\"\\\n\r\",\"b\"\r\n"
check xw([], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\r\n"
check xw([CsvStr(t: ""), CsvStr(t: "é\\")], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\"\",\"é\\\"\r\n"
check xw([CsvNum(t: "1000000000000"), CsvStr(t: "\n "), CsvStr(t: ";x")], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "1000000000000,\"\n \",\";x\"\r\n"
check xw([], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\r\n"
check xw([CsvStr(t: "'é"), CsvStr(t: "😀;"), CsvNull, CsvStr(t: "\n,")], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\"'é\",\"😀;\",\"\",\"\n,\"\r\n"
check xw([], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\r\n"
check xw([CsvNull, CsvStr(t: "\"\t,;"), CsvStr(t: "b,éb")], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\"\",\"\"\"\t,;\",\"b,éb\"\r\n"
check xw([CsvStr(t: "x ;\\"), CsvStr(t: "\n;"), CsvStr(t: ""), CsvStr(t: "'a")], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\"x ;\\\",\"\n;\",\"\",\"'a\"\r\n"
check xw([CsvNum(t: "1e+20"), CsvStr(t: ";\n ;"), CsvStr(t: "x"), CsvStr(t: ",|;")], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "1e+20,\";\n ;\",\"x\",\",|;\"\r\n"
check xw([CsvNull], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\"\"\r\n"
check xw([CsvStr(t: ""), CsvStr(t: "x"), CsvStr(t: "")], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\"\",\"x\",\"\"\r\n"
check xw([CsvStr(t: "")], xdl(",", "\"", "", true, false, false, 2, "\r\n")) == "\"\"\r\n"
# seeded random records under QUOTE_STRINGS
check xw([CsvNull, CsvStr(t: ""), CsvStr(t: "😀"), CsvStr(t: "")], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == ",\"\",\"😀\",\"\"\r\n"
check xw([], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == "\r\n"
check xw([], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == "\r\n"
check xw([CsvStr(t: ""), CsvNum(t: "1"), CsvStr(t: "b")], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == "\"\",1,\"b\"\r\n"
check xw([CsvNull, CsvStr(t: "\t"), CsvNull], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == ",\"\t\",\r\n"
check xw([], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == "\r\n"
check xw([CsvNull, CsvNum(t: "1e+20"), CsvStr(t: "  ,")], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == ",1e+20,\"  ,\"\r\n"
check xw([], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == "\r\n"
check xw([CsvStr(t: "b,|\t"), CsvStr(t: "x|x"), CsvStr(t: "|"), CsvStr(t: "\n ")], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == "\"b,|\t\",\"x|x\",\"|\",\"\n \"\r\n"
check xw([CsvStr(t: ""), CsvNum(t: "1e+20")], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == "\"\",1e+20\r\n"
check xw([CsvStr(t: "|"), CsvNull, CsvNull, CsvStr(t: "\"|xx")], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == "\"|\",,,\"\"\"|xx\"\r\n"
check xw([], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == "\r\n"
check xw([CsvStr(t: "'b|'"), CsvStr(t: ",")], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == "\"'b|'\",\",\"\r\n"
check xw([CsvNum(t: "0"), CsvStr(t: "é\r")], xdl(",", "\"", "", true, false, false, 4, "\r\n")) == "0,\"é\r\"\r\n"
# seeded random records under QUOTE_NOTNULL
check xw([CsvStr(t: " |é")], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\" |é\"\r\n"
check xw([], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\r\n"
check xw([CsvStr(t: "a"), CsvStr(t: ""), CsvStr(t: "😀 "), CsvStr(t: "\\;a")], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\"a\",\"\",\"😀 \",\"\\;a\"\r\n"
check xw([CsvNull], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "ERR 1 single empty field record must be quoted"
check xw([CsvStr(t: "b"), CsvNull], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\"b\",\r\n"
check xw([CsvStr(t: "\r\t")], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\"\r\t\"\r\n"
check xw([CsvStr(t: "\n\n\nb"), CsvStr(t: "😀"), CsvNum(t: "-7")], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\"\n\n\nb\",\"😀\",\"-7\"\r\n"
check xw([], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\r\n"
check xw([CsvNum(t: "1000000000000"), CsvNull], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\"1000000000000\",\r\n"
check xw([CsvStr(t: "a,"), CsvNull, CsvStr(t: "||")], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\"a,\",,\"||\"\r\n"
check xw([CsvStr(t: ";\\ ,")], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\";\\ ,\"\r\n"
check xw([CsvNum(t: "-0.25"), CsvStr(t: "\t,")], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\"-0.25\",\"\t,\"\r\n"
check xw([CsvNull, CsvStr(t: ",😀b😀")], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == ",\",😀b😀\"\r\n"
check xw([CsvStr(t: "\n 😀"), CsvNum(t: "1e+20")], xdl(",", "\"", "", true, false, false, 5, "\r\n")) == "\"\n 😀\",\"1e+20\"\r\n"
# seeded random records under space delimiter, skipinitialspace
check xw([], xdl(" ", "\"", "", true, true, false, 0, "\r\n")) == "\r\n"
check xw([CsvStr(t: ","), CsvStr(t: "")], xdl(" ", "\"", "", true, true, false, 0, "\r\n")) == ", \"\"\r\n"
check xw([CsvStr(t: ""), CsvStr(t: "\"")], xdl(" ", "\"", "", true, true, false, 0, "\r\n")) == "\"\" \"\"\"\"\r\n"
check xw([CsvStr(t: ","), CsvStr(t: "xbxx")], xdl(" ", "\"", "", true, true, false, 0, "\r\n")) == ", xbxx\r\n"
check xw([], xdl(" ", "\"", "", true, true, false, 0, "\r\n")) == "\r\n"
check xw([CsvStr(t: ""), CsvStr(t: "ax\"é")], xdl(" ", "\"", "", true, true, false, 0, "\r\n")) == "\"\" \"ax\"\"é\"\r\n"
check xw([CsvStr(t: ""), CsvStr(t: "\r ")], xdl(" ", "\"", "", true, true, false, 0, "\r\n")) == "\"\" \"\r \"\r\n"
check xw([CsvStr(t: ""), CsvStr(t: ""), CsvStr(t: "")], xdl(" ", "\"", "", true, true, false, 0, "\r\n")) == "\"\" \"\" \"\"\r\n"
