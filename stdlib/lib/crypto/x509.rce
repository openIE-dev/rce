module crypto.x509

# X.509 certificate structure (RFC 5280), on data.der. Parses the Certificate
# SEQUENCE { tbsCertificate, signatureAlgorithm, signatureValue } and the
# TBSCertificate fields: version, serialNumber, signature OID, validity.
# Pure, total. (Full Name/SPKI/extensions parsing + signature verification and
# the TLS handshake are follow-up built on this.)

use data.der

pub fn x509_parts(b: &[i64]) -> List[List[i64]]
    return der.der_children(b, 0)

fn tbs_child_pos(b: &[i64]) -> List[i64]
    let cp = der.der_children_pos(b, 0)
    let tbs_pos = copy(cp[0]) as usize
    return der.der_children_pos(b, tbs_pos)

fn tbs_index(b: &[i64]) -> usize
    let cp = tbs_child_pos(b)
    let first = der.der_tlv(b, copy(cp[0]) as usize)
    if copy(first[0]) == 160
        return 1
    return 0

pub fn x509_version(b: &[i64]) -> i64
    let cp = tbs_child_pos(b)
    let first_pos = copy(cp[0]) as usize
    let first = der.der_tlv(b, first_pos)
    if copy(first[0]) == 160
        let inner = der.der_children_pos(b, first_pos)
        let v = der.der_tlv(b, copy(inner[0]) as usize)
        return der.der_int(b, &v)
    return 0

pub fn x509_serial(b: &[i64]) -> i64
    let cp = tbs_child_pos(b)
    let idx = tbs_index(b)
    let serial = der.der_tlv(b, copy(cp[idx]) as usize)
    return der.der_int(b, &serial)

pub fn x509_sig_oid(b: &[i64]) -> List[i64]
    let cp = tbs_child_pos(b)
    let idx = tbs_index(b)
    let alg_pos = copy(cp[idx + 1]) as usize
    let fields = der.der_children_pos(b, alg_pos)
    let oid = der.der_tlv(b, copy(fields[0]) as usize)
    return der.der_oid(b, &oid)

pub fn x509_validity(b: &[i64]) -> List[List[i64]]
    let cp = tbs_child_pos(b)
    let idx = tbs_index(b)
    let validity_pos = copy(cp[idx + 3]) as usize
    let times = der.der_children_pos(b, validity_pos)
    var out: List[List[i64]] = []
    var k: usize = 0
    while k < times.len() bound 2
        let t = der.der_tlv(b, copy(times[k]) as usize)
        let cs = copy(t[2]) as usize
        let len = copy(t[1]) as usize
        var bytes: List[i64] = []
        var j: usize = 0
        while j < len bound 64
            bytes.append(copy(b[cs + j]))
            j += 1
        out.append(bytes)
        k += 1
    return out

# ---------------- spectests (real Ed25519 cert, serial 1234, CN=test.example) ----------------

const CERT: List[i64] = [48, 129, 219, 48, 129, 142, 160, 3, 2, 1, 2, 2, 2, 4, 210, 48, 5, 6, 3, 43, 101, 112, 48, 23, 49, 21, 48, 19, 6, 3, 85, 4, 3, 12, 12, 116, 101, 115, 116, 46, 101, 120, 97, 109, 112, 108, 101, 48, 30, 23, 13, 50, 52, 48, 49, 48, 49, 48, 48, 48, 48, 48, 48, 90, 23, 13, 51, 48, 48, 49, 48, 49, 48, 48, 48, 48, 48, 48, 90, 48, 23, 49, 21, 48, 19, 6, 3, 85, 4, 3, 12, 12, 116, 101, 115, 116, 46, 101, 120, 97, 109, 112, 108, 101, 48, 42, 48, 5, 6, 3, 43, 101, 112, 3, 33, 0, 122, 233, 244, 113, 203, 232, 64, 206, 91, 133, 71, 155, 0, 55, 78, 94, 160, 182, 204, 146, 255, 234, 10, 139, 135, 217, 49, 122, 154, 35, 19, 150, 48, 5, 6, 3, 43, 101, 112, 3, 65, 0, 51, 205, 43, 75, 173, 128, 127, 82, 147, 254, 231, 1, 189, 5, 230, 154, 157, 92, 184, 104, 142, 178, 181, 41, 164, 219, 225, 67, 135, 151, 34, 193, 213, 228, 50, 183, 60, 8, 88, 217, 97, 28, 59, 155, 112, 193, 161, 133, 154, 61, 17, 199, 239, 58, 81, 190, 86, 236, 17, 28, 247, 112, 86, 3]

const PARTS: List[List[i64]] = x509_parts(&CERT)
const OID: List[i64] = x509_sig_oid(&CERT)
const VAL: List[List[i64]] = x509_validity(&CERT)

check PARTS.len() == 3
check x509_version(&CERT) == 2
check x509_serial(&CERT) == 1234
check OID == [1, 3, 101, 112]
check VAL.len() == 2