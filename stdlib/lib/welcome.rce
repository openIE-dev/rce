module welcome

use crypto
use hpke
use mls
use treekem

# Joining an MLS group from a Welcome (RFC 9420 12.4.3.1), suite 1, in pure
# RCE on lib/crypto.rce, lib/hpke.rce, lib/mls.rce and lib/treekem.rce:
# find our EncryptedGroupSecrets by KeyPackageRef, open GroupSecrets with the
# KeyPackage init key, derive the PSK secret (8.4), member and welcome
# secrets, open the GroupInfo, check its confirmation tag, its signature by
# the signer's leaf and the ratchet tree hash against the GroupContext, and
# derive the epoch secret and epoch authenticator.
# Vectors: welcome.json and passive-client-welcome.json (suite 1).

fn mls_body(h: text) -> List[i64] = treekem.slice_i(crypto.unhex(h), 4)

pub fn u64b(x: i64) -> List[i64]
    var o: List[i64] = []
    for i in 0..8
        o.push((x >> (8 * (7 - i))) & 255)
    return o

# GroupSecrets hex + "." + encrypted_group_info hex, or "" when no entry is ours
fn welcome_secrets(welcome: text, kp: text, init_priv: text) -> text
    let w = mls_body(welcome)
    let r = mls.ref_hash("MLS 1.0 KeyPackage Reference", crypto.tohex(mls_body(kp)))
    let sv = treekem.rd_v(copy(w), 2)
    let end = (sv[0] + sv[1]) as usize
    let egi = treekem.get_v(copy(w), end)
    var p = sv[1] as usize
    while p < end bound 4096
        let nm = crypto.tohex(treekem.get_v(copy(w), p))
        p = treekem.skip_v(copy(w), p)
        let ko = crypto.tohex(treekem.get_v(copy(w), p))
        p = treekem.skip_v(copy(w), p)
        let ctext = crypto.tohex(treekem.get_v(copy(w), p))
        p = treekem.skip_v(copy(w), p)
        if nm == r
            return hpke.decrypt_with_label(init_priv, "Welcome", crypto.tohex(copy(egi)), ko, ctext) + "." + crypto.tohex(egi)
    return ""

# PSK secret (8.4) from the GroupSecrets psks and external PSKs "id:psk,..."
fn psk_secret(gs: List[i64], p0: usize, psks: text) -> List[i64]
    let lv = treekem.rd_v(copy(gs), p0)
    let end = (lv[0] + lv[1]) as usize
    var ids: List[text] = []
    var p = lv[1] as usize
    while p < end bound 4096
        let s0 = p
        let typ = gs[p]
        p += 1
        if typ == 1
            p = treekem.skip_v(copy(gs), p)
        else
            p = treekem.skip_v(copy(gs), p + 1) + 8
        p = treekem.skip_v(copy(gs), p)
        ids.push(crypto.tohex(crypto.slice(copy(gs), s0, p)))
    var ps = mls.zero32()
    let n = ids.len() as i64
    var i: i64 = 0
    for idh in ids
        let idb = crypto.unhex(copy(idh))
        let pid = crypto.tohex(treekem.get_v(copy(idb), 1))
        var psk: List[i64] = []
        for kv in psks.split(",")
            if kv != ""
                let parts = kv.split(":")
                if copy(parts[0]) == pid
                    psk = crypto.unhex(copy(parts[1]))
        let pin = mls.expand_label(mls.extract(mls.zero32(), psk), "derived psk", crypto.cat(idb, [(i >> 8) & 255, i & 255, (n >> 8) & 255, n & 255]), 32)
        ps = mls.extract(pin, ps)
        i += 1
    return ps

# GroupInfo hex (empty when it does not open) + "." + member secret hex
fn welcome_group_info(gsx: text, egi: text, psks: text) -> text
    let gs = crypto.unhex(gsx)
    let js = treekem.get_v(copy(gs), 0)
    var p = treekem.skip_v(copy(gs), 0)
    let has = gs[p]
    p += 1
    if has == 1
        p = treekem.skip_v(copy(gs), p)
    let mem = mls.extract(js, psk_secret(gs, p, psks))
    let ws = mls.derive_secret(copy(mem), "welcome")
    let key = mls.expand_label(copy(ws), "key", [], 16)
    let nonce = mls.expand_label(ws, "nonce", [], 12)
    let gi = hpke.gcm_open(key, nonce, [], crypto.unhex(egi))
    if gi.len() == 1 and gi[0] == -1
        return "." + crypto.tohex(mem)
    return crypto.tohex(gi) + "." + crypto.tohex(mem)

# offsets in a GroupInfo: [group_context end, confirmation_tag start, signer, signature start]
fn gi_offsets(gi: List[i64]) -> List[i64]
    var p = treekem.skip_v(copy(gi), 4) + 8
    p = treekem.skip_v(copy(gi), p)
    p = treekem.skip_v(copy(gi), p)
    let gce = treekem.skip_v(copy(gi), p)
    let tag = treekem.skip_v(copy(gi), gce)
    let signer = treekem.skip_v(copy(gi), tag)
    return [gce as i64, tag as i64, signer as i64, (signer + 4) as i64]

fn gi_tree_hash(gi: List[i64]) -> text = crypto.tohex(treekem.get_v(copy(gi), treekem.skip_v(copy(gi), 4) + 8))

fn gi_signer(gi: List[i64]) -> i64
    let o = gi_offsets(copy(gi))
    let s = o[2] as usize
    return (gi[s] << 24) | (gi[s + 1] << 16) | (gi[s + 2] << 8) | gi[s + 3]

# the ratchet_tree extension (type 2) of the GroupInfo, as rt_decode input; "" if absent
fn gi_ratchet_tree(gi: List[i64]) -> text
    let o = gi_offsets(copy(gi))
    let ev = treekem.rd_v(copy(gi), o[0] as usize)
    let end = (ev[0] + ev[1]) as usize
    var p = ev[1] as usize
    while p < end bound 4096
        let typ = (gi[p] << 8) | gi[p + 1]
        let d = treekem.rd_v(copy(gi), p + 2)
        if typ == 2
            return crypto.tohex(crypto.slice(copy(gi), d[1] as usize, (d[0] + d[1]) as usize))
        p = (d[0] + d[1]) as usize
    return ""

fn gi_signature_ok(gi: List[i64], signer_pub: text) -> bool
    let o = gi_offsets(copy(gi))
    let tbs = crypto.tohex(crypto.slice(copy(gi), 0, o[3] as usize))
    return mls.verify_with_label(signer_pub, "GroupInfoTBS", tbs, crypto.tohex(treekem.get_v(gi, o[3] as usize)))

# epoch secret hex + "." + confirmation tag ok
fn welcome_epoch(gi: List[i64], mem: text) -> text
    let o = gi_offsets(copy(gi))
    let gc = crypto.slice(copy(gi), 0, o[0] as usize)
    let cth = treekem.get_v(copy(gi), treekem.skip_v(copy(gi), treekem.skip_v(copy(gi), 4) + 8))
    let es = mls.expand_label(crypto.unhex(mem), "epoch", gc, 32)
    let tag = treekem.get_v(gi, o[1] as usize)
    let ok = crypto.hmac(mls.derive_secret(copy(es), "confirm"), cth) == tag
    return crypto.tohex(es) + "." + ok.tostr()

# the signature key of the leaf at index i of a decoded tree
pub fn leaf_sig_key(nodes: List[text], i: i64) -> text
    let b = treekem.slice_i(crypto.unhex(copy(nodes[(2 * i) as usize])), 1)
    return crypto.tohex(treekem.get_v(copy(b), treekem.skip_v(b, 0)))
