module col.func

# Functional combinators (universal-core gap): the composition layer over
# lists. RCE is total/bounded with no first-class closures, so each combinator
# takes a small kind tag selecting the operation (a defunctionalized closure).
# map/filter/fold/reduce/zip/find/any/all/count/flat_concat. With recursion +
# arithmetic + cons these make the list basis a universal computational algebra.

pub kind Op
    Add
    Mul
    Sub
    Max
    Min
    EqZero
    GtZero
    LtZero
    Even
    Odd
    Pos
    Neg
    Abs
    Not

fn apply1(op: &Op, x: i64) -> i64
    match op
        Add -> x
        Mul -> x
        Sub -> 0 - x
        Max -> x
        Min -> x
        EqZero -> if x == 0 then 1 else 0
        GtZero -> if x > 0 then 1 else 0
        LtZero -> if x < 0 then 1 else 0
        Even -> if x % 2 == 0 then 1 else 0
        Odd -> if x % 2 != 0 then 1 else 0
        Pos -> if x > 0 then x else 0
        Neg -> if x < 0 then x else 0
        Abs -> if x < 0 then 0 - x else x
        Not -> if x == 0 then 1 else 0

fn apply2(op: &Op, a: i64, b: i64) -> i64
    match op
        Add -> a + b
        Mul -> a * b
        Sub -> a - b
        Max -> if a > b then a else b
        Min -> if a < b then a else b
        EqZero -> if a == b then 1 else 0
        GtZero -> if a > b then 1 else 0
        LtZero -> if a < b then 1 else 0
        Even -> a
        Odd -> a
        Pos -> a
        Neg -> a
        Abs -> a
        Not -> a

pub fn map(xs: &[i64], op: &Op) -> List[i64]
    var out: List[i64] = []
    for x in xs
        out.append(apply1(op, x))
    return out

pub fn filter(xs: &[i64], op: &Op) -> List[i64]
    var out: List[i64] = []
    for x in xs
        if apply1(op, x) != 0
            out.append(x)
    return out

pub fn fold(xs: &[i64], init: i64, op: &Op) -> i64
    var acc = init
    for x in xs
        acc = apply2(op, acc, x)
    return acc

pub fn reduce(xs: &[i64], op: &Op) -> i64
    if xs.len() == 0
        return 0
    var acc = copy(xs[0])
    var i: usize = 1
    while i < xs.len() bound 67108864
        acc = apply2(op, acc, copy(xs[i]))
        i += 1
    return acc

pub fn zip_add(a: &[i64], b: &[i64]) -> List[i64]
    var out: List[i64] = []
    let n = if a.len() < b.len() then a.len() else b.len()
    var i: usize = 0
    while i < n bound 67108864
        out.append(copy(a[i]) + copy(b[i]))
        i += 1
    return out

pub fn find(xs: &[i64], op: &Op) -> i64
    var i: usize = 0
    while i < xs.len() bound 67108864
        if apply1(op, copy(xs[i])) != 0
            return i as i64
        i += 1
    return 0 - 1

pub fn any(xs: &[i64], op: &Op) -> bool
    for x in xs
        if apply1(op, x) != 0
            return true
    return false

pub fn all(xs: &[i64], op: &Op) -> bool
    for x in xs
        if apply1(op, x) == 0
            return false
    return true

pub fn count(xs: &[i64], op: &Op) -> i64
    var n: i64 = 0
    for x in xs
        if apply1(op, x) != 0
            n += 1
    return n

pub fn reverse(xs: &[i64]) -> List[i64]
    var out: List[i64] = []
    var i: usize = xs.len()
    while i > 0 bound 67108864
        i -= 1
        out.append(copy(xs[i]))
    return out

# ---------------- spectests ----------------

const XS: List[i64] = [1, 2, 3, 4, 5]
const YS: List[i64] = [10, 20, 30, 40, 50]
const EMPTY: List[i64] = []
const MIX: List[i64] = [0 - 3, 0 - 1, 0, 2, 4]

const OP_ADD: Op = Add
const OP_MUL: Op = Mul
const OP_EVEN: Op = Even
const OP_GTZERO: Op = GtZero
const OP_POS: Op = Pos
const OP_ABS: Op = Abs

const MAPPED: List[i64] = map(&MIX, &OP_ABS)
const FILTERED: List[i64] = filter(&MIX, &OP_GTZERO)
const FOLDED: i64 = fold(&XS, 0, &OP_ADD)
const REDUCED: i64 = reduce(&XS, &OP_MUL)
const ZIPPED: List[i64] = zip_add(&XS, &YS)
const REVERSED: List[i64] = reverse(&XS)

check MAPPED == [3, 1, 0, 2, 4]
check FILTERED == [2, 4]
check FOLDED == 15
check REDUCED == 120
check ZIPPED == [11, 22, 33, 44, 55]
check REVERSED == [5, 4, 3, 2, 1]
check find(&XS, &OP_EVEN) == 1
check find(&XS, &OP_GTZERO) == 0
check any(&MIX, &OP_GTZERO) == true
check all(&XS, &OP_GTZERO) == true
check all(&MIX, &OP_GTZERO) == false
check count(&MIX, &OP_EVEN) == 3
check fold(&EMPTY, 7, &OP_ADD) == 7
check reduce(&EMPTY, &OP_ADD) == 0