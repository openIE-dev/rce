module col.parallel

# Concurrency combinators over the language's deterministic `for ... par`
# (disjoint write footprints, W-PAR-1; result equals source order, T16).
# Parallel map writes distinct indices; reduction folds the parallel results.

pub fn par_map_double(xs: &[i64]) -> List[i64]
    var out: List[i64] = [0 for _ in 0..xs.len()]
    for i in 0..xs.len() par
        out[i] = copy(xs[i]) * 2
    return out

pub fn par_map_add(xs: &[i64], ys: &[i64]) -> List[i64]
    var out: List[i64] = [0 for _ in 0..xs.len()]
    for i in 0..xs.len() par
        out[i] = copy(xs[i]) + copy(ys[i])
    return out

pub fn par_sum(xs: &[i64]) -> i64
    let doubled = par_map_double(xs)
    var s: i64 = 0
    for x in doubled
        s = s + x
    return s

# ---------------- spectests ----------------

const XS: List[i64] = [1, 2, 3, 4, 5]
const YS: List[i64] = [10, 20, 30, 40, 50]

const D: List[i64] = par_map_double(&XS)
const A: List[i64] = par_map_add(&XS, &YS)

check D == [2, 4, 6, 8, 10]
check A == [11, 22, 33, 44, 55]
check par_sum(&XS) == 30