module col.search

# Search on sorted lists (universal-core closure): binary_search, lower_bound
# (first index with xs[i] >= target), upper_bound (first index with xs[i] >
# target). Iterative, pure, total, O(log n). The search counterpart to col's
# sort; together they close the ordered-sequence algorithms.

pub fn binary_search(xs: &[i64], target: i64) -> i64
    var lo: usize = 0
    var hi: usize = xs.len()
    while lo < hi bound 67108864
        let mid = lo + (hi - lo) / 2
        let v = copy(xs[mid])
        if v == target
            return mid as i64
        if v < target
            lo = mid + 1
        else
            hi = mid
    return 0 - 1

pub fn lower_bound(xs: &[i64], target: i64) -> i64
    var lo: usize = 0
    var hi: usize = xs.len()
    while lo < hi bound 67108864
        let mid = lo + (hi - lo) / 2
        if copy(xs[mid]) < target
            lo = mid + 1
        else
            hi = mid
    return lo as i64

pub fn upper_bound(xs: &[i64], target: i64) -> i64
    var lo: usize = 0
    var hi: usize = xs.len()
    while lo < hi bound 67108864
        let mid = lo + (hi - lo) / 2
        if copy(xs[mid]) <= target
            lo = mid + 1
        else
            hi = mid
    return lo as i64

# ---------------- spectests ----------------

const XS: List[i64] = [1, 3, 5, 7, 9, 11]
const EMPTY: List[i64] = []
const DUP: List[i64] = [2, 2, 2, 5, 5, 8]

check binary_search(&XS, 5) == 2
check binary_search(&XS, 1) == 0
check binary_search(&XS, 11) == 5
check binary_search(&XS, 4) == -1
check binary_search(&EMPTY, 1) == -1
check lower_bound(&XS, 5) == 2
check lower_bound(&XS, 4) == 2
check lower_bound(&XS, 12) == 6
check lower_bound(&XS, 0) == 0
check upper_bound(&XS, 5) == 3
check upper_bound(&XS, 4) == 2
check upper_bound(&XS, 11) == 6
check lower_bound(&DUP, 2) == 0
check upper_bound(&DUP, 2) == 3
check lower_bound(&DUP, 5) == 3
check upper_bound(&DUP, 5) == 5