module data.der

# ASN.1 DER (domain-closure gap, X.509/TLS foundation): tag-length-value parsing.
# der_tlv -> [tag, len, content_start, next_pos]; der_children parses a
# constructed value's children; der_int decodes a positive INTEGER content.
# Short and long form lengths. Pure, total. (OID decode, full X.509 cert
# structure and the TLS handshake are follow-up built on this.)

pub fn der_tlv(b: &[i64], pos: usize) -> List[i64]
    let tag = copy(b[pos])
    var p = pos + 1
    let l0 = copy(b[p])
    p += 1
    var len: i64 = 0
    if l0 < 128
        len = l0
    else
        let n = (l0 & 127) as usize
        var k: usize = 0
        while k < n bound 8
            len = len * 256 + copy(b[p])
            p += 1
            k += 1
    let cs = p
    let next = p + len as usize
    return [tag, len, cs as i64, next as i64]

pub fn der_children(b: &[i64], pos: usize) -> List[List[i64]]
    let outer = der_tlv(b, pos)
    var cur = copy(outer[2]) as usize
    let end = copy(outer[3]) as usize
    var out: List[List[i64]] = []
    while cur < end bound 67108864
        let tlv = der_tlv(b, cur)
        cur = copy(tlv[3]) as usize
        out.append(tlv)
    return out

# Start positions of a constructed value's children (for navigation).
pub fn der_children_pos(b: &[i64], pos: usize) -> List[i64]
    let outer = der_tlv(b, pos)
    var cur = copy(outer[2]) as usize
    let end = copy(outer[3]) as usize
    var out: List[i64] = []
    while cur < end bound 67108864
        out.append(cur as i64)
        let tlv = der_tlv(b, cur)
        cur = copy(tlv[3]) as usize
    return out

pub fn der_int(b: &[i64], tlv: &List[i64]) -> i64
    let cs = copy(tlv[2]) as usize
    let len = copy(tlv[1]) as usize
    var v: i64 = 0
    var k: usize = 0
    while k < len bound 8
        v = v * 256 + copy(b[cs + k])
        k += 1
    return v

# Decode an OBJECT IDENTIFIER content into its arc components (first byte packs
# 40*a + b; subsequent arcs are base-128, high bit = continuation).
pub fn der_oid(b: &[i64], tlv: &List[i64]) -> List[i64]
    let cs = copy(tlv[2]) as usize
    let len = copy(tlv[1]) as usize
    var out: List[i64] = []
    if len == 0
        return out
    let first = copy(b[cs])
    out.append(first / 40)
    out.append(first % 40)
    var v: i64 = 0
    var k: usize = 1
    while k < len bound 64
        let byte = copy(b[cs + k])
        if v <= 922337203685477580
            v = v * 128 + (byte & 127)
        if (byte & 128) == 0
            out.append(v)
            v = 0
        k += 1
    return out

# ---------------- spectests ----------------

const INT5: List[i64] = [2, 1, 5]
const SEQ: List[i64] = [48, 6, 2, 1, 1, 2, 1, 2]
const OCT: List[i64] = [4, 3, 97, 98, 99]
const NUL: List[i64] = [5, 0]

const T_INT: List[i64] = der_tlv(&INT5, 0)
const T_SEQ: List[i64] = der_tlv(&SEQ, 0)
const T_OCT: List[i64] = der_tlv(&OCT, 0)
const T_NUL: List[i64] = der_tlv(&NUL, 0)
const CH: List[List[i64]] = der_children(&SEQ, 0)
const C0: List[i64] = copy(CH[0])
const C1: List[i64] = copy(CH[1])

check T_INT == [2, 1, 2, 3]
check der_int(&INT5, &T_INT) == 5
check T_SEQ == [48, 6, 2, 8]
check T_OCT == [4, 3, 2, 5]
check T_NUL == [5, 0, 2, 2]
check CH.len() == 2
check der_int(&SEQ, &C0) == 1
check der_int(&SEQ, &C1) == 2

const OID_CN: List[i64] = [6, 3, 85, 4, 3]
const T_OID: List[i64] = der_tlv(&OID_CN, 0)
const ARC: List[i64] = der_oid(&OID_CN, &T_OID)
check ARC == [2, 5, 4, 3]