module data.yaml

# YAML serialization (domain-closure gap), mapping subset: parse "key: value"
# lines into [key, value] pairs; strip comments (#), blank lines; unquote
# double-quoted values; document marker "---" ignored. Pure, total. (Full YAML —
# sequences, nesting, anchors, multiline scalars — is follow-up.)

fn unquote(v: &text) -> text
    let c = v.chars()
    if c.len() >= 2
        let first = copy(c[0])
        let last = copy(c[c.len() - 1])
        if first == "\""
            if last == "\""
                var out: text = ""
                var i: usize = 1
                while i + 1 < c.len() bound 67108864
                    out = out + copy(c[i])
                    i += 1
                return out
    return copy(v)

fn parse_line(l: &text) -> List[text]
    let line = l.strip()
    if line.len_chars() == 0
        return []
    let cs = line.chars()
    let c0 = copy(cs[0])
    if c0 == "#"
        return []
    if line == "---"
        return []
    let parts = line.split(": ")
    if parts.len() < 2
        return []
    let k = copy(parts[0]).strip()
    let vraw = copy(parts[1]).strip()
    let v = unquote(&vraw)
    return [k, v]

pub fn yaml_parse(doc: &text) -> List[List[text]]
    var out: List[List[text]] = []
    for line in doc.split("\n")
        let pair = parse_line(&line)
        if pair.len() == 2
            out.append(pair)
    return out

# Parse a YAML block sequence ("- item" lines) into a list of scalar values.
pub fn yaml_parse_seq(doc: &text) -> List[text]
    var out: List[text] = []
    for line in doc.split("\n")
        let l = line.strip()
        if l.len_chars() == 0
            pass
        else
            let cs = l.chars()
            if copy(cs[0]) == "#"
                pass
            else
                if copy(cs[0]) == "-"
                    let parts = l.split("- ")
                    if parts.len() >= 2
                        let v = copy(parts[1]).strip()
                        out.append(unquote(&v))
                    else
                        out.append("")
    return out

# ---------------- spectests ----------------

const DOC: text = "---\nname: hello\ncount: 42\n# comment\nenabled: true\nquoted: \"hello world\""
const PARSED: List[List[text]] = yaml_parse(&DOC)

const E0: List[text] = ["name", "hello"]
const E1: List[text] = ["count", "42"]
const E2: List[text] = ["enabled", "true"]
const E3: List[text] = ["quoted", "hello world"]
const EXPECT: List[List[text]] = [E0, E1, E2, E3]

const EMPTY_DOC: text = ""
const ONLY_COMMENT: text = "# nothing\n---"

check PARSED == EXPECT
check PARSED.len() == 4
check yaml_parse(&EMPTY_DOC).len() == 0
check yaml_parse(&ONLY_COMMENT).len() == 0

const SEQ_DOC: text = "- alpha\n- beta\n- \"gamma delta\"\n# comment\n-"
const SEQ: List[text] = yaml_parse_seq(&SEQ_DOC)
check SEQ == ["alpha", "beta", "gamma delta", ""]
check yaml_parse_seq(&EMPTY_DOC).len() == 0