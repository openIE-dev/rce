module text.ops

# Text operation closure (gap): find/replace/starts_with/ends_with/count/reverse.
# split/contains/strip/join/upper/lower are built-in; these complete the set.
# Pure, total, bounded; operates over .chars().

pub fn text_find(s: &text, sub: &text) -> i64
    let a = s.chars()
    let b = sub.chars()
    if b.len() == 0
        return 0
    if b.len() > a.len()
        return 0 - 1
    var i: usize = 0
    while i + b.len() <= a.len() bound 67108864
        var ok: bool = true
        var j: usize = 0
        while j < b.len() bound 67108864
            if copy(a[i + j]) != copy(b[j])
                ok = false
            j += 1
        if ok
            return i as i64
        i += 1
    return 0 - 1

pub fn text_starts_with(s: &text, prefix: &text) -> bool
    let a = s.chars()
    let b = prefix.chars()
    if b.len() > a.len()
        return false
    var j: usize = 0
    while j < b.len() bound 67108864
        if copy(a[j]) != copy(b[j])
            return false
        j += 1
    return true

pub fn text_ends_with(s: &text, suffix: &text) -> bool
    let a = s.chars()
    let b = suffix.chars()
    if b.len() > a.len()
        return false
    let off = a.len() - b.len()
    var j: usize = 0
    while j < b.len() bound 67108864
        if copy(a[off + j]) != copy(b[j])
            return false
        j += 1
    return true

pub fn text_replace(s: &text, src: &text, dst: &text) -> text
    let a = s.chars()
    let f = src.chars()
    var out: text = ""
    if f.len() == 0
        return copy(s)
    var i: usize = 0
    while i < a.len() bound 67108864
        var hit: bool = false
        if i + f.len() <= a.len()
            hit = true
            var j: usize = 0
            while j < f.len() bound 67108864
                if copy(a[i + j]) != copy(f[j])
                    hit = false
                j += 1
        if hit
            out = out + dst
            i += f.len()
        else
            out = out + copy(a[i])
            i += 1
    return out

pub fn text_count(s: &text, sub: &text) -> i64
    let a = s.chars()
    let b = sub.chars()
    if b.len() == 0
        return 0
    var n: i64 = 0
    var i: usize = 0
    while i + b.len() <= a.len() bound 67108864
        var ok: bool = true
        var j: usize = 0
        while j < b.len() bound 67108864
            if copy(a[i + j]) != copy(b[j])
                ok = false
            j += 1
        if ok
            n += 1
            i += b.len()
        else
            i += 1
    return n

pub fn text_reverse(s: &text) -> text
    let a = s.chars()
    var out: text = ""
    var i: usize = a.len()
    while i > 0 bound 67108864
        i -= 1
        out = out + copy(a[i])
    return out

# ---------------- spectests ----------------

const HW: text = "hello world"
const HELLO: text = "hello"
const ABC: text = "abc"
const DASH: text = "a-b-c"
const AAA: text = "aaa"
const ABAB: text = "ababab"
const EMPTY: text = ""
const WORLD: text = "world"
const HE: text = "he"
const LO: text = "lo"
const DASHS: text = "-"
const PLUS: text = "+"
const A: text = "a"
const BB: text = "bb"
const AB: text = "ab"
const X: text = "x"

check text_find(&HW, &WORLD) == 6
check text_find(&HELLO, &X) == -1
check text_find(&HELLO, &EMPTY) == 0
check text_replace(&DASH, &DASHS, &PLUS) == "a+b+c"
check text_replace(&AAA, &A, &BB) == "bbbbbb"
check text_starts_with(&HELLO, &HE) == true
check text_starts_with(&HELLO, &LO) == false
check text_ends_with(&HELLO, &LO) == true
check text_ends_with(&HELLO, &HE) == false
check text_count(&ABAB, &AB) == 3
check text_reverse(&ABC) == "cba"
check text_reverse(&EMPTY) == ""