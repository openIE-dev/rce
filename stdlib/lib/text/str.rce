module text.str

# Everyday string operations that the built-in Text methods (spec 5.15)
# lack, with the meaning of CPython 3.13's str methods on Unicode 15.1.0,
# the version of its unicodedata module. Pure; the same input gives the
# same text on every host.
#
# Positions. A text is indexed by UTF-8 byte (spec 5.1), so the search
# functions take and return byte offsets, which slice the text directly
# (s[i:j]). Every offset they return is a character boundary. The start
# and end of str_find_in, str_rfind_in and str_count_in are adjusted as
# Python adjusts them (a negative value counts from the end, values are
# clamped), in bytes. str_slice, str_slice_step and str_char_at take
# character indices, as Python's s[i] and s[a:b:c] do, and
# str_char_offset and str_char_index convert between the two.
#
# Search. str_find, str_rfind, str_count, str_replace and the split
# functions run the built-in split (the linear class of C.6.4) over
# windows of at most STR_WIN bytes of match starts, so a call costs a few
# fuel ticks per window whatever the size of the text, and no list passes
# the size limit. StrFinder is a Knuth-Morris-Pratt automaton written
# here: linear in the haystack plus the needle by construction, with
# overlapping matches and a resumable scan (StrScan) over the chunks of a
# stream of any length.
#
# Characters. Case mapping (str_upper, str_lower with the final sigma
# rule, str_title, str_capitalize, str_swapcase, str_casefold) and the
# predicates str_isalpha ... str_isidentifier follow CPython exactly,
# from tables that scripts/gen/str_data.py derives from the Unicode
# 15.1.0 files. The built-in upper, lower, isalpha, isdigit and isspace
# stay ASCII (spec 6.3 N7).
#
# Word case. str_words splits a text into words as change-case 5.4.4
# does: letters and ASCII digits make words, everything else separates
# them, and a word also ends between a lowercase letter or ASCII digit
# and an uppercase letter, and before the last capital of a run of
# capitals that a lowercase letter follows. str_camel, str_pascal,
# str_snake, str_kebab, str_constant and str_capital join the words as
# change-case's camelCase, pascalCase, snakeCase, kebabCase, constantCase
# and capitalCase do, except that the first letter of a word is a whole
# code point (change-case takes a UTF-16 unit, so it leaves a word that
# starts with a letter above U+FFFF as it is).
#
# str_slugify is Django 5.2's slugify with allow_unicode=False: NFKD,
# then ASCII only, lowercase, other than letters, digits, "_", "-" and
# spaces removed, each run of hyphens and spaces made one hyphen, and
# hyphens and underscores stripped from both ends.
#
# Limits. A text holds at most STR_LIMIT characters (spec 6.3 N9). A
# function whose result could be longer returns BadStr("too large", n),
# n being the length the result would have; such input never traps. The
# split functions make at most STR_LIMIT - 1 splits (the last piece
# holds the rest of the text). StrBuf collects text beyond that size and
# hands it out as chunks of at most STR_LIMIT characters.
#
# Fuel. The search, split, replace, slicing, partition and padding
# functions cost a few fuel ticks per window, per piece or per tab,
# whatever the length of the text. str_upper, str_lower, str_casefold,
# str_capitalize, str_slugify and the predicates other than str_istitle
# look each distinct character up once and replace it throughout with the
# built-in split and join, so their fuel grows with the number of
# distinct characters (and, for str_lower, of capital sigmas). str_title,
# str_swapcase, str_istitle, str_words, the word-case functions, the strip
# functions on what they strip, and str_splitlines on text with line ends
# other than \n and \r\n read character by character, at about 50 to 100
# ticks each, so one input's fuel covers a few hundred thousand
# characters of them. For more, apply them to consecutive chunks: a
# chunk that starts after a space (after a line end, for
# str_splitlines) sees the same neighbouring characters (the final sigma
# rule, the previous cased letter, word boundaries) as in the whole text.

pub const STR_LIMIT: i64 = 1000000
const STR_WIN: i64 = 999000

# The error of this module. why is "too large" (n: the length in
# characters the result would have, above STR_LIMIT), "fill" (n: the
# length of a fill text that is not one character), "step" (a zero slice
# step; n = 0) or "code point" (n: a value that is not a Unicode scalar
# value).
error BadStr(why: text, n: i64)

fn sx_too_large(n: i64) -> BadStr = BadStr(why: "too large", n: n)

# ---------------- characters and boundaries ----------------

# Byte length of the UTF-8 sequence led by byte b.
fn sx_len(b: i64) -> i64 = if b < 128 then 1 else (if b < 224 then 2 else (if b < 240 then 3 else 4))

# Code point of the character that starts at byte i of s.
fn sx_cp(s: &text, i: usize) -> i64
    let b = s[i] as i64
    if b < 128
        return b
    if b < 224
        return ((b & 31) << 6) | ((s[i + 1] as i64) & 63)
    if b < 240
        return ((b & 15) << 12) | (((s[i + 1] as i64) & 63) << 6) | ((s[i + 2] as i64) & 63)
    return ((b & 7) << 18) | (((s[i + 1] as i64) & 63) << 12) | (((s[i + 2] as i64) & 63) << 6) | ((s[i + 3] as i64) & 63)

# Start of the character that ends at byte j (0 < j <= len) of s.
fn sx_back(s: &text, j: usize) -> usize
    var p = j - 1
    while p > 0 and ((s[p] as i64) & 192) == 128 bound 4
        p -= 1
    return p

# The text of the Unicode scalar value c.
fn sx_chr(c: i64) -> text
    if c < 128
        return [c].utf8()
    if c < 2048
        return [192 | (c >> 6), 128 | (c & 63)].utf8()
    if c < 65536
        return [224 | (c >> 12), 128 | ((c >> 6) & 63), 128 | (c & 63)].utf8()
    return [240 | (c >> 18), 128 | ((c >> 12) & 63), 128 | ((c >> 6) & 63), 128 | (c & 63)].utf8()

# The character of w bytes at byte i of s, as a text.
fn sx_char(s: &text, i: usize, w: usize) -> text
    if w == 1
        return [s[i] as i64].utf8()
    if w == 2
        return [s[i] as i64, s[i + 1] as i64].utf8()
    if w == 3
        return [s[i] as i64, s[i + 1] as i64, s[i + 2] as i64].utf8()
    return [s[i] as i64, s[i + 1] as i64, s[i + 2] as i64, s[i + 3] as i64].utf8()

fn sx_scalar(c: i64) -> bool = c >= 0 and c <= 1114111 and (c < 55296 or c > 57343)

# Python's chr: the one-character text of a Unicode scalar value.
pub fn str_chr(c: i64) -> text ! BadStr
    if not sx_scalar(c)
        fail BadStr(why: "code point", n: c)
    return sx_chr(c)

# Python's ord of the first character of s, or -1 for the empty text.
pub fn str_ord(s: &text) -> i64 = if s.len_bytes() == 0 then -1 else sx_cp(s, 0)

# The first character boundary at or after byte p, p clamped to 0..len.
fn sx_up(s: &text, p: i64) -> i64
    let n = s.len_bytes() as i64
    if p <= 0
        return 0
    if p >= n
        return n
    var q = p
    while q < n and ((s[q as usize] as i64) & 192) == 128 bound 4
        q += 1
    return q

# The last character boundary at or before byte p, p clamped to 0..len.
fn sx_down(s: &text, p: i64) -> i64
    let n = s.len_bytes() as i64
    if p <= 0
        return 0
    if p >= n
        return n
    var q = p
    while q > 0 and ((s[q as usize] as i64) & 192) == 128 bound 4
        q -= 1
    return q

# s[a:b] (boundaries); the whole text is not copied byte by byte.
fn sx_sub(s: &text, a: i64, b: i64) -> text = if a == 0 and b == (s.len_bytes() as i64) then copy(s) else s[a as usize:b as usize]

# Python's ADJUST_INDICES on a length n: end clamped to 0..n with a
# negative value counted from the end; start made non-negative the same
# way and left above n when it is.
fn sx_adj_end(e: i64, n: i64) -> i64 = if e > n then n else (if e < 0 then (e + n).max(0) else e)

fn sx_adj_start(st: i64, n: i64) -> i64 = if st < 0 then (st + n).max(0) else st

fn sx_ascii(s: &text) -> bool = s.len_bytes() == s.len_chars()

# Byte offset of the character with index k (0 <= k <= len_chars), or -1.
pub fn str_char_offset(s: &text, k: i64) -> i64
    let nc = s.len_chars() as i64
    if k < 0 or k > nc
        return -1
    if sx_ascii(s) or k == 0
        return k
    if k == nc
        return s.len_bytes() as i64
    let cs = s.chars()
    return "".join(cs[0:k as usize]).len_bytes() as i64

# Index of the character that holds byte p (p clamped to 0..len_bytes;
# len_chars for p at the end).
pub fn str_char_index(s: &text, p: i64) -> i64
    let q = sx_down(s, p)
    if sx_ascii(s) or q == 0
        return q
    return sx_sub(s, 0, q).len_chars() as i64

# ---------------- search ----------------

# First match of sub (not empty) in s[a:b] (a, b boundaries), or -1.
fn sx_first(s: &text, sub: &text, a: i64, b: i64) -> i64
    let m = sub.len_bytes() as i64
    var w = a
    while w + m <= b bound 64
        let wn = sx_up(s, w + STR_WIN).min(b)
        let re = sx_down(s, (wn + m - 1).min(b))
        let ps = sx_sub(s, w, re).split(copy(sub))
        if ps.len() > 1
            return w + (ps[0].len_bytes() as i64)
        w = wn
    return -1

# Start of the last match of sub (not empty) in s[a:b], or -1.
fn sx_last(s: &text, sub: &text, a: i64, b: i64) -> i64
    let m = sub.len_bytes() as i64
    let rsub = sub.reverse()
    var e = b
    while e - m >= a bound 64
        let en = sx_down(s, e - STR_WIN).max(a)
        let rs = sx_up(s, (en - m + 1).max(a))
        let ps = sx_sub(s, rs, e).reverse().split(copy(rsub))
        if ps.len() > 1
            return e - (ps[0].len_bytes() as i64) - m
        e = en
    return -1

# Number of non-overlapping matches of sub (not empty) in s[a:b], leftmost
# first, as Python counts them.
fn sx_count(s: &text, sub: &text, a: i64, b: i64) -> i64
    let m = sub.len_bytes() as i64
    var c: i64 = 0
    var pos = a
    var w = a
    while w + m <= b bound 64
        let wn = sx_up(s, w + STR_WIN).min(b)
        let re = sx_down(s, (wn + m - 1).min(b))
        if pos < re
            let ps = sx_sub(s, pos, re).split(copy(sub))
            let k = ps.len() - 1
            c += k as i64
            if k > 0
                pos = re - (ps[k].len_bytes() as i64)
        pos = pos.max(wn)
        w = wn
    return c

# Starts of the first lim (all when lim < 0) non-overlapping matches of
# sub (not empty) in s[a:b], leftmost first.
fn sx_starts(s: &text, sub: &text, a: i64, b: i64, lim: i64) -> List[i64]
    let m = sub.len_bytes() as i64
    var out: List[i64] = []
    if lim == 0
        return out
    var pos = a
    var w = a
    while w + m <= b bound 64
        let wn = sx_up(s, w + STR_WIN).min(b)
        let re = sx_down(s, (wn + m - 1).min(b))
        if pos < re
            let ps = sx_sub(s, pos, re).split(copy(sub))
            var off = pos
            var k: usize = 0
            while k + 1 < ps.len() bound 1000000
                off += ps[k].len_bytes() as i64
                out.push(off)
                if lim > 0 and (out.len() as i64) >= lim
                    return out
                off += m
                k += 1
            if k > 0
                pos = off
        pos = pos.max(wn)
        w = wn
    return out

# Every piece of s cut at each match of sep (not empty), leftmost first,
# as consecutive lists of fewer than STR_LIMIT pieces each.
fn sx_split_chunks(s: &text, sep: &text) -> List[List[text]]
    let n = s.len_bytes() as i64
    let m = sep.len_bytes() as i64
    var out: List[List[text]] = []
    var a: i64 = 0
    while a <= n bound 64
        if sx_count(s, sep, a, n) < STR_LIMIT - 1
            out.push(sx_sub(s, a, n).split(copy(sep)))
            return out
        let st = sx_starts(s, sep, a, n, STR_LIMIT - 2)
        let e = st[st.len() - 1] + m
        var ps = sx_sub(s, a, e).split(copy(sep))
        let _ = ps.pop()
        out.push(ps)
        a = e
    return out

# Python's s.find(sub): byte offset of the first match, or -1.
pub fn str_find(s: &text, sub: &text) -> i64 = str_find_in(s, sub, 0, s.len_bytes() as i64)

# Python's s.rfind(sub): byte offset of the last match, or -1.
pub fn str_rfind(s: &text, sub: &text) -> i64 = str_rfind_in(s, sub, 0, s.len_bytes() as i64)

# Python's s.count(sub): non-overlapping matches; the empty text matches
# at every character boundary.
pub fn str_count(s: &text, sub: &text) -> i64 = str_count_in(s, sub, 0, s.len_bytes() as i64)

# Python's s.find(sub, start, end) in bytes: the first match lying in
# s[start:end]. An empty sub matches at the first character boundary at
# or after start, when that is at most end.
pub fn str_find_in(s: &text, sub: &text, start: i64, end: i64) -> i64
    let n = s.len_bytes() as i64
    let e = sx_adj_end(end, n)
    let st = sx_adj_start(start, n)
    let m = sub.len_bytes() as i64
    if e - st < m
        return -1
    let a = sx_up(s, st)
    if m == 0
        return if a <= e then a else -1
    let b = sx_down(s, e)
    if b - a < m
        return -1
    return sx_first(s, sub, a, b)

# Python's s.rfind(sub, start, end) in bytes. An empty sub matches at the
# last character boundary at or before end, when that is at least start.
pub fn str_rfind_in(s: &text, sub: &text, start: i64, end: i64) -> i64
    let n = s.len_bytes() as i64
    let e = sx_adj_end(end, n)
    let st = sx_adj_start(start, n)
    let m = sub.len_bytes() as i64
    if e - st < m
        return -1
    let b = sx_down(s, e)
    if m == 0
        return if b >= st then b else -1
    let a = sx_up(s, st)
    if b - a < m
        return -1
    return sx_last(s, sub, a, b)

# Python's s.count(sub, start, end) in bytes. An empty sub counts the
# character boundaries in start..end.
pub fn str_count_in(s: &text, sub: &text, start: i64, end: i64) -> i64
    let n = s.len_bytes() as i64
    let e = sx_adj_end(end, n)
    let st = sx_adj_start(start, n)
    let m = sub.len_bytes() as i64
    if e - st < m
        return 0
    let a = sx_up(s, st)
    let b = sx_down(s, e)
    if m == 0
        return if a > b then 0 else (sx_sub(s, a, b).len_chars() as i64) + 1
    if b - a < m
        return 0
    return sx_count(s, sub, a, b)

# Python's s.removeprefix(p) and s.removesuffix(p).
pub fn str_removeprefix(s: &text, p: &text) -> text = if p.len_bytes() > 0 and s.startswith(copy(p)) then s[p.len_bytes():] else copy(s)

pub fn str_removesuffix(s: &text, p: &text) -> text = if p.len_bytes() > 0 and s.endswith(copy(p)) then s[0:s.len_bytes() - p.len_bytes()] else copy(s)

# ---------------- repeat, replace ----------------

# k copies of t (k >= 0, k * chars(t) within the limit), by doubling.
fn sx_rep(t: &text, k: i64) -> text
    var out = ""
    var p = copy(t)
    var r = k
    while r > 0 bound 64
        if (r & 1) == 1
            out = out + p
        r = r >> 1
        if r > 0
            p = p + p
    return out

# Python's s * n (n <= 0 gives the empty text).
pub fn str_repeat(s: &text, n: i64) -> text ! BadStr
    let c = s.len_chars() as i64
    if n <= 0 or c == 0
        return ""
    if n > STR_LIMIT / c
        fail sx_too_large(if n > 9223372036854775807 / c then 9223372036854775807 else n * c)
    return sx_rep(s, n)

# Python's s.replace(old, new): every non-overlapping match, leftmost
# first; an empty old matches at every character boundary.
pub fn str_replace(s: &text, old: &text, new: &text) -> text ! BadStr = try str_replace_n(s, old, new, -1)

# Python's s.replace(old, new, count): the first count matches (all when
# count < 0).
pub fn str_replace_n(s: &text, old: &text, new: &text, count: i64) -> text ! BadStr
    let n = s.len_bytes() as i64
    let m = old.len_bytes() as i64
    let nc = s.len_chars() as i64
    let newc = new.len_chars() as i64
    let dc = newc - (old.len_chars() as i64)
    if count == 0
        return copy(s)
    if m == 0
        # insertions before the first k characters, and at the end when k > nc
        let k = if count < 0 or count > nc + 1 then nc + 1 else count
        if newc == 0
            return copy(s)
        let size = nc + k * newc
        if size > STR_LIMIT
            fail sx_too_large(size)
        let p = str_char_offset(s, k - 1)
        let ps = sx_sub(s, 0, p).split("")
        return new.join(ps) + s[p as usize:]
    let total = sx_count(s, old, 0, n)
    let size = nc + (if count < 0 then total else count.min(total)) * dc
    if size > STR_LIMIT
        fail sx_too_large(size)
    var chunks: List[text] = []
    var left = count
    var pos: i64 = 0
    var w: i64 = 0
    while w + m <= n and left != 0 bound 64
        let wn = sx_up(s, w + STR_WIN).min(n)
        let re = sx_down(s, (wn + m - 1).min(n))
        if pos < re
            let reg = sx_sub(s, pos, re)
            let ps = reg.split(copy(old))
            var k = (ps.len() as i64) - 1
            var last = re - (ps[k as usize].len_bytes() as i64)
            if left > 0 and k > left
                # stop after the first left matches of this window
                last = pos
                for j in 0..(left as usize)
                    last += (ps[j].len_bytes() as i64) + m
                k = left
            if k > 0
                let head = if last == re then reg else sx_sub(s, pos, last)
                chunks.push(new.join(head.split(copy(old))))
                pos = last
                if left > 0
                    left -= k
        if left != 0 and pos < wn
            chunks.push(sx_sub(s, pos, wn))
            pos = wn
        w = wn
    chunks.push(sx_sub(s, pos, n))
    return "".join(chunks)

# ---------------- split, partition ----------------

# Python's s.partition(sep): (head, sep, tail) at the first match, or
# (s, "", "") without one. An empty sep matches at offset 0.
pub fn str_partition(s: &text, sep: &text) -> (text, text, text)
    let i = str_find(s, sep)
    if i < 0
        return (copy(s), "", "")
    return (s[0:i as usize], copy(sep), s[(i as usize) + sep.len_bytes():])

# Python's s.rpartition(sep): at the last match, or ("", "", s) without
# one. An empty sep matches at the end.
pub fn str_rpartition(s: &text, sep: &text) -> (text, text, text)
    let i = str_rfind(s, sep)
    if i < 0
        return ("", "", copy(s))
    return (s[0:i as usize], copy(sep), s[(i as usize) + sep.len_bytes():])

# Rust's split_once: the texts before and after the first match of sep,
# or none.
pub fn str_split_once(s: &text, sep: &text) -> (text, text)?
    let i = str_find(s, sep)
    if i < 0
        return none
    return some((s[0:i as usize], s[(i as usize) + sep.len_bytes():]))

# Rust's rsplit_once: around the last match of sep, or none.
pub fn str_rsplit_once(s: &text, sep: &text) -> (text, text)?
    let i = str_rfind(s, sep)
    if i < 0
        return none
    return some((s[0:i as usize], s[(i as usize) + sep.len_bytes():]))

# Python's s.split(sep, maxsplit): at most maxsplit splits (all when
# maxsplit < 0, and never more than STR_LIMIT - 1), leftmost first. An
# empty sep matches at every character boundary, as re.split("", s) does.
pub fn str_splitn(s: &text, sep: &text, maxsplit: i64) -> List[text]
    let n = s.len_bytes() as i64
    let m = sep.len_bytes() as i64
    let lim = if maxsplit < 0 or maxsplit > STR_LIMIT - 1 then STR_LIMIT - 1 else maxsplit
    if lim == 0
        return [copy(s)]
    if m == 0
        let k = lim.min((s.len_chars() as i64) + 1)
        let p = str_char_offset(s, k - 1)
        var ps = sx_sub(s, 0, p).split("")
        let _ = ps.pop()
        ps.push(s[p as usize:])
        return ps
    let c = sx_count(s, sep, 0, n)
    if c < STR_LIMIT - 1
        let ps = s.split(copy(sep))
        if c <= lim
            return ps
        var out: List[text] = copy(ps[0:lim as usize])
        out.push(sep.join(ps[lim as usize:]))
        return out
    let st = sx_starts(s, sep, 0, n, lim)
    let e = st[st.len() - 1] + m
    var ps = sx_sub(s, 0, e).split(copy(sep))
    let _ = ps.pop()
    ps.push(s[e as usize:])
    return ps

# Python's s.rsplit(sep, maxsplit): splits from the right. An empty sep
# matches at every character boundary, the rightmost first.
pub fn str_rsplitn(s: &text, sep: &text, maxsplit: i64) -> List[text]
    let r = s.reverse()
    let rsep = sep.reverse()
    let ps = str_splitn(&r, &rsep, maxsplit)
    var out: List[text] = []
    var i = ps.len()
    while i > 0 bound 1000000
        i -= 1
        out.push(ps[i].reverse())
    return out

# Python's s.splitlines(keepends): lines end at \n, \r, \r\n, \v, \f,
# \x1c, \x1d, \x1e, U+0085, U+2028 and U+2029; a final line end makes no
# empty line.
pub fn str_splitlines(s: &text, keepends: bool) -> List[text]
    let n = s.len_bytes() as i64
    var out: List[text] = []
    if n == 0
        return out
    let nl = "\n"
    let cr = "\r"
    let crlf = "\r\n"
    let other = s.contains("\u{b}") or s.contains("\u{c}") or s.contains("\u{1c}") or s.contains("\u{1d}") or s.contains("\u{1e}") or s.contains("\u{85}") or s.contains("\u{2028}") or s.contains("\u{2029}")
    # only \n and \r\n end lines: split at \n and drop the \r before it
    if not other and sx_count(s, &cr, 0, n) == sx_count(s, &crlf, 0, n) and sx_count(s, &nl, 0, n) < STR_LIMIT - 1
        let ends = s.endswith("\n")
        var ps = s.split("\n")
        if ends
            let _ = ps.pop()
        let last = ps.len() - 1
        let crs = s.contains("\r")
        if not keepends and not crs
            return ps
        for j in 0..ps.len()
            let full = j < last or ends
            if keepends
                out.push(if full then ps[j] + "\n" else copy(ps[j]))
            elif full and ps[j].endswith("\r")
                out.push(ps[j][0:ps[j].len_bytes() - 1])
            else
                out.push(copy(ps[j]))
        return out
    let cs = s.chars()
    let nc = cs.len()
    var start: usize = 0
    var k: usize = 0
    while k < nc bound 1000000
        let ch = copy(cs[k])
        let b = ch[0] as i64
        var w: usize = 0
        if b == 10 or b == 11 or b == 12 or (b >= 28 and b <= 30)
            w = 1
        elif b == 13
            w = if k + 1 < nc and cs[k + 1] == "\n" then 2 else 1
        elif ch == "\u{85}" or ch == "\u{2028}" or ch == "\u{2029}"
            w = 1
        if w > 0
            out.push("".join(cs[start:(if keepends then k + w else k)]))
            k += w
            start = k
        else
            k += 1
    if start < nc
        out.push("".join(cs[start:nc]))
    return out

# ---------------- strip ----------------

# Whether the character of w bytes at byte i of s is in set, or, with
# ws, whitespace as str.isspace() has it (the built-in strip's White_Space
# set and U+001C..U+001F).
fn sx_in(s: &text, i: usize, w: usize, set: &text, ws: bool) -> bool
    if ws
        return ((sx_fw(s, i) >> 3) & SF_SPACE) != 0
    return set.contains(sx_char(s, i, w))

# Byte offset after the leading characters of s that sx_in accepts.
fn sx_lskip(s: &text, set: &text, ws: bool) -> usize
    let n = s.len_bytes()
    var i: usize = 0
    while i < n bound 4194304
        let w = sx_len(s[i] as i64) as usize
        if not sx_in(s, i, w, set, ws)
            return i
        i += w
    return n

# Byte offset where the trailing characters of s that sx_in accepts begin.
fn sx_rskip(s: &text, set: &text, ws: bool) -> usize
    var j = s.len_bytes()
    while j > 0 bound 4194304
        let p = sx_back(s, j)
        if not sx_in(s, p, j - p, set, ws)
            return j
        j = p
    return 0

fn sx_strip(s: &text, set: &text, ws: bool, left: bool, right: bool) -> text
    let n = s.len_bytes()
    let a = if left then sx_lskip(s, set, ws) else 0
    if a == n
        return ""
    let b = if right then sx_rskip(s, set, ws) else n
    return sx_sub(s, a as i64, b as i64)

# Python's s.lstrip(), s.rstrip() and s.strip(): whitespace as
# str.isspace() has it.
pub fn str_lstrip(s: &text) -> text = sx_strip(s, s, true, true, false)

pub fn str_rstrip(s: &text) -> text = sx_strip(s, s, true, false, true)

pub fn str_strip(s: &text) -> text = sx_strip(s, s, true, true, true)

# Python's s.lstrip(chars), s.rstrip(chars) and s.strip(chars): the
# characters of chars, in any order.
pub fn str_lstrip_chars(s: &text, chars: &text) -> text = sx_strip(s, chars, false, true, false)

pub fn str_rstrip_chars(s: &text, chars: &text) -> text = sx_strip(s, chars, false, false, true)

pub fn str_strip_chars(s: &text, chars: &text) -> text = sx_strip(s, chars, false, true, true)

# ---------------- padding ----------------

fn sx_fill(fill: &text) -> i64 ! BadStr
    let k = fill.len_chars() as i64
    if k != 1
        fail BadStr(why: "fill", n: k)
    return k

# Python's s.center(width, fill), s.ljust(width, fill) and
# s.rjust(width, fill): width in characters, fill exactly one character.
pub fn str_center(s: &text, width: i64, fill: &text) -> text ! BadStr
    let _ = try sx_fill(fill)
    let c = s.len_chars() as i64
    if width <= c
        return copy(s)
    if width > STR_LIMIT
        fail sx_too_large(width)
    let marg = width - c
    let left = marg / 2 + (marg & width & 1)
    return sx_rep(fill, left) + copy(s) + sx_rep(fill, marg - left)

pub fn str_ljust(s: &text, width: i64, fill: &text) -> text ! BadStr
    let _ = try sx_fill(fill)
    let c = s.len_chars() as i64
    if width <= c
        return copy(s)
    if width > STR_LIMIT
        fail sx_too_large(width)
    return copy(s) + sx_rep(fill, width - c)

pub fn str_rjust(s: &text, width: i64, fill: &text) -> text ! BadStr
    let _ = try sx_fill(fill)
    let c = s.len_chars() as i64
    if width <= c
        return copy(s)
    if width > STR_LIMIT
        fail sx_too_large(width)
    return sx_rep(fill, width - c) + copy(s)

# Python's s.zfill(width): zeros on the left, after a leading + or -.
pub fn str_zfill(s: &text, width: i64) -> text ! BadStr
    let c = s.len_chars() as i64
    if width <= c
        return copy(s)
    if width > STR_LIMIT
        fail sx_too_large(width)
    let zero = "0"
    let z = sx_rep(&zero, width - c)
    if s.startswith("+") or s.startswith("-")
        return s[0:1] + z + s[1:]
    return z + copy(s)

# Python's s.expandtabs(tabsize): each tab becomes spaces up to the next
# column that is a multiple of tabsize (tabs are removed when tabsize <=
# 0); \n and \r reset the column; columns count characters.
pub fn str_expandtabs(s: &text, tabsize: i64) -> text ! BadStr
    let tab = "\t"
    if not s.contains("\t")
        return copy(s)
    let nl = "\n"
    let cr = "\r"
    let sp = " "
    let chunks = sx_split_chunks(s, &tab)
    let spaces = if tabsize > 0 then sx_rep(&sp, tabsize.min(STR_LIMIT)) else ""
    var parts: List[text] = []
    var size: i64 = 0
    var col: i64 = 0
    var idx: i64 = 0
    for chunk in chunks
        for piece in chunk
            if idx > 0 and tabsize > 0
                let k = tabsize - col % tabsize
                size = size.saturating_add(k)
                if size <= STR_LIMIT
                    parts.push(spaces[0:k as usize])
                col = col.saturating_add(k)
            let pc = piece.len_chars() as i64
            size = size.saturating_add(pc)
            if piece.contains("\n") or piece.contains("\r")
                let pn = piece.len_bytes() as i64
                let ln = sx_last(&piece, &nl, 0, pn).max(sx_last(&piece, &cr, 0, pn))
                col = piece[(ln as usize) + 1:].len_chars() as i64
            else
                col = col.saturating_add(pc)
            if size <= STR_LIMIT
                parts.push(copy(piece))
            idx += 1
    if size > STR_LIMIT
        fail sx_too_large(size)
    return "".join(parts)

# ---------------- character-index slicing ----------------

# Python's s[start:stop] by character index (a negative index counts
# from the end; indices are clamped; a stop at or above the length is the
# end).
pub fn str_slice(s: &text, start: i64, stop: i64) -> text
    let nc = s.len_chars() as i64
    let a = if start < 0 then (start + nc).max(0) else start.min(nc)
    let b = if stop < 0 then (stop + nc).max(0) else stop.min(nc)
    if a >= b
        return ""
    if sx_ascii(s)
        return sx_sub(s, a, b)
    let cs = s.chars()
    return "".join(cs[a as usize:b as usize])

# Python's s[i]: the character at index i (negative from the end), or none.
pub fn str_char_at(s: &text, i: i64) -> text?
    let nc = s.len_chars() as i64
    let k = if i < 0 then i + nc else i
    if k < 0 or k >= nc
        return none
    if sx_ascii(s)
        return some(sx_char(s, k as usize, 1))
    let cs = s.chars()
    return some(copy(cs[k as usize]))

# Python's s[start:stop:step0] with none for an omitted bound; a zero
# step is BadStr("step", 0).
pub fn str_slice_step(s: &text, start: i64?, stop: i64?, step0: i64) -> text ! BadStr
    if step0 == 0
        fail BadStr(why: "step", n: 0)
    let nc = s.len_chars() as i64
    # a step longer than the text takes one character at most, so it is
    # clamped (which keeps 0 - stp and the index arithmetic in range)
    let stp = if step0 > nc + 1 then nc + 1 else (if step0 < 0 - nc - 1 then 0 - nc - 1 else step0)
    # PySlice_Unpack and PySlice_AdjustIndices
    var a = if start.isnone() then (if stp < 0 then nc else 0) else start.or(0)
    var b = if stop.isnone() then (if stp < 0 then -1 - nc else nc) else stop.or(0)
    if a < 0
        a += nc
        if a < 0
            a = if stp < 0 then -1 else 0
    elif a >= nc
        a = if stp < 0 then nc - 1 else nc
    if b < 0
        b += nc
        if b < 0
            b = if stp < 0 then -1 else 0
    elif b >= nc
        b = if stp < 0 then nc - 1 else nc
    var len: i64 = 0
    if stp < 0
        if b < a
            len = (a - b - 1) / (0 - stp) + 1
    elif a < b
        len = (b - a - 1) / stp + 1
    if len == 0
        return ""
    if stp == 1
        return str_slice(s, a, b)
    let cs = s.chars()
    var parts: List[text] = []
    var i = a
    for _j in 0..len
        parts.push(copy(cs[i as usize]))
        i += stp
    return "".join(parts)

# ---------------- character records ----------------

const SF_ALPHA: i64 = 1
const SF_DECIMAL: i64 = 2
const SF_DIGIT: i64 = 4
const SF_NUMERIC: i64 = 8
const SF_SPACE: i64 = 16
const SF_PRINTABLE: i64 = 32
const SF_UPPER: i64 = 64
const SF_LOWER: i64 = 128
const SF_TITLE: i64 = 256
const SF_CASED: i64 = 512
const SF_IGNORABLE: i64 = 1024
const SF_XID_START: i64 = 2048
const SF_XID_CONTINUE: i64 = 4096
const SF_LU: i64 = 8192
const SF_LL: i64 = 16384
const SF_WORD: i64 = 32768

# Record of the code point c.
fn sx_rec(c: i64) -> usize
    let h = c >> STR_SHIFT
    if h >= STR_IX1N
        return 0
    return STR_IX2[((STR_IX1[h as usize] << STR_SHIFT) + (c & STR_MASK)) as usize] as usize

# Record and byte length of the character at byte i of s, as r * 8 + w.
fn sx_rw(s: &text, i: usize) -> i64
    let b = s[i] as i64
    if b < 128
        return STR_R7[b as usize] * 8 + 1
    var c: i64 = 0
    var w: i64 = 4
    if b < 224
        c = ((b & 31) << 6) | ((s[i + 1] as i64) & 63)
        w = 2
    elif b < 240
        c = ((b & 15) << 12) | (((s[i + 1] as i64) & 63) << 6) | ((s[i + 2] as i64) & 63)
        w = 3
    else
        c = ((b & 7) << 18) | (((s[i + 1] as i64) & 63) << 12) | (((s[i + 2] as i64) & 63) << 6) | ((s[i + 3] as i64) & 63)
    let h = c >> STR_SHIFT
    let r = if h < STR_IX1N then STR_IX2[((STR_IX1[h as usize] << STR_SHIFT) + (c & STR_MASK)) as usize] else 0
    return r * 8 + w

# Flags and byte length of the character at byte i of s, as f * 8 + w.
fn sx_fw(s: &text, i: usize) -> i64
    let b = s[i] as i64
    if b < 128
        return STR_A7[b as usize] * 8 + 1
    let rw = sx_rw(s, i)
    return STR_RF[(rw >> 3) as usize] * 8 + (rw & 7)

# Flags of a one-character text.
fn sx_flags1(ch: &text) -> i64
    let b = ch[0] as i64
    if b < 128
        return STR_A7[b as usize]
    return STR_RF[sx_rec(sx_cp(ch, 0))]

# The full mapping knd (0 lower, 1 upper, 2 title, 3 fold) of the code
# point c with record r: one code point (a delta in the record) or a
# sequence in STR_SX.
fn sx_map(c: i64, r: usize, knd: i64) -> text
    let x = STR_RX[r]
    if x == 0
        let d = if knd == 0 then STR_RL[r] else (if knd == 1 then STR_RU[r] else (if knd == 2 then STR_RT[r] else STR_RC[r]))
        return sx_chr(c + d)
    var p = (x - 1) as usize
    var k: i64 = 0
    while k < knd bound 4
        p += (STR_SX[p] as usize) + 1
        k += 1
    var o = ""
    for j in 0..(STR_SX[p] as usize)
        o = o + sx_chr(STR_SX[p + 1 + j])
    return o

# Whether the mapping knd changes the code point with record r.
fn sx_changes(r: usize, knd: i64) -> bool
    if STR_RX[r] != 0
        return true
    let d = if knd == 0 then STR_RL[r] else (if knd == 1 then STR_RU[r] else (if knd == 2 then STR_RT[r] else STR_RC[r]))
    return d != 0

# ---------------- predicates ----------------

# The distinct characters of s, in code point order (ASCII first).
fn sx_distinct(s: &text) -> List[text] = set_of(s.chars()).tolist()

# The distinct non-ASCII characters of s, in code point order.
fn sx_distinct_wide(s: &text) -> List[text]
    let ds = sx_distinct(s)
    var k: usize = 0
    while k < ds.len() and ds[k][0] < 128 bound 1000000
        k += 1
    let out: List[text] = copy(ds[k:])
    return out

# Whether every character of s has a flag of m (false for the empty
# text). Each distinct character is looked up once.
fn sx_all(s: &text, m: i64) -> bool
    if s.len_bytes() == 0
        return false
    for d in sx_distinct(s)
        if (sx_flags1(&d) & m) == 0
            return false
    return true

# Python's str.isalpha, isdecimal, isdigit, isnumeric, isalnum, isspace
# (all false for the empty text) and isprintable, isascii (true for it).
pub fn str_isalpha(s: &text) -> bool = sx_all(s, SF_ALPHA)

pub fn str_isdecimal(s: &text) -> bool = sx_all(s, SF_DECIMAL)

pub fn str_isdigit(s: &text) -> bool = sx_all(s, SF_DIGIT)

pub fn str_isnumeric(s: &text) -> bool = sx_all(s, SF_NUMERIC)

pub fn str_isalnum(s: &text) -> bool = sx_all(s, SF_ALPHA | SF_DECIMAL | SF_DIGIT | SF_NUMERIC)

pub fn str_isspace(s: &text) -> bool = sx_all(s, SF_SPACE)

pub fn str_isprintable(s: &text) -> bool = s.len_bytes() == 0 or sx_all(s, SF_PRINTABLE)

pub fn str_isascii(s: &text) -> bool = sx_ascii(s)

# Python's str.isidentifier: XID_Start or "_", then XID_Continue.
pub fn str_isidentifier(s: &text) -> bool
    if s.len_bytes() == 0
        return false
    let fw = sx_fw(s, 0)
    if s[0] != 95 and ((fw >> 3) & SF_XID_START) == 0
        return false
    let w = (fw & 7) as usize
    let rest = s[w:]
    return w == s.len_bytes() or sx_all(&rest, SF_XID_CONTINUE)

# Python's str.isupper and str.islower: at least one cased character of
# the wanted case and none of the other (a titlecase letter counts against
# both).
fn sx_iscase(s: &text, want: i64, other: i64) -> bool
    let bad = other | SF_TITLE
    var cased = false
    for d in sx_distinct(s)
        let f = sx_flags1(&d)
        if (f & bad) != 0
            return false
        if (f & want) != 0
            cased = true
    return cased

pub fn str_isupper(s: &text) -> bool = sx_iscase(s, SF_UPPER, SF_LOWER)

pub fn str_islower(s: &text) -> bool = sx_iscase(s, SF_LOWER, SF_UPPER)

# Python's str.istitle: uppercase and titlecase characters only after an
# uncased one, lowercase only after a cased one, and at least one cased.
pub fn str_istitle(s: &text) -> bool
    let n = s.len_bytes()
    var cased = false
    var prev = false
    var i: usize = 0
    while i < n bound 4194304
        let fw = sx_fw(s, i)
        let f = fw >> 3
        if (f & (SF_UPPER | SF_TITLE)) != 0
            if prev
                return false
            prev = true
            cased = true
        elif (f & SF_LOWER) != 0
            if not prev
                return false
            prev = true
            cased = true
        else
            prev = false
        i += (fw & 7) as usize
    return cased

# ---------------- case mapping ----------------

# Whether the capital sigma cs[k] is final: a cased letter before it
# (case-ignorable characters between) and none after it.
fn sx_final_sigma(cs: &[text], k: usize) -> bool
    var j = k
    var before = false
    while j > 0 bound 1000000
        j -= 1
        let f = sx_flags1(&cs[j])
        if (f & SF_IGNORABLE) == 0
            before = (f & SF_CASED) != 0
            break
    if not before
        return false
    var q = k + 1
    while q < cs.len() bound 1000000
        let f = sx_flags1(&cs[q])
        if (f & SF_IGNORABLE) == 0
            return (f & SF_CASED) == 0
        q += 1
    return true

# 1 when the last (with first, the first) character of p that is not
# case-ignorable is cased, 0 when it is not cased, -1 when p has none.
fn sx_edge(p: &text, first: bool) -> i64
    let n = p.len_bytes()
    if first
        var i: usize = 0
        while i < n bound 4194304
            let fw = sx_fw(p, i)
            let f = fw >> 3
            if (f & SF_IGNORABLE) == 0
                return if (f & SF_CASED) != 0 then 1 else 0
            i += (fw & 7) as usize
        return -1
    var j = n
    while j > 0 bound 4194304
        let q = sx_back(p, j)
        let f = sx_fw(p, q) >> 3
        if (f & SF_IGNORABLE) == 0
            return if (f & SF_CASED) != 0 then 1 else 0
        j = q
    return -1

# The capital sigmas of t, the lowercase of orig with every other
# character mapped, made final (U+03C2) where orig has them after a cased
# letter and before none (case-ignorable characters skipped), and U+03C3
# elsewhere.
fn sx_sigma(orig: &text, t: &text) -> text
    let sig = "\u{3a3}"
    let po = sx_split_chunks(orig, &sig)
    let pm = sx_split_chunks(t, &sig)
    var total: usize = 0
    for ch in po
        total += ch.len()
    var acc: List[text] = []
    var big: List[text] = []
    var g: usize = 0
    var prev = ""
    for ci in 0..po.len()
        let ochunk = copy(po[ci])
        let mchunk = copy(pm[ci])
        for qi in 0..ochunk.len()
            let cur = copy(ochunk[qi])
            if g > 0
                let eb = sx_edge(&prev, false)
                let before = eb == 1 or (eb == -1 and g > 1)
                let ea = sx_edge(&cur, true)
                let later = ea == 1 or (ea == -1 and g + 1 < total)
                acc.push(if before and not later then "\u{3c2}" else "\u{3c3}")
            acc.push(copy(mchunk[qi]))
            if acc.len() >= 4096
                big.push("".join(acc))
                acc = []
            prev = cur
            g += 1
    big.push("".join(acc))
    return "".join(big)

# lower (mode 0, with the final sigma rule), upper (1) or fold (3) of s:
# the built-in method for ASCII, then each distinct other character that
# changes replaced throughout by its mapping. The full mappings are
# stable (no character of a mapping changes again), so the order of the
# replacements does not matter.
fn sx_case3(s: &text, mode: i64) -> text ! BadStr
    if sx_ascii(s)
        return if mode == 1 then s.upper() else s.lower()
    let n = s.len_bytes() as i64
    var size = s.len_chars() as i64
    var reps: List[text] = []
    var sigma = false
    for d in sx_distinct_wide(s)
        let c = sx_cp(&d, 0)
        let r = sx_rec(c)
        if sx_changes(r, mode)
            if mode == 0 and c == 931
                sigma = true
            else
                let m = sx_map(c, r, mode)
                let mc = m.len_chars() as i64
                if mc != 1
                    size += sx_count(s, &d, 0, n) * (mc - 1)
                reps.push(copy(d))
                reps.push(m)
    if size > STR_LIMIT
        fail sx_too_large(size)
    var t = if mode == 1 then s.upper() else s.lower()
    var k: usize = 0
    while k + 1 < reps.len() bound 1000000
        t = try str_replace_n(&t, &reps[k], &reps[k + 1], -1)
        k += 2
    if sigma
        return sx_sigma(s, &t)
    return t

# title (mode 4: the title mapping after an uncased character, lower
# after a cased one) or swapcase (6) of s, character by character, with
# the final sigma rule.
fn sx_case_ctx(s: &text, mode: i64) -> text ! BadStr
    let cs = s.chars()
    let nc = cs.len()
    var parts: List[text] = []
    var size: i64 = 0
    var run: usize = 0
    var prev = false
    var k: usize = 0
    while k < nc bound 1000000
        let ch = copy(cs[k])
        let b0 = ch[0] as i64
        let c = if b0 < 128 then b0 else sx_cp(&ch, 0)
        let r = if b0 < 128 then STR_R7[b0 as usize] as usize else sx_rec(c)
        let f = STR_RF[r]
        var knd: i64 = -1
        if mode == 4
            knd = if prev then 0 else 2
            prev = (f & SF_CASED) != 0
        else
            knd = if (f & SF_UPPER) != 0 then 0 else (if (f & SF_LOWER) != 0 then 1 else -1)
        if knd >= 0 and sx_changes(r, knd)
            var t = sx_map(c, r, knd)
            if c == 931 and knd == 0 and sx_final_sigma(&cs, k)
                t = "\u{3c2}"
            if run < k
                size += (k - run) as i64
                if size <= STR_LIMIT
                    parts.push("".join(cs[run:k]))
            size += t.len_chars() as i64
            if size <= STR_LIMIT
                parts.push(t)
            run = k + 1
        k += 1
    if run == 0
        return copy(s)
    if run < nc
        size += (nc - run) as i64
        if size <= STR_LIMIT
            parts.push("".join(cs[run:nc]))
    if size > STR_LIMIT
        fail sx_too_large(size)
    return "".join(parts)

# Python's s.upper(), s.lower(), s.casefold(), s.title() and
# s.swapcase(), with the full (SpecialCasing) mappings.
pub fn str_upper(s: &text) -> text ! BadStr = try sx_case3(s, 1)

pub fn str_lower(s: &text) -> text ! BadStr = try sx_case3(s, 0)

pub fn str_casefold(s: &text) -> text ! BadStr = try sx_case3(s, 3)

pub fn str_title(s: &text) -> text ! BadStr = try sx_case_ctx(s, 4)

pub fn str_swapcase(s: &text) -> text ! BadStr = try sx_case_ctx(s, 6)

# Python's s.capitalize(): the title mapping of the first character, then
# the rest as str_lower has it (in the context of the whole text).
pub fn str_capitalize(s: &text) -> text ! BadStr
    if s.len_bytes() == 0
        return ""
    let low = try str_lower(s)
    let c = sx_cp(s, 0)
    let r = sx_rec(c)
    let l0 = if c == 931 then 1 else sx_map(c, r, 0).len_chars() as i64
    let head = sx_map(c, r, 2)
    let size = (low.len_chars() as i64) - l0 + (head.len_chars() as i64)
    if size > STR_LIMIT
        fail sx_too_large(size)
    return head + str_slice(&low, l0, STR_LIMIT)

# ---------------- word case (change-case 5.4.4) ----------------

# Words of s as change-case's split: runs of letters (with the code
# points whose simple case folding is a letter's, as the u and i flags of
# its /[^\p{L}\d]+/giu read them) and ASCII digits, cut between a
# lowercase letter or digit and an uppercase letter (gc Ll, Lu), and
# between two uppercase letters that a lowercase letter follows.
pub fn str_words(s: &text) -> List[text]
    let cs = s.chars()
    let nc = cs.len()
    var out: List[text] = []
    var start: i64 = -1
    # classes of the previous two characters of the current word:
    # 1 lowercase letter or digit, 2 uppercase letter, 0 other letter
    var p1: i64 = -1
    var p2: i64 = -1
    var k: usize = 0
    while k < nc bound 1000000
        let ch = copy(cs[k])
        let b = ch[0] as i64
        let digit = b >= 48 and b <= 57
        let f = if digit then 0 else sx_flags1(&ch)
        if digit or (f & SF_WORD) != 0
            let cls = if digit or (f & SF_LL) != 0 then 1 else (if (f & SF_LU) != 0 then 2 else 0)
            if start < 0
                start = k as i64
            elif cls == 2 and p1 == 1
                out.push("".join(cs[start as usize:k]))
                start = k as i64
            elif (f & SF_LL) != 0 and p1 == 2 and p2 == 2
                out.push("".join(cs[start as usize:k - 1]))
                start = (k - 1) as i64
            p2 = p1
            p1 = cls
        else
            if start >= 0
                out.push("".join(cs[start as usize:k]))
            start = -1
            p1 = -1
            p2 = -1
        k += 1
    if start >= 0
        out.push("".join(cs[start as usize:nc]))
    return out

# First character upper-cased, the rest lower-cased (each as its own
# text); with digit_mark, a first ASCII digit gets "_" in front instead.
fn sx_cap(word: &text, digit_mark: bool) -> text ! BadStr
    let w = sx_len(word[0] as i64) as usize
    let first = word[0:w]
    let rest = word[w:]
    let lo = try str_lower(&rest)
    if digit_mark and word[0] >= 48 and word[0] <= 57
        return "_" + first + lo
    return (try str_upper(&first)) + lo

fn sx_join_words(ws: &[text], mode: i64) -> text ! BadStr
    var parts: List[text] = []
    var size: i64 = 0
    var k: usize = 0
    let sep = if mode == 2 then "_" else (if mode == 3 then "-" else (if mode == 4 then "_" else (if mode == 5 then " " else "")))
    for wd in ws
        var t = ""
        if mode == 0 and k == 0
            t = try str_lower(&wd)
        elif mode == 0
            t = try sx_cap(&wd, true)
        elif mode == 1
            t = try sx_cap(&wd, k > 0)
        elif mode == 4
            t = try str_upper(&wd)
        elif mode == 5
            t = try sx_cap(&wd, false)
        else
            t = try str_lower(&wd)
        size += (t.len_chars() as i64) + (if k > 0 then (sep.len_chars() as i64) else 0)
        if size <= STR_LIMIT
            parts.push(t)
        k += 1
    if size > STR_LIMIT
        fail sx_too_large(size)
    return sep.join(parts)

# change-case's camelCase ("fooBar"), pascalCase ("FooBar"), snakeCase
# ("foo_bar"), kebabCase ("foo-bar"), constantCase ("FOO_BAR") and
# capitalCase ("Foo Bar"). camel and pascal put "_" before a word (other
# than the first) that starts with a digit.
pub fn str_camel(s: &text) -> text ! BadStr
    let ws = str_words(s)
    return try sx_join_words(&ws, 0)

pub fn str_pascal(s: &text) -> text ! BadStr
    let ws = str_words(s)
    return try sx_join_words(&ws, 1)

pub fn str_snake(s: &text) -> text ! BadStr
    let ws = str_words(s)
    return try sx_join_words(&ws, 2)

pub fn str_kebab(s: &text) -> text ! BadStr
    let ws = str_words(s)
    return try sx_join_words(&ws, 3)

pub fn str_constant(s: &text) -> text ! BadStr
    let ws = str_words(s)
    return try sx_join_words(&ws, 4)

pub fn str_capital(s: &text) -> text ! BadStr
    let ws = str_words(s)
    return try sx_join_words(&ws, 5)

# ---------------- slugify (Django 5.2) ----------------

# One ASCII byte b through Django's filters: lowercase; letters, digits
# and "_" kept; "-" and the characters re's \s matches (\t \n \v \f \r,
# \x1c..\x1f, space) as a separator; the rest dropped. Returns the byte,
# -1 for a separator, -2 for a dropped byte.
fn sx_slug_byte(b: i64) -> i64
    if b >= 65 and b <= 90
        return b + 32
    if (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 95
        return b
    if b == 45 or b == 32 or (b >= 9 and b <= 13) or (b >= 28 and b <= 31)
        return -1
    return -2

# Django's slugify(s) with allow_unicode=False: each distinct non-ASCII
# character replaced by the ASCII part of its NFKD form, then lowercase,
# the bytes sx_slug_byte drops removed, separators made spaces, the words
# joined with "-", and "-" and "_" stripped from both ends.
pub fn str_slugify(s: &text) -> text ! BadStr
    let n = s.len_bytes() as i64
    var t = copy(s)
    if not sx_ascii(s)
        var size = s.len_chars() as i64
        var reps: List[text] = []
        for d in sx_distinct_wide(s)
            let a = copy(STR_AF[STR_RA[sx_rec(sx_cp(&d, 0))] as usize])
            size += sx_count(s, &d, 0, n) * ((a.len_chars() as i64) - 1)
            reps.push(copy(d))
            reps.push(a)
        if size > STR_LIMIT
            fail sx_too_large(size)
        var k: usize = 0
        while k + 1 < reps.len() bound 1000000
            t = try str_replace_n(&t, &reps[k], &reps[k + 1], -1)
            k += 2
    t = t.lower()
    let sp = " "
    let none_ = ""
    for d in sx_distinct(&t)
        let x = sx_slug_byte(d[0] as i64)
        if x == -2
            t = try str_replace_n(&t, &d, &none_, -1)
        elif x == -1 and d != " "
            t = try str_replace_n(&t, &d, &sp, -1)
    let w = "-".join(t.words())
    let ends = "-_"
    return str_strip_chars(&w, &ends)

# ---------------- StrBuf: amortized appends ----------------

const STR_RUN: usize = 64
const STR_RUN_CHARS: i64 = 65536

# A text under construction: pieces are joined 64 at a time into runs,
# and 64 runs make a block, so an append through &mut copies at most a
# few short lists. The content may exceed STR_LIMIT characters.
pub struct StrBuf
    cur: List[text]
    cur_chars: i64
    runs: List[text]
    blocks: List[List[text]]
    chars: i64

pub fn str_buf() -> StrBuf = StrBuf(cur: [], cur_chars: 0, runs: [], blocks: [], chars: 0)

fn sx_buf_flush(b: &mut StrBuf)
    if b.cur.len() > 0
        let r = "".join(copy(b.cur))
        b.runs.push(r)
        b.cur = []
        b.cur_chars = 0
        if b.runs.len() >= STR_RUN
            b.blocks.push(copy(b.runs))
            b.runs = []

# Append t.
pub fn str_buf_add(b: &mut StrBuf, t: &text)
    let k = t.len_chars() as i64
    if k == 0
        return
    if b.cur.len() >= STR_RUN or b.cur_chars + k > STR_RUN_CHARS
        sx_buf_flush(b)
    b.cur.push(copy(t))
    b.cur_chars += k
    b.chars += k

# Append the character with code point c (BadStr("code point", c) when c
# is not a Unicode scalar value).
pub fn str_buf_add_cp(b: &mut StrBuf, c: i64) -> () ! BadStr
    if not sx_scalar(c)
        fail BadStr(why: "code point", n: c)
    let t = sx_chr(c)
    str_buf_add(b, &t)

# Length of the content in characters.
pub fn str_buf_chars(b: &StrBuf) -> i64 = b.chars

# Every piece in order, runs and blocks flattened.
fn sx_buf_pieces(b: &StrBuf) -> List[text]
    var ps: List[text] = []
    for blk in b.blocks
        for r in blk
            ps.push(copy(r))
    for r in b.runs
        ps.push(copy(r))
    for t in b.cur
        ps.push(copy(t))
    return ps

# The content as one text, or BadStr("too large", chars).
pub fn str_buf_text(b: &StrBuf) -> text ! BadStr
    if b.chars > STR_LIMIT
        fail sx_too_large(b.chars)
    return "".join(sx_buf_pieces(b))

# The content as consecutive texts of at most STR_LIMIT characters each
# (the empty list for an empty buffer).
pub fn str_buf_chunks(b: &StrBuf) -> List[text]
    var out: List[text] = []
    var acc: List[text] = []
    var acc_chars: i64 = 0
    for p in sx_buf_pieces(b)
        let k = p.len_chars() as i64
        if acc_chars + k > STR_LIMIT
            out.push("".join(acc))
            acc = []
            acc_chars = 0
        acc.push(p)
        acc_chars += k
    if acc.len() > 0
        out.push("".join(acc))
    return out

# ---------------- StrFinder: Knuth-Morris-Pratt ----------------

# A needle prepared for search: its bytes and the KMP border table
# (bord[k] is the length of the longest proper border of pat[0..k]).
pub struct StrFinder
    pat: List[i64]
    bord: List[i64]

pub fn str_finder(needle: &text) -> StrFinder
    let m = needle.len_bytes()
    var pat: List[i64] = []
    for i in 0..m
        pat.push(needle[i] as i64)
    var bd: List[i64] = []
    if m > 0
        bd.push(0)
    var k: i64 = 0
    var i: usize = 1
    while i < m bound 4194304
        while k > 0 and pat[k as usize] != pat[i] bound 4194304
            k = bd[(k - 1) as usize]
        if pat[k as usize] == pat[i]
            k += 1
        bd.push(k)
        i += 1
    return StrFinder(pat: pat, bord: bd)

# Run the automaton over hay from byte i0 in state k0; base is added to
# every offset. Returns the match starts (at most lim when lim >= 0) and
# the final state.
fn sx_kmp(f: &StrFinder, hay: &text, i0: usize, k0: i64, base: i64, overlap: bool, lim: i64) -> (List[i64], i64)
    var out: List[i64] = []
    let pat = copy(f.pat)
    let bd = copy(f.bord)
    let m = pat.len() as i64
    let reset = if overlap then bd[(m - 1) as usize] else 0
    let n = hay.len_bytes()
    var k = k0
    var i = i0
    while i < n bound 4194304
        let c = hay[i] as i64
        while k > 0 and pat[k as usize] != c bound 4194304
            k = bd[(k - 1) as usize]
        if pat[k as usize] == c
            k += 1
            if k == m
                out.push(base + (i as i64) + 1 - m)
                if lim >= 0 and (out.len() as i64) >= lim
                    return (out, k)
                k = reset
        i += 1
    return (out, k)

# Byte offsets of the character boundaries of s from byte a, at most lim.
fn sx_bounds(s: &text, a: i64, base: i64, lim: i64) -> List[i64]
    var out: List[i64] = []
    let n = s.len_bytes()
    var i = sx_up(s, a) as usize
    while i < n and (out.len() as i64) < lim bound 4194304
        out.push(base + (i as i64))
        i += sx_len(s[i] as i64) as usize
    return out

# The first match at or after byte start (adjusted as str_find_in
# adjusts it), or -1.
pub fn str_finder_find(f: &StrFinder, hay: &text, start: i64) -> i64
    let n = hay.len_bytes() as i64
    let st = sx_adj_start(start, n)
    if f.pat.len() == 0
        return if st <= n then sx_up(hay, st) else -1
    if st >= n
        return -1
    let r = sx_kmp(f, hay, sx_up(hay, st) as usize, 0, 0, false, 1)
    return if r.0.len() > 0 then r.0[0] else -1

# Starts of every match in hay: overlapping ones when overlap, else the
# leftmost non-overlapping ones (those str_count counts). An empty needle
# matches at every character boundary. At most STR_LIMIT offsets.
pub fn str_finder_all(f: &StrFinder, hay: &text, overlap: bool) -> List[i64]
    if f.pat.len() == 0
        var b = sx_bounds(hay, 0, 0, STR_LIMIT)
        if (b.len() as i64) < STR_LIMIT
            b.push(hay.len_bytes() as i64)
        return b
    let r = sx_kmp(f, hay, 0, 0, 0, overlap, STR_LIMIT)
    return r.0

# A resumable scan over the chunks of one stream: the finder, the
# automaton state and the stream offset of the next chunk. The scan holds
# its own copy of the finder, so its state always belongs to that needle.
pub struct StrScan
    f: StrFinder
    k: i64
    pos: i64
    overlap: bool

# A scan for the needle of f from the start of a stream: overlapping
# matches when overlap, else the leftmost non-overlapping ones.
pub fn str_scan(f: &StrFinder, overlap: bool) -> StrScan = StrScan(f: copy(f), k: 0, pos: 0, overlap: overlap)

# Feed the next chunk; returns the stream offsets of the matches that end
# in it (a match may start in an earlier chunk). An empty needle reports
# the start of every character of the chunk. Chunks are texts, so each
# one ends at a character boundary; a chunk of any length within the size
# limit is accepted, and the stream as a whole has no length limit.
pub fn str_scan_feed(st: &mut StrScan, chunk: &text) -> List[i64]
    let base = st.pos
    st.pos += chunk.len_bytes() as i64
    if st.f.pat.len() == 0
        return sx_bounds(chunk, 0, base, STR_LIMIT)
    let r = sx_kmp(&st.f, chunk, 0, st.k, base, st.overlap, -1)
    st.k = r.1
    return r.0

# The stream offset of the next chunk (the bytes fed so far).
pub fn str_scan_pos(st: &StrScan) -> i64 = st.pos

# ---- data (generated by scripts/gen/str_data.py from Unicode 15.1.0; do not edit)
# A code point c has the record STR_IX2[(STR_IX1[c >> STR_SHIFT] << STR_SHIFT) + (c & STR_MASK)]
# (record 0 above the end of STR_IX1). Record fields: STR_RF flags (bits, in
# order: ALPHA, DECIMAL, DIGIT, NUMERIC, SPACE, PRINTABLE, UPPER, LOWER,
# TITLE, CASED, CASE_IGNORABLE, XID_START, XID_CONTINUE, GC_LU, GC_LL, WORD),
# STR_RL, STR_RU, STR_RT, STR_RC the deltas of the one-code-point lower, upper,
# title and fold mappings, STR_RX the 1-based start in STR_SX of a mapping
# longer than one code point (lengths and code points of lower, upper,
# title, fold), STR_RA the index in STR_AF of the ASCII part of the NFKD form.

