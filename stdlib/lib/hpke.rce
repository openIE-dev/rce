module hpke

# AES-128-GCM (FIPS 197, NIST SP 800-38D) and HPKE base mode (RFC 9180) with
# DHKEM(X25519, HKDF-SHA256), HKDF-SHA256 and AES-128-GCM: the public-key
# encryption of MLS cipher suite 1 (EncryptWithLabel), pure RCE on top of
# lib/crypto.rce (X25519, HMAC, byte helpers). Randomness never comes from
# here: the ephemeral key is derived from logged random bytes (HC-10). Not
# constant time (see lib/crypto.rce).
# Vectors: FIPS 197 C.1 and SP 800-38D test case 4 as checks; RFC 9180
# A.1 (base mode) and the RFC 9420 crypto-basics.json EncryptWithLabel
# vector for suite 1 as host steps in tests/hpke_rce.rs.

# AES S-box by arithmetic: the inverse in GF(2^8) (a^254, 15 multiplications
# whose bit pattern is the public constant 254) followed by the FIPS 197
# affine map. No table is indexed by the (secret) byte and nothing branches
# on it. gmul is the shift-and-add product with masks in place of branches.
fn gmul(a: i64, b: i64) -> i64
    var p: i64 = 0
    var x = a
    var y = b
    for _ in 0..8
        p = p ^ (x & (0 - (y & 1)))
        x = ((x << 1) ^ (27 & (0 - (x >> 7)))) & 255
        y = y >> 1
    return p

fn ginv(a: i64) -> i64
    var r: i64 = 1
    for k in 0..8
        r = gmul(r, r)
        if ((254 >> (7 - k as i64)) & 1) == 1
            r = gmul(r, a)
    return r

fn rotl8(v: i64, n: i64) -> i64 = ((v << n) | (v >> (8 - n))) & 255

fn sbox(x: i64) -> i64
    let i = ginv(x)
    return i ^ rotl8(i, 1) ^ rotl8(i, 2) ^ rotl8(i, 3) ^ rotl8(i, 4) ^ 99


# multiply by x in GF(2^8): the reduction is a mask from the top bit, no branch
fn xt(b: i64) -> i64 = ((b << 1) ^ (27 & (0 - (b >> 7)))) & 255

# the 176-byte expanded key of a 16-byte AES-128 key
fn aes_expand(key: List[i64]) -> List[i64]
    var w = copy(key)
    var rc: i64 = 1
    var i: usize = 16
    while i < 176 bound 160
        var t = [w[i - 4], w[i - 3], w[i - 2], w[i - 1]]
        if i % 16 == 0
            t = [sbox(t[1]) ^ rc, sbox(t[2]), sbox(t[3]), sbox(t[0])]
            rc = xt(rc)
        for j in 0..4
            w.push(w[i - 16 + j] ^ t[j])
        i += 4
    return w

fn aes_block(rk: List[i64], inp: List[i64]) -> List[i64]
    var s: List[i64] = []
    for i in 0..16
        s.push(inp[i] ^ rk[i])
    for r in 1..11
        # SubBytes and ShiftRows (state column-major: byte c*4+row)
        var t: List[i64] = []
        for c in 0..4
            for row in 0..4
                t.push(sbox(s[((c + row) % 4) * 4 + row]))
        # MixColumns, except in the last round
        if r < 10
            var m: List[i64] = []
            for c in 0..4
                let a0 = t[4 * c]
                let a1 = t[4 * c + 1]
                let a2 = t[4 * c + 2]
                let a3 = t[4 * c + 3]
                m.push(xt(a0) ^ xt(a1) ^ a1 ^ a2 ^ a3)
                m.push(a0 ^ xt(a1) ^ xt(a2) ^ a2 ^ a3)
                m.push(a0 ^ a1 ^ xt(a2) ^ xt(a3) ^ a3)
                m.push(xt(a0) ^ a0 ^ a1 ^ a2 ^ xt(a3))
            t = m
        s = []
        for i in 0..16
            s.push(t[i] ^ rk[16 * r + i])
    return s

# GF(2^128) multiply of GCM (bit 0 is the most significant bit of byte 0)
fn gf_mul(x: List[i64], y: List[i64]) -> List[i64]
    var z: List[i64] = []
    for _ in 0..16
        z.push(0)
    var v = copy(y)
    for i in 0..128
        let xm = 0 - ((x[i / 8] >> (7 - (i % 8) as i64)) & 1)
        for j in 0..16
            z[j] = z[j] ^ (v[j] & xm)
        let lsb = v[15] & 1
        var j: usize = 15
        while j > 0 bound 16
            v[j] = (v[j] >> 1) | ((v[j - 1] & 1) << 7)
            j -= 1
        v[0] = v[0] >> 1
        v[0] = v[0] ^ (225 & (0 - lsb))
    return z

fn ghash(h: List[i64], aad: List[i64], ctext: List[i64]) -> List[i64]
    var y: List[i64] = []
    for _ in 0..16
        y.push(0)
    for part in [copy(aad), copy(ctext)]
        var off: usize = 0
        while off < part.len() bound 65536
            for j in 0..16
                if off + j < part.len()
                    y[j] = y[j] ^ part[off + j]
            y = gf_mul(y, copy(h))
            off += 16
    var lens: List[i64] = []
    for n in [aad.len() as i64 * 8, ctext.len() as i64 * 8]
        for k in 0..8
            lens.push((n >> (56 - 8 * k)) & 255)
    for j in 0..16
        y[j] = y[j] ^ lens[j]
    return gf_mul(y, h)

fn ctr_block(iv: List[i64], c: i64) -> List[i64] = cat(copy(iv), [(c >> 24) & 255, (c >> 16) & 255, (c >> 8) & 255, c & 255])

# CTR mode from counter 2 (the keystream XOR of GCM)
fn gcm_ctr(rk: List[i64], iv: List[i64], data: List[i64]) -> List[i64]
    var out: List[i64] = []
    var c: i64 = 2
    var off: usize = 0
    while off < data.len() bound 65536
        let ks = aes_block(copy(rk), ctr_block(copy(iv), c))
        for j in 0..16
            if off + j < data.len()
                out.push(data[off + j] ^ ks[j])
        c += 1
        off += 16
    return out

fn zero16() -> List[i64]
    var z: List[i64] = []
    for _ in 0..16
        z.push(0)
    return z

# AES-128-GCM with a 12-byte nonce: ciphertext || 16-byte tag
fn gcm_seal(key: List[i64], iv: List[i64], aad: List[i64], pt: List[i64]) -> List[i64]
    let rk = aes_expand(key)
    let h = aes_block(copy(rk), zero16())
    let ctext = gcm_ctr(copy(rk), copy(iv), pt)
    let s = ghash(h, aad, copy(ctext))
    let ek = aes_block(rk, ctr_block(iv, 1))
    var tag: List[i64] = []
    for j in 0..16
        tag.push(s[j] ^ ek[j])
    return cat(ctext, tag)

# byte-list equality with no early exit (OR of the XORs, tested once); a
# copy of crypto.ct_eq so this file also checks against an embedded crypto
# that predates it. Only the lengths are public.
fn hp_ct_eq(a: List[i64], b: List[i64]) -> bool
    if a.len() != b.len()
        return false
    var acc: i64 = 0
    for i in 0..a.len()
        acc = acc | (a[i] ^ b[i])
    return acc == 0

# the plaintext, or [-1] when the tag does not verify
fn gcm_open(key: List[i64], iv: List[i64], aad: List[i64], sealed: List[i64]) -> List[i64]
    if sealed.len() < 16
        return [-1]
    let pt = gcm_ctr(aes_expand(copy(key)), copy(iv), slice(copy(sealed), 0, sealed.len() - 16))
    if hp_ct_eq(gcm_seal(key, iv, aad, copy(pt)), sealed)
        return pt
    return [-1]

# ---- HPKE base mode (RFC 9180) ----

fn i2osp2(n: i64) -> List[i64] = [(n >> 8) & 255, n & 255]

fn suite_kem() -> List[i64] = cat(tobytes("KEM"), i2osp2(32))

# HPKE suite: DHKEM(X25519, HKDF-SHA256), HKDF-SHA256, AES-128-GCM
fn suite_hpke() -> List[i64] = cat(cat(tobytes("HPKE"), i2osp2(32)), cat(i2osp2(1), i2osp2(1)))

fn hp_extract(suite: List[i64], salt: List[i64], lbl: text, ikm: List[i64]) -> List[i64] = hmac(salt, cat(cat(tobytes("HPKE-v1"), suite), cat(tobytes(lbl), ikm)))

fn hp_expand(suite: List[i64], prk: List[i64], lbl: text, info: List[i64], n: usize) -> List[i64]
    let li = cat(cat(i2osp2(n as i64), cat(tobytes("HPKE-v1"), suite)), cat(tobytes(lbl), info))
    var out: List[i64] = []
    var t: List[i64] = []
    var c: i64 = 1
    while out.len() < n bound 255
        t = hmac(copy(prk), cat(cat(copy(t), copy(li)), [c]))
        for x in copy(t)
            if out.len() < n
                out.push(x)
        c += 1
    return out

# DeriveKeyPair(ikm) of DHKEM(X25519): the private key, hex
fn hp_derive_sk(ikm: text) -> text = tohex(hp_expand(suite_kem(), hp_extract(suite_kem(), [], "dkp_prk", unhex(ikm)), "sk", [], 32))

fn hp_shared(dh: List[i64], kem_context: List[i64]) -> List[i64] = hp_expand(suite_kem(), hp_extract(suite_kem(), [], "eae_prk", dh), "shared_secret", kem_context, 32)

# key || base_nonce (28 bytes) of the base-mode key schedule
fn hp_key_nonce(shared: List[i64], info: List[i64]) -> List[i64]
    let s = suite_hpke()
    let ksc = cat(cat([0], hp_extract(copy(s), [], "psk_id_hash", [])), hp_extract(copy(s), [], "info_hash", info))
    let secret = hp_extract(copy(s), shared, "secret", [])
    return cat(hp_expand(copy(s), copy(secret), "key", copy(ksc), 16), hp_expand(s, secret, "base_nonce", ksc, 12))

fn hp_nonce(base: List[i64], seq: i64) -> List[i64]
    var n = copy(base)
    for k in 0..8
        n[11 - k] = n[11 - k] ^ ((seq >> (8 * k as i64)) & 255)
    return n

# RFC 9180 7.1.4: the DH output must not be the all-zero value (the peer sent
# a low-order point); the OR of all bytes is tested once at the end, so the
# test does not branch per byte. Only the abort (a public event) branches.
fn hp_allzero(b: List[i64]) -> bool
    var acc: i64 = 0
    for x in b
        acc = acc | x
    return acc == 0

# SetupBaseS + Seal: "enc.ciphertext" (hex) to recipient public key pkr (""
# when pkr is not 32 bytes or the DH output is all zero, RFC 9180 7.1.4),
# with the ephemeral private key ske (from logged random bytes), message
# number seq of the context
fn hpke_seal(pkr: text, ske: text, info: text, aad: text, pt: text, seq: i64) -> text
    if unhex(copy(pkr)).len() != 32
        return ""
    let enc = pubkey(copy(ske))
    let dh = unhex(x25519(ske, copy(pkr)))
    if hp_allzero(copy(dh))
        return ""
    let kn = hp_key_nonce(hp_shared(dh, cat(unhex(copy(enc)), unhex(pkr))), unhex(info))
    let ctext = gcm_seal(slice(copy(kn), 0, 16), hp_nonce(slice(kn, 16, 28), seq), unhex(aad), unhex(pt))
    return enc + "." + tohex(ctext)

# SetupBaseR + Open: the plaintext (hex), or "" when it does not open (also for
# an enc that is not 32 bytes or gives an all-zero DH output, RFC 9180 7.1.4)
fn hpke_open(skr: text, enc: text, info: text, aad: text, ctext: text, seq: i64) -> text
    if unhex(copy(enc)).len() != 32
        return ""
    let pkr = pubkey(copy(skr))
    let dh = unhex(x25519(skr, copy(enc)))
    if hp_allzero(copy(dh))
        return ""
    let kn = hp_key_nonce(hp_shared(dh, cat(unhex(enc), unhex(pkr))), unhex(info))
    let pt = gcm_open(slice(copy(kn), 0, 16), hp_nonce(slice(kn, 16, 28), seq), unhex(aad), unhex(ctext))
    if pt.len() == 1 and pt[0] == -1
        return ""
    return tohex(pt)

# MLS EncryptWithLabel / DecryptWithLabel (RFC 9420 5.1.3): info is
# EncryptContext { opaque label<V> = "MLS 1.0 " + label; opaque context<V> }
fn mls_vec2(b: List[i64]) -> List[i64]
    let n = b.len() as i64
    if n < 64
        return cat([n], b)
    return cat([64 | (n >> 8), n & 255], b)

fn enc_context(lbl: text, context: text) -> text = tohex(cat(mls_vec2(tobytes("MLS 1.0 " + lbl)), mls_vec2(unhex(context))))

fn encrypt_with_label(pk: text, ske: text, lbl: text, context: text, pt: text) -> text = hpke_seal(pk, ske, enc_context(lbl, context), "", pt, 0)

fn decrypt_with_label(sk: text, lbl: text, context: text, kem_output: text, ctext: text) -> text = hpke_open(sk, kem_output, enc_context(lbl, context), "", ctext, 0)

check tohex(aes_block(aes_expand(unhex("000102030405060708090a0b0c0d0e0f")), unhex("00112233445566778899aabbccddeeff"))) == "69c4e0d86a7b0430d8cdb78070b4c55a"
check tohex(gcm_seal(unhex("feffe9928665731c6d6a8f9467308308"), unhex("cafebabefacedbaddecaf888"), unhex("feedfacedeadbeeffeedfacedeadbeefabaddad2"), unhex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39"))) == "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47"
check gcm_open(unhex("feffe9928665731c6d6a8f9467308308"), unhex("cafebabefacedbaddecaf888"), [], unhex("00112233445566778899aabbccddeeff")) == [-1]
