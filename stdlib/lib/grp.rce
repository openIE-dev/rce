module grp

use crypto
use framing
use hpke
use mls
use protect
use treekem
use welcome

# MLS group state across epochs for a passive member (RFC 9420 8, 12.2 to
# 12.4), pure RCE on lib/crypto.rce, lib/hpke.rce, lib/mls.rce,
# lib/treekem.rce, lib/framing.rce, lib/protect.rce and lib/welcome.rce:
# proposal references, applying GroupContextExtensions, Update, Remove (with
# truncation), Add (leftmost blank leaf, extension, unmerged leaves) and PSK
# proposals in RFC order, the committer's update path with the new leaves
# excluded from resolutions, the provisional GroupContext, our new path
# secrets and node keys, the commit secret, the confirmed and interim
# transcript hashes, the key schedule with external and resumption PSKs,
# and the confirmation tag. Vectors: passive-client-handling-commit.json
# (suite 1), in tests/group_rce.rs.
#
# Held private keys are "node:sk," text; resumption secrets "epoch:secret,".

fn kv_get(m: text, k: text) -> text
    for e in m.split(",")
        if e != ""
            let p = e.split(":")
            if copy(p[0]) == k
                return copy(p[1])
    return ""

fn kv_set(m: text, k: text, v: text) -> text
    var o = ""
    for e in m.split(",")
        if e != ""
            let p = e.split(":")
            if copy(p[0]) != k
                o = o + e + ","
    return o + k + ":" + v + ","

fn lca(a0: i64, b0: i64) -> i64
    var a = a0
    var b = b0
    while a != b bound 128
        if mls.tm_level(a) <= mls.tm_level(b)
            a = treekem.rt_parent(a)
        else
            b = treekem.rt_parent(b)
    return a

fn tree_root(nodes: List[text]) -> i64 = ((nodes.len() - 1) / 2) as i64

# the LeafNode of a KeyPackage body, as a tree node ("01" + LeafNode)
fn kp_leaf_node(kp: List[i64]) -> text
    let p = treekem.skip_v(copy(kp), 4)
    return "01" + crypto.tohex(crypto.slice(copy(kp), p, treekem.leaf_end(kp, p)))

fn in_list(xs: List[i64], v: i64) -> bool
    for x in xs
        if x == v
            return true
    return false

# resolution excluding the leaves in ex (new members of this commit)
fn resolution_ex(nodes: List[text], x: i64, ex: List[i64]) -> List[i64]
    var out: List[i64] = []
    for y in treekem.resolution(nodes, x)
        if y % 2 == 1 or not in_list(copy(ex), y / 2)
            out.push(y)
    return out

fn filtered_path_ex(nodes: List[text], s: i64, ex: List[i64]) -> List[i64]
    let root = tree_root(copy(nodes))
    var out: List[i64] = []
    var x = 2 * s
    while x != root bound 64
        let q = treekem.rt_parent(x)
        let sb = treekem.rt_sibling(x, q)
        if resolution_ex(copy(nodes), sb, copy(ex)).len() > 0
            out.push(q)
            out.push(sb)
        x = q
    return out

fn blank_path(nodes: List[text], x0: i64) -> List[text]
    var t = nodes
    let root = tree_root(copy(t))
    var x = x0
    while x != root bound 64
        x = treekem.rt_parent(x)
        t[x as usize] = ""
    return t

fn with_unmerged(n: text, u: i64) -> text
    let f = treekem.nfields(copy(n))
    var um: List[i64] = []
    for x in treekem.unmerged(n)
        um = crypto.cat(um, treekem.u32b(x))
    um = crypto.cat(um, treekem.u32b(u))
    return "02" + crypto.tohex(crypto.cat(crypto.cat(treekem.ser_v(crypto.unhex(copy(f[0]))), treekem.ser_v(crypto.unhex(copy(f[1])))), treekem.ser_v(um)))

# the proposals of a Commit, resolved: "sender.proposal hex" (type included);
# refs maps ProposalRef hex to "sender.proposal hex"
fn commit_proposals(content: List[i64], s: i64, refs: text) -> List[text]
    let v = treekem.rd_v(copy(content), 0)
    let end = (v[0] + v[1]) as usize
    var p = v[1] as usize
    var out: List[text] = []
    while p < end bound 4096
        if content[p] == 1
            let e = framing.proposal_end(copy(content), p + 1)
            out.push(s.tostr() + "." + crypto.tohex(crypto.slice(copy(content), p + 1, e)))
            p = e
        else
            let r = crypto.tohex(treekem.get_v(copy(content), p + 1))
            out.push(kv_get(copy(refs), r))
            p = treekem.skip_v(copy(content), p + 1)
    return out

# ProposalRef of a proposal PublicMessage, and "sender.proposal hex"
fn proposal_ref(msg: text) -> List[text]
    let f = framing.mls_decode(copy(msg))
    let ac = crypto.cat(crypto.cat([0, 1], crypto.cat(treekem.ser_v(crypto.unhex(copy(f[1]))), crypto.unhex(copy(f[2])))), crypto.cat(crypto.cat(crypto.unhex(copy(f[3])), treekem.ser_v(crypto.unhex(copy(f[4])))), crypto.cat(crypto.unhex(copy(f[5])), crypto.cat(crypto.unhex(copy(f[6])), treekem.ser_v(crypto.unhex(copy(f[7])))))))
    let r = mls.ref_hash("MLS 1.0 Proposal Reference", crypto.tohex(ac))
    let sb = crypto.unhex(copy(f[3]))
    let sender = (sb[1] << 24) | (sb[2] << 16) | (sb[3] << 8) | sb[4]
    return [r, sender.tostr() + "." + copy(f[6])]

# apply resolved proposals in RFC order (12.3); returns the tree nodes
# followed by three entries: the new gce hex, the added leaves "a,b," and
# the PSK ids as hex joined by ","
fn apply_proposals(nodes: List[text], props: List[text], gce0: text) -> List[text]
    var t = nodes
    var gce = gce0
    for pr in copy(props)
        let pp = pr.split(".")
        let b = crypto.unhex(copy(pp[1]))
        if ((b[0] << 8) | b[1]) == 7
            gce = crypto.tohex(treekem.get_v(treekem.slice_i(b, 2), 0))
    for pr in copy(props)
        let pp = pr.split(".")
        let b = crypto.unhex(copy(pp[1]))
        if ((b[0] << 8) | b[1]) == 2
            let sx = copy(pp[0]).toint()
            t[(2 * sx) as usize] = "01" + crypto.tohex(treekem.slice_i(b, 2))
            t = blank_path(t, 2 * sx)
    var removed = false
    for pr in copy(props)
        let pp = pr.split(".")
        let b = crypto.unhex(copy(pp[1]))
        if ((b[0] << 8) | b[1]) == 3
            let r = (b[2] << 24) | (b[3] << 16) | (b[4] << 8) | b[5]
            t[(2 * r) as usize] = ""
            t = blank_path(t, 2 * r)
            removed = true
    if removed
        var go = true
        while go and t.len() > 1 bound 64
            var blank = true
            for i in (t.len() + 1) / 2..t.len()
                if t[i] != ""
                    blank = false
            if blank
                var half: List[text] = []
                for i in 0..(t.len() - 1) / 2
                    half.push(copy(t[i]))
                t = half
            else
                go = false
    var added = ""
    for pr in copy(props)
        let pp = pr.split(".")
        let b = crypto.unhex(copy(pp[1]))
        if ((b[0] << 8) | b[1]) == 1
            var free: i64 = -1
            var i: usize = 0
            while i < t.len() bound 4096
                if free < 0 and t[i] == ""
                    free = i as i64
                i += 2
            if free < 0
                free = (t.len() + 1) as i64
                let w = t.len() + 1
                for _ in 0..w
                    t.push("")
            t[free as usize] = kp_leaf_node(treekem.slice_i(b, 2))
            added = added + (free / 2).tostr() + ","
            let root = tree_root(copy(t))
            var y = free
            while y != root bound 64
                y = treekem.rt_parent(y)
                if t[y as usize] != ""
                    t[y as usize] = with_unmerged(copy(t[y as usize]), free / 2)
    var psks = ""
    for pr in copy(props)
        let pp = pr.split(".")
        let b = crypto.unhex(copy(pp[1]))
        if ((b[0] << 8) | b[1]) == 4
            psks = psks + crypto.tohex(treekem.slice_i(b, 2)) + ","
    t.push(gce)
    t.push(added)
    t.push(psks)
    return t

fn int_list(s: text) -> List[i64]
    var o: List[i64] = []
    for x in s.split(",")
        if x != ""
            o.push(copy(x).toint())
    return o

# PSK secret over PSK ids, external "id:psk," and resumption "epoch:secret,"
fn psk_secret_ids(ids: text, ext: text, res: text) -> List[i64]
    var list: List[text] = []
    for x in ids.split(",")
        if x != ""
            list.push(copy(x))
    var ps = mls.zero32()
    let n = list.len() as i64
    var i: i64 = 0
    for idh in list
        let idb = crypto.unhex(copy(idh))
        var key: List[i64] = []
        if idb[0] == 1
            key = crypto.unhex(kv_get(copy(ext), crypto.tohex(treekem.get_v(copy(idb), 1))))
        else
            let q = treekem.skip_v(copy(idb), 2)
            var e: i64 = 0
            for j in 0..8
                e = (e << 8) | idb[q + j]
            key = crypto.unhex(kv_get(copy(res), e.tostr()))
        let pin = mls.expand_label(mls.extract(mls.zero32(), key), "derived psk", crypto.cat(idb, [(i >> 8) & 255, i & 255, (n >> 8) & 255, n & 255]), 32)
        ps = mls.extract(pin, ps)
        i += 1
    return ps

fn group_context_x(gid: text, epoch: i64, th: text, cth: text, gce: text) -> text
    return crypto.tohex(crypto.cat(crypto.cat(crypto.cat([0, 1, 0, 1], treekem.ser_v(crypto.unhex(gid))), crypto.cat(welcome.u64b(epoch), treekem.ser_v(crypto.unhex(th)))), crypto.cat(treekem.ser_v(crypto.unhex(cth)), treekem.ser_v(crypto.unhex(gce)))))

# our new keys from an update path: decrypt at the first filtered node over
# our leaf, ratchet up; returns [held, commit secret] or [] if we cannot
fn path_receive(old: List[text], up: List[text], fp: List[i64], ex: List[i64], gc: text, me: i64, held0: text) -> List[text]
    var held = held0
    let m = fp.len() / 2
    for j in 0..m
        let sb = fp[2 * j + 1]
        let k = mls.tm_level(sb)
        if 2 * me >= sb - ((1 << k) - 1) and 2 * me <= sb + ((1 << k) - 1)
            let cts = up[j + 1].split("|")
            var pos: usize = 0
            for d in resolution_ex(copy(old), sb, copy(ex))
                let sk = kv_get(copy(held), d.tostr())
                if sk != ""
                    let kc = cts[pos + 1].split(",")
                    var ps = hpke.decrypt_with_label(sk, "UpdatePathNode", copy(gc), copy(kc[0]), copy(kc[1]))
                    for jj in j..m
                        held = kv_set(held, fp[2 * jj].tostr(), treekem.node_sk(copy(ps)))
                        ps = crypto.tohex(mls.derive_secret(crypto.unhex(ps), "path"))
                    return [held, ps]
                pos += 1
    return []

# a PublicMessage from a current member: signed by its leaf, with the
# membership tag under this epoch's membership key and GroupContext gc
fn authentic(msg: text, nodes: List[text], gc: text, mkey: text) -> bool
    let f = framing.mls_decode(copy(msg))
    if f.len() != 10
        return false
    let sb = crypto.unhex(copy(f[3]))
    if sb[0] != 1
        return false
    let s = (sb[1] << 24) | (sb[2] << 16) | (sb[3] << 8) | sb[4]
    if 2 * s >= nodes.len() as i64
        return false
    if nodes[(2 * s) as usize] == ""
        return false
    return protect.pub_ok(msg, gc, welcome.leaf_sig_key(nodes, s), mkey)
