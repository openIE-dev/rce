module compress.huffman

# DEFLATE fixed-Huffman blocks (RFC 1951 3.2.6), the actual compression cell.
# Literal-only fixed-Huffman encode + decode (no LZ77 matching yet). Bit packing
# LSB-first; Huffman codes MSB-first (reversed on write). Verified against
# Python zlib raw-deflate vectors and round-trip.

fn rev_bits(v: i64, n: usize) -> i64
    var r: i64 = 0
    var x = v
    var k: usize = 0
    while k < n bound 16
        r = (r << 1) | (x & 1)
        x = x >> 1
        k += 1
    return r

# fixed lit/len code -> [code, nbits]
fn fixed_code(lit: i64) -> List[i64]
    if lit <= 143
        return [48 + lit, 8]
    if lit <= 255
        return [400 + lit - 144, 9]
    if lit <= 279
        return [lit - 256, 7]
    return [192 + lit - 280, 8]

fn push_bits(out: &mut List[i64], acc: i64, nbits: usize, val: i64, n: usize) -> List[i64]
    var a = acc | (val << nbits)
    var nb = nbits + n
    while nb >= 8 bound 64
        out.append(a & 255)
        a = a >> 8
        nb -= 8
    return [a, nb as i64]

pub fn deflate_fixed(data: &[i64]) -> List[i64]
    var out: List[i64] = []
    var acc: i64 = 0
    var nb: usize = 0
    let h = push_bits(&mut out, acc, nb, 3, 3)
    acc = copy(h[0])
    nb = copy(h[1]) as usize
    for x in data
        let fc = fixed_code(x)
        let code = rev_bits(copy(fc[0]), copy(fc[1]) as usize)
        let r = push_bits(&mut out, acc, nb, code, copy(fc[1]) as usize)
        acc = copy(r[0])
        nb = copy(r[1]) as usize
    let e = fixed_code(256)
    let ec = rev_bits(copy(e[0]), copy(e[1]) as usize)
    let r2 = push_bits(&mut out, acc, nb, ec, copy(e[1]) as usize)
    acc = copy(r2[0])
    nb = copy(r2[1]) as usize
    if nb > 0
        out.append(acc)
    return out

fn read_bit(data: &[i64], bp: usize) -> List[i64]
    let byte = copy(data[bp / 8])
    let bit = (byte >> (bp % 8)) & 1
    return [bit, (bp + 1) as i64]

fn decode_lit(data: &[i64], bp: usize) -> List[i64]
    var code: i64 = 0
    var p = bp
    var n: usize = 0
    while n < 9 bound 9
        let rb = read_bit(data, p)
        code = code * 2 + copy(rb[0])
        p = copy(rb[1]) as usize
        n += 1
        if n == 7
            if code <= 23
                return [code + 256, p as i64]
        if n == 8
            if code >= 48
                if code <= 191
                    return [code - 48, p as i64]
            if code >= 192
                if code <= 199
                    return [code - 192 + 280, p as i64]
        if n == 9
            if code >= 400
                if code <= 511
                    return [code - 400 + 144, p as i64]
    return [256, p as i64]

pub fn inflate_fixed(data: &[i64]) -> List[i64]
    var out: List[i64] = []
    var bp: usize = 3
    var go: bool = true
    while go bound 67108864
        let r = decode_lit(data, bp)
        let lit = copy(r[0])
        bp = copy(r[1]) as usize
        if lit == 256
            go = false
        else
            out.append(lit)
    return out

# ---------------- spectests (Python zlib raw-deflate vectors) ----------------

const EMPTY: List[i64] = []
const A: List[i64] = [65]
const HELLO: List[i64] = [104, 101, 108, 108, 111]

const DE: List[i64] = deflate_fixed(&EMPTY)
const DA: List[i64] = deflate_fixed(&A)
const DH: List[i64] = deflate_fixed(&HELLO)

check DE == [3, 0]
check DA == [115, 4, 0]
check DH == [203, 72, 205, 201, 201, 7, 0]
check inflate_fixed(&DE) == EMPTY
check inflate_fixed(&DA) == A
check inflate_fixed(&DH) == HELLO