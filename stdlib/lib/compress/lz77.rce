module compress.lz77

# LZ77 sliding-window compression (the matching engine behind DEFLATE/gzip).
# Greedy longest-match: tokens are [0, byte] literals or [1, length, distance]
# matches (length >= 3). Overlapping matches allowed (run-length). Round-trip
# verified. Pure, total, bounded. (DEFLATE bit-encoding of these tokens is the
# huffman module's job; this is the compression proper.)

pub fn lz77_encode(data: &[i64], window: usize) -> List[List[i64]]
    var out: List[List[i64]] = []
    var pos: usize = 0
    while pos < data.len() bound 67108864
        var best_len: usize = 0
        var best_dist: usize = 0
        var start: usize = 0
        if pos > window
            start = pos - window
        var s: usize = start
        while s < pos bound 67108864
            var l: usize = 0
            while pos + l < data.len() bound 258
                if copy(data[s + l]) == copy(data[pos + l])
                    l += 1
                else
                    break
            if l > best_len
                best_len = l
                best_dist = pos - s
            s += 1
        if best_len >= 3
            out.append([1, best_len as i64, best_dist as i64])
            pos += best_len
        else
            out.append([0, copy(data[pos])])
            pos += 1
    return out

pub fn lz77_decode(tokens: &List[List[i64]]) -> List[i64]
    var out: List[i64] = []
    for t in tokens
        let tt = copy(t)
        if copy(tt[0]) == 0
            out.append(copy(tt[1]))
        else
            let len = copy(tt[1]) as usize
            let dist = copy(tt[2]) as usize
            var k: usize = 0
            while k < len bound 258
                let src = out.len() - dist
                out.append(copy(out[src]))
                k += 1
    return out

# ---------------- spectests (round-trip + compression) ----------------

const ABAB: List[i64] = [97, 98, 97, 98, 97, 98, 97, 98]
const RUN: List[i64] = [120, 120, 120, 120, 120, 120, 120]
const MIX: List[i64] = [1, 2, 3, 1, 2, 3, 1, 2, 3, 4, 5]
const EMPTY: List[i64] = []
const SINGLE: List[i64] = [42]

const E_ABAB: List[List[i64]] = lz77_encode(&ABAB, 32)
const E_RUN: List[List[i64]] = lz77_encode(&RUN, 32)
const E_MIX: List[List[i64]] = lz77_encode(&MIX, 32)

check lz77_decode(&E_ABAB) == ABAB
check lz77_decode(&E_RUN) == RUN
check lz77_decode(&E_MIX) == MIX
const E_EMPTY: List[List[i64]] = lz77_encode(&EMPTY, 32)
const E_SINGLE: List[List[i64]] = lz77_encode(&SINGLE, 32)
check lz77_decode(&E_EMPTY) == EMPTY
check lz77_decode(&E_SINGLE) == SINGLE
# "abababab" compresses: 2 literals + one match of length 6
check E_ABAB.len() == 3
# "xxxxxxx" compresses to literal + match(6,1)
check E_RUN.len() == 2