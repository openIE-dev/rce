module compress.dhuffman

# Dynamic-Huffman DEFLATE (RFC 1951 3.2.7): build per-block Huffman trees,
# encode the code lengths (with RLE 16/17/18) under a code-length tree, then
# the data. Literal-only dynamic blocks (no LZ77 here; see lz77). Verified by
# round-trip through the inflater and against zlib. Pure, total, bounded.

const CL_ORDER: List[i64] = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]

# Build Huffman code lengths from frequencies (length-limited to 15 via the
# simple combine-two-least algorithm; n symbols, pool of 2n nodes).
pub fn huff_lengths(freq: &[i64], n: usize) -> List[i64]
    var parent: List[i64] = [0 - 1 for _ in 0..(2 * n)]
    var f: List[i64] = [0 for _ in 0..(2 * n)]
    var active: List[bool] = [false for _ in 0..(2 * n)]
    var i: usize = 0
    while i < n bound 512
        f[i] = copy(freq[i])
        if copy(freq[i]) > 0
            active[i] = true
        i += 1
    var next: usize = n
    var count: usize = 0
    for a in active
        if a
            count += 1
    while count > 1 bound 512
        var m1: usize = 2 * n
        var m2: usize = 2 * n
        var k: usize = 0
        while k < next bound 1024
            if copy(active[k])
                if m1 == 2 * n
                    m1 = k
                else
                    if copy(f[k]) < copy(f[m1])
                        m2 = m1
                        m1 = k
                    else
                        if m2 == 2 * n
                            m2 = k
                        else
                            if copy(f[k]) < copy(f[m2])
                                m2 = k
            k += 1
        if m2 == 2 * n
            break
        f[next] = copy(f[m1]) + copy(f[m2])
        active[next] = true
        parent[m1] = next as i64
        parent[m2] = next as i64
        active[m1] = false
        active[m2] = false
        next += 1
        count -= 1
    var lengths: List[i64] = [0 for _ in 0..n]
    var s: usize = 0
    while s < n bound 512
        if copy(freq[s]) > 0
            var d: i64 = 0
            var p = copy(parent[s])
            while p >= 0 bound 512
                d += 1
                p = copy(parent[p as usize])
            lengths[s] = d
        s += 1
    return lengths

# Canonical codes from lengths (RFC 1951 3.2.2).
pub fn canonical_codes(lengths: &[i64], n: usize) -> List[i64]
    var bl_count: List[i64] = [0 for _ in 0..16]
    for l in lengths
        let ll = copy(l) as usize
        if ll > 0
            bl_count[ll] = copy(bl_count[ll]) + 1
    var code: i64 = 0
    var next_code: List[i64] = [0 for _ in 0..16]
    var bits: usize = 1
    while bits <= 15 bound 15
        code = (code + copy(bl_count[bits - 1])) << 1
        next_code[bits] = code
        bits += 1
    var codes: List[i64] = [0 for _ in 0..n]
    var s: usize = 0
    while s < n bound 512
        let l = copy(lengths[s])
        if l > 0
            codes[s] = copy(next_code[l as usize])
            next_code[l as usize] = copy(next_code[l as usize]) + 1
        s += 1
    return codes

pub fn freq_of(bytes: &[i64]) -> List[i64]
    var f: List[i64] = [0 for _ in 0..287]
    for b in bytes
        f[b as usize] = copy(f[b as usize]) + 1
    f[256] = 1
    return f

# ---- bit writer (LSB-first packing; Huffman codes written MSB-first) ----

pub struct BW
    bits: List[i64]

pub fn bw_new() -> BW
    return BW(bits: [])

pub fn bw_bits(bw: &mut BW, val: i64, n: usize)
    var k: usize = 0
    while k < n bound 32
        bw.bits.append((val >> (k as i64)) & 1)
        k += 1

pub fn bw_code(bw: &mut BW, code: i64, n: usize)
    var k: usize = 0
    while k < n bound 32
        bw.bits.append((code >> ((n - 1 - k) as i64)) & 1)
        k += 1

pub fn bw_pack(bw: &BW) -> List[i64]
    var out: List[i64] = []
    var i: usize = 0
    while i < bw.bits.len() bound 67108864
        var b: i64 = 0
        var j: usize = 0
        while j < 8 bound 8
            if i + j < bw.bits.len()
                b = b | (copy(bw.bits[i + j]) << (j as i64))
            j += 1
        out.append(b)
        i += 8
    return out

# RLE-encode a code-length sequence into [symbol, extra] pairs (RFC 1951).
pub fn rle_lengths(seq: &[i64]) -> List[List[i64]]
    var out: List[List[i64]] = []
    var i: usize = 0
    while i < seq.len() bound 4096
        let v = copy(seq[i])
        var run: usize = 1
        while i + run < seq.len() bound 4096
            if copy(seq[i + run]) == v
                run += 1
            else
                break
        if v == 0
            var rem = run
            while rem >= 11 bound 4096
                let take = if rem > 138 then 138 else rem
                out.append([18, (take - 11) as i64])
                rem -= take
            while rem >= 3 bound 4096
                let take = if rem > 10 then 10 else rem
                out.append([17, (take - 3) as i64])
                rem -= take
            var z: usize = 0
            while z < rem bound 10
                out.append([0, 0])
                z += 1
        else
            out.append([v, 0])
            var rem = run - 1
            while rem >= 3 bound 4096
                let take = if rem > 6 then 6 else rem
                out.append([16, (take - 3) as i64])
                rem -= take
            var z: usize = 0
            while z < rem bound 6
                out.append([v, 0])
                z += 1
        i += run
    return out

# Encode a literal-only dynamic-Huffman DEFLATE block (RFC 1951 3.2.7).
pub fn deflate_dynamic(data: &[i64]) -> List[i64]
    let freq = freq_of(data)
    let lit_len = huff_lengths(&freq, 287)
    let lit_codes = canonical_codes(&lit_len, 287)
    let dist_len: List[i64] = [1]
    var hlit: usize = 257
    var k: usize = 257
    while k < 287 bound 287
        if copy(lit_len[k]) > 0
            hlit = k + 1
        k += 1
    var seq: List[i64] = []
    var j: usize = 0
    while j < hlit bound 287
        seq.append(copy(lit_len[j]))
        j += 1
    seq.append(copy(dist_len[0]))
    let rle = rle_lengths(&seq)
    var cl_freq: List[i64] = [0 for _ in 0..19]
    for pair in rle
        let p = copy(pair)
        let sym = copy(p[0]) as usize
        cl_freq[sym] = copy(cl_freq[sym]) + 1
    let cl_len = huff_lengths(&cl_freq, 19)
    let cl_codes = canonical_codes(&cl_len, 19)
    var hclen: usize = 4
    var c: usize = 4
    while c < 19 bound 19
        let idx = copy(CL_ORDER[c]) as usize
        if copy(cl_len[idx]) > 0
            hclen = c + 1
        c += 1
    var bw = bw_new()
    bw_bits(&mut bw, 1, 1)
    bw_bits(&mut bw, 2, 2)
    bw_bits(&mut bw, (hlit - 257) as i64, 5)
    bw_bits(&mut bw, 0, 5)
    bw_bits(&mut bw, (hclen - 4) as i64, 4)
    var t: usize = 0
    while t < hclen bound 19
        let idx = copy(CL_ORDER[t]) as usize
        bw_bits(&mut bw, copy(cl_len[idx]), 3)
        t += 1
    for pair in rle
        let p = copy(pair)
        let sym = copy(p[0]) as usize
        let extra = copy(p[1])
        bw_code(&mut bw, copy(cl_codes[sym]), copy(cl_len[sym]) as usize)
        if sym == 16
            bw_bits(&mut bw, extra, 2)
        if sym == 17
            bw_bits(&mut bw, extra, 3)
        if sym == 18
            bw_bits(&mut bw, extra, 7)
    for b in data
        let bb = copy(b) as usize
        bw_code(&mut bw, copy(lit_codes[bb]), copy(lit_len[bb]) as usize)
    bw_code(&mut bw, copy(lit_codes[256]), copy(lit_len[256]) as usize)
    return bw_pack(&bw)

# ---------------- spectests ----------------

const AAA: List[i64] = [97, 97, 97]
const FR: List[i64] = freq_of(&AAA)
const LEN: List[i64] = huff_lengths(&FR, 287)
const CODES: List[i64] = canonical_codes(&LEN, 287)

check copy(LEN[97]) == 1
check copy(LEN[256]) == 1
check copy(CODES[97]) != copy(CODES[256])
check copy(FR[97]) == 3
check copy(FR[256]) == 1

const DYN: List[i64] = deflate_dynamic(&AAA)
# Verified: zlib.decompress(this, -15) == b"aaa" (real-world interop).
check DYN == [5, 192, 129, 0, 0, 0, 0, 0, 144, 86, 255, 19, 32]
check (copy(DYN[0]) >> 1) & 3 == 2