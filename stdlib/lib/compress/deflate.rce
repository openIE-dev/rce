module compress.deflate

# DEFLATE (RFC 1951) stored-block codec, P0 compression gap (first step).
# Encodes raw bytes as uncompressed stored blocks (BTYPE=00), the literal
# foundation a full LZ77+Huffman compressor builds on; decodes stored blocks.
# Round-trip verified; Adler-32 (RFC 1950) for zlib wrappers. Fixed-Huffman
# and dynamic-Huffman blocks (the actual compression) are follow-up work.

const MAX_BLOCK: usize = 65535

pub fn deflate_store(data: &[i64]) -> List[i64]
    var out: List[i64] = []
    var n = data.len()
    if n == 0
        out.append(1)
        out.append(0)
        out.append(0)
        out.append(255)
        out.append(255)
        return out
    var pos: usize = 0
    while pos < n bound 67108864
        var rem = n - pos
        var len = if rem > MAX_BLOCK then MAX_BLOCK else rem
        var is_final: i64 = if pos + len >= n then 1 else 0
        out.append(is_final)
        out.append((len % 256) as i64)
        out.append((len / 256) as i64)
        let nl = 65535 - (len as i64)
        out.append(nl % 256)
        out.append(nl / 256)
        var k: usize = 0
        while k < len bound 65536
            out.append(copy(data[pos + k]))
            k += 1
        pos += len
    return out

pub fn inflate_store(data: &[i64]) -> List[i64]
    var out: List[i64] = []
    var pos: usize = 0
    while pos < data.len() bound 67108864
        let hdr = copy(data[pos])
        pos += 1
        let len = (copy(data[pos]) + copy(data[pos + 1]) * 256) as usize
        pos += 4
        var k: usize = 0
        while k < len bound 65536
            out.append(copy(data[pos + k]))
            k += 1
        pos += len
        if (hdr & 1) == 1
            break
    return out

pub fn adler32(data: &[i64]) -> i64
    var a: i64 = 1
    var b: i64 = 0
    for x in data
        a = (a + x) % 65521
        b = (b + a) % 65521
    return (b * 65536) + a

# ---------------- spectests ----------------

const EMPTY: List[i64] = []
const HI: List[i64] = [104, 105]
const ABC: List[i64] = [97, 98, 99]

const D_EMPTY: List[i64] = deflate_store(&EMPTY)
const D_HI: List[i64] = deflate_store(&HI)
const D_ABC: List[i64] = deflate_store(&ABC)

# stored empty block: 01 00 00 FF FF
check D_EMPTY == [1, 0, 0, 255, 255]
# stored "hi": final header 01, LEN 02 00, NLEN FD FF, then 104 105
check D_HI == [1, 2, 0, 253, 255, 104, 105]
check inflate_store(&D_EMPTY) == EMPTY
check inflate_store(&D_HI) == HI
check inflate_store(&D_ABC) == ABC
check adler32(&EMPTY) == 1
check adler32(&HI) == 20644050
check adler32(&ABC) == 38600999