error E
fn bump(x: &mut i64, k: i64) -> i64 ! E
    x += k
    if x > 5
        fail E
    return x + 0

fn main()
    var a: i64 = 0
    let r = bump(&mut a, 0) catch -1
    emit r.tostr()
    emit a.tostr()
