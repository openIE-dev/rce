state S
    n: u8 = 0
event Tick
step S on Tick
    n = (n + 1) % 4

law small
    always n < 3
#--- rce-test
# id: properties/t63-law-mod4-lt3
# area: properties
# clauses: [T63]
# expect: cli
# seq: [{"argv": ["law", "main.rce"]}]
# output_has:
#   - "fails"
# provenance: property: T63, bounded exhaustive over k in 2..6 and bound in {k-1, k} (this test k = 4, bound 3): the oracle says `always n < 3` fails at n = 3 for a counter mod 4; rce law decides the same.
#---
