state S
    n: u8 = 0
event Tick
step S on Tick
    n = (n + 1) % 3

law small
    always n < 2
#--- rce-test
# id: properties/t63-law-mod3-lt2
# area: properties
# clauses: [T63]
# expect: cli
# seq: [{"argv": ["law", "main.rce"]}]
# output_has:
#   - "fails"
# provenance: property: T63, bounded exhaustive over k in 2..6 and bound in {k-1, k} (this test k = 3, bound 2): the oracle says `always n < 2` fails at n = 2 for a counter mod 3; rce law decides the same.
#---
