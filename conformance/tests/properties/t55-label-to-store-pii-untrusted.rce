struct Declass
struct Vouch
label pii by Declass
label untrusted by Vouch
state Log
    shown: i64 = 0
event Show(p: i64, code: i64 @ {pii, untrusted})
step Log on Show(p: _p, code: c)
    shown = c
#--- rce-test
