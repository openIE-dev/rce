state S
    n: i64 = 0
event Inc
event Dec
step S on Inc
    n = (n + 1) % 4
    emit n.tostr()
step S on Dec
    n = (n + 3) % 4
    emit n.tostr()
#--- rce-test
# id: properties/t57-unfold-w11
# area: properties
# clauses: [T57]
# expect: cli
# seq: [{"argv": ["run", "main.rce", "Dec, Inc, Dec"]}]
# status: 0
# output_has:
#   - "1 Dec S { n = 3 }\n  emit \"3\""
#   - "2 Inc S { n = 0 }\n  emit \"0\""
#   - "3 Dec S { n = 3 }\n  emit \"3\""
# provenance: property: T57, bounded exhaustive over every word over {Inc, Dec} of length 1 to 3 (14 words; this test Dec Inc Dec): the run's outputs are those of the model beh(s, e.w) = lambda(s, e) . beh(delta(s, e), w) of a mod-4 counter.
#---
