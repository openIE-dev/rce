struct Declass
label pii by Declass
state S
    seen: i64 = 0
    hid: i64 @ {pii} = 0
event Show(p: i64, code: i64 @ {pii})
step S on Show(p: v, code: c)
    seen = seen + v
    hid = c
    emit v.tostr()
