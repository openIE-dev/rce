state S
    n: u8 = 0
event Tick
step S on Tick
    n = (n + 1) % 6

law small
    always n < 6
#--- rce-test
# id: properties/t63-law-mod6-lt6
# area: properties
# clauses: [T63]
# expect: cli
# seq: [{"argv": ["law", "main.rce"]}]
# output_has:
#   - "holds"
# provenance: property: T63, bounded exhaustive over k in 2..6 and bound in {k-1, k} (this test k = 6, bound 6): the oracle says `always n < 6` holds for a counter mod 6; rce law decides the same.
#---
