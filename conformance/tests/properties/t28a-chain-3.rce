protocol Ask
    send i64
    recv i64

protocol Answer
    recv i64
    send i64

fn server(s: session Answer)
    let x = <- s
    s <- x + 1

fn main()
    var v: i64 = 0
    let (c0, s0) = chan[session Ask](1)
    spawn server(s0)
    c0 <- v
    v = <- c0
    let (c1, s1) = chan[session Ask](1)
    spawn server(s1)
    c1 <- v
    v = <- c1
    let (c2, s2) = chan[session Ask](1)
    spawn server(s2)
    c2 <- v
    v = <- c2
    emit v
#--- rce-test
# id: properties/t28a-chain-3
# area: properties
# clauses: [T28a]
# expect: cli
# seq: [{"argv": ["run", "main.rce"]}]
# status: 0
# output_has:
#   - "emit 3"
# provenance: property: T28a, bounded exhaustive over chains of 1 to 3 sessions driven by one coordinator (this test 3); the configuration of message-only participants always steps to the end and the coordinator receives v = 3 in send order. Global type syntax is not in the grammar, so the participants are written as their projections.
#---
