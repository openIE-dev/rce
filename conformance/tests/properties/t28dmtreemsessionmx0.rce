protocol Ask
    send i64
    recv i64

protocol Answer
    recv i64
    send i64

fn server(s: session Answer)
    let x = <- s
    s <- x * 2

fn main()
    let (c, s) = chan[session Ask](1)
    spawn server(s)
    c <- 0
    let r = <- c
    emit r
