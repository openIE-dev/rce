state S
    n: u8 = 0
event Tick
step S on Tick
    n = (n + 1) % 2

law small
    always n < 2
#--- rce-test
# id: properties/t63-law-mod2-lt2
# area: properties
# clauses: [T63]
# expect: cli
# seq: [{"argv": ["law", "main.rce"]}]
# output_has:
#   - "holds"
# provenance: property: T63, bounded exhaustive over k in 2..6 and bound in {k-1, k} (this test k = 2, bound 2): the oracle says `always n < 2` holds for a counter mod 2; rce law decides the same.
#---
