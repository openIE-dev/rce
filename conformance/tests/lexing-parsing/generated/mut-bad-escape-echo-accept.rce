module echo

intent "an effect request is an emitted struct with a req id; the host answers each with exactly one EchoDone"
    example Say(msg: "hi"), EchoDone(req: 1, status: "failed", data: none, err: "x") -> failed == 1

struct Echo
    req: u64
    msg: text

event Say(msg: text)
event EchoDone(req: u64, status: text, data: text?, err: text)

state S
    next: u64 = 0
    got: List[text] = []
    failed: u64 = 0

step S on Say(msg: m)
    next += 1
    emit Echo(req: next, msg: m)

step S on EchoDone(req: r, status: st, data: d, err: e)
    if st == "delivered"
        got.push(d.or(""))
    else
        failed += 1

const BAD_U = "\u{110000}"
