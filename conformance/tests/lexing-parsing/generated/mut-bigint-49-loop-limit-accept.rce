# A program can raise or lower the default loop limit.
const LOOP_LIMIT: u64 = 5000000

fn count(n: u64) -> u64
    var k: u64 = 0
    while k < n
        k += 1
    return k

check count(2000000) == 2000000

const BIG_LIT = 99999999999999999999999
