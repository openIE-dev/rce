# f32 arithmetic: computed in f64 and rounded once, so every target agrees bit for bit.
fn axpy(a: f32, x: f32, y: f32) -> f32
    return a * x + y

check axpy(2.0 as f32, 0.1 as f32, 1.0 as f32) == 1.2 as f32
check (0.1 as f32) as f64 != 0.1
check (16777217 as f32) as i64 == 16777216
