const BIG: u8 = 200
const LIMIT = 5

kind Shape
    Circle(r: f64)
    Square(side: f64)
    Dot

fn area(s: Shape) -> f64
    match s
        Circle(r: r) -> return 3.0 * r * r
        Square(side: x) -> return x * x
        Dot -> return 0.0

fn over() -> u8 = BIG + BIG

fn spin() -> u64
    var n: u64 = 0
    while true bound 10
        n += 1
    return n

fn adder(k: i64) -> List[i64]
    let f = fn(x: i64) => x + k
    return [1, 2, 3].map(f)

fn bump(x: &mut i64)
    x += 10

fn caller() -> i64
    var a: i64 = 1
    bump(&mut a)
    bump(&mut a)
    return a

fn texts() -> text = "a\tb \u{1F600} " + "x"

fn shapes() -> List[f64] = [area(Circle(r: 1.5)), area(Square(side: 2.0)), area(Dot)]

fn floats() -> List[f64] = [1.0 / 3.0, 1e20, 0.0001, 2.5e-7, -0.0]

fn nums() -> List[i64] = [7 / 2, -7 / 2, 7 % 3, -7 % 3, 1 << 4, 255 & 15]

fn sorted() -> List[i64]
    var xs: List[i64] = [3, 1, 2]
    xs.sort()
    xs.push(9)
    return xs

fn mapped() -> Map[text, i64]
    var m: Map[text, i64] = {"a": 1}
    m["b"] = 2
    m["a"] += 5
    return m

check caller() == 21

fn wide() -> u64
    let a: u64 = 18446744073709551615
    return a * a

fn wide_sat() -> u64
    let a: u64 = 18446744073709551615
    return a.saturating_mul(a)

fn wide_wrap() -> u64
    let a: u64 = 18446744073709551615
    return a.wrapping_mul(a)

fn fminmax() -> List[f64]
    let a: f64 = 2.5
    return [a.min(-1.0), a.max(-1.0), a.min(2.5), 1e300.max(1e-300)]

fn imin_rem() -> i64
    let m: i64 = -9223372036854775807 - 1
    return m % -1
