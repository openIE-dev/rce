kind Shape
    Circle(r: f64)
    Rect(w: f64, h: f64)
    Empty

fn area(s: &Shape) -> f64
    match s
        Circle(r: r) -> 3.141592653589793 * r * r
        Rect(w: w, h: h) -> w * h
        Empty -> 0.0

const BIG_LIT = 99999999999999999999999
