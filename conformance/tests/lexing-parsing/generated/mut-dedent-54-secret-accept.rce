# rce-version: 0.8
module login

intent "secrets are opaque (5.16): no literal can make one, no output can carry one, equality is the one release"
    example Enroll(pw: "s3cret"), Login(pw: "s3cret") -> ok == 1
    example Enroll(pw: "s3cret"), Login(pw: "guess") -> failed == 1

state Vault
    stored: Secret[text]? = none
    ok: u32 = 0
    failed: u32 = 0

event Enroll(pw: Secret[text])
event Login(pw: Secret[text])

step Vault on Enroll(pw: p)
    stored = some(p)
step Vault on Login(pw: p)
    if stored == some(p)
        ok += 1
      else
        failed += 1
