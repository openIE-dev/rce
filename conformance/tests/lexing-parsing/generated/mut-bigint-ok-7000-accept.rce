# Host-independent evaluation depth (interp::EVAL_DEPTH): 7,000 nested calls
# fit on every host; see tests/eval_depth.rs.
fn down(n: i64) -> i64 bound 100000000
    if n <= 0
        return 0
    return 1 + down(n - 1)

check down(7000) == 7000

const BIG_LIT = 99999999999999999999999
