# A device region holds fixed-size values only and performs no effects.
fn dot4(a: [f32; 4], b: [f32; 4]) -> f32
    var acc: f32 = 0 as f32
    with device gpu bound 4096
        let p: [f32; 4] = a * b
        for x in p
            acc = acc + x
    return acc

check dot4([1.0 as f32, 2.0 as f32, 3.0 as f32, 4.0 as f32], [1.0 as f32, 1.0 as f32, 1.0 as f32, 1.0 as f32]) == 10.0 as f32
