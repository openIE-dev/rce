fn freq(words: &[text]) -> Map[text, u32]
    var m: Map[text, u32] = {}
    for w in words
        m[w] = (m.get(w) catch 0) + 1
      return m

fn table() -> Map[text, i64] = {"a": 1, "b": 2,}
