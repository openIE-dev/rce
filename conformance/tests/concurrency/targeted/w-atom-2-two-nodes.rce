# rce-version: 0.6
event Add(k: i64)
actor A
    n: i64 = 0
    on Add(k: k) -> n + k
actor B
    n: i64 = 0
    on Add(k: k) -> n + k
node east { A }
node west { B }
fn main()
    let a = A()
    let b = B()
    atomic
        a <- Add(k: 1)
        b <- Add(k: 2)
