# rce-version: 0.6
struct V
    k: i64
    n: i64
impl Merge for V
    fn merge(self, o: V) -> V = if self.k > o.k then self else (if o.k > self.k then o else V(k: self.k, n: self.n.max(o.n)))
    fn bottom() -> V
        V(k: 0, n: 0)
