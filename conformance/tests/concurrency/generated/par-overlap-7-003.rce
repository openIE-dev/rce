# rce-version: 0.6
fn main()
    var v0: i64 = 11
    var v1: i64 = 11
    var v2: i64 = -11
    var acc: List[i64] = [1, 2, 1, 5, 4]
    par
        branch b0
            for x in acc
                v0 = v0 - x * 2
        branch b1
            for x in acc
                v0 = v0 + x * 2
        branch b2
            for x in acc
                v2 = v2 - x * 2
    emit v0
    emit v1
    emit v2
