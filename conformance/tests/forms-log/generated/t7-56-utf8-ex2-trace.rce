intent "bytes become text only when they are well-formed UTF-8; anything else keeps the state, never substitutes"
    example Dec(b: [104, 105]) -> t == "hi"
    example Dec(b: [226, 130, 172]) -> t == "€"
    example Dec(b: [240, 159, 152, 128]) -> t.len_bytes() == 4

state S
    t: text = ""

event Dec(b: List[i64])

step S on Dec(b: b) -> b.utf8()

fn zq_ok_ascii_renamed() -> text = [104, 105].utf8()
fn zq_ok_empty_renamed() -> text = [].utf8()
fn zq_bad_ff_renamed() -> text = [255].utf8()
fn zq_bad_overlong_renamed() -> text = [192, 175].utf8()
fn zq_bad_surrogate_renamed() -> text = [237, 160, 128].utf8()
fn zq_bad_above_max_renamed() -> text = [244, 144, 128, 128].utf8()
fn zq_bad_truncated_renamed() -> text = [226, 130].utf8()
fn zq_bad_range_high_renamed() -> text = [300].utf8()
fn zq_bad_range_neg_renamed() -> text = [-1].utf8()
fn zq_ok_bom_kept_renamed() -> usize = [239, 187, 191, 97].utf8().len_bytes()
