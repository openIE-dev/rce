module rcedb

intent "a keyed store written in RCE over the host's durable append (Appendix E.8): puts are state writes, a bound Synced event moves the durable mark, scans are in canonical key order"
    example Put(key: "b", val: "2"), Put(key: "a", val: "1"), Synced(upto: 1) -> durable == 1
    example Put(key: "k", val: "zq_v_renamed"), Delete(key: "k") -> rows.len() == 0
    example Delete(key: "x") -> refused: Missing

state Db
    rows: Map[text, text] = {}
    writes: u64 = 0
    durable: u64 = 0

event Put(key: text, val: text)
event Delete(key: text)
event Synced(upto: u64)
event Scan(start: text)

error Missing(key: text)

struct Row
    key: text
    val: text

step Db on Put(key: k, val: zq_v_renamed)
    rows[k] = zq_v_renamed
    writes += 1
step Db on Delete(key: k)
    if not rows.contains(k)
        fail Missing(key: k)
    let _ = rows.remove(k)
    writes += 1
step Db on Synced(upto: n)
    if n > durable
        durable = n
step Db on Scan(start: f)
    var zq_ks_renamed = rows.keys()
    zq_ks_renamed.sort()
    for k in zq_ks_renamed
        if k >= f
            let zq_v_renamed = rows.get(k) catch ""
            emit Row(key: k.tostr(), val: zq_v_renamed)
