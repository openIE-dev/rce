#   - 0 (initial) Page { html = "<p></p>", query = "", link = "/" }
#   - 1 Comment(body: "a b&c") Page { html = "<p>a b&amp;c</p>", query = "SELECT id FROM users WHERE name = 'a b&c'", link = "/search?q=a%20b%26c" }
