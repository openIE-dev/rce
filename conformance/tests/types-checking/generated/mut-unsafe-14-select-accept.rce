fn merge(a: chan text, b: chan text, out: chan text)
    loop bound 1000
        select
            recv some(x) from a -> out <- x
            recv some(y) from b -> out <- y
            recv none from a -> break
            after 10 -> emit "idle"

fn unsafe_probe() -> i64
    let unsafe = 1
    return unsafe
