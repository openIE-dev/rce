fn split(xs: &[i64]) -> (i64, i64)
    var lo: i64 = 0
    var hi: i64 = 0
    par
        branch left
            for x in xs
                lo += x
        branch right
            for x in xs
                hi = hi.saturating_add(x)
    (lo, hi)

fn dup_zz() -> i64
    return 1

fn dup_zz() -> i64
    return 2
