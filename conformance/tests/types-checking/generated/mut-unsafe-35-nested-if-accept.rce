fn grade(score: u32) -> text
    if score >= 90
        return "A"
    elif score >= 80
        return "B"
    elif score >= 70
        if score == 77
            return "lucky C"
        return "C"
    else
        return "F"

fn unsafe_probe() -> i64
    let unsafe = 1
    return unsafe
