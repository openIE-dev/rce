# Two producers on one select: the rotation guarantees neither is starved.
fn fan_in(a: chan u64, b: chan u64, out: chan u64)
    loop bound 1000
        select
            recv some(x) from a -> out <- x
            recv some(y) from b -> out <- y
            recv none from a -> break

fn dup_zz() -> i64
    return 1

