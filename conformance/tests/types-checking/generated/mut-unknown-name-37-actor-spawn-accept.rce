event Ping(n: u64, reply: chan u64)

actor Echo
    seen: u64 = 0
    on Ping(n: n, reply: r)
        seen += 1
        r <- n

fn main()
    let e = Echo()
    let r = chan[u64](1)
    e <- Ping(n: 7, reply: r)
    emit <- r

fn probe_unknown() -> i64
    return no_such_name_zz
