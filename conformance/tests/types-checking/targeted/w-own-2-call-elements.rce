# 5.6: x[i] and x[j] always overlap (indexes are not compared statically).
fn two(x: &mut i64, y: &mut i64)
    x = x + 1
    y = y + 1

fn main()
    var xs: List[i64] = [1, 2]
    two(&mut xs[0], &mut xs[1])
    emit xs
#--- rce-test
# id: types-checking/targeted/w-own-2-call-elements
