# 5.6: a `let` borrow of a state list element whose index variable changes
# after the `let`: the write through it lands in the element read at the
# `let`, and the whole trace (with fuel) is the same on every adapter.
intent "let borrow of a state element"
    example Hit(k: 1), Hit(k: 1), Hit(k: 2) -> xs[1] == 2

state S
    xs: List[i64] = [0, 0, 0]
    i: usize = 0

event Hit(k: usize)

fn bump(x: &mut i64)
    x = x + 1

step S on Hit(k: k)
    i = k
    let e = &mut xs[i]
    i = 0
    bump(e)
#--- rce-test
