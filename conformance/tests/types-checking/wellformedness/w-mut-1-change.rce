# W-MUT-1: `example Reset -> n >= 0` and the law `small` hold on every
# mutant. W-MUT-2: `n % 6` becomes `n % 7`, a mutant no obligation kills
# and `rce equiv` tells from the program after six events.
intent "a counter modulo 6 that shows its double"
    example Inc, Inc -> 2
    example Inc, Show -> 1
    example Reset -> n >= 0
    check double(2) == 4
    law small
        "the counter fits its byte"
        always n <= 255

state Counter
    n: u8 = 0

struct Shown
    value: u8

event Inc
event Show
event Reset

fn double(x: u8) -> u8
    return x * 2

step Counter on Inc -> (n + 1) % 6
step Counter on Show
    emit Shown(value: double(n))
step Counter on Reset -> 0
#--- rce-test
# id: types-checking/wellformedness/w-mut-1-change
# area: types-checking
# clauses: [W-MUT-1]
# expect: change
# diagnostic: W-MUT-1
# provenance: harvested from spec/checker/tests/mutants/vacuous.rce: rce check reports W-MUT-1 first
#---
