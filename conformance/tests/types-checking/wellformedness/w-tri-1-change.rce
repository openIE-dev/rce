# rce-version: 0.9
struct Declass
struct Vouch

label pii by Declass
label untrusted by Vouch

state Log
    shown: i64 = 0

event Mix(code: i64 @ {pii}, note: text @ {untrusted})

step Log on Mix(code: c, note: n)
    emit c.tostr() + n
