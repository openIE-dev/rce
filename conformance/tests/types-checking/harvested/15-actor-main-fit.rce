
fn main()
    let t = Tally()
    t <- Add(k: 5)
    t <- Add(k: 7)
    let r = chan[i64](1)
    t <- Get(reply: r)
    match <- r
        some(v) -> emit v
        none -> emit -1
    t <- Add(k: -2)
    t <- Get(reply: r)
    match <- r
        some(v) -> emit v
        none -> emit -1
