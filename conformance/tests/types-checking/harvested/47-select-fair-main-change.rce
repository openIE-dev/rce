
fn prod(c: chan u64, base: u64, n: u64)
    for i in 0..n
        c <- base + i
    c.close()

fn main()
    let a = chan[u64](1)
    let b = chan[u64](1)
    let out = chan[u64](32)
    spawn prod(a, 100, 6)
    spawn prod(b, 200, 6)
    fan_in(a, b, out)
    out.close()
    loop bound 100
        match <- out
            some(v) -> emit v
            none -> break
