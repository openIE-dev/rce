
fn put(c: chan text, tag: text, n: i64)
    for i in 0..n
        c <- tag + i.tostr()
    c.close()

fn drain(out: chan text)
    loop bound 100
        match <- out
            some(v) -> emit v
            none -> break

fn main()
    let a = chan[text](1)
    let b = chan[text](1)
    let out = chan[text](16)
    spawn put(a, "a", 3)
    spawn put(b, "b", 2)
    merge(a, b, out)
    out.close()
    drain(out)
