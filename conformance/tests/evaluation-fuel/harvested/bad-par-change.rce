# rce-version: 0.6
# Refused: `par` inside a recursive cycle with a bounded function.
fn f(n: i64) -> i64 bound 10
    if n <= 0
        return 0
    var a = 0
    var b = 0
    par
        branch left
            a = f(n - 1)
        branch right
            b = 1
    return a + b
