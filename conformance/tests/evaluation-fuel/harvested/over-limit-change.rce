# Recursion past the evaluation-depth limit (interp::EVAL_DEPTH) traps with
# `evaluation depth` on every host, including wasm32 (see tests/eval_depth.rs).
fn down(n: i64) -> i64 bound 100000000
    if n <= 0
        return 0
    return 1 + down(n - 1)

check down(10000) == 10000
