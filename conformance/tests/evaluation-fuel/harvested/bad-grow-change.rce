kind L
    Nil
    Cons(h: i64, t: Box[L])

fn f(x: L) -> i64
    match x
        Nil -> return 0
        Cons(h: h, t: t) -> return g(Cons(h: h, t: Box(x)))

fn g(y: L) -> i64
    return f(y)
