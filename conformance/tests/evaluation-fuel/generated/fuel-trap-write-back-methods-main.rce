error Boom(at: i64)

struct Acc
    n: i64

impl Acc
    fn add(&mut self, k: i64) -> i64 ! Boom
        self.n += k
        if self.n > 5
            fail Boom(at: self.n)
        return self.n

fn bump(x: &mut i64, y: &mut List[i64]) -> i64 ! Boom
    x += 1
    let c: i64 = x + 0
    y.push(c)
    if x > 11
        fail Boom(at: x + 0)
    return (x + 0) * 10

fn wrap(n: &mut i64, l: &mut List[i64]) -> i64 ! Boom
    let r = try bump(&mut n, &mut l)
    let _ = try bump(&mut n, &mut l)
    return r

fn main()
    var n: i64 = 10
    var l: List[i64] = []
    let v = wrap(&mut n, &mut l) catch |e| e.at
    emit n
    emit l.len()
    emit v
    let w = bump(&mut n, &mut l) catch -1
    emit n
    emit w
    var a = Acc(n: 1)
    emit a.add(2) catch -1
    emit a.n
    emit a.add(9) catch |e| e.at * 100
    emit a.n
