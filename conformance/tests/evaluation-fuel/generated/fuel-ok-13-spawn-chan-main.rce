fn producer(out: chan i64, n: i64)
    for i in 0..n
        out <- i
    out.close()

fn main()
    let c = chan[i64](8)
    spawn producer(c, 100)
    var total = 0
    loop
        match <- c
            some(v) -> total += v
            none -> break
    emit total
