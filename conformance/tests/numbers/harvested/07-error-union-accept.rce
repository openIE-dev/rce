error ParseFailed(at: u32)
error Empty

fn parse_digit(c: text) -> u8 ! ParseFailed
    if c.isdigit()
        return c.toint() as u8
    fail ParseFailed(at: 0)

fn sum_digits(s: text) -> u32 ! (ParseFailed)
    var total: u32 = 0
    for c in s.chars()
        total += (try parse_digit(c)) as u32
    return total

fn report(e: ParseFailed) -> u32 = e.at

fn safe(s: text) -> u32 = sum_digits(s) catch 0

fn logged(s: text) -> u32 = sum_digits(s) catch |e| report(e)
