fn popcount(x: u64) -> u32
    var v = x
    var c: u32 = 0
    while v != 0 bound 64
        v &= v - 1
        c += 1
    return c

fn mix(a: u32, b: u32) -> u32 = (a << 5 | a >> 27) ^ ~b & 0xFF
