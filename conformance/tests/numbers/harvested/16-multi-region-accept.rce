intent "two regions step on one event: the cart holds the items, the stats count the adds and removes"
    example AddItem(name: "milk"), AddItem(name: "eggs"), RemoveItem(name: "milk"), AddItem(name: "tea"), Reset, AddItem(name: "jam") -> items == ["jam"] and adds == 4 and removes == 1
    example AddItem(name: "milk"), AddItem(name: "eggs"), RemoveItem(name: "milk") -> items == ["eggs"] and removes == 1

state Cart
    items: List[text] = []

state Stats
    adds: u64 = 0
    removes: u64 = 0

event AddItem(name: text)
event RemoveItem(name: text)
event Reset

step Cart on AddItem(name: n) -> items.with(n)
step Stats on AddItem(name: _)
    adds += 1
step Cart on RemoveItem(name: n)
    items = [copy(i) for i in items if i != n]
step Stats on RemoveItem(name: _)
    removes += 1
step Cart on Reset -> []
