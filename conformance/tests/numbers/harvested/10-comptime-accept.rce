const N: usize = 64
const TABLE: [u32; 256] = comptime crc_table()

comptime fn crc_table() -> [u32; 256]
    var t = [0; 256]
    for i in 0..256
        var c: u32 = i as u32
        for _ in 0..8
            c = if c & 1 == 1 then 0xEDB88320 ^ (c >> 1) else c >> 1
        t[i] = c
    return t

fn zeros[comptime n: usize]() -> [u8; n]
    return [0; n]
