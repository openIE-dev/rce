# Audio-style processing on fixed-size buffers. Lane-wise arithmetic on
# arrays applies an operator to each element.
fn gain(buf: [f64; 4], g: f64) -> [f64; 4]
    let gs: [f64; 4] = [g, g, g, g]
    return buf * gs

fn mix(a: [i32; 4], b: [i32; 4]) -> [i32; 4] = a + b

fn clip(x: i32) -> i16
    if x > 32767
        return 32767
    if x < -32768
        return -32768
    return x as i16

const A: [i32; 4] = [30000, 100, -30000, 0]
const B: [i32; 4] = [10000, 100, -10000, 5]

check gain([1.0, -2.0, 0.5, 0.0], 2.0) == [2.0, -4.0, 1.0, 0.0]
check mix(A, B) == [40000, 200, -40000, 5]
check clip(mix(A, B)[0]) == 32767
check clip(mix(A, B)[2]) == -32768
