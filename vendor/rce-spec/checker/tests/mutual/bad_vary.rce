# Refused: f shrinks x in one call and y in the other, resetting the other
# to a fixed value, so f(Leaf, Node(Leaf)) calls itself forever.
kind T
    Leaf
    Node(k: Box[T])

fn f(x: &T, y: &T) -> i64
    let c = Node(k: Box(Node(k: Box(Leaf))))
    match x
        Node(k: a) -> return f(a, &c)
        Leaf
            match y
                Node(k: b) -> return f(&c, b)
                Leaf -> return 0

