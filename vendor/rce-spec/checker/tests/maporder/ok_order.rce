# Erratum E-1 to 6.7: a map iterates in canonical key order (7.1), never in
# insertion order. Keys are inserted out of order, overwritten and removed.
fn walk() -> text
    var m: Map[text, u32] = {"pear": 1, "apple": 2}
    m.insert("fig", 3)
    m.insert("banana", 4)
    m.insert("apple", 5)
    m.remove("pear")
    var s = ""
    for (k, v) in m
        s = s + k + "=" + v.tostr() + ";"
    return s

fn ints() -> text
    var m: Map[i64, text] = {}
    m.insert(10, "x")
    m.insert(-3, "y")
    m.insert(2, "z")
    var s = ""
    for k in m.keys()
        s = s + k.tostr() + ","
    for v in m.values()
        s = s + v
    return s

check walk() == "apple=5;banana=4;fig=3;"
check ints() == "-3,2,10,yzx"
