module notes_http

intent "a notes service over HTTP/1.1: list, create, read and delete notes as JSON; a malformed request gets the status the host names, a body that is not UTF-8 400, a note over 4096 bytes 413, an unknown path 404, a wrong method 405, and a refused step 503 when it ran out of fuel and 500 otherwise, as when the notes would exceed SIZE_LIMIT (cause size)"
    example HttpRequest(id: 1, method: "POST", target: "/notes", version: "HTTP/1.1", names: ["Host"], values: ["x"], body: [109, 105, 108, 107]) -> last_status == 201 and notes.len() == 1
    example HttpRequest(id: 1, method: "GET", target: "/notes/9", version: "HTTP/1.1", names: ["Host"], values: ["x"], body: []) -> last_status == 404
    example HttpRequest(id: 1, method: "PUT", target: "/notes", version: "HTTP/1.1", names: ["Host"], values: ["x"], body: []) -> last_status == 405
    example HttpRequest(id: 1, method: "HEAD", target: "/health", version: "HTTP/1.1", names: ["Host"], values: ["x"], body: []) -> last_status == 200
    example HttpRequest(id: 1, method: "POST", target: "/notes", version: "HTTP/1.1", names: [], values: [], body: [32, 32, 32]) -> last_status == 422 and notes.len() == 0
    example HttpRequest(id: 1, method: "POST", target: "/notes", version: "HTTP/1.1", names: [], values: [], body: [97]), HttpRequest(id: 2, method: "DELETE", target: "/notes/1", version: "HTTP/1.1", names: [], values: [], body: []) -> last_status == 204 and notes.len() == 0
    example HttpMalformed(id: 1, status: 400, why: "bare LF") -> last_status == 400
    example HttpRequest(id: 1, method: "POST", target: "/notes", version: "HTTP/1.1", names: [], values: [], body: [109, 255]) -> last_status == 400 and notes.len() == 0
    example HttpRequest(id: 1, method: "POST", target: "/notes", version: "HTTP/1.1", names: [], values: [], body: [226, 130, 172]) -> last_status == 201 and notes[1] == "€"
    example HttpMalformed(id: 1, status: 413, why: "body over 1000000 bytes") -> last_status == 413
    example HttpRequest(id: 1, method: "POST", target: "/notes", version: "HTTP/1.1", names: [], values: [], body: [97 for _i in 0..4097]) -> last_status == 413 and notes.len() == 0
    example HttpRequest(id: 1, method: "POST", target: "/notes", version: "HTTP/1.1", names: [], values: [], body: [97]), Refused(seq: 3, cause: "size") -> last_status == 500 and notes.len() == 1
    example Refused(seq: 1, cause: "fuel") -> last_status == 503

check note(1, "a\u{7}\"") == "{\"id\":1,\"text\":\"a\\u0007\\\"\"}"

use text.utf8

struct HttpRespond
    req: u64
    status: u64
    names: List[text]
    values: List[text]
    body: text

event HttpRequest(id: u64, method: text, target: text, version: text, names: List[text], values: List[text], body: List[i64])
event HttpMalformed(id: u64, status: u64, why: text)
event HttpRespondDone(req: u64, status: text, data: u64?, err: text)
event Refused(seq: u64, cause: text)

const MAX_NOTE: usize = 4096
const ESC: Map[text, text] = {"\"": "\\\"", "\\": "\\\\", "\n": "\\n", "\r": "\\r", "\t": "\\t"}
const HEX: text = "0123456789abcdef"

fn esc(c: text) -> text
    let x = c[0] as usize
    if x < 32 and not ESC.contains(c)
        return "\\u00" + copy(HEX.chars()[x / 16]) + copy(HEX.chars()[x % 16])
    return ESC.get(c) catch c

fn json_str(t: &text) -> text = "\"" + "".join([esc(c) for c in t.chars()]) + "\""

fn note(id: u64, t: text) -> text = "{\"id\":" + id.tostr() + ",\"text\":" + json_str(&t) + "}"

fn err(s: u64, why: text) -> (u64, text, text) = (s, "{\"error\":" + json_str(&why) + "}", "")

fn no(allow: text) -> (u64, text, text) = (405, "{\"error\":\"method not allowed\"}", allow)

fn respond(id: u64, r: (u64, text, text)) -> HttpRespond
    var names: List[text] = []
    var values: List[text] = []
    if r.0 != 204
        names.push("Content-Type")
        values.push("application/json")
    if r.2 != ""
        names.push("Allow")
        values.push(copy(r.2))
    return HttpRespond(req: id, status: r.0, names: names, values: values, body: r.1)

fn is_id(t: &text) -> bool = not t.isempty() and t.len_bytes() <= 18 and t.isdigit()

state Server
    next_id: u64 = 1
    notes: Map[u64, text] = {}
    last_status: u64 = 0

step Server on HttpRequest(id: id, method: m, target: t, version: _, names: _, values: _, body: b)
    let p = t.split("/")
    let n = p.len() == 3 and p[1] == "notes" and is_id(&p[2])
    let k = if n then p[2].toint() as u64 else 0
    let fits = b.len() <= MAX_NOTE
    let ok = fits and utf8.utf8_valid(&b)
    let s = if ok then b.utf8() else ""
    let g = if m == "HEAD" then "GET" else copy(m)
    var r = err(404, "not found")
    match (g, copy(t))
        ("GET", "/health") -> r = (200, "{\"ok\":true}", "")
        (_, "/health") -> r = no("GET, HEAD")
        ("GET", "/notes") -> r = (200, "[" + ",".join([note(i, copy(notes[i])) for i in notes.keys()]) + "]", "")
        ("POST", "/notes") -> r = if not fits then err(413, "note over 4096 bytes") else (if not ok then err(400, "body is not UTF-8") else (if s.strip().isempty() then err(422, "empty note") else (201, note(next_id, copy(s)), "")))
        (_, "/notes") -> r = no("GET, HEAD, POST")
        ("GET", _) if n -> r = if notes.contains(k) then (200, note(k, copy(notes[k])), "") else err(404, "no such note")
        ("DELETE", _) if n -> r = if notes.contains(k) then (204, "", "") else err(404, "no such note")
        (_, _) if n -> r = no("GET, HEAD, DELETE")
        _ -> pass
    if r.0 == 201
        notes[next_id] = copy(s)
        next_id += 1
    if r.0 == 204
        let _ = notes.remove(k)
    last_status = r.0
    emit respond(id, r)

step Server on HttpMalformed(id: id, status: st, why: w)
    last_status = st
    emit respond(id, err(st, w))

step Server on Refused(seq: q, cause: c)
    let st: u64 = if c == "fuel" then 503 else 500
    last_status = st
    emit respond(q, err(st, "step refused: " + c))

step Server on HttpRespondDone(_, _, _, _)
    pass
