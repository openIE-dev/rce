# A checkout with 40 independent options in one record-typed state.
# Generated by gen_checkout.py; each option has its own events.
intent "a checkout of 40 independent options: the program grows by one field and its steps per option"
    example Toggle0, Toggle0, Toggle0 -> flag0
    example Hold2, Hold2, Hold2, Hold2 -> kept: AtLimit
    example Apply3, Apply3 -> kept: AlreadyApplied

type Region = u8 where self <= 3

state Checkout
    flag0: bool = false
    region1: Region = 0
    hold2: u8 = 0
    promo3: bool = false
    flag4: bool = false
    region5: Region = 0
    hold6: u8 = 0
    promo7: bool = false
    flag8: bool = false
    region9: Region = 0
    hold10: u8 = 0
    promo11: bool = false
    flag12: bool = false
    region13: Region = 0
    hold14: u8 = 0
    promo15: bool = false
    flag16: bool = false
    region17: Region = 0
    hold18: u8 = 0
    promo19: bool = false
    flag20: bool = false
    region21: Region = 0
    hold22: u8 = 0
    promo23: bool = false
    flag24: bool = false
    region25: Region = 0
    hold26: u8 = 0
    promo27: bool = false
    flag28: bool = false
    region29: Region = 0
    hold30: u8 = 0
    promo31: bool = false
    flag32: bool = false
    region33: Region = 0
    hold34: u8 = 0
    promo35: bool = false
    flag36: bool = false
    region37: Region = 0
    hold38: u8 = 0
    promo39: bool = false

struct Total
    cents: i64

error AtLimit
error AlreadyApplied

event Toggle0
event SetRegion1(r: Region)
event Hold2
event Release2
event Apply3
event Toggle4
event SetRegion5(r: Region)
event Hold6
event Release6
event Apply7
event Toggle8
event SetRegion9(r: Region)
event Hold10
event Release10
event Apply11
event Toggle12
event SetRegion13(r: Region)
event Hold14
event Release14
event Apply15
event Toggle16
event SetRegion17(r: Region)
event Hold18
event Release18
event Apply19
event Toggle20
event SetRegion21(r: Region)
event Hold22
event Release22
event Apply23
event Toggle24
event SetRegion25(r: Region)
event Hold26
event Release26
event Apply27
event Toggle28
event SetRegion29(r: Region)
event Hold30
event Release30
event Apply31
event Toggle32
event SetRegion33(r: Region)
event Hold34
event Release34
event Apply35
event Toggle36
event SetRegion37(r: Region)
event Hold38
event Release38
event Apply39
event Place

step Checkout on Toggle0
    flag0 = not flag0
step Checkout on SetRegion1(r: r)
    region1 = r
step Checkout on Hold2 if hold2 == 3
    fail AtLimit
step Checkout on Hold2
    hold2 += 1
step Checkout on Release2 if hold2 == 0
    fail AtLimit
step Checkout on Release2
    hold2 -= 1
step Checkout on Apply3 if promo3
    fail AlreadyApplied
step Checkout on Apply3
    promo3 = true
step Checkout on Toggle4
    flag4 = not flag4
step Checkout on SetRegion5(r: r)
    region5 = r
step Checkout on Hold6 if hold6 == 3
    fail AtLimit
step Checkout on Hold6
    hold6 += 1
step Checkout on Release6 if hold6 == 0
    fail AtLimit
step Checkout on Release6
    hold6 -= 1
step Checkout on Apply7 if promo7
    fail AlreadyApplied
step Checkout on Apply7
    promo7 = true
step Checkout on Toggle8
    flag8 = not flag8
step Checkout on SetRegion9(r: r)
    region9 = r
step Checkout on Hold10 if hold10 == 3
    fail AtLimit
step Checkout on Hold10
    hold10 += 1
step Checkout on Release10 if hold10 == 0
    fail AtLimit
step Checkout on Release10
    hold10 -= 1
step Checkout on Apply11 if promo11
    fail AlreadyApplied
step Checkout on Apply11
    promo11 = true
step Checkout on Toggle12
    flag12 = not flag12
step Checkout on SetRegion13(r: r)
    region13 = r
step Checkout on Hold14 if hold14 == 3
    fail AtLimit
step Checkout on Hold14
    hold14 += 1
step Checkout on Release14 if hold14 == 0
    fail AtLimit
step Checkout on Release14
    hold14 -= 1
step Checkout on Apply15 if promo15
    fail AlreadyApplied
step Checkout on Apply15
    promo15 = true
step Checkout on Toggle16
    flag16 = not flag16
step Checkout on SetRegion17(r: r)
    region17 = r
step Checkout on Hold18 if hold18 == 3
    fail AtLimit
step Checkout on Hold18
    hold18 += 1
step Checkout on Release18 if hold18 == 0
    fail AtLimit
step Checkout on Release18
    hold18 -= 1
step Checkout on Apply19 if promo19
    fail AlreadyApplied
step Checkout on Apply19
    promo19 = true
step Checkout on Toggle20
    flag20 = not flag20
step Checkout on SetRegion21(r: r)
    region21 = r
step Checkout on Hold22 if hold22 == 3
    fail AtLimit
step Checkout on Hold22
    hold22 += 1
step Checkout on Release22 if hold22 == 0
    fail AtLimit
step Checkout on Release22
    hold22 -= 1
step Checkout on Apply23 if promo23
    fail AlreadyApplied
step Checkout on Apply23
    promo23 = true
step Checkout on Toggle24
    flag24 = not flag24
step Checkout on SetRegion25(r: r)
    region25 = r
step Checkout on Hold26 if hold26 == 3
    fail AtLimit
step Checkout on Hold26
    hold26 += 1
step Checkout on Release26 if hold26 == 0
    fail AtLimit
step Checkout on Release26
    hold26 -= 1
step Checkout on Apply27 if promo27
    fail AlreadyApplied
step Checkout on Apply27
    promo27 = true
step Checkout on Toggle28
    flag28 = not flag28
step Checkout on SetRegion29(r: r)
    region29 = r
step Checkout on Hold30 if hold30 == 3
    fail AtLimit
step Checkout on Hold30
    hold30 += 1
step Checkout on Release30 if hold30 == 0
    fail AtLimit
step Checkout on Release30
    hold30 -= 1
step Checkout on Apply31 if promo31
    fail AlreadyApplied
step Checkout on Apply31
    promo31 = true
step Checkout on Toggle32
    flag32 = not flag32
step Checkout on SetRegion33(r: r)
    region33 = r
step Checkout on Hold34 if hold34 == 3
    fail AtLimit
step Checkout on Hold34
    hold34 += 1
step Checkout on Release34 if hold34 == 0
    fail AtLimit
step Checkout on Release34
    hold34 -= 1
step Checkout on Apply35 if promo35
    fail AlreadyApplied
step Checkout on Apply35
    promo35 = true
step Checkout on Toggle36
    flag36 = not flag36
step Checkout on SetRegion37(r: r)
    region37 = r
step Checkout on Hold38 if hold38 == 3
    fail AtLimit
step Checkout on Hold38
    hold38 += 1
step Checkout on Release38 if hold38 == 0
    fail AtLimit
step Checkout on Release38
    hold38 -= 1
step Checkout on Apply39 if promo39
    fail AlreadyApplied
step Checkout on Apply39
    promo39 = true
step Checkout on Place
    var t: i64 = 1000
    t += if flag0 then 100 else 0
    t += (region1 as i64) * 8
    t += (hold2 as i64) * 250
    t -= if promo3 then 53 else 0
    t += if flag4 then 104 else 0
    t += (region5 as i64) * 12
    t += (hold6 as i64) * 250
    t -= if promo7 then 57 else 0
    t += if flag8 then 108 else 0
    t += (region9 as i64) * 16
    t += (hold10 as i64) * 250
    t -= if promo11 then 61 else 0
    t += if flag12 then 112 else 0
    t += (region13 as i64) * 20
    t += (hold14 as i64) * 250
    t -= if promo15 then 65 else 0
    t += if flag16 then 116 else 0
    t += (region17 as i64) * 24
    t += (hold18 as i64) * 250
    t -= if promo19 then 69 else 0
    t += if flag20 then 120 else 0
    t += (region21 as i64) * 28
    t += (hold22 as i64) * 250
    t -= if promo23 then 73 else 0
    t += if flag24 then 124 else 0
    t += (region25 as i64) * 32
    t += (hold26 as i64) * 250
    t -= if promo27 then 77 else 0
    t += if flag28 then 128 else 0
    t += (region29 as i64) * 36
    t += (hold30 as i64) * 250
    t -= if promo31 then 81 else 0
    t += if flag32 then 132 else 0
    t += (region33 as i64) * 40
    t += (hold34 as i64) * 250
    t -= if promo35 then 85 else 0
    t += if flag36 then 136 else 0
    t += (region37 as i64) * 44
    t += (hold38 as i64) * 250
    t -= if promo39 then 89 else 0
    emit Total(cents: t)
