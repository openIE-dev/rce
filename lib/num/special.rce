module num.special

# Elementary and special functions for num.stats, in pure RCE over IEEE
# binary64. Every function is a fixed sequence of correctly rounded
# + - * / and sqrt with no FMA (spec 6.3 N3), so it returns the same bits
# on every target.
#
# exp, log, log1p, expm1, erf, erfc and lgamma are line-for-line ports of
# FDLIBM 5.3 (Sun Microsystems; netlib.org/fdlibm, see SOURCE.md for the
# notice), checked bit for bit against FDLIBM compiled with gcc on x86-64
# SSE2 (-O0 -ffp-contract=off) and for error against mpmath 1.4.1 at 200
# bits (tests/num/special_checks*.rce). FDLIBM is faithful (error below 1
# ulp), not correctly rounded; the correctly rounded CORE-MATH ports of
# the `math` module replace these when they land (see the progress log).
# FDLIBM reads and writes the high and low 32-bit words of a double; the
# word access is rebuilt here from exact scalings (f64_bits,
# f64_from_bits), since rce has no bit casts.
#
# Results that are not finite (log 0, exp overflow, lgamma at a pole)
# trap like every f64 operation; NaN and infinity never appear.

const SP_I64MIN: i64 = -9223372036854775807 - 1
const SP_M32: i64 = 4294967295
const SP_M52: i64 = 4503599627370495
const SP_TWO52: f64 = 4503599627370496.0
const SP_TWO54: f64 = 18014398509481984.0
const SP_TWOM1000: f64 = 9.332636185032189e-302
const SP_HUGE: f64 = 1.7976931348623157e308

fn sp_up(k: i64) -> f64
    if k == 512
        return 1.3407807929942597e154
    if k == 256
        return 1.157920892373162e77
    if k == 128
        return 3.402823669209385e38
    if k == 64
        return 18446744073709551616.0
    if k == 32
        return 4294967296.0
    if k == 16
        return 65536.0
    if k == 8
        return 256.0
    if k == 4
        return 16.0
    if k == 2
        return 4.0
    return 2.0

fn sp_down(k: i64) -> f64
    if k == 512
        return 7.458340731200207e-155
    if k == 256
        return 8.636168555094445e-78
    if k == 128
        return 2.938735877055719e-39
    if k == 64
        return 5.421010862427522e-20
    if k == 32
        return 2.3283064365386963e-10
    if k == 16
        return 0.0000152587890625
    if k == 8
        return 0.00390625
    if k == 4
        return 0.0625
    if k == 2
        return 0.25
    return 0.5

# 2^k for -1074 <= k <= 1023, exact (a product of exact powers).
pub fn sp_pow2(k: i64) -> f64
    var r = 1.0
    var s: i64 = 512
    if k >= 0
        var e = k
        while s >= 1 bound 11
            if e >= s
                r = r * sp_up(s)
                e -= s
            s = s / 2
        return r
    var e = 0 - k
    if e > 1022
        r = sp_down(512) * sp_down(512)
        e -= 1024
        r = r * 4.0
        e += 2
    while s >= 1 bound 11
        if e >= s
            r = r * sp_down(s)
            e -= s
        s = s / 2
    return r

# The IEEE 754 binary64 encoding of x as a signed 64-bit integer (sign
# bit = bit 63), computed from exact scalings: find e with 2^e <= |x| <
# 2^(e+1) by a binary search over power-of-two factors, then read the
# 52-bit fraction as an exact integer.
pub fn f64_bits(x: f64) -> i64
    if x == 0.0
        return 0
    let neg = x < 0.0
    var a = if neg then 0.0 - x else x
    var e: i64 = 0
    var s: i64 = 512
    if a >= 2.0
        while s >= 1 bound 11
            if a >= sp_up(s)
                a = a * sp_down(s)
                e += s
            s = s / 2
    elif a < 1.0
        var twice = true
        while s >= 1 bound 12
            if a * sp_up(s) < 2.0
                a = a * sp_up(s)
                e -= s
            if s == 512 and twice
                twice = false
            else
                s = s / 2
    var b: i64 = 0
    if e >= -1022
        b = ((e + 1023) << 52) | (((a - 1.0) * SP_TWO52) as i64)
    else
        let ax = if neg then 0.0 - x else x
        let p537 = sp_up(512) * sp_up(16) * sp_up(8) * 2.0
        b = ((ax * p537) * p537) as i64
    if neg
        b = b + SP_I64MIN
    return b

# Inverse of f64_bits. An encoding of infinity or NaN traps (non-finite).
pub fn f64_from_bits(b: i64) -> f64
    let neg = b < 0
    let u = if neg then b - SP_I64MIN else b
    let ex = u >> 52
    let m = u & SP_M52
    var x = 0.0
    if ex == 2047
        x = SP_HUGE * 2.0
    elif ex == 0
        x = ((m as f64) * sp_pow2(-537)) * sp_pow2(-537)
    else
        x = (1.0 + (m as f64) * sp_pow2(-52)) * sp_pow2(ex - 1023)
    return if neg then 0.0 - x else x

# High word as a signed 32-bit int (C `int hx = __HI(x)`), low word
# unsigned, and the word setters.
pub fn hi_word(x: f64) -> i64
    let h = (f64_bits(x) >> 32) & SP_M32
    return if h >= 2147483648 then h - 4294967296 else h

pub fn lo_word(x: f64) -> i64 = f64_bits(x) & SP_M32

pub fn from_words(h: i64, l: i64) -> f64
    let hu = h & SP_M32
    let hs = if hu >= 2147483648 then hu - 4294967296 else hu
    return f64_from_bits(hs * 4294967296 + (l & SP_M32))

pub fn set_hi(x: f64, h: i64) -> f64 = from_words(h, lo_word(x))
pub fn set_lo(x: f64, l: i64) -> f64 = from_words(hi_word(x), l)

fn sp_abs(x: f64) -> f64 = if x < 0.0 then 0.0 - x else x

# A value that traps when used: stands for FDLIBM's +-inf and NaN
# returns (6.3 N3: a non-finite result traps).
fn sp_nonfinite() -> f64 = SP_HUGE * 2.0

