# ---------------------------------------------------------------- exp, log
# FDLIBM e_exp.c: x = k ln2 + r, ln2 split hi/lo (hi has 32 trailing
# zero bits so k * hi is exact), a degree-5 Remez rational in r.
pub fn exp(x0: f64) -> f64
    var x = x0
    let hx0 = hi_word(x)
    let xsb: i64 = if hx0 < 0 then 1 else 0
    let hx = hx0 & 2147483647
    if hx >= 1082535490
        if x > EX_O_THRESHOLD
            return sp_nonfinite()
        if x < EX_U_THRESHOLD
            return 0.0
    var hi = 0.0
    var lo = 0.0
    var k: i64 = 0
    if hx > 1071001154
        if hx < 1072734898
            if xsb == 0
                hi = x - LG_LN2_HI
                lo = LG_LN2_LO
            else
                hi = x + LG_LN2_HI
                lo = 0.0 - LG_LN2_LO
            k = 1 - xsb - xsb
        else
            k = (EX_INVLN2 * x + (if xsb == 0 then 0.5 else -0.5)) as i64
            let t = k as f64
            hi = x - t * LG_LN2_HI
            lo = t * LG_LN2_LO
        x = hi - lo
    elif hx < 1043333120
        return 1.0 + x
    let t = x * x
    let c = x - t * (EX_P1 + t * (EX_P2 + t * (EX_P3 + t * (EX_P4 + t * EX_P5))))
    if k == 0
        return 1.0 - ((x * c) / (c - 2.0) - x)
    let y = 1.0 - ((lo - (x * c) / (2.0 - c)) - hi)
    if k >= -1021
        return f64_from_bits(f64_bits(y) + (k << 52))
    return f64_from_bits(f64_bits(y) + ((k + 1000) << 52)) * SP_TWOM1000

# FDLIBM e_log.c: x = 2^k (1 + f), f in [sqrt(2)/2 - 1, sqrt(2) - 1],
# log(1 + f) = 2s + s R(s^2) with s = f / (2 + f).
pub fn log(x0: f64) -> f64
    var x = x0
    var hx = hi_word(x)
    var k: i64 = 0
    if hx < 1048576
        if x == 0.0 or hx < 0
            return sp_nonfinite()
        k -= 54
        x = x * SP_TWO54
        hx = hi_word(x)
    k += (hx >> 20) - 1023
    hx = hx & 1048575
    var i = (hx + 614244) & 1048576
    x = set_hi(x, hx | (i ^ 1072693248))
    k += i >> 20
    let f = x - 1.0
    if (1048575 & (2 + hx)) < 3
        if f == 0.0
            if k == 0
                return 0.0
            let dk = k as f64
            return dk * LG_LN2_HI + dk * LG_LN2_LO
        let r = f * f * (0.5 - 0.3333333333333333 * f)
        if k == 0
            return f - r
        let dk = k as f64
        return dk * LG_LN2_HI - ((r - dk * LG_LN2_LO) - f)
    let s = f / (2.0 + f)
    let dk = k as f64
    let z = s * s
    i = hx - 398458
    let w = z * z
    let j = 440401 - hx
    let t1 = w * (LG_LG2 + w * (LG_LG4 + w * LG_LG6))
    let t2 = z * (LG_LG1 + w * (LG_LG3 + w * (LG_LG5 + w * LG_LG7)))
    i = i | j
    let r = t2 + t1
    if i > 0
        let hfsq = 0.5 * f * f
        if k == 0
            return f - (hfsq - s * (hfsq + r))
        return dk * LG_LN2_HI - ((hfsq - (s * (hfsq + r) + dk * LG_LN2_LO)) - f)
    if k == 0
        return f - s * (f - r)
    return dk * LG_LN2_HI - ((s * (f - r) - dk * LG_LN2_LO) - f)

# FDLIBM s_log1p.c (including its normalization of u near sqrt(2)).
pub fn log1p(x: f64) -> f64
    let hx = hi_word(x)
    let ax = hx & 2147483647
    var k: i64 = 1
    var f = 0.0
    var hu: i64 = 0
    var c = 0.0
    if hx < 1071284858
        if ax >= 1072693248
            return sp_nonfinite()
        if ax < 1042284544
            if ax < 1016070144
                return x
            return x - x * x * 0.5
        if hx > 0 or hx <= -1076707645
            k = 0
            f = x
            hu = 1
    if k != 0
        var u = 0.0
        if hx < 1128267776
            u = 1.0 + x
            hu = hi_word(u)
            k = (hu >> 20) - 1023
            c = if k > 0 then 1.0 - (u - x) else x - (u - 1.0)
            c = c / u
        else
            u = x
            hu = hi_word(u)
            k = (hu >> 20) - 1023
            c = 0.0
        hu = hu & 1048575
        if hu < 434334
            u = set_hi(u, hu | 1072693248)
        else
            k += 1
            u = set_hi(u, hu | 1071644672)
            hu = (1048576 - hu) >> 2
        f = u - 1.0
    let hfsq = 0.5 * f * f
    if hu == 0
        if f == 0.0
            if k == 0
                return 0.0
            c = c + (k as f64) * LG_LN2_LO
            return (k as f64) * LG_LN2_HI + c
        let r = hfsq * (1.0 - 0.6666666666666666 * f)
        if k == 0
            return f - r
        return (k as f64) * LG_LN2_HI - ((r - ((k as f64) * LG_LN2_LO + c)) - f)
    let s = f / (2.0 + f)
    let z = s * s
    let r = z * (L1_LP1 + z * (L1_LP2 + z * (L1_LP3 + z * (L1_LP4 + z * (L1_LP5 + z * (L1_LP6 + z * L1_LP7))))))
    if k == 0
        return f - (hfsq - s * (hfsq + r))
    return (k as f64) * LG_LN2_HI - ((hfsq - (s * (hfsq + r) + ((k as f64) * LG_LN2_LO + c))) - f)

# FDLIBM s_expm1.c.
pub fn expm1(x0: f64) -> f64
    var x = x0
    let hx0 = hi_word(x)
    let neg = hx0 < 0
    let hx = hx0 & 2147483647
    if hx >= 1078159482
        if hx >= 1082535490
            if x > EX_O_THRESHOLD
                return sp_nonfinite()
        if neg
            return 1.0e-300 - 1.0
    var hi = 0.0
    var lo = 0.0
    var k: i64 = 0
    var c = 0.0
    if hx > 1071001154
        if hx < 1072734898
            if not neg
                hi = x - LG_LN2_HI
                lo = LG_LN2_LO
                k = 1
            else
                hi = x + LG_LN2_HI
                lo = 0.0 - LG_LN2_LO
                k = -1
        else
            k = (EX_INVLN2 * x + (if neg then -0.5 else 0.5)) as i64
            let t = k as f64
            hi = x - t * LG_LN2_HI
            lo = t * LG_LN2_LO
        x = hi - lo
        c = (hi - x) - lo
    elif hx < 1016070144
        return x
    let hfx = 0.5 * x
    let hxs = x * hfx
    let r1 = 1.0 + hxs * (EM_Q1 + hxs * (EM_Q2 + hxs * (EM_Q3 + hxs * (EM_Q4 + hxs * EM_Q5))))
    let t = 3.0 - r1 * hfx
    var e = hxs * ((r1 - t) / (6.0 - x * t))
    if k == 0
        return x - (x * e - hxs)
    e = x * (e - c) - c
    e = e - hxs
    if k == -1
        return 0.5 * (x - e) - 0.5
    if k == 1
        if x < -0.25
            return -2.0 * (e - (x + 0.5))
        return 1.0 + 2.0 * (x - e)
    if k <= -2 or k > 56
        let y = 1.0 - (e - x)
        return f64_from_bits(f64_bits(y) + (k << 52)) - 1.0
    if k < 20
        let tt = from_words(1072693248 - (2097152 >> k), 0)
        let y = tt - (e - x)
        return f64_from_bits(f64_bits(y) + (k << 52))
    let tt = from_words((1023 - k) << 20, 0)
    var y = x - (e + tt)
    y = y + 1.0
    return f64_from_bits(f64_bits(y) + (k << 52))

# ---------------------------------------------------------------- erf
fn sp_erf_rs(s: f64, wide: bool) -> List[f64]
    if not wide
        let r = ER_RA0 + s * (ER_RA1 + s * (ER_RA2 + s * (ER_RA3 + s * (ER_RA4 + s * (ER_RA5 + s * (ER_RA6 + s * ER_RA7))))))
        let q = 1.0 + s * (ER_SA1 + s * (ER_SA2 + s * (ER_SA3 + s * (ER_SA4 + s * (ER_SA5 + s * (ER_SA6 + s * (ER_SA7 + s * ER_SA8)))))))
        return [r, q]
    let r = ER_RB0 + s * (ER_RB1 + s * (ER_RB2 + s * (ER_RB3 + s * (ER_RB4 + s * (ER_RB5 + s * ER_RB6)))))
    let q = 1.0 + s * (ER_SB1 + s * (ER_SB2 + s * (ER_SB3 + s * (ER_SB4 + s * (ER_SB5 + s * (ER_SB6 + s * ER_SB7))))))
    return [r, q]

fn sp_erf_pq(z: f64) -> f64
    let r = ER_PP0 + z * (ER_PP1 + z * (ER_PP2 + z * (ER_PP3 + z * ER_PP4)))
    let s = 1.0 + z * (ER_QQ1 + z * (ER_QQ2 + z * (ER_QQ3 + z * (ER_QQ4 + z * ER_QQ5))))
    return r / s

fn sp_erf_pa(s: f64) -> f64
    let p = ER_PA0 + s * (ER_PA1 + s * (ER_PA2 + s * (ER_PA3 + s * (ER_PA4 + s * (ER_PA5 + s * ER_PA6)))))
    let q = 1.0 + s * (ER_QA1 + s * (ER_QA2 + s * (ER_QA3 + s * (ER_QA4 + s * (ER_QA5 + s * ER_QA6)))))
    return p / q

# exp(-x^2) R/S part shared by erf and erfc: x > 0, z = x with its low
# word cleared, so z * z is exact.
fn sp_erf_tail(x: f64, rs: &[f64]) -> f64
    let z = set_lo(x, 0)
    return exp((0.0 - z) * z - 0.5625) * exp((z - x) * (z + x) + rs[0] / rs[1])

# FDLIBM s_erf.c.
pub fn erf(x: f64) -> f64
    let hx = hi_word(x)
    let ix = hx & 2147483647
    if ix < 1072365568
        if ix < 1043333120
            if ix < 8388608
                return 0.125 * (8.0 * x + ER_EFX8 * x)
            return x + ER_EFX * x
        let y = sp_erf_pq(x * x)
        return x + x * y
    if ix < 1072955392
        let pq = sp_erf_pa(sp_abs(x) - 1.0)
        if hx >= 0
            return ER_ERX + pq
        return (0.0 - ER_ERX) - pq
    if ix >= 1075314688
        if hx >= 0
            return 1.0 - 1.0e-300
        return 1.0e-300 - 1.0
    let ax = sp_abs(x)
    let s = 1.0 / (ax * ax)
    let rs = sp_erf_rs(s, ix >= 1074191214)
    let r = sp_erf_tail(ax, &rs)
    if hx >= 0
        return 1.0 - r / ax
    return r / ax - 1.0

pub fn erfc(x: f64) -> f64
    let hx = hi_word(x)
    let ix = hx & 2147483647
    if ix < 1072365568
        if ix < 1013972992
            return 1.0 - x
        let y = sp_erf_pq(x * x)
        if hx < 1070596096
            return 1.0 - (x + x * y)
        var r = x * y
        r = r + (x - 0.5)
        return 0.5 - r
    if ix < 1072955392
        let pq = sp_erf_pa(sp_abs(x) - 1.0)
        if hx >= 0
            let z = 1.0 - ER_ERX
            return z - pq
        let z = ER_ERX + pq
        return 1.0 + z
    if ix < 1077673984
        let ax = sp_abs(x)
        let s = 1.0 / (ax * ax)
        if ix >= 1074191213 and hx < 0 and ix >= 1075314688
            return 2.0 - 1.0e-300
        let rs = sp_erf_rs(s, ix >= 1074191213)
        let r = sp_erf_tail(ax, &rs)
        if hx > 0
            return r / ax
        return 2.0 - r / ax
    if hx > 0
        return 1.0e-300 * 1.0e-300
    return 2.0 - 1.0e-300

# ---------------------------------------------------------------- lgamma
# FDLIBM k_sin.c / k_cos.c kernels on [-pi/4, pi/4] (y = 0 here).
fn sp_ksin(x: f64) -> f64
    let ix = hi_word(x) & 2147483647
    if ix < 1044381696
        return x
    let z = x * x
    let v = z * x
    let r = KS_S2 + z * (KS_S3 + z * (KS_S4 + z * (KS_S5 + z * KS_S6)))
    return x + v * (KS_S1 + z * r)

fn sp_kcos(x: f64) -> f64
    let ix = hi_word(x) & 2147483647
    if ix < 1044381696
        return 1.0
    let z = x * x
    let r = z * (KC_C1 + z * (KC_C2 + z * (KC_C3 + z * (KC_C4 + z * (KC_C5 + z * KC_C6)))))
    if ix < 1070805811
        return 1.0 - (0.5 * z - (z * r))
    var qx = 0.28125
    if ix <= 1072234496
        qx = from_words(ix - 2097152, 0)
    let hz = 0.5 * z - qx
    let a = 1.0 - qx
    return a - (hz - (z * r))

# sin(pi x) for x < 0 (FDLIBM e_lgamma_r.c sin_pi).
fn sp_sin_pi(x: f64) -> f64
    let ix = hi_word(x) & 2147483647
    if ix < 1070596096
        return sp_ksin(GA_PI * x)
    var y = 0.0 - x
    var z = y.floor()
    var n: i64 = 0
    if z != y
        y = y * 0.5
        y = 2.0 * (y - y.floor())
        n = (y * 4.0) as i64
    else
        if ix >= 1128267776
            y = 0.0
            n = 0
        else
            if ix < 1127219200
                z = y + SP_TWO52
            n = lo_word(z) & 1
            y = n as f64
            n = n << 2
    if n == 0
        y = sp_ksin(GA_PI * y)
    elif n == 1 or n == 2
        y = sp_kcos(GA_PI * (0.5 - y))
    elif n == 3 or n == 4
        y = sp_ksin(GA_PI * (1.0 - y))
    elif n == 5 or n == 6
        y = 0.0 - sp_kcos(GA_PI * (y - 1.5))
    else
        y = sp_ksin(GA_PI * (y - 2.0))
    return 0.0 - y

pub struct Lgamma
    value: f64
    sign: i64

# FDLIBM e_lgamma_r.c: log|Gamma(x)| and the sign of Gamma(x). Poles
# (x = 0, -1, -2, ..) trap.
pub fn lgamma_r(x0: f64) -> Lgamma
    var x = x0
    let hx = hi_word(x)
    let lx = lo_word(x)
    var sgn: i64 = 1
    let ix = hx & 2147483647
    if (ix | lx) == 0
        return Lgamma(value: sp_nonfinite(), sign: 1)
    if ix < 999292928
        if hx < 0
            return Lgamma(value: 0.0 - log(0.0 - x), sign: -1)
        return Lgamma(value: 0.0 - log(x), sign: 1)
    var nadj = 0.0
    if hx < 0
        if ix >= 1127219200
            return Lgamma(value: sp_nonfinite(), sign: 1)
        let t = sp_sin_pi(x)
        if t == 0.0
            return Lgamma(value: sp_nonfinite(), sign: 1)
        nadj = log(GA_PI / sp_abs(t * x))
        if t < 0.0
            sgn = -1
        x = 0.0 - x
    var r = 0.0
    if ((ix - 1072693248) | lx) == 0 or ((ix - 1073741824) | lx) == 0
        r = 0.0
    elif ix < 1073741824
        var y = 0.0
        var i: i64 = 0
        if ix <= 1072483532
            r = 0.0 - log(x)
            if ix >= 1072130372
                y = 1.0 - x
                i = 0
            elif ix >= 1070442081
                y = x - (GA_TC - 1.0)
                i = 1
            else
                y = x
                i = 2
        else
            r = 0.0
            if ix >= 1073460419
                y = 2.0 - x
                i = 0
            elif ix >= 1072936132
                y = x - GA_TC
                i = 1
            else
                y = x - 1.0
                i = 2
        if i == 0
            let z = y * y
            let p1 = GA_A0 + z * (GA_A2 + z * (GA_A4 + z * (GA_A6 + z * (GA_A8 + z * GA_A10))))
            let p2 = z * (GA_A1 + z * (GA_A3 + z * (GA_A5 + z * (GA_A7 + z * (GA_A9 + z * GA_A11)))))
            let p = y * p1 + p2
            r = r + (p - 0.5 * y)
        elif i == 1
            let z = y * y
            let w = z * y
            let p1 = GA_T0 + w * (GA_T3 + w * (GA_T6 + w * (GA_T9 + w * GA_T12)))
            let p2 = GA_T1 + w * (GA_T4 + w * (GA_T7 + w * (GA_T10 + w * GA_T13)))
            let p3 = GA_T2 + w * (GA_T5 + w * (GA_T8 + w * (GA_T11 + w * GA_T14)))
            let p = z * p1 - (GA_TT - w * (p2 + y * p3))
            r = r + (GA_TF + p)
        else
            let p1 = y * (GA_U0 + y * (GA_U1 + y * (GA_U2 + y * (GA_U3 + y * (GA_U4 + y * GA_U5)))))
            let p2 = 1.0 + y * (GA_V1 + y * (GA_V2 + y * (GA_V3 + y * (GA_V4 + y * GA_V5))))
            r = r + ((-0.5) * y + p1 / p2)
    elif ix < 1075838976
        let i = x as i64
        let y = x - (i as f64)
        let p = y * (GA_S0 + y * (GA_S1 + y * (GA_S2 + y * (GA_S3 + y * (GA_S4 + y * (GA_S5 + y * GA_S6))))))
        let q = 1.0 + y * (GA_R1 + y * (GA_R2 + y * (GA_R3 + y * (GA_R4 + y * (GA_R5 + y * GA_R6)))))
        r = 0.5 * y + p / q
        var z = 1.0
        if i >= 7
            z = z * (y + 6.0)
        if i >= 6
            z = z * (y + 5.0)
        if i >= 5
            z = z * (y + 4.0)
        if i >= 4
            z = z * (y + 3.0)
        if i >= 3
            z = z * (y + 2.0)
            r = r + log(z)
    elif ix < 1133510656
        let t = log(x)
        let z = 1.0 / x
        let y = z * z
        let w = GA_W0 + z * (GA_W1 + y * (GA_W2 + y * (GA_W3 + y * (GA_W4 + y * (GA_W5 + y * GA_W6)))))
        r = (x - 0.5) * (t - 1.0) + w
    else
        r = x * (log(x) - 1.0)
    if hx < 0
        r = nadj - r
    return Lgamma(value: r, sign: sgn)

pub fn lgamma(x: f64) -> f64 = lgamma_r(x).value
