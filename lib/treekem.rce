module treekem

# TreeKEM ratchet trees for MLS (RFC 9420 section 7), pure RCE on top of
# lib/crypto.rce and lib/mls.rce. This slice decodes a serialized
# ratchet_tree (optional<Node> nodes<V>, TLS presentation language), pads
# it to a full tree (the leaf count is a power of two, 7.1), and computes
# tree hashes (7.8), resolutions (4.1.1) and parent-hash validity (7.9.2),
# and processes and generates update paths (7.4 to 7.6). Checked against the
# official tree-validation.json and treekem.json vectors in
# tests/treekem_rce.rs.

# a QUIC-style varint length at p: [value, next position]
fn rd_v(b: List[i64], p: usize) -> List[i64]
    let t = b[p] >> 6
    if t == 0
        return [b[p] & 63, (p + 1) as i64]
    if t == 1
        return [((b[p] & 63) << 8) | b[p + 1], (p + 2) as i64]
    return [((b[p] & 63) << 24) | (b[p + 1] << 16) | (b[p + 2] << 8) | b[p + 3], (p + 4) as i64]

fn skip_v(b: List[i64], p: usize) -> usize
    let r = rd_v(copy(b), p)
    return (r[0] + r[1]) as usize

fn get_v(b: List[i64], p: usize) -> List[i64]
    let r = rd_v(copy(b), p)
    return slice(b, r[1] as usize, (r[0] + r[1]) as usize)

# end of a LeafNode starting at p (7.2)
fn leaf_end(b: List[i64], p0: usize) -> usize
    var p = skip_v(copy(b), p0)
    p = skip_v(copy(b), p)
    p += 2
    p = skip_v(copy(b), p)
    for _ in 0..5
        p = skip_v(copy(b), p)
    let src = b[p]
    p += 1
    if src == 1
        p += 16
    if src == 3
        p = skip_v(copy(b), p)
    p = skip_v(copy(b), p)
    return skip_v(b, p)

fn parent_end(b: List[i64], p0: usize) -> usize
    var p = skip_v(copy(b), p0)
    p = skip_v(copy(b), p)
    return skip_v(b, p)

# the nodes of a ratchet_tree, padded to 2^k leaves: "" for a blank node,
# else the hex of the node type byte (1 leaf, 2 parent) and the node's encoding
fn rt_node_end(b: List[i64], p: usize) -> usize
    if b[p] == 0
        return p + 1
    if b[p + 1] == 1
        return leaf_end(b, p + 2)
    return parent_end(b, p + 2)

fn rt_node(b: List[i64], p: usize, e: usize) -> text = if b[p] == 0 then "" else tohex(slice(b, p + 1, e))

fn rt_pad(nodes: List[text]) -> List[text]
    var out = nodes
    var leaves: usize = 1
    while 2 * leaves - 1 < out.len() bound 32
        leaves = leaves * 2
    while out.len() < 2 * leaves - 1 bound 65536
        out.push("")
    return out

fn rt_decode(tree: text) -> List[text]
    let b = unhex(tree)
    let r = rd_v(copy(b), 0)
    let end = (r[0] + r[1]) as usize
    var p = r[1] as usize
    var nodes: List[text] = []
    while p < end bound 65536
        let e = rt_node_end(copy(b), p)
        nodes.push(rt_node(copy(b), p, e))
        p = e
    return rt_pad(nodes)

fn nbody(n: text) -> List[i64]
    let b = unhex(n)
    return slice(copy(b), 1, b.len())

fn ntype(n: text) -> i64
    if n == ""
        return 0
    return unhex(n)[0]

# encryption key, parent hash ("" for none) and unmerged leaves (parents
# only) of a node: [enc_key_hex, parent_hash_hex, "l1,l2,..."]
fn nfields(n: text) -> List[text]
    let typ = ntype(copy(n))
    let b = nbody(n)
    let ek = tohex(get_v(copy(b), 0))
    var p = skip_v(copy(b), 0)
    if typ == 2
        let ph = tohex(get_v(copy(b), p))
        p = skip_v(copy(b), p)
        let um = get_v(copy(b), p)
        var us = ""
        var i: usize = 0
        while i + 4 <= um.len() bound 16384
            let u = (um[i] << 24) | (um[i + 1] << 16) | (um[i + 2] << 8) | um[i + 3]
            us = if us == "" then u.tostr() else us + "," + u.tostr()
            i += 4
        return [ek, ph, us]
    p = skip_v(copy(b), p)
    p += 2
    p = skip_v(copy(b), p)
    for _ in 0..5
        p = skip_v(copy(b), p)
    if b[p] == 3
        return [ek, tohex(get_v(copy(b), p + 1)), ""]
    return [ek, "", ""]

fn unmerged(n: text) -> List[i64]
    var out: List[i64] = []
    if ntype(copy(n)) != 2
        return out
    let f = nfields(n)
    if f[2] == ""
        return out
    for x in copy(f[2]).split(",")
        out.push(x.toint())
    return out

fn ser_v(b: List[i64]) -> List[i64]
    let n = b.len() as i64
    if n < 64
        return cat([n], b)
    if n < 16384
        return cat([64 | (n >> 8), n & 255], b)
    return cat([128 | (n >> 24), (n >> 16) & 255, (n >> 8) & 255, n & 255], b)

fn u32b(x: i64) -> List[i64] = [(x >> 24) & 255, (x >> 16) & 255, (x >> 8) & 255, x & 255]

# tree hashes (7.8) of every node of a full tree, bottom up
fn hash_order(w: usize) -> List[i64]
    var o: List[i64] = []
    var x: usize = 0
    while x < w bound 65536
        o.push(x as i64)
        x += 2
    var k: i64 = 1
    while (1 << k) <= w as i64 bound 32
        var y = ((1 << k) - 1) as usize
        while y < w bound 65536
            o.push(y as i64)
            y += (1 << (k + 1)) as usize
        k += 1
    return o

fn node_hash(node: text, x: i64, hl: text, hr: text) -> text
    let present: List[i64] = if node == "" then [0] else cat([1], nbody(copy(node)))
    if x % 2 == 0
        return tohex(sha256(cat(cat([1], u32b(x / 2)), present)))
    return tohex(sha256(cat(cat([2], present), cat(ser_v(unhex(hl)), ser_v(unhex(hr))))))

fn tree_hashes(nodes: List[text]) -> List[text]
    var h: List[text] = []
    for _ in 0..nodes.len()
        h.push("")
    for x in hash_order(nodes.len())
        if x % 2 == 0
            h[x as usize] = node_hash(copy(nodes[x as usize]), x, "", "")
        else
            let l = tm_left(x) as usize
            let r = (x ^ (3 << (tm_level(x) - 1))) as usize
            h[x as usize] = node_hash(copy(nodes[x as usize]), x, copy(h[l]), copy(h[r]))
    return h

# resolution (4.1.1) of node x of a full tree
fn resolution(nodes: List[text], x: i64) -> List[i64]
    var out: List[i64] = []
    var todo: List[i64] = [x]
    while todo.len() > 0 bound 65536
        let y = todo[0]
        todo = slice_i(copy(todo), 1)
        if nodes[y as usize] != ""
            out.push(y)
            for u in unmerged(copy(nodes[y as usize]))
                out.push(2 * u)
        else
            if y % 2 == 1
                todo = cat([tm_left(y), y ^ (3 << (tm_level(y) - 1))], todo)
    return out

fn slice_i(b: List[i64], lo: usize) -> List[i64] = slice(copy(b), lo, b.len())

# the tree with the leaves in ex blanked and removed from every unmerged list
fn strip_leaves(nodes: List[text], ex: List[i64]) -> List[text]
    var out: List[text] = []
    var x: usize = 0
    for n in nodes
        var m = copy(n)
        if x % 2 == 0 and ex.contains((x / 2) as i64)
            m = ""
        if x % 2 == 1 and m != ""
            let um = unmerged(copy(m))
            var keep: List[i64] = []
            for u in copy(um)
                if not ex.contains(u)
                    keep.push(u)
            if keep.len() != um.len()
                let f = nfields(copy(m))
                var ub: List[i64] = []
                for u in keep
                    ub = cat(ub, u32b(u))
                m = tohex(cat([2], cat(cat(ser_v(unhex(copy(f[0]))), ser_v(unhex(copy(f[1])))), ser_v(ub))))
        out.push(m)
        x += 1
    return out

# ParentHash(P) as seen from the child whose sibling is s (7.9)
fn parent_hash_of(nodes: List[text], p: i64, s: i64) -> text
    let f = nfields(copy(nodes[p as usize]))
    let sib = tree_hashes(strip_leaves(copy(nodes), unmerged(copy(nodes[p as usize]))))
    return tohex(sha256(cat(cat(ser_v(unhex(copy(f[0]))), ser_v(unhex(copy(f[1])))), ser_v(unhex(copy(sib[s as usize]))))))

# parent node p is parent-hash valid (7.9.2): a node in the resolution of
# one child, not an unmerged leaf of p, carries ParentHash(p) for that side
fn parent_hash_valid(nodes: List[text], p: i64) -> bool
    if nodes[p as usize] == ""
        return true
    let um = unmerged(copy(nodes[p as usize]))
    let l = tm_left(p)
    let r = p ^ (3 << (tm_level(p) - 1))
    for side in [[l, r], [r, l]]
        let h = parent_hash_of(copy(nodes), p, side[1])
        for d in resolution(copy(nodes), side[0])
            if not um.contains(d / 2) or d % 2 == 1
                if nfields(copy(nodes[d as usize]))[1] == h
                    return true
    return false

# ---- UpdatePath (RFC 9420 7.6, 7.9): decode, filtered direct path, merge,
# and decrypting the path secret a receiver is sent.

fn rt_parent(x: i64) -> i64
    let k = tm_level(x)
    return (x - (x & (1 << (k + 1)))) | (1 << k)

fn rt_sibling(x: i64, p: i64) -> i64 = if x < p then p ^ (3 << (tm_level(p) - 1)) else tm_left(p)

# [leaf as "01" + LeafNode hex, then one "ek|kem_output,ctext|kem_output,ctext" per node]
fn up_parse(uh: text) -> List[text]
    let b = unhex(uh)
    let e = leaf_end(copy(b), 0)
    var out: List[text] = ["01" + tohex(slice(copy(b), 0, e))]
    let r = rd_v(copy(b), e)
    let end = (r[0] + r[1]) as usize
    var p = r[1] as usize
    while p < end bound 4096
        var s = tohex(get_v(copy(b), p)) + "|"
        p = skip_v(copy(b), p)
        let c = rd_v(copy(b), p)
        let ce = (c[0] + c[1]) as usize
        p = c[1] as usize
        while p < ce bound 4096
            s = s + tohex(get_v(copy(b), p)) + ","
            p = skip_v(copy(b), p)
            s = s + tohex(get_v(copy(b), p)) + "|"
            p = skip_v(copy(b), p)
        out.push(s)
    return out

# filtered direct path of leaf s as [node, copath child, node, copath child, ...]
fn filtered_path(nodes: List[text], s: i64) -> List[i64]
    let root = ((nodes.len() + 1) / 2 - 1) as i64
    var out: List[i64] = []
    var x = 2 * s
    while x != root bound 64
        let q = rt_parent(x)
        let sb = rt_sibling(x, q)
        if resolution(copy(nodes), sb).len() > 0
            out.push(q)
            out.push(sb)
        x = q
    return out

# tree hash of the subtree at x alone
fn subtree_hash(nodes: List[text], x: i64) -> text
    let k = tm_level(x)
    let lo = x - ((1 << k) - 1)
    let hi = x + ((1 << k) - 1)
    var h: List[text] = []
    for _ in 0..nodes.len()
        h.push("")
    for y in hash_order(nodes.len())
        if y >= lo and y <= hi
            if y % 2 == 0
                h[y as usize] = node_hash(copy(nodes[y as usize]), y, "", "")
            else
                let l = tm_left(y) as usize
                let r = (y ^ (3 << (tm_level(y) - 1))) as usize
                h[y as usize] = node_hash(copy(nodes[y as usize]), y, copy(h[l]), copy(h[r]))
    return copy(h[x as usize])

# the tree after sender s applies its update path; the last element is the
# parent hash the new leaf must carry
fn up_merge(nodes: List[text], s: i64, up: List[text], fp: List[i64]) -> List[text]
    var t = nodes
    let root = ((t.len() + 1) / 2 - 1) as i64
    var x = 2 * s
    while x != root bound 64
        x = rt_parent(x)
        t[x as usize] = ""
    t[(2 * s) as usize] = copy(up[0])
    var ph: List[i64] = []
    var j = fp.len() / 2
    while j > 0 bound 64
        j -= 1
        let ek = unhex(copy(up[j + 1].split("|")[0]))
        let body = cat(cat(ser_v(copy(ek)), ser_v(copy(ph))), [0])
        t[fp[2 * j] as usize] = "02" + tohex(body)
        let sh = unhex(subtree_hash(copy(t), fp[2 * j + 1]))
        ph = sha256(cat(cat(ser_v(ek), ser_v(ph)), ser_v(sh)))
    t.push(tohex(ph))
    return t

fn group_context(gid: text, epoch: i64, th: text, cth: text) -> text
    var ep: List[i64] = []
    for i in 0..8
        ep.push((epoch >> (8 * (7 - i))) & 255)
    return tohex(cat(cat(cat([0, 1, 0, 1], ser_v(unhex(gid))), cat(ep, ser_v(unhex(th)))), cat(ser_v(unhex(cth)), [0])))

fn node_sk(path_secret: text) -> text = hp_derive_sk(tohex(derive_secret(unhex(path_secret), "node")))

# receiver at leaf i holding private keys held ("nn:sk,..." with the node index nn as one hex byte)
# opens its path secret; returns path_secret + "/" + commit_secret
fn up_receive(nodes: List[text], up: List[text], fp: List[i64], gc: text, i: i64, held: text) -> text
    var keys: List[i64] = []
    var sks: List[text] = []
    for kv in held.split(",")
        if kv != ""
            let parts = kv.split(":")
            keys.push(unhex(copy(parts[0]))[0])
            sks.push(copy(parts[1]))
    let m = fp.len() / 2
    for j in 0..m
        let sb = fp[2 * j + 1]
        let k = tm_level(sb)
        if 2 * i >= sb - ((1 << k) - 1) and 2 * i <= sb + ((1 << k) - 1)
            let cts = up[j + 1].split("|")
            var pos: usize = 0
            for d in resolution(copy(nodes), sb)
                for q in 0..keys.len()
                    if keys[q] == d
                        if pos < 1000
                            let kc = cts[pos + 1].split(",")
                            var ps = decrypt_with_label(copy(sks[q]), "UpdatePathNode", copy(gc), copy(kc[0]), copy(kc[1]))
                            let got = copy(ps)
                            for _ in j + 1..m
                                ps = tohex(derive_secret(unhex(ps), "path"))
                            return got + "/" + tohex(derive_secret(unhex(ps), "path"))
                pos += 1
    return "none"

# ---- generating an update path (RFC 9420 7.4, 7.5, 7.6) ----
# All randomness is an input: the caller passes bytes it got from a logged
# host entropy effect (HC-10), so the same log replays to the same path.

# [leaf_node_secret_sk, path_secret per filtered node..., commit_secret]
fn up_secrets(leaf_secret: text, m: i64) -> List[text]
    var out: List[text] = [node_sk(copy(leaf_secret))]
    var ps = tohex(derive_secret(unhex(leaf_secret), "path"))
    for _ in 0..m
        out.push(copy(ps))
        ps = tohex(derive_secret(unhex(ps), "path"))
    out.push(ps)
    return out

# offsets in a LeafNode body: [signature_key start, source byte, extensions start, signature start]
fn leaf_offsets(b: List[i64]) -> List[i64]
    let k = skip_v(copy(b), 0)
    var p = skip_v(copy(b), k) + 2
    p = skip_v(copy(b), p)
    for _ in 0..5
        p = skip_v(copy(b), p)
    let src = p
    p += 1
    if b[src] == 1
        p += 16
    if b[src] == 3
        p = skip_v(copy(b), p)
    let ext = p
    let sig = skip_v(b, p)
    return [k as i64, src as i64, ext as i64, sig as i64]

# the sender's new LeafNode (source commit): old leaf with a new encryption
# key and the parent hash, signed over LeafNodeTBS with group_id and index
fn up_leaf(old: text, ek: text, ph: text, sig_priv: text, gid: text, s: i64) -> text
    let b = slice_i(unhex(old), 1)
    let o = leaf_offsets(copy(b))
    let body = cat(cat(cat(ser_v(unhex(ek)), slice(copy(b), o[0] as usize, o[1] as usize)), cat([3], ser_v(unhex(ph)))), slice(b, o[2] as usize, o[3] as usize))
    let tbs = cat(cat(copy(body), ser_v(unhex(gid))), u32b(s))
    let sig = sign_with_label(sig_priv, "LeafNodeTBS", tohex(tbs))
    return "01" + tohex(cat(body, ser_v(unhex(sig))))

fn leaf_signature_ok(leaf: text, gid: text, s: i64) -> bool
    let b = slice_i(unhex(leaf), 1)
    let o = leaf_offsets(copy(b))
    let sk = tohex(get_v(copy(b), o[0] as usize))
    let tbs = cat(cat(slice(copy(b), 0, o[3] as usize), ser_v(unhex(gid))), u32b(s))
    return verify_with_label(sk, "LeafNodeTBS", tohex(tbs), tohex(get_v(b, o[3] as usize)))

# one UpdatePathNode: encryption key and the path secret sealed to every
# node of the copath child's resolution, ephemeral keys from rnd in order
fn up_node(nodes: List[text], ek: text, sb: i64, gc: text, ps: text, rnd: text) -> text
    var cts: List[i64] = []
    var k: usize = 0
    for d in resolution(copy(nodes), sb)
        let pk = copy(nfields(copy(nodes[d as usize]))[0])
        let ske = tohex(slice(unhex(copy(rnd)), 32 * k, 32 * (k + 1)))
        let sealed = encrypt_with_label(pk, ske, "UpdatePathNode", copy(gc), copy(ps))
        let parts = sealed.split(".")
        cts = cat(cts, cat(ser_v(unhex(copy(parts[0]))), ser_v(unhex(copy(parts[1])))))
        k += 1
    return tohex(cat(ser_v(unhex(ek)), ser_v(cts)))

fn up_serialize(leaf: text, nodes_hex: List[text]) -> text
    var all: List[i64] = []
    for n in nodes_hex
        all = cat(all, unhex(copy(n)))
    return tohex(cat(slice_i(unhex(leaf), 1), ser_v(all)))
