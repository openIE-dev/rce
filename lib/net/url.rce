module net.url

# WHATWG URL Standard (survey M25, pure part): the basic URL parser
# (section 4.4, no state override), host parsing (IPv4, IPv6, opaque
# hosts, ASCII domains), and serialization with the URL API getters.
# Checked against the WPT url/resources/urltestdata.json. Domains with
# non-ASCII code points, and ASCII labels starting "xn--", need UTS #46
# (IDNA mapping and validity tables, needs spec or data): parsing such a
# host fails with BadUrl(why: "idna"), never with a guessed answer.
# Code points: text is UTF-8, so input is split with chars() and each
# code point value is decoded here.

error BadUrl(why: text)

pub struct Url
    scheme: text
    username: text
    password: text
    has_host: bool
    host: text
    port: i64
    opaque: bool
    opath: text
    path: List[text]
    has_query: bool
    query: text
    has_frag: bool
    frag: text

pub fn url_empty() -> Url = Url(scheme: "", username: "", password: "", has_host: false, host: "", port: -1, opaque: false, opath: "", path: [], has_query: false, query: "", has_frag: false, frag: "")

# ---------------- code points ----------------

pub fn cp_of(c: &text) -> i64
    let b0 = c[0] as i64
    if c.len() == 1
        return b0
    if c.len() == 2
        return ((b0 & 31) << 6) | ((c[1] as i64) & 63)
    if c.len() == 3
        return ((b0 & 15) << 12) | (((c[1] as i64) & 63) << 6) | ((c[2] as i64) & 63)
    return ((b0 & 7) << 18) | (((c[1] as i64) & 63) << 12) | (((c[2] as i64) & 63) << 6) | ((c[3] as i64) & 63)

fn is_alpha(c: i64) -> bool = (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
fn is_digit(c: i64) -> bool = c >= 48 and c <= 57
fn is_hex(c: i64) -> bool = is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
fn hex_val(c: i64) -> i64 = if is_digit(c) then c - 48 else (if c >= 97 then c - 87 else c - 55)
fn lower_cp(c: i64) -> i64 = if c >= 65 and c <= 90 then c + 32 else c

const HEXU: text = "0123456789ABCDEF"
const HEXL: text = "0123456789abcdef"

fn lower_text(t: &text) -> text
    var o = ""
    for c in t.chars()
        let x = cp_of(&c)
        if x >= 65 and x <= 90
            o = o + ascii_char(x + 32)
        else
            o = o + c
    return o

const ASCII: text = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

# The text of printable ASCII code point x (32..126).
fn ascii_char(x: i64) -> text = copy(ASCII.chars()[(x - 32) as usize])

# ---------------- percent-encoding (section 1.3) ----------------
# Sets: 0 C0 control, 1 fragment, 2 query, 3 special-query, 4 path,
# 5 userinfo.

fn in_set(c: i64, set: i64) -> bool
    if c < 32 or c > 126
        return true
    if set == 0
        return false
    if set == 1
        return c == 32 or c == 34 or c == 60 or c == 62 or c == 96
    let q = c == 32 or c == 34 or c == 35 or c == 60 or c == 62
    if set == 2
        return q
    if set == 3
        return q or c == 39
    let p = q or c == 63 or c == 94 or c == 96 or c == 123 or c == 125
    if set == 4
        return p
    return p or c == 47 or c == 58 or c == 59 or c == 61 or c == 64 or c == 91 or c == 92 or c == 93 or c == 124

fn pct_byte(b: i64) -> text
    let hs = HEXU.chars()
    return "%" + copy(hs[(b >> 4) as usize]) + copy(hs[(b & 15) as usize])

pub fn pct_encode(ch: &text, set: i64) -> text
    if not in_set(cp_of(ch), set)
        return copy(ch)
    var o = ""
    var i: usize = 0
    while i < ch.len() bound 4
        o = o + pct_byte(ch[i] as i64)
        i += 1
    return o

# Percent-decode to bytes (section 1.3).
pub fn pct_decode(t: &text) -> List[i64]
    var b: List[i64] = []
    var i: usize = 0
    while i < t.len() bound 16777216
        b.push(t[i] as i64)
        i += 1
    var o: List[i64] = []
    var k: usize = 0
    while k < b.len() bound 16777216
        if b[k] == 37 and k + 2 < b.len() + 0 and is_hex(b[k + 1]) and is_hex(b[k + 2])
            o.push(hex_val(b[k + 1]) * 16 + hex_val(b[k + 2]))
            k += 3
        else
            o.push(b[k])
            k += 1
    return o

# ---------------- hosts (section 3) ----------------

fn forbidden_host(c: i64) -> bool
    return c == 0 or c == 9 or c == 10 or c == 13 or c == 32 or c == 35 or c == 47 or c == 58 or c == 60 or c == 62 or c == 63 or c == 64 or c == 91 or c == 92 or c == 93 or c == 94 or c == 124

fn forbidden_domain(c: i64) -> bool = forbidden_host(c) or c <= 31 or c == 37 or c == 127

fn split_dots(t: &text) -> List[text]
    var parts: List[text] = []
    var cur = ""
    for c in t.chars()
        if c == "."
            parts.push(cur)
            cur = ""
        else
            cur = cur + c
    parts.push(cur)
    return parts

# An IPv4 number (4.3 step "IPv4 number parser"): value, or -1 on
# failure; values above 2^40 are clamped (they fail the range checks).
fn ipv4_number(t: &text) -> i64
    if t == ""
        return -1
    let cs = t.chars()
    var r: i64 = 10
    var i: usize = 0
    if cs.len() >= 2 and cs[0] == "0" and (cs[1] == "x" or cs[1] == "X")
        r = 16
        i = 2
    elif cs.len() >= 2 and cs[0] == "0"
        r = 8
        i = 1
    var v: i64 = 0
    while i < cs.len() bound 16777216
        let c = cp_of(&cs[i])
        var d: i64 = -1
        if is_hex(c)
            d = hex_val(c)
        if d < 0 or d >= r
            return -1
        if v < 1099511627776
            v = v * r + d
        i += 1
    return v

fn ends_in_number(t: &text) -> bool
    var parts = split_dots(t)
    if parts[parts.len() - 1] == ""
        if parts.len() == 1
            return false
        let x = parts.pop()
    let last = copy(parts[parts.len() - 1])
    if last == ""
        return false
    var all = true
    for c in last.chars()
        if not is_digit(cp_of(&c))
            all = false
    if all
        return true
    return ipv4_number(&last) >= 0

fn ipv4_parse(t: &text) -> i64 ! BadUrl
    var parts = split_dots(t)
    if parts[parts.len() - 1] == "" and parts.len() > 1
        let x = parts.pop()
    if parts.len() > 4
        fail BadUrl(why: "ipv4 parts")
    var ns: List[i64] = []
    for p in parts
        let n = ipv4_number(&p)
        if n < 0
            fail BadUrl(why: "ipv4 number")
        ns.push(n)
    var i: usize = 0
    while i + 1 < ns.len() bound 4
        if ns[i] > 255
            fail BadUrl(why: "ipv4 range")
        i += 1
    var lim: i64 = 1
    var k: usize = 0
    while k < 5 - ns.len() bound 5
        lim = lim * 256
        k += 1
    if ns[ns.len() - 1] >= lim
        fail BadUrl(why: "ipv4 range")
    var v = ns[ns.len() - 1]
    var j: usize = 0
    while j + 1 < ns.len() bound 4
        var m: i64 = 1
        var e: usize = 0
        while e < 3 - j bound 3
            m = m * 256
            e += 1
        v += ns[j] * m
        j += 1
    return v

fn ipv4_text(v: i64) -> text
    return ((v >> 24) & 255).tostr() + "." + ((v >> 16) & 255).tostr() + "." + ((v >> 8) & 255).tostr() + "." + (v & 255).tostr()

fn at(cs: &[i64], p: usize) -> i64 = if p < cs.len() then cs[p] else -1

pub fn ipv6_parse(t: &text) -> List[i64] ! BadUrl
    var cs: List[i64] = []
    for c in t.chars()
        cs.push(cp_of(&c))
    var a: List[i64] = [0, 0, 0, 0, 0, 0, 0, 0]
    var pi: usize = 0
    var comp: i64 = -1
    var p: usize = 0
    if at(&cs, 0) == 58
        if at(&cs, 1) != 58
            fail BadUrl(why: "ipv6")
        p = 2
        pi = 1
        comp = 1
    while at(&cs, p) != -1 bound 64
        if pi == 8
            fail BadUrl(why: "ipv6")
        if at(&cs, p) == 58
            if comp >= 0
                fail BadUrl(why: "ipv6")
            p += 1
            pi += 1
            comp = pi as i64
            continue
        var v: i64 = 0
        var len: usize = 0
        while len < 4 and is_hex(at(&cs, p)) bound 4
            v = v * 16 + hex_val(at(&cs, p))
            p += 1
            len += 1
        if at(&cs, p) == 46
            if len == 0
                fail BadUrl(why: "ipv6")
            p -= len
            if pi > 6
                fail BadUrl(why: "ipv6")
            var seen: i64 = 0
            while at(&cs, p) != -1 bound 64
                var piece: i64 = -1
                if seen > 0
                    if at(&cs, p) == 46 and seen < 4
                        p += 1
                    else
                        fail BadUrl(why: "ipv6 v4")
                if not is_digit(at(&cs, p))
                    fail BadUrl(why: "ipv6 v4")
                while is_digit(at(&cs, p)) bound 64
                    let n = at(&cs, p) - 48
                    if piece == -1
                        piece = n
                    elif piece == 0
                        fail BadUrl(why: "ipv6 v4")
                    else
                        piece = piece * 10 + n
                    if piece > 255
                        fail BadUrl(why: "ipv6 v4")
                    p += 1
                a[pi] = a[pi] * 256 + piece
                seen += 1
                if seen == 2 or seen == 4
                    pi += 1
            if seen != 4
                fail BadUrl(why: "ipv6 v4")
            break
        elif at(&cs, p) == 58
            p += 1
            if at(&cs, p) == -1
                fail BadUrl(why: "ipv6")
        elif at(&cs, p) != -1
            fail BadUrl(why: "ipv6")
        a[pi] = v
        pi += 1
    if comp >= 0
        var swaps = (pi as i64) - comp
        var q: i64 = 7
        while q != 0 and swaps > 0 bound 8
            let x = (comp + swaps - 1) as usize
            let y = a[q as usize]
            a[q as usize] = a[x]
            a[x] = y
            q -= 1
            swaps -= 1
    elif pi != 8
        fail BadUrl(why: "ipv6")
    return a

fn hex_piece(v: i64) -> text
    if v == 0
        return "0"
    let hs = HEXL.chars()
    var o = ""
    var x = v
    while x > 0 bound 4
        o = copy(hs[(x & 15) as usize]) + o
        x = x >> 4
    return o

pub fn ipv6_text(a: &[i64]) -> text
    var best: i64 = -1
    var blen: i64 = 1
    var i: i64 = 0
    while i < 8 bound 8
        var j = i
        while j < 8 and a[j as usize] == 0 bound 8
            j += 1
        if j - i > blen
            best = i
            blen = j - i
        i = if j > i then j else i + 1
    var o = ""
    var ignore = false
    var k: i64 = 0
    while k < 8 bound 8
        if ignore and a[k as usize] == 0
            k += 1
            continue
        ignore = false
        if best == k
            o = o + (if k == 0 then "::" else ":")
            ignore = true
            k += 1
            continue
        o = o + hex_piece(a[k as usize])
        if k != 7
            o = o + ":"
        k += 1
    return o

fn bytes_text_ascii(b: &[i64]) -> text ! BadUrl
    var o = ""
    for x in b
        if x >= 128
            fail BadUrl(why: "idna")
        if x < 32 or x == 127
            fail BadUrl(why: "forbidden domain code point")
        o = o + ascii_char(lower_cp(x))
    return o

# Host parser (section 3.5); `special` is "not opaque".
pub fn host_parse(input: &text, special: bool) -> text ! BadUrl
    let cs = input.chars()
    if cs.len() > 0 and cs[0] == "["
        if cs[cs.len() - 1] != "]"
            fail BadUrl(why: "ipv6 unclosed")
        var inner = ""
        var i: usize = 1
        while i + 1 < cs.len() bound 16777216
            inner = inner + cs[i]
            i += 1
        let a = try ipv6_parse(&inner)
        return "[" + ipv6_text(&a) + "]"
    if not special
        var o = ""
        for c in cs
            if forbidden_host(cp_of(&c))
                fail BadUrl(why: "forbidden host code point")
            o = o + pct_encode(&c, 0)
        return o
    let d = pct_decode(input)
    let ascii = try bytes_text_ascii(&d)
    for c in ascii.chars()
        if forbidden_domain(cp_of(&c))
            fail BadUrl(why: "forbidden domain code point")
    for l in split_dots(&ascii)
        if l.startswith("xn--")
            fail BadUrl(why: "idna")
    if ascii == ""
        fail BadUrl(why: "empty host")
    if ends_in_number(&ascii)
        let v = try ipv4_parse(&ascii)
        return ipv4_text(v)
    return ascii

# ---------------- schemes and paths ----------------

pub fn is_special(s: &text) -> bool = s == "ftp" or s == "file" or s == "http" or s == "https" or s == "ws" or s == "wss"

pub fn default_port(s: &text) -> i64
    if s == "ftp"
        return 21
    if s == "http" or s == "ws"
        return 80
    if s == "https" or s == "wss"
        return 443
    return -1

fn is_wdl(t: &text, normalized: bool) -> bool
    let cs = t.chars()
    if cs.len() != 2 or not is_alpha(cp_of(&cs[0]))
        return false
    return cs[1] == ":" or (not normalized and cs[1] == "|")

fn starts_wdl(cs: &[i64], p: usize) -> bool
    if p + 1 >= cs.len() + 0 and p + 2 > cs.len()
        return false
    if not is_alpha(cs[p]) or (cs[p + 1] != 58 and cs[p + 1] != 124)
        return false
    if p + 2 == cs.len()
        return true
    let c = cs[p + 2]
    return c == 47 or c == 92 or c == 63 or c == 35

fn single_dot(b: &text) -> bool = b == "." or lower_text(b) == "%2e"
fn double_dot(b: &text) -> bool
    let l = lower_text(b)
    return l == ".." or l == ".%2e" or l == "%2e." or l == "%2e%2e"

fn shorten(u: &mut Url)
    if u.scheme == "file" and u.path.len() == 1 and is_wdl(&u.path[0], true)
        return
    if u.path.len() > 0
        let x = u.path.pop()

# ---------------- the basic URL parser (4.4) ----------------

# States
const S_SCHEME_START: i64 = 0
const S_SCHEME: i64 = 1
const S_NO_SCHEME: i64 = 2
const S_SPECIAL_REL_OR_AUTH: i64 = 3
const S_PATH_OR_AUTH: i64 = 4
const S_RELATIVE: i64 = 5
const S_RELATIVE_SLASH: i64 = 6
const S_SPECIAL_AUTH_SLASHES: i64 = 7
const S_SPECIAL_AUTH_IGNORE: i64 = 8
const S_AUTHORITY: i64 = 9
const S_HOST: i64 = 10
const S_PORT: i64 = 11
const S_FILE: i64 = 12
const S_FILE_SLASH: i64 = 13
const S_FILE_HOST: i64 = 14
const S_PATH_START: i64 = 15
const S_PATH: i64 = 16
const S_OPAQUE: i64 = 17
const S_QUERY: i64 = 18
const S_FRAGMENT: i64 = 19

fn is_c0_or_space(c: i64) -> bool = c >= 0 and c <= 32

pub fn parse(input: &text) -> Url ! BadUrl
    let e = url_empty()
    return parse_url(input, &e, false)

pub fn parse_with(input: &text, base: &Url) -> Url ! BadUrl = parse_url(input, base, true)

fn copy_base_auth(u: &mut Url, b: &Url)
    u.username = copy(b.username)
    u.password = copy(b.password)
    u.has_host = b.has_host
    u.host = copy(b.host)
    u.port = b.port

fn parse_url(input: &text, base: &Url, has_base: bool) -> Url ! BadUrl
    # strip leading and trailing C0 control or space, remove tab and newline
    let all = input.chars()
    var lo: usize = 0
    var hi: usize = all.len()
    while lo < hi and is_c0_or_space(cp_of(&all[lo])) bound 16777216
        lo += 1
    while hi > lo and is_c0_or_space(cp_of(&all[hi - 1])) bound 16777216
        hi -= 1
    var ch: List[text] = []
    var cs: List[i64] = []
    var i = lo
    while i < hi bound 16777216
        let x = cp_of(&all[i])
        if x != 9 and x != 10 and x != 13
            ch.push(copy(all[i]))
            cs.push(x)
        i += 1
    var u = url_empty()
    var st = S_SCHEME_START
    var buf = ""
    var at_seen = false
    var brackets = false
    var pw_seen = false
    var p: i64 = 0
    let n = cs.len() as i64
    while p <= n bound 16777216
        let c = if p < n then cs[p as usize] else -1
        let cc = if p < n then copy(ch[p as usize]) else ""
        let rem1 = if p + 1 < n then cs[(p + 1) as usize] else -1
        let sp = is_special(&u.scheme)
        if st == S_SCHEME_START
            if is_alpha(c)
                buf = buf + ascii_char(lower_cp(c))
                st = S_SCHEME
            else
                st = S_NO_SCHEME
                p -= 1
        elif st == S_SCHEME
            if is_alpha(c) or is_digit(c) or c == 43 or c == 45 or c == 46
                buf = buf + ascii_char(lower_cp(c))
            elif c == 58
                u.scheme = buf
                buf = ""
                if u.scheme == "file"
                    st = S_FILE
                elif is_special(&u.scheme) and has_base and base.scheme == u.scheme
                    st = S_SPECIAL_REL_OR_AUTH
                elif is_special(&u.scheme)
                    st = S_SPECIAL_AUTH_SLASHES
                elif rem1 == 47
                    st = S_PATH_OR_AUTH
                    p += 1
                else
                    u.opaque = true
                    u.opath = ""
                    st = S_OPAQUE
            else
                buf = ""
                st = S_NO_SCHEME
                p = -1
        elif st == S_NO_SCHEME
            if not has_base or (base.opaque and c != 35)
                fail BadUrl(why: "no scheme")
            elif base.opaque and c == 35
                u.scheme = copy(base.scheme)
                u.opaque = true
                u.opath = copy(base.opath)
                u.has_query = base.has_query
                u.query = copy(base.query)
                u.has_frag = true
                u.frag = ""
                st = S_FRAGMENT
            elif base.scheme != "file"
                st = S_RELATIVE
                p -= 1
            else
                st = S_FILE
                p -= 1
        elif st == S_SPECIAL_REL_OR_AUTH
            if c == 47 and rem1 == 47
                st = S_SPECIAL_AUTH_IGNORE
                p += 1
            else
                st = S_RELATIVE
                p -= 1
        elif st == S_PATH_OR_AUTH
            if c == 47
                st = S_AUTHORITY
            else
                st = S_PATH
                p -= 1
        elif st == S_RELATIVE
            u.scheme = copy(base.scheme)
            if c == 47
                st = S_RELATIVE_SLASH
            elif is_special(&u.scheme) and c == 92
                st = S_RELATIVE_SLASH
            else
                copy_base_auth(&mut u, base)
                u.path = copy(base.path)
                u.has_query = base.has_query
                u.query = copy(base.query)
                if c == 63
                    u.has_query = true
                    u.query = ""
                    st = S_QUERY
                elif c == 35
                    u.has_frag = true
                    u.frag = ""
                    st = S_FRAGMENT
                elif c != -1
                    u.has_query = false
                    u.query = ""
                    shorten(&mut u)
                    st = S_PATH
                    p -= 1
        elif st == S_RELATIVE_SLASH
            if sp and (c == 47 or c == 92)
                st = S_SPECIAL_AUTH_IGNORE
            elif c == 47
                st = S_AUTHORITY
            else
                copy_base_auth(&mut u, base)
                st = S_PATH
                p -= 1
        elif st == S_SPECIAL_AUTH_SLASHES
            st = S_SPECIAL_AUTH_IGNORE
            if c == 47 and rem1 == 47
                p += 1
            else
                p -= 1
        elif st == S_SPECIAL_AUTH_IGNORE
            if c != 47 and c != 92
                st = S_AUTHORITY
                p -= 1
        elif st == S_AUTHORITY
            if c == 64
                if at_seen
                    buf = "%40" + buf
                at_seen = true
                for b in buf.chars()
                    if b == ":" and not pw_seen
                        pw_seen = true
                        continue
                    let e = pct_encode(&b, 5)
                    if pw_seen
                        u.password = u.password + e
                    else
                        u.username = u.username + e
                buf = ""
            elif c == -1 or c == 47 or c == 63 or c == 35 or (sp and c == 92)
                if at_seen and buf == ""
                    fail BadUrl(why: "empty credentials host")
                p -= (buf.chars().len() as i64) + 1
                buf = ""
                st = S_HOST
            else
                buf = buf + cc
        elif st == S_HOST
            if c == 58 and not brackets
                if buf == ""
                    fail BadUrl(why: "empty host")
                let h = try host_parse(&buf, sp)
                u.has_host = true
                u.host = h
                buf = ""
                st = S_PORT
            elif c == -1 or c == 47 or c == 63 or c == 35 or (sp and c == 92)
                p -= 1
                if sp and buf == ""
                    fail BadUrl(why: "empty host")
                let h = try host_parse(&buf, sp)
                u.has_host = true
                u.host = h
                buf = ""
                st = S_PATH_START
            else
                if c == 91
                    brackets = true
                if c == 93
                    brackets = false
                buf = buf + cc
        elif st == S_PORT
            if is_digit(c)
                buf = buf + cc
            elif c == -1 or c == 47 or c == 63 or c == 35 or (sp and c == 92)
                if buf != ""
                    var v: i64 = 0
                    for d in buf.chars()
                        if v <= 65535
                            v = v * 10 + cp_of(&d) - 48
                    if v > 65535
                        fail BadUrl(why: "port range")
                    u.port = if v == default_port(&u.scheme) then -1 else v
                    buf = ""
                st = S_PATH_START
                p -= 1
            else
                fail BadUrl(why: "port")
        elif st == S_FILE
            u.scheme = "file"
            u.has_host = true
            u.host = ""
            if c == 47 or c == 92
                st = S_FILE_SLASH
            elif has_base and base.scheme == "file"
                u.has_host = base.has_host
                u.host = copy(base.host)
                u.path = copy(base.path)
                u.has_query = base.has_query
                u.query = copy(base.query)
                if c == 63
                    u.has_query = true
                    u.query = ""
                    st = S_QUERY
                elif c == 35
                    u.has_frag = true
                    u.frag = ""
                    st = S_FRAGMENT
                elif c != -1
                    u.has_query = false
                    u.query = ""
                    if not starts_wdl(&cs, p as usize)
                        shorten(&mut u)
                    else
                        u.path = []
                    st = S_PATH
                    p -= 1
            else
                st = S_PATH
                p -= 1
        elif st == S_FILE_SLASH
            if c == 47 or c == 92
                st = S_FILE_HOST
            else
                if has_base and base.scheme == "file"
                    u.has_host = base.has_host
                    u.host = copy(base.host)
                    if not starts_wdl(&cs, p as usize) and base.path.len() > 0 and is_wdl(&base.path[0], true)
                        u.path.push(copy(base.path[0]))
                st = S_PATH
                p -= 1
        elif st == S_FILE_HOST
            if c == -1 or c == 47 or c == 92 or c == 63 or c == 35
                p -= 1
                if is_wdl(&buf, false)
                    st = S_PATH
                elif buf == ""
                    u.has_host = true
                    u.host = ""
                    st = S_PATH_START
                else
                    var h = try host_parse(&buf, sp)
                    if h == "localhost"
                        h = ""
                    u.has_host = true
                    u.host = h
                    buf = ""
                    st = S_PATH_START
            else
                buf = buf + cc
        elif st == S_PATH_START
            if sp
                st = S_PATH
                if c != 47 and c != 92
                    p -= 1
            elif c == 63
                u.has_query = true
                u.query = ""
                st = S_QUERY
            elif c == 35
                u.has_frag = true
                u.frag = ""
                st = S_FRAGMENT
            elif c != -1
                st = S_PATH
                if c != 47
                    p -= 1
        elif st == S_PATH
            let slash = c == 47 or (sp and c == 92)
            if c == -1 or slash or c == 63 or c == 35
                if double_dot(&buf)
                    shorten(&mut u)
                    if not slash
                        u.path.push("")
                elif single_dot(&buf) and not slash
                    u.path.push("")
                elif not single_dot(&buf)
                    if u.scheme == "file" and u.path.len() == 0 and is_wdl(&buf, false)
                        buf = copy(buf.chars()[0]) + ":"
                    u.path.push(buf)
                buf = ""
                if c == 63
                    u.has_query = true
                    u.query = ""
                    st = S_QUERY
                if c == 35
                    u.has_frag = true
                    u.frag = ""
                    st = S_FRAGMENT
            else
                buf = buf + pct_encode(&cc, 4)
        elif st == S_OPAQUE
            if c == 63
                u.has_query = true
                u.query = ""
                st = S_QUERY
            elif c == 35
                u.has_frag = true
                u.frag = ""
                st = S_FRAGMENT
            elif c == 32
                if rem1 == 63 or rem1 == 35
                    u.opath = u.opath + "%20"
                else
                    u.opath = u.opath + " "
            elif c != -1
                u.opath = u.opath + pct_encode(&cc, 0)
        elif st == S_QUERY
            if c == 35
                u.has_frag = true
                u.frag = ""
                st = S_FRAGMENT
            elif c != -1
                u.query = u.query + pct_encode(&cc, if sp then 3 else 2)
        elif st == S_FRAGMENT
            if c != -1
                u.frag = u.frag + pct_encode(&cc, 1)
        p += 1
    return u

# ---------------- serialization and the URL API (4.5, 6) ----------------

pub fn pathname(u: &Url) -> text
    if u.opaque
        return copy(u.opath)
    var o = ""
    for s in u.path
        o = o + "/" + s
    return o

pub fn href(u: &Url) -> text
    var o = u.scheme + ":"
    if u.has_host
        o = o + "//"
        if u.username != "" or u.password != ""
            o = o + u.username
            if u.password != ""
                o = o + ":" + u.password
            o = o + "@"
        o = o + u.host
        if u.port >= 0
            o = o + ":" + u.port.tostr()
    elif not u.opaque and u.path.len() > 1 and u.path[0] == ""
        o = o + "/."
    o = o + pathname(u)
    if u.has_query
        o = o + "?" + u.query
    if u.has_frag
        o = o + "#" + u.frag
    return o

pub fn protocol(u: &Url) -> text = u.scheme + ":"
pub fn hostname(u: &Url) -> text = copy(u.host)
pub fn port_text(u: &Url) -> text = if u.port >= 0 then u.port.tostr() else ""
pub fn host_text(u: &Url) -> text = if u.port >= 0 then u.host + ":" + u.port.tostr() else copy(u.host)
pub fn search(u: &Url) -> text = if u.has_query and u.query != "" then "?" + u.query else ""
pub fn hash(u: &Url) -> text = if u.has_frag and u.frag != "" then "#" + u.frag else ""
