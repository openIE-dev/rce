module ui.text
# uses: text/utf8
use text.utf8

# Text segmentation, line breaking, bidi and terminal width (survey M47),
# pure, over the Unicode 16.0.0 data pinned in scripts/gen/text_data.py.
# Input is a list of code points (utf8.codepoints of a text). Boundaries
# are code point offsets 0 < b <= n, each the start of the next segment
# (n closes the last one); an empty input has none.
# - UAX #29 (revision 45): grapheme clusters (extended, with GB9c Indic
#   conjuncts), words and sentences, default rules.
# - UAX #14 (revision 53): line break opportunities with the default
#   LB1 resolution; mandatory breaks are reported separately.
# - UAX #9 (revision 50): paragraph level (P2, P3), explicit levels (X1 to
#   X10), weak and neutral types (W1 to W7, N0 bracket pairs, N1, N2),
#   implicit levels (I1, I2), L1 for one line, L2 visual order.
# - Terminal cells: derived (see vectors/SOURCE.md): 2 for East Asian
#   Wide and Fullwidth, 0 for marks, format characters and Hangul medial
#   and final jamo, 1 otherwise; a grapheme cluster takes its first
#   non-zero width, and 2 when it holds U+FE0F after an emoji.

pub fn cps(t: &text) -> List[i64] = utf8.codepoints(t)

# ---------------- UAX #29 grapheme clusters ----------------
const G_CR: i64 = 1
const G_LF: i64 = 2
const G_CONTROL: i64 = 3
const G_EXTEND: i64 = 4
const G_ZWJ: i64 = 5
const G_RI: i64 = 6
const G_PREPEND: i64 = 7
const G_SPACINGMARK: i64 = 8
const G_L: i64 = 9
const G_V: i64 = 10
const G_T: i64 = 11
const G_LV: i64 = 12
const G_LVT: i64 = 13

pub fn grapheme_breaks(cs: &[i64]) -> List[i64]
    var out: List[i64] = []
    let n = cs.len()
    if n == 0
        return out
    var prev = gcb(copy(cs[0]))
    # GB9c: 0 none, 1 after Consonant [Extend Linker]*, 2 after one with a Linker
    var conj: i64 = if incb(copy(cs[0])) == 2 then 1 else 0
    # GB11: 0 none, 1 after ExtPict Extend*, 2 after ExtPict Extend* ZWJ
    var emo: i64 = if ext_pict(copy(cs[0])) then 1 else 0
    var ri: i64 = if prev == G_RI then 1 else 0
    var i: usize = 1
    while i < n
        let c = copy(cs[i])
        let cur = gcb(c)
        let ic = incb(c)
        var brk = true
        if prev == G_CR and cur == G_LF
            brk = false
        elif prev == G_CONTROL or prev == G_CR or prev == G_LF
            brk = true
        elif cur == G_CONTROL or cur == G_CR or cur == G_LF
            brk = true
        elif prev == G_L and (cur == G_L or cur == G_V or cur == G_LV or cur == G_LVT)
            brk = false
        elif (prev == G_LV or prev == G_V) and (cur == G_V or cur == G_T)
            brk = false
        elif (prev == G_LVT or prev == G_T) and cur == G_T
            brk = false
        elif cur == G_EXTEND or cur == G_ZWJ or cur == G_SPACINGMARK or prev == G_PREPEND
            brk = false
        elif conj == 2 and ic == 2
            brk = false
        elif emo == 2 and ext_pict(c)
            brk = false
        elif prev == G_RI and cur == G_RI and ri % 2 == 1
            brk = false
        if brk
            out.push(i as i64)
        # state after c
        if ic == 2
            conj = 1
        elif conj > 0 and ic == 1
            conj = 2
        elif conj > 0 and ic == 3
            conj = conj
        else
            conj = 0
        if ext_pict(c)
            emo = 1
        elif emo == 1 and cur == G_EXTEND
            emo = 1
        elif emo == 1 and cur == G_ZWJ
            emo = 2
        else
            emo = 0
        ri = if cur == G_RI then ri + 1 else 0
        prev = cur
        i += 1
    out.push(n as i64)
    return out
# ---------------- UAX #29 words ----------------
const W_CR: i64 = 1
const W_LF: i64 = 2
const W_NEWLINE: i64 = 3
const W_EXTEND: i64 = 4
const W_ZWJ: i64 = 5
const W_RI: i64 = 6
const W_FORMAT: i64 = 7
const W_KATAKANA: i64 = 8
const W_HL: i64 = 9
const W_ALETTER: i64 = 10
const W_SQ: i64 = 11
const W_DQ: i64 = 12
const W_MIDNUMLET: i64 = 13
const W_MIDLETTER: i64 = 14
const W_MIDNUM: i64 = 15
const W_NUMERIC: i64 = 16
const W_ENL: i64 = 17
const W_WSEG: i64 = 18

fn w_ign(k: i64) -> bool = k == W_EXTEND or k == W_FORMAT or k == W_ZWJ
fn w_ah(k: i64) -> bool = k == W_ALETTER or k == W_HL
fn w_midlq(k: i64) -> bool = k == W_MIDLETTER or k == W_MIDNUMLET or k == W_SQ
fn w_midnq(k: i64) -> bool = k == W_MIDNUM or k == W_MIDNUMLET or k == W_SQ

# Index of the nearest non-ignorable (WB4) class at or before i, or -1.
fn w_back(ks: &[i64], i: i64) -> i64
    var j = i
    while j >= 0 and w_ign(copy(ks[j as usize]))
        j -= 1
    return j

fn w_fwd(ks: &[i64], i: i64) -> i64
    var j = i
    while j < ks.len() as i64 and w_ign(copy(ks[j as usize]))
        j += 1
    return j

pub fn word_breaks(cs: &[i64]) -> List[i64]
    var out: List[i64] = []
    let n = cs.len()
    if n == 0
        return out
    var ks: List[i64] = []
    for c in cs
        ks.push(wb(c))
    var i: usize = 1
    while i < n
        let rp = copy(ks[i - 1])
        let cur = copy(ks[i])
        var brk = true
        var done = false
        if rp == W_CR and cur == W_LF
            brk = false
            done = true
        elif rp == W_NEWLINE or rp == W_CR or rp == W_LF or cur == W_NEWLINE or cur == W_CR or cur == W_LF
            done = true
        elif rp == W_ZWJ and ext_pict(copy(cs[i]))
            brk = false
            done = true
        elif rp == W_WSEG and cur == W_WSEG
            brk = false
            done = true
        elif w_ign(cur)
            brk = false
            done = true
        if not done
            let pj = w_back(&ks, i as i64 - 1)
            let a = if pj >= 0 then copy(ks[pj as usize]) else -1
            let pj2 = if pj >= 0 then w_back(&ks, pj - 1) else -1
            let a2 = if pj2 >= 0 then copy(ks[pj2 as usize]) else -1
            let nj = w_fwd(&ks, i as i64 + 1)
            let b2 = if nj < n as i64 then copy(ks[nj as usize]) else -1
            if w_ah(a) and w_ah(cur)
                brk = false
            elif w_ah(a) and w_midlq(cur) and w_ah(b2)
                brk = false
            elif w_ah(a2) and w_midlq(a) and w_ah(cur)
                brk = false
            elif a == W_HL and cur == W_SQ
                brk = false
            elif a == W_HL and cur == W_DQ and b2 == W_HL
                brk = false
            elif a2 == W_HL and a == W_DQ and cur == W_HL
                brk = false
            elif a == W_NUMERIC and cur == W_NUMERIC
                brk = false
            elif w_ah(a) and cur == W_NUMERIC
                brk = false
            elif a == W_NUMERIC and w_ah(cur)
                brk = false
            elif a2 == W_NUMERIC and w_midnq(a) and cur == W_NUMERIC
                brk = false
            elif a == W_NUMERIC and w_midnq(cur) and b2 == W_NUMERIC
                brk = false
            elif a == W_KATAKANA and cur == W_KATAKANA
                brk = false
            elif (w_ah(a) or a == W_NUMERIC or a == W_KATAKANA or a == W_ENL) and cur == W_ENL
                brk = false
            elif a == W_ENL and (w_ah(cur) or cur == W_NUMERIC or cur == W_KATAKANA)
                brk = false
            elif a == W_RI and cur == W_RI
                # WB15, WB16: odd count of RI (ignoring WB4 characters) before
                var cnt: i64 = 0
                var j = pj
                while j >= 0 and copy(ks[j as usize]) == W_RI
                    cnt += 1
                    j = w_back(&ks, j - 1)
                brk = cnt % 2 == 0
        if brk
            out.push(i as i64)
        i += 1
    out.push(n as i64)
    return out
# ---------------- UAX #29 sentences ----------------
const S_CR: i64 = 1
const S_LF: i64 = 2
const S_EXTEND: i64 = 3
const S_SEP: i64 = 4
const S_FORMAT: i64 = 5
const S_SP: i64 = 6
const S_LOWER: i64 = 7
const S_UPPER: i64 = 8
const S_OLETTER: i64 = 9
const S_NUMERIC: i64 = 10
const S_ATERM: i64 = 11
const S_SCONTINUE: i64 = 12
const S_STERM: i64 = 13
const S_CLOSE: i64 = 14

fn s_ign(k: i64) -> bool = k == S_EXTEND or k == S_FORMAT
fn s_para(k: i64) -> bool = k == S_SEP or k == S_CR or k == S_LF
fn s_aterm(k: i64) -> bool = k == S_ATERM or k == S_STERM

fn s_back(ks: &[i64], i: i64) -> i64
    var j = i
    while j >= 0 and s_ign(copy(ks[j as usize]))
        j -= 1
    return j

fn s_fwd(ks: &[i64], i: i64) -> i64
    var j = i
    while j < ks.len() as i64 and s_ign(copy(ks[j as usize]))
        j += 1
    return j

pub fn sentence_breaks(cs: &[i64]) -> List[i64]
    var out: List[i64] = []
    let n = cs.len()
    if n == 0
        return out
    var ks: List[i64] = []
    for c in cs
        ks.push(sb(c))
    var i: usize = 1
    while i < n
        let rp = copy(ks[i - 1])
        let cur = copy(ks[i])
        var brk = false
        if rp == S_CR and cur == S_LF
            brk = false
        elif s_para(rp)
            brk = true
        elif s_ign(cur)
            brk = false
        else
            let pj = s_back(&ks, i as i64 - 1)
            let a = if pj >= 0 then copy(ks[pj as usize]) else -1
            let pj2 = if pj >= 0 then s_back(&ks, pj - 1) else -1
            let a2 = if pj2 >= 0 then copy(ks[pj2 as usize]) else -1
            # SATerm Close* Sp* ending at pj
            var j = pj
            var sp = false
            while j >= 0 and copy(ks[j as usize]) == S_SP
                sp = true
                j = s_back(&ks, j - 1)
            while j >= 0 and copy(ks[j as usize]) == S_CLOSE
                j = s_back(&ks, j - 1)
            let term = if j >= 0 then copy(ks[j as usize]) else -1
            let pat = s_aterm(term)
            if a == S_ATERM and cur == S_NUMERIC
                brk = false
            elif a == S_ATERM and (a2 == S_UPPER or a2 == S_LOWER) and cur == S_UPPER
                brk = false
            elif pat and term == S_ATERM and s8(&ks, i as i64)
                brk = false
            elif pat and (cur == S_SCONTINUE or s_aterm(cur))
                brk = false
            elif pat and not sp and (cur == S_CLOSE or cur == S_SP or s_para(cur))
                brk = false
            elif pat and (cur == S_SP or s_para(cur))
                brk = false
            elif pat
                brk = true
        if brk
            out.push(i as i64)
        i += 1
    out.push(n as i64)
    return out

# SB8: ( not (OLetter | Upper | Lower | ParaSep | SATerm) )* Lower, from i on.
fn s8(ks: &[i64], i: i64) -> bool
    var j = i
    while j < ks.len() as i64
        let k = copy(ks[j as usize])
        if k == S_LOWER
            return true
        if k == S_OLETTER or k == S_UPPER or s_para(k) or s_aterm(k)
            return false
        j = s_fwd(ks, j + 1)
    return false
# ---------------- UAX #14 line breaking ----------------
const L_XX: i64 = 0
const L_BK: i64 = 1
const L_CR: i64 = 2
const L_LF: i64 = 3
const L_CM: i64 = 4
const L_NL: i64 = 5
const L_SG: i64 = 6
const L_WJ: i64 = 7
const L_ZW: i64 = 8
const L_GL: i64 = 9
const L_SP: i64 = 10
const L_ZWJ: i64 = 11
const L_B2: i64 = 12
const L_BA: i64 = 13
const L_BB: i64 = 14
const L_HY: i64 = 15
const L_CB: i64 = 16
const L_CL: i64 = 17
const L_CP: i64 = 18
const L_EX: i64 = 19
const L_IN: i64 = 20
const L_NS: i64 = 21
const L_OP: i64 = 22
const L_QU: i64 = 23
const L_IS: i64 = 24
const L_NU: i64 = 25
const L_PO: i64 = 26
const L_PR: i64 = 27
const L_SY: i64 = 28
const L_AI: i64 = 29
const L_AL: i64 = 30
const L_CJ: i64 = 31
const L_EB: i64 = 32
const L_EM: i64 = 33
const L_H2: i64 = 34
const L_H3: i64 = 35
const L_HL: i64 = 36
const L_ID: i64 = 37
const L_JL: i64 = 38
const L_JV: i64 = 39
const L_JT: i64 = 40
const L_RI: i64 = 41
const L_SA: i64 = 42
const L_AK: i64 = 43
const L_AP: i64 = 44
const L_AS: i64 = 45
const L_VF: i64 = 46
const L_VI: i64 = 47

const GC_CN: i64 = 0
const GC_MN: i64 = 6
const GC_MC: i64 = 7
const GC_PI: i64 = 16
const GC_PF: i64 = 17

# Per code point after LB1, LB9 and LB10: class, general category, East
# Asian width, Extended_Pictographic and whether LB9 absorbed it.
struct LbItem
    cls: i64
    raw: i64
    gcat: i64
    east: bool
    pict: bool
    cp: i64
    gone: bool

fn lb1(c: i64) -> i64
    let k = lb(c)
    if k == L_AI or k == L_SG or k == L_XX
        return L_AL
    if k == L_SA
        let g = gc(c)
        return if g == GC_MN or g == GC_MC then L_CM else L_AL
    if k == L_CJ
        return L_NS
    return k

fn lb_items(cs: &[i64]) -> List[LbItem]
    var it: List[LbItem] = []
    var base: i64 = -1
    for c in cs
        let k = lb1(c)
        let e = ea(c)
        var x = LbItem(cls: k, raw: k, gcat: gc(c), east: e == 2 or e == 3 or e == 5, pict: ext_pict(c), cp: c, gone: false)
        if k == L_CM or k == L_ZWJ
            if base >= 0
                x.gone = true
            else
                # LB10: as U+0041
                x.cls = L_AL
                x.gcat = 1
                x.east = false
                x.pict = false
                base = 0
        elif k == L_BK or k == L_CR or k == L_LF or k == L_NL or k == L_SP or k == L_ZW
            base = -1
        else
            base = 0
        it.push(x)
    return it

fn lb_prev(it: &[LbItem], i: i64) -> i64
    var j = i
    while j >= 0 and it[j as usize].gone
        j -= 1
    return j

fn lb_next(it: &[LbItem], i: i64) -> i64
    var j = i
    while j < it.len() as i64 and it[j as usize].gone
        j += 1
    return j

fn lcls(it: &[LbItem], j: i64) -> i64 = if j >= 0 and j < it.len() as i64 then copy(it[j as usize].cls) else -1

fn ak_set(it: &[LbItem], j: i64) -> bool
    let k = lcls(it, j)
    return k == L_AK or k == L_AS or (j >= 0 and j < it.len() as i64 and it[j as usize].cp == 9676)

# 0 no break before i, 1 break opportunity, 2 mandatory break.
fn lb_at(it: &[LbItem], i: i64) -> i64
    let rp = copy(it[(i - 1) as usize].raw)
    let rcur = copy(it[i as usize].raw)
    if rp == L_BK
        return 2
    if rp == L_CR and rcur == L_LF
        return 0
    if rp == L_CR or rp == L_LF or rp == L_NL
        return 2
    if rcur == L_BK or rcur == L_CR or rcur == L_LF or rcur == L_NL
        return 0
    if rcur == L_SP or rcur == L_ZW
        return 0
    var z = i - 1
    while z >= 0 and copy(it[z as usize].raw) == L_SP
        z -= 1
    if z >= 0 and copy(it[z as usize].raw) == L_ZW
        return 1
    if rp == L_ZWJ
        return 0
    if it[i as usize].gone
        return 0
    let pj = lb_prev(it, i - 1)
    let a = lcls(it, pj)
    let b = copy(it[i as usize].cls)
    let pj2 = if pj >= 0 then lb_prev(it, pj - 1) else -1
    let a2 = lcls(it, pj2)
    let nj = lb_next(it, i + 1)
    let n = it.len() as i64
    let b2 = lcls(it, nj)
    let nj2 = if nj < n then lb_next(it, nj + 1) else n
    let b3 = lcls(it, nj2)
    # LB11, LB12, LB12a
    if b == L_WJ or a == L_WJ
        return 0
    if a == L_GL
        return 0
    if b == L_GL and a != L_SP and a != L_BA and a != L_HY
        return 0
    # LB13
    if b == L_CL or b == L_CP or b == L_EX or b == L_SY
        return 0
    # last non-SP before i, for SP* contexts
    var q = pj
    while q >= 0 and lcls(it, q) == L_SP
        q = lb_prev(it, q - 1)
    let qa = lcls(it, q)
    # LB14
    if qa == L_OP
        return 0
    # LB15a
    if qa == L_QU and it[q as usize].gcat == GC_PI
        let q2 = lb_prev(it, q - 1)
        let k = lcls(it, q2)
        if q2 < 0 or k == L_BK or k == L_CR or k == L_LF or k == L_NL or k == L_OP or k == L_QU or k == L_GL or k == L_SP or k == L_ZW
            return 0
    # LB15b
    if b == L_QU and it[i as usize].gcat == GC_PF
        if nj >= n or b2 == L_SP or b2 == L_GL or b2 == L_WJ or b2 == L_CL or b2 == L_QU or b2 == L_CP or b2 == L_EX or b2 == L_IS or b2 == L_SY or b2 == L_BK or b2 == L_CR or b2 == L_LF or b2 == L_NL or b2 == L_ZW
            return 0
    # LB15c, LB15d
    if a == L_SP and b == L_IS and b2 == L_NU
        return 1
    if b == L_IS
        return 0
    # LB16, LB17
    if (qa == L_CL or qa == L_CP) and b == L_NS
        return 0
    if qa == L_B2 and b == L_B2
        return 0
    # LB18
    if a == L_SP
        return 1
    # LB19
    if b == L_QU and it[i as usize].gcat != GC_PI
        return 0
    if a == L_QU and it[pj as usize].gcat != GC_PF
        return 0
    # LB19a
    if b == L_QU and not it[pj as usize].east
        return 0
    if b == L_QU and (nj >= n or not it[nj as usize].east)
        return 0
    if a == L_QU and not it[i as usize].east
        return 0
    if a == L_QU and (pj2 < 0 or not it[pj2 as usize].east)
        return 0
    # LB20
    if b == L_CB or a == L_CB
        return 1
    # LB20a
    if (a == L_HY or it[pj as usize].cp == 8208) and b == L_AL
        if pj2 < 0 or a2 == L_BK or a2 == L_CR or a2 == L_LF or a2 == L_NL or a2 == L_SP or a2 == L_ZW or a2 == L_CB or a2 == L_GL
            return 0
    # LB21
    if b == L_BA or b == L_HY or b == L_NS or a == L_BB
        return 0
    # LB21a
    if a2 == L_HL and (a == L_HY or (a == L_BA and not it[pj as usize].east)) and b != L_HL
        return 0
    # LB21b, LB22
    if a == L_SY and b == L_HL
        return 0
    if b == L_IN
        return 0
    # LB23, LB23a, LB24
    if (a == L_AL or a == L_HL) and b == L_NU
        return 0
    if a == L_NU and (b == L_AL or b == L_HL)
        return 0
    if a == L_PR and (b == L_ID or b == L_EB or b == L_EM)
        return 0
    if (a == L_ID or a == L_EB or a == L_EM) and b == L_PO
        return 0
    if (a == L_PR or a == L_PO) and (b == L_AL or b == L_HL)
        return 0
    if (a == L_AL or a == L_HL) and (b == L_PR or b == L_PO)
        return 0
    # LB25
    if b == L_PO or b == L_PR or b == L_NU
        var r = pj
        if b != L_NU and (a == L_CL or a == L_CP)
            r = pj2
        while r >= 0 and (lcls(it, r) == L_SY or lcls(it, r) == L_IS)
            r = lb_prev(it, r - 1)
        if lcls(it, r) == L_NU
            return 0
    if (a == L_PO or a == L_PR) and b == L_OP and (b2 == L_NU or (b2 == L_IS and b3 == L_NU))
        return 0
    if (a == L_PO or a == L_PR or a == L_HY or a == L_IS) and b == L_NU
        return 0
    # LB26, LB27
    if a == L_JL and (b == L_JL or b == L_JV or b == L_H2 or b == L_H3)
        return 0
    if (a == L_JV or a == L_H2) and (b == L_JV or b == L_JT)
        return 0
    if (a == L_JT or a == L_H3) and b == L_JT
        return 0
    if (a == L_JL or a == L_JV or a == L_JT or a == L_H2 or a == L_H3) and b == L_PO
        return 0
    if a == L_PR and (b == L_JL or b == L_JV or b == L_JT or b == L_H2 or b == L_H3)
        return 0
    # LB28, LB28a
    if (a == L_AL or a == L_HL) and (b == L_AL or b == L_HL)
        return 0
    let bi = i
    if a == L_AP and (ak_set(it, bi) or b == L_AS)
        return 0
    if ak_set(it, pj) and (b == L_VF or b == L_VI)
        return 0
    if a == L_VI and ak_set(it, pj2) and (b == L_AK or it[i as usize].cp == 9676)
        return 0
    if ak_set(it, pj) and ak_set(it, bi) and b2 == L_VF
        return 0
    # LB29, LB30
    if a == L_IS and (b == L_AL or b == L_HL)
        return 0
    if (a == L_AL or a == L_HL or a == L_NU) and b == L_OP and not it[i as usize].east
        return 0
    if a == L_CP and not it[pj as usize].east and (b == L_AL or b == L_HL or b == L_NU)
        return 0
    # LB30a
    if a == L_RI and b == L_RI
        var cnt: i64 = 0
        var r = pj
        while r >= 0 and lcls(it, r) == L_RI
            cnt += 1
            r = lb_prev(it, r - 1)
        if cnt % 2 == 1
            return 0
    # LB30b
    if b == L_EM and (a == L_EB or (it[pj as usize].pict and it[pj as usize].gcat == GC_CN))
        return 0
    return 1

# Break opportunities (code point offsets, n included) and their kind.
pub fn line_kinds(cs: &[i64]) -> List[i64]
    var out: List[i64] = []
    let it = lb_items(cs)
    var i: i64 = 1
    while i < it.len() as i64
        out.push(lb_at(&it, i))
        i += 1
    return out

pub fn line_breaks(cs: &[i64]) -> List[i64]
    var out: List[i64] = []
    if cs.len() == 0
        return out
    let it = lb_items(cs)
    var i: i64 = 1
    while i < it.len() as i64
        if lb_at(&it, i) != 0
            out.push(i)
        i += 1
    out.push(cs.len() as i64)
    return out

# Mandatory breaks only (after BK, CR, LF, NL and CR LF); eot is mandatory.
pub fn line_mandatory(cs: &[i64]) -> List[i64]
    var out: List[i64] = []
    if cs.len() == 0
        return out
    let it = lb_items(cs)
    var i: i64 = 1
    while i < it.len() as i64
        if lb_at(&it, i) == 2
            out.push(i)
        i += 1
    out.push(cs.len() as i64)
    return out

# ---------------- UAX #9 bidi ----------------
const B_L: i64 = 0
const B_R: i64 = 1
const B_AL: i64 = 2
const B_EN: i64 = 3
const B_ES: i64 = 4
const B_ET: i64 = 5
const B_AN: i64 = 6
const B_CS: i64 = 7
const B_NSM: i64 = 8
const B_BN: i64 = 9
const B_B: i64 = 10
const B_S: i64 = 11
const B_WS: i64 = 12
const B_ON: i64 = 13
const B_LRE: i64 = 14
const B_LRO: i64 = 15
const B_RLE: i64 = 16
const B_RLO: i64 = 17
const B_PDF: i64 = 18
const B_LRI: i64 = 19
const B_RLI: i64 = 20
const B_FSI: i64 = 21
const B_PDI: i64 = 22
const MAX_DEPTH: i64 = 125

pub struct Bidi
    para: i64
    levels: List[i64]

fn is_iso_init(k: i64) -> bool = k == B_LRI or k == B_RLI or k == B_FSI
fn is_removed(k: i64) -> bool = k == B_LRE or k == B_RLE or k == B_LRO or k == B_RLO or k == B_PDF or k == B_BN
fn is_ni(k: i64) -> bool = k == B_B or k == B_S or k == B_WS or k == B_ON or k == B_LRI or k == B_RLI or k == B_FSI or k == B_PDI

# BD9: index of the PDI matching the isolate initiator at i, or n.
fn match_pdi(t: &[i64], i: usize) -> usize
    var depth: i64 = 1
    var j = i + 1
    while j < t.len()
        let k = copy(t[j])
        if is_iso_init(k)
            depth += 1
        elif k == B_PDI
            depth -= 1
            if depth == 0
                return j
        elif k == B_B
            return t.len()
        j += 1
    return t.len()

# P2, P3 on t[lo..hi): 0, 1, or -1 when no strong character.
fn first_strong(t: &[i64], lo: usize, hi: usize) -> i64
    var j = lo
    while j < hi
        let k = copy(t[j])
        if k == B_L
            return 0
        if k == B_R or k == B_AL
            return 1
        if is_iso_init(k)
            j = match_pdi(t, j)
        elif k == B_B
            return -1
        j += 1
    return -1

struct Entry
    level: i64
    ovr: i64
    iso: bool

fn least_odd(l: i64) -> i64 = if l % 2 == 0 then l + 1 else l + 2
fn least_even(l: i64) -> i64 = if l % 2 == 0 then l + 2 else l + 1

# dir: 0 LTR, 1 RTL, 2 auto (P2, P3; LTR when no strong character).
# cs gives code points for N0 bracket pairs; pass [] when there are none.
pub fn bidi_levels(types: &[i64], cs: &[i64], dir: i64) -> Bidi
    let n = types.len()
    var t: List[i64] = []
    for k in types
        t.push(k)
    var para = dir
    if dir == 2
        let f = first_strong(&t, 0, n)
        para = if f < 0 then 0 else f
    # X1 to X8
    var lv: List[i64] = []
    var st: List[Entry] = [Entry(level: para, ovr: -1, iso: false)]
    var over_iso: i64 = 0
    var over_emb: i64 = 0
    var valid_iso: i64 = 0
    var i: usize = 0
    while i < n
        let k = copy(t[i])
        let top = copy(st[st.len() - 1])
        if k == B_RLE or k == B_LRE or k == B_RLO or k == B_LRO
            let nl = if k == B_RLE or k == B_RLO then least_odd(top.level) else least_even(top.level)
            lv.push(top.level)
            if nl <= MAX_DEPTH and over_iso == 0 and over_emb == 0
                let ov = if k == B_RLO then B_R else (if k == B_LRO then B_L else -1)
                st.push(Entry(level: nl, ovr: ov, iso: false))
            elif over_iso == 0
                over_emb += 1
        elif is_iso_init(k)
            lv.push(top.level)
            if top.ovr >= 0
                t[i] = top.ovr
            var rtl = k == B_RLI
            if k == B_FSI
                rtl = first_strong(&t, i + 1, match_pdi(&t, i)) == 1
            let nl = if rtl then least_odd(top.level) else least_even(top.level)
            if nl <= MAX_DEPTH and over_iso == 0 and over_emb == 0
                valid_iso += 1
                st.push(Entry(level: nl, ovr: -1, iso: true))
            else
                over_iso += 1
        elif k == B_PDI
            if over_iso > 0
                over_iso -= 1
            elif valid_iso > 0
                over_emb = 0
                while not st[st.len() - 1].iso
                    st.pop()
                st.pop()
                valid_iso -= 1
            let t2 = copy(st[st.len() - 1])
            lv.push(t2.level)
            if t2.ovr >= 0
                t[i] = t2.ovr
        elif k == B_PDF
            if over_iso > 0
                over_iso = over_iso
            elif over_emb > 0
                over_emb -= 1
            elif not top.iso and st.len() >= 2
                st.pop()
            lv.push(top.level)
        elif k == B_B
            lv.push(para)
        elif k == B_BN
            lv.push(top.level)
        else
            lv.push(top.level)
            if top.ovr >= 0
                t[i] = top.ovr
        i += 1
    # embedding levels before W1 to I2 change them (for sos and eos)
    var emb: List[i64] = []
    for x in lv
        emb.push(x)
    # X9: kept positions; X10: level runs and isolating run sequences
    var keep: List[i64] = []
    i = 0
    while i < n
        if not is_removed(copy(types[i]))
            keep.push(i as i64)
        i += 1
    # runs as [start, end) over keep indices
    var rs: List[i64] = []
    var re: List[i64] = []
    var q: usize = 0
    while q < keep.len()
        let s0 = q
        while q + 1 < keep.len() and lv[keep[q + 1] as usize] == lv[keep[s0] as usize]
            q += 1
        rs.push(s0 as i64)
        re.push(q as i64 + 1)
        q += 1
    var used: List[bool] = []
    for x in rs
        used.push(false)
    var r: usize = 0
    while r < rs.len()
        if used[r]
            r += 1
            continue
        # build the sequence of keep indices
        var seq: List[i64] = []
        var cur = r
        while true
            used[cur] = true
            var a = copy(rs[cur])
            while a < re[cur]
                seq.push(copy(keep[a as usize]))
                a += 1
            let last = copy(seq[seq.len() - 1]) as usize
            if not is_iso_init(copy(types[last]))
                break
            let m = match_pdi(types, last)
            if m >= n
                break
            # the run that starts with m
            var nx: i64 = -1
            var z = cur + 1
            while z < rs.len()
                if keep[rs[z] as usize] == m as i64
                    nx = z as i64
                    break
                z += 1
            if nx < 0
                break
            cur = nx as usize
        resolve_seq(&mut t, &mut lv, &emb, types, cs, &seq, para)
        r += 1
    # L1
    var out: List[i64] = []
    i = 0
    while i < n
        out.push(if is_removed(copy(types[i])) then -1 else copy(lv[i]))
        i += 1
    var trail = true
    var j = n as i64 - 1
    while j >= 0
        let k = copy(types[j as usize])
        if k == B_S or k == B_B
            out[j as usize] = para
            trail = true
        elif trail and (k == B_WS or is_iso_init(k) or k == B_PDI)
            out[j as usize] = para
        elif is_removed(k)
            trail = trail
        else
            trail = false
        j -= 1
    return Bidi(para: para, levels: out)

fn strong_dir(k: i64) -> i64
    if k == B_L
        return 0
    if k == B_R or k == B_EN or k == B_AN
        return 1
    return -1

fn canon_bracket(c: i64) -> i64 = if c == 9001 then 12296 else (if c == 9002 then 12297 else c)

fn resolve_seq(t: &mut List[i64], lv: &mut List[i64], emb: &[i64], orig: &[i64], cs: &[i64], seq: &[i64], para: i64)
    let m = seq.len()
    let first = copy(seq[0]) as usize
    let last = copy(seq[m - 1]) as usize
    let level = copy(emb[first])
    # sos, eos
    var lv_before = para
    var p = first as i64 - 1
    while p >= 0 and is_removed(copy(orig[p as usize]))
        p -= 1
    if p >= 0
        lv_before = copy(emb[p as usize])
    var lv_after = para
    if not is_iso_init(copy(orig[last]))
        var q = last + 1
        while q < orig.len() and is_removed(copy(orig[q]))
            q += 1
        if q < orig.len()
            lv_after = copy(emb[q])
    let sos = if (if lv_before > level then lv_before else level) % 2 == 0 then B_L else B_R
    let eos = if (if lv_after > level then lv_after else level) % 2 == 0 then B_L else B_R
    var ty: List[i64] = []
    for x in seq
        ty.push(copy(t[x as usize]))
    # W1
    var k: usize = 0
    while k < m
        if ty[k] == B_NSM
            if k == 0
                ty[k] = sos
            else
                let pv = copy(ty[k - 1])
                ty[k] = if is_iso_init(pv) or pv == B_PDI then B_ON else pv
        k += 1
    # W2, W3
    var last_strong = sos
    k = 0
    while k < m
        let x = copy(ty[k])
        if x == B_L or x == B_R or x == B_AL
            last_strong = x
        elif x == B_EN and last_strong == B_AL
            ty[k] = B_AN
        k += 1
    k = 0
    while k < m
        if ty[k] == B_AL
            ty[k] = B_R
        k += 1
    # W4
    k = 1
    while k + 1 < m
        let x = copy(ty[k])
        let a = copy(ty[k - 1])
        let b = copy(ty[k + 1])
        if x == B_ES and a == B_EN and b == B_EN
            ty[k] = B_EN
        elif x == B_CS and a == B_EN and b == B_EN
            ty[k] = B_EN
        elif x == B_CS and a == B_AN and b == B_AN
            ty[k] = B_AN
        k += 1
    # W5
    k = 0
    while k < m
        if ty[k] == B_ET
            var e = k
            while e < m and ty[e] == B_ET
                e += 1
            let adj = (k > 0 and ty[k - 1] == B_EN) or (e < m and ty[e] == B_EN)
            if adj
                var z = k
                while z < e
                    ty[z] = B_EN
                    z += 1
            k = e
        else
            k += 1
    # W6
    k = 0
    while k < m
        let x = copy(ty[k])
        if x == B_ES or x == B_ET or x == B_CS
            ty[k] = B_ON
        k += 1
    # W7
    last_strong = sos
    k = 0
    while k < m
        let x = copy(ty[k])
        if x == B_L or x == B_R
            last_strong = x
        elif x == B_EN and last_strong == B_L
            ty[k] = B_L
        k += 1
    # N0
    let e_dir = if level % 2 == 0 then B_L else B_R
    if cs.len() > 0
        n0(&mut ty, orig, cs, seq, sos, e_dir)
    # N1, N2
    k = 0
    while k < m
        if is_ni(copy(ty[k]))
            var e = k
            while e < m and is_ni(copy(ty[e]))
                e += 1
            let lead = if k == 0 then strong_dir(sos) else strong_dir(copy(ty[k - 1]))
            let trail = if e >= m then strong_dir(eos) else strong_dir(copy(ty[e]))
            let d = if lead == trail and lead >= 0 then (if lead == 0 then B_L else B_R) else e_dir
            var z = k
            while z < e
                ty[z] = d
                z += 1
            k = e
        else
            k += 1
    # I1, I2
    k = 0
    while k < m
        let x = copy(ty[k])
        let at = copy(seq[k]) as usize
        if level % 2 == 0
            if x == B_R
                lv[at] = level + 1
            elif x == B_AN or x == B_EN
                lv[at] = level + 2
        elif x == B_L or x == B_EN or x == B_AN
            lv[at] = level + 1
        t[at] = x
        k += 1

# N0 (BD16 bracket pairs within one isolating run sequence).
fn n0(ty: &mut List[i64], orig: &[i64], cs: &[i64], seq: &[i64], sos: i64, e_dir: i64)
    let m = seq.len()
    var so: List[i64] = []
    var sc: List[i64] = []
    var po: List[i64] = []
    var pc: List[i64] = []
    var k: usize = 0
    var full = false
    while k < m and not full
        if ty[k] == B_ON
            let c = copy(cs[seq[k] as usize])
            let bt = bracket_type(c)
            if bt == 1
                if so.len() >= 63
                    full = true
                else
                    so.push(canon_bracket(bracket_pair(c)))
                    sc.push(k as i64)
            elif bt == 2
                var d = so.len() as i64 - 1
                let cc = canon_bracket(c)
                while d >= 0
                    if so[d as usize] == cc
                        po.push(copy(sc[d as usize]))
                        pc.push(k as i64)
                        while so.len() as i64 > d
                            so.pop()
                            sc.pop()
                        break
                    d -= 1
        k += 1
    # sort pairs by opening position (insertion sort)
    var np = po.len()
    var a: usize = 1
    while a < np
        var b = a
        while b > 0 and po[b - 1] > po[b]
            let x = copy(po[b])
            po[b] = copy(po[b - 1])
            po[b - 1] = x
            let y = copy(pc[b])
            pc[b] = copy(pc[b - 1])
            pc[b - 1] = y
            b -= 1
        a += 1
    let e = strong_dir(e_dir)
    var z: usize = 0
    while z < np
        let o = copy(po[z]) as usize
        let c = copy(pc[z]) as usize
        var found_e = false
        var found_o = false
        var w = o + 1
        while w < c
            let d = strong_dir(copy(ty[w]))
            if d == e
                found_e = true
            elif d >= 0
                found_o = true
            w += 1
        var set: i64 = -1
        if found_e
            set = e
        elif found_o
            var ctx = strong_dir(sos)
            var b2 = o as i64 - 1
            while b2 >= 0
                let d = strong_dir(copy(ty[b2 as usize]))
                if d >= 0
                    ctx = d
                    break
                b2 -= 1
            set = if ctx != e then ctx else e
        if set >= 0
            let v = if set == 0 then B_L else B_R
            ty[o] = v
            ty[c] = v
            var f = o + 1
            while f < m and copy(orig[seq[f] as usize]) == B_NSM
                ty[f] = v
                f += 1
            f = c + 1
            while f < m and copy(orig[seq[f] as usize]) == B_NSM
                ty[f] = v
                f += 1
        z += 1

# L2: visual order (left to right) of the positions with a level (>= 0).
pub fn bidi_order(levels: &[i64]) -> List[i64]
    var idx: List[i64] = []
    var lv: List[i64] = []
    var hi: i64 = 0
    var lo_odd: i64 = 1000
    var i: usize = 0
    while i < levels.len()
        let l = copy(levels[i])
        if l >= 0
            idx.push(i as i64)
            lv.push(l)
            if l > hi
                hi = l
            if l % 2 == 1 and l < lo_odd
                lo_odd = l
        i += 1
    var L = hi
    while L >= lo_odd
        var a: usize = 0
        while a < idx.len()
            if lv[a] >= L
                var b = a
                while b < idx.len() and lv[b] >= L
                    b += 1
                var x = a
                var y = b - 1
                while x < y
                    let t1 = copy(idx[x])
                    idx[x] = copy(idx[y])
                    idx[y] = t1
                    let t2 = copy(lv[x])
                    lv[x] = copy(lv[y])
                    lv[y] = t2
                    x += 1
                    y -= 1
                a = b
            else
                a += 1
        L -= 1
    return idx

# Bidi classes of code points (Bidi_Class).
pub fn bidi_types(cs: &[i64]) -> List[i64]
    var o: List[i64] = []
    for c in cs
        o.push(bidi_class(c))
    return o

# ---------------- terminal cells (derived) ----------------
const GC_ME: i64 = 8
const GC_CF: i64 = 27
const GC_CC: i64 = 26

# Cells of one code point: 0, 1 or 2.
pub fn cp_width(c: i64) -> i64
    let g = gc(c)
    if g == GC_MN or g == GC_ME or g == GC_CF or g == GC_CC
        return 0
    if c == 8203 or (c >= 4448 and c <= 4607) or (c >= 55216 and c <= 55295)
        return 0
    let e = ea(c)
    if e == 2 or e == 5
        return 2
    return 1

# Cells of one grapheme cluster cs[a..b).
pub fn cluster_width(cs: &[i64], a: usize, b: usize) -> i64
    var w: i64 = 0
    var pict = false
    var i = a
    while i < b
        let c = copy(cs[i])
        if w == 0
            w = cp_width(c)
            pict = ext_pict(c)
        elif c == 65039 and pict
            w = 2
        i += 1
    return w

# Cells of a whole sequence, cluster by cluster.
pub fn text_width(cs: &[i64]) -> i64
    var w: i64 = 0
    var a: usize = 0
    for b in grapheme_breaks(cs)
        w += cluster_width(cs, a, b as usize)
        a = b as usize
    return w

# Segments of cs (the code points between consecutive boundaries).
pub fn segments(cs: &[i64], bs: &[i64]) -> List[List[i64]]
    var out: List[List[i64]] = []
    var a: usize = 0
    for b in bs
        var seg: List[i64] = []
        var i = a
        while i < b as usize
            seg.push(copy(cs[i]))
            i += 1
        out.push(seg)
        a = b as usize
    return out

